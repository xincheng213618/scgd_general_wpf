<Window x:Class="ColorVisionSetup.WindowUpdate"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ColorVision 在线下载" Width="820" Height="580" WindowStyle="None" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Background="#080F19" Foreground="#F3F7FC"
        FontFamily="Microsoft YaHei UI" FontSize="13" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        Icon="ColorVision1.ico" Loaded="Window_Loaded" Closing="Window_Closing" Closed="Window_Closed">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
        <LinearGradientBrush x:Key="Spectrum" StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Color="#6590FF" Offset="0"/><GradientStop Color="#55D7FA" Offset="0.28"/>
            <GradientStop Color="#85F3C6" Offset="0.55"/><GradientStop Color="#D0F0A1" Offset="0.78"/><GradientStop Color="#FFC18E" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="ButtonBase" TargetType="Button">
            <Setter Property="Foreground" Value="#A6B7CA"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#75D9C8"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#E8FFF8"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.7"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource ButtonBase}"/>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="#B4F7D7"/><Setter Property="Foreground" Value="#0B2A25"/>
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="24,13"/>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#D5FFEB"/></Trigger></Style.Triggers>
        </Style>
        <Storyboard x:Key="SpectrumDrift" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="OrbitAngle" Storyboard.TargetProperty="Angle" From="-24" To="-15" Duration="0:0:9"/>
            <DoubleAnimation Storyboard.TargetName="PrismGlow" Storyboard.TargetProperty="Opacity" From="0.35" To="0.7" Duration="0:0:9"/>
        </Storyboard>
    </Window.Resources>
    <Border BorderBrush="#2A394B" BorderThickness="1" Background="#080F19" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="250"/><RowDefinition Height="*"/><RowDefinition Height="44"/></Grid.RowDefinitions>
            <Grid Grid.RowSpan="2" IsHitTestVisible="False">
                <Ellipse Width="650" Height="400" HorizontalAlignment="Right" Margin="0,-120,-140,0">
                    <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#173C48"/><GradientStop Color="#00080F19" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
                </Ellipse>
                <Path Stroke="#13283B" StrokeThickness="1" Data="M 450,0 L 818,225 M 510,0 L 818,187 M 575,0 L 818,147 M 640,0 L 818,105"/>
            </Grid>
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Caption_MouseLeftButtonDown" Margin="24,0,10,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="19" Height="19" Margin="0,0,9,0">
                        <Path Stroke="{StaticResource Spectrum}" StrokeThickness="2" Data="M 9,1 L 17,5 L 17,14 L 9,18 L 1,14 L 1,5 Z"/>
                        <Path Stroke="#A7EBD7" StrokeThickness="1" Data="M 1,5 L 9,10 L 17,5 M 9,10 L 9,18"/>
                    </Grid>
                    <TextBlock Text="COLORVISION" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="12" Foreground="#DDE8F2"/>
                    <TextBlock Text="/ 在线下载" Foreground="#697E93" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Content="─" Width="38" Height="30" Padding="0" Click="Minimize_Click" AutomationProperties.Name="最小化"/>
                    <Button Content="×" Width="38" Height="30" Padding="0" FontSize="20" Click="Close_Click" AutomationProperties.Name="关闭"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1" Margin="38,8,26,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="350"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Rectangle Width="22" Height="2" Fill="#89E5CB" VerticalAlignment="Center" Margin="0,0,9,0"/>
                        <TextBlock Text="A NEW SPECTRUM" FontFamily="Segoe UI" Foreground="#88ACBB" FontSize="10"/>
                    </StackPanel>
                    <TextBlock Text="ColorVision" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="48" Foreground="#F2F7FF"/>
                    <TextBlock Text="看见，更进一步。" FontSize="23" Foreground="#C9DDE8" Margin="0,7,0,16"/>
                    <TextBlock Text="下载最新版本，继续探索光与色彩。" Foreground="#8398AD" FontSize="12"/>
                </StackPanel>
                <Viewbox Grid.Column="1" Stretch="Uniform" IsHitTestVisible="False" Margin="-30,-12,-12,-10">
                    <Canvas Width="360" Height="250">
                        <Ellipse x:Name="PrismGlow" Canvas.Left="52" Canvas.Top="17" Width="265" Height="226" Opacity="0.55">
                            <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#306E80"/><GradientStop Color="#00080F19" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
                        </Ellipse>
                        <Ellipse Canvas.Left="30" Canvas.Top="38" Width="303" Height="178" Stroke="#20364B" StrokeThickness="1"/>
                        <Ellipse Canvas.Left="10" Canvas.Top="16" Width="342" Height="220" Stroke="#16283A" StrokeThickness="1" StrokeDashArray="2,9"/>
                        <Canvas Width="360" Height="250">
                            <Canvas.RenderTransform><RotateTransform x:Name="OrbitAngle" Angle="-24" CenterX="180" CenterY="125"/></Canvas.RenderTransform>
                            <Ellipse Canvas.Left="24" Canvas.Top="62" Width="306" Height="125" Stroke="{StaticResource Spectrum}" StrokeThickness="12" Opacity="0.055"/>
                            <Ellipse Canvas.Left="24" Canvas.Top="62" Width="306" Height="125" Stroke="{StaticResource Spectrum}" StrokeThickness="5" Opacity="0.14"/>
                            <Ellipse Canvas.Left="24" Canvas.Top="62" Width="306" Height="125" Stroke="{StaticResource Spectrum}" StrokeThickness="1.8"/>
                            <Ellipse Canvas.Left="36" Canvas.Top="72" Width="282" Height="105" Stroke="{StaticResource Spectrum}" StrokeThickness="1" Opacity="0.4"/>
                            <Ellipse Canvas.Left="260" Canvas.Top="167" Width="5" Height="5" Fill="#CEFAC1"/>
                        </Canvas>
                        <Path Data="M 177,51 L 115,161 L 244,157 Z" Stroke="#A4D1E1" StrokeThickness="1.2">
                            <Path.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#254F70"/><GradientStop Color="#233E47" Offset="0.6"/><GradientStop Color="#0F2332" Offset="1"/></LinearGradientBrush></Path.Fill>
                        </Path>
                        <Path Data="M 177,51 L 185,129 L 244,157 Z" Fill="#386783" Opacity="0.55"/>
                        <Path Data="M 115,161 L 185,129 L 244,157 Z" Fill="#82D2CD" Opacity="0.14"/>
                        <Path Data="M 177,51 L 185,129 L 115,161 M 185,129 L 244,157" Stroke="#95C8D6" StrokeThickness="0.8" Opacity="0.65"/>
                        <Path Data="M 19,141 L 155,113" Stroke="#C5EEFA" StrokeThickness="1.5"/>
                        <Path Data="M 199,106 L 340,53" Stroke="#779EF7" StrokeThickness="1.4" Opacity="0.8"/>
                        <Path Data="M 202,113 L 346,81" Stroke="#66CEED" StrokeThickness="1.4" Opacity="0.8"/>
                        <Path Data="M 205,120 L 348,109" Stroke="#85ECCA" StrokeThickness="1.4" Opacity="0.9"/>
                        <Path Data="M 208,127 L 346,137" Stroke="#D0EFA8" StrokeThickness="1.4" Opacity="0.8"/>
                        <Path Data="M 211,134 L 340,165" Stroke="#F2C69E" StrokeThickness="1.4" Opacity="0.8"/>
                        <Ellipse Canvas.Left="17" Canvas.Top="139" Width="4" Height="4" Fill="#E3F9FF"/>
                        <TextBlock Canvas.Left="91" Canvas.Top="215" Text="LIGHT  /  COLOR  /  VISION" FontFamily="Segoe UI" FontSize="8" Foreground="#496579"/>
                    </Canvas>
                </Viewbox>
            </Grid>
            <Border Grid.Row="2" Margin="28,8,28,0" Padding="23,18" CornerRadius="12" BorderBrush="#27374A" BorderThickness="1" Background="#101B28">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="{Binding Status}" FontSize="16" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/>
                            <TextBlock Text="{Binding Detail}" Foreground="#8FA5B9" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#172C32" BorderBrush="#29454A" BorderThickness="1" CornerRadius="5" Padding="10,5" VerticalAlignment="Top">
                            <TextBlock Text="{Binding VersionText}" FontSize="11" FontFamily="Segoe UI" Foreground="#98E7CE"/>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Row="1" Margin="0,18,0,0">
                        <ProgressBar Height="4" Minimum="0" Maximum="100" Value="{Binding Progress}" IsIndeterminate="{Binding IsIndeterminate}" Background="#223247" Foreground="{StaticResource Spectrum}" BorderThickness="0" AutomationProperties.Name="下载进度"/>
                        <Grid Margin="0,9,0,0">
                            <TextBlock Text="{Binding TransferText}" Foreground="#7F97AC" FontSize="11"/>
                            <TextBlock Text="{Binding ProgressText}" Foreground="#AFEDD5" FontSize="11" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                    <Grid Grid.Row="2" VerticalAlignment="Bottom" Margin="0,16,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="重新检查" Click="Refresh_Click" IsEnabled="{Binding CanRefresh}" Padding="0,8,12,8" FontSize="12"/>
                            <Button Content="打开文件夹" Click="OpenFolder_Click" Visibility="{Binding CanOpenFolder, Converter={StaticResource BoolVisibility}}" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="取消" Click="Cancel_Click" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" IsEnabled="{Binding CanCancel}" Margin="0,0,12,0"/>
                            <Button x:Name="PrimaryButton" Content="{Binding PrimaryText}" Click="Primary_Click" IsEnabled="{Binding CanAct}" Style="{StaticResource PrimaryButton}" MinWidth="178" IsDefault="True"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
            <Grid Grid.Row="3" Margin="32,0,28,0">
                <TextBlock Text="COLORVISION   /   官方在线下载" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="10" Foreground="#536B81" VerticalAlignment="Center"/>
                <Button Content="查看日志" Click="OpenLog_Click" HorizontalAlignment="Right" FontSize="10" Foreground="#70879D" Padding="8,5"/>
            </Grid>
        </Grid>
    </Border>
</Window>
