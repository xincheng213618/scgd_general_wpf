<Window x:Class="ProjectARVRPro.ResultViewRefreshManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ColorVision.Themes.Controls;assembly=ColorVision.Themes"
        Title="视图刷新管理" Width="820" Height="600" MinWidth="700" MinHeight="460"
        Background="{DynamicResource GlobalBackground}" Foreground="{DynamicResource GlobalTextBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="RefreshWarningBackground" Color="#32FF9800" />
        <SolidColorBrush x:Key="RefreshWarningBorder" Color="#E69000" />
        <SolidColorBrush x:Key="RefreshSafeBackground" Color="#2022A06B" />
        <SolidColorBrush x:Key="RefreshSafeBorder" Color="#398B65" />
        <Style x:Key="RefreshListItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="IsTabStop" Value="False" />
        </Style>
        <Style x:Key="RefreshRowBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CV.Surface.Control}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CV.Border.Control}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,13" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsWarning}" Value="True">
                    <Setter Property="Background" Value="{StaticResource RefreshWarningBackground}" />
                    <Setter Property="BorderBrush" Value="{StaticResource RefreshWarningBorder}" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="24,18,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="视图刷新管理" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="统一管理所有读图与结果视图的自动刷新；多组设备会显示实际影响的视图数量。"
                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,6,0,0" />
        </StackPanel>

        <Border Grid.Row="1" x:Name="SummaryBorder" CornerRadius="8" BorderThickness="1" Padding="14,11" Margin="0,0,0,14">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource RefreshSafeBackground}" />
                    <Setter Property="BorderBrush" Value="{StaticResource RefreshSafeBorder}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasAnyEnabled}" Value="True">
                            <Setter Property="Background" Value="{StaticResource RefreshWarningBackground}" />
                            <Setter Property="BorderBrush" Value="{StaticResource RefreshWarningBorder}" />
                            <Setter Property="BorderThickness" Value="2" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" FontSize="17" FontWeight="Bold" Width="26" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="✓" />
                            <Setter Property="Foreground" Value="{StaticResource RefreshSafeBorder}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasAnyEnabled}" Value="True">
                                    <Setter Property="Text" Value="!" />
                                    <Setter Property="Foreground" Value="{StaticResource RefreshWarningBorder}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <StackPanel>
                    <TextBlock Text="{Binding SummaryTitle}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SummaryDescription}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,3,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" BorderBrush="{DynamicResource CV.Border.Control}" BorderThickness="1" CornerRadius="8" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ListBox ItemsSource="{Binding Items}" ItemContainerStyle="{StaticResource RefreshListItem}"
                         Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource RefreshRowBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="70" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding InstanceSummary}" Margin="0,5,12,0" FontSize="12"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="10" Padding="10,3">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource RefreshSafeBackground}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource RefreshWarningBackground}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold" />
                                    </Border>
                                    <controls:ToggleSwitch Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           IsChecked="{Binding IsAutoRefreshEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                           ToolTip="开启或关闭这类视图的自动刷新" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="一键关闭全部刷新" Click="DisableAll_Click" MinWidth="150" Padding="14,7" />
                <TextBlock Text="修改在确定后统一写入配置文件" Margin="12,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="取消" IsCancel="True" MinWidth="88" Padding="14,7" Margin="0,0,8,0" />
                <Button Content="确定并保存" Click="Save_Click" MinWidth="110" Padding="14,7" IsDefault="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
