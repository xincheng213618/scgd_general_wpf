<UserControl x:Class="ProjectARVRPro.Controls.ProcessStepProgress"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:ColorVision.UI.Controls;assembly=ColorVision.UI"
             xmlns:display="clr-namespace:ProjectARVRPro"
             x:Name="ProgressControl" Foreground="{DynamicResource GlobalTextBrush}" Height="42" UseLayoutRounding="True">
    <UserControl.Resources>
        <Style x:Key="StepButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0,1"/>
            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Stretch"/>
                            </Border>
                            <Border x:Name="FocusOutline" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1" CornerRadius="4" Visibility="Collapsed" IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ButtonBackground}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ButtonBackground}"/>
                                <Setter TargetName="FocusOutline" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <ItemsControl x:Name="StepItems" ItemsSource="{Binding Steps, ElementName=ProgressControl}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Button Style="{StaticResource StepButton}" Tag="{Binding}" ToolTip="{Binding Details}"
                        AutomationProperties.Name="{Binding Details}" MouseDoubleClick="Step_MouseDoubleClick" PreviewKeyDown="Step_PreviewKeyDown">
                    <Button.ContextMenu>
                        <ContextMenu Opened="StepMenu_Opened">
                            <MenuItem Header="{display:DisplayText Key='打开流程模板'}" Click="OpenTemplate_Click"/>
                            <MenuItem Header="{display:DisplayText Key='编辑配置'}" Click="EditConfiguration_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="16"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Height="2" VerticalAlignment="Center" Background="{DynamicResource BorderBrush}">
                            <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding IsFirst}" Value="True"><Setter Property="Visibility" Value="Hidden"/></DataTrigger></Style.Triggers></Style></Border.Style>
                        </Border>
                        <ui:CircularProgressIndicator Grid.Column="1" Width="24" Height="24" State="{Binding State}" Value="{Binding Progress}" StepNumber="{Binding Number}"/>
                        <Border Grid.Column="2" Height="2" VerticalAlignment="Center" Background="{DynamicResource BorderBrush}">
                            <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding IsLast}" Value="True"><Setter Property="Visibility" Value="Hidden"/></DataTrigger></Style.Triggers></Style></Border.Style>
                        </Border>
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding Meta.Name}" Foreground="{DynamicResource GlobalTextBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12" Margin="8,0"/>
                    </Grid>
                </Button>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
