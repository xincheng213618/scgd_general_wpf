<Window x:Class="ProjectARVRPro.Process.ProcessGroupNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:display="clr-namespace:ProjectARVRPro"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" UseLayoutRounding="True"
        Background="{DynamicResource GlobalBackground}" Foreground="{DynamicResource GlobalTextBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="24,22,24,18">
            <TextBlock x:Name="HeadingText" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock x:Name="DescriptionText" Margin="0,7,0,22" Opacity="0.7" TextWrapping="Wrap"/>
            <TextBlock x:Name="NameLabel" Text="{display:DisplayText Key='流程组名称'}"
                       FontWeight="SemiBold" HorizontalAlignment="Left" Margin="0,0,0,7"/>
            <TextBox x:Name="NameBox" Height="36" VerticalContentAlignment="Center" Padding="10,4"
                     AutomationProperties.LabeledBy="{Binding ElementName=NameLabel}"
                     AutomationProperties.Name="{display:DisplayText Key='流程组名称'}"/>
            <TextBlock Text="{display:DisplayText Key='名称不能为空，且不能与其他流程组重复。'}"
                       Margin="0,8,0,0" Opacity="0.6" FontSize="12" TextWrapping="Wrap"/>
            <TextBlock x:Name="ErrorText" Margin="0,8,0,0" MinHeight="18" TextWrapping="Wrap"
                       Foreground="{DynamicResource DangerBrush}" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="{display:DisplayText Key='取消'}" IsCancel="True"
                        MinWidth="82" Padding="16,7" Margin="0,0,10,0"/>
                <Button x:Name="SaveButton" IsDefault="True" Click="Save_Click" MinWidth="100" Padding="16,7"
                        Background="{DynamicResource PrimaryBrush}" BorderBrush="{DynamicResource PrimaryBrush}" Foreground="White"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
