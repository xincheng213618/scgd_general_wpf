<UserControl x:Class="ProjectARVRPro.Integration.IntegrationDemoPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded"
             IsVisibleChanged="UserControl_IsVisibleChanged">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12" MaxWidth="1040" HorizontalAlignment="Left">
            <TextBlock Text="外部系统对接" FontSize="20" FontWeight="Bold"/>
            <TextBlock Margin="0 6 0 14" Foreground="{DynamicResource SecondaryTextBrush}"
                       Text="下载可直接运行并包含 C# 源码的 ProjectARVRPro 对接 Demo，用于 TCP 调用、结果 JSON 解析和 CSV 导出。"
                       TextWrapping="Wrap"/>

            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0 0 0 12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="260"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="当前插件版本：" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock x:Name="CurrentPluginVersionText" Grid.Column="1" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="2" Text="结果输出模式：" Foreground="{DynamicResource SecondaryTextBrush}" Margin="18 0 0 0"/>
                    <TextBlock x:Name="OutputModeText" Grid.Column="3" FontWeight="SemiBold"/>

                    <TextBlock Grid.Row="1" Text="Socket 协议：" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0 8 0 0"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="1.0 / 默认端口 6666" Margin="0 8 0 0"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="下载服务：" Foreground="{DynamicResource SecondaryTextBrush}" Margin="18 8 0 0"/>
                    <TextBlock x:Name="ServiceUrlText" Grid.Row="1" Grid.Column="3" Margin="0 8 0 0" TextTrimming="CharacterEllipsis"/>

                    <TextBlock Grid.Row="2" Text="说明：" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0 8 0 0"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="0 8 0 0" TextWrapping="Wrap"
                               Text="标准结果使用现代嵌套契约；启用 Legacy 输出时请按现场旧版扁平字段解析。"/>
                </Grid>
            </Border>

            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0 0 0 12">
                <StackPanel>
                    <DockPanel Margin="0 0 0 10">
                        <TextBlock Text="对接 Demo" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="刷新版本" Padding="10 4" Click="RefreshButton_Click"/>
                    </DockPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="最新版本：" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock x:Name="LatestVersionText" Grid.Column="1" Text="尚未检查" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="2" Text="已验证插件版本：" Foreground="{DynamicResource SecondaryTextBrush}" Margin="18 0 0 0"/>
                        <TextBlock x:Name="VerifiedPluginVersionText" Grid.Column="3" Text="—"/>

                        <TextBlock Grid.Row="1" Text="运行环境：" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0 7 0 0"/>
                        <TextBlock x:Name="RuntimeText" Grid.Row="1" Grid.Column="1" Text=".NET Framework 4.8" Margin="0 7 0 0"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="协议版本：" Foreground="{DynamicResource SecondaryTextBrush}" Margin="18 7 0 0"/>
                        <TextBlock x:Name="ProtocolVersionText" Grid.Row="1" Grid.Column="3" Text="—" Margin="0 7 0 0"/>

                        <TextBlock Grid.Row="2" Text="版本说明：" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0 7 0 0"/>
                        <TextBlock x:Name="ReleaseNotesText" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Text="—" Margin="0 7 0 0" TextWrapping="Wrap"/>
                    </Grid>

                    <TextBlock x:Name="StatusText" Margin="0 12 0 8" Foreground="{DynamicResource SecondaryTextBrush}" Text="切换到本页后检查发布版本。" TextWrapping="Wrap"/>
                    <WrapPanel>
                        <Button x:Name="DownloadButton" Content="下载最新版" Padding="14 6" Margin="0 0 8 0" IsEnabled="False" Click="DownloadButton_Click"/>
                        <Button x:Name="CopyDownloadLinkButton" Content="复制下载链接" Padding="12 6" Margin="0 0 8 0" IsEnabled="False" Click="CopyDownloadLinkButton_Click"/>
                        <Button Content="打开下载目录" Padding="12 6" Click="OpenDownloadDirectoryButton_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="14">
                <StackPanel>
                    <TextBlock Text="快速调用与解析" FontSize="16" FontWeight="Bold" Margin="0 0 0 10"/>
                    <TextBlock Text="一键执行示例" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <Grid Margin="0 4 0 10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="RunAllCommandTextBox" IsReadOnly="True" IsReadOnlyCaretVisible="True" Padding="6" HorizontalScrollBarVisibility="Auto"/>
                        <Button Grid.Column="1" Content="复制" Padding="12 4" Margin="8 0 0 0" Tag="RunAll" Click="CopyCommandButton_Click"/>
                    </Grid>

                    <TextBlock Text="离线解析示例" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <Grid Margin="0 4 0 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ParseCommandTextBox" IsReadOnly="True" IsReadOnlyCaretVisible="True" Padding="6" HorizontalScrollBarVisibility="Auto"/>
                        <Button Grid.Column="1" Content="复制" Padding="12 4" Margin="8 0 0 0" Tag="Parse" Click="CopyCommandButton_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
