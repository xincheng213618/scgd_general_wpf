<Window x:Class="ProjectARVRPro.Offline.OfflineMessagesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="现场相关消息 · 只读" Width="1120" Height="720" MinWidth="800" MinHeight="500"
        Background="{DynamicResource GlobalBackground}" Loaded="Window_Loaded">
    <Grid Margin="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock x:Name="SourceText" Foreground="{DynamicResource GlobalTextBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <DockPanel Grid.Row="1" Margin="0,0,0,10">
            <ComboBox x:Name="KindBox" Width="120" SelectedIndex="0" SelectionChanged="Kind_Changed"><ComboBoxItem Content="Socket"/><ComboBoxItem Content="MQTT"/></ComboBox>
            <TextBlock x:Name="RangeText" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
        </DockPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <DataGrid x:Name="MessagesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" RowHeight="32" ColumnHeaderHeight="30" HeadersVisibility="Column" SelectionMode="Single" SelectionChanged="Message_Selected">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="时间" Binding="{Binding Time, StringFormat=HH:mm:ss.fff}" Width="105"/>
                    <DataGridTextColumn Header="方向" Binding="{Binding Direction}" Width="65"/>
                    <DataGridTextColumn Header="事件/主题" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="MsgID" Binding="{Binding Correlation}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"/>
            <TextBox Grid.Column="2" x:Name="PayloadText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" Padding="8"/>
        </Grid>
        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="PreviousButton" Content="上一页" Click="Previous_Click" Padding="12,5"/><Button x:Name="NextButton" Content="下一页" Click="Next_Click" Margin="6,0,0,0" Padding="12,5"/></StackPanel>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{DynamicResource GlobalTextBrush}" TextWrapping="Wrap"/>
        </DockPanel>
    </Grid>
</Window>
