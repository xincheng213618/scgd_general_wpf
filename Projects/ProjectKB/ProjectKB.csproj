<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<ApplicationIcon>Assets\ProjectKB.ico</ApplicationIcon>
		<VersionPrefix>1.4.6.12</VersionPrefix>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="Assets\ProjectKB.ico" />
		<None Remove="Assets\ProjectKB.png" />
		<None Remove="CHANGELOG.md" />
		<None Remove="README.md" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="Assets\ProjectKB.ico" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="CHANGELOG.md">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</EmbeddedResource>
		<EmbeddedResource Include="README.md">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="NModbus" Version="3.0.83" />
		<PackageReference Include="ScottPlot.WPF" Version="5.0.56" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Engine\ColorVision.Engine\ColorVision.Engine.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Resource Include="Assets\ProjectKB.ico" />
		<Resource Include="Assets\ProjectKB.png" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="EditRecipeWindow.xaml.cs">
			<SubType>Code</SubType>
		</Compile>
		<Compile Update="Properties\Resources.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Resources.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Properties\Resources.resx">
			<Generator>PublicResXFileCodeGenerator</Generator>
			<LastGenOutput>Resources.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<None Update="FunTestDll.dll">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="FunTestDllConfig.INI">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="manifest.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<Import Project="..\..\PluginProject.HostCopy.targets" />

</Project>
