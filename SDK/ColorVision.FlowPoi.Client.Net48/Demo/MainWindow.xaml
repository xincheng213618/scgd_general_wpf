<Window x:Class="ColorVision.FlowPoi.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ColorVision 流程 POI 对接 Demo · .NET Framework 4.8"
        Width="1280" Height="820" MinWidth="960" MinHeight="650"
        WindowStartupLocation="CenterScreen" Background="#F4F6F8"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Margin" Value="0,4,12,0"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="#EEF2F6"/>
            <Setter Property="BorderBrush" Value="#DDE3EA"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,5"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="流程 POI 对接 Demo" FontSize="25" FontWeight="SemiBold" Foreground="#172B4D"/>
            <TextBlock Text="独立 net48 / x64 客户端 · TCP JSON · FlowRunPoi" Margin="0,5,0,0" Foreground="#526378"/>
        </StackPanel>
        <Border Grid.Row="1" Background="White" BorderBrush="#DDE3EA" BorderThickness="1" CornerRadius="8" Padding="16">
            <StackPanel>
                <Grid x:Name="InputPanel">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="1.3*"/>
                        <ColumnDefinition Width="2.5*"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="1.6*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="主程序 IP / 主机名"/>
                        <TextBox x:Name="HostTextBox" Text="127.0.0.1"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="端口"/>
                        <TextBox x:Name="PortTextBox" Text="6666"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,12,0">
                        <TextBlock Text="调用方式"/>
                        <ComboBox x:Name="SelectorComboBox" SelectedIndex="0" Height="30" Margin="0,4,0,0"
                                  SelectionChanged="Selector_Changed" VerticalContentAlignment="Center">
                            <ComboBoxItem Content="流程名称"/>
                            <ComboBoxItem Content="模板 ID"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <TextBlock x:Name="SelectorLabel" Text="流程名称"/>
                        <Grid>
                            <TextBox x:Name="FlowNameTextBox" ToolTip="填写主程序中的实际流程名称"/>
                            <TextBox x:Name="FlowIdTextBox" Visibility="Collapsed" ToolTip="实际模板 ID；支持本地模板负数 ID，不能填 0"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="超时（秒）"/>
                        <TextBox x:Name="TimeoutTextBox" Text="600"/>
                    </StackPanel>
                    <StackPanel Grid.Column="5">
                        <TextBlock Text="请求关联编号（可选）"/>
                        <TextBox x:Name="SerialNumberTextBox" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
                <WrapPanel Margin="0,16,0,0">
                    <Button x:Name="RunButton" Content="发送并执行流程" Click="Run_Click" Background="#1765C1" Foreground="White"/>
                    <Button x:Name="CancelButton" Content="取消等待" Click="Cancel_Click" IsEnabled="False"/>
                    <Button x:Name="SampleButton" Content="查看离线样例" Click="Sample_Click"/>
                    <Button x:Name="OpenButton" Content="打开响应 JSON…" Click="Open_Click"/>
                </WrapPanel>
                <TextBlock Text="执行会运行主程序中的实际流程及前后处理。取消等待仅断开客户端，不会停止主程序流程。"
                           TextWrapping="Wrap" Foreground="#68778B" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="2" Background="White" BorderBrush="#DDE3EA" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,12">
            <StackPanel>
                <TextBlock x:Name="StatusText" Text="就绪 · 可先查看离线样例，或填写主程序地址和流程信息。" Foreground="#526378" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="SummaryText" Text="尚无结果" Foreground="#526378" Margin="0,6,0,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="IdentityText" Foreground="#68778B" Margin="0,5,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="3" Background="White" BorderBrush="#DDE3EA" BorderThickness="1" CornerRadius="8" Padding="12">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="ExportJsonButton" Content="导出 JSON…" Click="ExportJson_Click" IsEnabled="False"/>
                        <Button x:Name="ExportCsvButton" Content="导出 CSV…" Click="ExportCsv_Click" IsEnabled="False" Margin="0"/>
                    </StackPanel>
                    <TextBlock x:Name="ResultTitle" Text="本次响应" FontSize="16" FontWeight="SemiBold"/>
                </DockPanel>
                <TabControl>
                    <TabItem Header="POI 结果">
                        <DataGrid x:Name="PointsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  BorderThickness="0" RowBackground="White" AlternatingRowBackground="#F8FAFC"
                                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="算法 / 输出名称" Binding="{Binding AlgorithmName}" Width="160"/>
                                <DataGridTextColumn Header="点位名称" Binding="{Binding Name}" Width="120"/>
                                <DataGridTextColumn Header="POI ID" Binding="{Binding PoiId}" Width="75"/>
                                <DataGridTextColumn Header="X" Binding="{Binding X, StringFormat={}{0:G9}}" Width="100"/>
                                <DataGridTextColumn Header="Y" Binding="{Binding Y, StringFormat={}{0:G9}}" Width="100"/>
                                <DataGridTextColumn Header="Z" Binding="{Binding Z, StringFormat={}{0:G9}}" Width="100"/>
                                <DataGridTextColumn Header="x（色度）" Binding="{Binding ChromaticityX, StringFormat={}{0:G9}}" Width="115"/>
                                <DataGridTextColumn Header="y（色度）" Binding="{Binding ChromaticityY, StringFormat={}{0:G9}}" Width="115"/>
                                <DataGridTextColumn Header="u′" Binding="{Binding U, StringFormat={}{0:G9}}" Width="100"/>
                                <DataGridTextColumn Header="v′" Binding="{Binding V, StringFormat={}{0:G9}}" Width="100"/>
                                <DataGridTextColumn Header="CCT" Binding="{Binding CCT, StringFormat={}{0:G9}}" Width="100"/>
                                <DataGridTextColumn Header="Wave" Binding="{Binding Wave, StringFormat={}{0:G9}}" Width="100"/>
                                <DataGridTextColumn Header="像素 X" Binding="{Binding PixelX}" Width="80"/>
                                <DataGridTextColumn Header="像素 Y" Binding="{Binding PixelY}" Width="80"/>
                                <DataGridTextColumn Header="宽度" Binding="{Binding Width}" Width="75"/>
                                <DataGridTextColumn Header="高度" Binding="{Binding Height}" Width="75"/>
                                <DataGridTextColumn Header="算法结果 ID" Binding="{Binding AlgorithmResultId}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="响应 JSON">
                        <TextBox x:Name="ResponseTextBox" IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="12" Margin="0" VerticalContentAlignment="Top"/>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Border>
    </Grid>
</Window>
