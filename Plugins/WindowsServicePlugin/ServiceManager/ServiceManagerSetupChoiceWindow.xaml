<Window x:Class="WindowsServicePlugin.ServiceManager.ServiceManagerSetupChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:WindowsServicePlugin.Properties"
        Title="{x:Static res:Resources.SetupConfigTitle}" Width="620" SizeToContent="Height"
        Background="{DynamicResource CV.Surface.Window}"
        Foreground="{DynamicResource CV.Text.Primary}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary Source="ServiceManagerStyles.xaml" />
    </Window.Resources>
    <Grid Margin="30,28,30,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{x:Static res:Resources.SetupConfigChoiceTitle}"
                   Style="{StaticResource ServiceHeading}"/>

        <TextBlock x:Name="LegacyConfigText"
                   Grid.Row="1"
                   Margin="0,10,0,24"
                   TextWrapping="Wrap"
                   Style="{StaticResource ServiceSubtitle}"/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="ImportButton"
                    Grid.Column="0"
                    MinHeight="110"
                    Padding="18"
                    Click="Import_Click">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Resources.ImportConfig}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="{x:Static res:Resources.ImportConfigDescription}" Margin="0,6,0,0" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="2"
                    MinHeight="110"
                    Padding="18"
                    Click="Manual_Click">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Resources.ManualConfig}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="{x:Static res:Resources.ManualConfigDescription}" Margin="0,6,0,0" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <Button Grid.Row="3"
                Content="{x:Static res:Resources.SkipConfig}"
                Style="{StaticResource ServiceLink}"
                Margin="0,22,0,0"
                HorizontalAlignment="Right"
                Click="Skip_Click"/>
    </Grid>
</Window>
