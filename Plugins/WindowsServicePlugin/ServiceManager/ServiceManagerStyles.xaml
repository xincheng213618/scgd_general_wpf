<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:res="clr-namespace:WindowsServicePlugin.Properties">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/ColorVision.Themes;component/Themes/Components/Dialog.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <Style x:Key="ServiceHeading" TargetType="TextBlock">
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource CV.Text.Primary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="ServiceSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource CV.Text.Secondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="ServiceSectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,14" />
    </Style>
    <Style x:Key="ServiceDivider" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource CV.Border.Weak}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="0,0,0,20" />
        <Setter Property="Margin" Value="0,0,0,20" />
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource CV.Button.Secondary}">
        <Setter Property="MinWidth" Value="64" />
        <Setter Property="Padding" Value="14,7" />
    </Style>
    <Style x:Key="ServiceLink" TargetType="Button" BasedOn="{StaticResource CV.Button.Text}">
        <Setter Property="Padding" Value="0,7" />
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style x:Key="ServiceStatus" TargetType="TextBlock" BasedOn="{StaticResource ServiceSubtitle}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource CV.Accent.Primary}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="ServiceStartAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="ServiceStopAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="TabControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TabPanel IsItemsHost="True" Background="Transparent" KeyboardNavigation.TabIndex="0" />
                        <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent" KeyboardNavigation.TabIndex="1" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource CV.Text.Primary}" />
        <Setter Property="Padding" Value="0,10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="TabBorder" Background="Transparent" BorderBrush="Transparent"
                            BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}" Margin="0,0,24,0">
                        <ContentPresenter x:Name="TabHeader" ContentSource="Header" RecognizesAccessKey="True"
                                          TextElement.Foreground="{DynamicResource CV.Text.Secondary}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="TabHeader" Property="TextElement.Foreground" Value="{DynamicResource CV.Accent.Primary}" />
                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource CV.Accent.Primary}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TabHeader" Property="TextElement.Foreground" Value="{DynamicResource CV.Accent.Primary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Expander">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource CV.Text.Primary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <StackPanel>
                        <ToggleButton x:Name="HeaderToggle" Style="{x:Null}" Background="Transparent" BorderThickness="0"
                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0,10"
                                      Foreground="{TemplateBinding Foreground}" FontSize="13"
                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                        <DockPanel>
                                            <Path x:Name="Chevron" DockPanel.Dock="Right" Margin="16,0,2,0" Width="8" Height="5"
                                                  VerticalAlignment="Center" Stroke="{DynamicResource CV.Text.Secondary}"
                                                  StrokeThickness="1.4" Data="M 0,0 L 4,4 L 8,0" RenderTransformOrigin="0.5,0.5" />
                                            <ContentPresenter ContentSource="Content" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Chevron" Property="RenderTransform">
                                                <Setter.Value><RotateTransform Angle="180" /></Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource CV.Accent.Primary}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="ExpandedContent" Visibility="Collapsed" Margin="0,8,0,8" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ExpandedContent" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ServiceProgress" TargetType="ProgressBar">
        <Setter Property="Height" Value="4" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Foreground" Value="{DynamicResource CV.Accent.Primary}" />
        <Setter Property="Background" Value="{DynamicResource CV.Surface.Alternate}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="2" />
                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="2" HorizontalAlignment="Left" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="ServicePackagePath">
        <Border Background="{DynamicResource CV.Surface.Control}" CornerRadius="6" Padding="12,9">
            <TextBlock TextTrimming="CharacterEllipsis" ToolTip="{Binding}" Foreground="{DynamicResource CV.Text.Secondary}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="{Binding}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding}" Value="">
                                <Setter Property="Text" Value="{x:Static res:Resources.PackageNotSelected}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>
    </DataTemplate>
</ResourceDictionary>
