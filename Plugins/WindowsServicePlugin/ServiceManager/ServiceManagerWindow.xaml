<Window x:Class="WindowsServicePlugin.ServiceManager.ServiceManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WindowsServicePlugin.ServiceManager"
        xmlns:res="clr-namespace:WindowsServicePlugin.Properties"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance local:ServiceManagerViewModel}"
        Title="{x:Static res:Resources.ServiceManager}" Width="960" Height="640" MinWidth="820" MinHeight="560"
        Background="{DynamicResource CV.Surface.Window}" Foreground="{DynamicResource CV.Text.Primary}"
        FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ResourceDictionary Source="ServiceManagerStyles.xaml" />
    </Window.Resources>
    <Grid Margin="30,28,30,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource ServiceDivider}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{x:Static res:Resources.ServiceManager}" Style="{StaticResource ServiceHeading}" />
                    <TextBlock Text="{x:Static res:Resources.ServiceManagerSubtitle}" Style="{StaticResource ServiceSubtitle}" Margin="0,8,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <Button Content="{x:Static res:Resources.OpenFolder}" Command="{Binding OpenBaseLocationCommand}"
                            ToolTip="{Binding Config.BaseLocation}" Style="{StaticResource ServiceLink}" HorizontalAlignment="Right" />
                    <Button Content="{x:Static res:Resources.ManagementSettings}" Style="{StaticResource ServiceLink}"
                            HorizontalAlignment="Right" Click="OpenActionsMenu">
                        <Button.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="{x:Static res:Resources.SetDirectory}" Command="{Binding SetBasePathCommand}" />
                                <MenuItem Header="{x:Static res:Resources.UpdateConfig}" Command="{Binding UpdateConfigCommand}" />
                                <Separator />
                                <MenuItem Header="{x:Static res:Resources.RefreshStatus}" Command="{Binding RefreshCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" BorderThickness="0" Background="Transparent" Padding="0">
            <TabItem Header="{x:Static res:Resources.CVWindowsService}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Services}" Margin="0,8,0,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource CV.Border.Weak}" BorderThickness="0,0,0,1" Padding="0,20">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                            <WrapPanel>
                                                <TextBlock Text="{Binding DisplayName}" FontSize="17" FontWeight="SemiBold" ToolTip="{Binding ExePath}" />
                                                <TextBlock Text="{Binding VersionText}" Style="{StaticResource ServiceSubtitle}" Margin="10,3,0,0" />
                                            </WrapPanel>
                                            <TextBlock Text="{Binding ServiceName}" Style="{StaticResource ServiceSubtitle}" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource ServiceStatus}" HorizontalAlignment="Right" Margin="0,0,0,10" />
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="{x:Static res:Resources.Start}" Style="{StaticResource ServiceStartAction}"
                                                        Command="{Binding DataContext.ServiceStartCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                <Button Content="{x:Static res:Resources.Stop}" Style="{StaticResource ServiceStopAction}"
                                                        Command="{Binding DataContext.ServiceStopCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                <Button Content="{x:Static res:Resources.Restart}" Margin="8,0,0,0"
                                                        Command="{Binding DataContext.ServiceRestartCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                <Button Content="•••" Margin="8,0,0,0" MinWidth="36" Padding="10,7"
                                                        ToolTip="{x:Static res:Resources.MoreActions}" AutomationProperties.Name="{x:Static res:Resources.MoreActions}"
                                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" Click="OpenActionsMenu">
                                                    <Button.ContextMenu>
                                                        <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                                            <MenuItem Header="{x:Static res:Resources.OpenFolder}" Command="{Binding OpenFolderCommand}"
                                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                            <Separator />
                                                            <MenuItem Header="{x:Static res:Resources.Install}" Command="{Binding ServiceInstallCommand}"
                                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                            <MenuItem Header="{x:Static res:Resources.Uninstall}" Command="{Binding ServiceUninstallCommand}"
                                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                            <MenuItem Header="{x:Static res:Resources.Terminate}" Command="{Binding ServiceTerminateCommand}"
                                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{x:Static res:Resources.MySQL}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,24,0,12">
                        <Border Style="{StaticResource ServiceDivider}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{x:Static res:Resources.MySqlServiceInfo}" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding MySqlManager.Config.ServiceName}" Style="{StaticResource ServiceSubtitle}" Margin="0,8,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock DataContext="{Binding MySqlManager.Config}" Text="{Binding Status}" Style="{StaticResource ServiceStatus}" HorizontalAlignment="Right" Margin="0,0,0,10" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="{x:Static res:Resources.Start}" Command="{Binding MySqlStartCommand}" />
                                        <Button Content="{x:Static res:Resources.Stop}" Command="{Binding MySqlStopCommand}" Margin="8,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Expander Header="{x:Static res:Resources.ConnectionSettings}">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Static res:Resources.Path}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding MySqlManager.Config.ExePath, Mode=OneWay}" IsReadOnly="True" ToolTip="{Binding MySqlManager.Config.ExePath}" />
                                    <Button Grid.Column="2" Content="{x:Static res:Resources.Browse}" Command="{Binding MySqlBrowseCommand}" Margin="10,0,0,0" />
                                </Grid>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Static res:Resources.RootPassword}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding MySqlManager.Config.RootPassword, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="2" Content="{x:Static res:Resources.GenerateRandom}" Command="{Binding MySqlGenerateRandomRootPasswordCommand}" Margin="10,0,0,0" />
                                    <Button Grid.Column="3" Content="{x:Static res:Resources.ApplyRootPassword}" Command="{Binding MySqlApplyRootPasswordCommand}" Margin="8,0,0,0" />
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{x:Static res:Resources.AppUser}" Margin="0,0,0,8" />
                                        <TextBox Text="{Binding MySqlManager.Config.AppUser, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{x:Static res:Resources.AppPassword}" Margin="0,0,0,8" />
                                        <TextBox Text="{Binding MySqlManager.Config.AppPassword, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="{x:Static res:Resources.Database}" Margin="0,0,0,8" />
                                        <TextBox Text="{Binding MySqlManager.Config.Database, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                                <Button Content="{x:Static res:Resources.CreateOrUpdateUser}" Command="{Binding MySqlCreateOrUpdateUserCommand}" HorizontalAlignment="Right" Margin="0,0,0,20" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Static res:Resources.SqlScript}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding MySqlManager.Config.SqlScriptPath, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="2" Content="{x:Static res:Resources.Browse}" Command="{Binding MySqlBrowseSqlScriptCommand}" Margin="10,0,0,0" />
                                    <Button Grid.Column="3" Content="{x:Static res:Resources.RunScript}" Command="{Binding MySqlRunScriptCommand}" Margin="8,0,0,0" />
                                </Grid>
                            </StackPanel>
                        </Expander>
                        <Expander Header="{x:Static res:Resources.ServiceMaintenance}" Margin="0,8,0,0">
                            <WrapPanel>
                                <Button Content="{x:Static res:Resources.ZipFullInstall}" Command="{Binding MySqlInstallZipCommand}" Margin="0,0,8,8" />
                                <Button Content="{x:Static res:Resources.RegisterService}" Command="{Binding MySqlRegisterExistingCommand}" Margin="0,0,8,8" ToolTip="{x:Static res:Resources.RegisterMySqlTooltip}" />
                                <Button Content="{x:Static res:Resources.Uninstall}" Command="{Binding MySqlUninstallCommand}" Margin="0,0,8,8" />
                                <Button Content="{x:Static res:Resources.ResetDatabase}" Command="{Binding MySqlResetDatabaseCommand}" Margin="0,0,0,8" ToolTip="{x:Static res:Resources.ResetDatabaseTooltip}" />
                            </WrapPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{x:Static res:Resources.MQTT}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,24,0,12">
                        <Border Style="{StaticResource ServiceDivider}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{x:Static res:Resources.MqttServiceInfo}" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding MqttManager.Config.ServiceName}" Style="{StaticResource ServiceSubtitle}" Margin="0,8,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock DataContext="{Binding MqttManager.Config}" Text="{Binding Status}" Style="{StaticResource ServiceStatus}" HorizontalAlignment="Right" Margin="0,0,0,10" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="{x:Static res:Resources.Start}" Command="{Binding MqttStartCommand}" />
                                        <Button Content="{x:Static res:Resources.Stop}" Command="{Binding MqttStopCommand}" Margin="8,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Expander Header="{x:Static res:Resources.Path}">
                            <TextBox Text="{Binding MqttManager.Config.ExePath, Mode=OneWay}" IsReadOnly="True" ToolTip="{Binding MqttManager.Config.ExePath}" />
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{x:Static res:Resources.ServiceLog}">
                <local:ServiceOperationLog x:Name="OperationLog" Margin="0,18,0,0" />
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Margin="0,8,0,6" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding ProgressText}" Style="{StaticResource ServiceSubtitle}" Margin="0,0,0,8" />
            <ProgressBar Value="{Binding Progress}" Style="{StaticResource ServiceProgress}" />
        </StackPanel>

        <Border Grid.Row="3" BorderBrush="{DynamicResource CV.Border.Weak}" BorderThickness="0,1,0,0" Padding="0,18,0,0" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Content="{x:Static res:Resources.InstallAndUpdate}" Command="{Binding OpenInstallManagerCommand}"
                        Style="{StaticResource ServiceLink}" HorizontalAlignment="Left" ToolTip="{x:Static res:Resources.OpenInstallManagerToolTip}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="{x:Static res:Resources.OneKeyStop}" Command="{Binding OneKeyStopCommand}" Margin="0,0,10,0" />
                    <Button Content="{x:Static res:Resources.OneKeyStart}" Command="{Binding OneKeyStartCommand}" Style="{StaticResource CV.Button.Primary}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
