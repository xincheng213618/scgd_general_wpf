<Project>
  <PropertyGroup>
	<!-- 官方插件随 x64 宿主构建和打包；ARM64 尚无完整 native/runtime 发布链。 -->
	<Platforms>x64</Platforms>
	<Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <PackageTags>ColorVision</PackageTags>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisMode>Recommended</AnalysisMode>
	<PlatformTarget>x64</PlatformTarget>
	<TargetFrameworks>net10.0-windows</TargetFrameworks>
	<NoWarn>CS8002</NoWarn>
	<EnableWindowsTargeting>true</EnableWindowsTargeting>  
    <SupportsHotReload>false</SupportsHotReload>
  </PropertyGroup>

  <ItemGroup>
	<ColorVisionPlatformRole Include="X64" />
  </ItemGroup>

  <PropertyGroup>   
    <Copyright>Copyright (C) 2025 ColorVision Corporation</Copyright>
    <AssemblyCompany>ColorVision Corp.</AssemblyCompany>
    <AssemblyCopyright>Copyright (C) 2025 ColorVision Corporation</AssemblyCopyright>
    <AssemblyProduct>ColorVision</AssemblyProduct>
    <Company>ColorVision</Company>
    <NeutralLanguage>zh-CN</NeutralLanguage>
	<Authors>xincheng</Authors>
	<PackageProjectUrl>https://github.com/xincheng213618/scgd_general_wpf</PackageProjectUrl>
	<IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
	<RepositoryUrl>https://github.com/xincheng213618/scgd_general_wpf</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
</Project>
