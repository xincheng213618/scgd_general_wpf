<UserControl x:Class="Conoscope.ConoscopeView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Conoscope"
        xmlns:properties="clr-namespace:Conoscope.Properties"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        mc:Ignorable="d"
        Background="{DynamicResource GlobalBackground}" d:Height="720" d:Width="1280" Initialized="Window_Initialized">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Presentation/ConoscopeIcons.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <Style x:Key="PanelHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}"/>
        </Style>
        <Style x:Key="PanelMutedTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}"/>
            <Setter Property="Opacity" Value="0.72"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PanelSurfaceButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource GlobalBorderBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource GlobalBorderBrush1}"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PanelSurfaceToggleStyle" TargetType="ToggleButton">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="MinWidth" Value="68"/>
            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource GlobalBorderBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource GlobalBorderBrush1}"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OverlayToolButtonStyle" TargetType="Button" BasedOn="{StaticResource PanelSurfaceButtonStyle}">
            <Setter Property="Width" Value="36"/>
            <Setter Property="MinWidth" Value="36"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style x:Key="OverlayToolToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource PanelSurfaceToggleStyle}">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="MinWidth" Value="36"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid x:Name="ImageViewHost" Grid.Column="0" Background="#15191F">
            <local:ConoscopeImageHost x:Name="ImageView" />
            <ComboBox x:Name="cbImageCoordinateSystem" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" ToolTip="{x:Static properties:Resources.Con_Category_CoordAxis}" AutomationProperties.Name="{x:Static properties:Resources.Con_Category_CoordAxis}" Width="126" Height="26" SelectedIndex="0" SelectionChanged="cbImageCoordinateSystem_SelectionChanged">
                <ComboBoxItem Content="{x:Static properties:Resources.BtnPolarCoord}" Tag="Polar"/>
                <ComboBoxItem Content="H/V" Tag="HorizontalVertical"/>
                <ComboBoxItem Content="North Polar" Tag="NorthPolar"/>
                <ComboBoxItem Content="East Polar" Tag="EastPolar"/>
            </ComboBox>
            <Border x:Name="PseudoColorLegendPanel" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Padding="6" Background="#DD15191F" BorderBrush="#405F6670" BorderThickness="1" CornerRadius="4" Visibility="Collapsed" IsHitTestVisible="False">
                <StackPanel>
                    <TextBlock x:Name="tbPseudoColorLegendTitle" Foreground="White" FontWeight="SemiBold" Text="Y" HorizontalAlignment="Center" />
                    <TextBlock x:Name="tbPseudoColorLegendMax" Margin="0,6,0,4" Foreground="White" FontSize="11" HorizontalAlignment="Center" Text="0" />
                    <Border Width="18" Height="124" BorderBrush="#55FFFFFF" BorderThickness="1">
                        <Image x:Name="imgPseudoColorLegend" Stretch="Fill" />
                    </Border>
                    <TextBlock x:Name="tbPseudoColorLegendMin" Margin="0,4,0,0" Foreground="White" FontSize="11" HorizontalAlignment="Center" Text="0" />
                </StackPanel>
            </Border>
            <Border x:Name="CoordinateDragOverlay" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,52,0,0" Visibility="Collapsed" IsHitTestVisible="False" Background="#CC202020" BorderBrush="#F28B82" BorderThickness="1" CornerRadius="4" Padding="8,4">
                <TextBlock x:Name="CoordinateDragOverlayText" Foreground="White" FontSize="11" />
            </Border>
            <Border x:Name="FocusToolbarPanel" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8" Padding="3" Background="{DynamicResource GlobalBorderBrush}" BorderBrush="{DynamicResource ButtonBorderBrush}" BorderThickness="1" CornerRadius="6">
                <ToolBar ToolBarTray.IsLocked="True" Background="Transparent" BorderThickness="0" Padding="0">
                    <ToggleButton x:Name="tglFocusCircleMode" ContentTemplate="{StaticResource ConoscopeIcon.Pan}" Style="{StaticResource OverlayToolToggleStyle}" ToolTip="{x:Static properties:Resources.TbEditFocusPointTip}" Checked="tglFocusCircleMode_Checked" Unchecked="tglFocusCircleMode_Unchecked" />
                    <ToggleButton x:Name="tglFocusCircleDrawTool" ContentTemplate="{StaticResource ConoscopeIcon.Circle}" Style="{StaticResource OverlayToolToggleStyle}" ToolTip="{x:Static properties:Resources.TbCircleTip}" IsChecked="False" Checked="tglFocusCircleDrawTool_Checked" Unchecked="tglFocusCircleDrawTool_Unchecked" />
                    <ToggleButton x:Name="tglFocusCircleSelectTool" Style="{StaticResource OverlayToolToggleStyle}" Content="{x:Static properties:Resources.TbEdit}" ToolTip="{x:Static properties:Resources.TbEditTip}" Checked="tglFocusCircleSelectTool_Checked" Unchecked="tglFocusCircleSelectTool_Unchecked" Visibility="Collapsed" />
                    <ToggleButton x:Name="tglFocusCircleEraseTool" ContentTemplate="{StaticResource ConoscopeIcon.Eraser}" Style="{StaticResource OverlayToolToggleStyle}" ToolTip="{x:Static properties:Resources.TbEraserTip}" Checked="tglFocusCircleEraseTool_Checked" Unchecked="tglFocusCircleEraseTool_Unchecked" />
                    <Separator/>
                    <Button x:Name="btnCircleFit" ContentTemplate="{StaticResource ConoscopeIcon.Fit}" Style="{StaticResource OverlayToolButtonStyle}" ToolTip="{x:Static properties:Resources.TbCircleFitTip}" Click="btnCircleFit_Click" />
                    <Button x:Name="btnCalculateFocusCircles" ContentTemplate="{StaticResource ConoscopeIcon.Calculate}" Style="{StaticResource OverlayToolButtonStyle}" ToolTip="{x:Static properties:Resources.TbCalcTip}" Click="btnCalculateFocusCircles_Click" />
                    <Button x:Name="btnClearFocusCircles" Style="{StaticResource OverlayToolButtonStyle}" Content="{x:Static properties:Resources.TbClearAll}" ToolTip="{x:Static properties:Resources.TbClearAllTip}" Click="btnClearFocusCircles_Click" Visibility="Collapsed" />
                    <Separator Visibility="Collapsed"/>
                    <TextBlock x:Name="tbSelectedFocusPointInfo" Width="280" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Visibility="Collapsed" Foreground="{DynamicResource GlobalTextBrush}" ToolTip="{x:Static properties:Resources.TipSelectedFocusPoint}" />
                    <Separator x:Name="sepSelectedFocusPointInfo" Visibility="Collapsed"/>
                    <ComboBox x:Name="cbFocusPoiTemplate" Width="118" Height="28" DisplayMemberPath="Key" SelectedValuePath="Value" ToolTip="{x:Static properties:Resources.TipFocusPoiTemplate}" SelectionChanged="cbFocusPoiTemplate_SelectionChanged"/>
                    <Button x:Name="btnSaveFocusPoiTemplate" ContentTemplate="{StaticResource ConoscopeIcon.Save}" Style="{StaticResource OverlayToolButtonStyle}" ToolTip="{x:Static properties:Resources.TipSaveFocusPoiTemplate}" Click="btnSaveFocusPoiTemplate_Click" />
                    <Button x:Name="btnManageFocusPoiTemplate" Style="{StaticResource OverlayToolButtonStyle}" Content="POI" ToolTip="{x:Static properties:Resources.TipManageFocusPoiTemplate}" Click="btnManageFocusPoiTemplate_Click" Visibility="Collapsed" />
                </ToolBar>
            </Border>
        </Grid>

        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="{DynamicResource GlobalBorderBrush}" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="True"/>

        <Border Grid.Column="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,5">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                            <Button x:Name="btnCaptureCurve" ContentTemplate="{StaticResource ConoscopeIcon.Save}" ToolTip="{x:Static properties:Resources.BtnCaptureCurve}" AutomationProperties.Name="{x:Static properties:Resources.BtnCaptureCurve}" Click="btnCaptureCurve_Click" Style="{StaticResource OverlayToolButtonStyle}" Margin="0,0,4,0"/>
                            <Button x:Name="btnShowSnapshots" ContentTemplate="{StaticResource ConoscopeIcon.Calculate}" ToolTip="{x:Static properties:Resources.TitleCurveSnapshots}" AutomationProperties.Name="{x:Static properties:Resources.TitleCurveSnapshots}" Click="btnShowSnapshots_Click" Style="{StaticResource OverlayToolButtonStyle}" Margin="0,0,8,0"/>
                            <ToggleButton x:Name="tglReferencePolarMode" Content="{x:Static properties:Resources.BtnPolarCoord}" Style="{StaticResource PanelSurfaceToggleStyle}" Checked="tglReferencePolarMode_Checked" Unchecked="tglReferencePolarMode_Unchecked" Margin="0,0,8,0"/>
                            <Button Content="{x:Static properties:Resources.BtnExportCurrent}" Click="btnExportCurrentReference_Click" Style="{StaticResource PanelSurfaceButtonStyle}"/>
                        </StackPanel>
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="{x:Static properties:Resources.LabelRefCurve}" Style="{StaticResource PanelHeaderTextStyle}" Margin="0,0,16,0"/>
                            <TextBlock x:Name="tbReferenceMode" Style="{StaticResource PanelMutedTextStyle}" Margin="0,0,8,0"/>
                            <TextBlock x:Name="tbReferenceValue" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource GlobalTextBrush}"/>
                        </WrapPanel>
                    </DockPanel>
                </Border>
                <Grid Grid.Row="1">
                    <ScottPlot:WpfPlot x:Name="wpfPlotReference" Margin="5" />
                    <local:ConoscopePolarPlot x:Name="polarPlotReference" Margin="5" Visibility="Collapsed"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
