<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- All icons share a 24-unit canvas and inherit the host control's foreground. -->
    <Style x:Key="Conoscope.IconStroke" TargetType="Path">
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}}" />
        <Setter Property="StrokeThickness" Value="1.6" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="Fill" Value="Transparent" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style x:Key="Conoscope.IconAccentStroke" TargetType="Path" BasedOn="{StaticResource Conoscope.IconStroke}">
        <Setter Property="Stroke" Value="{DynamicResource PrimaryBrush}" />
    </Style>

    <DataTemplate x:Key="ConoscopeIcon.Curves">
        <Viewbox Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Path Style="{StaticResource Conoscope.IconStroke}" Data="M3 4 V20 H21 M6 16 C9 16 9 7 13 7 C17 7 17 16 21 16" />
                <Path Style="{StaticResource Conoscope.IconAccentStroke}" Data="M6 17 C10 17 11 11 15 11 C18 11 19 14 21 14" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="ConoscopeIcon.CaptureCurve">
        <Viewbox Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Path Style="{StaticResource Conoscope.IconStroke}" Data="M3 4 V20 H21 M6 16 C9 16 9 8 12 8 C15 8 15 16 18 16" />
                <Path Style="{StaticResource Conoscope.IconAccentStroke}" Data="M19 3 V9 M16 6 H22" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="ConoscopeIcon.Open">
        <Viewbox Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Path Style="{StaticResource Conoscope.IconStroke}" Data="M3 10 V6.5 A1.5 1.5 0 0 1 4.5 5 H9 L11 7 H18.5 A1.5 1.5 0 0 1 20 8.5 V10" />
                <Path Style="{StaticResource Conoscope.IconStroke}" Data="M3 10 H21 L18.8 18.2 A1.7 1.7 0 0 1 17.2 19.5 H6.1 A1.7 1.7 0 0 1 4.4 18.1 Z" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="ConoscopeIcon.Camera">
        <Viewbox Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Path Style="{StaticResource Conoscope.IconStroke}" Data="M4.5 7.5 H8 L9.5 5 H14.5 L16 7.5 H19.5 A1.5 1.5 0 0 1 21 9 V18 A1.5 1.5 0 0 1 19.5 19.5 H4.5 A1.5 1.5 0 0 1 3 18 V9 A1.5 1.5 0 0 1 4.5 7.5 Z" />
                <Path Style="{StaticResource Conoscope.IconAccentStroke}" Data="M15.5 13.5 A3.5 3.5 0 1 1 8.5 13.5 A3.5 3.5 0 1 1 15.5 13.5" />
                <Path Style="{StaticResource Conoscope.IconStroke}" Data="M17.5 10 H18" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="ConoscopeIcon.Run">
        <Viewbox Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Path Style="{StaticResource Conoscope.IconStroke}" Data="M8 4.5 L19.5 12 L8 19.5 Z" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="ConoscopeIcon.Refresh">
        <Viewbox Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Path Style="{StaticResource Conoscope.IconStroke}" Data="M19.5 8 A8 8 0 1 0 20 14 M19.5 3.5 V8.5 H14.5" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="ConoscopeIcon.Settings">
        <Viewbox Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Path Style="{StaticResource Conoscope.IconStroke}" Data="M10 3 H14 L14.6 5.4 L16.2 6.3 L18.6 5.7 L20.6 9.2 L18.8 11 V13 L20.6 14.8 L18.6 18.3 L16.2 17.7 L14.6 18.6 L14 21 H10 L9.4 18.6 L7.8 17.7 L5.4 18.3 L3.4 14.8 L5.2 13 V11 L3.4 9.2 L5.4 5.7 L7.8 6.3 L9.4 5.4 Z M15.2 12 A3.2 3.2 0 1 1 8.8 12 A3.2 3.2 0 1 1 15.2 12" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="ConoscopeIcon.Cube">
        <Viewbox Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Path Style="{StaticResource Conoscope.IconStroke}" Data="M12 3 L20.5 7.8 V16.2 L12 21 L3.5 16.2 V7.8 Z M12 12.6 V21" />
                <Path Style="{StaticResource Conoscope.IconAccentStroke}" Data="M3.5 7.8 L12 12.6 L20.5 7.8" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="ConoscopeIcon.Cie">
        <Viewbox Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Path Style="{StaticResource Conoscope.IconStroke}" Data="M4 20 H21 M4 20 V3" />
                <Path Style="{StaticResource Conoscope.IconStroke}" Data="M6.5 17.5 C4 12 8.3 3.8 11.8 4.2 C14.4 4.5 14.5 10.4 20 15.8 L6.5 17.5 Z" />
                <Path Style="{StaticResource Conoscope.IconAccentStroke}" Data="M7.5 16.6 L11 7.5 L18 15.6 Z" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="ConoscopeIcon.ExportAzimuth">
        <Viewbox Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Path Style="{StaticResource Conoscope.IconStroke}" Data="M17 10 A7 7 0 1 1 3 10 A7 7 0 1 1 17 10 M3 10 H17 M10 10 L13.5 3.9" />
                <Path Style="{StaticResource Conoscope.IconAccentStroke}" Data="M13.5 19 H21 M18 16 L21 19 L18 22" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="ConoscopeIcon.ExportPolar">
        <Viewbox Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Path Style="{StaticResource Conoscope.IconStroke}" Data="M17 10 A7 7 0 1 1 3 10 A7 7 0 1 1 17 10 M13.3 10 A3.3 3.3 0 1 1 6.7 10 A3.3 3.3 0 1 1 13.3 10 M10 3 V6.7 M13.3 10 H17" />
                <Path Style="{StaticResource Conoscope.IconAccentStroke}" Data="M13.5 19 H21 M18 16 L21 19 L18 22" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="ConoscopeIcon.ExportAdvanced">
        <Viewbox Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Path Style="{StaticResource Conoscope.IconStroke}" Data="M10.5 21 H5 A1.5 1.5 0 0 1 3.5 19.5 V4.5 A1.5 1.5 0 0 1 5 3 H13 L18.5 8.5 V13 M13 3 V8.5 H18.5 M7 11.5 H14.5 M7 15 H11" />
                <Path Style="{StaticResource Conoscope.IconAccentStroke}" Data="M13.5 19 H21 M18 16 L21 19 L18 22" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="ConoscopeIcon.Select">
        <Viewbox Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Path Style="{StaticResource Conoscope.IconStroke}" Data="M5 3 L20 13 L13 14 L10 21 Z M13 14 L18 21" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="ConoscopeIcon.Pan">
        <Viewbox Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Path Style="{StaticResource Conoscope.IconStroke}" Data="M12 3 V21 M3 12 H21 M9 6 L12 3 L15 6 M18 9 L21 12 L18 15 M9 18 L12 21 L15 18 M6 9 L3 12 L6 15" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="ConoscopeIcon.Circle">
        <Viewbox Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Path Style="{StaticResource Conoscope.IconStroke}" Data="M20 12 A8 8 0 1 1 4 12 A8 8 0 1 1 20 12" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="ConoscopeIcon.Eraser">
        <Viewbox Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Path Style="{StaticResource Conoscope.IconStroke}" Data="M4.2 12.8 L13.5 3.5 A1.5 1.5 0 0 1 15.6 3.5 L20.5 8.4 A1.5 1.5 0 0 1 20.5 10.5 L11.5 19.5 H8.5 L4.2 15.2 A1.7 1.7 0 0 1 4.2 12.8 Z M8 9 L15 16 M11.5 19.5 H21" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="ConoscopeIcon.Fit">
        <Viewbox Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Path Style="{StaticResource Conoscope.IconStroke}" Data="M3 8 V3 H8 M16 3 H21 V8 M21 16 V21 H16 M8 21 H3 V16" />
                <Path Style="{StaticResource Conoscope.IconAccentStroke}" Data="M16.5 12 A4.5 4.5 0 1 1 7.5 12 A4.5 4.5 0 1 1 16.5 12" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="ConoscopeIcon.Calculate">
        <Viewbox Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Path Style="{StaticResource Conoscope.IconStroke}" Data="M6 2.5 H18 A1.5 1.5 0 0 1 19.5 4 V20 A1.5 1.5 0 0 1 18 21.5 H6 A1.5 1.5 0 0 1 4.5 20 V4 A1.5 1.5 0 0 1 6 2.5 Z M8 6.5 H16 V9 H8 Z M8 13 H10 M9 12 V14 M14 13 H16 M8 17 H10 M14 16.5 H16 M14 18.5 H16" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="ConoscopeIcon.Save">
        <Viewbox Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Path Style="{StaticResource Conoscope.IconStroke}" Data="M5 3.5 H16.5 L20.5 7.5 V19 A1.5 1.5 0 0 1 19 20.5 H5 A1.5 1.5 0 0 1 3.5 19 V5 A1.5 1.5 0 0 1 5 3.5 Z M7.5 3.5 V9 H15.5 V3.5 M7.5 20.5 V14 H16.5 V20.5 M13 6 V7" />
            </Canvas>
        </Viewbox>
    </DataTemplate>
</ResourceDictionary>
