<Window x:Class="Conoscope.Presentation.ConoscopeCurveSnapshotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:properties="clr-namespace:Conoscope.Properties"
        xmlns:scottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="{x:Static properties:Resources.TitleCurveSnapshots}"
        Width="1180" Height="760" MinWidth="900" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource GlobalBackground}"
        Foreground="{DynamicResource GlobalTextBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12">
            <WrapPanel>
                <Button Content="{x:Static properties:Resources.CurveSessionImport}" Padding="12,6" Margin="0,0,8,8" Click="ImportSession_Click"/>
                <Button Content="{x:Static properties:Resources.CurveSessionSave}" Padding="12,6" Margin="0,0,16,8" Click="SaveSession_Click"/>
                <Button x:Name="DeleteSnapshotButton" Content="{x:Static properties:Resources.SnapshotDeleteSelected}"
                        Padding="12,6" Margin="0,0,8,8" IsEnabled="False" Click="DeleteSnapshot_Click"/>
                <Button x:Name="ExportSnapshotButton" Content="{x:Static properties:Resources.SnapshotExportSelected}"
                        Padding="12,6" Margin="0,0,0,8" IsEnabled="False" Click="ExportSnapshot_Click"/>
            </WrapPanel>
            <TextBlock Text="{x:Static properties:Resources.SnapshotSessionHint}" TextWrapping="Wrap"
                       Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{DynamicResource CV.Text.Secondary}"/>
            <CheckBox x:Name="NormalizeCurves" Content="{x:Static properties:Resources.CurveNormalize}" Margin="0,8,0,0"
                      ToolTip="{x:Static properties:Resources.CurveNormalizeHint}" Checked="NormalizeCurves_Changed" Unchecked="NormalizeCurves_Changed"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350" MinWidth="250"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*" MinWidth="440"/>
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="4*" MinHeight="180"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2*" MinHeight="120"/>
                </Grid.RowDefinitions>
                <ListBox x:Name="SnapshotList" SelectionMode="Single"
                         SelectionChanged="SnapshotList_SelectionChanged"
                         HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsShown, Mode=TwoWay}" Margin="0,0,8,0" VerticalAlignment="Center"
                                          ToolTip="{x:Static properties:Resources.SnapshotVisible}"
                                          AutomationProperties.Name="{x:Static properties:Resources.SnapshotVisible}"/>
                                <Ellipse Grid.Column="1" Width="8" Height="8" Fill="{Binding ColorBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Description}" FontSize="11" Margin="0,3,0,0"
                                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource CV.Text.Secondary}"/>
                                    <TextBlock Text="{Binding MetricSummary}" FontSize="11" Margin="0,3,0,0" ToolTip="{Binding MetricDetails}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding MetricSummary}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="1" Margin="0,14,0,10">
                    <TextBlock Text="{x:Static properties:Resources.Con_FP_Name}" Margin="0,0,0,5"/>
                    <TextBox x:Name="SnapshotName" Text="{Binding SelectedItem.Name, ElementName=SnapshotList, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                             KeyDown="SnapshotName_KeyDown" Padding="6,4"/>
                    <TextBlock Text="{x:Static properties:Resources.SnapshotRenameHint}" TextWrapping="Wrap" FontSize="11"
                               Margin="0,5,0,0" Foreground="{DynamicResource CV.Text.Secondary}"/>
                </StackPanel>

                <Border Grid.Row="2" BorderBrush="{DynamicResource CV.Border.Weak}" BorderThickness="1" CornerRadius="4" Padding="8">
                    <TextBox Text="{Binding SelectedItem.Details, ElementName=SnapshotList, Mode=OneWay}"
                             IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             BorderThickness="0" Background="Transparent"/>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="Transparent"/>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="8,0,0,8">
                    <TextBlock Text="{x:Static properties:Resources.SnapshotCompatibilityHint}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ComparisonSummary" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="11"
                               Foreground="{DynamicResource CV.Text.Secondary}"/>
                    <TextBlock x:Name="SelectedCurveContext" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <TextBlock x:Name="SelectedCurveMetrics" TextWrapping="Wrap" Margin="0,8,0,0"
                               ToolTip="{x:Static properties:Resources.FwhmRule}"/>
                </StackPanel>
                <Border Grid.Row="1" BorderBrush="{DynamicResource CV.Border.Weak}" BorderThickness="1" CornerRadius="4">
                    <Grid>
                        <scottPlot:WpfPlot x:Name="SnapshotPlot"/>
                        <TextBlock x:Name="EmptyHint" Text="{x:Static properties:Resources.SnapshotEmptyHint}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="24"
                                   Foreground="{DynamicResource CV.Text.Secondary}" IsHitTestVisible="False"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
