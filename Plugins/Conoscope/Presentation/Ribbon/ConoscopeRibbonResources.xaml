<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:properties="clr-namespace:Conoscope.Properties">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../ConoscopeIcons.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Thickness x:Key="RibbonTabContentMargin">4,3,4,3</Thickness>

    <DataTemplate x:Key="DocumentHeaderTemplate">
        <StackPanel Orientation="Horizontal">
            <TextBlock Style="{x:Null}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>

    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="RibbonTabItemStyle" TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource CV.Text.Secondary}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid Background="Transparent">
                        <Border x:Name="HeaderSurface" Background="Transparent" CornerRadius="5,5,0,0">
                            <ContentPresenter x:Name="HeaderContent" ContentSource="Header" Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <Border x:Name="SelectionIndicator" Height="2" Margin="13,0" VerticalAlignment="Bottom"
                                Background="{DynamicResource CV.Accent.Primary}" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HeaderSurface" Property="Background" Value="{DynamicResource CV.Surface.ControlHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource CV.Text.Primary}" />
                            <Setter TargetName="HeaderContent" Property="TextElement.FontWeight" Value="SemiBold" />
                            <Setter TargetName="HeaderSurface" Property="Background" Value="{DynamicResource CV.Surface.Control}" />
                            <Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RibbonTabControlStyle" TargetType="TabControl">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource RibbonTabItemStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <ToggleButton x:Name="RibbonCollapseButton" DockPanel.Dock="Right" Width="28" Height="24" Margin="4,0"
                                          Background="Transparent" BorderBrush="Transparent" Foreground="{DynamicResource CV.Text.Secondary}"
                                          IsChecked="False" ToolTip="{x:Static properties:Resources.RibbonCollapseCommands}"
                                          AutomationProperties.Name="{x:Static properties:Resources.RibbonCollapseCommands}">
                                <Path x:Name="RibbonChevron" Data="M 0 5 L 4 1 L 8 5" Width="8" Height="6"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                      StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </ToggleButton>
                            <TabPanel IsItemsHost="True" Margin="6,0" KeyboardNavigation.TabIndex="1" />
                        </DockPanel>
                        <Border x:Name="RibbonCommands" Grid.Row="1" Background="{DynamicResource CV.Surface.Control}" BorderBrush="{DynamicResource CV.Border.Weak}" BorderThickness="0,1,0,0">
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger SourceName="RibbonCollapseButton" Property="IsChecked" Value="True">
                            <Setter TargetName="RibbonCommands" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RibbonChevron" Property="Data" Value="M 0 1 L 4 5 L 8 1" />
                            <Setter TargetName="RibbonCollapseButton" Property="ToolTip" Value="{x:Static properties:Resources.RibbonExpandCommands}" />
                            <Setter TargetName="RibbonCollapseButton" Property="AutomationProperties.Name" Value="{x:Static properties:Resources.RibbonExpandCommands}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="QuickButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Padding" Value="10,2" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="RibbonGroupStyle" TargetType="Border">
        <Setter Property="MinHeight" Value="78" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Padding" Value="6,1,6,1" />
        <Setter Property="BorderBrush" Value="{DynamicResource CV.Border.Weak}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style x:Key="RibbonGroupHeaderStyle" TargetType="TextBlock">
        <Setter Property="Visibility" Value="Visible" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="{DynamicResource CV.Text.Secondary}" />
        <Setter Property="Margin" Value="2,3,0,0" />
    </Style>

    <Style x:Key="RibbonFieldLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource CV.Text.Secondary}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="RibbonButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="MinWidth" Value="38" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource CV.Surface.Control}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CV.Border.Weak}" />
        <Setter Property="Foreground" Value="{DynamicResource CV.Text.Primary}" />
    </Style>

    <Style x:Key="RibbonLargeButtonStyle" TargetType="Button" BasedOn="{StaticResource RibbonButtonStyle}">
        <Setter Property="ToolTipService.ShowDuration" Value="12000" />
    </Style>

    <Style x:Key="RibbonPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource RibbonLargeButtonStyle}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="{DynamicResource CV.Tag.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CV.Tag.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource CV.Accent.Primary}" />
    </Style>

    <Style x:Key="RibbonTallButtonStyle" TargetType="Button" BasedOn="{StaticResource RibbonLargeButtonStyle}">
        <Setter Property="MinWidth" Value="62" />
        <Setter Property="MinHeight" Value="60" />
        <Setter Property="Padding" Value="9,5" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style x:Key="RibbonTallPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource RibbonTallButtonStyle}">
        <Setter Property="Foreground" Value="{DynamicResource CV.Accent.Primary}" />
        <Setter Property="Background" Value="{DynamicResource CV.Tag.Background}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="RibbonVectorIconStyle" TargetType="ContentControl">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <Style x:Key="RibbonCompactVectorIconStyle" TargetType="ContentControl" BasedOn="{StaticResource RibbonVectorIconStyle}">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
    </Style>

    <Style x:Key="RibbonTallCaptionStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Margin" Value="0,5,0,0" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <Style x:Key="RibbonExecuteButtonStyle" TargetType="Button" BasedOn="{StaticResource RibbonPrimaryButtonStyle}">
        <Setter Property="MinWidth" Value="74" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Background" Value="#FF17874E" />
        <Setter Property="BorderBrush" Value="#FF0F663A" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style x:Key="RibbonSmallButtonStyle" TargetType="Button" BasedOn="{StaticResource RibbonButtonStyle}">
        <Setter Property="MinWidth" Value="0" />
    </Style>

    <Style x:Key="RibbonIconTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
    </Style>

    <Style x:Key="RibbonButtonCaptionStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="5,0,0,0" />
    </Style>

    <Style x:Key="RibbonExecuteButtonIconStyle" TargetType="TextBlock" BasedOn="{StaticResource RibbonIconTextStyle}">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style x:Key="RibbonExecuteButtonCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource RibbonButtonCaptionStyle}">
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style x:Key="RibbonInlineButtonContentStyle" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="RibbonComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource ComboBox.Small}">
        <Setter Property="Height" Value="28" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="RibbonTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Height" Value="28" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="RibbonTabScrollViewerStyle" TargetType="ScrollViewer">
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Focusable" Value="False" />
    </Style>

    <Style x:Key="RibbonTabContentPanelStyle" TargetType="StackPanel">
        <Setter Property="Margin" Value="{StaticResource RibbonTabContentMargin}" />
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <Style x:Key="StatusPillStyle" TargetType="Border">
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource GlobalBorderBrush}" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style x:Key="CompactRibbonGroupHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource RibbonGroupHeaderStyle}">
        <Setter Property="FontSize" Value="9.5" />
        <Setter Property="Margin" Value="0,3,0,0" />
    </Style>

    <Style x:Key="CompactStatusPillStyle" TargetType="Border" BasedOn="{StaticResource StatusPillStyle}">
        <Setter Property="Padding" Value="5,1" />
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="CornerRadius" Value="3" />
    </Style>

    <Style x:Key="CompactStatusTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{DynamicResource CV.Text.Secondary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="ReferenceModeRadioStyle" TargetType="RadioButton">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3">
                        <ContentPresenter Margin="6,4"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource CV.Accent.Primary}" />
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource CV.Tag.Background}" />
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource CV.Accent.Primary}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource GlobalTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource CV.Accent.Primary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
