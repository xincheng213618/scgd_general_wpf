<Window x:Class="Conoscope.Presentation.ConoscopeExportProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:properties="clr-namespace:Conoscope.Properties"
        Title="{x:Static properties:Resources.BtnExport}" Width="620" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource GlobalBackground}" Foreground="{DynamicResource GlobalTextBrush}">
    <StackPanel Margin="24">
        <TextBlock x:Name="StatusText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock x:Name="FileText" Margin="0,12,0,12" TextWrapping="Wrap"/>
        <ProgressBar x:Name="ExportProgress" Height="20" Maximum="100"/>
        <TextBlock x:Name="ProgressText" Margin="0,10,0,0" TextWrapping="Wrap"/>
        <TextBlock Text="{x:Static properties:Resources.ExportCancelHint}" Foreground="{DynamicResource CV.Text.Secondary}"
                   Margin="0,12,0,20" TextWrapping="Wrap"/>
        <Button x:Name="CancelButton" Content="{x:Static properties:Resources.BtnCancel}" Padding="22,6"
                HorizontalAlignment="Right" Click="Cancel_Click"/>
    </StackPanel>
</Window>
