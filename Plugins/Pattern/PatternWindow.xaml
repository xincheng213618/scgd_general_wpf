<Window x:Class="Pattern.PatternWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Pattern"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance local:PatternManager}"
        Title="{x:Static local:PatternText.ChartGenerationTool}" Height="600" Width="616" MinHeight="460" MinWidth="566"
        Background="{DynamicResource GlobalBackground}" WindowStartupLocation="CenterOwner" Initialized="Window_Initialized"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource TextBoxBaseStyle}"/>
        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="Pane" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlobalBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource ButtonDefault}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}, TargetNullValue=操作, FallbackValue=操作}"/>
        </Style>
        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid Margin="6">
        <Grid x:Name="WorkspaceGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LibraryColumn" Width="250" MinWidth="200" MaxWidth="520"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*" MinWidth="330"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Pane}">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="OpenActions_Click" ToolTip="{x:Static local:PatternText.TemplateActions}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE712;"/>
                            <Button.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="{x:Static local:PatternText.TemplateFolder}" Command="{Binding OpenPatternPathCommand}"/>
                                    <MenuItem Header="{x:Static local:PatternText.Import}" Command="{Binding ImportZipCommand}" ToolTip="{x:Static local:PatternText.ImportTemplateZip}"/>
                                    <MenuItem Header="{x:Static local:PatternText.Export}" Command="{Binding ExportZipCommand}" ToolTip="{x:Static local:PatternText.ExportAllTemplatesZip}"/>
                                    <Separator/>
                                    <MenuItem Header="{x:Static local:PatternText.ClearTemplateList}" Command="{Binding ClearTemplatePatternFilesCommand}"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding EditCommand}" ToolTip="{x:Static local:PatternText.EditSettings}" Margin="0,0,4,0">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE713;"/>
                        </Button>
                        <Button x:Name="ThemeToggleButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="ThemeToggleButton_Click"
                                ToolTip="{x:Static local:PatternText.SwitchTheme}" Margin="0,0,4,0">
                            <TextBlock x:Name="ThemeIconText" Style="{StaticResource Icon}" Text="&#xE708;"/>
                        </Button>
                        <TextBlock Text="{x:Static local:PatternText.TemplateLibrary}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding Items.Count, ElementName=ListViewPattern}" Margin="8,0,0,0" Opacity="0.6" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Grid Grid.Row="1" Margin="0,0,0,6">
                        <hc:TextBox x:Name="PatternSearchBox" Style="{DynamicResource TextBoxPlus.Small}" Padding="28,3,6,3" MinHeight="28"
                                    hc:InfoElement.Placeholder="{x:Static local:PatternText.SearchTemplates}" AutomationProperties.Name="{x:Static local:PatternText.SearchTemplates}"/>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" HorizontalAlignment="Left" Margin="8,0,0,0" Opacity="0.6" IsHitTestVisible="False"/>
                    </Grid>
                    <Grid Grid.Row="2">
                        <ListView x:Name="ListViewPattern" Background="Transparent" Padding="0" BorderThickness="0"
                                  SelectionChanged="ListViewPattern_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                  AutomationProperties.Name="{x:Static local:PatternText.TemplateLibrary}">
                            <ListView.Template>
                                <ControlTemplate TargetType="ListView">
                                    <ScrollViewer Focusable="False" CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ListView.Template>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource ListViewItemBaseStyle.Small}">
                                    <Setter Property="ContextMenu" Value="{Binding ContextMenu}"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="6,3"/>
                                    <Setter Property="Margin" Value="0,0,0,1"/>
                                    <Setter Property="ToolTip" Value="{Binding Name}"/>
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ButtonBackground}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ButtonBackground}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:TemplatePatternFile}">
                                    <Grid>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                                   Visibility="{Binding IsEditMode,Converter={StaticResource bool2VisibilityConverter1}}"/>
                                        <TextBox Text="{Binding Name}" LostFocus="TextBox_LostFocus" Tag="{Binding}" Padding="2,0"
                                                 Visibility="{Binding IsEditMode,Converter={StaticResource bool2VisibilityConverter}}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock Text="{x:Static local:PatternText.NoTemplatesFound}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Stretch" Margin="12,32" Opacity="0.6" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Items.Count, ElementName=ListViewPattern}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Border Grid.Row="3" BorderBrush="{DynamicResource GlobalBorderBrush}" BorderThickness="0,1,0,0" Padding="0,6,0,0" Margin="0,6,0,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding OpenSaveFilePathCommand}" Margin="6,0,0,0"
                                    ToolTip="{x:Static local:PatternText.OpenOutputFolder}">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;"/>
                            </Button>
                            <Button Content="{x:Static local:PatternText.GenerateAllTemplateImages}" Click="GenAllTemplate_Click" MinHeight="28"
                                    ToolTip="{x:Static local:PatternText.GenerateAllTemplateImagesTooltip}"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" DragCompleted="LibrarySplitter_DragCompleted"/>
            <Grid x:Name="EditorAndPreview" Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ParameterColumn" Width="330" MinWidth="330"/>
                    <ColumnDefinition x:Name="PreviewGapColumn" Width="0"/>
                    <ColumnDefinition x:Name="PreviewColumn" Width="0"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Pane}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="8,8,8,6">
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="OpenActions_Click" ToolTip="{x:Static local:PatternText.PatternActions}">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE712;"/>
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{x:Static local:PatternText.Reset}" Click="Reset_Click" ToolTip="{x:Static local:PatternText.ResetTooltip}"/>
                                        <MenuItem Header="{x:Static local:PatternText.SaveAsDefault}" Click="SaveAsDefault_Click" ToolTip="{x:Static local:PatternText.SaveCurrentParametersAsDefault}"/>
                                        <MenuItem Header="{x:Static local:PatternText.EditPatternParameters}" Click="Button_Click"/>
                                        <Separator/>
                                        <MenuItem Header="{x:Static local:PatternText.ResetFactoryDefaults}" Click="ResetSaveAsDefault_Click" ToolTip="{x:Static local:PatternText.ResetFactoryDefaultsTooltip}"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <Button DockPanel.Dock="Right" Content="{x:Static local:PatternText.ProjectionTool}" Command="{Binding OpenImageProjectorCommand}"
                                    ToolTip="{x:Static local:PatternText.OpenProjectionTool}" Padding="8,2" Margin="6,0,6,0"/>
                            <TextBlock Text="{x:Static local:PatternText.PatternSettings}" Style="{StaticResource SectionTitle}"/>
                        </DockPanel>
                        <ScrollViewer x:Name="ParameterScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,0,8,8">
                            <StackPanel>
                                <Grid x:Name="ResolutionStackPanel" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition Width="1.6*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="txtWidth" Text="{Binding Width, ValidatesOnExceptions=True}" MinHeight="28" ToolTip="{x:Static local:PatternText.ImageWidth}" AutomationProperties.Name="{x:Static local:PatternText.ImageWidth}"/>
                                    <TextBlock Grid.Column="1" Text="×" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6"/>
                                    <TextBox x:Name="txtHeight" Grid.Column="2" Text="{Binding Height, ValidatesOnExceptions=True}" MinHeight="28" ToolTip="{x:Static local:PatternText.ImageHeight}" AutomationProperties.Name="{x:Static local:PatternText.ImageHeight}"/>
                                    <ComboBox x:Name="cmbResolution" Grid.Column="4" MinHeight="28" hc:InfoElement.Placeholder="{x:Static local:PatternText.ResolutionPreset}"
                                              ToolTip="{x:Static local:PatternText.ResolutionPreset}" AutomationProperties.Name="{x:Static local:PatternText.ResolutionPreset}"/>
                                </Grid>
                                <ComboBox x:Name="cmbPattern1" DisplayMemberPath="Name" MinHeight="28" Margin="0,0,0,8"
                                          ToolTip="{x:Static local:PatternText.PatternType}" AutomationProperties.Name="{x:Static local:PatternText.PatternType}"/>
                                <Border x:Name="PatternEditorGrid"/>
                            </StackPanel>
                        </ScrollViewer>
                        <Border Grid.Row="2" BorderBrush="{DynamicResource GlobalBorderBrush}" BorderThickness="0,1,0,0" Padding="8">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Button Content="{x:Static local:PatternText.SaveToTemplate}" Click="TempSave_Click" MinHeight="32" ToolTip="{x:Static local:PatternText.SaveCurrentParametersToTemplate}"/>
                                    <Button x:Name="GenerateButton" Grid.Column="2" Content="{x:Static local:PatternText.GeneratePattern}" Click="PatternGen_Click" MinHeight="32"
                                            Background="{DynamicResource PrimaryBrush}" BorderBrush="{DynamicResource PrimaryBrush}" Foreground="White" FontWeight="SemiBold"
                                            ToolTip="{x:Static local:PatternText.GenerateCurrentPattern}"/>
                                </Grid>
                                <Border x:Name="OutputActions" Margin="0,8,0,0" BorderBrush="{DynamicResource GlobalBorderBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="OpenActions_Click" ToolTip="{x:Static local:PatternText.ImageOutput}" Margin="8,0,0,0">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE712;"/>
                                            <Button.ContextMenu>
                                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="{x:Static local:PatternText.OpenOutputFolder}" Command="{Binding OpenSaveFilePathCommand}"/>
                                                    <MenuItem Header="{x:Static local:PatternText.ClearOutputDirectory}" Command="{Binding ClearSaveFilePathCommand}"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                        <Button x:Name="SaveImageButton" DockPanel.Dock="Right" Content="{x:Static local:PatternText.SaveAs}" Click="BtnSave_Click" MinHeight="32" Padding="14,4" Margin="8,0,0,0"
                                                IsEnabled="False" ToolTip="{x:Static local:PatternText.SaveAsImageFile}"/>
                                        <ComboBox x:Name="cmbFormat" SelectedValue="{Binding Config.PatternFormat}" DisplayMemberPath="Key" SelectedValuePath="Value" MinHeight="32"
                                                  AutomationProperties.Name="{x:Static local:PatternText.ImageOutput}"/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
                <Border x:Name="PreviewPane" Grid.Column="2" Style="{StaticResource Pane}" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" UseLayoutRounding="False">
                    <Border x:Name="DisplayGrid" ClipToBounds="True"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
