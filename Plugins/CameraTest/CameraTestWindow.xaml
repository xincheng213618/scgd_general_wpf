<Window x:Class="CameraTest.CameraTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:images="clr-namespace:ColorVision.ImageEditor;assembly=ColorVision.ImageEditor"
        xmlns:sfr="clr-namespace:ColorVision.ImageEditor.EditorTools.Algorithms.Calculate.SFR;assembly=ColorVision.ImageEditor"
        xmlns:plots="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="相机生产调试" Width="1500" Height="920" MinWidth="1100" MinHeight="700"
        Background="{DynamicResource GlobalBackground}" Foreground="{DynamicResource PrimaryTextBrush}"
        Closing="Window_Closing" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="14,7"/><Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="MetricText" TargetType="TextBlock">
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="16" Background="{DynamicResource GlobalBackground}">
        <StackPanel DockPanel.Dock="Top">
            <DockPanel Margin="0,0,0,16">
                <TextBlock Text="相机生产调试" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock x:Name="ModeText" Text="单帧调试" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.7"/>
            </DockPanel>
            <WrapPanel Margin="0,0,0,14">
                <Button x:Name="LiveButton" Content="开始实时分析" Style="{StaticResource ActionButton}" Click="Live_Click"/>
                <Button x:Name="StopButton" Content="停止并冻结" Style="{StaticResource ActionButton}" Click="Stop_Click" IsEnabled="False"/>
                <Separator Width="12" Opacity="0"/>
                <Button x:Name="CaptureButton" Content="取图分析" Style="{StaticResource ActionButton}" Click="Capture_Click"/>
                <Button x:Name="OpenButton" Content="打开图像…" Style="{StaticResource ActionButton}" Click="Open_Click"/>
                <Button x:Name="AnalyzeButton" Content="重新分析" Style="{StaticResource ActionButton}" Click="Analyze_Click"/>
                <Button x:Name="ExportButton" Content="导出结果…" Style="{StaticResource ActionButton}" Click="Export_Click"/>
                <Button x:Name="SaveImageButton" Content="保存原图…" Style="{StaticResource ActionButton}" Click="SaveImage_Click"/>
                <Button x:Name="ArchiveButton" Content="记录并存档" Style="{StaticResource ActionButton}" Click="Archive_Click"/>
                <Button Content="存档目录" Style="{StaticResource ActionButton}" Click="ArchiveFolder_Click"/>
            </WrapPanel>
        </StackPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="#55808080" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText" Text="打开图像，或连接相机开始。每个搜索框中应包含一个完整 BMW 靶标。" TextWrapping="Wrap"/>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="480"/></Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="相机" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock x:Name="CameraSummary" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <WrapPanel Margin="0,0,0,10">
                        <Button x:Name="CameraSettingsButton" Content="设置…" Style="{StaticResource ActionButton}" Click="CameraSettings_Click"/>
                        <Button x:Name="DiscoverButton" Content="查找相机" Style="{StaticResource ActionButton}" Click="Discover_Click"/>
                    </WrapPanel>
                    <ComboBox x:Name="CameraIds" Margin="0,0,0,10" SelectionChanged="CameraIds_SelectionChanged" ToolTip="选择发现的相机；也可在设置中手工填写 ID。"/>
                    <WrapPanel Margin="0,0,0,20">
                        <Button x:Name="ConnectButton" Content="连接" Style="{StaticResource ActionButton}" Click="Connect_Click"/>
                        <Button x:Name="DisconnectButton" Content="断开" Style="{StaticResource ActionButton}" Click="Disconnect_Click"/>
                    </WrapPanel>
                    <TextBlock Text="分析设置" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <WrapPanel Margin="0,0,0,10">
                        <Button x:Name="SignalSettingsButton" Content="信号与质量…" Style="{StaticResource ActionButton}" Click="SignalSettings_Click"/>
                        <Button x:Name="MetricSettingsButton" Content="指标…" Style="{StaticResource ActionButton}" Click="MetricSettings_Click"/>
                    </WrapPanel>
                    <TextBlock x:Name="SignalSummary" TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,18"/>
                    <WrapPanel Margin="0,0,0,10">
                        <Button x:Name="ArchiveSettingsButton" Content="存档信息…" Style="{StaticResource ActionButton}" Click="ArchiveSettings_Click"/>
                        <Button x:Name="JudgmentSettingsButton" Content="判定标准…" Style="{StaticResource ActionButton}" Click="JudgmentSettings_Click"/>
                    </WrapPanel>
                    <TextBlock x:Name="ArchiveSummary" TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,16"/>
                    <TextBlock Text="BMW 搜索区域" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock Text="每框一个靶标。可用下方矩形工具或“框选新增”，画完点击“开始分析”。停止实时分析后可编辑。" TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,10"/>
                    <WrapPanel Margin="0,0,0,10">
                        <Button x:Name="AddRegionButton" Content="框选新增" Style="{StaticResource ActionButton}" Click="AddRegion_Click"/>
                        <Button x:Name="RemoveRegionButton" Content="移除" Style="{StaticResource ActionButton}" Click="RemoveRegion_Click"/>
                    </WrapPanel>
                </StackPanel>
                <WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <Button x:Name="LoadProfileButton" Content="加载配置…" Style="{StaticResource ActionButton}" Click="LoadProfile_Click"/>
                    <Button x:Name="SaveProfileButton" Content="保存配置…" Style="{StaticResource ActionButton}" Click="SaveProfile_Click"/>
                </WrapPanel>
                <ListBox x:Name="RegionList" MinHeight="100">
                    <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4"><TextBlock Text="{Binding Id}" FontWeight="SemiBold"/><TextBlock Text="{Binding Bounds}" Opacity="0.7" FontSize="11"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            <GridSplitter Grid.Column="1" Width="4" Background="{DynamicResource GlobalBorderBrush}" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <images:ImageView x:Name="ImageView"/>
                <TextBlock x:Name="FrameText" Grid.Row="1" Text="尚未加载图像" Margin="0,8,0,0" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
            </Grid>
            <GridSplitter Grid.Column="3" Width="4" Background="{DynamicResource GlobalBorderBrush}" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
            <TabControl x:Name="AnalysisTabs" Grid.Column="4">
            <TabItem Header="SFR">
            <Grid Margin="6">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="270"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <WrapPanel Margin="0,0,0,8">
                    <TextBlock Text="通道" Margin="0,0,12,0"/>
                    <CheckBox x:Name="ShowY" Content="Y" IsChecked="True" Margin="0,0,12,0" Click="PlotSettings_Click"/>
                    <CheckBox x:Name="ShowR" Content="R" IsChecked="True" Margin="0,0,12,0" Click="PlotSettings_Click"/>
                    <CheckBox x:Name="ShowG" Content="G" IsChecked="True" Margin="0,0,12,0" Click="PlotSettings_Click"/>
                    <CheckBox x:Name="ShowB" Content="B" IsChecked="True" Margin="0,0,12,0" Click="PlotSettings_Click"/>
                    <ComboBox x:Name="PlotMode" Width="90" SelectedIndex="0" SelectionChanged="PlotMode_SelectionChanged"><ComboBoxItem Content="MTF"/><ComboBoxItem Content="ESF"/><ComboBoxItem Content="LSF"/></ComboBox>
                </WrapPanel>
                <Grid Grid.Row="1">
                    <sfr:SfrSimplePlotControl x:Name="CurvePlot"/>
                    <Border x:Name="EmptyPlot" Background="{DynamicResource GlobalBackground}">
                        <TextBlock Text="选择一条边查看 RGB/Y 曲线" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6"/>
                    </Border>
                </Grid>
                <DataGrid Grid.Row="2" x:Name="Metrics" Margin="0,10,0,0" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="Metrics_SelectionChanged" EnableRowVirtualization="True">
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="ToolTip" Value="{Binding Status}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Background="{TemplateBinding Background}" Padding="0">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="点位" Binding="{Binding Target}" Width="65" ElementStyle="{StaticResource MetricText}"/>
                        <DataGridTextColumn Header="边" Binding="{Binding Edge}" Width="58" ElementStyle="{StaticResource MetricText}"/>
                        <DataGridTextColumn Header="通道" Binding="{Binding Channel}" Width="48" ElementStyle="{StaticResource MetricText}"/>
                        <DataGridTextColumn Header="MTF50" Binding="{Binding Mtf50, StringFormat=F4}" Width="65" ElementStyle="{StaticResource MetricText}"/>
                        <DataGridTextColumn Header="MTF10" Binding="{Binding Mtf10, StringFormat=F4}" Width="65" ElementStyle="{StaticResource MetricText}"/>
                        <DataGridTextColumn x:Name="ResponseColumn" Header="MTF@0.25" Binding="{Binding Response, StringFormat=P1}" Width="100" ElementStyle="{StaticResource MetricText}"/>
                        <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="180" ElementStyle="{StaticResource MetricText}"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="3" Margin="0,12,0,0">
                    <TextBlock Text="{Binding SelectedItem.Status, ElementName=Metrics}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock Text="MTF50 / MTF10 单位：cycles/pixel" Opacity="0.7"/>
                    <TextBlock Text="Y 为相对亮度组合信号（曲线中记为 L）。" TextWrapping="Wrap" Opacity="0.7" Margin="0,5,0,0"/>
                    <TextBlock Text="通道边缘位移见“色差”；当前调试数据可保存为完整存档。" TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel>
            </Grid>
            </TabItem>
            <TabItem Header="色差">
                <Grid Margin="6">
                    <Grid.RowDefinitions><RowDefinition Height="240"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <plots:WpfPlot x:Name="ColorPlot"/>
                    <DataGrid x:Name="ColorMetrics" Grid.Row="1" Margin="0,10,0,10" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="ColorMetrics_SelectionChanged" CellStyle="{Binding CellStyle, ElementName=Metrics}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="点位" Binding="{Binding Target}" Width="70" ElementStyle="{StaticResource MetricText}"/>
                            <DataGridTextColumn Header="边" Binding="{Binding Edge}" Width="60" ElementStyle="{StaticResource MetricText}"/>
                            <DataGridTextColumn Header="通道差" Binding="{Binding Pair}" Width="70" ElementStyle="{StaticResource MetricText}"/>
                            <DataGridTextColumn Header="位移 (px)" Binding="{Binding Shift, StringFormat=F3}" Width="90" ElementStyle="{StaticResource MetricText}"/>
                            <DataGridTextColumn Header="方向" Binding="{Binding Axis}" Width="60" ElementStyle="{StaticResource MetricText}"/>
                            <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="220" ElementStyle="{StaticResource MetricText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2">
                        <TextBlock Text="{Binding SelectedItem.Status, ElementName=ColorMetrics}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock Text="同一位置的 RGB 50% 边缘位移，单位 px。表内为公共法线方向；正号对应原图 +X 或 +Y 分量。" TextWrapping="Wrap" Opacity="0.75"/>
                        <TextBlock Text="包含镜头、传感器和图像处理的综合偏移；不等同于 ΔE、面积色差或纯镜头径向色差。" TextWrapping="Wrap" Opacity="0.75" Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="调焦趋势">
                <DockPanel Margin="6">
                    <StackPanel DockPanel.Dock="Top">
                        <ComboBox x:Name="FocusSelection" SelectionChanged="FocusSelection_Changed" Margin="0,0,0,10"/>
                        <ComboBox x:Name="FocusMetricPicker" SelectedIndex="0" SelectionChanged="FocusSelection_Changed" Margin="0,0,0,10"><ComboBoxItem Content="指定频率 MTF"/><ComboBoxItem Content="MTF50"/></ComboBox>
                        <TextBlock x:Name="FocusReadout" Text="开始实时分析后记录调焦趋势。" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <TextBlock Text="保留本轮最近 300 帧；缺测处断开。峰值仅供调焦参考，不代表已到最佳焦点。" TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,10"/>
                        <WrapPanel>
                            <Button x:Name="ClearFocusButton" Content="清空本轮" Style="{StaticResource ActionButton}" Click="ClearFocus_Click"/>
                            <Button x:Name="ExportFocusButton" Content="导出调焦记录…" Style="{StaticResource ActionButton}" Click="ExportFocus_Click"/>
                        </WrapPanel>
                    </StackPanel>
                    <plots:WpfPlot x:Name="FocusPlot"/>
                </DockPanel>
            </TabItem>
            <TabItem Header="判定">
                <DockPanel Margin="6">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock x:Name="VerdictText" Text="未分析" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <TextBlock Text="判定为可选功能。未设标准、未知编码、缺通道或无效测量不会显示为合格。" TextWrapping="Wrap" Opacity="0.75"/>
                    </StackPanel>
                    <DataGrid x:Name="JudgmentMetrics" IsReadOnly="True" AutoGenerateColumns="False" CellStyle="{Binding CellStyle, ElementName=Metrics}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="点位 / 边" Binding="{Binding Target}" Width="70" ElementStyle="{StaticResource MetricText}"/>
                            <DataGridTextColumn Header="边" Binding="{Binding Edge}" Width="60" ElementStyle="{StaticResource MetricText}"/>
                            <DataGridTextColumn Header="通道" Binding="{Binding Channel}" Width="65" ElementStyle="{StaticResource MetricText}"/>
                            <DataGridTextColumn Header="指标" Binding="{Binding Metric}" Width="110" ElementStyle="{StaticResource MetricText}"/>
                            <DataGridTextColumn Header="值" Binding="{Binding Value, StringFormat=F4}" Width="65" ElementStyle="{StaticResource MetricText}"/>
                            <DataGridTextColumn Header="阈值" Binding="{Binding Limit, StringFormat=F4}" Width="65" ElementStyle="{StaticResource MetricText}"/>
                            <DataGridTextColumn Header="判定" Binding="{Binding Status}" Width="85" ElementStyle="{StaticResource MetricText}"/>
                            <DataGridTextColumn Header="原因" Binding="{Binding Reason}" Width="220" ElementStyle="{StaticResource MetricText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
