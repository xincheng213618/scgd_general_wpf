<Window x:Class="CameraTest.CameraTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:images="clr-namespace:ColorVision.ImageEditor;assembly=ColorVision.ImageEditor"
        xmlns:sfr="clr-namespace:ColorVision.ImageEditor.EditorTools.Algorithms.Calculate.SFR;assembly=ColorVision.ImageEditor"
        xmlns:plots="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="相机生产调试" Width="1500" Height="920" MinWidth="1100" MinHeight="700"
        Background="{DynamicResource GlobalBackground}" Foreground="{DynamicResource PrimaryTextBrush}"
        Closing="Window_Closing" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="12,5"/><Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="MinHeight" Value="30"/><Setter Property="BorderBrush" Value="{DynamicResource CV.Border.Weak}"/>
        </Style>
        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/><Setter Property="Margin" Value="0"/>
        </Style>
        <Style x:Key="CameraCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="26"/><Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="6,2"/><Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="ResultGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource CV.Surface.Control}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="RowBackground" Value="{DynamicResource CV.Surface.Control}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource CV.Surface.Alternate}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CV.Border.Weak}"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="RowHeight" Value="30"/>
            <Setter Property="ColumnHeaderHeight" Value="32"/><Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/><Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="ClipboardCopyMode" Value="IncludeHeader"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="ColumnHeaderStyle"><Setter.Value><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource CV.Surface.Alternate}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/><Setter Property="Padding" Value="6,4"/></Style></Setter.Value></Setter>
        </Style>
        <Style x:Key="MetricText" TargetType="TextBlock">
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="ChannelMetricText" TargetType="TextBlock" BasedOn="{StaticResource MetricText}">
            <Style.Triggers>
                <Trigger Property="Text" Value="未通过"><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="YMetricText" TargetType="TextBlock" BasedOn="{StaticResource ChannelMetricText}"><Setter Property="ToolTip" Value="{Binding YHint}"/></Style>
        <Style x:Key="RMetricText" TargetType="TextBlock" BasedOn="{StaticResource ChannelMetricText}"><Setter Property="ToolTip" Value="{Binding RHint}"/></Style>
        <Style x:Key="GMetricText" TargetType="TextBlock" BasedOn="{StaticResource ChannelMetricText}"><Setter Property="ToolTip" Value="{Binding GHint}"/></Style>
        <Style x:Key="BMetricText" TargetType="TextBlock" BasedOn="{StaticResource ChannelMetricText}"><Setter Property="ToolTip" Value="{Binding BHint}"/></Style>
        <Style x:Key="EdgeButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Padding" Value="6,5"/><Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Background" Value="{DynamicResource CV.Surface.Alternate}"/>
            <Setter Property="ToolTip" Value="查看此边的曲线与数值"/>
        </Style>
        <Style x:Key="EdgeReadout" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <DockPanel Background="{DynamicResource GlobalBackground}">
        <StackPanel DockPanel.Dock="Top">
            <Border BorderBrush="{DynamicResource CV.Border.Weak}" BorderThickness="0,0,0,1">
                <Menu x:Name="MainMenu" Padding="8,2" Background="Transparent">
                    <MenuItem Header="文件(_F)">
                        <MenuItem Header="打开图像…" Click="Open_Click" IsEnabled="{Binding IsEnabled, ElementName=OpenButton}"/>
                        <MenuItem x:Name="SaveImageMenuItem" Header="保存原图…" Click="SaveImage_Click"/>
                        <MenuItem x:Name="ExportMenuItem" Header="导出分析结果…" Click="Export_Click"/>
                        <Separator/>
                        <MenuItem x:Name="LoadProfileMenuItem" Header="加载检测配置…" Click="LoadProfile_Click"/>
                        <MenuItem x:Name="SaveProfileMenuItem" Header="保存检测配置…" Click="SaveProfile_Click"/>
                        <Separator/><MenuItem Header="退出" Click="Exit_Click"/>
                    </MenuItem>
                    <MenuItem Header="相机(_C)">
                        <MenuItem Header="查找相机" Click="Discover_Click" IsEnabled="{Binding IsEnabled, ElementName=DiscoverButton}"/>
                        <MenuItem Header="连接" Click="Connect_Click" IsEnabled="{Binding IsEnabled, ElementName=ConnectButton}"/>
                        <MenuItem Header="断开" Click="Disconnect_Click" IsEnabled="{Binding IsEnabled, ElementName=DisconnectButton}"/>
                        <MenuItem x:Name="VideoSettingsMenuItem" Header="视频分析设置…" Click="VideoSettings_Click"/>
                        <Separator/><MenuItem Header="相机参数" Click="CameraSettings_Click" IsEnabled="{Binding IsEnabled, ElementName=CameraSettingsButton}"/>
                    </MenuItem>
                    <MenuItem Header="分析(_A)">
                        <MenuItem Header="{Binding Content, ElementName=AnalyzeButton}" Click="Analyze_Click" IsEnabled="{Binding IsEnabled, ElementName=AnalyzeButton}"/>
                        <MenuItem Header="实时分析" Click="Live_Click" IsEnabled="{Binding IsEnabled, ElementName=LiveButton}"/>
                        <MenuItem Header="停止并冻结" Click="Stop_Click" IsEnabled="{Binding IsEnabled, ElementName=StopButton}"/>
                        <Separator/>
                        <MenuItem Header="添加测量点" Click="AddRegion_Click" IsEnabled="{Binding IsEnabled, ElementName=AddRegionButton}"/>
                        <MenuItem x:Name="RemoveRegionMenuItem" Header="移除所选测量点" Click="RemoveRegion_Click"/>
                        <Separator/>
                        <MenuItem x:Name="SignalSettingsMenuItem" Header="输入信号与质量…" Click="SignalSettings_Click"/>
                        <MenuItem x:Name="MetricSettingsMenuItem" Header="分析指标…" Click="MetricSettings_Click"/>
                        <MenuItem x:Name="JudgmentSettingsMenuItem" Header="判定标准…" Click="JudgmentSettings_Click"/>
                    </MenuItem>
                    <MenuItem Header="存档(_R)">
                        <MenuItem Header="记录并存档" Click="Archive_Click" IsEnabled="{Binding IsEnabled, ElementName=ArchiveButton}"/>
                        <MenuItem x:Name="ArchiveSettingsMenuItem" Header="存档信息…" Click="ArchiveSettings_Click"/>
                        <MenuItem Header="打开存档目录" Click="ArchiveFolder_Click"/>
                    </MenuItem>
                    <MenuItem Header="视图(_V)">
                        <MenuItem Header="适合窗口" Click="FitImage_Click"/>
                        <MenuItem x:Name="DisplaySettingsMenuItem" Header="SFR 测量与显示…" Click="DisplaySettings_Click"/>
                    </MenuItem>
                </Menu>
            </Border>
            <WrapPanel Margin="12,8,12,10">
                <Button x:Name="OpenButton" Content="打开图像" Style="{StaticResource ActionButton}" Click="Open_Click"/>
                <Button x:Name="CameraPaneButton" Content="收起相机" Style="{StaticResource QuietButton}" Click="ToggleCameraPane_Click" Margin="0,0,16,0"/>
                <Button x:Name="AddRegionButton" Content="添加测量点" Click="AddRegion_Click" Style="{StaticResource ActionButton}"/>
                <Button x:Name="AnalyzeButton" Content="开始分析" Style="{StaticResource ActionButton}" Background="{DynamicResource PrimaryBrush}" Foreground="White" Click="Analyze_Click" Margin="6,0,12,0"/>
                <Button x:Name="ArchiveButton" Content="记录并存档" Style="{StaticResource ActionButton}" Click="Archive_Click"/>
                <TextBlock Text="图卡" Margin="14,0,6,0"/>
                <ComboBox x:Name="ChartTypeSelector" Width="130" Style="{StaticResource CameraCombo}" SelectionChanged="ChartType_Changed" ToolTip="选择 BMW 靶标、棋盘格交叉点或自动识别"/>
                <Button Content="测量设置" Style="{StaticResource QuietButton}" Click="DisplaySettings_Click" IsEnabled="{Binding IsEnabled, ElementName=DisplaySettingsMenuItem}"/>
            </WrapPanel>
        </StackPanel>
        <Border x:Name="StatusBar" DockPanel.Dock="Bottom" BorderBrush="{DynamicResource CV.Border.Weak}" BorderThickness="0,1,0,0" Padding="12,7" Margin="0,8,0,0">
            <Grid x:Name="StatusLine">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="打开图像，或连接相机开始。" FontSize="11" Margin="0,0,12,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock x:Name="CameraSummary" FontSize="11" Opacity="0.7" Margin="0,0,12,0"/>
                    <TextBlock x:Name="CaptureTimingText" FontSize="11" MaxWidth="160" Margin="0,0,12,0"/>
                    <StackPanel x:Name="VideoReadoutBar" Orientation="Horizontal" Visibility="Collapsed">
                        <TextBlock x:Name="VideoFpsText" Text="显示 — FPS" FontSize="11" Margin="0,0,12,0" ToolTip="实际显示帧率，包含分析和绘图开销。"/>
                        <TextBlock x:Name="VideoSharpnessText" Text="清晰度 —" FontSize="11" Margin="0,0,12,0"/>
                        <TextBlock x:Name="VideoAnalysisText" FontSize="11" Margin="0,0,12,0"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="CaptureStampText" Grid.Column="2" FontSize="11" Opacity="0.7" Margin="0,0,12,0"/>
                <TextBlock x:Name="FrameSaveText" Grid.Column="3" FontSize="11" Opacity="0.7" Margin="0,0,12,0"/>
                <TextBlock x:Name="FrameText" Grid.Column="4" Text="尚未加载图像" FontSize="11" MaxWidth="220" Opacity="0.7"/>
            </Grid>
        </Border>
        <Grid Margin="12,0,12,0">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="CameraPaneColumn" Width="200" MinWidth="180" MaxWidth="300"/><ColumnDefinition x:Name="CameraSplitterColumn" Width="10"/><ColumnDefinition Width="*" MinWidth="200"/><ColumnDefinition Width="10"/><ColumnDefinition Width="540" MinWidth="400"/></Grid.ColumnDefinitions>
            <ScrollViewer x:Name="CameraPane" Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="型号" Width="40" FontSize="11" Opacity="0.7"/>
                        <ComboBox x:Name="CameraModels" SelectionChanged="ConnectionSelection_Changed" Style="{StaticResource CameraCombo}"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="ID" Width="40" FontSize="11" Opacity="0.7"/>
                        <Button x:Name="DiscoverButton" DockPanel.Dock="Right" Content="↻" ToolTip="刷新相机 ID" Style="{StaticResource QuietButton}" Click="Discover_Click" Padding="5,0" MinHeight="26" Margin="2,0,0,0"/>
                        <ComboBox x:Name="CameraIds" SelectionChanged="CameraIds_SelectionChanged" ToolTip="刷新后选择相机" Style="{StaticResource CameraCombo}"/>
                    </DockPanel>
                    <Expander Header="采集参数" Margin="0,0,0,12">
                        <StackPanel Margin="0,8,0,0">
                            <DockPanel Margin="0,0,0,8"><TextBlock Text="模式" Width="40" FontSize="11"/><ComboBox x:Name="CameraModes" SelectionChanged="ConnectionSelection_Changed" Style="{StaticResource CameraCombo}"/></DockPanel>
                            <DockPanel><TextBlock Text="位深" Width="40" FontSize="11"/><ComboBox x:Name="CameraDepths" SelectionChanged="ConnectionSelection_Changed" Style="{StaticResource CameraCombo}"/></DockPanel>
                        </StackPanel>
                    </Expander>
                    <WrapPanel Margin="0,0,0,8">
                        <Button x:Name="ConnectButton" Content="连接" Style="{StaticResource ActionButton}" Click="Connect_Click"/>
                        <Button x:Name="DisconnectButton" Content="断开" Style="{StaticResource ActionButton}" Click="Disconnect_Click"/>
                    </WrapPanel>
                    <Border Height="1" Background="{DynamicResource CV.Border.Weak}" Margin="0,4,0,10"/>
                    <DockPanel Margin="0,0,0,5">
                        <TextBlock DockPanel.Dock="Left" Text="曝光 (ms)" Width="68" FontSize="11" Opacity="0.7"/>
                        <TextBox x:Name="ExposureInput" Text="100" TextChanged="AcquisitionInput_Changed" LostKeyboardFocus="AcquisitionInput_Commit" KeyDown="AcquisitionInput_KeyDown"/>
                    </DockPanel>
                    <Slider x:Name="ExposureSlider" Minimum="0" Maximum="11.0021" SmallChange="0.05" Value="4.60517" ValueChanged="AcquisitionSlider_Changed" ToolTip="拖动调整曝光" Margin="0,0,0,10"/>
                    <DockPanel Margin="0,0,0,5">
                        <TextBlock DockPanel.Dock="Left" Text="增益" Width="68" FontSize="11" Opacity="0.7"/>
                        <TextBox x:Name="GainInput" Text="0" TextChanged="AcquisitionInput_Changed" LostKeyboardFocus="AcquisitionInput_Commit" KeyDown="AcquisitionInput_KeyDown"/>
                    </DockPanel>
                    <Slider x:Name="GainSlider" Minimum="0" Maximum="100" SmallChange="1" ValueChanged="AcquisitionSlider_Changed" ToolTip="拖动调整增益" Margin="0,0,0,4"/>
                    <DockPanel Margin="0,0,0,8">
                        <Button x:Name="CaptureButton" DockPanel.Dock="Left" Content="取图" Style="{StaticResource ActionButton}" Click="Capture_Click"/>
                        <CheckBox x:Name="SaveCaptureCheck" Content="取图后保存" Click="SaveCapture_Click" VerticalAlignment="Center" ToolTip="自动保存无损 PNG 原图及相机参数 JSON；视频帧不自动写入磁盘。"/>
                    </DockPanel>
                    <DockPanel Margin="0,4,0,0">
                        <Button DockPanel.Dock="Right" Content="目录" ToolTip="打开保存目录" Click="OpenCaptureDirectory_Click" Style="{StaticResource QuietButton}" FontSize="11" Padding="4,4" Margin="4,0,0,0"/>
                        <Button x:Name="CaptureDirectoryButton" DockPanel.Dock="Right" Content="位置…" Click="CaptureDirectory_Click" Style="{StaticResource QuietButton}" FontSize="11" Padding="4,4" Margin="4,0,0,0"/>
                        <TextBlock Text="保存位置" FontSize="11" Opacity="0.7"/>
                    </DockPanel>
                    <Border Height="1" Background="{DynamicResource CV.Border.Weak}" Margin="0,12"/>
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="设置" Click="VideoSettings_Click" IsEnabled="{Binding IsEnabled, ElementName=VideoSettingsMenuItem}" Style="{StaticResource QuietButton}" FontSize="11"/>
                        <TextBlock Text="视频分析" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ComboBox x:Name="VideoModeSelector" SelectionChanged="VideoMode_Changed" Style="{StaticResource CameraCombo}" Margin="0,0,0,8">
                        <ComboBoxItem Content="仅预览"/><ComboBoxItem Content="基础清晰度"/><ComboBoxItem Content="四边 SFR"/>
                    </ComboBox>
                    <WrapPanel><Button x:Name="LiveButton" Content="开始视频" Style="{StaticResource ActionButton}" Click="Live_Click"/><Button x:Name="StopButton" Content="停止" ToolTip="停止实时分析并冻结当前画面" Style="{StaticResource QuietButton}" Click="Stop_Click" IsEnabled="False"/></WrapPanel>
                    <Button x:Name="CameraSettingsButton" Visibility="Collapsed"/>
                    <TextBlock x:Name="RegionCountText" Visibility="Collapsed"/>
                </StackPanel>
                <Grid>
                    <ListBox x:Name="RegionList" Visibility="Collapsed" BorderThickness="0" Background="Transparent" SelectionChanged="RegionList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/><Setter Property="Padding" Value="4,7"/></Style></ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate><DataTemplate><DockPanel ToolTip="{Binding Bounds}">
                            <Button DockPanel.Dock="Right" Content="×" Tag="{Binding}" Click="RemoveRegion_Click" ToolTip="移除此测量点" Style="{StaticResource QuietButton}" IsEnabled="{Binding IsEnabled, ElementName=AddRegionButton}"/>
                            <StackPanel><TextBlock Text="{Binding Id}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold"/><TextBlock Text="{Binding Bounds}" Foreground="{DynamicResource PrimaryTextBrush}" Opacity="0.55" FontSize="10" Margin="0,3,0,0"/></StackPanel>
                        </DockPanel></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="EmptyRegionsText" Visibility="Collapsed"/>
                </Grid>
            </DockPanel>
            </ScrollViewer>
            <GridSplitter x:Name="CameraSplitter" Grid.Column="1" Width="3" Background="{DynamicResource CV.Border.Weak}" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
            <Grid Grid.Column="2">
                <images:ImageView x:Name="ImageView"/>
                <Border x:Name="StartGuide" Background="{DynamicResource CV.Surface.Alternate}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                        <TextBlock Text="从一张图开始" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="打开图像，或连接相机取图" Margin="0,10,0,24" Opacity="0.65" HorizontalAlignment="Center"/>
                        <Button Content="打开图像…" Click="Open_Click" Style="{StaticResource ActionButton}" HorizontalAlignment="Center"/>
                        <TextBlock Text="选择图卡类型并添加测量点" TextWrapping="Wrap" TextAlignment="Center" FontSize="12" Opacity="0.65" Margin="0,24,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
            <GridSplitter Grid.Column="3" Width="4" Background="{DynamicResource GlobalBorderBrush}" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
            <TabControl x:Name="AnalysisTabs" Grid.Column="4">
            <TabItem Header="清晰度" ToolTip="SFR · MTF50 / MTF10 单位为 cycles/pixel。Y 为相对亮度组合信号，曲线中记为 L。">
            <Grid Margin="6">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="0.85*" MinHeight="140"/><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="80"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                <DockPanel Margin="0,4,0,8">
                    <StackPanel DockPanel.Dock="Right" Margin="8,0,0,0" HorizontalAlignment="Right">
                        <TextBlock x:Name="SelectedMetricValue" Text="—" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="SelectedMetricCaption" Text="MTF50 · cycles/pixel" FontSize="10" Opacity="0.65"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="CurveSelectionText" Text="等待分析" FontSize="16" FontWeight="SemiBold"/>
                        <WrapPanel Margin="0,5,0,0">
                            <TextBlock x:Name="ResultSummary" Text="每条边一行，通道横向对比" FontSize="11" Opacity="0.65"/>
                            <Button x:Name="FailedTargetsButton" Content="处理未定位" Visibility="Collapsed" Click="FailedTarget_Click" Style="{StaticResource QuietButton}" Padding="4,0" FontSize="11" Foreground="{DynamicResource PrimaryBrush}"/>
                            <Button x:Name="MissingResultsButton" Content="查看缺值" Visibility="Collapsed" Click="MissingResult_Click" Style="{StaticResource QuietButton}" Padding="4,0" FontSize="11" Foreground="{DynamicResource PrimaryBrush}" ToolTip="按当前点位、通道和指标筛选，逐项定位缺值及原因；测量质量检查与产品合格判定不同。"/>
                        </WrapPanel>
                    </StackPanel>
                </DockPanel>
                <UniformGrid Rows="1" Margin="0,0,0,10">
                    <Button x:Name="LeftEdgeButton" Tag="Left" Click="Direction_Click" Style="{StaticResource EdgeButton}"><StackPanel><TextBlock Text="左边" FontSize="10" Opacity="0.7" Style="{StaticResource EdgeReadout}"/><TextBlock x:Name="LeftEdgeValue" Text="—" FontSize="15" FontWeight="SemiBold" Style="{StaticResource EdgeReadout}"/></StackPanel></Button>
                    <Button x:Name="TopEdgeButton" Tag="Top" Click="Direction_Click" Style="{StaticResource EdgeButton}"><StackPanel><TextBlock Text="上边" FontSize="10" Opacity="0.7" Style="{StaticResource EdgeReadout}"/><TextBlock x:Name="TopEdgeValue" Text="—" FontSize="15" FontWeight="SemiBold" Style="{StaticResource EdgeReadout}"/></StackPanel></Button>
                    <Button x:Name="RightEdgeButton" Tag="Right" Click="Direction_Click" Style="{StaticResource EdgeButton}"><StackPanel><TextBlock Text="右边" FontSize="10" Opacity="0.7" Style="{StaticResource EdgeReadout}"/><TextBlock x:Name="RightEdgeValue" Text="—" FontSize="15" FontWeight="SemiBold" Style="{StaticResource EdgeReadout}"/></StackPanel></Button>
                    <Button x:Name="BottomEdgeButton" Tag="Bottom" Click="Direction_Click" Style="{StaticResource EdgeButton}" Margin="0"><StackPanel><TextBlock Text="下边" FontSize="10" Opacity="0.7" Style="{StaticResource EdgeReadout}"/><TextBlock x:Name="BottomEdgeValue" Text="—" FontSize="15" FontWeight="SemiBold" Style="{StaticResource EdgeReadout}"/></StackPanel></Button>
                </UniformGrid>
                </StackPanel>
                <WrapPanel Grid.Row="1" Margin="0,0,0,4">
                    <TextBlock Text="通道" Margin="0,0,12,0"/>
                    <CheckBox x:Name="ShowY" Content="Y" IsChecked="True" Margin="0,0,12,0" Click="PlotSettings_Click"/>
                    <CheckBox x:Name="ShowR" Content="R" IsChecked="True" Margin="0,0,12,0" Click="PlotSettings_Click"/>
                    <CheckBox x:Name="ShowG" Content="G" IsChecked="True" Margin="0,0,12,0" Click="PlotSettings_Click"/>
                    <CheckBox x:Name="ShowB" Content="B" IsChecked="True" Margin="0,0,12,0" Click="PlotSettings_Click"/>
                    <ComboBox x:Name="PlotMode" Width="90" SelectedIndex="0" SelectionChanged="PlotMode_SelectionChanged"><ComboBoxItem Content="MTF"/><ComboBoxItem Content="ESF"/><ComboBoxItem Content="LSF"/></ComboBox>
                    <CheckBox x:Name="FocusLabels" Content="专注当前点" IsChecked="True" Click="FocusLabels_Click" Margin="12,0,0,0" ToolTip="当前点用简短标签显示四边数值；其他点保留名称和测量框。取消后显示完整标注。"/>
                </WrapPanel>
                <Grid Grid.Row="2">
                    <sfr:SfrSimplePlotControl x:Name="CurvePlot"/>
                    <Border x:Name="EmptyPlot" Background="{DynamicResource GlobalBackground}">
                        <TextBlock x:Name="EmptyPlotText" Text="分析后，点击结果或图上的刃边查看曲线" TextWrapping="Wrap" TextAlignment="Center" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6"/>
                    </Border>
                </Grid>
                <WrapPanel Grid.Row="3" Margin="0,8,0,8">
                    <ComboBox x:Name="TargetFilter" Width="112" SelectionChanged="TargetFilter_Changed" ToolTip="按点位筛选" Margin="0,0,6,4"/>
                    <ComboBox x:Name="OverviewMetric" Width="112" SelectedIndex="0" SelectionChanged="OverviewMetric_Changed" Margin="0,0,6,4" ToolTip="图上标注、四边读数与概览使用同一指标；显示频率可在测量设置中修改，只查询已有曲线。"><ComboBoxItem Content="MTF50"/><ComboBoxItem Content="MTF10"/><ComboBoxItem x:Name="TargetFrequencyOption" Content="MTF@0.25"/><ComboBoxItem Content="MTF@0.5"/></ComboBox>
                    <Button x:Name="LowestButton" Content="定位最低值" Click="Lowest_Click" Style="{StaticResource QuietButton}" ToolTip="定位本帧当前筛选范围内、当前指标的最低可用数值；不代表判定不合格。" Margin="0,0,6,4"/>
                    <CheckBox x:Name="ShowDetails" Content="明细" Click="ShowDetails_Click" Margin="0,0,0,4"/>
                </WrapPanel>
                <DataGrid Grid.Row="4" x:Name="Overview" Style="{StaticResource ResultGrid}" CellStyle="{Binding CellStyle, ElementName=Metrics}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" MouseDoubleClick="Result_MouseDoubleClick" PreviewKeyDown="Result_PreviewKeyDown" SelectionChanged="Overview_SelectionChanged" SizeChanged="Overview_SizeChanged" PreviewMouseLeftButtonUp="Overview_MouseUp" ToolTip="点击一行切换刃边，点击通道数值切换图上标注；方向键切换结果，双击或 Enter 查看原图、曲线与测量诊断。">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="点位" Binding="{Binding Target}" Width="*" MinWidth="64" ElementStyle="{StaticResource MetricText}"/>
                        <DataGridTextColumn Header="边" Binding="{Binding EdgeLabel}" Width="32" ElementStyle="{StaticResource MetricText}"/>
                        <DataGridTextColumn x:Name="OverviewY" Header="Y" Binding="{Binding Y}" SortMemberPath="YValue" Width="62" ElementStyle="{StaticResource YMetricText}"/>
                        <DataGridTextColumn x:Name="OverviewR" Header="R" Binding="{Binding R}" SortMemberPath="RValue" Width="62" ElementStyle="{StaticResource RMetricText}"/>
                        <DataGridTextColumn x:Name="OverviewG" Header="G" Binding="{Binding G}" SortMemberPath="GValue" Width="62" ElementStyle="{StaticResource GMetricText}"/>
                        <DataGridTextColumn x:Name="OverviewB" Header="B" Binding="{Binding B}" SortMemberPath="BValue" Width="62" ElementStyle="{StaticResource BMetricText}"/>
                    </DataGrid.Columns>
                </DataGrid>
                <DataGrid Grid.Row="4" x:Name="Metrics" Visibility="Collapsed" Style="{StaticResource ResultGrid}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" MouseDoubleClick="Result_MouseDoubleClick" PreviewKeyDown="Result_PreviewKeyDown" ToolTip="双击或 Enter 查看本次结果详情，不重新计算。" SelectionChanged="Metrics_SelectionChanged" EnableRowVirtualization="True">
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="ToolTip" Value="{Binding DiagnosticText}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Background="{TemplateBinding Background}" Padding="0">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="点位" Binding="{Binding Target}" Width="65" ElementStyle="{StaticResource MetricText}"/>
                        <DataGridTextColumn Header="边" Binding="{Binding Edge}" Width="50" ElementStyle="{StaticResource MetricText}"/>
                        <DataGridTextColumn Header="通道" Binding="{Binding Channel}" Width="48" ElementStyle="{StaticResource MetricText}"/>
                        <DataGridTextColumn Header="MTF50" Binding="{Binding Mtf50, StringFormat=F4}" Width="65" ElementStyle="{StaticResource MetricText}"/>
                        <DataGridTextColumn Header="MTF10" Binding="{Binding Mtf10, StringFormat=F4}" Width="65" ElementStyle="{StaticResource MetricText}"/>
                        <DataGridTextColumn x:Name="ResponseColumn" Header="MTF@0.25" Binding="{Binding Response, StringFormat=P1}" Width="80" ElementStyle="{StaticResource MetricText}"/>
                        <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="*" MinWidth="90" ElementStyle="{StaticResource MetricText}"/>
                    </DataGrid.Columns>
                </DataGrid>
                <Border Grid.Row="5" Background="{DynamicResource CV.Surface.Alternate}" Padding="10,8" Margin="0,10,0,0" CornerRadius="4">
                    <StackPanel>
                        <DockPanel>
                            <Button x:Name="CheckSignalButton" DockPanel.Dock="Right" Content="检查信号" Style="{StaticResource QuietButton}" Visibility="Collapsed" Click="SignalSettings_Click" IsEnabled="{Binding IsEnabled, ElementName=SignalSettingsMenuItem}" Padding="6,0" Foreground="{DynamicResource PrimaryBrush}"/>
                            <TextBlock x:Name="ResultHint" Text="先框选完整靶标，再开始分析。" TextWrapping="Wrap" FontSize="11"/>
                        </DockPanel>
                        <WrapPanel x:Name="RecoveryActions" Visibility="Collapsed" Margin="0,6,0,0">
                            <Button x:Name="ExpandRegionButton" Content="扩大选框重试" Click="ExpandRegion_Click" Style="{StaticResource QuietButton}" ToolTip="选框宽高各增加 50%，限制在原图内并重新分析。可用 Ctrl+Z 撤销。"/>
                            <Button Content="测量设置…" Click="DisplaySettings_Click" Style="{StaticResource QuietButton}" IsEnabled="{Binding IsEnabled, ElementName=DisplaySettingsMenuItem}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>
            </TabItem>
            <TabItem Header="色差" ToolTip="RGB 50% 边缘位移，单位 px。包括镜头、传感器和图像处理的综合偏移，不等同于 ΔE 或纯镜头径向色差。">
                <Grid Margin="6">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="220"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock x:Name="ColorSummary" Text="分析图像后显示 R−G、R−B、G−B 的刃边位移。" TextWrapping="Wrap" Margin="0,4,0,8"/>
                    <plots:WpfPlot x:Name="ColorPlot" Grid.Row="1"/>
                    <DataGrid x:Name="ColorMetrics" Style="{StaticResource ResultGrid}" Grid.Row="2" Margin="0,10,0,10" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="ColorMetrics_SelectionChanged" CellStyle="{Binding CellStyle, ElementName=Metrics}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="点位" Binding="{Binding Target}" Width="70" ElementStyle="{StaticResource MetricText}"/>
                            <DataGridTextColumn Header="边" Binding="{Binding Edge}" Width="60" ElementStyle="{StaticResource MetricText}"/>
                            <DataGridTextColumn Header="通道差" Binding="{Binding Pair}" Width="70" ElementStyle="{StaticResource MetricText}"/>
                            <DataGridTextColumn Header="位移 (px)" Binding="{Binding ShiftText}" Width="90" ElementStyle="{StaticResource MetricText}"/>
                            <DataGridTextColumn Header="方向" Binding="{Binding Axis}" Width="60" ElementStyle="{StaticResource MetricText}"/>
                            <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="220" ElementStyle="{StaticResource MetricText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="3" Text="{Binding SelectedItem.Status, ElementName=ColorMetrics}" TextWrapping="Wrap" FontSize="11" Opacity="0.75" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                </Grid>
            </TabItem>
            <TabItem Header="调焦趋势">
                <DockPanel Margin="6">
                    <StackPanel DockPanel.Dock="Top">
                        <ComboBox x:Name="FocusSelection" SelectionChanged="FocusSelection_Changed" Margin="0,0,0,10"/>
                        <ComboBox x:Name="FocusMetricPicker" SelectedIndex="0" SelectionChanged="FocusSelection_Changed" Margin="0,0,0,10"><ComboBoxItem Content="指定频率 MTF"/><ComboBoxItem Content="MTF50"/></ComboBox>
                        <TextBlock x:Name="FocusReadout" Text="开始实时分析后记录调焦趋势。" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <TextBlock Text="保留本轮最近 300 帧；缺测处断开。峰值仅供调焦参考，不代表已到最佳焦点。" TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,10"/>
                        <WrapPanel>
                            <Button x:Name="ClearFocusButton" Content="清空本轮" Style="{StaticResource ActionButton}" Click="ClearFocus_Click"/>
                            <Button x:Name="ExportFocusButton" Content="导出调焦记录…" Style="{StaticResource ActionButton}" Click="ExportFocus_Click"/>
                        </WrapPanel>
                    </StackPanel>
                    <plots:WpfPlot x:Name="FocusPlot"/>
                </DockPanel>
            </TabItem>
            <TabItem Header="判定">
                <DockPanel Margin="6">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock x:Name="VerdictText" Text="未分析" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <TextBlock Text="判定为可选功能。未设标准、未知编码、缺通道或无效测量不会显示为合格。" TextWrapping="Wrap" Opacity="0.75"/>
                    </StackPanel>
                    <DataGrid x:Name="JudgmentMetrics" Style="{StaticResource ResultGrid}" IsReadOnly="True" AutoGenerateColumns="False" CellStyle="{Binding CellStyle, ElementName=Metrics}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="点位 / 边" Binding="{Binding Target}" Width="70" ElementStyle="{StaticResource MetricText}"/>
                            <DataGridTextColumn Header="边" Binding="{Binding Edge}" Width="60" ElementStyle="{StaticResource MetricText}"/>
                            <DataGridTextColumn Header="通道" Binding="{Binding Channel}" Width="65" ElementStyle="{StaticResource MetricText}"/>
                            <DataGridTextColumn Header="指标" Binding="{Binding Metric}" Width="110" ElementStyle="{StaticResource MetricText}"/>
                            <DataGridTextColumn Header="值" Binding="{Binding Value, StringFormat=F4}" Width="65" ElementStyle="{StaticResource MetricText}"/>
                            <DataGridTextColumn Header="阈值" Binding="{Binding Limit, StringFormat=F4}" Width="65" ElementStyle="{StaticResource MetricText}"/>
                            <DataGridTextColumn Header="判定" Binding="{Binding Status}" Width="85" ElementStyle="{StaticResource MetricText}"/>
                            <DataGridTextColumn Header="原因" Binding="{Binding Reason}" Width="220" ElementStyle="{StaticResource MetricText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
