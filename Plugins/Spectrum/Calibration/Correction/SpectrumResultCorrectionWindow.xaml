<Window x:Class="Spectrum.Calibration.Correction.SpectrumResultCorrectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="光谱校正" Width="1180" Height="780" MinWidth="980" MinHeight="680"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource GlobalBackground}"
        Foreground="{DynamicResource GlobalTextBrush}">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="MinHeight" Value="30" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Background" Value="{DynamicResource GlobalBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}" />
            <Setter Property="EnableRowVirtualization" Value="True" />
            <Setter Property="EnableColumnVirtualization" Value="True" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="220" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="12" Margin="0,0,0,10" CornerRadius="5"
                BorderThickness="1" BorderBrush="{DynamicResource GlobalBorderBrush1}"
                Background="{DynamicResource GlobalBorderBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,6,0" Text="结果" Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBlock x:Name="ResultText" Grid.Row="0" Grid.Column="1" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Row="0" Grid.Column="2" Margin="12,0,6,0" Text="标定组" Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBlock x:Name="GroupText" Grid.Row="0" Grid.Column="3" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Row="0" Grid.Column="4" Margin="12,0,6,0" Text="当前 DAT" Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBlock x:Name="SourceFileText" Grid.Row="0" Grid.Column="5" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="6" Margin="0,8,0,0"
                           Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"
                           Text="使用当前选中结果预览并导出 DAT；不会更改当前标定组。" />
            </Grid>
        </Border>

        <TabControl x:Name="CorrectionTabs" Grid.Row="1" SelectedIndex="1" Margin="0,0,0,8"
                    SelectionChanged="CorrectionTabs_SelectionChanged">
            <TabItem Header="单独亮度校正">
                <Grid Margin="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,12,10" Text="目标亮度/光度值" />
                    <TextBox x:Name="TargetBrightnessTextBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10" TextChanged="BrightnessInput_Changed" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,12,10" Text="当前结果实测值" />
                    <TextBox x:Name="MeasuredBrightnessTextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" IsReadOnly="True" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,12,10" Text="校正比例" />
                    <TextBox x:Name="BrightnessRatioTextBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" IsReadOnly="True" />
                    <TextBlock Grid.Row="0" Grid.RowSpan="3" Grid.Column="2" Margin="28,0,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="输入目标值后预览并导出 DAT；相对光谱形状不变。" />
                </Grid>
            </TabItem>

            <TabItem Header="完整光谱校正">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,7">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Margin="0,0,6,0" Content="从 CSV/TXT 导入" Click="ImportStandardButton_Click" />
                            <Button Content="清空标准值" Click="ClearStandardButton_Click" />
                        </StackPanel>
                        <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"
                                   Text="导入覆盖 380–780 nm 的两列标准谱；可按 Ctrl+V 粘贴。" />
                    </DockPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <GroupBox Grid.Column="0" Header="标准绝对光谱（可编辑）" Padding="5">
                            <DataGrid x:Name="StandardDataGrid" ItemsSource="{Binding StandardRows}" AutoGenerateColumns="False"
                                      CanUserAddRows="True" CanUserDeleteRows="True" PreviewKeyDown="StandardDataGrid_PreviewKeyDown">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="波长 (nm)" Width="*" Binding="{Binding Wavelength, UpdateSourceTrigger=LostFocus, StringFormat=G10}" />
                                    <DataGridTextColumn Header="标准值" Width="*" Binding="{Binding Value, UpdateSourceTrigger=LostFocus, StringFormat=G10}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                        <GroupBox Grid.Column="2" Header="当前校正后绝对光谱（只读）" Padding="5">
                            <DataGrid ItemsSource="{Binding MeasuredRows}" AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="波长 (nm)" Width="*" Binding="{Binding Wavelength, StringFormat=F1}" />
                                    <DataGridTextColumn Header="fPL × fPlambda" Width="*" Binding="{Binding Value, StringFormat=G10}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Margin="0,0,0,8" Padding="5" CornerRadius="4"
                BorderBrush="{DynamicResource GlobalBorderBrush1}" BorderThickness="1">
            <ScottPlot:WpfPlot x:Name="PreviewPlot" />
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                <TextBlock x:Name="GeneratedFileText" Margin="0,3,12,0" Foreground="{DynamicResource SecondaryTextBrush}"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Margin="0,0,8,0" MinWidth="100" Content="预览" Click="PreviewButton_Click" />
                <Button MinWidth="120" Content="导出 DAT" Click="GenerateButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
