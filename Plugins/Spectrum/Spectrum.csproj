<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <DefineConstants>$(DefineConstants);SPECTRUM_ABOUT</DefineConstants>
    <Company>Spectromer</Company>
	<ApplicationIcon>pic.ico</ApplicationIcon>
	<VersionPrefix>2.3.3.13</VersionPrefix>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="pic.ico" />
  </ItemGroup>

  <!-- Keep the tested native-caption implementation in sync with the main shell,
       without taking a dependency on the ColorVision executable. -->
  <ItemGroup>
    <Compile Include="..\..\ColorVision\Windowing\CompactTitleBarChrome.cs" Link="Windowing\CompactTitleBarChrome.cs" />
    <Compile Include="..\..\ColorVision\Windowing\CompactTitleBarVisibilityGuard.cs" Link="Windowing\CompactTitleBarVisibilityGuard.cs" />
  </ItemGroup>

  <!-- Share the presentation source while keeping the plugin compatible with released hosts. -->
  <ItemGroup>
    <Compile Include="..\..\UI\ColorVision.UI\Views\About\AboutArtScene.cs" Link="Help\Art\AboutArtScene.cs" />
    <Compile Include="..\..\UI\ColorVision.UI\Views\About\AboutText.cs" Link="Help\Art\AboutText.cs" />
    <Compile Include="..\..\UI\ColorVision.UI\Views\About\AboutWindowChrome.cs" Link="Help\Art\AboutWindowChrome.cs" />
    <Compile Include="..\..\UI\ColorVision.UI\Views\About\VisionImageStudy.cs" Link="Help\Art\VisionImageStudy.cs" />
    <EmbeddedResource Include="..\..\UI\ColorVision.UI\Views\About\AboutResources*.resx" Link="Help\Art\%(Filename)%(Extension)" LogicalName="Spectrum.Help.Art.%(Filename).resources" />
  </ItemGroup>

	
	<ItemGroup>
		<PackageReference Include="Dirkster.AvalonDock.Themes.VS2013" Version="4.74.1" />
		<PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.158" />
		<PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" />
		<PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" />
		<PackageReference Include="OpenCvSharp4.WpfExtensions" Version="4.13.0.20260627" />
		<!-- Compatibility freeze: keep ScottPlot.WPF 5.0.56; see docs/04-api-reference/ui-components/component-handbook.md. -->
		<PackageReference Include="ScottPlot.WPF" Version="5.0.56" />
		<PackageReference Include="System.IO.Ports" Version="10.0.11" />
	</ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Include="DirectSpectrometer\Native\*.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>%(Filename)%(Extension)</TargetPath>
    </None>
    <None Update="CHANGELOG.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="log4net.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Magiude.dat">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="manifest.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Properties\Settings.settings">
      <Generator>PublicSettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
    <None Update="WavaLength.dat">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Update\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Engine\cvColorVision\cvColorVision.csproj" />
    <ProjectReference Include="..\..\UI\ColorVision.ImageEditor\ColorVision.ImageEditor.csproj" />
    <ProjectReference Include="..\..\UI\ColorVision.Database\ColorVision.Database.csproj" />
    <ProjectReference Include="..\..\UI\ColorVision.Scheduler\ColorVision.Scheduler.csproj" />
    <ProjectReference Include="..\..\UI\ColorVision.SocketProtocol\ColorVision.SocketProtocol.csproj" />
    <ProjectReference Include="..\..\UI\ColorVision.Solution\ColorVision.Solution.csproj" />
    <ProjectReference Include="..\..\UI\ColorVision.UI\ColorVision.UI.csproj" />
  </ItemGroup>

</Project>
