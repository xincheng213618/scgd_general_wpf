<base:BaseWindow x:Class="Spectrum.Help.SpectrumAboutWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:base="clr-namespace:ColorVision.Themes.Controls;assembly=ColorVision.Themes"
                 xmlns:art="clr-namespace:Spectrum.Help.Art"
                 Width="880" Height="590" BorderThickness="0"
                 IsBlurEnabled="False" IsDragMoveEnabled="True" ResizeMode="NoResize"
                 ShowIcon="False" ShowInTaskbar="False" ShowTitle="False" WindowStyle="None"
                 Title="{x:Static art:AboutText.SpectrumTitle}"
                 UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <base:BaseWindow.Template>
        <ControlTemplate TargetType="{x:Type base:BaseWindow}">
            <!-- Paint the full HWND; the native region owns the outer corner clipping. -->
            <Border Background="{TemplateBinding Background}">
                <AdornerDecorator><ContentPresenter /></AdornerDecorator>
            </Border>
        </ControlTemplate>
    </base:BaseWindow.Template>
    <base:BaseWindow.Resources>
        <SolidColorBrush x:Key="About.Ink" Color="#EDF3FF" />
        <SolidColorBrush x:Key="About.Muted" Color="#919CB2" />
        <SolidColorBrush x:Key="About.Faint" Color="#66758F" />
        <SolidColorBrush x:Key="About.Line" Color="#334C607F" />
        <SolidColorBrush x:Key="About.Surface" Color="#FF080D19" />
        <SolidColorBrush x:Key="About.Hover" Color="#186794CD" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource About.Ink}" />
            <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
        </Style>
        <Style x:Key="About.Micro" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource About.Muted}" />
        </Style>
        <Style x:Key="About.Chrome" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource About.Muted}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChromeBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChromeBorder" Property="Background" Value="{DynamicResource About.Hover}" />
                                <Setter Property="Foreground" Value="{DynamicResource About.Ink}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ChromeBorder" Property="BorderBrush" Value="{DynamicResource About.Ink}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ChromeBorder" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </base:BaseWindow.Resources>
    <Viewbox Stretch="Uniform">
        <Grid x:Name="Exhibition" Width="880" Height="590" Background="{DynamicResource About.Surface}" MouseMove="Exhibition_MouseMove" MouseLeave="Exhibition_MouseLeave">
            <Grid.Clip><RectangleGeometry Rect="0,0,880,590" RadiusX="16" RadiusY="16" /></Grid.Clip>
            <art:AboutArtScene Artwork="Spectrum" x:Name="SpectralScene" IsHitTestVisible="False" />
            <Border Margin="0.5" BorderThickness="1" CornerRadius="16" IsHitTestVisible="False">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#665FABC5" />
                        <GradientStop Offset="0.35" Color="#226976B2" />
                        <GradientStop Offset="0.7" Color="#44655D8E" />
                        <GradientStop Offset="1" Color="#667CABB3" />
                    </LinearGradientBrush>
                </Border.BorderBrush>
            </Border>
            <Grid Margin="38,24,28,0" Height="36" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="S P E C T R U M" FontSize="11" FontWeight="SemiBold" />
                    <Border Width="1" Height="12" Margin="20,0" Background="{DynamicResource About.Line}" />
                    <TextBlock Text="{x:Static art:AboutText.SpectrumEyebrow}" FontSize="10" Foreground="{DynamicResource About.Muted}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="PaletteButton" Style="{StaticResource About.Chrome}" Click="PaletteButton_Click" ToolTip="{x:Static art:AboutText.PaletteTooltip}" AutomationProperties.Name="{x:Static art:AboutText.PaletteAutomation}">
                        <Grid Width="14" Height="14">
                            <Ellipse Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
                            <Path Data="M 7,0 A 7,7 0 0 0 7,14 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Grid>
                    </Button>
                    <Button x:Name="CloseButton" Margin="6,0,0,0" Style="{StaticResource About.Chrome}" Click="CloseButton_Click" ToolTip="{x:Static art:AboutText.CloseTooltip}" AutomationProperties.Name="{x:Static art:AboutText.CloseAutomation}" IsCancel="True">
                        <Path Width="12" Height="12" Data="M 0,0 L 12,12 M 12,0 L 0,12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" />
                    </Button>
                </StackPanel>
            </Grid>
            <StackPanel Margin="40,110,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
                <TextBlock Text="01 /" Style="{StaticResource About.Micro}" />
                <TextBlock Margin="0,9,0,0" Text="THE SPECTRAL" Style="{StaticResource About.Micro}" FontSize="9" />
                <TextBlock Margin="0,3,0,0" Text="CONTINUUM" Style="{StaticResource About.Micro}" FontSize="9" />
                <Border Width="26" Height="1" Margin="0,16,0,0" HorizontalAlignment="Left" Background="{DynamicResource About.Line}" />
            </StackPanel>
            <StackPanel Margin="0,0,41,192" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False">
                <TextBlock x:Name="PaletteLabel" Text="N O C T U R N E" Style="{StaticResource About.Micro}" FontSize="9" HorizontalAlignment="Right" />
                <TextBlock Margin="0,6,0,0" Text="380 — 780 nm" Style="{StaticResource About.Micro}" FontSize="9" HorizontalAlignment="Right" />
            </StackPanel>
            <Grid Margin="40,0,40,64" VerticalAlignment="Bottom">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="HeadlineLabel" Text="{x:Static art:AboutText.SpectrumHeadline}" FontSize="27" FontWeight="Light" />
                    <TextBlock Margin="2,10,0,0" Text="{x:Static art:AboutText.SpectrumSubline}" Style="{StaticResource About.Micro}" FontSize="9" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="24,0,0,0">
                    <TextBlock x:Name="VersionLabel" Text="Spectrum" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="25" FontWeight="Light" HorizontalAlignment="Right" />
                    <TextBlock x:Name="BuildLabel" Margin="0,8,0,0" Text="BUILD 2026.09.08 / X64" Style="{StaticResource About.Micro}" FontSize="9" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
            <Grid Margin="40,0,40,20" VerticalAlignment="Bottom">
                <TextBlock x:Name="CopyrightLabel" Text="© 2023–2026 ColorVision" FontSize="9" Foreground="{DynamicResource About.Faint}" />
                <TextBlock x:Name="RuntimeLabel" HorizontalAlignment="Right" Text=".NET 10 / 64-BIT" Style="{StaticResource About.Micro}" FontSize="9" Foreground="{DynamicResource About.Faint}" />
            </Grid>
        </Grid>
    </Viewbox>
</base:BaseWindow>
