<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<UseWPF>true</UseWPF>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<VersionPrefix>1.5.1.2</VersionPrefix>
		<TargetFrameworks>net10.0-windows7.0</TargetFrameworks>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<IncludeSymbols>True</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PackageProjectUrl>https://github.com/xincheng213618/scgd_general_wpf</PackageProjectUrl>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<NoWarn>NU5100</NoWarn>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
	  <Compile Remove="CVCOme\**" />
	  <EmbeddedResource Remove="CVCOme\**" />
	  <None Remove="CVCOme\**" />
	  <Page Remove="CVCOme\**" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Devices\Spectrometer\ColorRenderingData\*.csv" LogicalName="cvColorVision.ColorRenderingData.%(Filename)%(Extension)" />
		<None Update="Devices\Spectrometer\ColorRenderingData\NOTICE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" TargetPath="ThirdPartyNotices\Colour-Science.txt" Pack="true" PackagePath="contentFiles/any/any/ThirdPartyNotices/Colour-Science.txt" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="log4net" Version="3.5.0" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="OpenCvSharp5" Version="5.0.0.20261011" />
		<PackageReference Include="OpenCvSharp5.runtime.win" Version="5.0.0.20261011" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\DLL\scgd_internal_dll\cvCamera.dll" Link="runtimes\win-x64\native\cvCamera.dll">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			<Pack>true</Pack>
			<PackagePath>runtimes/win-x64/native</PackagePath>
		</None>
