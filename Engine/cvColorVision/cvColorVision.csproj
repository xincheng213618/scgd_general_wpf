	<Target Name="ValidateGaolitongNativeDependencies" BeforeTargets="Build" Condition="'$(Configuration)' == 'Release'">
		<Error Condition="!Exists('..\..\DLL\scgd_internal_dll\glaDevSys64.dll') or !Exists('..\..\DLL\scgd_internal_dll\xGUSB64.dll') or !Exists('..\..\DLL\scgd_internal_dll\xGCOM64.dll') or !Exists('..\..\DLL\scgd_internal_dll\xserial64.dll') or !Exists('..\..\DLL\scgd_internal_dll\FTD2XX.dll')" Text="Missing one or more Gaolitong x64 runtime dependencies in DLL\scgd_internal_dll: glaDevSys64.dll, xGUSB64.dll, xGCOM64.dll, xserial64.dll, FTD2XX.dll." />
	</Target>

