<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<UseWPF>true</UseWPF>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<VersionPrefix>1.5.1.1</VersionPrefix>
		<TargetFrameworks>net10.0-windows7.0</TargetFrameworks>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<IncludeSymbols>True</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PackageProjectUrl>https://github.com/xincheng213618/scgd_general_wpf</PackageProjectUrl>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<NoWarn>NU5100</NoWarn>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
	  <Compile Remove="CVCOme\**" />
	  <EmbeddedResource Remove="CVCOme\**" />
	  <None Remove="CVCOme\**" />
