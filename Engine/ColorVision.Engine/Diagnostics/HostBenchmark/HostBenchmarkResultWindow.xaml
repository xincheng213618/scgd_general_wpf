<Window x:Class="ColorVision.Engine.Diagnostics.HostBenchmark.HostBenchmarkResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="基准测试成绩" Width="930" MinWidth="710" MinHeight="470" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#090E1C" Foreground="#EDF3FF" FontSize="14" UseLayoutRounding="True"
        Loaded="Window_Loaded" Activated="Window_Activated" Closed="Window_Closed">
    <Window.Resources>
        <SolidColorBrush x:Key="Secondary" Color="#A6B6D5" />
        <SolidColorBrush x:Key="Panel" Color="#10192B" />
        <SolidColorBrush x:Key="PanelBorder" Color="#273751" />
        <LinearGradientBrush x:Key="Signal" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#9D80FF" Offset="0" />
            <GradientStop Color="#5B8FF7" Offset="0.52" />
            <GradientStop Color="#64ECEB" Offset="1" />
        </LinearGradientBrush>
        <DrawingBrush x:Key="GridLines" TileMode="Tile" Stretch="None" Viewport="0,0,24,24" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <GeometryDrawing Geometry="M0,0 L24,0 24,24">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#227DB6F9" Thickness="1" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F3F8FF" />
            <Setter Property="Background" Value="#1A2843" />
            <Setter Property="BorderBrush" Value="#3A5277" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" CornerRadius="9" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#A4E9FF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#C4D9FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ShareActionButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="MinWidth" Value="215" />
            <Setter Property="MinHeight" Value="41" />
            <Setter Property="Padding" Value="20,7" />
            <Setter Property="BorderBrush" Value="#A8A5F9" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.6">
                        <GradientStop Color="#6441C9" Offset="0" />
                        <GradientStop Color="#435BCB" Offset="0.66" />
                        <GradientStop Color="#286885" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MinorButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="ScoreBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="8" />
            <Setter Property="Foreground" Value="#79A1F0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="#263550" CornerRadius="4">
                            <Grid x:Name="PART_Track" ClipToBounds="True">
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="4"
                                        Background="{TemplateBinding Foreground}" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLocal}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Signal}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsStandard}" Value="True">
                    <Setter Property="Foreground" Value="#AFA2E4" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsExample}" Value="True">
                    <Setter Property="Foreground" Value="#698394" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="22,18,22,15">
            <Border CornerRadius="19" BorderBrush="#455794" BorderThickness="1">
                <Border.Background>
                    <ImageBrush ImageSource="/ColorVision.Engine;component/Assets/Image/BenchmarkOptics.png" Stretch="UniformToFill" />
                </Border.Background>
                <Border CornerRadius="18" Background="#2A070C1A" Padding="20,15,20,14">
                    <StackPanel HorizontalAlignment="Center" MaxWidth="500" MinHeight="208">
                        <TextBlock Text="基准测试得分" Foreground="#D5CFFF" FontSize="16" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,-5,0,-6">
                            <TextBlock x:Name="ScoreText" FontSize="79" FontWeight="Bold"
                                       FontFamily="Segoe UI Variable Display, Segoe UI" Foreground="#FBFDFF" />
                            <TextBlock x:Name="ScoreUnit" Text="分" Foreground="#C0D1F2" VerticalAlignment="Bottom"
                                       FontSize="18" Margin="8,0,0,19" />
                        </StackPanel>
                        <TextBlock x:Name="ScoreSummaryText" Foreground="#C4E5FF" FontSize="13" TextAlignment="Center"
                                   TextWrapping="Wrap" />
                        <Grid HorizontalAlignment="Center" Margin="0,13,0,0">
                            <Button x:Name="ShareButton" Click="Share_Click" Style="{StaticResource ShareActionButton}"
                                    IsEnabled="False" AutomationProperties.Name="{Binding Text, ElementName=ShareButtonText}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="ShareButtonText" Text="分享成绩" />
                                    <TextBlock Text="↗" Margin="9,0,0,0" FontSize="17" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="RetryShareButton" Click="Share_Click" Style="{StaticResource ShareActionButton}"
                                    IsEnabled="False" Visibility="Collapsed"
                                    AutomationProperties.Name="{Binding Text, ElementName=RetryShareButtonText}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="RetryShareButtonText" Text="重试分享" />
                                    <TextBlock Text="↻" Margin="9,0,0,0" FontSize="17" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock x:Name="ShareStatusText" Text="分享后公开硬件配置和得分"
                                   Foreground="#CCD9F4" TextAlignment="Center" TextWrapping="Wrap"
                                   Margin="0,6,0,0" FontSize="12" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Border>
            </Border>

            <Border CornerRadius="15" Padding="17,13" Margin="0,14,0,0" Background="{StaticResource Panel}"
                    BorderBrush="{StaticResource PanelBorder}" BorderThickness="1">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="和其他电脑对比" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button x:Name="RefreshButton" Grid.Column="1" Content="刷新" Style="{StaticResource MinorButton}"
                                VerticalAlignment="Center" Click="Refresh_Click" />
                    </Grid>
                    <TextBlock x:Name="ComparisonStatusText" Foreground="{StaticResource Secondary}" FontSize="12"
                               TextWrapping="Wrap" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite" />
                    <ItemsControl x:Name="ComparisonItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4" ToolTip="{Binding Description}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.45*" />
                                        <ColumnDefinition Width="3.35*" />
                                        <ColumnDefinition Width="70" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Hardware}" TextTrimming="CharacterEllipsis" FontSize="11"
                                                   Foreground="{StaticResource Secondary}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Hardware}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <ProgressBar Grid.Column="1" Maximum="{Binding ScaleMaximum}" Value="{Binding Score}"
                                                 Style="{StaticResource ScoreBar}" VerticalAlignment="Center"
                                                 AutomationProperties.Name="{Binding Label}" />
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Score, StringFormat=N1}" TextAlignment="Right" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Trend}" TextAlignment="Right" FontSize="11">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#8CEBC5" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Trend}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Decreased}" Value="True">
                                                            <Setter Property="Foreground" Value="#FFB6A7" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <StackPanel Margin="0,9,0,0">
                <Button x:Name="DetailsButton" Content="测试详情 ▾" Click="Details_Click" HorizontalAlignment="Left"
                        Style="{StaticResource MinorButton}" Background="Transparent" BorderBrush="Transparent" />
                <StackPanel x:Name="DetailsPanel" Visibility="Collapsed" Margin="9,7,9,0">
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock x:Name="CpuText" Foreground="#EAF1FF" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <Grid x:Name="GpuPanel" Margin="0,3,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="显卡" Foreground="{StaticResource Secondary}" FontSize="12" Margin="0,0,6,0" />
                            <TextBlock x:Name="GpuText" Grid.Column="1" Foreground="{StaticResource Secondary}" TextWrapping="Wrap" FontSize="12" />
                        </Grid>
                        <TextBlock x:Name="MemoryText" Margin="0,4,0,0" Foreground="{StaticResource Secondary}" FontSize="12" />
                    </StackPanel>
                    <TextBlock x:Name="RunDetailsText" Foreground="{StaticResource Secondary}" FontSize="12" TextWrapping="Wrap" />
                    <ItemsControl x:Name="MetricItems" Margin="0,7,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="128" />
                                        <ColumnDefinition Width="128" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" Foreground="#E4EEFF" />
                                    <TextBlock Grid.Column="1" Text="{Binding Median}" Foreground="{StaticResource Secondary}" />
                                    <TextBlock Grid.Column="2" Text="{Binding P95}" Foreground="{StaticResource Secondary}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
