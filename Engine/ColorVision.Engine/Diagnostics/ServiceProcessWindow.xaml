<Window x:Class="ColorVision.Engine.Diagnostics.ServiceProcessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="服务进程诊断 · 许可证统一放行" Width="990" Height="770" MinWidth="760" MinHeight="620"
        WindowStartupLocation="CenterOwner" UseLayoutRounding="True" FontSize="14"
        Background="{DynamicResource GlobalBackground}" Foreground="{DynamicResource GlobalTextBrush}"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="ShowWhenRunning"/>
        <Style x:Key="ServiceCard" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Padding" Value="16,13"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlobalBorderBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="Card" Property="BorderThickness" Value="2,1,1,1"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="22,18,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 0 标题 -->
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="服务进程诊断" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock x:Name="CheckStatus" Margin="0,4,0,0" Text="正在检查 dev / x64 两个本机服务…"
                           AutomationProperties.LiveSetting="Polite" Foreground="{DynamicResource SecondaryTextBrush}"/>
            </StackPanel>
            <Button x:Name="RefreshButton" Grid.Column="1" VerticalAlignment="Center"
                    Content="刷新" Padding="16,5" MinHeight="32" Click="Refresh_Click"/>
        </Grid>

        <!-- 1 环境状态 -->
        <Border Grid.Row="1" Padding="12,8" Margin="0,0,0,10" CornerRadius="6" BorderThickness="1"
                BorderBrush="{DynamicResource GlobalBorderBrush}" Background="{DynamicResource ButtonBackground}">
            <StackPanel>
                <TextBlock x:Name="StatusLine" FontWeight="SemiBold" Text="正在检查权限…"/>
                <TextBlock x:Name="PrivilegeLine" Margin="0,4,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource SecondaryTextBrush}" Text=""/>
            </StackPanel>
        </Border>

        <!-- 2 说明：默认放行 / 移除测量限制 -->
        <Border Grid.Row="2" Padding="12,9" Margin="0,0,0,12" CornerRadius="6" BorderThickness="1"
                BorderBrush="{DynamicResource PrimaryBrush}" Background="{DynamicResource ButtonBackground}">
            <TextBlock TextWrapping="Wrap" LineHeight="21">
                服务心跳每次调用 licenseClientDLL.dll!LicenseValidate 判定有效期，失败即把设备置为
                Unauthorized，后续测量请求（NeedAuth）一律返回 401 —— 这就是测量被限制的来源。
                一键放行使该函数恒返回 TRUE，<Bold>dev 与 x64 两个服务进程同时生效</Bold>；
                默认放行，不再提供任何拒绝 / 限制测量的策略选项。只改进程内存，不改磁盘文件，服务重启后自动失效。
                已处于未授权状态的设备，重新打开或重连一次即可刷新状态。
            </TextBlock>
        </Border>

        <!-- 3 两个服务卡片 -->
        <ListBox x:Name="Services" Grid.Row="3" Margin="-5,0,-5,12" Padding="0" BorderThickness="0"
                 Background="Transparent" SelectionMode="Single" ItemContainerStyle="{StaticResource ServiceCard}"
                 SelectedValuePath="Name" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectionChanged="Services_SelectionChanged"
                 AutomationProperties.Name="本机服务进程">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="2"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Label}" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0"
                                   Text="{Binding Status}" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6,0,0"
                                   Text="{Binding Name}" ToolTip="{Binding Name}" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Margin="0,7,0,0"
                                   Text="{Binding BypassStatus}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryBrush}"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 4 详情：进程列表 + 只读诊断 -->
        <Grid Grid.Row="4" DataContext="{Binding SelectedItem, ElementName=Services}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*"/>
                <ColumnDefinition Width="1.35*"/>
            </Grid.ColumnDefinitions>

            <Border Padding="14,10" Margin="0,0,6,0" CornerRadius="8" BorderThickness="1"
                    BorderBrush="{DynamicResource GlobalBorderBrush}" Background="{DynamicResource ButtonBackground}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding DetailTitle}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,9"/>
                    <ListView Grid.Row="1" ItemsSource="{Binding Instances}" SelectionMode="Single" BorderThickness="0"
                              Background="{DynamicResource ButtonBackground}" Foreground="{DynamicResource GlobalTextBrush}"
                              AutomationProperties.Name="进程详情"
                              Visibility="{Binding IsRunning, Converter={StaticResource ShowWhenRunning}}">
                        <ListView.View>
                            <GridView AllowsColumnReorder="False">
                                <GridViewColumn Header="进程 ID" DisplayMemberBinding="{Binding Id}" Width="82"/>
                                <GridViewColumn Header="启动时间" DisplayMemberBinding="{Binding StartTime}" Width="150"/>
                                <GridViewColumn Header="放行" DisplayMemberBinding="{Binding Bypass}" Width="64"/>
                                <GridViewColumn Header="命中" DisplayMemberBinding="{Binding Hits}" Width="60"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <TextBlock Grid.Row="1" Text="{Binding EmptyDetails}" TextWrapping="Wrap"
                               VerticalAlignment="Center" HorizontalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}" IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <Border Grid.Column="1" Padding="14,10" Margin="6,0,0,0" CornerRadius="8" BorderThickness="1"
                    BorderBrush="{DynamicResource GlobalBorderBrush}" Background="{DynamicResource ButtonBackground}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="目标模块诊断（只读）" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,9"/>
                    <TextBox x:Name="DiagnosticsBox" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                             BorderThickness="0" Background="Transparent"
                             Foreground="{DynamicResource GlobalTextBrush}"
                             FontFamily="Consolas, Microsoft YaHei" FontSize="12"
                             Text="尚未执行只读诊断。"/>
                </Grid>
            </Border>
        </Grid>

        <!-- 5 操作条 -->
        <Grid Grid.Row="5" Margin="0,12,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="HitSummary" FontWeight="SemiBold" Text="放行状态：未放行"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="InspectButton" Content="重新诊断" Padding="14,5" MinHeight="32"
                        Margin="0,0,8,0" Click="Inspect_Click"/>
                <Button x:Name="InstallButton" Content="一键放行（dev + x64）" Padding="16,5" MinHeight="32"
                        Margin="0,0,8,0" FontWeight="SemiBold" Click="Install_Click"/>
                <Button x:Name="RestoreButton" Content="恢复原校验" Padding="14,5" MinHeight="32"
                        Click="Restore_Click"/>
            </StackPanel>
        </Grid>

        <!-- 6 运行日志 -->
        <Border Grid.Row="6" Padding="12,8" CornerRadius="8" BorderThickness="1" MinHeight="128" MaxHeight="170"
                BorderBrush="{DynamicResource GlobalBorderBrush}" Background="{DynamicResource ButtonBackground}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="运行日志" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent"
                         Foreground="{DynamicResource GlobalTextBrush}"
                         FontFamily="Consolas, Microsoft YaHei" FontSize="12"/>
            </Grid>
        </Border>
    </Grid>
</Window>
