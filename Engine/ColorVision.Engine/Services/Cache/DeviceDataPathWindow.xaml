<Window x:Class="ColorVision.Engine.Services.DeviceDataPathWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:engine="clr-namespace:ColorVision.Engine"
        xmlns:properties="clr-namespace:ColorVision.Engine.Properties"
        Title="{engine:EngineLang DeviceDataPathConfigure}"
        Width="650" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13"
        UseLayoutRounding="True" Background="{DynamicResource GlobalBackground}">
    <StackPanel Margin="18,16,18,14">
        <ContentControl x:Name="DataPathEditor" HorizontalContentAlignment="Stretch"/>
        <TextBlock x:Name="DataPathStatus" Margin="0,10,0,0" Visibility="Collapsed"
                   Foreground="{DynamicResource GlobalTextBrush}" TextWrapping="Wrap"/>
        <StackPanel Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button MinWidth="94" MinHeight="32" Margin="0,0,8,0" Padding="12,6"
                    IsDefault="True" Click="ApplyDataPath_Click" Content="{x:Static properties:Resources.ApplySettings}"/>
            <Button MinWidth="82" MinHeight="32" Padding="12,6" IsCancel="True" Content="{x:Static properties:Resources.Close}"/>
        </StackPanel>
    </StackPanel>
</Window>
