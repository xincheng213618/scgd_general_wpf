<Window x:Class="ColorVision.Engine.Services.PhyCameras.Group.CalibrationTemplateCloneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:properties="clr-namespace:ColorVision.Engine.Properties"
        mc:Ignorable="d"
        Title="{x:Static properties:Resources.CloneCalibrationTemplates}"
        Width="640"
        Height="560"
        MinWidth="540"
        MinHeight="440"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{x:Static properties:Resources.CloneCalibrationTemplates}"
                       FontSize="22"
                       FontWeight="SemiBold"/>
            <TextBlock Margin="0,6,0,0"
                       Text="{x:Static properties:Resources.CloneCalibrationTemplatesDescription}"
                       TextWrapping="Wrap"
                       Opacity="0.72"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Margin="0,0,12,10"
                       VerticalAlignment="Center"
                       Text="{x:Static properties:Resources.CloneCalibrationTemplatesTarget}"/>
            <TextBox Grid.Column="1"
                     Margin="0,0,0,10"
                     IsReadOnly="True"
                     Text="{Binding TargetCamera.Code, Mode=OneWay}"/>

            <TextBlock Grid.Row="1"
                       Margin="0,0,12,0"
                       VerticalAlignment="Center"
                       Text="{x:Static properties:Resources.CloneCalibrationTemplatesSource}"/>
            <ComboBox x:Name="SourceCameraComboBox"
                      Grid.Row="1"
                      Grid.Column="1"
                      ItemsSource="{Binding SourceCameras}"
                      SelectedItem="{Binding SelectedSourceCamera, Mode=TwoWay}"
                      SelectionChanged="SourceCameraComboBox_SelectionChanged">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Code}"/>
                            <TextBlock Margin="8,0,0,0" Opacity="0.58">
                                <Run Text="("/>
                                <Run Text="{Binding CalibrationParams.Count, Mode=OneWay}"/>
                                <Run Text=")"/>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <Border Grid.Row="2"
                Margin="0,16,0,10"
                Padding="10,8"
                BorderBrush="{DynamicResource GlobalBorderBrush1}"
                BorderThickness="1"
                CornerRadius="3">
            <TextBlock Text="{x:Static properties:Resources.CloneCalibrationTemplatesSafetyNote}"
                       TextWrapping="Wrap"
                       Opacity="0.75"/>
        </Border>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,8">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Margin="6,0,0,0"
                            Padding="10,4"
                            Click="SelectAll_Click"
                            Content="{x:Static properties:Resources.ButtonSelectAll}"/>
                    <Button Margin="6,0,0,0"
                            Padding="10,4"
                            Click="ClearSelection_Click"
                            Content="{x:Static properties:Resources.Clear}"/>
                </StackPanel>
                <TextBlock VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="{x:Static properties:Resources.CloneCalibrationTemplatesAvailable}"/>
            </DockPanel>

            <ListBox Grid.Row="1"
                     ItemsSource="{Binding Templates}"
                     BorderBrush="{DynamicResource GlobalBorderBrush1}"
                     BorderThickness="1">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="8,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox VerticalAlignment="Center"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                            <TextBlock Grid.Column="1"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="{Binding Name}"/>
                            <TextBlock Grid.Column="2"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       Opacity="0.58"
                                       Text="{Binding CalibrationMode}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <StackPanel Grid.Row="4"
                    Margin="0,18,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button MinWidth="110"
                    Padding="14,7"
                    IsDefault="True"
                    Click="Clone_Click"
                    Content="{x:Static properties:Resources.CloneCalibrationTemplates}"/>
            <Button MinWidth="90"
                    Margin="8,0,0,0"
                    Padding="14,7"
                    IsCancel="True"
                    Content="{x:Static properties:Resources.Cancel}"/>
        </StackPanel>
    </Grid>
</Window>
