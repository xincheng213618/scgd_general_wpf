<Window x:Class="ColorVision.Engine.Services.PhyCameras.Group.CalibrationEdit"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:local="clr-namespace:ColorVision.Engine.Services.PhyCameras.Group"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:properties="clr-namespace:ColorVision.Engine.Properties"
        mc:Ignorable="d"
        Title="{x:Static properties:Resources.CalibrationFileManagement}"
        Width="1100" Height="780" MinWidth="980" MinHeight="620"
        Background="{DynamicResource UpdateDialog.Background}"
        Foreground="{DynamicResource UpdateDialog.TextPrimary}"
        Closed="Window_Closed" Closing="Window_Closing" Initialized="Window_Initialized">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ColorVision.Themes;component/Themes/UpdateDialogTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource UpdateDialog.TextPrimary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource TextBox.Small}" />
        <Style x:Key="SectionCardStyle" TargetType="Border" BasedOn="{StaticResource UpdateDialogCardStyle}">
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="IconActionButtonStyle" TargetType="Button" BasedOn="{StaticResource UpdateDialogTextButtonStyle}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <DataTemplate x:Key="CalibrationRowTemplate">
            <Border BorderBrush="{DynamicResource UpdateDialog.WeakBorder}" BorderThickness="0,0,0,1" Padding="0,3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="82" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Title}" FontSize="13" />
                    <hc:ComboBox Grid.Column="1" Height="30" Margin="0,0,10,0"
                                 hc:InfoElement.ShowClearButton="True" DisplayMemberPath="Name"
                                 ItemsSource="{Binding Resources}" ToolTip="{Binding SelectedResource.Name}"
                                 SelectedItem="{Binding SelectedResource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Grid Grid.Column="2" Width="72" VerticalAlignment="Center">
                        <TextBlock Text="本机缺失" FontSize="11" HorizontalAlignment="Center" Foreground="#B7791F" ToolTip="当前文件在本机不可用">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FileStatus}" Value="本机缺失"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedResource.IsValid}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Button Style="{StaticResource IconActionButtonStyle}" Content="&#xE8E5;" ToolTip="在文件夹中显示" AutomationProperties.Name="定位校正文件" Click="OpenCalibration_Click" />
                            <Button Content="&#xE70F;" ToolTip="编辑文本校正文件" AutomationProperties.Name="编辑校正文件" Click="EditCalibration_Click">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource IconActionButtonStyle}">
                                        <Setter Property="Visibility" Value="Hidden" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedResource.CanEditText}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <Button Style="{StaticResource IconActionButtonStyle}" Content="&#xE898;" AutomationProperties.Name="上传校正文件" Command="{Binding Group.UploadCalibrationItemCommand}" CommandParameter="{Binding SlotKey}" ToolTip="上传此类型的校正文件" />
                        <Button Content="&#xE9D2;" ToolTip="用户校正" AutomationProperties.Name="用户校正" Click="CorrectFourColor_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource IconActionButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanCorrect}" Value="False"><Setter Property="Visibility" Value="Hidden" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
    <Grid x:Name="EditorContent" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="校正文件管理" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="为校正组配置文件 · 修改会在关闭窗口时保存" FontSize="12" Margin="0,4,0,0" Foreground="{DynamicResource UpdateDialog.TextSecondary}" /></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource UpdateDialogTextButtonStyle}" Margin="0,0,8,0"
                        Command="{Binding UploadCalibrationCommand}" Content="上传校正组" />
                <Button x:Name="ExportButton" Style="{StaticResource UpdateDialogTextButtonStyle}" Margin="0,0,8,0"
                        Click="Export_Click" Content="导出" />
                <Button Style="{StaticResource UpdateDialogTextButtonStyle}" Margin="0,0,8,0"
                        Click="LaunchFourColorCorrection_Click" Content="用户校正" />
                <Button Style="{StaticResource UpdateDialogSecondaryButtonStyle}"
                        Command="{Binding OepnCalibrationToolCommand}" Content="创建校正" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" BorderBrush="{DynamicResource UpdateDialog.Border}" BorderThickness="0,1,0,0" />

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource UpdateDialogCardStyle}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="2,0,2,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="校正组" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Items.Count, ElementName=ListView1, StringFormat={}{0} 组}"
                                       FontSize="11" Margin="0,2,0,0" Foreground="{DynamicResource UpdateDialog.TextSecondary}" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource IconActionButtonStyle}" Content="&#xE713;"
                                ToolTip="校正组管理" Click="GroupManagement_Click">
                            <Button.ContextMenu>
                                <ContextMenu FontFamily="Microsoft YaHei UI" FontSize="13">
                                    <MenuItem Header="添加组" Click="Button_Add_Click" />
                                    <Separator />
                                    <MenuItem Header="删除选中组" Click="Button_Delete_Click" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </Grid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0"><Button Content="＋ 添加组" Padding="9,5" Click="Button_Add_Click" /><Button Content="删除" Padding="9,5" Margin="6,0,0,0" Click="Button_Delete_Click" /></StackPanel>
                    <ListBox x:Name="ListView1" Grid.Row="1" Background="Transparent"
                              BorderThickness="0" SelectionChanged="ListView1_SelectionChanged"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="ContextMenu" Value="{Binding ContextMenu}" />
                                <Setter Property="Padding" Value="8,7" />
                                <Setter Property="Margin" Value="0,1" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="RowChrome" Padding="{TemplateBinding Padding}"
                                                    Background="{TemplateBinding Background}" CornerRadius="5">
                                                <ContentPresenter Content="{TemplateBinding Content}"
                                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="RowChrome" Property="Background" Value="{DynamicResource UpdateDialog.SurfaceHover}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="RowChrome" Property="Background" Value="{DynamicResource UpdateDialog.TagBackground}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:GroupResource}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding SysResourceModel.Id}" FontSize="11"
                                               Foreground="{DynamicResource UpdateDialog.TextSecondary}" />
                                    <Grid Grid.Column="1">
                                        <TextBlock Text="{Binding Name}"
                                                   Visibility="{Binding IsEditMode, Converter={StaticResource bool2VisibilityConverter1}}" />
                                        <TextBox Text="{Binding Name}" Tag="{Binding .}" LostFocus="TextBox_LostFocus"
                                                 Visibility="{Binding IsEditMode, Converter={StaticResource bool2VisibilityConverter}}" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Grid x:Name="StackPanelCab" Grid.Column="2">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource SectionCardStyle}" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" FontSize="16" FontWeight="SemiBold" Margin="0,0,16,0" />
                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                    <TextBlock Text="增益" FontSize="11" Margin="0,0,0,3" Foreground="{DynamicResource UpdateDialog.TextSecondary}" />
                                    <TextBox Height="28" Padding="6,3" Text="{Binding Config.Gain, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                    <TextBlock Text="曝光" FontSize="11" Margin="0,0,0,3" Foreground="{DynamicResource UpdateDialog.TextSecondary}" />
                                    <TextBox Height="28" Padding="6,3" Text="{Binding Config.ExpTime, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" Margin="0,0,8,0">
                                    <TextBlock Text="ND" FontSize="11" Margin="0,0,0,3" Foreground="{DynamicResource UpdateDialog.TextSecondary}" />
                                    <TextBox Height="28" Padding="6,3" Text="{Binding Config.ND, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4" Margin="0,0,8,0">
                                    <TextBlock Text="光圈" FontSize="11" Margin="0,0,0,3" Foreground="{DynamicResource UpdateDialog.TextSecondary}" />
                                    <TextBox Height="28" Padding="6,3" Text="{Binding Config.Aperture, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="5" Margin="0,0,8,0">
                                    <TextBlock Text="焦距 (mm)" FontSize="11" Margin="0,0,0,3" Foreground="{DynamicResource UpdateDialog.TextSecondary}" />
                                    <TextBox Height="28" Padding="6,3" Text="{Binding Config.FocalLength, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="6" Margin="0,0,0,0">
                                    <TextBlock Text="对焦距离 (m)" FontSize="11" Margin="0,0,0,3" Foreground="{DynamicResource UpdateDialog.TextSecondary}" />
                                    <TextBox Height="28" Padding="6,3" Text="{Binding Config.FocusDistance, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SectionCardStyle}">
                            <StackPanel>
                                <TextBlock Text="成像校正" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,3" />
                                <ItemsControl ItemsSource="{Binding NormalRows, ElementName=RootWindow}"
                                              ItemTemplate="{StaticResource CalibrationRowTemplate}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCardStyle}" Margin="0">
                            <StackPanel>
                                <TextBlock Text="色度校正" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,3" />
                                <ItemsControl ItemsSource="{Binding PrimaryColorRows, ElementName=RootWindow}"
                                              ItemTemplate="{StaticResource CalibrationRowTemplate}" />
                                <ItemsControl ItemsSource="{Binding SecondaryColorRows, ElementName=RootWindow}"
                                              ItemTemplate="{StaticResource CalibrationRowTemplate}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
        <Border x:Name="ExportBusyOverlay" Panel.ZIndex="100" Background="#66000000"
                Visibility="Collapsed">
            <Border Width="360" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Style="{StaticResource UpdateDialogCardStyle}">
                <StackPanel>
                    <TextBlock Text="正在导出校正文件" FontSize="17" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <ProgressBar x:Name="ExportProgressBar" Height="5" Margin="0,18,0,12"
                                 Minimum="0" Maximum="100" Foreground="{DynamicResource PrimaryBrush}" />
                    <TextBlock x:Name="ExportStatusText" Text="正在准备导出…" FontSize="12"
                               HorizontalAlignment="Center" Foreground="{DynamicResource UpdateDialog.TextSecondary}"
                               AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Text="文件较大时可能需要一些时间，请勿关闭窗口" FontSize="11" Margin="0,6,0,0"
                               HorizontalAlignment="Center" Foreground="{DynamicResource UpdateDialog.TextSecondary}" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
