<Window x:Class="ColorVision.Engine.Services.PhyCameras.CreateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ColorVision.Engine.Services.PhyCameras"
        xmlns:properties="clr-namespace:ColorVision.Engine.Properties"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:CreateWindow}"
        Title="{x:Static properties:Resources.CreateDevice}"
        Height="730" Width="920"
        MinHeight="560" MinWidth="860"
        Foreground="{DynamicResource GlobalTextBrush}"
        Background="{DynamicResource GlobalBackground}"
        WindowStartupLocation="CenterOwner"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Initialized="Window_Initialized">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ColorVision.Engine;component/Services/PhyCameras/PhyCameraConfigStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16,14,16,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="1"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{x:Static properties:Resources.LabelCameraCode}" Style="{StaticResource FieldLabelStyle}"/>
                    <hc:ComboBox x:Name="CameraCode"
                                 Height="32"
                                 IsEditable="True"
                                 SelectedIndex="0"
                                 SelectedValue="{Binding CreateConfig.CameraID}"
                                 Text="{Binding CreateConfig.Code}"
                                 hc:InfoElement.ShowClearButton="True"/>
                    <TextBlock x:Name="DeviceName" Style="{StaticResource InlineSummaryStyle}" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{x:Static properties:Resources.DefaultCaptureMode}" Style="{StaticResource FieldLabelStyle}"/>
                    <ComboBox x:Name="ComboxCameraTakeImageMode"
                              Height="32"
                              SelectedValue="{Binding CreateConfig.TakeImageMode}"
                              SelectedValuePath="Key"
                              DisplayMemberPath="Value"/>
                </StackPanel>
            </Grid>
        </Border>

        <local:PhyCameraConfigEditor x:Name="ConfigEditor" Grid.Row="1"/>

        <Border Grid.Row="2" Background="{DynamicResource GlobalBorderBrush1}" Opacity="0.64"/>

        <Grid Grid.Row="3" Margin="0,14,0,14" MinHeight="52">
                <Button Content="{x:Static properties:Resources.PropertyEdit}"
                        Style="{StaticResource ToolbarButtonStyle}"
                        MinWidth="120"
                        Height="36"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Click="OpenPropertyEditor_Click"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Content="{x:Static properties:Resources.Submit}"
                            Style="{StaticResource PrimaryToolbarButtonStyle}"
                            MinWidth="120"
                            Height="36"
                            Click="Button_Click"/>
                    <Button Content="{x:Static properties:Resources.Cancel}"
                            Style="{StaticResource ToolbarButtonStyle}"
                            MinWidth="120"
                            Height="36"
                            Click="CancelButton_Click"/>
                </StackPanel>
        </Grid>
    </Grid>
</Window>
