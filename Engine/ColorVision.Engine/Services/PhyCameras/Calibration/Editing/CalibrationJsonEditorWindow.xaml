<Window x:Class="ColorVision.Engine.Services.PhyCameras.Calibration.Editing.CalibrationJsonEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="校正参数编辑" Width="1100" Height="790" MinWidth="800" MinHeight="580"
        WindowStartupLocation="CenterOwner" Closing="Window_Closing"
        Background="{DynamicResource UpdateDialog.Background}" Foreground="{DynamicResource UpdateDialog.TextPrimary}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ColorVision.Themes;component/Themes/UpdateDialogTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15" /><Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,12" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Window.CommandBindings><CommandBinding Command="Save" Executed="Save_Executed" CanExecute="Save_CanExecute" /></Window.CommandBindings>
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock x:Name="HeadingText" FontSize="25" FontWeight="SemiBold" />
            <TextBlock x:Name="DescriptionText" Margin="0,5,0,0" TextWrapping="Wrap" Foreground="{DynamicResource UpdateDialog.TextSecondary}" />
        </StackPanel>
        <Border Grid.Row="1" Padding="12,9" Margin="0,0,0,12" Style="{StaticResource UpdateDialogCardStyle}">
            <StackPanel>
                <TextBlock x:Name="PathText" TextWrapping="Wrap" />
                <CheckBox x:Name="ManualConfirmation" Margin="0,8,0,0" Visibility="Collapsed" Content="我已核对手工参数的来源和适用条件；默认模板不代表实测校正" Checked="Confirmation_Changed" Unchecked="Confirmation_Changed" />
            </StackPanel>
        </Border>
        <TabControl x:Name="EditorTabs" Grid.Row="2" SelectionChanged="EditorTabs_SelectionChanged">
            <TabItem x:Name="ParameterTab" Header="参数编辑">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="ParameterPanel" Margin="14" />
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="CurveTab" Header="系数曲线">
                <Grid Margin="14">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock x:Name="CurveDescription" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="最大半径(px)" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBox x:Name="CurveRadius" Text="1000" Width="100" TextChanged="CurveRadius_TextChanged" />
                        <Button Content="更新曲线" Margin="12,0,0,0" Click="RefreshCurve_Click" Style="{StaticResource UpdateDialogSecondaryButtonStyle}" />
                    </StackPanel>
                    <Border Grid.Row="2" BorderBrush="{DynamicResource UpdateDialog.Border}" BorderThickness="1" Background="{DynamicResource UpdateDialog.Background}">
                        <Canvas x:Name="CurveCanvas" ClipToBounds="True" SizeChanged="CurveCanvas_SizeChanged" />
                    </Border>
                    <TextBlock x:Name="CurveStatus" Grid.Row="3" TextWrapping="Wrap" Margin="0,10,0,0" />
                </Grid>
            </TabItem>
            <TabItem x:Name="SpatialTab" Header="空间预览">
                <Grid Margin="14">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Text="灰色网格表示输出坐标，彩色网格表示对应的源采样位置。用于核对参数方向和形变，实际效果需使用图像验证。" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <StackPanel x:Name="PreviewSizePanel" Orientation="Horizontal">
                            <TextBlock Text="预览宽 × 高(px)" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBox x:Name="PreviewWidth" Text="1920" Width="85" />
                            <TextBlock Text="×" VerticalAlignment="Center" Margin="8,0" />
                            <TextBox x:Name="PreviewHeight" Text="1080" Width="85" />
                        </StackPanel>
                        <Button Content="更新预览" Click="RefreshSpatial_Click" Style="{StaticResource UpdateDialogSecondaryButtonStyle}" />
                    </StackPanel>
                    <Border Grid.Row="2" BorderBrush="{DynamicResource UpdateDialog.Border}" BorderThickness="1">
                        <Canvas x:Name="SpatialCanvas" ClipToBounds="True" SizeChanged="SpatialCanvas_SizeChanged" />
                    </Border>
                    <TextBlock x:Name="SpatialStatus" Grid.Row="3" TextWrapping="Wrap" Margin="0,10,0,0" />
                </Grid>
            </TabItem>
            <TabItem x:Name="AdvancedTab" Header="高级 JSON">
                <Grid Margin="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="应用到表单" Click="ApplyAdvanced_Click" Style="{StaticResource UpdateDialogSecondaryButtonStyle}" />
                        <TextBlock Text="保留未显示的扩展字段。保存前会检查字段、数组长度与数值。" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" />
                    </DockPanel>
                    <TextBox x:Name="AdvancedJson" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas" FontSize="13" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextChanged="AdvancedJson_TextChanged" />
                </Grid>
            </TabItem>
        </TabControl>
        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,12,0,12" TextWrapping="Wrap" />
        <DockPanel Grid.Row="4">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="SaveAsButton" Content="另存为" Click="SaveAs_Click" MinWidth="84" Margin="0,0,8,0" Style="{StaticResource UpdateDialogSecondaryButtonStyle}" />
                <Button x:Name="SaveButton" Content="保存" Click="Save_Click" MinWidth="84" Margin="0,0,8,0" Style="{StaticResource UpdateDialogPrimaryButtonStyle}" />
                <Button Content="关闭" Click="Close_Click" MinWidth="72" Style="{StaticResource UpdateDialogSecondaryButtonStyle}" />
            </StackPanel>
            <Button Content="重新加载" Click="Reload_Click" HorizontalAlignment="Left" Style="{StaticResource UpdateDialogSecondaryButtonStyle}" />
        </DockPanel>
    </Grid>
</Window>
