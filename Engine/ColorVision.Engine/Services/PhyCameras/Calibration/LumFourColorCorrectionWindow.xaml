<Window x:Class="ColorVision.Engine.Services.PhyCameras.Calibration.LumFourColorCorrectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="四色校正文件修正"
        Width="1120" Height="660" MinWidth="1020" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource UpdateDialog.Background}"
        Foreground="{DynamicResource UpdateDialog.TextPrimary}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ColorVision.Themes;component/Themes/UpdateDialogTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource UpdateDialog.TextPrimary}" />
            </Style>
            <Style x:Key="FieldTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource TextBox.Small}">
                <Setter Property="Height" Value="34" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="30,26,30,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="1" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,18">
            <StackPanel x:Name="CalculationActions" DockPanel.Dock="Right">
                <Button x:Name="CalculateButton" Width="110" Click="Calculate_Click" Content="计算校正"
                        IsEnabled="{Binding IsChecked, ElementName=ManualDataConfirmed}"
                        Style="{StaticResource UpdateDialogPrimaryButtonStyle}" />
            </StackPanel>
            <TextBlock FontSize="26" FontWeight="SemiBold" Text="四色校正 · 手工数值" />
        </DockPanel>

        <Border Grid.Row="1" Background="{DynamicResource UpdateDialog.Border}" />

        <Border x:Name="SourcePanel" Grid.Row="2" Margin="0,18,0,12" Padding="16,14"
                Style="{StaticResource UpdateDialogCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="112" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource SectionLabelStyle}" Text="原校正文件" />
                <TextBox x:Name="SourcePathBox" Grid.Column="1" Margin="0,0,12,0"
                         Style="{StaticResource FieldTextBoxStyle}" TextChanged="InputChanged" />
                <Button Grid.Column="2" Width="86" Click="BrowseSource_Click"
                        Content="选择文件" Style="{StaticResource UpdateDialogSecondaryButtonStyle}" />
            </Grid>
        </Border>

        <Grid x:Name="ModePanel" Grid.Row="3" Margin="2,0,2,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <RadioButton x:Name="SinglePointMode" GroupName="CorrectionMode" Content="单点修正"
                         VerticalAlignment="Center" Checked="CorrectionMode_Checked" />
            <RadioButton x:Name="FourColorMode" Grid.Column="1" Margin="24,0,0,0"
                         GroupName="CorrectionMode" Content="RGBW（MATLAB）" IsChecked="True"
                         VerticalAlignment="Center" Checked="CorrectionMode_Checked" />
            <RadioButton x:Name="PythonRgbMode" Grid.Column="2" Margin="24,0,0,0" GroupName="CorrectionMode" Content="RGB（Python）"
                         VerticalAlignment="Center" Checked="CorrectionMode_Checked" ToolTip="仅使用 R/G/B，输出 XYZ→XYZ 修正矩阵，不与原矩阵合成。" />
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>

            <Border x:Name="MeasurementPanel" Padding="14" Style="{StaticResource UpdateDialogCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="粘贴" Width="66" Margin="0,0,6,0" Click="Paste_Click" Style="{StaticResource UpdateDialogSecondaryButtonStyle}" />
                            <Button Content="复制全部" Width="86" Click="CopyAll_Click" Style="{StaticResource UpdateDialogSecondaryButtonStyle}" />
                        </StackPanel>
                        <StackPanel><TextBlock Style="{StaticResource SectionLabelStyle}" Text="测量数据" />
                        </StackPanel>
                    </DockPanel>
                    <DataGrid x:Name="MeasurementsGrid" Grid.Row="1"
                              Style="{x:Null}" SelectionUnit="Cell" SelectionMode="Extended" ClipboardCopyMode="ExcludeHeader"
                              PreviewKeyDown="MeasurementsGrid_PreviewKeyDown" ToolTip="Ctrl+V 粘贴；Ctrl+C 复制选区"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserReorderColumns="False" CanUserResizeRows="False" CanUserSortColumns="False"
                              HeadersVisibility="Column" GridLinesVisibility="All"
                              RowHeight="38" ColumnHeaderHeight="34"
                              BorderThickness="1" BorderBrush="{DynamicResource UpdateDialog.Border}" Background="{DynamicResource UpdateDialog.Surface}"
                              HorizontalGridLinesBrush="{DynamicResource UpdateDialog.WeakBorder}"
                              VerticalGridLinesBrush="{DynamicResource UpdateDialog.WeakBorder}">
                        <DataGrid.Resources><Style TargetType="TextBox"><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="Padding" Value="5,0" /></Style></DataGrid.Resources>
                        <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource UpdateDialog.TextPrimary}" /></Style></DataGrid.RowStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="1" /><Setter Property="BorderBrush" Value="Transparent" />
                                <Setter Property="Padding" Value="5,0" /><Setter Property="Foreground" Value="{DynamicResource UpdateDialog.TextPrimary}" />
                                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center" /></Border></ControlTemplate></Setter.Value></Setter>
                                <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource UpdateDialog.TagBackground}" /><Setter Property="BorderBrush" Value="{DynamicResource UpdateDialog.Accent}" /></Trigger></Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{DynamicResource UpdateDialog.TextSecondary}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource UpdateDialog.WeakBorder}" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="54" Header="目标" IsReadOnly="True" Binding="{Binding Target}" />
                            <DataGridTextColumn Width="*" Header="相机 Y" Binding="{Binding CameraY, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Width="*" Header="相机 x" Binding="{Binding CameraX, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Width="*" Header="相机 y" Binding="{Binding CameraYChromaticity, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Width="*" Header="光谱 Y" Binding="{Binding ReferenceY, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Width="*" Header="光谱 x" Binding="{Binding ReferenceX, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Width="*" Header="光谱 y" Binding="{Binding ReferenceYChromaticity, UpdateSourceTrigger=PropertyChanged}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <CheckBox x:Name="ManualDataConfirmed" Grid.Row="2" Margin="0,12,0,0" Unchecked="InputChanged">
                        <TextBlock Text="已核对测量数据" ToolTip="核对色块、原校正文件及光谱 IP（30%～95%）；修改数据后需重新确认。" />
                    </CheckBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Padding="16" Style="{StaticResource UpdateDialogCardStyle}">
                <StackPanel>
                    <TextBlock x:Name="ResultTitle" Style="{StaticResource SectionLabelStyle}" Text="计算结果" />
                    <TextBox x:Name="ResultPreview" Margin="0,12,0,0" Height="184"
                             Padding="12" IsReadOnly="True" AcceptsReturn="True"
                             FontFamily="Cascadia Mono,Consolas" FontSize="12"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             HorizontalContentAlignment="Left" VerticalContentAlignment="Top" />
                    <TextBlock x:Name="StatusText" Margin="0,14,0,0" FontSize="12"
                               Foreground="{DynamicResource UpdateDialog.TextSecondary}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="5" Margin="0,18,0,0" Background="{DynamicResource UpdateDialog.Border}" />

        <Grid Grid.Row="6" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="BackupPathText" Visibility="Collapsed" Margin="0,0,16,0" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                       Foreground="{DynamicResource UpdateDialog.TextSecondary}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="CloseButton" Width="96" Click="Close_Click" Content="关闭"
                        Style="{StaticResource UpdateDialogTextButtonStyle}" />
                <Button x:Name="SaveButton" Width="132" Margin="10,0,0,0" Click="SaveAs_Click"
                        Content="另存为" IsEnabled="False"
                        Style="{StaticResource UpdateDialogSecondaryButtonStyle}" />
                <Button x:Name="ReplaceButton" Width="216" Margin="10,0,0,0" Click="ReplaceCurrent_Click"
                        Content="替换当前文件并重启服务" IsEnabled="False" ToolTipService.ShowOnDisabled="True"
                        ToolTip="备份原校正文件后替换，并重启 ColorVision 服务。"
                        Style="{StaticResource UpdateDialogPrimaryButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
