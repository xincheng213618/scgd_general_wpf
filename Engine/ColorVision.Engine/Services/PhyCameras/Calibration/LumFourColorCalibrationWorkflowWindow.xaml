<Window x:Class="ColorVision.Engine.Services.PhyCameras.Calibration.LumFourColorCalibrationWorkflowWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="四色校正采集"
        Width="1260" Height="800" MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource UpdateDialog.Background}"
        Foreground="{DynamicResource UpdateDialog.TextPrimary}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Closed="Window_Closed">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ColorVision.Themes;component/Themes/UpdateDialogTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="17" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="CaptionStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{DynamicResource UpdateDialog.TextSecondary}" />
            </Style>
            <Style x:Key="FieldBoxStyle" TargetType="TextBox" BasedOn="{StaticResource TextBox.Small}">
                <Setter Property="Height" Value="32" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style x:Key="FieldComboStyle" TargetType="ComboBox" BasedOn="{StaticResource ComboBox.Small}">
                <Setter Property="Height" Value="32" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style x:Key="DataLabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource UpdateDialog.TextSecondary}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="28,22,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="1" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="28" FontWeight="SemiBold" Text="四色校正采集" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionStyle}"
                           Text="完成相机 POI 测量与光谱采集后更新校正文件，两侧采集顺序不限。" />
            </StackPanel>
            <Button Grid.Column="1" Width="92" Height="34" Click="OpenManual_Click"
                    Content="手动录入" Style="{StaticResource UpdateDialogTextButtonStyle}" />
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource UpdateDialog.Border}" />

        <Border Grid.Row="2" Margin="0,16,0,14" Padding="16,13" Style="{StaticResource UpdateDialogCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="84" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="116" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="230" />
                </Grid.ColumnDefinitions>

                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="原校正文件" />
                <TextBox x:Name="SourcePathBox" Grid.Column="1" Grid.ColumnSpan="5" IsReadOnly="True"
                         Style="{StaticResource FieldBoxStyle}" TextChanged="SourcePathBox_TextChanged" />
                <Button Grid.Column="7" Height="32" Click="BrowseSource_Click" Content="选择原校正文件"
                        Style="{StaticResource UpdateDialogSecondaryButtonStyle}" />

                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Width="84" VerticalAlignment="Center" FontWeight="SemiBold" Text="采集方式" />
                    <RadioButton x:Name="FourColorMode" GroupName="CorrectionMode" Content="RGBW 四色"
                                 IsChecked="True" VerticalAlignment="Center" Checked="CorrectionMode_Checked" />
                    <RadioButton x:Name="SinglePointMode" Margin="22,0,0,0" GroupName="CorrectionMode"
                                 Content="单点" VerticalAlignment="Center" Checked="CorrectionMode_Checked" />
                </StackPanel>

                <TextBlock Grid.Row="2" Grid.Column="3" VerticalAlignment="Center" FontWeight="SemiBold" Text="相机" />
                <ComboBox x:Name="CameraCombo" Grid.Row="2" Grid.Column="5" DisplayMemberPath="Name"
                          SelectionChanged="CameraCombo_SelectionChanged" Style="{StaticResource FieldComboStyle}" />
                <Grid Grid.Row="2" Grid.Column="7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="86" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="校正模板" />
                    <ComboBox x:Name="CalibrationCombo" Grid.Column="1" DisplayMemberPath="Key"
                              Style="{StaticResource FieldComboStyle}" />
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="205" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="310" />
            </Grid.ColumnDefinitions>

            <Border Padding="14" Style="{StaticResource UpdateDialogCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="采集进度" />
                    <TextBlock Grid.Row="1" Margin="0,4,0,12" Style="{StaticResource CaptionStyle}"
                               Text="按色块逐项完成" />
                    <ListBox x:Name="SampleList" Grid.Row="2" BorderThickness="0" Background="Transparent"
                             SelectionChanged="SampleList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,4" Height="48">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="16" VerticalAlignment="Center"
                                            Background="{DynamicResource UpdateDialog.TagBackground}">
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontWeight="SemiBold" Text="{Binding Name}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                        <TextBlock Margin="0,2,0,0" Style="{StaticResource CaptionStyle}" Text="{Binding Progress}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock FontWeight="SemiBold" Text="光谱仪" />
                        <ComboBox x:Name="SpectrumCombo" Grid.Row="2" DisplayMemberPath="Name"
                                  Style="{StaticResource FieldComboStyle}" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Padding="14" Style="{StaticResource UpdateDialogCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="CIE 图像与 POI" />
                        <TextBlock x:Name="CurrentTargetText" Grid.Column="1" VerticalAlignment="Center"
                                   Foreground="{DynamicResource UpdateDialog.Accent}" FontWeight="SemiBold" />
                    </Grid>
                    <Grid x:Name="ImageSurface" Grid.Row="2" ClipToBounds="True" Background="#151515"
                          SizeChanged="ImageSurface_SizeChanged">
                        <Image x:Name="CieImage" Stretch="Uniform" />
                        <Canvas x:Name="PoiCanvas" Background="Transparent"
                                MouseLeftButtonDown="PoiCanvas_MouseLeftButtonDown"
                                MouseMove="PoiCanvas_MouseMove"
                                MouseLeftButtonUp="PoiCanvas_MouseLeftButtonUp" />
                        <StackPanel x:Name="EmptyImagePanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center" Foreground="#D0D0D0" FontSize="15" Text="尚未取图" />
                            <TextBlock Margin="0,6,0,0" Foreground="#8E8E8E" FontSize="12" Text="可连接相机取图，或加载 CVCIE 文件" />
                        </StackPanel>
                    </Grid>
                    <UniformGrid x:Name="OperationPanel" Grid.Row="4" Columns="4">
                        <Button x:Name="CaptureCameraButton" Margin="0,0,6,0" Height="36" Click="CaptureCamera_Click"
                                Content="相机取图" Style="{StaticResource UpdateDialogPrimaryButtonStyle}" />
                        <Button x:Name="LoadCieButton" Margin="2,0,4,0" Height="36" Click="LoadCie_Click"
                                Content="加载 CIE" Style="{StaticResource UpdateDialogSecondaryButtonStyle}" />
                        <Button x:Name="DrawPoiButton" Margin="4,0,2,0" Height="36" Click="DrawPoi_Click"
                                Content="绘制 POI" Style="{StaticResource UpdateDialogSecondaryButtonStyle}" />
                        <Button x:Name="CaptureSpectrumButton" Margin="6,0,0,0" Height="36" Click="CaptureSpectrum_Click"
                                Content="采集光谱" Style="{StaticResource UpdateDialogSecondaryButtonStyle}" />
                    </UniformGrid>
                </Grid>
            </Border>

            <Border Grid.Column="4" Padding="14" Style="{StaticResource UpdateDialogCardStyle}">
                <Grid x:Name="MeasurementPanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="测量数据" />

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="26" />
                            <RowDefinition Height="26" />
                            <RowDefinition Height="26" />
                            <RowDefinition Height="26" />
                            <RowDefinition Height="26" />
                            <RowDefinition Height="26" />
                            <RowDefinition Height="26" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.ColumnSpan="2" FontWeight="SemiBold" Text="相机 POI" />
                        <TextBlock Grid.Row="1" Style="{StaticResource DataLabelStyle}" Text="X" />
                        <TextBlock Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Text="{Binding CameraX, StringFormat={}{0:G9}}" />
                        <TextBlock Grid.Row="2" Style="{StaticResource DataLabelStyle}" Text="Y" />
                        <TextBlock Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Text="{Binding CameraY, StringFormat={}{0:G9}}" />
                        <TextBlock Grid.Row="3" Style="{StaticResource DataLabelStyle}" Text="Z" />
                        <TextBlock Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Text="{Binding CameraZ, StringFormat={}{0:G9}}" />
                        <TextBlock Grid.Row="4" Style="{StaticResource DataLabelStyle}" Text="CIE x" />
                        <TextBlock Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" Text="{Binding CameraCieX, StringFormat={}{0:G9}}" />
                        <TextBlock Grid.Row="5" Style="{StaticResource DataLabelStyle}" Text="CIE y" />
                        <TextBlock Grid.Row="5" Grid.Column="1" VerticalAlignment="Center" Text="{Binding CameraCieY, StringFormat={}{0:G9}}" />
                        <TextBlock Grid.Row="6" Style="{StaticResource DataLabelStyle}" Text="增益" />
                        <TextBlock Grid.Row="6" Grid.Column="1" VerticalAlignment="Center" Text="{Binding CameraGain, StringFormat={}{0:G7}}" />
                        <TextBlock Grid.Row="7" Style="{StaticResource DataLabelStyle}" Text="曝光" />
                        <TextBlock Grid.Row="7" Grid.Column="1" VerticalAlignment="Center" Text="{Binding CameraExposure}"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding CameraExposure}" />
                    </Grid>

                    <Border Grid.Row="3" Margin="0,12" Background="{DynamicResource UpdateDialog.WeakBorder}" />

                    <Grid Grid.Row="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="26" />
                            <RowDefinition Height="26" />
                            <RowDefinition Height="26" />
                            <RowDefinition Height="26" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.ColumnSpan="2" FontWeight="SemiBold" Text="光谱仪" />
                        <TextBlock Grid.Row="1" Style="{StaticResource DataLabelStyle}" Text="Y" />
                        <TextBlock Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Text="{Binding ReferenceY, StringFormat={}{0:G9}}" />
                        <TextBlock Grid.Row="2" Style="{StaticResource DataLabelStyle}" Text="CIE x" />
                        <TextBlock Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Text="{Binding ReferenceCieX, StringFormat={}{0:G9}}" />
                        <TextBlock Grid.Row="3" Style="{StaticResource DataLabelStyle}" Text="CIE y" />
                        <TextBlock Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Text="{Binding ReferenceCieY, StringFormat={}{0:G9}}" />
                        <TextBlock Grid.Row="4" Style="{StaticResource DataLabelStyle}" Text="结果 ID" />
                        <TextBlock Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" Text="{Binding SpectrumResultId}" />
                    </Grid>

                    <Border Grid.Row="5" Margin="0,12" Background="{DynamicResource UpdateDialog.WeakBorder}" />

                    <Grid Grid.Row="6" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontWeight="SemiBold" Text="光谱数据" />
                        <TextBlock x:Name="SpectrumCountText" Grid.Column="1" Style="{StaticResource CaptionStyle}" />
                    </Grid>
                    <DataGrid x:Name="SpectrumGrid" Grid.Row="7" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" BorderThickness="0" Background="Transparent"
                              RowHeight="25" ColumnHeaderHeight="28">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="*" Header="波长 (nm)" Binding="{Binding Wavelength, StringFormat={}{0:F1}}" />
                            <DataGridTextColumn Width="*" Header="值" Binding="{Binding Value, StringFormat={}{0:G8}}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="4" Margin="0,16,0,0" Background="{DynamicResource UpdateDialog.Border}" />

        <Grid Grid.Row="5" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{DynamicResource UpdateDialog.TextSecondary}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Width="92" Click="Close_Click" Content="关闭" Style="{StaticResource UpdateDialogTextButtonStyle}" />
                <Button x:Name="CalculateButton" Width="112" Margin="10,0,0,0" Click="Calculate_Click"
                        Content="计算校正" IsEnabled="False" Style="{StaticResource UpdateDialogSecondaryButtonStyle}" />
                <Button x:Name="SaveButton" Width="112" Margin="10,0,0,0" Click="SaveAs_Click"
                        Content="保存结果" IsEnabled="False" Style="{StaticResource UpdateDialogPrimaryButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
