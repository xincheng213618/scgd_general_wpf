<Window x:Class="ColorVision.Engine.Services.PhyCameras.Calibration.LumFourColorSpectrumSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择已有光谱" Width="860" Height="520" MinWidth="760" MinHeight="420" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource UpdateDialog.Background}" Foreground="{DynamicResource UpdateDialog.TextPrimary}">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/ColorVision.Themes;component/Themes/UpdateDialogTheme.xaml" />
    </ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock x:Name="TargetText" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Margin="0,8,0,16" Text="所选设备最近 100 条亮度结果。请按采集时间、色块及 ND 核对；选中后点击使用。" TextWrapping="Wrap" />
        <DataGrid x:Name="ResultsGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  SelectionMode="Single" SelectionUnit="FullRow" SelectionChanged="ResultsGrid_SelectionChanged" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Width="65" Binding="{Binding ResultId}" />
                <DataGridTextColumn Header="采集时间" Width="165" Binding="{Binding CapturedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
                <DataGridTextColumn Header="Y" Width="*" Binding="{Binding Y, StringFormat={}{0:G8}}" />
                <DataGridTextColumn Header="CIE x" Width="*" Binding="{Binding CieX, StringFormat={}{0:G7}}" />
                <DataGridTextColumn Header="CIE y" Width="*" Binding="{Binding CieY, StringFormat={}{0:G7}}" />
                <DataGridTextColumn Header="IP (%)" Width="85" Binding="{Binding IpPercent, StringFormat={}{0:F2}}" />
                <DataGridTextColumn Header="ND" Width="55" Binding="{Binding NdPort}" />
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Width="88" IsCancel="True" Style="{StaticResource UpdateDialogTextButtonStyle}" />
            <Button x:Name="UseButton" Content="使用所选结果" Width="130" Margin="8,0,0,0" IsEnabled="False" Click="Use_Click" Style="{StaticResource UpdateDialogPrimaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
