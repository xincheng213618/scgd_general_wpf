<UserControl x:Class="ColorVision.Engine.Services.PhyCameras.InfoPhyCamera"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ColorVision.Engine.Services.PhyCameras"
             xmlns:properties="clr-namespace:ColorVision.Engine.Properties"
             mc:Ignorable="d" UseLayoutRounding="True"
             d:DataContext="{d:DesignInstance local:PhyCamera}"
             d:DesignHeight="560" d:DesignWidth="620">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ColorVision.Engine;component/Services/PhyCameras/PhyCameraConsoleStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <local:StatusToTextConverter x:Key="StatusToTextConverter"/>
            <local:StatusToBrushConverter x:Key="StatusToBrushConverter"/>

            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            </Style>
            <Style x:Key="HeaderIconButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseActionButtonStyle}">
                <Setter Property="Width" Value="28"/>
                <Setter Property="MinHeight" Value="28"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="4,0,0,0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}"/>
            </Style>
            <Style x:Key="CommandButtonTextStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="FontWeight" Value="Medium"/>
            </Style>
            <Style x:Key="CameraCommandButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource CommandActionButtonStyle}">
                <Setter Property="MinHeight" Value="38"/>
                <Setter Property="Margin" Value="0,0,8,6"/>
                <Setter Property="Padding" Value="8,7"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}"/>
                <Setter Property="Background" Value="{DynamicResource GlobalBackground}"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
            </Style>
            <Style x:Key="CameraResetButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource CameraCommandButtonStyle}">
                <Setter Property="MinWidth" Value="112"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
                <Setter Property="Foreground" Value="#FFD92D20"/>
                <Setter Property="BorderBrush" Value="#FFD92D20"/>
            </Style>
            <Style x:Key="ActionSectionIconStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
            </Style>
            <Style x:Key="ActionSectionCardStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource ConsoleSurfaceStyle}">
                <Setter Property="Background" Value="{DynamicResource GlobalBorderBrush}"/>
                <Setter Property="Padding" Value="12,10,4,4"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource ConsoleSurfaceStyle}" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding DeviceModeDisplayText}" FontSize="20" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding SysResourceModel.Remark, Converter={StaticResource StatusToTextConverter}}"
                               Foreground="{Binding SysResourceModel.Remark, Converter={StaticResource StatusToBrushConverter}}"
                               FontSize="12" FontWeight="SemiBold"/>
                </Grid>
                <TextBox Text="{Binding Code, Mode=OneWay}" Style="{StaticResource CopyableTextBoxStyle}"
                         FontFamily="Consolas" FontSize="12" Opacity="0.7" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding CameraInfoMetaText, Mode=OneWay}" FontSize="11" Opacity="0.65"
                           TextWrapping="Wrap" Margin="0,4,0,0"/>

                <Border Background="{DynamicResource GlobalBorderBrush}" CornerRadius="6" Padding="10,6" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <WrapPanel VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Text="{Binding LicenseStatusBadgeText}" Foreground="{Binding LicenseStatusBrush}"
                                       FontSize="11" FontWeight="SemiBold" Margin="0,2,6,2"/>
                            <TextBlock Text="{Binding LicenseSummaryMetaText}" FontSize="11" Opacity="0.7" Margin="0,2,0,2"/>
                        </WrapPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource BaseActionButtonStyle}" Content="{x:Static properties:Resources.Update}"
                                    Command="{Binding UploadLicenseCommand}" ToolTip="{x:Static properties:Resources.ModifyLicense}"
                                    MinHeight="28" Padding="6,2" Margin="0" FontSize="11" Background="Transparent" BorderThickness="0"/>
                            <Button Style="{StaticResource HeaderIconButtonStyle}" Content="&#xE896;"
                                    Command="{Binding UploadLicenseNetCommand}" ToolTip="{x:Static properties:Resources.DownLicOnline}"/>
                            <Button Style="{StaticResource HeaderIconButtonStyle}" Content="&#xE8C8;"
                                    Command="{Binding CopyLicenseCommand}" ToolTip="{x:Static properties:Resources.CopyLicense}"/>
                            <Button Style="{StaticResource HeaderIconButtonStyle}" Content="&#xEDE1;"
                                    Command="{Binding ExportLicenseCommand}" ToolTip="{x:Static properties:Resources.ExportLicense}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
            <Border Grid.Row="1" Height="1" Background="{DynamicResource ButtonBorderBrush}" Margin="0,14,0,14"/>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False" Focusable="False" Padding="0,0,2,0">
                <StackPanel>
                <Border Style="{StaticResource ActionSectionCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="&#xE713;" Style="{StaticResource ActionSectionIconStyle}"/>
                            <TextBlock Text="{x:Static properties:Resources.PhyCameraConfigurationSection}" Style="{StaticResource ConsoleSectionTitleStyle}"
                                       ToolTip="{x:Static properties:Resources.PhyCameraConfigurationHint}"/>
                        </StackPanel>
                        <UniformGrid Columns="4" SizeChanged="ActionGrid_SizeChanged">
                            <Button Style="{StaticResource CameraCommandButtonStyle}" Command="{Binding EditCommand}">
                                <TextBlock Text="{x:Static properties:Resources.ModifyConfiguration}" Style="{StaticResource CommandButtonTextStyle}"/>
                            </Button>
                            <Button Style="{StaticResource CameraCommandButtonStyle}" Command="{Binding PropertyEditorEditCommand}">
                                <TextBlock Text="{x:Static properties:Resources.PropertyEdit}" Style="{StaticResource CommandButtonTextStyle}"/>
                            </Button>
                            <Button Style="{StaticResource CameraCommandButtonStyle}" Command="{Binding OpenSettingDirectoryCommand}">
                                <TextBlock Text="{x:Static properties:Resources.ButtonOpenConfigFile}" Style="{StaticResource CommandButtonTextStyle}"/>
                            </Button>
                            <Button Style="{StaticResource CameraCommandButtonStyle}" Command="{Binding FilterWheelEditCommand}">
                                <TextBlock Text="{x:Static properties:Resources.EditFilterWheelConfig}" Style="{StaticResource CommandButtonTextStyle}"/>
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ActionSectionCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="&#xE9E9;" Style="{StaticResource ActionSectionIconStyle}"/>
                            <TextBlock Text="{x:Static properties:Resources.PhyCameraCalibrationSection}" Style="{StaticResource ConsoleSectionTitleStyle}"
                                       ToolTip="{x:Static properties:Resources.PhyCameraCalibrationHint}"/>
                        </StackPanel>
                        <UniformGrid Columns="4" SizeChanged="ActionGrid_SizeChanged">
                            <Button Style="{StaticResource CameraCommandButtonStyle}" Command="{Binding UploadCalibrationCommand}">
                                <TextBlock Text="{x:Static properties:Resources.UploadCalibrationFiles}" Style="{StaticResource CommandButtonTextStyle}"/>
                            </Button>
                            <Button Style="{StaticResource CameraCommandButtonStyle}" Command="{Binding CalibrationTemplateOpenCommand}">
                                <TextBlock Text="{x:Static properties:Resources.CaliTemplateSet}" Style="{StaticResource CommandButtonTextStyle}"/>
                            </Button>
                            <Button Style="{StaticResource CameraCommandButtonStyle}" Command="{Binding CloneCalibrationTemplatesCommand}">
                                <TextBlock Text="{x:Static properties:Resources.CloneCalibrationTemplates}" Style="{StaticResource CommandButtonTextStyle}"/>
                            </Button>
                            <Button Style="{StaticResource CameraCommandButtonStyle}" Command="{Binding CalibrationEditCommand}">
                                <TextBlock Text="{x:Static properties:Resources.ButtonCalibrationEdit}" Style="{StaticResource CommandButtonTextStyle}"/>
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ActionSectionCardStyle}" Margin="0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="&#xE81C;" Style="{StaticResource ActionSectionIconStyle}"/>
                            <TextBlock Text="{x:Static properties:Resources.PhyCameraRecoverySection}" Style="{StaticResource ConsoleSectionTitleStyle}"
                                       ToolTip="{x:Static properties:Resources.PhyCameraRecoveryHint}"/>
                        </StackPanel>
                        <UniformGrid Columns="4" SizeChanged="ActionGrid_SizeChanged">
                            <Button Style="{StaticResource CameraCommandButtonStyle}" Command="{Binding CreatResotreCommand}">
                                <TextBlock Text="{x:Static properties:Resources.CreateRestorePoint}" Style="{StaticResource CommandButtonTextStyle}"/>
                            </Button>
                            <Button Style="{StaticResource CameraCommandButtonStyle}" Command="{Binding LoadResotreCommand}">
                                <TextBlock Text="{x:Static properties:Resources.LoadRestorePoint}" Style="{StaticResource CommandButtonTextStyle}"/>
                            </Button>
                        </UniformGrid>
                        <Border Height="1" Background="{DynamicResource ButtonBorderBrush}" Margin="0,6,8,10"/>
                        <Grid Margin="0,0,8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Static properties:Resources.PhyCameraResetHint}" FontSize="11" Opacity="0.65"
                                       TextWrapping="Wrap" Margin="0,0,16,6" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Style="{StaticResource CameraResetButtonStyle}" Command="{Binding ResetCommand}">
                                <TextBlock Text="{x:Static properties:Resources.Reset}" Style="{StaticResource CommandButtonTextStyle}"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
