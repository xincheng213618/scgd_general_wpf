<Window x:Class="ColorVision.Engine.Services.PhySpectrums.PhySpectrumManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:properties="clr-namespace:ColorVision.Engine.Properties"
        Title="{x:Static properties:Resources.PhysicalSpectrumManager}"
        Width="1020" Height="740" MinWidth="880" MinHeight="660"
        Background="{DynamicResource GlobalBorderBrush}" SnapsToDevicePixels="True" UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ColorVision.Engine;component/Services/PhyCameras/PhyCameraConsoleStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="SpectrumListItem" TargetType="ListBoxItem">
                <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
                <Setter Property="Padding" Value="12"/>
                <Setter Property="Background" Value="{DynamicResource GlobalBackground}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                    <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="{x:Static properties:Resources.PhysicalSpectrumManager}" FontSize="23" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding SummaryText}" Margin="0,7,0,0" Opacity="0.65"/>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource ConsoleSurfaceStyle}" Padding="12" Margin="0,0,0,14">
            <WrapPanel>
                <Button Content="{x:Static properties:Resources.SpectrumScanOnline}" Command="{Binding ScanCommand}" Style="{StaticResource PrimaryToolbarButtonStyle}"/>
                <TextBlock Text="{x:Static properties:Resources.SpectrumScanPort}" Margin="4,0,8,6"/>
                <TextBox Text="{Binding ComPort, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="48" VerticalContentAlignment="Center" Margin="0,0,12,6" ToolTip="{x:Static properties:Resources.SpectrumScanPortHint}"/>
                <Button Content="{x:Static properties:Resources.SpectrumUpdateAllLicenses}" Command="{Binding UpdateAllCommand}" Style="{StaticResource ToolbarButtonStyle}"/>
                <Button Content="{x:Static properties:Resources.Refresh}" Command="{Binding RefreshCommand}" Style="{StaticResource ToolbarButtonStyle}"/>
            </WrapPanel>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" MinWidth="270"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*" MinWidth="390"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource ConsoleSurfaceStyle}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{x:Static properties:Resources.SpectrumSerialList}" Style="{StaticResource ConsoleSectionTitleStyle}"/>
                    <StackPanel Grid.Row="1" Margin="0,10,0,12">
                        <TextBlock Text="{x:Static properties:Resources.SpectrumSearchSerial}" FontSize="11" Opacity="0.65" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" MinHeight="30" VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <ListBox Grid.Row="2" ItemsSource="{Binding FilteredSpectrums}" SelectedItem="{Binding SelectedSpectrum}"
                             Foreground="{DynamicResource GlobalTextBrush}" Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource SpectrumListItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding DiscoveryText}" FontSize="10" Opacity="0.65" Margin="8,0,0,0"/>
                                        <TextBlock Text="{Binding DisplayModel}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding SN}" FontFamily="Consolas" FontSize="12" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding SN}"/>
                                    <DockPanel Margin="0,7,0,0">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding RegistrationText}" FontSize="10" Opacity="0.6"/>
                                        <TextBlock Text="{Binding LicenseStatus}" Foreground="{Binding LicenseBrush}" FontSize="11"/>
                                    </DockPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="3" Margin="0,12,0,0">
                        <TextBlock Text="{x:Static properties:Resources.SpectrumAddSerial}" FontSize="11" Opacity="0.65" Margin="0,0,0,6"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{x:Static properties:Resources.SpectrumRegister}" Command="{Binding AddCommand}" Style="{StaticResource BaseActionButtonStyle}" Margin="6,0,0,0"/>
                            <TextBox Text="{Binding NewSerial, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"/>
                        </DockPanel>
                    </StackPanel>
                </Grid>
            </Border>
            <GridSplitter Grid.Column="1" Width="14" HorizontalAlignment="Stretch" Background="Transparent" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>
            <Border Grid.Column="2" Style="{StaticResource ConsoleSurfaceStyle}" Padding="20">
                <Grid>
                    <TextBlock Text="{x:Static properties:Resources.SpectrumEmptySelection}" HorizontalAlignment="Center" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelection}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding HasSelection, Converter={StaticResource BoolVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedSpectrum.DisplayModel}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBox Text="{Binding SelectedSpectrum.SN, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontFamily="Consolas" FontSize="15" Margin="0,8,0,12"/>
                            <WrapPanel Margin="0,0,0,12">
                                <TextBlock Text="{Binding SelectedSpectrum.DiscoveryText}" Margin="0,0,14,6"/>
                                <TextBlock Text="{Binding SelectedSpectrum.RegistrationText}" Opacity="0.65" Margin="0,0,14,6"/>
                                <Button Content="{x:Static properties:Resources.SpectrumRegister}" Command="{Binding RegisterCommand}" Style="{StaticResource BaseActionButtonStyle}"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding SelectedSpectrum.DiscoverySource}" Opacity="0.65" TextWrapping="Wrap" Margin="0,0,0,14"/>
                            <Border Style="{StaticResource SectionPanelStyle}" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="{x:Static properties:Resources.SpectrumLicenseSection}" Style="{StaticResource ConsoleSectionTitleStyle}"/>
                                    <TextBlock Text="{Binding SelectedSpectrum.LicenseStatus}" Foreground="{Binding SelectedSpectrum.LicenseBrush}" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,12"/>
                                    <Grid Margin="0,0,0,18">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{x:Static properties:Resources.SpectrumLicenseExpiry}" Style="{StaticResource LabelTextStyle}"/>
                                            <TextBlock Text="{Binding SelectedSpectrum.ExpiryText}" Style="{StaticResource ValueTextStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{x:Static properties:Resources.SpectrumLicenseCustomer}" Style="{StaticResource LabelTextStyle}"/>
                                            <TextBlock Text="{Binding SelectedSpectrum.Customer}" Style="{StaticResource ValueTextStyle}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                    <WrapPanel>
                                        <Button Content="{x:Static properties:Resources.SpectrumUpdateLicense}" Command="{Binding UpdateCommand}" Style="{StaticResource PrimaryToolbarButtonStyle}"/>
                                        <Button Content="{x:Static properties:Resources.SpectrumImportLicense}" Command="{Binding ImportCommand}" Style="{StaticResource ToolbarButtonStyle}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <TextBox Text="{Binding SelectedSpectrum.OperationResult, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" MaxHeight="120" VerticalScrollBarVisibility="Auto"/>
                            <TextBlock Text="{x:Static properties:Resources.SpectrumManagerHint}" Opacity="0.6" TextWrapping="Wrap" Margin="0,14,0,0" FontSize="11"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,6" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"/>
            <TextBox Text="{Binding StatusText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="60" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0"/>
            <Expander Header="{x:Static properties:Resources.SpectrumDiscoveryDetails}" Margin="0,5,0,0">
                <TextBox Text="{Binding DiscoveryDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="120" VerticalScrollBarVisibility="Auto"/>
            </Expander>
        </StackPanel>
    </Grid>
</Window>
