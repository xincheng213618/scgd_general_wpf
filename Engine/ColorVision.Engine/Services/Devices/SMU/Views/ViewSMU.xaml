<UserControl x:Class="ColorVision.Engine.Services.Devices.SMU.Views.ViewSMU"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ColorVision.Engine.Services.Devices.SMU.Views"
             xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             Background="{DynamicResource GlobalBackground}" Initialized="UserControl_Initialized">
    <UserControl.Resources>
        <local:SmuReadingConverter x:Key="Reading"/>
        <local:SmuHistoryHeightConverter x:Key="HistoryHeight"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource ButtonDefault}">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="MinHeight" Value="30"/>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="MainGrid" Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition x:Name="DetailRow" Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition x:Name="HistoryRow">
                <RowDefinition.Height><MultiBinding Converter="{StaticResource HistoryHeight}">
                    <Binding ElementName="ScanPanel" Path="Visibility"/><Binding Path="Height"/>
                    <Binding ElementName="HistoryPane" Path="Visibility"/>
                </MultiBinding></RowDefinition.Height>
            </RowDefinition>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="源表测量结果" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock x:Name="SelectionCaption" Text="选择一条记录查看测量详情" Style="{StaticResource MutedText}" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="FollowLatest" Content="跟随最新" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0" Click="FollowLatest_Click"/>
                <Button Content="导出所选" Style="{StaticResource ActionButton}" Click="Export_Click"/>
                <Button Content="视图设置" Style="{StaticResource ActionButton}" Command="{Binding EditCommand}"/>
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" BorderBrush="{DynamicResource GlobalBorderBrush1}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,12">
            <Grid x:Name="MetricBand" Margin="18,16" DataContext="{x:Null}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="实测电压" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Height="46">
                        <TextBlock x:Name="VoltageReading" FontSize="32" FontWeight="SemiBold"
                                   Text="{Binding Voltage, Converter={StaticResource Reading}, ConverterParameter=V, FallbackValue=—}"
                                   ToolTip="{Binding Voltage, StringFormat=G17}"/>
                    </Viewbox>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="18,0,12,0">
                    <TextBlock Text="实测电流" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Height="46">
                        <TextBlock x:Name="CurrentReading" FontSize="32" FontWeight="SemiBold"
                                   Text="{Binding Current, Converter={StaticResource Reading}, ConverterParameter=mA, FallbackValue=—}"
                                   ToolTip="{Binding Current, StringFormat=G17}"/>
                    </Viewbox>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="18,0,12,0" ToolTip="{Binding ResistanceDescription}">
                    <TextBlock Text="电阻 R" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Height="46">
                        <TextBlock x:Name="ResistanceReading" FontSize="32" FontWeight="SemiBold"
                                   Text="{Binding Resistance, Converter={StaticResource Reading}, ConverterParameter=Ω, FallbackValue=—}"
                                   ToolTip="{Binding Resistance, StringFormat=G17}"/>
                    </Viewbox>
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="18,0,12,0">
                    <TextBlock Text="功率 P" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Height="46">
                        <TextBlock x:Name="PowerReading" FontSize="32" FontWeight="SemiBold"
                                   Text="{Binding Power, Converter={StaticResource Reading}, ConverterParameter=W, FallbackValue=—}"
                                   ToolTip="{Binding Power, StringFormat=G17}"/>
                    </Viewbox>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Border x:Name="PointInfo" BorderBrush="{DynamicResource GlobalBorderBrush1}" BorderThickness="0,0,0,1" Padding="2,2,2,14">
                <StackPanel>
                    <TextBlock x:Name="PointExplanation" Text="单点测量直接显示读数；扫描结果显示 I–V 特性。" Style="{StaticResource MutedText}"/>
                    <TextBlock x:Name="SettingsCaption" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            <Grid x:Name="ScanPanel" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="2.3*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*" MinWidth="260"/></Grid.ColumnDefinitions>
                <Border BorderBrush="{DynamicResource GlobalBorderBrush1}" BorderThickness="1" CornerRadius="5">
                    <Grid Margin="10">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <DockPanel Margin="4,0,4,8">
                            <ComboBox x:Name="AxisChoice" DockPanel.Dock="Right" Width="155" SelectedIndex="0" SelectionChanged="AxisChoice_SelectionChanged">
                                <ComboBoxItem Content="横轴：电压 (V)"/><ComboBoxItem Content="横轴：电流 (mA)"/>
                            </ComboBox>
                            <TextBlock x:Name="ChartTitle" Text="I–V 特性" FontWeight="SemiBold" FontSize="15"/>
                        </DockPanel>
                        <ScottPlot:WpfPlot x:Name="wpfplot1" Grid.Row="1" MinHeight="150"/>
                        <TextBlock x:Name="PlotNote" Grid.Row="2" Style="{StaticResource MutedText}" Margin="4,7,0,0" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Border>
                <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="{DynamicResource GlobalBorderBrush1}"/>
                <Border Grid.Column="2" BorderBrush="{DynamicResource GlobalBorderBrush1}" BorderThickness="1" CornerRadius="5">
                    <DockPanel Margin="10">
                        <DockPanel DockPanel.Dock="Top" Margin="2,0,2,8">
                            <TextBlock x:Name="PointPosition" DockPanel.Dock="Right" Style="{StaticResource MutedText}"/>
                            <TextBlock Text="逐点数据" FontSize="15" FontWeight="SemiBold"/>
                        </DockPanel>
                        <ListView x:Name="listView2" BorderThickness="0" Background="{DynamicResource GlobalBackground}" Style="{StaticResource ListView.Small}" SelectionChanged="Point_SelectionChanged">
                            <ListView.View><GridView>
                                <GridViewColumn Header="#" Width="38" DisplayMemberBinding="{Binding Index}"/>
                                <GridViewColumn Header="V" Width="78" DisplayMemberBinding="{Binding Voltage, StringFormat=G6}"/>
                                <GridViewColumn Header="mA" Width="82" DisplayMemberBinding="{Binding Current, StringFormat=G6}"/>
                                <GridViewColumn Header="Ω" Width="82" DisplayMemberBinding="{Binding Resistance, StringFormat=G6, TargetNullValue=—}"/>
                                <GridViewColumn Header="W" Width="90" DisplayMemberBinding="{Binding Power, StringFormat=G6}"/>
                            </GridView></ListView.View>
                        </ListView>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
        <GridSplitter x:Name="HistorySplitter" Grid.Row="3" Height="5" Margin="0,0,0,4" HorizontalAlignment="Stretch"
                      Visibility="Collapsed" Background="{DynamicResource GlobalBorderBrush1}" DragCompleted="HistorySplitter_DragCompleted"/>
        <Border x:Name="HistoryPane" Grid.Row="4" BorderBrush="{DynamicResource GlobalBorderBrush1}" BorderThickness="1" CornerRadius="5"
                Visibility="{Binding IsShowListView, Converter={StaticResource bool2VisibilityConverter}}">
            <DockPanel Margin="10">
                <Grid DockPanel.Dock="Top" Margin="2,0,2,9">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="测量记录" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock x:Name="RecordCount" Text="0 条" Style="{StaticResource MutedText}" Margin="10,0,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <CheckBox x:Name="CompareScans" Content="叠加所选扫描" VerticalAlignment="Center" Margin="0,0,10,0" Click="CompareScans_Click" ToolTip="按 Ctrl 选择多条扫描记录进行比较"/>
                        <Button Content="查询历史" Style="{StaticResource ActionButton}" Click="Search_Click"/>
                        <Button Content="移除所选" Style="{StaticResource ActionButton}" Click="Delete_Click"/>
                        <Button Content="清空列表" Style="{StaticResource ActionButton}" Click="Clear_Click"/>
                    </StackPanel>
                </Grid>
                <Grid>
                    <ListView x:Name="listView1" SelectionMode="Extended" BorderThickness="0" Background="{DynamicResource GlobalBackground}" Style="{StaticResource ListView.Small}"
                              SelectionChanged="Result_SelectionChanged" PreviewKeyDown="Result_PreviewKeyDown">
                        <ListView.Resources><ContextMenu x:Key="ColumnMenu" Opened="ContextMenu_Opened"/></ListView.Resources>
                        <ListView.View><GridView>
                            <GridView.ColumnHeaderContainerStyle>
                                <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource GridViewColumnHeaderBase}">
                                    <Setter Property="Visibility" Value="Visible"/><Setter Property="ContextMenu" Value="{StaticResource ColumnMenu}"/>
                                    <EventSetter Event="Click" Handler="GridViewColumnSort"/>
                                </Style>
                            </GridView.ColumnHeaderContainerStyle>
                            <GridViewColumn Header="时间" Width="153" DisplayMemberBinding="{Binding CreateTime, StringFormat=yyyy-MM-dd HH:mm:ss}"/>
                            <GridViewColumn Header="类型" Width="55" DisplayMemberBinding="{Binding ResultKind}"/>
                            <GridViewColumn Header="通道" Width="48" DisplayMemberBinding="{Binding ChannelType}"/>
                            <GridViewColumn Header="源模式" Width="76" DisplayMemberBinding="{Binding SourceMode}"/>
                            <GridViewColumn Header="电压 (V)" Width="110" DisplayMemberBinding="{Binding LastVoltage, StringFormat=G6, TargetNullValue=—}"/>
                            <GridViewColumn Header="电流 (mA)" Width="110" DisplayMemberBinding="{Binding LastCurrent, StringFormat=G6, TargetNullValue=—}"/>
                            <GridViewColumn Header="电阻 (Ω)" Width="110" DisplayMemberBinding="{Binding LastResistance, StringFormat=G6, TargetNullValue=—}"/>
                            <GridViewColumn Header="功率 (W)" Width="110" DisplayMemberBinding="{Binding LastPower, StringFormat=G6, TargetNullValue=—}"/>
                            <GridViewColumn Header="源值 / 扫描范围" Width="155" DisplayMemberBinding="{Binding SourceDescription}"/>
                            <GridViewColumn Header="用时 (ms)" Width="85" DisplayMemberBinding="{Binding TotalTime, TargetNullValue=—}"/>
                            <GridViewColumn Header="点数" Width="55" DisplayMemberBinding="{Binding PointCount}"/>
                            <GridViewColumn Header="记录 ID" Width="70" DisplayMemberBinding="{Binding Id}"/>
                        </GridView></ListView.View>
                    </ListView>
                    <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock Text="暂无测量结果" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="执行测量后，单点读数或扫描曲线会显示在这里。" Style="{StaticResource MutedText}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
