<Window x:Class="ColorVision.Engine.Services.Devices.CameraBoundDeviceConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:properties="clr-namespace:ColorVision.Engine.Properties"
        Title="{x:Static properties:Resources.ModifyConfiguration}"
        Width="650" MinWidth="580" MinHeight="220" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource GlobalBackground}" SnapsToDevicePixels="True" UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary Source="/ColorVision.Engine;component/Services/PhyCameras/PhyCameraConsoleStyles.xaml"/>
    </Window.Resources>
    <Grid Margin="16,14,16,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border Style="{StaticResource MetricCardStyle}" CornerRadius="8" Padding="16,10" Margin="0,0,4,10" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="{x:Static properties:Resources.DeviceConnection}" Style="{StaticResource SectionTitleStyle}"/>
                    <StackPanel x:Name="ConfigurationFields"/>
                </StackPanel>
            </Border>
        </ScrollViewer>
        <TextBlock Grid.Row="1" x:Name="StatusText" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,4,8" Visibility="Collapsed"/>
        <Border Grid.Row="2" BorderBrush="{DynamicResource GlobalBorderBrush1}" BorderThickness="0,1,0,0" Padding="0,12">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button x:Name="ConfirmButton" Content="{x:Static properties:Resources.OK}" Style="{StaticResource PrimaryToolbarButtonStyle}"
                        MinWidth="90" Height="34" Margin="0" IsDefault="True" Click="Ok_Click"/>
                <Button Content="{x:Static properties:Resources.Cancel}" Style="{StaticResource ToolbarButtonStyle}"
                        MinWidth="90" Height="34" Margin="6,0,0,0" IsCancel="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
