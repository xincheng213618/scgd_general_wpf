<Window x:Class="ColorVision.Engine.Services.Devices.Camera.Local.LocalCalibrationCacheManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:engine="clr-namespace:ColorVision.Engine"
        Title="{engine:EngineLang 本地缓存管理}"
        Width="1100" Height="730" MinWidth="900" MinHeight="680"
        Background="{DynamicResource GlobalBackground}"
        Initialized="Window_Initialized" Closing="Window_Closing" Closed="Window_Closed">
    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/ColorVision.Themes;component/Themes/Controls/Button.xaml"/>
        </ResourceDictionary.MergedDictionaries>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}"/>
        </Style>
        <Style x:Key="CacheActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonDefault}">
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
        </Style>
        <Style x:Key="CacheGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}"/>
            <Setter Property="RowBackground" Value="{DynamicResource ButtonBackground}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="RowHeight" Value="42"/>
            <Setter Property="ColumnHeaderHeight" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{DynamicResource GlobalBackground}"/>
                        <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="Padding" Value="12,0"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
                        <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource CV.Surface.ControlHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource CV.Tag.Background}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="12,0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                        <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CacheCellTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="CacheNumberTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CacheCellTextStyle}">
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="150"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{engine:EngineLang 缓存内存}" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock x:Name="TotalMemoryText" Text="—" FontSize="30" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ModuleCountText" Margin="18,0,0,5" VerticalAlignment="Bottom" Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>
                <TextBlock Text="{engine:EngineLang Key='校正内存为估算值；总量只统计已接入的缓存模块。'}"
                           Margin="0,5,0,0" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                <Grid Width="260" VerticalAlignment="Center">
                    <TextBox x:Name="CacheSearchBox" Height="36" Padding="12,7" TextChanged="CacheSearchBox_TextChanged"
                             AutomationProperties.Name="{engine:EngineLang 搜索缓存模块或文件}"
                             ToolTip="{engine:EngineLang 搜索缓存模块或文件}"/>
                    <TextBlock x:Name="SearchPlaceholderText" Text="{engine:EngineLang 搜索缓存模块或文件…}"
                               Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                </Grid>
                <Button x:Name="RefreshButton" Content="{engine:EngineLang 刷新}" Click="RefreshButton_Click"
                        ToolTip="{engine:EngineLang 重新读取当前进程的缓存清单}" Style="{StaticResource CacheActionButtonStyle}"/>
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Background="{DynamicResource ButtonBackground}" CornerRadius="8" ClipToBounds="True"
                BorderBrush="{DynamicResource ButtonBorderBrush}" BorderThickness="1">
            <Grid>
                <DataGrid x:Name="CacheModulesGrid" Style="{StaticResource CacheGridStyle}" RowHeight="54"
                          SelectionChanged="CacheModulesGrid_SelectionChanged" AutomationProperties.Name="{engine:EngineLang 缓存模块}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="{engine:EngineLang 缓存模块}" Width="*" MinWidth="175" SortMemberPath="Name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" ToolTip="{Binding Description}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{engine:EngineLang 内存占用}" Width="155" SortMemberPath="MemoryBytes" SortDirection="Descending">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Margin="-12,0">
                                        <ProgressBar Value="{Binding MemoryShare, Mode=OneWay}" Maximum="1" Minimum="0" BorderThickness="0"
                                                     Background="Transparent" Foreground="{DynamicResource CV.Accent.Primary}" Opacity="0.16" IsHitTestVisible="False">
                                            <ProgressBar.Template>
                                                <ControlTemplate TargetType="ProgressBar">
                                                    <Grid x:Name="PART_Track">
                                                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left"/>
                                                    </Grid>
                                                </ControlTemplate>
                                            </ProgressBar.Template>
                                        </ProgressBar>
                                        <TextBlock Text="{Binding MemoryText}" Margin="12,0" FontWeight="SemiBold"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{engine:EngineLang 缓存条目}" Binding="{Binding EntryCount, StringFormat=N0}" Width="100"
                                            ElementStyle="{StaticResource CacheNumberTextStyle}"/>
                        <DataGridTextColumn Header="{engine:EngineLang 命中次数}" Binding="{Binding HitCount, StringFormat=N0}" Width="100"
                                            ElementStyle="{StaticResource CacheNumberTextStyle}"/>
                        <DataGridTextColumn Header="{engine:EngineLang 活动引用}" Binding="{Binding ActiveReferences, StringFormat=N0}" Width="100"
                                            ElementStyle="{StaticResource CacheNumberTextStyle}"/>
                        <DataGridTextColumn Header="{engine:EngineLang 使用状态}" Binding="{Binding UsageText}" Width="190"
                                            ElementStyle="{StaticResource CacheCellTextStyle}"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="EmptyModulesText" Visibility="Collapsed" Text="{engine:EngineLang 没有匹配的缓存模块。}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
            </Grid>
        </Border>
        <Grid Grid.Row="2" Margin="0,22,0,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,6">
                <TextBlock x:Name="SelectedModuleTitleText" Text="{engine:EngineLang 模块详情}" FontSize="17" FontWeight="SemiBold"/>
            </Grid>
            <StackPanel Grid.Row="1" Margin="0,0,0,12">
                <TextBlock x:Name="SelectedModuleDescriptionText" Text="{engine:EngineLang 选择模块以查看缓存详情。}"
                           TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                <TextBlock x:Name="SelectedModuleSummaryText" Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"/>
                <TextBlock x:Name="SelectedModuleErrorText" Visibility="Collapsed" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource CV.Status.Error}"/>
                <StackPanel x:Name="ImageCacheOptionsPanel" Visibility="Collapsed" Orientation="Horizontal" Margin="0,12,0,0">
                    <CheckBox x:Name="ImageCacheEnabledCheckBox" Content="{engine:EngineLang 启用 CVRAW 文件缓存}"
                              Click="ImageCacheEnabledCheckBox_Click" VerticalAlignment="Center"
                              ToolTip="{engine:EngineLang Key='默认开启。关闭后直接读写文件，已有读取完成后释放槽位；显示内存复用保持不变。'}"/>
                    <TextBlock Text="{engine:EngineLang 数量上限}" VerticalAlignment="Center" Margin="28,0,12,0"/>
                    <TextBox x:Name="ImageCacheCountTextBox" Width="70" Height="34" Padding="8,6"
                             AutomationProperties.Name="{engine:EngineLang 图像缓存数量上限}"
                             ToolTip="{engine:EngineLang Key='默认保留 1 个完整 CVRAW 图像文件，可调整；减少数量后释放多余缓存，磁盘文件保留。'}"/>
                    <Button x:Name="ApplyImageCacheCountButton" Content="{engine:EngineLang 应用}" Click="ApplyImageCacheCountButton_Click"
                            Padding="14,6" MinHeight="34" Margin="10,0,0,0"/>
                </StackPanel>
            </StackPanel>
            <Border Grid.Row="2" Background="{DynamicResource ButtonBackground}" CornerRadius="8" ClipToBounds="True"
                    BorderBrush="{DynamicResource ButtonBorderBrush}" BorderThickness="1">
                <Grid>
                    <DataGrid x:Name="CacheDetailsGrid" Style="{StaticResource CacheGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{engine:EngineLang 缓存条目}" Binding="{Binding Name}" Width="150"
                                                ElementStyle="{StaticResource CacheCellTextStyle}"/>
                            <DataGridTextColumn Header="{engine:EngineLang 文件路径}" Binding="{Binding FilePath}" Width="*" MinWidth="160">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CacheCellTextStyle}">
                                        <Setter Property="ToolTip" Value="{Binding FilePath}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="{engine:EngineLang 文件大小}" Binding="{Binding FileSizeText}" Width="110" SortMemberPath="FileBytes"
                                                ElementStyle="{StaticResource CacheNumberTextStyle}"/>
                            <DataGridTextColumn Header="{engine:EngineLang 内存占用}" Binding="{Binding MemoryText}" Width="110" SortMemberPath="MemoryBytes"
                                                ElementStyle="{StaticResource CacheNumberTextStyle}"/>
                            <DataGridTextColumn Header="{engine:EngineLang 命中次数}" Binding="{Binding HitCount, StringFormat=N0}" Width="100"
                                                ElementStyle="{StaticResource CacheNumberTextStyle}"/>
                            <DataGridTextColumn Header="{engine:EngineLang 使用状态}" Binding="{Binding UsageText}" Width="175"
                                                ElementStyle="{StaticResource CacheCellTextStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="EmptyDetailsText" Text="{engine:EngineLang 当前模块没有缓存文件。}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="{engine:EngineLang 尚未读取缓存状态。}" VerticalAlignment="Center"
                       Margin="0,0,16,0" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="ReleaseSelectedButton" Content="{engine:EngineLang 释放选中}" IsEnabled="False"
                        Click="ReleaseSelectedButton_Click" Style="{StaticResource CacheActionButtonStyle}"/>
                <Button x:Name="ReleaseAllButton" Content="{engine:EngineLang 释放全部}" Click="ReleaseAllButton_Click"
                        Style="{StaticResource CacheActionButtonStyle}"/>
            </StackPanel>
        </Grid>
        <Border x:Name="LoadingOverlay" Grid.RowSpan="3" Visibility="Collapsed" Background="{DynamicResource GlobalBackground}" Opacity="0.92">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Width="220" Height="5" IsIndeterminate="True"/>
                <TextBlock x:Name="LoadingText" Margin="0,12,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
