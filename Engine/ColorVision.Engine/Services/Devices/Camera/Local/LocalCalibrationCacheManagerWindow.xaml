<Window x:Class="ColorVision.Engine.Services.Devices.Camera.Local.LocalCalibrationCacheManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:engine="clr-namespace:ColorVision.Engine"
        Title="{engine:EngineLang 本地校正缓存管理}"
        Width="1160"
        Height="680"
        MinWidth="900"
        MinHeight="520"
        Background="{DynamicResource GlobalBackground}"
        Initialized="Window_Initialized"
        Closing="Window_Closing"
        Closed="Window_Closed">
    <Window.Resources>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}"/>
        </Style>
        <Style x:Key="CacheActionButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Padding="14,11"
                Background="{DynamicResource ButtonBackground}"
                BorderBrush="{DynamicResource ButtonBorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{engine:EngineLang 本地校正缓存管理}"
                               FontSize="21"
                               FontWeight="SemiBold"/>
                    <TextBlock Margin="0,3,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="{engine:EngineLang Key='查看 opencv_helper 在当前进程中复用的单校正文件缓存。'}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="RefreshButton"
                            Content="{engine:EngineLang 刷新}"
                            ToolTip="{engine:EngineLang 重新读取当前进程的缓存清单}"
                            Click="RefreshButton_Click"
                            Style="{StaticResource CacheActionButtonStyle}"/>
                    <Button x:Name="ReleaseAllButton"
                            Content="{engine:EngineLang 释放全部}"
                            ToolTip="{engine:EngineLang Key='等待正在执行的校正结束，然后释放所有相机上下文与可释放的共享文件缓存'}"
                            Click="ReleaseAllButton_Click"
                            Background="Firebrick"
                            Foreground="White"
                            Style="{StaticResource CacheActionButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="14,12,14,10"
                Padding="12,9"
                Background="{DynamicResource ButtonBackground}"
                BorderBrush="{DynamicResource ButtonBorderBrush}"
                BorderThickness="1"
                CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="EntryCountText" FontWeight="SemiBold" Text="{engine:EngineLang Key='缓存文件：--'}"/>
                <TextBlock Grid.Column="1" Margin="22,0,0,0" FontWeight="SemiBold" Text="{engine:EngineLang Key='驻留内存：--'}" x:Name="ResidentMemoryText"/>
                <TextBlock Grid.Column="2" Margin="22,0,0,0" Text="{engine:EngineLang Key='缓存预算：--'}" x:Name="BudgetText"/>
                <TextBlock Grid.Column="3" Margin="22,0,0,0" Text="{engine:EngineLang Key='命中：--'}" x:Name="HitSummaryText"/>
                <TextBlock Grid.Column="4"
                           Margin="22,0,0,0"
                           HorizontalAlignment="Right"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="{engine:EngineLang Key='内存为 native 估算的缓存驻留量'}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="14,0">
            <DataGrid x:Name="CacheDataGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      Background="Transparent"
                      BorderBrush="{DynamicResource ButtonBorderBrush}"
                      BorderThickness="1"
                      RowHeaderWidth="0"
                      EnableRowVirtualization="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{engine:EngineLang 校正类型}" Binding="{Binding CalibrationTypeText}" Width="125"/>
                    <DataGridTextColumn Header="{engine:EngineLang 文件路径}" Binding="{Binding FilePath}" Width="*"/>
                    <DataGridTextColumn Header="{engine:EngineLang 驻留内存}" Binding="{Binding ResidentMemoryText}" Width="115"/>
                    <DataGridTextColumn Header="{engine:EngineLang 命中次数}" Binding="{Binding HitCount}" Width="90"/>
                    <DataGridTextColumn Header="{engine:EngineLang 使用状态}" Binding="{Binding UsageText}" Width="180"/>
                </DataGrid.Columns>
            </DataGrid>

            <Border x:Name="LoadingOverlay"
                    Visibility="Collapsed"
                    Background="#66FFFFFF">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar Width="220" Height="5" IsIndeterminate="True"/>
                    <TextBlock x:Name="LoadingText"
                               Margin="0,12,0,0"
                               HorizontalAlignment="Center"
                               Text="{engine:EngineLang 正在读取缓存状态…}"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3"
                Margin="14,8,14,12"
                Padding="2,4">
            <TextBlock x:Name="StatusText"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Text="{engine:EngineLang 尚未读取缓存状态。}"
                       TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
