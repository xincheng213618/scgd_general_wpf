<UserControl x:Class="ColorVision.Engine.Services.Devices.Camera.Views.CameraFocusChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:engine="clr-namespace:ColorVision.Engine">
    <Grid>
        <Button x:Name="ShowChartButton" Visibility="Collapsed" Padding="8,3" Click="ShowChart_Click"
                Content="{engine:EngineLang CameraFocusChart_Show}"/>
        <Border x:Name="ChartPanel" Visibility="Collapsed" Padding="8" CornerRadius="6"
                Background="{DynamicResource GlobalBackground}" BorderBrush="{DynamicResource GlobalBorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,4">
                    <Button x:Name="HideChartButton" DockPanel.Dock="Right" Content="×" Width="24" Height="24" Padding="0" Click="CloseChart_Click"
                            ToolTip="{engine:EngineLang CameraFocusChart_Hide}"
                            AutomationProperties.Name="{engine:EngineLang CameraFocusChart_Hide}"/>
                    <TextBlock x:Name="ChartTitle" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                               Foreground="{DynamicResource GlobalTextBrush}"/>
                </DockPanel>
                <ContentControl x:Name="PlotHost" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                <TextBlock x:Name="ChartReadout" Grid.Row="2" Margin="0,4,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource GlobalTextBrush}"/>
                <TextBlock x:Name="ChartDetailReadout" Grid.Row="3" Margin="0,4,0,0" TextWrapping="Wrap"
                           Visibility="Collapsed" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                           Foreground="{DynamicResource GlobalTextBrush}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
