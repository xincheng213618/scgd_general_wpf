<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:displayUi="clr-namespace:ColorVision.UI;assembly=ColorVision.UI"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:local="clr-namespace:ColorVision.Engine.Services.Devices.Camera"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:properties="clr-namespace:ColorVision.Engine.Properties"
             xmlns:engine="clr-namespace:ColorVision.Engine"
             xmlns:winf="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"
             x:Class="ColorVision.Engine.Services.Devices.Camera.Controls.CameraCaptureControl" MinWidth="240" mc:Ignorable="d">
    <StackPanel>
        <StackPanel>
            <StackPanel x:Name="SingleExposure">
                <DockPanel Margin="0,0,0,2">
                    <TextBlock MinWidth="50" Margin="0,0,5,0" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{x:Static properties:Resources.Exposure}"/>
                    <TextBox Width="62" DockPanel.Dock="Right" Text="{Binding DisplayConfig.ExpTime, StringFormat=F2}"/>
                    <hc:PreviewSlider IsSnapToTickEnabled="True" LargeChange="0.01" Maximum="{Binding Config.ExpTimeMaxLog}" Minimum="{Binding Config.ExpTimeMinLog}" SmallChange="0.001" TickFrequency="0.001" Value="{Binding DisplayConfig.ExpTimeLog}"/>
                </DockPanel>
            </StackPanel>
            <StackPanel x:Name="RgbExposure">
                <DockPanel Margin="0,0,0,2">
                    <TextBlock MinWidth="60" Margin="0,0,5,0" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{x:Static properties:Resources.ExposureR}"/>
                    <TextBox Width="62" DockPanel.Dock="Right" Text="{Binding DisplayConfig.ExpTimeR, StringFormat=F2}"/>
                    <hc:PreviewSlider IsSnapToTickEnabled="True" LargeChange="0.01" Maximum="{Binding Config.ExpTimeMaxLog}" Minimum="{Binding Config.ExpTimeMinLog}" SmallChange="0.001" TickFrequency="0.001" Value="{Binding DisplayConfig.ExpTimeRLog}"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,2">
                    <TextBlock MinWidth="60" Margin="0,0,5,0" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{x:Static properties:Resources.ExposureG}"/>
                    <TextBox Width="62" DockPanel.Dock="Right" Text="{Binding DisplayConfig.ExpTimeG, StringFormat=F2}"/>
                    <hc:PreviewSlider IsSnapToTickEnabled="True" LargeChange="0.01" Maximum="{Binding Config.ExpTimeMaxLog}" Minimum="{Binding Config.ExpTimeMinLog}" SmallChange="0.001" TickFrequency="0.001" Value="{Binding DisplayConfig.ExpTimeGLog}"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,2">
                    <TextBlock MinWidth="60" Margin="0,0,5,0" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{x:Static properties:Resources.ExposureB}"/>
                    <TextBox Width="62" DockPanel.Dock="Right" Text="{Binding DisplayConfig.ExpTimeB, StringFormat=F2}"/>
                    <hc:PreviewSlider IsSnapToTickEnabled="True" LargeChange="0.001" Maximum="{Binding Config.ExpTimeMaxLog}" Minimum="{Binding Config.ExpTimeMinLog}" SmallChange="0.001" TickFrequency="0.001" Value="{Binding DisplayConfig.ExpTimeBLog}"/>
                </DockPanel>
            </StackPanel>
        </StackPanel>
        <DockPanel Margin="0,0,0,2">
            <DockPanel x:Name="GainPanel" DockPanel.Dock="Left" Margin="0,0,5,0" ToolTipService.ShowOnDisabled="True">
                <TextBlock Text="{x:Static properties:Resources.Gain}" Margin="0,0,3,0"/>
                <TextBox Width="46" Text="{Binding DisplayConfig.Gain, StringFormat=F2}"/>
            </DockPanel>
            <DockPanel x:Name="AveragePanel" DockPanel.Dock="Left" Margin="0,0,5,0">
                <TextBlock Text="{engine:EngineLang CameraPanel_Averages}" Margin="0,0,3,0"/>
                <TextBox Width="32" Text="{Binding DisplayConfig.AvgCount}"/>
            </DockPanel>
            <DockPanel>
                <TextBlock Text="{x:Static properties:Resources.Flip}" Margin="0,0,3,0"/>
                <ComboBox x:Name="CBFilp" MinWidth="60" DisplayMemberPath="Key" SelectedValue="{Binding DisplayConfig.FlipMode}" SelectedValuePath="Value" Style="{StaticResource ComboBox.Small}"/>
            </DockPanel>
        </DockPanel>
        <StackPanel x:Name="CaptureOnlyPanel">
            <DockPanel Margin="0,0,0,2">
                <Button Content="{x:Static properties:Resources.AutoExposure}" Padding="3,1" x:Name="AutoExposureButton" DockPanel.Dock="Right"/>
                <DockPanel x:Name="AutoExposureTemplatePanel">
                    <Button Width="24" Height="24" Margin="4,0,0,0" Padding="2" ToolTip="{x:Static properties:Resources.Property}" DockPanel.Dock="Right" x:Name="EditExposureButton">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="" FontSize="14" HorizontalAlignment="Center"/>
                    </Button>
                    <ComboBox d:DataContext="{d:DesignInstance local:DisplayCameraConfig}" x:Name="ComboxAutoExpTimeParamTemplate" ToolTip="{Binding SelectedItem.DisplayName, RelativeSource={RelativeSource Self}}" DisplayMemberPath="DisplayName" SelectedIndex="{Binding ExpTimeParamTemplateIndex}" SelectedValuePath="Value" Style="{StaticResource ComboBox.Small}"/>
                </DockPanel>
            </DockPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="62"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,2" ToolTip="{engine:EngineLang 拍照前自动曝光模板}" x:Name="CaptureAutoExposureTemplatePanel">
                    <Button Width="24" Height="24" Margin="4,0,0,0" Padding="2" ToolTip="{x:Static properties:Resources.Property}" DockPanel.Dock="Right" x:Name="EditCaptureExposureButton">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="" FontSize="14" HorizontalAlignment="Center"/>
                    </Button>
                    <ComboBox d:DataContext="{d:DesignInstance local:DisplayCameraConfig}" x:Name="ComboxAutoExpTimeParamTemplate1" DisplayMemberPath="DisplayName" SelectedIndex="{Binding ExpTimeParamTemplate1Index, FallbackValue=0}" SelectedValuePath="Value" Style="{StaticResource ComboBox.Small}"/>
                </DockPanel>
                <DockPanel Grid.Row="1" Margin="0,0,0,2">
                    <Button Width="24" Height="24" Margin="4,0,0,0" Padding="2" ToolTip="{x:Static properties:Resources.Property}" DockPanel.Dock="Right" x:Name="EditCalibrationButton">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="" FontSize="14" HorizontalAlignment="Center"/>
                    </Button>
                    <ComboBox d:DataContext="{d:DesignInstance local:DisplayCameraConfig}" x:Name="ComboxCalibrationTemplate" ToolTip="{Binding GainSourceHint}" SelectedIndex="{Binding CalibrationTemplateIndex, FallbackValue=0}" SelectedValuePath="Value" Style="{StaticResource ComboBox.Small}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                            <Setter Property="Text" Value="{Binding Key}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Value.Id}" Value="-1">
                                                    <Setter Property="Text" Value="{engine:EngineLang CameraPanel_NoCalibrationTemplate}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </DockPanel>
                <Button Grid.Column="1" Grid.RowSpan="2" x:Name="TakePhotoButton" Content="{x:Static properties:Resources.Capture}" FontSize="15" FontWeight="Bold" MinHeight="48" Padding="4,2" Margin="4,0,0,2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            </Grid>
            <CheckBox Content="{engine:EngineLang CameraPanel_AutoExposureND}" IsChecked="{Binding Config.IsAutoExpWithND}" Margin="0,0,0,2" ToolTip="{engine:EngineLang CameraPanel_NDHint}" x:Name="AutoExposureND"/>
            <StackPanel Visibility="{Binding ServiceControlsEnabled, Converter={StaticResource bool2VisibilityConverter}}">
                <DockPanel Margin="0,2" IsEnabled="{Binding ServiceControlsEnabled}" Visibility="{Binding Config.CFW.IsNDPort, Converter={StaticResource bool2VisibilityConverter}}">
                    <Button Content="{x:Static properties:Resources.FilterWheelReadPosition}" DockPanel.Dock="Right" x:Name="ReadFilterButton"/>
                    <Button Content="{x:Static properties:Resources.ChangeNDPort}" DockPanel.Dock="Right" x:Name="ChangeFilterButton"/>
                    <TextBlock Text="{x:Static properties:Resources.NDFilterPosition}"/>
                    <TextBox Margin="5,0" BorderThickness="0,0,0,1" Text="{Binding Config.NDPort}"/>
                </DockPanel>
            </StackPanel>
            <StackPanel>
                <StackPanel x:Name="MotorPanel" Visibility="{Binding Config.MotorConfig.IsUseMotor, Converter={StaticResource bool2VisibilityConverter}}">
                    <StackPanel Margin="0,5,0,0">
                        <DockPanel>
                            <Button Content="{x:Static properties:Resources.AutoFocus}" Padding="5,1" DockPanel.Dock="Right" x:Name="AutoFocusButton"/>
                            <Button x:Name="FineFocusButton" DockPanel.Dock="Right" Margin="0,0,3,0" Padding="5,1" Visibility="Collapsed"
                                    Content="{engine:EngineLang CameraPanel_FineFocus}" ToolTip="{engine:EngineLang CameraPanel_FineFocusHint}"/>
                            <Grid Width="20" Margin="5,0" HorizontalAlignment="Left" DockPanel.Dock="Right">
                                <TextBlock HorizontalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource GlobalTextBrush}" RenderTransformOrigin="0.5,0.5" Text="">
                                    <TextBlock.RenderTransform>
                                        <RotateTransform x:Name="rotateTransform10"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                                <Button Width="20" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" x:Name="EditFocusButton">
                                    <Button.Triggers>
                                        <EventTrigger RoutedEvent="Button.Click">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation FillBehavior="Stop" Storyboard.TargetName="rotateTransform10" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:0.5"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Button.Triggers>
                                </Button>
                            </Grid>
                            <ComboBox d:DataContext="{d:DesignInstance local:DisplayCameraConfig}" x:Name="ComboxAutoFocus" DisplayMemberPath="Key" SelectedIndex="{Binding AutoFocusTemplateIndex}" SelectedValuePath="Value" Style="{StaticResource ComboBox.Small}"/>
                        </DockPanel>
                        <DockPanel Margin="0,1,0,0">
                            <Button Content="{x:Static properties:Resources.Move}" Padding="5,1" DockPanel.Dock="Right" x:Name="MoveButton"/>
                            <CheckBox x:Name="CheckBoxIsAbs" Content="{x:Static properties:Resources.AbsolutePosition}"/>
                            <TextBox x:Name="TextPos" Margin="4,0" BorderThickness="0,0,0,1" Text="0"/>
                        </DockPanel>
                        <Grid Margin="0,1,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="JogLeftButton" Height="24" Padding="0" Content="←"
                                    ToolTip="{engine:EngineLang CameraPanel_MotorJogLeft}"
                                    AutomationProperties.Name="{engine:EngineLang CameraPanel_MotorJogLeft}"/>
                            <DockPanel Grid.Column="1" Margin="3,0">
                                <TextBlock Margin="0,0,3,0" Text="{engine:EngineLang CameraPanel_MotorJogStep}"/>
                                <TextBox x:Name="JogStepBox" Padding="2,0" TextAlignment="Center" Text="100"
                                         ToolTip="{engine:EngineLang CameraPanel_MotorJogStepHint}"
                                         AutomationProperties.Name="{engine:EngineLang CameraPanel_MotorJogStep}"/>
                            </DockPanel>
                            <Button Grid.Column="2" x:Name="JogRightButton" Height="24" Padding="0" Content="→"
                                    ToolTip="{engine:EngineLang CameraPanel_MotorJogRight}"
                                    AutomationProperties.Name="{engine:EngineLang CameraPanel_MotorJogRight}"/>
                            <DockPanel Grid.Column="3" Margin="6,0,0,0">
                                <Button x:Name="ApertureButton" Width="30" Padding="2,1" DockPanel.Dock="Right"
                                        Content="{engine:EngineLang CameraPanel_MotorSetAperture}"
                                        ToolTip="{x:Static properties:Resources.AdjustAperture}"
                                        AutomationProperties.Name="{x:Static properties:Resources.AdjustAperture}"/>
                                <TextBlock Text="{engine:EngineLang CameraPanel_MotorAperture}"
                                           ToolTip="{x:Static properties:Resources.ApertureF}"/>
                                <TextBox x:Name="TextDiaphragm" Width="37" Margin="3,0" Padding="2,0" BorderThickness="0,0,0,1" Text="0"
                                         AutomationProperties.Name="{x:Static properties:Resources.ApertureF}"/>
                            </DockPanel>
                        </Grid>
                        <DockPanel Margin="0,1,0,0">
                            <Button x:Name="HomeButton" DockPanel.Dock="Right" Padding="5,1"
                                    Content="{engine:EngineLang CameraPanel_MotorHome}"
                                    ToolTip="{x:Static properties:Resources.HomePosition}"
                                    AutomationProperties.Name="{x:Static properties:Resources.HomePosition}"/>
                            <Button x:Name="ReadPositionButton" DockPanel.Dock="Right" Padding="5,1" Margin="0,0,3,0"
                                    Content="{engine:EngineLang CameraPanel_MotorReadPosition}"
                                    ToolTip="{x:Static properties:Resources.AcquirePosition}"
                                    AutomationProperties.Name="{x:Static properties:Resources.AcquirePosition}"/>
                            <TextBlock Text="{engine:EngineLang CameraPanel_MotorPosition}"/>
                            <TextBox Margin="4,0" Background="Transparent" BorderThickness="0" IsReadOnly="True"
                                     Text="{Binding Config.MotorConfig.Position, Mode=OneWay}"
                                     AutomationProperties.Name="{x:Static properties:Resources.CurrentPosition}"/>
                        </DockPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
