<Window x:Class="ColorVision.Engine.Services.Devices.Camera.Diagnostics.HikCaptureTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:engine="clr-namespace:ColorVision.Engine"
        Title="{engine:EngineLang HikTest_Title}" Width="1240" Height="780" MinWidth="940" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource GlobalBackground}"
        Closing="Window_Closing" Closed="Window_Closed">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource ButtonDefault}">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock FontSize="22" FontWeight="SemiBold" Text="{engine:EngineLang HikTest_Title}" />
            <TextBlock Margin="0,6,0,14" Text="{engine:EngineLang HikTest_Description}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
        </StackPanel>
        <Border Grid.Row="1" Padding="14" Background="{DynamicResource SecondaryRegionBrush}" CornerRadius="6">
            <StackPanel x:Name="SettingsPanel">
                <DockPanel Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Margin="10,0,0,0" Padding="16,5" Content="{engine:EngineLang HikTest_Refresh}" Click="Refresh_Click" />
                    <TextBlock Width="100" Text="{engine:EngineLang HikTest_Camera}" />
                    <ComboBox x:Name="CameraBox" IsEditable="True" MinWidth="320" />
                </DockPanel>
                <WrapPanel>
                    <StackPanel Width="165" Margin="0,0,16,0">
                        <TextBlock Text="{engine:EngineLang HikTest_Exposure}" Margin="0,0,0,4" />
                        <TextBox x:Name="ExposureBox" />
                    </StackPanel>
                    <StackPanel Width="145" Margin="0,0,16,0">
                        <TextBlock Text="{engine:EngineLang HikTest_Gain}" Margin="0,0,0,4" />
                        <TextBox x:Name="GainBox" />
                    </StackPanel>
                    <StackPanel Width="210">
                        <TextBlock Text="{engine:EngineLang HikTest_Quality}" Margin="0,0,0,4" />
                        <ComboBox x:Name="QualityBox" SelectedIndex="3">
                            <ComboBoxItem Content="{engine:EngineLang HikTest_Fast}" />
                            <ComboBoxItem Content="{engine:EngineLang HikTest_Balanced}" />
                            <ComboBoxItem Content="{engine:EngineLang HikTest_Optimal}" />
                            <ComboBoxItem Content="{engine:EngineLang HikTest_OptimalPlus}" />
                        </ComboBox>
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="2" Margin="0,12">
            <WrapPanel>
                <Button x:Name="RunButton" Style="{StaticResource ActionButton}" Content="{engine:EngineLang HikTest_Run}" Click="Run_Click" />
                <Button x:Name="CaptureButton" Style="{StaticResource ActionButton}" Content="{engine:EngineLang HikTest_Capture}" Click="Capture_Click" IsEnabled="False" />
                <Button x:Name="SaveRawButton" Style="{StaticResource ActionButton}" Content="{engine:EngineLang HikTest_SaveRaw}" ToolTip="{engine:EngineLang HikTest_SaveRawTip}" Click="SaveRaw_Click" IsEnabled="False" />
                <Button x:Name="StopButton" Style="{StaticResource ActionButton}" Content="{engine:EngineLang HikTest_Stop}" Click="Stop_Click" IsEnabled="False" />
                <Button x:Name="CopyButton" Style="{StaticResource ActionButton}" Content="{engine:EngineLang HikTest_Copy}" Click="Copy_Click" />
            </WrapPanel>
            <TextBlock x:Name="StatusText" Margin="0,8,0,0" Text="{engine:EngineLang HikTest_Ready}" TextWrapping="Wrap" />
            <TextBlock x:Name="SummaryText" Margin="0,10,0,0" FontWeight="SemiBold" TextWrapping="Wrap" />
        </StackPanel>
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" />
                <RowDefinition Height="6" />
                <RowDefinition Height="2*" />
            </Grid.RowDefinitions>
            <DataGrid x:Name="SamplesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" EnableRowVirtualization="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{engine:EngineLang HikTest_RunNumber}" Binding="{Binding Run}" Width="50" />
                    <DataGridTextColumn Header="{engine:EngineLang HikTest_Index}" Binding="{Binding Index}" Width="65" />
                    <DataGridTextColumn Header="{engine:EngineLang HikTest_Cycle}" Binding="{Binding CycleMs, StringFormat=F3}" Width="110" />
                    <DataGridTextColumn Header="{engine:EngineLang HikTest_Total}" Binding="{Binding CaptureMs, StringFormat=F3}" Width="115" />
                    <DataGridTextColumn Header="{engine:EngineLang HikTest_Wait}" Binding="{Binding WaitMs, StringFormat=F3}" Width="135" />
                    <DataGridTextColumn Header="{engine:EngineLang HikTest_Convert}" Binding="{Binding ConvertMs, StringFormat=F3}" Width="105" />
                    <DataGridTextColumn Header="{engine:EngineLang HikTest_Setup}" Binding="{Binding SetupMs, StringFormat=F3}" Width="125" />
                    <DataGridTextColumn Header="{engine:EngineLang HikTest_Cpu}" Binding="{Binding ThreadCpuMs, StringFormat=F3}" Width="180" />
                    <DataGridTextColumn Header="Frame ID" Binding="{Binding FrameId}" Width="85" />
                    <DataGridTextColumn Header="{engine:EngineLang HikTest_Width}" Binding="{Binding Width}" Width="65" />
                    <DataGridTextColumn Header="{engine:EngineLang HikTest_Height}" Binding="{Binding Height}" Width="65" />
                </DataGrid.Columns>
            </DataGrid>
            <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" />
            <TextBox x:Name="DetailsBox" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" FontFamily="Consolas" FontSize="12" />
        </Grid>
        <TextBlock Grid.Row="4" Margin="0,12,0,0" Text="{engine:EngineLang HikTest_Footnote}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
    </Grid>
</Window>
