<UserControl x:Class="ColorVision.Engine.Services.Devices.Spectrum.Views.ViewSpectrum"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local ="clr-namespace:ColorVision.Engine.Services.Devices.Spectrum.Views"
             xmlns:vm ="clr-namespace:ColorVision.Common.MVVM;assembly=ColorVision.Common"

             xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:properties ="clr-namespace:ColorVision.Engine.Properties"
             xmlns:display="clr-namespace:ColorVision.Engine"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:ViewSpectrum}"
             d:DesignHeight="450" d:DesignWidth="800" Background="{DynamicResource BorderBrush}"  Initialized="UserControl_Initialized">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="SpectrumDataVisibility"/>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ToolTip" Value="{ Binding Text,RelativeSource={RelativeSource Self}}"/>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="MainGrid">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="ListRow1" Height="*"/>
                <RowDefinition x:Name="ListRow2" Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid>
                <ScottPlot:WpfPlot x:Name="wpfplot1" Panel.ZIndex="9"/>
                <ScottPlot:WpfPlot x:Name="wpfplot2" Panel.ZIndex="9" Visibility="Collapsed"/>
            </Grid>
            <Grid x:Name="Grid1" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="3,2" Orientation="Horizontal" VerticalAlignment="Center">
                        <ToggleButton x:Name="ToggleSpectrumResults" Style="{StaticResource PanelToggleButtonStyle}" IsChecked="{Binding Config.IsShowListView, Mode=TwoWay}" ToolTip="{display:EngineLang Key=显示或隐藏测量列表}">
                            <Path Style="{StaticResource PanelIconPathStyle}" Data="M4,4.5 H14 C14.55,4.5 15,4.95 15,5.5 V12.5 C15,13.05 14.55,13.5 14,13.5 H4 C3.45,13.5 3,13.05 3,12.5 V5.5 C3,4.95 3.45,4.5 4,4.5 Z M4,10.3 H14"/>
                        </ToggleButton>
                        <ToggleButton x:Name="ToggleSpectrumComparison" ToolTip="{display:EngineLang Key=多曲线比较}" Click="Button1_Click"  IsChecked="False" Margin="2,0,0,0" >
                            <Image  Stretch="Uniform" Source="{DynamicResource DrawingImageSwitch}" />
                        </ToggleButton>
                        <ToggleButton x:Name="ToggleSpectrumType" Click="ToggleSpectrumType_Click" Margin="2,0,0,0" ToolTip="{x:Static properties:Resources.ToggleSpectrum}">
                            <TextBlock Text="{x:Static properties:Resources.Relative}" x:Name="SpectrumTypeText"/>
                        </ToggleButton>

                        <Button x:Name="AnalyzeSpectrumButton" Click="AnalyzeSpectrum_Click" Content="{display:EngineLang Key=分析}" ToolTip="{display:EngineLang Key=分析选中的光谱}" Padding="8,2" Margin="4,0,0,0">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource ButtonDefault.Small}"><Style.Triggers><DataTrigger Binding="{Binding SelectedItem, ElementName=listView1}" Value="{x:Null}"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Button.Style>
                        </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource PanelIconButtonStyle}" ToolTip="{x:Static properties:Resources.Inquire}" Click="Inquire_Click">
                        <Path Style="{StaticResource PanelActionIconPathStyle}" Data="M7.2,3.2 A4,4 0 1 1 7.2,11.2 A4,4 0 1 1 7.2,3.2 M10.2,10.2 L14.2,14.2"/>
                    </Button>
                    <Button x:Name="Search" Style="{StaticResource PanelIconButtonStyle}" ToolTip="{x:Static properties:Resources.AdvanceSearch}" Click="SearchAdvanced_Click">
                        <Path Style="{StaticResource PanelActionIconPathStyle}" Data="M3,4.5 H15 L10.5,9 V13 L7.5,14 V9 Z"/>
                    </Button>
                    <Button Click="OpenSpectrumExportMenu_Click" Padding="2" Height="25" Width="25" Margin="0,1,5,0" ToolTip="{display:EngineLang Key=导出}">
<Button.ContextMenu><ContextMenu><MenuItem Header="{display:EngineLang Key=导出测量结果 CSV}" Click="Button_Click"/><MenuItem Header="{display:EngineLang Key=导出完整原始光谱 CSV}" Click="ExportRawSpectrum_Click" ToolTip="{display:EngineLang Key=保留全部采样点和负值，可能包含采集时的平滑处理}"/></ContextMenu></Button.ContextMenu>
                        <Rectangle Width="16" Height="16" Fill="{DynamicResource DISave}" />
                    </Button>
                    <Button  Click="Button2_Click" Padding="2" Height="25" Width="25" Margin="0,1,5,0" >
                        <Button.Triggers>
                            <EventTrigger RoutedEvent="Button.Click">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation  Storyboard.TargetName="ScaleTransform" Storyboard.TargetProperty="ScaleX" To="0.7" Duration="0:0:0.1" AutoReverse="True" />
                                        <DoubleAnimation  Storyboard.TargetName="ScaleTransform" Storyboard.TargetProperty="ScaleY" To="0.7" Duration="0:0:0.1" AutoReverse="True" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Button.Triggers>
                        <Image  Stretch="Uniform" Source="{DynamicResource DrawingImageDelete}" RenderTransformOrigin="0.5,0.5">
                            <Image.RenderTransform>
                                <ScaleTransform x:Name="ScaleTransform" ScaleX="1" ScaleY="1" />
                            </Image.RenderTransform>
                        </Image>
                    </Button>
                    <Button Grid.Column="0" Margin="0,1,5,0" Command="{Binding Config.EditCommand}" Padding="2" Height="25" Width="25" >
                        <Button.Triggers>
                            <EventTrigger RoutedEvent="Button.Click">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="rotateTransform2" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:0.5" FillBehavior="Stop"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Button.Triggers>
                        <TextBlock Text="&#xE713;"  HorizontalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource GlobalTextBrush}">
                            <TextBlock.RenderTransform>
                                <RotateTransform x:Name="rotateTransform2" CenterX="8" CenterY="8"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Button>

                </StackPanel>


                <ListView Height="{Binding Config.Height}" Visibility="{Binding Config.IsShowListView, Converter={StaticResource SpectrumDataVisibility}}" Grid.Row="1" Padding="0,5,5,0"  BorderThickness="0"  x:Name="listView1"  SelectionChanged="listView1_SelectionChanged" Style="{StaticResource ListView.Small}"  PreviewKeyDown="listView1_PreviewKeyDown" >
                    <ListView.Resources>
                        <ContextMenu x:Key="ItemContextMenu" Opened="ContextMenu_Opened"/>
                    </ListView.Resources>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="{x:Type ListViewItem}" BasedOn="{StaticResource ListViewItemBaseStyle.Small}">
                            <Setter Property="ContextMenu"><Setter.Value><ContextMenu/></Setter.Value></Setter>
                            <EventSetter Event="ContextMenuOpening" Handler="SpectrumResult_ContextMenuOpening"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View >
                        <GridView >
                            <GridView.ColumnHeaderContainerStyle>
                                <Style TargetType="{x:Type GridViewColumnHeader}" BasedOn="{StaticResource  GridViewColumnHeaderBase}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="ContextMenu" Value="{StaticResource ItemContextMenu}" />
                                    <EventSetter Event="Click" Handler="GridViewColumnSort"/>
                                </Style>
                            </GridView.ColumnHeaderContainerStyle>
                            <GridViewColumn   Header="{x:Static properties:Resources.SerialNumber1}" >
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate  DataType="{x:Type local:ViewResultSpectrum}">
                                        <TextBlock Text="{Binding Id}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn  Header="{x:Static properties:Resources.CreateTime}">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate  DataType="{x:Type local:ViewResultSpectrum}">
                                        <TextBlock Text="{ Binding  CreateTime,StringFormat=yyyy/MM/dd/HH:mm:ss}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn  Header="IntTime">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate  DataType="{x:Type local:ViewResultSpectrum}">
                                        <TextBlock Text="{Binding IntTime}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn  Header="IP" >
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate  DataType="{x:Type local:ViewResultSpectrum}">
                                        <TextBlock Text="{Binding IP}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="EqeColumn" Header="EQE(%)">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type local:ViewResultSpectrum}">
                                        <TextBlock Text="{Binding EqePercent, StringFormat={}{0:F4}}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="LuminousFluxColumn" Header="{x:Static properties:Resources.LuminousFlux}">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type local:ViewResultSpectrum}">
                                        <TextBlock Text="{Binding LuminousFlux, StringFormat={}{0:F4}}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="RadiantFluxColumn" Header="{x:Static properties:Resources.RadiantFlux}" >
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type local:ViewResultSpectrum}">
                                        <TextBlock Text="{Binding RadiantFlux, StringFormat={}{0:F6}}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="LuminousEfficacyColumn" Header="{x:Static properties:Resources.LuminousEfficacy}">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type local:ViewResultSpectrum}">
                                        <TextBlock Text="{Binding LuminousEfficacy, StringFormat={}{0:F4}}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="LvColumn" Header="{x:Static properties:Resources.Lv}">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate  DataType="{x:Type local:ViewResultSpectrum}">
                                        <TextBlock Text="{ Binding Lv}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn  Header="{x:Static properties:Resources.Blue}" >
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate  DataType="{x:Type local:ViewResultSpectrum}">
                                        <TextBlock Text="{ Binding Blue}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn  Header="{x:Static properties:Resources.fx}" >
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate  DataType="{x:Type local:ViewResultSpectrum}">
                                        <TextBlock Text="{ Binding fx}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn  Header="{x:Static properties:Resources.fy}" >
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate  DataType="{x:Type local:ViewResultSpectrum}">
                                        <TextBlock Text="{ Binding fy}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn  Header="{x:Static properties:Resources.fu}" >
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate  DataType="{x:Type local:ViewResultSpectrum}">
                                        <TextBlock Text="{ Binding fu}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn  Header="{x:Static properties:Resources.fv}" >
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate  DataType="{x:Type local:ViewResultSpectrum}">
                                        <TextBlock Text="{ Binding fv}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="Duv">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Chromaticity.Duv, StringFormat={}{0:F5}, TargetNullValue=—}" ToolTip="{Binding TemperatureStatusText}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="{display:EngineLang Key=补色波长(nm)}">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Chromaticity.ComplementaryWavelength, StringFormat={}{0:F2}, TargetNullValue=—}" ToolTip="{Binding ChromaticityStatusText}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="{display:EngineLang Key=色度状态}">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ChromaticityStatusText}" ToolTip="{Binding ChromaticityStatusText}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
<GridViewColumn  Header="{x:Static properties:Resources.CCT}">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate  DataType="{x:Type local:ViewResultSpectrum}">
                                        <TextBlock Text="{Binding Chromaticity.ColorTemperature, StringFormat={}{0:F1}, TargetNullValue=—}" ToolTip="{Binding TemperatureStatusText}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn  Header="{x:Static properties:Resources.Ld}">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate  DataType="{x:Type local:ViewResultSpectrum}">
                                        <TextBlock Text="{Binding Chromaticity.DominantWavelength, StringFormat={}{0:F2}, TargetNullValue=—}" ToolTip="{Binding ChromaticityStatusText}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn  Header="{x:Static properties:Resources.ColorPurityPercent}" >
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate  DataType="{x:Type local:ViewResultSpectrum}">
                                        <TextBlock Text="{Binding PurityPercent, StringFormat={}{0:F2}, TargetNullValue=—}" ToolTip="{Binding ChromaticityStatusText}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn  Header="{x:Static properties:Resources.Lp}">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate  DataType="{x:Type local:ViewResultSpectrum}">
                                        <TextBlock Text="{ Binding fLp}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn  Header="{x:Static properties:Resources.Ra}" >
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate  DataType="{x:Type local:ViewResultSpectrum}">
                                        <TextBlock Text="{Binding ColorRendering.Ra, StringFormat={}{0:F2}, TargetNullValue=—}" ToolTip="{Binding RenderingStatusText}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{display:EngineLang Key='平均波长 (nm)'}">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type local:ViewResultSpectrum}">
                                        <TextBlock Text="{Binding ColorRendering.MeanWavelength, StringFormat={}{0:F2}, TargetNullValue=—}" ToolTip="{Binding RenderingStatusText}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="R1">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type local:ViewResultSpectrum}">
                                        <TextBlock Text="{Binding RenderingIndices[0], StringFormat={}{0:F2}, TargetNullValue=—}" ToolTip="{Binding RenderingStatusText}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="R2">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type local:ViewResultSpectrum}">
                                        <TextBlock Text="{Binding RenderingIndices[1], StringFormat={}{0:F2}, TargetNullValue=—}" ToolTip="{Binding RenderingStatusText}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="R3">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type local:ViewResultSpectrum}">
                                        <TextBlock Text="{Binding RenderingIndices[2], StringFormat={}{0:F2}, TargetNullValue=—}" ToolTip="{Binding RenderingStatusText}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="R4">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type local:ViewResultSpectrum}">
                                        <TextBlock Text="{Binding RenderingIndices[3], StringFormat={}{0:F2}, TargetNullValue=—}" ToolTip="{Binding RenderingStatusText}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="R5">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type local:ViewResultSpectrum}">
                                        <TextBlock Text="{Binding RenderingIndices[4], StringFormat={}{0:F2}, TargetNullValue=—}" ToolTip="{Binding RenderingStatusText}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="R6">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type local:ViewResultSpectrum}">
                                        <TextBlock Text="{Binding RenderingIndices[5], StringFormat={}{0:F2}, TargetNullValue=—}" ToolTip="{Binding RenderingStatusText}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="R7">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type local:ViewResultSpectrum}">
                                        <TextBlock Text="{Binding RenderingIndices[6], StringFormat={}{0:F2}, TargetNullValue=—}" ToolTip="{Binding RenderingStatusText}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="R8">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type local:ViewResultSpectrum}">
                                        <TextBlock Text="{Binding RenderingIndices[7], StringFormat={}{0:F2}, TargetNullValue=—}" ToolTip="{Binding RenderingStatusText}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="R9">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type local:ViewResultSpectrum}">
                                        <TextBlock Text="{Binding RenderingIndices[8], StringFormat={}{0:F2}, TargetNullValue=—}" ToolTip="{Binding RenderingStatusText}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="R10">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type local:ViewResultSpectrum}">
                                        <TextBlock Text="{Binding RenderingIndices[9], StringFormat={}{0:F2}, TargetNullValue=—}" ToolTip="{Binding RenderingStatusText}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="R11">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type local:ViewResultSpectrum}">
                                        <TextBlock Text="{Binding RenderingIndices[10], StringFormat={}{0:F2}, TargetNullValue=—}" ToolTip="{Binding RenderingStatusText}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="R12">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type local:ViewResultSpectrum}">
                                        <TextBlock Text="{Binding RenderingIndices[11], StringFormat={}{0:F2}, TargetNullValue=—}" ToolTip="{Binding RenderingStatusText}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="R13">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type local:ViewResultSpectrum}">
                                        <TextBlock Text="{Binding RenderingIndices[12], StringFormat={}{0:F2}, TargetNullValue=—}" ToolTip="{Binding RenderingStatusText}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="R14">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type local:ViewResultSpectrum}">
                                        <TextBlock Text="{Binding RenderingIndices[13], StringFormat={}{0:F2}, TargetNullValue=—}" ToolTip="{Binding RenderingStatusText}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="R15 (JIS)">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type local:ViewResultSpectrum}">
                                        <TextBlock Text="{Binding RenderingIndices[14], StringFormat={}{0:F2}, TargetNullValue=—}" ToolTip="{Binding RenderingStatusText}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{display:EngineLang Key='显色性状态'}">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type local:ViewResultSpectrum}">
                                        <TextBlock Text="{Binding RenderingStatusText}" ToolTip="{Binding RenderingStatusText}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn  Header="{x:Static properties:Resources.HalfBandwidth}" >
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate  DataType="{x:Type local:ViewResultSpectrum}">
                                        <TextBlock Text="{ Binding fHW}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn  Header="{display:EngineLang Key=兴奋纯度(%)}" >
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate  DataType="{x:Type local:ViewResultSpectrum}">
                                        <TextBlock Text="{Binding PurityPercent, StringFormat={}{0:F2}, TargetNullValue=—}" ToolTip="{Binding ChromaticityStatusText}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn  Header="DominantWavelengthColor" >
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate  DataType="{x:Type local:ViewResultSpectrum}">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="14" Height="14" Background="{Binding DominantWavelengthColor}" CornerRadius="2" Margin="0,0,4,0"/>
                                            <TextBlock Text="{ Binding DominantWavelengthHex}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="VoltageColumn" Header="{x:Static properties:Resources.V}" >
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate  DataType="{x:Type local:ViewResultSpectrum}">
                                        <TextBlock Text="{ Binding V}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="CurrentColumn" Header="{x:Static properties:Resources.I}" >
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate  DataType="{x:Type local:ViewResultSpectrum}">
                                        <TextBlock Text="{ Binding I}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

            </Grid>
            <GridSplitter Visibility="{Binding Config.IsShowListView, Converter={StaticResource SpectrumDataVisibility}}" Grid.Row="1" Background="#01FFFFFF" Height="2" Panel.ZIndex="999" HorizontalAlignment="Stretch" VerticalAlignment="Top" DragCompleted="GridSplitter_DragCompleted"/>
        </Grid>



    </Grid>
</UserControl>
