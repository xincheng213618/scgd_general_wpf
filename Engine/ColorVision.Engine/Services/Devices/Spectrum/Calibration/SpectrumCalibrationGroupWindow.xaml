<Window x:Class="ColorVision.Engine.Services.Devices.Spectrum.Calibration.SpectrumCalibrationGroupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:engine="clr-namespace:ColorVision.Engine"
        xmlns:properties="clr-namespace:ColorVision.Engine.Properties"
        Title="{x:Static properties:Resources.SpectrumCalibrationGroups_Title}"
        Width="680" Height="380" MinWidth="600" MinHeight="360"
        Background="{DynamicResource GlobalBackground}">
    <Window.Resources>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>
        <Style BasedOn="{StaticResource TextBox.Small}" TargetType="{x:Type TextBox}" />
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,10">
            <Button x:Name="BtnRemoveGroup" DockPanel.Dock="Right" Margin="6,0,0,0" Padding="12,4" Click="BtnRemoveGroup_Click" Content="{x:Static properties:Resources.SpectrumCalibrationGroups_RemoveGroup}" />
            <Button x:Name="BtnAddGroup" DockPanel.Dock="Right" Margin="6,0,0,0" Padding="12,4" Click="BtnAddGroup_Click" Content="{x:Static properties:Resources.SpectrumCalibrationGroups_AddGroup}" />
            <TextBlock Width="110" Text="{x:Static properties:Resources.SpectrumCalibrationGroups_CurrentGroup}" />
            <ComboBox x:Name="ComboBoxGroups" DisplayMemberPath="GroupName" SelectionChanged="ComboBoxGroups_SelectionChanged" />
        </DockPanel>

        <GroupBox Grid.Row="1" Header="{x:Static properties:Resources.SpectrumCalibrationGroups_GroupDetails}">
            <StackPanel Margin="8">
                <StackPanel x:Name="DetailGrid">
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Width="110" Text="{x:Static properties:Resources.SpectrumCalibrationGroups_GroupName}" />
                        <TextBox Text="{Binding GroupName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>

                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Margin="6,0,0,0" Padding="10,3" Click="BtnSelectWavelength_Click" Content="{x:Static properties:Resources.SelectWithEllipsis}" />
                        <TextBlock Width="110" Text="{x:Static properties:Resources.SpectrumCalibrationGroups_WavelengthCalibration}" />
                        <TextBox IsReadOnly="True" Text="{Binding WavelengthFile}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    </DockPanel>

                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Margin="6,0,0,0" Padding="10,3" Click="BtnSelectMaguide_Click" Content="{x:Static properties:Resources.SelectWithEllipsis}" />
                        <TextBlock Width="110" Text="{x:Static properties:Resources.SpectrumCalibrationGroups_AmplitudeCalibration}" />
                        <TextBox IsReadOnly="True" Text="{Binding MaguideFile}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    </DockPanel>
                </StackPanel>

                <DockPanel Margin="0,0,0,8" LastChildFill="False">
                    <TextBlock Width="110" Text="{x:Static properties:Resources.SpectrumCalibrationGroups_FilterWheelService}" />
                    <ComboBox x:Name="ComboBoxCfwService" Width="255" DisplayMemberPath="DisplayName" SelectedValuePath="Code"
                              SelectionChanged="ComboBoxCfwService_SelectionChanged"
                              AutomationProperties.Name="{x:Static properties:Resources.SpectrumCalibrationGroups_FilterWheelService}" />
                    <CheckBox x:Name="LocalNdEnabled" Margin="12,0,0,0" VerticalAlignment="Center"
                              Content="{x:Static properties:Resources.SpectrumNdEnabled}"
                              IsChecked="{Binding NDConfig.IsNDPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>

                <DockPanel x:Name="NdHoleFields" Margin="0,0,0,8">
                    <TextBlock Width="110" Text="{x:Static properties:Resources.SpectrumCalibrationGroups_FilterWheelPosition}" />
                    <ComboBox x:Name="ComboBoxNDHole" Width="180" DisplayMemberPath="DisplayName" SelectedValuePath="HoleIndex"
                              SelectionChanged="ComboBoxNDHole_SelectionChanged"
                              SelectedValue="{Binding NDHoleIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              AutomationProperties.Name="{x:Static properties:Resources.SpectrumCalibrationGroups_FilterWheelPosition}" />
                    <TextBlock Margin="8,0,0,0" FontSize="11" Opacity="0.65" Text="{x:Static properties:Resources.SpectrumCalibrationGroups_AutoApplyNdHint}" />
                </DockPanel>

                <DockPanel x:Name="NdAttenuationField" Visibility="Collapsed">
                    <TextBlock Width="110" Text="{x:Static properties:Resources.SpectrumNdRates}" />
                    <TextBox x:Name="NdAttenuationInput" Width="86" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="{x:Static properties:Resources.SpectrumNdRates}" />
                    <TextBlock Margin="8,0,0,0" FontSize="11" Opacity="0.65" Text="{engine:EngineLang SpectrumCalibrationGroups_NdRateHint}" />
                </DockPanel>
            </StackPanel>
        </GroupBox>

        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button MinWidth="80" Margin="0,0,8,0" Padding="16,5" Click="BtnSave_Click" Content="{x:Static properties:Resources.Save}" />
                <Button MinWidth="80" Padding="16,5" Click="BtnClose_Click" Content="{x:Static properties:Resources.Close}" />
            </StackPanel>
            <TextBlock x:Name="SaveHintText" Margin="0,0,8,0" Foreground="Gray" FontSize="11" TextWrapping="Wrap" Text="{x:Static properties:Resources.SpectrumCalibrationGroups_SaveHint}" />
        </DockPanel>
    </Grid>
</Window>
