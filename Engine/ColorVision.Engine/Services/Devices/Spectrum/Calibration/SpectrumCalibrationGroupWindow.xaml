<Window x:Class="ColorVision.Engine.Services.Devices.Spectrum.Calibration.SpectrumCalibrationGroupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:engine="clr-namespace:ColorVision.Engine"
        xmlns:properties="clr-namespace:ColorVision.Engine.Properties"
        Title="{x:Static properties:Resources.SpectrumCalibrationGroups_Title}"
        Width="780" Height="540" MinWidth="660" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource GlobalBackground}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ColorVision.Themes;component/Themes/Components/Dialog.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource CV.Surface.Control}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CV.Border.Control}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16" />
            </Style>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource CV.Text.Primary}" />
            </Style>
            <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,12" />
            </Style>
            <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="Margin" Value="0,0,0,5" />
            </Style>
            <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="Foreground" Value="{DynamicResource CV.Text.Secondary}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="CompactButton" TargetType="Button" BasedOn="{StaticResource CV.Button.Secondary}">
                <Setter Property="MinWidth" Value="74" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Padding" Value="11,5" />
            </Style>
            <Style x:Key="Input" TargetType="TextBox" BasedOn="{StaticResource TextBoxBaseStyle}">
                <Setter Property="MinHeight" Value="32" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="20,16,20,14" BorderBrush="{DynamicResource CV.Border.Weak}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="CurrentGroupLabel" Style="{StaticResource FieldLabel}"
                               Text="{x:Static properties:Resources.SpectrumCalibrationGroups_CurrentGroup}" />
                    <ComboBox x:Name="ComboBoxGroups" MinHeight="32" DisplayMemberPath="GroupName"
                              SelectionChanged="ComboBoxGroups_SelectionChanged"
                              AutomationProperties.LabeledBy="{Binding ElementName=CurrentGroupLabel}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button x:Name="BtnAddGroup" Style="{StaticResource CompactButton}" Click="BtnAddGroup_Click"
                            Content="{x:Static properties:Resources.SpectrumCalibrationGroups_AddGroup}" />
                    <Button x:Name="BtnRenameGroup" Style="{StaticResource CompactButton}" Margin="8,0,0,0" Click="BtnRenameGroup_Click"
                            Content="{engine:EngineLang SpectrumCalibrationGroups_RenameGroup}" />
                    <Button x:Name="BtnRemoveGroup" Style="{StaticResource CompactButton}" Margin="8,0,0,0" Click="BtnRemoveGroup_Click"
                            Content="{x:Static properties:Resources.SpectrumCalibrationGroups_RemoveGroup}" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="20,16" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}">
                    <StackPanel x:Name="DetailGrid">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{engine:EngineLang SpectrumCalibrationGroups_CalibrationFiles}" />

                        <TextBlock x:Name="WavelengthLabel" Style="{StaticResource FieldLabel}"
                                   Text="{x:Static properties:Resources.SpectrumCalibrationGroups_WavelengthCalibration}" />
                        <DockPanel Margin="0,0,0,14">
                            <Button DockPanel.Dock="Right" Margin="8,0,0,0" Style="{StaticResource CompactButton}" Click="BtnSelectWavelength_Click"
                                    Content="{x:Static properties:Resources.SelectWithEllipsis}"
                                    AutomationProperties.LabeledBy="{Binding ElementName=WavelengthLabel}" />
                            <TextBox Style="{StaticResource Input}" IsReadOnly="True" Text="{Binding WavelengthFile, Mode=OneWay}"
                                     AutomationProperties.LabeledBy="{Binding ElementName=WavelengthLabel}"
                                     ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        </DockPanel>

                        <TextBlock x:Name="AmplitudeLabel" Style="{StaticResource FieldLabel}"
                                   Text="{x:Static properties:Resources.SpectrumCalibrationGroups_AmplitudeCalibration}" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Margin="8,0,0,0" Style="{StaticResource CompactButton}" Click="BtnSelectMaguide_Click"
                                    Content="{x:Static properties:Resources.SelectWithEllipsis}"
                                    AutomationProperties.LabeledBy="{Binding ElementName=AmplitudeLabel}" />
                            <TextBox Style="{StaticResource Input}" IsReadOnly="True" Text="{Binding MaguideFile, Mode=OneWay}"
                                     AutomationProperties.LabeledBy="{Binding ElementName=AmplitudeLabel}"
                                     ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{engine:EngineLang SpectrumCalibrationGroups_NdAssociation}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static properties:Resources.SpectrumCalibrationGroups_FilterWheelService}" />
                        <ComboBox x:Name="ComboBoxCfwService" MinHeight="32" Margin="0,0,0,14"
                                  DisplayMemberPath="DisplayName" SelectedValuePath="Code" SelectionChanged="ComboBoxCfwService_SelectionChanged"
                                  AutomationProperties.Name="{x:Static properties:Resources.SpectrumCalibrationGroups_FilterWheelService}" />
                        <StackPanel x:Name="NdHoleFields">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static properties:Resources.SpectrumCalibrationGroups_FilterWheelPosition}" />
                            <ComboBox x:Name="ComboBoxNDHole" MinHeight="32" DisplayMemberPath="DisplayName" SelectedValuePath="HoleIndex"
                                      SelectionChanged="ComboBoxNDHole_SelectionChanged"
                                      SelectedValue="{Binding NDHoleIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      AutomationProperties.Name="{x:Static properties:Resources.SpectrumCalibrationGroups_FilterWheelPosition}" />
                            <TextBlock Margin="0,6,0,0" Style="{StaticResource Hint}" Text="{x:Static properties:Resources.SpectrumCalibrationGroups_AutoApplyNdHint}" />
                        </StackPanel>

                        <Border Margin="0,12,0,0" Padding="0,11,0,0" BorderBrush="{DynamicResource CV.Border.Weak}" BorderThickness="0,1,0,0"
                                Visibility="{Binding Visibility, ElementName=LocalNdEnabled}">
                            <StackPanel>
                                <CheckBox x:Name="LocalNdEnabled" FontWeight="SemiBold"
                                          Content="{engine:EngineLang SpectrumCalibrationGroups_AutoSwitchNd}"
                                          IsChecked="{Binding NDConfig.IsNDPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <CheckBox.ContentTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=CheckBox}}" />
                                        </DataTemplate>
                                    </CheckBox.ContentTemplate>
                                </CheckBox>
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource Hint}" Text="{engine:EngineLang SpectrumCalibrationGroups_AutoSwitchNdHint}" />
                                <StackPanel x:Name="NdAttenuationField" Margin="0,10,0,0" Visibility="Collapsed">
                                    <DockPanel LastChildFill="False">
                                        <TextBlock DockPanel.Dock="Left" Margin="0,0,10,0" VerticalAlignment="Center"
                                                   Text="{x:Static properties:Resources.SpectrumNdRates}" />
                                        <TextBox x:Name="NdAttenuationInput" Width="84" Style="{StaticResource Input}"
                                                 Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="{x:Static properties:Resources.SpectrumNdRates}" />
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,5,0,0" Text="{engine:EngineLang SpectrumCalibrationGroups_NdRateHint}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="20,12" Background="{DynamicResource CV.Surface.Control}"
                BorderBrush="{DynamicResource CV.Border.Weak}" BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Button Style="{StaticResource CV.Button.Secondary}" Click="BtnClose_Click" Content="{x:Static properties:Resources.Close}" />
                    <Button Style="{StaticResource CV.Button.Primary}" Margin="8,0,0,0" Click="BtnSave_Click" Content="{x:Static properties:Resources.Save}" />
                </StackPanel>
                <TextBlock x:Name="SaveHintText" Style="{StaticResource Hint}" VerticalAlignment="Center"
                           Text="{x:Static properties:Resources.SpectrumCalibrationGroups_SaveHint}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
