<Window x:Class="ColorVision.Engine.Services.Devices.Spectrum.Correction.SpectrumCorrectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        mc:Ignorable="d"
        Title="光谱修正" Width="1220" Height="820" MinWidth="1050" MinHeight="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource GlobalBackground}"
        Foreground="{DynamicResource GlobalTextBrush}">
    <Window.Resources>
        <SolidColorBrush x:Key="SpectrumCorrectionWarningBrush" Color="#D9822B" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="6,4" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="MinHeight" Value="30" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Background" Value="{DynamicResource GlobalBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource GlobalBorderBrush1}" />
            <Setter Property="EnableRowVirtualization" Value="True" />
            <Setter Property="EnableColumnVirtualization" Value="True" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="235" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="12" Margin="0,0,0,10" CornerRadius="5"
                BorderThickness="1" BorderBrush="{DynamicResource GlobalBorderBrush1}"
                Background="{DynamicResource GlobalBorderBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,6,0" Text="设备" Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBlock x:Name="DeviceText" Grid.Row="0" Grid.Column="1" Text="采集后显示" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Row="0" Grid.Column="2" Margin="12,0,6,0" Text="SN" Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBlock x:Name="SerialNumberText" Grid.Row="0" Grid.Column="3" Text="—" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Row="0" Grid.Column="4" Margin="12,0,6,0" Text="标定组" Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBlock x:Name="CalibrationGroupText" Grid.Row="0" Grid.Column="5" Text="—" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Row="0" Grid.Column="6" Margin="12,0,6,0" Text="结果" Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBlock x:Name="ResultText" Grid.Row="0" Grid.Column="7" Text="—" TextTrimming="CharacterEllipsis" />
                <Button x:Name="CaptureButton" Grid.Row="0" Grid.RowSpan="2" Grid.Column="8" Margin="14,0,0,0"
                        MinWidth="110" Content="采集实测" Click="CaptureButton_Click" />

                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,8,6,0" Text="当前 DAT" Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBlock x:Name="MagnitudeFileText" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="7" Margin="0,8,0,0"
                           Text="采集后自动读取当前标定组" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
            </Grid>
        </Border>

        <TabControl x:Name="CorrectionTabs" Grid.Row="1" Margin="0,0,0,8" SelectedIndex="1" SelectionChanged="CorrectionTabs_SelectionChanged">
            <TabItem Header="单独亮度修正">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,12,10" Text="目标亮度/光度值" />
                    <TextBox x:Name="TargetBrightnessTextBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10" TextChanged="CorrectionInput_Changed" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,12,10" Text="本次服务实测值" />
                    <TextBox x:Name="MeasuredBrightnessTextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" IsReadOnly="True" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,12,10" Text="修正比例" />
                    <TextBox x:Name="BrightnessRatioTextBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" IsReadOnly="True" />

                    <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="2" Margin="28,0,0,0" Padding="14" CornerRadius="4"
                            Background="{DynamicResource GlobalBorderBrush}" BorderBrush="{DynamicResource GlobalBorderBrush1}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock FontSize="15" FontWeight="SemiBold" Text="只调整整体亮度，保持相对光谱形状" />
                            <TextBlock Margin="0,10,0,0" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"
                                       Text="新幅值系数 = 当前幅值系数 ×（目标值 ÷ 实测值）。目标值必须与服务返回的 fPh 使用同一种测量模式和单位。" />
                            <TextBlock Margin="0,10,0,0" Foreground="{StaticResource SpectrumCorrectionWarningBrush}" TextWrapping="Wrap"
                                       Text="应用后不会在本窗口自动复测；请等待服务重新加载后再正常测量验证。" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="完整光谱修正">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,7">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Margin="0,0,6,0" Content="从 CSV/TXT 导入" Click="ImportStandardButton_Click" />
                            <Button Content="清空标准值" Click="ClearStandardButton_Click" />
                        </StackPanel>
                        <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"
                                   Text="标准谱必须覆盖当前 DAT 全波段，且单位和测量光路必须与服务实测一致；表格支持双击编辑，也可在表格中按 Ctrl+V 粘贴两列数据。" />
                    </DockPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <GroupBox Grid.Column="0" Header="标准绝对光谱（可编辑）" Padding="5">
                            <DataGrid x:Name="StandardDataGrid" ItemsSource="{Binding StandardRows}" AutoGenerateColumns="False"
                                      CanUserAddRows="True" CanUserDeleteRows="True" PreviewKeyDown="StandardDataGrid_PreviewKeyDown">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="波长 (nm)" Width="*" Binding="{Binding Wavelength, UpdateSourceTrigger=LostFocus, StringFormat=G10}" />
                                    <DataGridTextColumn Header="标准值" Width="*" Binding="{Binding Value, UpdateSourceTrigger=LostFocus, StringFormat=G10}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                        <GroupBox Grid.Column="2" Header="服务实测绝对光谱（只读）" Padding="5">
                            <DataGrid x:Name="MeasuredDataGrid" ItemsSource="{Binding MeasuredRows}" AutoGenerateColumns="False"
                                      IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="波长 (nm)" Width="*" Binding="{Binding Wavelength, StringFormat=F1}" />
                                    <DataGridTextColumn Header="fPL × fPlambda" Width="*" Binding="{Binding Value, StringFormat=G10}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Margin="0,0,0,8" Padding="5" CornerRadius="4"
                BorderBrush="{DynamicResource GlobalBorderBrush1}" BorderThickness="1">
            <ScottPlot:WpfPlot x:Name="PreviewPlot" />
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" Foreground="{DynamicResource SecondaryTextBrush}" Text="请先采集服务实测数据。" TextWrapping="Wrap" />
                <TextBlock x:Name="GeneratedFileText" Margin="0,3,12,0" Foreground="{DynamicResource SecondaryTextBrush}"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="PreviewButton" Margin="0,0,8,0" MinWidth="95" Content="计算预览" Click="PreviewButton_Click" />
                <Button x:Name="GenerateButton" Margin="0,0,8,0" MinWidth="120" Content="生成新 DAT" Click="GenerateButton_Click" />
                <Button x:Name="ApplyButton" MinWidth="130" Content="应用已生成 DAT" IsEnabled="False" Click="ApplyButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
