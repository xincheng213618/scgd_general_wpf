<Window x:Class="ColorVision.Engine.Services.Devices.Spectrum.Local.LocalSpectrumWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="本地光谱仪" Width="1180" Height="800" MinWidth="720" MinHeight="500"
        Background="{DynamicResource GlobalBackgroundBrush}" Foreground="{DynamicResource GlobalTextBrush}"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{Binding Config.Name}" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Config.SN}" Margin="0,4,0,10"/>
            <WrapPanel>
                <Button Content="连接" Tag="Open" Click="Command_Click" Margin="0,0,8,8" Padding="14,5"/>
                <Button Content="断开" Tag="Close" Click="Command_Click" Margin="0,0,8,8" Padding="14,5"/>
                <Button Content="单次采集" Tag="GetData" Click="Command_Click" Margin="0,0,8,8" Padding="14,5"/>
                <Button Content="连续采集" Tag="GetDataAuto" Click="Command_Click" Margin="0,0,8,8" Padding="14,5"/>
                <Button Content="停止" Tag="GetDataAutoStop" Click="Command_Click" Margin="0,0,8,8" Padding="14,5"/>
                <Button Content="校零" Tag="InitDark" Click="Command_Click" Margin="0,0,8,8" Padding="14,5" ToolTip="请先遮光，再进行校零。"/>
                <Button Content="自适应校零" Tag="InitAutoDark" Click="Command_Click" Margin="0,0,8,8" Padding="14,5"/>
                <Button Content="设备配置" Command="{Binding EditCommand}" Margin="0,0,8,8" Padding="14,5"/>
                <Button Content="校正组" Command="{Binding OpenCalibrationGroupWindowCommand}" Margin="0,0,8,8" Padding="14,5"/>
                <Button Content="采集设置" Command="{Binding EditDisplayConfigCommand}" Margin="0,0,8,8" Padding="14,5"/>
                <Button Content="导出当前结果" Click="Export_Click" Margin="0,0,8,8" Padding="14,5"/>
                <Button x:Name="ApplyNodeButton" Content="应用到节点" Click="ApplyNode_Click" Visibility="Collapsed" Margin="0,0,8,8" Padding="14,5"/>
            </WrapPanel>
            <WrapPanel Margin="0,0,0,8">
                <TextBlock Text="积分时间(ms)" VerticalAlignment="Center"/>
                <TextBox Width="85" Margin="8,0,16,0" Text="{Binding DisplayConfig.IntTime, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                <TextBlock Text="平均次数" VerticalAlignment="Center"/>
                <TextBox Width="65" Margin="8,0,16,0" Text="{Binding DisplayConfig.AveNum, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                <CheckBox Content="自动积分" IsChecked="{Binding DisplayConfig.IsAutoIntTime}" Margin="0,0,16,0"/>
                <CheckBox Content="自动校零（需遮光）" IsChecked="{Binding DisplayConfig.IsAutoDark}" Margin="0,0,16,0"/>
                <CheckBox Content="自适应暗校正" IsChecked="{Binding DisplayConfig.IsShutter}"/>
            </WrapPanel>
            <TextBlock x:Name="Message" Text="连接由窗口和流程共用；关闭窗口会保留连接，停止设备请点击断开。" TextWrapping="Wrap" Margin="0,0,0,8"/>
        </StackPanel>
        <ContentControl x:Name="ResultHost"/>
    </DockPanel>
</Window>
