<Window x:Class="ColorVision.Engine.Services.Devices.PG.EditPG"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:properties="clr-namespace:ColorVision.Engine.Properties"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:controls="clr-namespace:ColorVision.Themes.Controls;assembly=ColorVision.Themes"
        Title="PG 配置" Width="650" Height="620" MinWidth="580" MinHeight="580"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource GlobalBackground}"
        SnapsToDevicePixels="True" UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ColorVision.Engine;component/Services/PhyCameras/PhyCameraConsoleStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="VisibleWhen"/>
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource GlobalBorderBrush1}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="16,10"/>
                <Setter Property="Margin" Value="0,0,4,10"/>
            </Style>
            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="Width" Value="125"/>
                <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="16,14,16,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="EditorContent" DataContext="{Binding Draft}">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel DataContext="{Binding Config}">
                        <TextBlock Text="设备" Style="{StaticResource SectionTitleStyle}"/>
                        <StackPanel x:Name="DeviceFields"/>
                        <DockPanel Margin="0,3">
                            <TextBlock Text="SN" Style="{StaticResource FieldLabel}"/>
                            <Button DockPanel.Dock="Right" Content="{x:Static properties:Resources.Edit}" Style="{StaticResource ToolbarButtonStyle}" Margin="6,0,0,0" MinWidth="60" Click="EditSn_Click"/>
                            <hc:ComboBox x:Name="CameraPhyID" IsEditable="True" Text="{Binding SN, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="Code" Style="{StaticResource ComboBox.Small}" hc:InfoElement.ShowClearButton="True"/>
                        </DockPanel>
                        <DockPanel Margin="0,3">
                            <TextBlock Text="PG 类型" Style="{StaticResource FieldLabel}"/>
                            <hc:ComboBox x:Name="PgCategory" IsEditable="True" AutoComplete="True" Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ComboBox.Small}" hc:InfoElement.ShowClearButton="True"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="连接" Style="{StaticResource SectionTitleStyle}"/>
                        <DockPanel x:Name="ConnectionMode" Margin="0,6,0,10" Visibility="{Binding IsStandardConnection, Converter={StaticResource VisibleWhen}}">
                            <TextBlock Text="连接方式" Style="{StaticResource FieldLabel}"/>
                            <WrapPanel>
                                <RadioButton x:Name="SerialMode" Content="串口" GroupName="ConnectionMode" IsChecked="{Binding Config.IsNet, Mode=TwoWay, Converter={StaticResource Boolean2BooleanReConverter}}" Margin="0,0,24,0"/>
                                <RadioButton x:Name="NetworkMode" Content="网口" GroupName="ConnectionMode" IsChecked="{Binding Config.IsNet, Mode=TwoWay}"/>
                            </WrapPanel>
                        </DockPanel>
                        <StackPanel x:Name="NetworkSection" Visibility="{Binding IsNetworkConnection, Converter={StaticResource VisibleWhen}}">
                            <DockPanel Margin="0,3">
                                <TextBlock Text="IP / 主机名" Style="{StaticResource FieldLabel}"/>
                                <controls:IPAddressBox x:Name="NetworkAddress" Text="{Binding NetworkAddress, UpdateSourceTrigger=PropertyChanged}" AllowTextMode="True" AutomationProperties.Name="PG IP 地址或主机名"/>
                            </DockPanel>
                            <DockPanel Margin="0,3">
                                <TextBlock Text="{x:Static properties:Resources.Port}" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="NetworkPort" Text="{Binding NetworkPort, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Style="{StaticResource TextBox.Small}"/>
                            </DockPanel>
                        </StackPanel>
                        <StackPanel x:Name="SerialSection" Visibility="{Binding IsSerialConnection, Converter={StaticResource VisibleWhen}}">
                            <DockPanel Margin="0,3">
                                <TextBlock Text="串口" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="SerialPortName" Text="{Binding SerialPortName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Small}" ToolTip="填写服务电脑上的串口名，例如 COM7。"/>
                            </DockPanel>
                            <DockPanel Margin="0,3">
                                <TextBlock Text="{x:Static properties:Resources.BaudRate}" Style="{StaticResource FieldLabel}"/>
                                <hc:ComboBox x:Name="SerialBaudRate" IsEditable="True" Text="{Binding SerialBaudRate, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Style="{StaticResource ComboBox.Small}"/>
                            </DockPanel>
                            <TextBlock Text="串口名按服务电脑填写，例如 COM7。" Style="{StaticResource LabelTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                        <StackPanel x:Name="I2CSection" Visibility="{Binding IsI2C, Converter={StaticResource VisibleWhen}}">
                            <DockPanel Margin="0,3">
                                <TextBlock Text="{x:Static properties:Resources.Engine_PG_DeviceIndex}" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="I2CDeviceIndex" Text="{Binding I2CDeviceIndex, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Small}"/>
                            </DockPanel>
                            <DockPanel Margin="0,3">
                                <TextBlock Text="{x:Static properties:Resources.DeviceAddr}" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="I2CDeviceAddress" Text="{Binding I2CDeviceAddress, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Style="{StaticResource TextBox.Small}"/>
                            </DockPanel>
                            <TextBlock Text="索引从 0 开始；设备地址填写十进制数值。" Style="{StaticResource LabelTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border x:Name="ProtocolSection" Style="{StaticResource CardStyle}" Visibility="{Binding ShowRegisterAddress, Converter={StaticResource VisibleWhen}}">
                    <StackPanel>
                        <TextBlock Text="设备参数" Style="{StaticResource SectionTitleStyle}"/>
                        <DockPanel Margin="0,3">
                            <TextBlock Text="{Binding RegisterAddressLabel}" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="RegisterAddress" Text="{Binding Config.RegisterAddress, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Style="{StaticResource TextBox.Small}"/>
                        </DockPanel>
                        <DockPanel Margin="0,3" Visibility="{Binding IsI2C, Converter={StaticResource VisibleWhen}}">
                            <TextBlock Text="I²C 通信速率" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="I2CSpeed" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding Config.BaudRate}" Style="{StaticResource ComboBox.Small}"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <TextBlock Grid.Row="1" x:Name="StatusText" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,4,8"/>
        <Border Grid.Row="2" BorderBrush="{DynamicResource GlobalBorderBrush1}" BorderThickness="0,1,0,0" Padding="0,12">
            <DockPanel>
                <TextBlock Text="修改连接参数后请重新连接。" Style="{StaticResource LabelTextStyle}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{x:Static properties:Resources.OK}" Style="{StaticResource PrimaryToolbarButtonStyle}" MinWidth="90" Height="34" IsDefault="True" Click="Ok_Click"/>
                    <Button Content="{x:Static properties:Resources.Cancel}" Style="{StaticResource ToolbarButtonStyle}" MinWidth="90" Height="34" IsCancel="True" Margin="6,0,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
