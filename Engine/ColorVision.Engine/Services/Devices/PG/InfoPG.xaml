<UserControl x:Class="ColorVision.Engine.Services.Devices.PG.InfoPG"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ColorVision.Engine.Services.Devices.PG"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:DevicePG}"
             d:DesignHeight="400"
             d:DesignWidth="600"
             Initialized="UserControl_Initialized">
    <Grid>
        <Border Background="{DynamicResource RegionBrush}" CornerRadius="5">
            <ScrollViewer Margin="-1,0" HorizontalScrollBarVisibility="Disabled">
                <UniformGrid x:Name="CommandGrid" Margin="5" VerticalAlignment="Top" />
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
