<UserControl x:Class="ColorVision.Engine.Services.Devices.LightingController.DisplayLightingController"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ColorVision.Engine.Services.Devices.LightingController"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:properties="clr-namespace:ColorVision.Engine.Properties"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:DeviceLightingController}"
             d:DesignWidth="300"
             ContextMenu="{Binding ContextMenu}"
             Initialized="UserControl_Initialized">
    <UserControl.Resources>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>
        <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource TextBox.Small}" />
    </UserControl.Resources>

    <StackPanel>
        <DockPanel Margin="0,0,5,0" ToolTip="{Binding DService.DeviceStatus}">
            <Grid DockPanel.Dock="Right">
                <ToggleButton Width="10" Height="10" HorizontalAlignment="Center" IsChecked="True" IsEnabled="False" Style="{StaticResource ButtonMQTTConnect}" />
                <Image Height="18" Source="{DynamicResource DrawingImageProperty}" />
                <Button Background="Transparent" BorderThickness="0" Command="{Binding PropertyCommand}" />
            </Grid>
            <ToggleButton Content="{Binding Config.Name}"
                          FontSize="15"
                          IsChecked="{Binding DisplayConfig.IsDisplayOpen}"
                          Style="{StaticResource ButtonPageControl1}"
                          ToolTip="{Binding DService.DeviceStatus}" />
        </DockPanel>

        <Border x:Name="DisPlayBorder"
                Style="{DynamicResource BorderModuleArea}"
                Visibility="{Binding DisplayConfig.IsDisplayOpen, Converter={StaticResource bool2VisibilityConverter}}">
            <StackPanel Margin="5">
                <TextBlock x:Name="TextBlockUnknown" Text="{x:Static properties:Resources.UnknownStatus}" />
                <TextBlock x:Name="TextBlockOffline" Text="{x:Static properties:Resources.offline}" />
                <Button x:Name="ButtonUnauthorized"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,4"
                        Command="{Binding EditCommand}"
                        Content="{x:Static properties:Resources.Unregistered}" />

                <StackPanel x:Name="ControlPanel">
                    <StackPanel Margin="0,0,0,4" Orientation="Horizontal">
                        <Button x:Name="ButtonOpen" Margin="0,0,4,0" Click="Open_Click" Content="{x:Static properties:Resources.Open}" />
                        <Button x:Name="ButtonClose" Background="Red" Click="Close_Click" Content="{x:Static properties:Resources.Close}" Foreground="White" />
                    </StackPanel>

                    <ItemsControl x:Name="ChannelsPanel" ItemsSource="{Binding Config.Channels}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:PMChannelConfig}">
                                <Border Margin="0,2"
                                        Padding="6"
                                        Background="{DynamicResource SecondaryRegionBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,5">
                                            <TextBlock DockPanel.Dock="Right" Opacity="0.65" Text="{Binding Code}" />
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                        </DockPanel>
                                        <DockPanel Margin="0,0,0,5">
                                            <Button DockPanel.Dock="Right" Margin="4,0,0,0" Click="GetValue_Click" Content="{x:Static properties:Resources.Refresh}" />
                                            <Button DockPanel.Dock="Right" Margin="4,0,0,0" Click="SetValue_Click" Content="{x:Static properties:Resources.Settings}" />
                                            <TextBlock Width="42" Text="{x:Static properties:Resources.Value}" />
                                            <TextBox MinWidth="70" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                        </DockPanel>
                                        <UniformGrid Columns="2">
                                            <Button Margin="0,0,2,0" Click="TurnOn_Click" Content="{x:Static properties:Resources.PowerOn}" />
                                            <Button Margin="2,0,0,0" Click="TurnOff_Click" Content="{x:Static properties:Resources.PowerOff}" />
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
