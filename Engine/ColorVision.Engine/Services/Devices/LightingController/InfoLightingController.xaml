<UserControl x:Class="ColorVision.Engine.Services.Devices.LightingController.InfoLightingController"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ColorVision.Engine.Services.Devices.LightingController"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:DeviceLightingController}"
             d:DesignHeight="400"
             d:DesignWidth="600"
             Initialized="UserControl_Initialized">
    <Grid>
        <Border Background="{DynamicResource SecondaryRegionBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="5" />
        <ScrollViewer Margin="5" HorizontalScrollBarVisibility="Disabled">
            <UniformGrid x:Name="CommandGrid" Margin="5" VerticalAlignment="Top" />
        </ScrollViewer>
    </Grid>
</UserControl>
