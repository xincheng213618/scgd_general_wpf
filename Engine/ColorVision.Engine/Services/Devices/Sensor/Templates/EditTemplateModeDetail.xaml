<UserControl x:Class="ColorVision.Engine.Services.Devices.Sensor.Templates.EditTemplateSensor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ColorVision.Engine.Services.Devices.Sensor.Templates"
             xmlns:properties="clr-namespace:ColorVision.Engine.Properties"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:SensorParam}"
             d:DesignHeight="600" d:DesignWidth="900">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,16" LastChildFill="False">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <CheckBox Margin="0,0,16,0" VerticalAlignment="Center" Content="{x:Static properties:Resources.Sensor_ShowPreview}" IsChecked="{Binding Source={x:Static local:EditTemplateSensor.Config}, Path=IsCommandPreviewVisible}"/>
                <Button Content="{x:Static properties:Resources.AddCmd}" Command="{Binding CreateCommand}"/>
                <Button x:Name="DeleteCommandButton" Margin="8,0,0,0" Content="{x:Static properties:Resources.MenuDelete}" Click="Button_Del_Click"/>
            </StackPanel>
            <StackPanel x:Name="CommandSelectionPanel" Orientation="Horizontal" Visibility="Collapsed">
                <ComboBox x:Name="CommandSelector" MinWidth="80" SelectionChanged="CommandSelector_SelectionChanged"/>
                <TextBlock x:Name="CommandPosition" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </DockPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid x:Name="CommandForm">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{x:Static properties:Resources.CommandType}" Margin="0,0,0,6"/>
                    <ComboBox x:Name="ComboBoxType" Initialized="ComboBoxType_Initialized" SelectedItem="{Binding SensorCmdType}" HorizontalAlignment="Left" MinWidth="180"/>
                    <TextBlock Text="{x:Static properties:Resources.SendCmd}" Margin="0,18,0,6"/>
                    <TextBox x:Name="TextBoxSendCommand" MinHeight="88" Padding="8" AcceptsReturn="True" VerticalContentAlignment="Top" TextWrapping="Wrap" FontFamily="Consolas" Text="{Binding Request, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="{x:Static properties:Resources.RevCmd}" Margin="0,16,0,6"/>
                    <TextBox x:Name="TextBoxResCommand" MinHeight="72" Padding="8" AcceptsReturn="True" VerticalContentAlignment="Top" TextWrapping="Wrap" FontFamily="Consolas" Text="{Binding Response, UpdateSourceTrigger=PropertyChanged}"/>
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="{x:Static properties:Resources.TimeOut_Ms}" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding Timeout, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Text="{x:Static properties:Resources.DelayMs}" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding Delay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{x:Static properties:Resources.RetryCount}" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding RetryCount, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>
                    <Expander Header="{x:Static properties:Resources.Sensor_BracketFormat}" Margin="0,20,0,0">
                        <StackPanel Margin="0,10,0,0">
                            <CheckBox Content="{x:Static properties:Resources.Sensor_UseControlCharacterNames}" IsChecked="{Binding Source={x:Static local:EditTemplateSensor.Config}, Path=UseControlNamesInBracketText}" Margin="0,0,0,8"/>
                            <TextBox MinHeight="64" Padding="8" AcceptsReturn="True" VerticalContentAlignment="Top" TextWrapping="Wrap" FontFamily="Consolas" Text="{Binding BracketText, UpdateSourceTrigger=PropertyChanged}"/>
                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="{x:Static properties:Resources.Sensor_ConvertToRequest}" Command="{Binding BracketTextToRequestCommand}" Margin="0,0,6,6"/>
                                <Button Content="{x:Static properties:Resources.Sensor_ConvertToResponse}" Command="{Binding BracketTextToResponseCommand}" Margin="0,0,6,6"/>
                                <Button Content="{x:Static properties:Resources.Sensor_RequestEcho}" Command="{Binding RequestToBracketTextCommand}" Margin="0,0,6,6"/>
                                <Button Content="{x:Static properties:Resources.Sensor_ResponseEcho}" Command="{Binding ResponseToBracketTextCommand}" Margin="0,0,6,6"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding ConvertStatus}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
                <Border Grid.Column="1" Width="260" Margin="20,0,0,0" Padding="14" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource GlobalBorderBrush}" VerticalAlignment="Top"
                        Visibility="{Binding Source={x:Static local:EditTemplateSensor.Config}, Path=IsCommandPreviewVisible, Converter={StaticResource bool2VisibilityConverter}}">
                    <TextBox Text="{Binding PreviewText, Mode=OneWay}" IsReadOnly="True" Padding="0" BorderThickness="0" Background="Transparent" FontFamily="Consolas" HorizontalContentAlignment="Left" VerticalContentAlignment="Top" TextWrapping="Wrap" AcceptsReturn="True"/>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
