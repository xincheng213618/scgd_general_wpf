<UserControl x:Class="ColorVision.Engine.Services.Devices.Sensor.Templates.EditTemplateSensor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ColorVision.Engine.Services.Devices.Sensor.Templates"
             xmlns:sensor="clr-namespace:MQTTMessageLib.Sensor;assembly=cvColorVision"
             xmlns:properties="clr-namespace:ColorVision.Engine.Properties"
             mc:Ignorable="d" Foreground="{DynamicResource CV.Text.Primary}" Background="{DynamicResource CV.Surface.Window}" FontSize="13" d:DesignHeight="640" d:DesignWidth="800">
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource CV.Text.Primary}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource TextBox.Small}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="MinHeight" Value="30"/>
        </Style>
        <Style x:Key="CommandText" TargetType="TextBox" BasedOn="{StaticResource TextBox.Small}">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Height" Value="76"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <WrapPanel Margin="0,0,0,12">
            <StackPanel x:Name="CommandSelectionPanel" Orientation="Horizontal" Margin="0,0,16,4">
                <ComboBox x:Name="CommandSelector" MinWidth="70" SelectionChanged="CommandSelector_SelectionChanged"/>
                <TextBlock x:Name="CommandPosition" Margin="8,0,0,0" Foreground="{DynamicResource CV.Text.Secondary}"/>
            </StackPanel>
            <Button Content="{x:Static properties:Resources.AddCmd}" Command="{Binding CreateCommand}" Margin="0,0,8,4"/>
            <Button x:Name="DeleteCommandButton" Content="{x:Static properties:Resources.Sensor_DeleteCommand}" Click="Button_Del_Click" Margin="0,0,0,4"/>
        </WrapPanel>
        <TextBlock x:Name="EmptyState" Grid.Row="1" Text="{x:Static properties:Resources.Sensor_EmptyCommands}" TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,20" Foreground="{DynamicResource CV.Text.Secondary}"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="CommandForm" Margin="0,0,8,0">
                <Border Padding="14" Background="{DynamicResource CV.Surface.Control}" BorderBrush="{DynamicResource CV.Border.Control}" BorderThickness="1" CornerRadius="6">
                    <StackPanel>
                        <WrapPanel>
                            <TextBlock Text="{x:Static properties:Resources.CommandType}" Margin="0,0,12,0"/>
                            <ComboBox x:Name="ComboBoxType" Initialized="ComboBoxType_Initialized" SelectedItem="{Binding SensorCmdType}" MinWidth="130" Margin="0,0,8,0">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding}" Value="{x:Static sensor:SensorCmdType.None}">
                                                <Setter Property="IsEnabled" Value="False"/>
                                                <Setter Property="ToolTip" Value="{x:Static properties:Resources.Sensor_NoneHint}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>
                            <Button x:Name="ConvertButton" Content="{x:Static properties:Resources.Sensor_ConvertEncoding}" Click="ConvertButton_Click" ToolTip="{x:Static properties:Resources.Sensor_ConversionHint}">
                                <Button.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="Hex" Command="{Binding ConvertEncodingCommand}" CommandParameter="{x:Static sensor:SensorCmdType.Hex}"/>
                                        <Separator/>
                                        <MenuItem Header="ASCII" Command="{Binding ConvertEncodingCommand}" CommandParameter="{x:Static sensor:SensorCmdType.Ascii}"/>
                                        <MenuItem Header="UTF-8" Command="{Binding ConvertEncodingCommand}" CommandParameter="{x:Static sensor:SensorCmdType.UTF8}"/>
                                        <MenuItem Header="GBK" Command="{Binding ConvertEncodingCommand}" CommandParameter="{x:Static sensor:SensorCmdType.GBK}"/>
                                        <MenuItem Header="UTF-7" Command="{Binding ConvertEncodingCommand}" CommandParameter="{x:Static sensor:SensorCmdType.UTF7}"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </WrapPanel>
                        <TextBlock Text="{x:Static properties:Resources.Sensor_ConversionHint}" FontSize="12" Foreground="{DynamicResource CV.Text.Secondary}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <TextBlock Text="{x:Static properties:Resources.SendCmd}" Margin="0,14,0,6"/>
                        <TextBox x:Name="TextBoxSendCommand" Style="{StaticResource CommandText}" Text="{Binding Request, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="{x:Static properties:Resources.RevCmd}" Margin="0,12,0,6"/>
                        <TextBox x:Name="TextBoxResCommand" Style="{StaticResource CommandText}" Height="60" Text="{Binding Response, UpdateSourceTrigger=PropertyChanged}"/>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="{x:Static properties:Resources.TimeOut_Ms}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding Timeout, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock Text="{x:Static properties:Resources.DelayMs}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding Delay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{x:Static properties:Resources.RetryCount}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding RetryCount, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding ConvertStatus}" TextWrapping="Wrap" Foreground="{DynamicResource CV.Accent.Primary}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Expander Header="{x:Static properties:Resources.Sensor_ShowPreview}" Margin="0,10,0,0" IsExpanded="{Binding Source={x:Static local:EditTemplateSensor.Config}, Path=IsCommandPreviewVisible}">
                    <TextBox Text="{Binding PreviewText, Mode=OneWay}" IsReadOnly="True" Padding="10" Margin="0,6,0,0" MaxHeight="160" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" TextWrapping="Wrap"/>
                </Expander>
                <Expander Header="{x:Static properties:Resources.Sensor_BracketFormat}" Margin="0,8,0,0">
                    <StackPanel Margin="0,8,0,0">
                        <CheckBox Content="{x:Static properties:Resources.Sensor_UseControlCharacterNames}" IsChecked="{Binding Source={x:Static local:EditTemplateSensor.Config}, Path=UseControlNamesInBracketText}" Margin="0,0,0,8"/>
                        <TextBox Style="{StaticResource CommandText}" Text="{Binding BracketText, UpdateSourceTrigger=PropertyChanged}"/>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="{x:Static properties:Resources.Sensor_ConvertToRequest}" Command="{Binding BracketTextToRequestCommand}" Margin="0,0,6,6"/>
                            <Button Content="{x:Static properties:Resources.Sensor_ConvertToResponse}" Command="{Binding BracketTextToResponseCommand}" Margin="0,0,6,6"/>
                            <Button Content="{x:Static properties:Resources.Sensor_RequestEcho}" Command="{Binding RequestToBracketTextCommand}" Margin="0,0,6,6"/>
                            <Button Content="{x:Static properties:Resources.Sensor_ResponseEcho}" Command="{Binding ResponseToBracketTextCommand}" Margin="0,0,6,6"/>
                        </WrapPanel>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
        <Button Grid.Row="2" Content="{x:Static properties:Resources.Sensor_DeleteType}" HorizontalAlignment="Right" Margin="0,12,0,0" Click="DeleteType_Click"/>
    </Grid>
</UserControl>
