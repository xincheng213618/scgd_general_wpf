<UserControl x:Class="ColorVision.Engine.Services.Devices.Sensor.Templates.SensorTemplateCreatePreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:ColorVision.Engine"
             xmlns:local="clr-namespace:ColorVision.Engine.Services.Devices.Sensor.Templates"
             Foreground="{DynamicResource CV.Text.Primary}"
             Background="{DynamicResource CV.Surface.Window}">
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource CV.Text.Primary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="TextAlignment" Value="Left"/>
        </Style>
        <Style x:Key="ReadableCommand" TargetType="TextBox" BasedOn="{StaticResource TextBox.Small}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="MaxHeight" Value="100"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16,12">
            <StackPanel x:Name="DefaultGuidancePanel">
                <TextBlock x:Name="PresetTitle" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock x:Name="PurposeText" Margin="0,6,0,14"/>
                <Border Padding="12" Background="{DynamicResource CV.Surface.Control}" BorderBrush="{DynamicResource CV.Border.Control}" BorderThickness="1" CornerRadius="6">
                    <StackPanel>
                        <TextBlock Text="{i18n:EngineLang Key='用哪个模块'}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ModuleGuideText" Margin="0,5,0,12"/>
                        <TextBlock Text="{i18n:EngineLang Key='适用设备 / 协议'}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="DeviceGuideText" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel x:Name="EchoPanel" Margin="0,14,0,0">
                <TextBlock Text="{i18n:EngineLang Key='发送什么（可读指令）'}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="ReadableRequest" Style="{StaticResource ReadableCommand}" Text="{Binding RequestReadableText, Mode=OneWay}"/>
                <TextBlock Text="{i18n:EngineLang Key='预期返回什么'}" FontWeight="SemiBold" Margin="0,10,0,5"/>
                <TextBox x:Name="ReadableResponse" Style="{StaticResource ReadableCommand}" Text="{Binding ResponseReadableText, Mode=OneWay}"/>
                <TextBlock Margin="0,5,0,0" FontSize="11" Foreground="{DynamicResource CV.Text.Secondary}" Text="{i18n:EngineLang Key='[LF] = 换行， [CR] = 回车。图案文件名、大小写及结束符需与设备协议一致。'}"/>
            </StackPanel>
            <Expander x:Name="CommandEditorExpander" Header="{i18n:EngineLang Key='编辑指令与通信参数'}" Margin="0,14,0,0">
                <local:EditTemplateSensor x:Name="CommandEditor" Height="540"/>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
