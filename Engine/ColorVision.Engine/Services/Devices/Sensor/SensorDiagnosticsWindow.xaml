<Window x:Class="ColorVision.Engine.Services.Devices.Sensor.SensorDiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:ColorVision.Engine"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:local="clr-namespace:ColorVision.Engine.Services.Devices.Sensor.Local"
        Title="{i18n:EngineLang Key='本地传感器 · 通信调试'}" Width="1180" Height="720" MinWidth="960" MinHeight="580"
        Background="{DynamicResource GlobalBackground}" UseLayoutRounding="True" KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlobalBorderBrush1}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
        </Style>
        <Style x:Key="DirectionText" TargetType="TextBlock">
            <Setter Property="Text" Value="{Binding Direction}"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static local:LocalSensorDiagnosticKind.Sent}">
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static local:LocalSensorDiagnosticKind.Received}">
                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static local:LocalSensorDiagnosticKind.Error}">
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DetailBox" TargetType="TextBox" BasedOn="{StaticResource TextBox.Small}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="FontFamily" Value="Consolas, Microsoft YaHei UI"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="DeviceTitle" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ConnectionText" Margin="0,8,0,0" Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock x:Name="StatusText" HorizontalAlignment="Right" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock x:Name="CountText" Margin="0,8,0,0" Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="3*" MinWidth="510"/><ColumnDefinition Width="12"/><ColumnDefinition Width="2*" MinWidth="320"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TabControl x:Name="RecordTabs" SelectionChanged="Filter_Changed" Margin="0,0,0,10">
                        <TabItem Header="{i18n:EngineLang Key='收发消息'}"/><TabItem Header="{i18n:EngineLang Key='运行日志'}"/>
                    </TabControl>
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" Style="{StaticResource TextBox.Small}" hc:InfoElement.Placeholder="{i18n:EngineLang Key='搜索指令或消息内容'}" TextChanged="Search_Changed" ToolTip="{i18n:EngineLang Key='搜索指令、内容、地址或十六进制'}" AutomationProperties.Name="{i18n:EngineLang Key='搜索通信记录'}"/>
                        <ComboBox x:Name="DirectionFilter" Grid.Column="1" Margin="8,0" SelectedIndex="0" SelectionChanged="Filter_Changed" Style="{StaticResource ComboBox.Small}">
                            <ComboBoxItem Content="{i18n:EngineLang Key='全部'}"/><ComboBoxItem Content="{i18n:EngineLang Key='发送'}"/><ComboBoxItem Content="{i18n:EngineLang Key='接收'}"/>
                        </ComboBox>
                        <CheckBox x:Name="AutoScroll" Grid.Column="2" Content="{i18n:EngineLang Key='自动滚动'}" IsChecked="True" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button x:Name="ClearHistoryButton" Grid.Column="3" Content="{i18n:EngineLang Key='清空'}" Click="Clear_Click" ToolTip="{i18n:EngineLang Key='清空此设备的窗口记录，已写入的应用日志保留'}"/>
                    </Grid>
                    <Grid Grid.Row="2">
                        <DataGrid x:Name="MessageGrid" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single" SelectionUnit="FullRow"
                                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" HeadersVisibility="Column"
                                  EnableRowVirtualization="True" EnableColumnVirtualization="True" SelectionChanged="MessageGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{i18n:EngineLang Key='时间'}" Binding="{Binding Time, StringFormat=HH:mm:ss.fff}" Width="100"/>
                                <DataGridTemplateColumn Header="{i18n:EngineLang Key='方向'}" Width="Auto" MinWidth="70"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Style="{StaticResource DirectionText}" Margin="4,0"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTextColumn Header="{i18n:EngineLang Key='指令 / 事件'}" Binding="{Binding Label}" Width="150"/>
                                <DataGridTextColumn Header="{i18n:EngineLang Key='内容'}" Binding="{Binding Preview}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border x:Name="EmptyState" Background="{DynamicResource ButtonBackground}" IsHitTestVisible="False" Margin="1,30,1,1">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="EmptyTitle" Text="{i18n:EngineLang Key='暂无收发消息'}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="{i18n:EngineLang Key='运行传感器指令后，记录会自动显示在这里。'}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <TextBlock x:Name="VisibleCount" Grid.Row="3" Margin="0,8,0,0" Foreground="{DynamicResource SecondaryTextBrush}"/>
                </Grid>
            </Border>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" Background="Transparent"/>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="{i18n:EngineLang Key='消息详情'}" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="DetailMeta" Grid.Row="1" Margin="0,10,0,10" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Text="{i18n:EngineLang Key='选择一条记录查看可读回显、原文和字节内容。'}"/>
                    <WrapPanel Grid.Row="2" Margin="0,0,0,8">
                        <Button x:Name="CopyTextButton" Content="{i18n:EngineLang Key='复制原文'}" Click="CopyText_Click" IsEnabled="False" Margin="0,0,8,4"/>
                        <Button x:Name="CopyHexButton" Content="{i18n:EngineLang Key='复制 Hex'}" Click="CopyHex_Click" IsEnabled="False" Margin="0,0,8,4"/>
                        <CheckBox x:Name="FormatJson" Content="{i18n:EngineLang Key='格式化 JSON'}" IsChecked="True" Checked="Format_Changed" Unchecked="Format_Changed" VerticalAlignment="Center" Margin="0,0,0,4"/>
                    </WrapPanel>
                    <TabControl Grid.Row="3">
                        <TabItem Header="{i18n:EngineLang Key='可读回显'}"><TextBox x:Name="DetailText" Style="{StaticResource DetailBox}"/></TabItem>
                        <TabItem Header="{i18n:EngineLang Key='原文'}"><TextBox x:Name="DetailOriginalText" Style="{StaticResource DetailBox}"/></TabItem>
                        <TabItem Header="{i18n:EngineLang Key='十六进制'}"><TextBox x:Name="DetailHex" Style="{StaticResource DetailBox}"/></TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>
        <TextBlock Grid.Row="2" Margin="0,10,0,0" Foreground="{DynamicResource SecondaryTextBrush}" Text="{i18n:EngineLang Key='最近 500 条 · 控制字符如 0D/0A 显示为 [CR]/[LF] · 接收按分片记录，完整回包见运行日志 · Ctrl+F 搜索 · Ctrl+C 复制'}"/>
    </Grid>
</Window>
