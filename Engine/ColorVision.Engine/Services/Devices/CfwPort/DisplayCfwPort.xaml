<UserControl x:Class="ColorVision.Engine.Services.Devices.CfwPort.DisplayCfwPort"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:displayUi="clr-namespace:ColorVision.UI;assembly=ColorVision.UI"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i18n="clr-namespace:ColorVision.Engine"
             xmlns:local="clr-namespace:ColorVision.Engine.Services.Devices.CfwPort"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:properties="clr-namespace:ColorVision.Engine.Properties"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:DeviceCfwPort}"
             d:DesignWidth="300"
             ContextMenu="{Binding ContextMenu}"
             Initialized="UserControl_Initialized">
    <UserControl.Resources>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>
        <Style BasedOn="{StaticResource TextBox.Small}" TargetType="{x:Type TextBox}" />
    </UserControl.Resources>
    <StackPanel>
        <DockPanel Margin="0,0,5,0">
            <Button DockPanel.Dock="Right" Style="{DynamicResource ButtonProperty.OnDeviceRow}" Command="{Binding PropertyCommand}" ToolTip="{x:Static properties:Resources.Property}" />

            <displayUi:DisplayPinButton DockPanel.Dock="Right"/>

            <ToggleButton x:Name="DisplayHeaderToggle" Content="{Binding Config.Name}" FontSize="15" IsChecked="True" Style="{StaticResource ButtonPageControl1}" ToolTip="{Binding DService.DeviceStatus}" />
        </DockPanel>
        <Border x:Name="DisPlayBorder" Style="{DynamicResource BorderModuleArea}" Visibility="{Binding ElementName=DisplayHeaderToggle, Path=IsChecked, Converter={StaticResource bool2VisibilityConverter}}">
            <StackPanel Margin="5">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                        <DockPanel x:Name="TextBlockUnknow" HorizontalAlignment="Left">
                            <TextBlock HorizontalAlignment="Center" Text="{x:Static properties:Resources.UnknownStatus}" />
                        </DockPanel>
                        <DockPanel x:Name="ButtonUnauthorized" HorizontalAlignment="Left">
                            <Button Height="24" Command="{Binding EditCommand}" Content="{Binding LicenseFailureText}" />
                        </DockPanel>
                        <DockPanel x:Name="ButtonInit" HorizontalAlignment="Left">
                            <Button Height="24" Command="{Binding EditCommand}" Content="{x:Static properties:Resources.SetSnFirst}" />
                        </DockPanel>
                        <Button x:Name="ButtonOffline" HorizontalAlignment="Left" Height="24" Background="Red" Click="CameraOffline_Click" Content="{x:Static properties:Resources.DeviceOffline}" Foreground="White" Visibility="Collapsed" />
                        <Button x:Name="ButtonOpen" HorizontalAlignment="Left" Height="24" Click="Open_Click" Content="{x:Static properties:Resources.Connect}" />
                        <Button x:Name="ButtonClose" HorizontalAlignment="Left" Height="24" Click="Close_Click" Content="{x:Static properties:Resources.Close}" Visibility="Collapsed" />
                    </StackPanel>
                    <Button x:Name="ConfigureButton" DockPanel.Dock="Left" Margin="5,0,0,0" Width="24" Height="24" Padding="2" VerticalAlignment="Center" Command="{Binding EditCommand}" ToolTip="{x:Static properties:Resources.ModifyConfiguration}" AutomationProperties.Name="{x:Static properties:Resources.ModifyConfiguration}">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" HorizontalAlignment="Center"/>
                    </Button>
                    <TextBlock x:Name="OpeningPositionText" DockPanel.Dock="Left" Margin="8,0,0,0"
                               Text="{i18n:EngineLang Key='正在读取当前孔位…'}" Visibility="Collapsed" />
                </DockPanel>
                <StackPanel x:Name="PositionActions" Orientation="Horizontal" Margin="0,5,0,0" Visibility="Collapsed">
                    <ComboBox x:Name="CombPort" Width="88" Height="24" Style="{StaticResource ComboBox.Small}"
                              SelectedValuePath="HoleIndex" DisplayMemberPath="HoleName" SelectionChanged="TargetHole_SelectionChanged"
                              AutomationProperties.Name="{x:Static properties:Resources.FilterWheelSetPosition}"/>
                    <Button x:Name="SwitchPositionButton" Height="24" Margin="5,0,0,0" Click="SetPort_Click"
                            Content="{x:Static properties:Resources.Switch}"/>
                    <TextBlock x:Name="CurrentHoleText" Margin="12,0,0,0" MaxWidth="64" FontWeight="SemiBold" Text="—"/>
                    <Button x:Name="RefreshPositionButton" Margin="4,0,0,0" Width="24" Height="24" Padding="2"
                            Click="GetPort_Click" ToolTip="{x:Static properties:Resources.FilterWheelReadPosition}"
                            AutomationProperties.Name="{x:Static properties:Resources.FilterWheelReadPosition}">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" HorizontalAlignment="Center"/>
                    </Button>
                </StackPanel>

            </StackPanel>
        </Border>
    </StackPanel>

</UserControl>
