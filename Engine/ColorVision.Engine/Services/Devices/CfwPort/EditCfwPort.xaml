<Window x:Class="ColorVision.Engine.Services.Devices.CfwPort.EditCfwPort"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:ColorVision.Engine"
        xmlns:properties="clr-namespace:ColorVision.Engine.Properties"
        Title="{i18n:EngineLang Key='滤色轮配置'}" Width="620" Height="540" MinWidth="500" MinHeight="390"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource GlobalBackground}"
        SnapsToDevicePixels="True" UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ColorVision.Engine;component/Services/PhyCameras/PhyCameraConsoleStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="VisibleWhen"/>
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource GlobalBorderBrush1}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="16,10"/>
                <Setter Property="Margin" Value="0,0,4,10"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="16,14,16,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{i18n:EngineLang Key='设备与连接'}" Style="{StaticResource SectionTitleStyle}"/>
                        <StackPanel x:Name="ModeFields"/>
                        <StackPanel x:Name="ConnectionFields"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{i18n:EngineLang Key='孔位与读回'}" Style="{StaticResource SectionTitleStyle}"/>
                        <StackPanel x:Name="PositionFields"/>
                    </StackPanel>
                </Border>
                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding UseLocalCfwPort}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="{i18n:EngineLang Key='服务设置'}" Style="{StaticResource SectionTitleStyle}"/>
                        <StackPanel x:Name="LicenseFields"/>

                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <TextBlock Grid.Row="1" x:Name="StatusText" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,4,8"/>
        <Border Grid.Row="2" BorderBrush="{DynamicResource GlobalBorderBrush1}" BorderThickness="0,1,0,0" Padding="0,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{x:Static properties:Resources.OK}" Style="{StaticResource PrimaryToolbarButtonStyle}"
                            MinWidth="90" Height="34" IsDefault="True" Click="Ok_Click"/>
                    <Button Content="{x:Static properties:Resources.Cancel}" Style="{StaticResource ToolbarButtonStyle}"
                            MinWidth="90" Height="34" IsCancel="True" Margin="6,0,0,0"/>
                </StackPanel>
                <TextBlock Text="{i18n:EngineLang Key='修改连接参数后请重新连接。'}" VerticalAlignment="Center"
                           TextWrapping="Wrap" FontSize="12" Opacity="0.65" Margin="0,0,12,0"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
