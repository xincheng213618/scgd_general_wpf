<Page x:Class="ColorVision.Engine.MeasureBatchManagerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:ColorVision.Engine"
      xmlns:flow="clr-namespace:ColorVision.Engine.FlowProcessing"
      xmlns:properties="clr-namespace:ColorVision.Engine.Properties"
      xmlns:sorts="clr-namespace:ColorVision.UI.Sorts;assembly=ColorVision.UI"
      xmlns:postProcess="clr-namespace:ColorVision.Engine.FlowProcessing.PostProcess"
      Title="{local:EngineLang 流程结果管理}" Background="{DynamicResource GlobalBackground}"
      Foreground="{DynamicResource GlobalTextBrush}" UseLayoutRounding="True"
      Loaded="Page_Loaded" Unloaded="Page_Unloaded" Initialized="UserControl_Initialized">
    <Page.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="SummaryValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>
        <postProcess:TypeNameConverter x:Key="TypeNameConverter"/>
        <postProcess:ProcessTooltipConverter x:Key="ProcessTooltipConverter"/>
    </Page.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{x:Static properties:Resources.ArchiveAll}" Click="Save_Click" Padding="12,6" Margin="0,0,8,0"/>
                <Button Content="{local:EngineLang 查询设置}" Command="{Binding Config.EditCommand}" Padding="12,6"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{local:EngineLang 流程结果管理}" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="{local:EngineLang 查看批次记录、执行详情与后处理}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>
        <UniformGrid Grid.Row="1" Columns="4" Margin="-4,0,-4,12">
            <Border Style="{StaticResource Card}" Margin="4,0"><StackPanel>
                <TextBlock Text="{local:EngineLang 本次查询}" Style="{StaticResource Caption}"/>
                <TextBlock x:Name="LoadedCountText" Text="0" Style="{StaticResource SummaryValue}"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="4,0"><StackPanel>
                <TextBlock Text="{local:EngineLang 已完成}" Style="{StaticResource Caption}"/>
                <TextBlock x:Name="CompletedCountText" Text="0" Style="{StaticResource SummaryValue}"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="4,0"><StackPanel>
                <TextBlock Text="{local:EngineLang 失败 / 超时}" Style="{StaticResource Caption}"/>
                <TextBlock x:Name="FailedCountText" Text="0" Style="{StaticResource SummaryValue}"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="4,0"><StackPanel>
                <TextBlock Text="{local:EngineLang 平均耗时（已完成 / 秒）}" Style="{StaticResource Caption}"/>
                <TextBlock x:Name="AverageTimeText" Text="—" Style="{StaticResource SummaryValue}"/>
            </StackPanel></Border>
        </UniformGrid>
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="12">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid x:Name="QueryControls">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox x:Name="SearchBox" MinHeight="34" VerticalContentAlignment="Center" Padding="10,4"
                                 KeyDown="KeyEnter" TextChanged="SearchBox_TextChanged" InputMethod.IsInputMethodEnabled="True"
                                 ToolTip="{local:EngineLang 输入完整批次编号，按 Enter 查询}"/>
                        <TextBlock Text="{local:EngineLang 输入完整批次编号，按 Enter 查询}" IsHitTestVisible="False" Margin="12,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style></TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="{x:Static properties:Resources.Search}" Click="Query_Click" Margin="8,0,0,0" Padding="16,5" IsDefault="False"/>
                        <Button Content="{local:EngineLang 重置}" Click="ResetQuery_Click" Margin="8,0,0,0" Padding="12,5"/>
                        <Button Content="{x:Static properties:Resources.AdvanceSearch}" Click="AdvanceQuery_Click" Margin="8,0,0,0" Padding="12,5"/>
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="QueryStatusText" Grid.Row="1" Margin="0,8,0,0" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
            </Grid>
        </Border>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="450"/><ColumnDefinition Width="10"/><ColumnDefinition Width="360" MinWidth="300"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <ListView x:Name="listView1" SelectionMode="Single" SelectionChanged="listView1_SelectionChanged" Background="Transparent" BorderThickness="0"
                              MouseDoubleClick="listView1_MouseDoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListView.Resources><ContextMenu x:Key="ItemContextMenu" Opened="ContextMenu_Opened"/></ListView.Resources>
                        <ListView.ItemContainerStyle><Style TargetType="ListViewItem" BasedOn="{StaticResource ListViewItemBaseStyle.Small}">
                            <Setter Property="ContextMenu" Value="{Binding ContextMenu}"/>
                            <Setter Property="MinHeight" Value="32"/>
                        </Style></ListView.ItemContainerStyle>
                        <ListView.View><GridView>
                            <GridView.ColumnHeaderContainerStyle><Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource InputElementBaseStyle}">
                                <Setter Property="Visibility" Value="Visible"/><Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                <Setter Property="Padding" Value="8"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
                                <Setter Property="ContextMenu" Value="{StaticResource ItemContextMenu}"/><EventSetter Event="Click" Handler="GridViewColumnSort"/>
                            </Style></GridView.ColumnHeaderContainerStyle>
                            <GridViewColumn Header="{x:Static properties:Resources.SerialNumber1}" Width="60" DisplayMemberBinding="{Binding MeasureBatchModel.Id}"/>
                            <GridViewColumn Header="{local:EngineLang 批次编号}" Width="225"><GridViewColumn.CellTemplate><DataTemplate>
                                <TextBlock Text="{Binding MeasureBatchModel.Code}" Style="{StaticResource CellText}"/>
                            </DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                            <GridViewColumn Header="{local:EngineLang 流程模板}" Width="140"><GridViewColumn.CellTemplate><DataTemplate>
                                <TextBlock Text="{Binding TemplateName}" Style="{StaticResource CellText}"/>
                            </DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                            <GridViewColumn Header="{local:EngineLang 状态}" Width="80" sorts:SortableExtension.SortMemberPath="MeasureBatchModel.FlowStatus"><GridViewColumn.CellTemplate><DataTemplate>
                                <DockPanel>
                                    <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center"><Ellipse.Style><Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource SecondaryTextBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MeasureBatchModel.FlowStatus}" Value="{x:Static flow:FlowStatus.Completed}"><Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding MeasureBatchModel.FlowStatus}" Value="{x:Static flow:FlowStatus.Failed}"><Setter Property="Fill" Value="{DynamicResource DangerBrush}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding MeasureBatchModel.FlowStatus}" Value="{x:Static flow:FlowStatus.OverTime}"><Setter Property="Fill" Value="{DynamicResource WarningBrush}"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style></Ellipse.Style></Ellipse>
                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource CellText}"/>
                                </DockPanel>
                            </DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                            <GridViewColumn Header="{local:EngineLang 耗时（秒）}" Width="100" DisplayMemberBinding="{Binding DurationSeconds, StringFormat={}{0:0.###}}"/>
                            <GridViewColumn Header="{x:Static properties:Resources.CreateTime}" Width="165" DisplayMemberBinding="{Binding MeasureBatchModel.CreateDate, StringFormat=yyyy/MM/dd HH:mm:ss}"/>
                            <GridViewColumn Header="{local:EngineLang 结果信息}" Width="230"><GridViewColumn.CellTemplate><DataTemplate>
                                <TextBlock Text="{Binding MeasureBatchModel.Result}" Style="{StaticResource CellText}"/>
                            </DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                        </GridView></ListView.View>
                    </ListView>
                    <StackPanel x:Name="EmptyStatePanel" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed">
                        <TextBlock Text="{local:EngineLang 暂无批次记录}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{local:EngineLang 可重置查询条件，或使用高级查询查找历史记录}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="16,8"/>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="{local:EngineLang 双击打开测量结果 · 右键查看更多操作}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="12,8"/>
                </Grid>
            </Border>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" Background="Transparent"/>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="{local:EngineLang 当前批次}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SelectedBatchText" Text="{x:Static properties:Resources.Flow_MeasureBatch_NotSelected}" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                    <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
                        <TabItem Header="{local:EngineLang 批次详情}">
                            <Grid Margin="0,10,0,0">
                                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="BatchDetailsPanel" DataContext="{Binding SelectedItem, ElementName=listView1}">
                                        <TextBlock Text="{local:EngineLang 流程模板}" Style="{StaticResource Caption}"/>
                                        <TextBlock Text="{Binding TemplateName, TargetNullValue=—}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                                        <TextBlock Text="{local:EngineLang 状态 / 耗时（秒）}" Style="{StaticResource Caption}"/>
                                        <TextBlock Margin="0,0,0,14"><Run Text="{Binding StatusText, Mode=OneWay, TargetNullValue=—}"/><Run Text="  /  "/><Run Text="{Binding DurationSeconds, Mode=OneWay, StringFormat={}{0:0.###}, TargetNullValue=—}"/></TextBlock>
                                        <TextBlock Text="{x:Static properties:Resources.CreateTime}" Style="{StaticResource Caption}"/>
                                        <TextBlock Text="{Binding MeasureBatchModel.CreateDate, StringFormat=yyyy/MM/dd HH:mm:ss, TargetNullValue=—}" Margin="0,0,0,14"/>
                                        <TextBlock Text="{local:EngineLang 结果信息}" Style="{StaticResource Caption}"/>
                                        <TextBox Text="{Binding MeasureBatchModel.Result, Mode=OneWay, TargetNullValue=—}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0" MinHeight="60"/>
                                    </StackPanel>
                                </ScrollViewer>
                                <UniformGrid Grid.Row="1" Columns="2" Margin="0,12,0,0">
                                    <Button x:Name="OpenResultButton" Content="{local:EngineLang 测量结果}" Click="OpenResult_Click" Margin="0,0,4,0" IsEnabled="False" Padding="8,6"/>
                                    <Button x:Name="OpenAnalysisButton" Content="{local:EngineLang 执行分析}" Click="OpenAnalysis_Click" Margin="4,0,0,0" IsEnabled="False" Padding="8,6"/>
                                </UniformGrid>
                            </Grid>
                        </TabItem>
                        <TabItem Header="{local:EngineLang 后处理}">
                            <Grid Margin="0,10,0,0">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="{x:Static properties:Resources.Flow_MeasureBatch_SelectProcessType}" Style="{StaticResource Caption}"/>
                                    <ComboBox x:Name="ProcessComboBox" SelectionChanged="ProcessComboBox_SelectionChanged" MinHeight="32">
                                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource TypeNameConverter}}" ToolTip="{Binding Converter={StaticResource ProcessTooltipConverter}}"/></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"><StackPanel x:Name="ProcessConfigPanel"/></ScrollViewer>
                                <Button Grid.Row="2" x:Name="ExecuteButton" Content="{x:Static properties:Resources.Flow_MeasureBatch_ExecutePostProcess}" Height="36" Margin="0,12,0,0" Click="ExecuteProcess_Click" IsEnabled="False"/>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
