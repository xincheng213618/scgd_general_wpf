<Window x:Class="ColorVision.Engine.FlowProcessing.PreProcess.PreProcessTypeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:properties="clr-namespace:ColorVision.Engine.Properties"
        Title="{x:Static properties:Resources.Flow_PreProcess_AddAction}"
        Width="560" Height="380" MinWidth="480" MinHeight="340"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource GlobalBackground}"
        Foreground="{DynamicResource GlobalTextBrush}"
        FocusManager.FocusedElement="{Binding ElementName=ProcessTypesList}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{x:Static properties:Resources.Flow_PreProcess_ChooseActionHint}"
                   TextWrapping="Wrap" Opacity="0.72" Margin="0,0,0,16"/>

        <ListBox x:Name="ProcessTypesList" Grid.Row="1"
                 ItemsSource="{Binding AvailableProcessTypes}"
                 SelectedItem="{Binding SelectedProcessType}"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 AutomationProperties.Name="{x:Static properties:Resources.Flow_PreProcess_Actions}">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Margin" Value="0,0,0,10"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Card" Padding="16,14" BorderThickness="2"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        Background="{DynamicResource GlobalBackground}"
                                        CornerRadius="{DynamicResource ControlCornerRadius}">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Card" Property="Background" Value="{DynamicResource GlobalBorderBrush1}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                        <Setter TargetName="Card" Property="Background" Value="{DynamicResource GlobalBorderBrush1}"/>
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource GlobalTextBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Description}" Margin="0,6,0,0" Opacity="0.72"
                                   Foreground="{DynamicResource GlobalTextBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="ConfirmAddButton" Content="{x:Static properties:Resources.Add}"
                    MinWidth="90" Padding="18,6" IsDefault="True" Click="AddButton_Click"
                    Background="{DynamicResource PrimaryBrush}" BorderBrush="{DynamicResource PrimaryBrush}" Foreground="White">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedItem, ElementName=ProcessTypesList}" Value="{x:Null}">
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="{x:Static properties:Resources.Cancel}" MinWidth="90" Padding="18,6" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
