<Page x:Class="ColorVision.Engine.FlowProcessing.Diagnostics.FlowNodeAnalysisPage"
      x:ClassModifier="internal"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      d:DesignHeight="760"
      d:DesignWidth="1320"
      Background="{DynamicResource GlobalBackground}"
      Loaded="Page_Loaded"
      Unloaded="Page_Unloaded">
    <Page.Resources>
        <SolidColorBrush x:Key="AnalysisSuccessBrush" Color="#2E9D66"/>
        <SolidColorBrush x:Key="AnalysisRunningBrush" Color="#D99000"/>
        <SolidColorBrush x:Key="AnalysisWarningBrush" Color="#D84A4A"/>

        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="AnalysisCardStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <Style x:Key="MetricLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="MetricValueStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="PrimaryActionButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="MinHeight" Value="30"/>
        </Style>

        <Style x:Key="BreadcrumbButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CompactInfoLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
        </Style>
    </Page.Resources>

    <Grid Margin="16,12,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="执行概览"
                            Style="{StaticResource BreadcrumbButtonStyle}"
                            Click="ShowOverviewButton_Click"/>
                    <TextBlock Text="  /  " Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="节点分析" Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>
                <TextBlock x:Name="NodeTitleText"
                           Margin="0,7,0,0"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Text="节点"/>
                <TextBlock x:Name="NodeSubtitleText"
                           Margin="0,3,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="—"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button x:Name="PreviousNodeButton"
                        Content="上一个节点"
                        Padding="10,5"
                        Margin="0,0,6,0"
                        Click="PreviousNodeButton_Click"/>
                <Button x:Name="NextNodeButton"
                        Content="下一个节点"
                        Padding="10,5"
                        Margin="0,0,12,0"
                        Click="NextNodeButton_Click"/>
                <Button x:Name="LocateFlowNodeButton"
                        Content="定位到流程图"
                        Padding="10,5"
                        Margin="0,0,6,0"
                        Click="LocateFlowNodeButton_Click"/>
                <Button Content="返回执行概览"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        Click="ShowOverviewButton_Click"/>
            </StackPanel>
        </Grid>

        <UniformGrid Grid.Row="1" Columns="4" Margin="0,14,0,12">
            <Border Style="{StaticResource AnalysisCardStyle}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="本次耗时" Style="{StaticResource MetricLabelStyle}"/>
                    <TextBlock x:Name="NodeElapsedText" Text="—" Style="{StaticResource MetricValueStyle}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource AnalysisCardStyle}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="节点工作量占比" Style="{StaticResource MetricLabelStyle}"/>
                    <TextBlock x:Name="NodeShareText" Text="—" Style="{StaticResource MetricValueStyle}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource AnalysisCardStyle}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="最近平均" Style="{StaticResource MetricLabelStyle}"/>
                    <TextBlock x:Name="NodeHistoryAverageText" Text="加载中…" Style="{StaticResource MetricValueStyle}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource AnalysisCardStyle}">
                <StackPanel>
                    <TextBlock Text="最近 P95" Style="{StaticResource MetricLabelStyle}"/>
                    <TextBlock x:Name="NodeHistoryP95Text" Text="加载中…" Style="{StaticResource MetricValueStyle}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="640"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="360" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource AnalysisCardStyle}" Padding="12,9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="批次" Style="{StaticResource CompactInfoLabelStyle}"/>
                            <TextBlock x:Name="NodeBatchText" Margin="0,0,18,0"/>
                            <TextBlock Text="类型" Style="{StaticResource CompactInfoLabelStyle}"/>
                            <TextBlock x:Name="NodeTypeText" Margin="0,0,18,0"/>
                            <TextBlock Text="开始" Style="{StaticResource CompactInfoLabelStyle}"/>
                            <TextBlock x:Name="NodeStartTimeText" Margin="0,0,18,0"/>
                            <TextBlock Text="结束" Style="{StaticResource CompactInfoLabelStyle}"/>
                            <TextBlock x:Name="NodeEndTimeText" Margin="0,0,18,0"/>
                            <TextBlock Text="SN" Style="{StaticResource CompactInfoLabelStyle}"/>
                            <TextBlock x:Name="NodeSerialNumberText"
                                       MaxWidth="230"
                                       TextTrimming="CharacterEllipsis"/>
                        </WrapPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Margin="16,0,0,0">
                            <TextBlock Text="状态" Style="{StaticResource CompactInfoLabelStyle}"/>
                            <TextBlock x:Name="NodeStateText" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource AnalysisCardStyle}" Padding="0">
                    <Grid Margin="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="190" MinHeight="130"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="本次节点消息" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock x:Name="MessageSummaryText"
                                           Margin="0,3,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="0 条消息"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="进入完整消息页"
                                    Padding="12,5"
                                    VerticalAlignment="Center"
                                    Click="OpenMessagesButton_Click"/>
                        </Grid>

                        <TextBlock x:Name="MessageEmptyText"
                                   Grid.Row="1"
                                   Grid.RowSpan="2"
                                   Margin="12,30,12,12"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="本次执行没有记录消息。&#x0a;本地节点可能直接在进程内执行，不经过 MQTT；也可能尚未产生可追踪消息。"
                                   Visibility="Collapsed"/>

                        <ListView x:Name="MessageListView"
                                  Grid.Row="2"
                                  Margin="0,10,0,0"
                                  Background="Transparent"
                                  BorderThickness="1"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.CanContentScroll="True"
                                  SelectionChanged="MessageListView_SelectionChanged"
                                  MouseDoubleClick="MessageListView_MouseDoubleClick">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="{x:Type ListViewItem}" BasedOn="{StaticResource ListViewItemBaseStyle.Small}"/>
                            </ListView.ItemContainerStyle>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="EventName" Width="140" DisplayMemberBinding="{Binding EventName}"/>
                                    <GridViewColumn Header="发送时间" Width="130">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding SendTime, StringFormat=HH:mm:ss.fff}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="接收时间" Width="130">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding RecvTime, StringFormat=HH:mm:ss.fff}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="耗时(ms)" Width="90" DisplayMemberBinding="{Binding ElapsedMs}"/>
                                    <GridViewColumn Header="状态" Width="90" DisplayMemberBinding="{Binding State}"/>
                                    <GridViewColumn Header="状态消息" Width="220" DisplayMemberBinding="{Binding StatusMessage}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border BorderBrush="{DynamicResource ButtonBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="发送 Payload" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="SendTopicText"
                                               Grid.Row="1"
                                               Margin="0,4,0,7"
                                               FontSize="11"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Text="选择一条消息查看 Topic 与 Payload"/>
                                    <TextBox x:Name="SendPayloadTextBox"
                                             Grid.Row="2"
                                             IsReadOnly="True"
                                             Background="{DynamicResource GlobalBackground}"
                                             BorderThickness="0"
                                             FontFamily="Consolas"
                                             FontSize="12"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2"
                                    BorderBrush="{DynamicResource ButtonBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="接收 Payload" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="RecvTopicText"
                                               Grid.Row="1"
                                               Margin="0,4,0,7"
                                               FontSize="11"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Text="选择一条消息查看 Topic 与 Payload"/>
                                    <TextBox x:Name="RecvPayloadTextBox"
                                             Grid.Row="2"
                                             IsReadOnly="True"
                                             Background="{DynamicResource GlobalBackground}"
                                             BorderThickness="0"
                                             FontFamily="Consolas"
                                             FontSize="12"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Column="2" Style="{StaticResource AnalysisCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="最近执行历史" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock x:Name="NodeHistoryHintText"
                               Grid.Row="1"
                               Margin="0,4,0,10"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="正在加载该节点最近的执行记录…"
                               TextWrapping="Wrap"/>

                    <ListView x:Name="NodeHistoryListView"
                              Grid.Row="2"
                              Background="Transparent"
                              BorderThickness="0">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="{x:Type ListViewItem}" BasedOn="{StaticResource ListViewItemBaseStyle.Small}"/>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Batch" Width="62" DisplayMemberBinding="{Binding BatchId}"/>
                                <GridViewColumn Header="开始时间" Width="142">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StartTime, StringFormat=MM/dd HH:mm:ss.fff}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="耗时(ms)" Width="82" DisplayMemberBinding="{Binding ElapsedMs}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <Border Grid.Row="3"
                            Margin="0,10,0,0"
                            Padding="0,9,0,0"
                            BorderBrush="{DynamicResource ButtonBorderBrush}"
                            BorderThickness="0,1,0,0">
                        <StackPanel>
                            <TextBlock Text="NodeId" Style="{StaticResource MetricLabelStyle}"/>
                            <TextBlock x:Name="NodeIdText"
                                       Margin="0,3,0,0"
                                       FontSize="11"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
