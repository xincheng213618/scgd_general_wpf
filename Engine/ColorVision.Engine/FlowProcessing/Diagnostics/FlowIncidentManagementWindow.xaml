<Window x:Class="ColorVision.Engine.FlowProcessing.Diagnostics.FlowIncidentManagementWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:engine="clr-namespace:ColorVision.Engine"
        Title="{engine:EngineLang Key='流程 Incident 管理'}"
        Width="1460"
        Height="860"
        MinWidth="1120"
        MinHeight="680"
        Background="{DynamicResource GlobalBackground}"
        Initialized="Window_Initialized">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Padding="10"
                Background="{DynamicResource ButtonBackground}"
                BorderBrush="{DynamicResource ButtonBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock VerticalAlignment="Center" Text="{engine:EngineLang Key='状态'}"/>
                <ComboBox x:Name="StateFilterComboBox"
                          Grid.Column="1"
                          Margin="6,0,12,0"
                          SelectedIndex="0">
                    <ComboBoxItem Content="{engine:EngineLang Key='待处置'}" Tag="Active"/>
                    <ComboBoxItem Content="{engine:EngineLang Key='未确认'}" Tag="Open"/>
                    <ComboBoxItem Content="{engine:EngineLang Key='已确认'}" Tag="Acknowledged"/>
                    <ComboBoxItem Content="{engine:EngineLang Key='已关闭'}" Tag="Resolved"/>
                    <ComboBoxItem Content="{engine:EngineLang Key='全部'}" Tag="All"/>
                </ComboBox>

                <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{engine:EngineLang Key='严重级别'}"/>
                <TextBox x:Name="SeverityFilterTextBox"
                         Grid.Column="3"
                         Margin="6,0,12,0"
                         ToolTip="{engine:EngineLang Key='留空表示全部；例如 Error、Warning'}"/>

                <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="{engine:EngineLang Key='类型'}"/>
                <TextBox x:Name="KindFilterTextBox"
                         Grid.Column="5"
                         Margin="6,0,12,0"
                         ToolTip="{engine:EngineLang Key='留空表示全部；例如 NodeFailure'}"/>

                <TextBlock Grid.Column="6" VerticalAlignment="Center" Text="{engine:EngineLang Key='搜索'}"/>
                <TextBox x:Name="SearchTextBox"
                         Grid.Column="7"
                         Margin="6,0,12,0"
                         ToolTip="{engine:EngineLang Key='搜索摘要、节点 ID 和详细信息'}"
                         KeyDown="SearchTextBox_KeyDown"/>
                <Button Grid.Column="8"
                        MinWidth="74"
                        Padding="12,5"
                        Content="{engine:EngineLang Key='刷新'}"
                        Click="RefreshButton_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,10,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.08*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="1.42*"/>
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="IncidentDataGrid"
                      Grid.Column="0"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionChanged="IncidentDataGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{engine:EngineLang Key='发现时间 (UTC)'}"
                                        Binding="{Binding DetectedTimeUtc, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                        Width="145"/>
                    <DataGridTextColumn Header="{engine:EngineLang Key='状态'}" Binding="{Binding State}" Width="90"/>
                    <DataGridTextColumn Header="{engine:EngineLang Key='级别'}" Binding="{Binding Severity}" Width="80"/>
                    <DataGridTextColumn Header="{engine:EngineLang Key='流程'}" Binding="{Binding FlowName}" Width="130"/>
                    <DataGridTextColumn Header="{engine:EngineLang Key='摘要'}" Binding="{Binding Summary}" Width="*"/>
                    <DataGridTextColumn Header="Run ID" Binding="{Binding RunRecordId}" Width="74"/>
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Column="1"
                          Width="8"
                          HorizontalAlignment="Stretch"
                          ResizeDirection="Columns"/>

            <Border Grid.Column="2"
                    Padding="12"
                    BorderBrush="{DynamicResource ButtonBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock FontWeight="SemiBold" Text="Incident"/>
                        <TextBlock Grid.Column="1"
                                   Margin="8,0,12,4"
                                   Text="{Binding Incident.Id, TargetNullValue=—}"/>
                        <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="Run"/>
                        <TextBlock Grid.Column="3"
                                   Margin="8,0,0,4"
                                   Text="{Binding Incident.RunRecordId, TargetNullValue=—}"/>

                        <TextBlock Grid.Row="1" FontWeight="SemiBold" Text="FlowKey"/>
                        <TextBox Grid.Row="1"
                                 Grid.Column="1"
                                 Grid.ColumnSpan="3"
                                 Margin="8,0,0,4"
                                 IsReadOnly="True"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Text="{Binding Run.FlowKey, TargetNullValue=—}"/>

                        <TextBlock Grid.Row="2" FontWeight="SemiBold" Text="RunKey"/>
                        <TextBox Grid.Row="2"
                                 Grid.Column="1"
                                 Grid.ColumnSpan="3"
                                 Margin="8,0,0,4"
                                 IsReadOnly="True"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Text="{Binding Run.RunKey, TargetNullValue=—}"/>

                        <TextBlock Grid.Row="3" FontWeight="SemiBold" Text="{engine:EngineLang Key='流程'}"/>
                        <TextBlock Grid.Row="3"
                                   Grid.Column="1"
                                   Margin="8,0,12,4"
                                   Text="{Binding Run.FlowName, TargetNullValue=—}"/>
                        <TextBlock Grid.Row="3" Grid.Column="2" FontWeight="SemiBold" Text="{engine:EngineLang Key='节点'}"/>
                        <TextBlock Grid.Row="3"
                                   Grid.Column="3"
                                   Margin="8,0,0,4"
                                   Text="{Binding Incident.NodeId, TargetNullValue=—}"/>

                        <TextBlock Grid.Row="4" FontWeight="SemiBold" Text="{engine:EngineLang Key='批次 / SN'}"/>
                        <StackPanel Grid.Row="4"
                                    Grid.Column="1"
                                    Grid.ColumnSpan="3"
                                    Margin="8,0,0,4"
                                    Orientation="Horizontal">
                            <TextBlock Text="{Binding Run.BatchId, TargetNullValue=—}"/>
                            <TextBlock Margin="8,0,8,0" Text="/"/>
                            <TextBlock Text="{Binding Run.SerialNumber, TargetNullValue=—}"/>
                        </StackPanel>

                        <TextBlock Grid.Row="5" FontWeight="SemiBold" Text="{engine:EngineLang Key='摘要'}"/>
                        <TextBlock Grid.Row="5"
                                   Grid.Column="1"
                                   Grid.ColumnSpan="3"
                                   Margin="8,0,0,4"
                                   TextWrapping="Wrap"
                                   Text="{Binding Incident.Summary, TargetNullValue=—}"/>
                    </Grid>

                    <StackPanel Grid.Row="1"
                                Margin="0,8,0,8"
                                Orientation="Horizontal">
                        <Button x:Name="OpenRunAnalysisButton"
                                Padding="10,5"
                                Content="{engine:EngineLang Key='打开运行分析'}"
                                Click="OpenRunAnalysisButton_Click"/>
                        <Button x:Name="LocateFlowNodeButton"
                                Margin="6,0,0,0"
                                Padding="10,5"
                                Content="{engine:EngineLang Key='定位当前画布节点'}"
                                Click="LocateFlowNodeButton_Click"/>
                        <Button Margin="6,0,0,0"
                                Padding="10,5"
                                Content="{engine:EngineLang Key='复制稳定标识'}"
                                Click="CopyIdentifiersButton_Click"/>
                    </StackPanel>

                    <TabControl Grid.Row="2">
                        <TabItem Header="{engine:EngineLang Key='详情'}">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock FontWeight="SemiBold" Text="{engine:EngineLang Key='确认信息'}"/>
                                <StackPanel Grid.Row="1"
                                            Margin="0,4,0,2"
                                            Orientation="Horizontal">
                                    <TextBlock Text="{Binding Incident.AcknowledgedTimeUtc, StringFormat={}{0:yyyy-MM-dd HH:mm:ss} UTC, TargetNullValue=—}"/>
                                    <TextBlock Margin="10,0,0,0"
                                               Text="{Binding Incident.AcknowledgedOperator, TargetNullValue=—}"/>
                                </StackPanel>
                                <TextBlock Grid.Row="2"
                                           Margin="0,0,0,8"
                                           TextWrapping="Wrap"
                                           Text="{Binding Incident.AcknowledgmentNote, TargetNullValue={engine:EngineLang 尚未确认}}"/>
                                <TextBlock Grid.Row="3" FontWeight="SemiBold" Text="{engine:EngineLang Key='关闭信息'}"/>
                                <StackPanel Grid.Row="4"
                                            Margin="0,4,0,2"
                                            Orientation="Horizontal">
                                    <TextBlock Text="{Binding Incident.ResolvedTimeUtc, StringFormat={}{0:yyyy-MM-dd HH:mm:ss} UTC, TargetNullValue=—}"/>
                                    <TextBlock Margin="10,0,0,0"
                                               Text="{Binding Incident.OperatorName, TargetNullValue=—}"/>
                                </StackPanel>
                                <TextBox Grid.Row="5"
                                         Margin="0,4,0,0"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         Text="{Binding Incident.Resolution, TargetNullValue={engine:EngineLang 尚未关闭}}"/>
                            </Grid>
                        </TabItem>
                        <TabItem Header="{engine:EngineLang Key='运行事件'}">
                            <DataGrid x:Name="EventDataGrid"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding SequenceNo}" Width="48"/>
                                    <DataGridTextColumn Header="{engine:EngineLang Key='时间 (UTC)'}"
                                                        Binding="{Binding OccurredTimeUtc, StringFormat={}{0:yyyy-MM-dd HH:mm:ss.fff}}"
                                                        Width="170"/>
                                    <DataGridTextColumn Header="{engine:EngineLang Key='类型'}" Binding="{Binding EventType}" Width="135"/>
                                    <DataGridTextColumn Header="{engine:EngineLang Key='节点'}" Binding="{Binding NodeId}" Width="140"/>
                                    <DataGridTextColumn Header="{engine:EngineLang Key='消息'}" Binding="{Binding Message}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="{engine:EngineLang Key='节点尝试'}">
                            <DataGrid x:Name="AttemptDataGrid"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding AttemptNo}" Width="48"/>
                                    <DataGridTextColumn Header="{engine:EngineLang Key='节点'}" Binding="{Binding NodeId}" Width="150"/>
                                    <DataGridTextColumn Header="{engine:EngineLang Key='开始 (UTC)'}"
                                                        Binding="{Binding StartedTimeUtc, StringFormat={}{0:yyyy-MM-dd HH:mm:ss.fff}}"
                                                        Width="170"/>
                                    <DataGridTextColumn Header="{engine:EngineLang Key='结果'}" Binding="{Binding Outcome}" Width="100"/>
                                    <DataGridTextColumn Header="{engine:EngineLang Key='错误码'}" Binding="{Binding ErrorCode}" Width="120"/>
                                    <DataGridTextColumn Header="{engine:EngineLang Key='错误'}" Binding="{Binding ErrorMessage}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="{engine:EngineLang Key='原始信息'}">
                            <TextBox Margin="8"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Text="{Binding Incident.DetailsJson}"/>
                        </TabItem>
                    </TabControl>

                    <Border Grid.Row="3"
                            Margin="0,10,0,0"
                            Padding="10"
                            Background="{DynamicResource ButtonBackground}"
                            CornerRadius="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="{engine:EngineLang Key='操作人'}"/>
                            <TextBox x:Name="OperatorTextBox"
                                     Grid.Column="1"
                                     Margin="6,0,12,0"/>
                            <TextBlock Grid.Column="2"
                                       VerticalAlignment="Center"
                                       Text="{engine:EngineLang Key='备注'}"/>
                            <TextBox x:Name="ActionNoteTextBox"
                                     Grid.Column="3"
                                     Margin="6,0,12,0"
                                     ToolTip="{engine:EngineLang Key='确认备注可选；关闭备注必填'}"/>
                            <Button x:Name="AcknowledgeButton"
                                    Grid.Column="4"
                                    Padding="12,5"
                                    Content="{engine:EngineLang Key='确认'}"
                                    Click="AcknowledgeButton_Click"/>
                            <Button x:Name="ResolveButton"
                                    Grid.Column="5"
                                    Margin="6,0,0,0"
                                    Padding="12,5"
                                    Content="{engine:EngineLang Key='关闭'}"
                                    Click="ResolveButton_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="PageStatusText"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource SecondaryTextBrush}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="PreviousPageButton"
                        MinWidth="72"
                        Padding="10,4"
                        Content="{engine:EngineLang Key='上一页'}"
                        Click="PreviousPageButton_Click"/>
                <Button x:Name="NextPageButton"
                        MinWidth="72"
                        Margin="6,0,0,0"
                        Padding="10,4"
                        Content="{engine:EngineLang Key='下一页'}"
                        Click="NextPageButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
