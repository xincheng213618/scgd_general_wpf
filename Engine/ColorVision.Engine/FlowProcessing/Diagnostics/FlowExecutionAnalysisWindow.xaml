<Window x:Class="ColorVision.Engine.FlowProcessing.Diagnostics.FlowExecutionAnalysisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="流程执行分析"
        Width="1480"
        Height="900"
        MinWidth="1100"
        MinHeight="700"
        Background="{DynamicResource GlobalBackground}"
        Initialized="Window_Initialized">
    <Window.Resources>
        <Style x:Key="ShellNavigationButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>

        <Style x:Key="ShellActionButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="14,11"
                Background="{DynamicResource ButtonBackground}"
                BorderBrush="{DynamicResource ButtonBorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="同流程"
                               Margin="0,0,6,0"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <Button x:Name="PreviousSameFlowRunButton"
                            Content="&#xE72B;"
                            ToolTip="上次相同流程执行"
                            AutomationProperties.Name="上次相同流程执行"
                            IsEnabled="False"
                            Click="PreviousSameFlowRunButton_Click"
                            Style="{StaticResource ShellNavigationButtonStyle}"/>
                    <Button x:Name="NextSameFlowRunButton"
                            Content="&#xE72A;"
                            ToolTip="下次相同流程执行"
                            AutomationProperties.Name="下次相同流程执行"
                            IsEnabled="False"
                            Margin="6,0,0,0"
                            Click="NextSameFlowRunButton_Click"
                            Style="{StaticResource ShellNavigationButtonStyle}"/>
                    <Border Width="1"
                            Height="24"
                            Margin="10,0"
                            Background="{DynamicResource ButtonBorderBrush}"/>
                    <TextBlock Text="全部流程"
                               Margin="0,0,6,0"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <Button x:Name="PreviousRunButton"
                            Content="&#xE72B;"
                            ToolTip="上一次流程执行"
                            AutomationProperties.Name="上一次流程执行"
                            IsEnabled="False"
                            Click="PreviousRunButton_Click"
                            Style="{StaticResource ShellNavigationButtonStyle}"/>
                    <Button x:Name="NextRunButton"
                            Content="&#xE72A;"
                            ToolTip="下一次流程执行"
                            AutomationProperties.Name="下一次流程执行"
                            IsEnabled="False"
                            Margin="6,0,0,0"
                            Click="NextRunButton_Click"
                            Style="{StaticResource ShellNavigationButtonStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="16,0,12,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="HeaderTitleText"
                                   Text="流程执行分析"
                                   FontSize="21"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource GlobalTextBrush}"/>
                        <TextBlock x:Name="BreadcrumbText"
                                   Margin="12,3,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                    <TextBlock x:Name="HeaderSubtitleText"
                               Margin="0,3,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="正在读取最近一次流程执行"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="刷新"
                            ToolTip="重新读取本次流程的节点与消息记录"
                            Click="RefreshButton_Click"
                            Style="{StaticResource ShellActionButtonStyle}"/>
                    <Button x:Name="ClearAllRecordsButton"
                            Content="清空全部记录"
                            ToolTip="清空所有流程的本地分析节点记录与消息记录"
                            Click="ClearAllRecordsButton_Click"
                            Style="{StaticResource ShellActionButtonStyle}"/>
                    <Button Content="导出"
                            Click="ExportButton_Click"
                            Style="{StaticResource ShellActionButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Frame x:Name="AnalysisFrame"
                   Margin="14"
                   NavigationUIVisibility="Hidden"/>

            <Border x:Name="LoadingOverlay"
                    Visibility="Collapsed"
                    Background="#66FFFFFF">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar Width="220" Height="5" IsIndeterminate="True"/>
                    <TextBlock Margin="0,12,0,0"
                               Text="正在加载流程执行记录…"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource GlobalTextBrush}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
