<Window x:Class="ColorVision.Engine.FlowProcessing.Diagnostics.FlowExecutionAnalysisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        xmlns:properties="clr-namespace:ColorVision.Engine.Properties"
        mc:Ignorable="d"
        Title="流程执行分析"
        Width="1400" Height="860" MinWidth="1080" MinHeight="680"
        Background="{DynamicResource GlobalBackground}"
        Initialized="Window_Initialized">
    <Window.Resources>
        <SolidColorBrush x:Key="AnalysisSuccessBrush" Color="#2E9D66"/>
        <SolidColorBrush x:Key="AnalysisRunningBrush" Color="#D99000"/>
        <SolidColorBrush x:Key="AnalysisWarningBrush" Color="#D84A4A"/>

        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="AnalysisCardStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <Style x:Key="MetricLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="MetricValueStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="PrimaryActionButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="MinHeight" Value="30"/>
        </Style>

        <Style x:Key="BatchItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="Chrome"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DurationItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="Chrome"
                                Padding="12"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource GlobalBorderBrush1}"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DurationProgressStyle" TargetType="{x:Type ProgressBar}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource GlobalBorderBrush1}"/>
            <Setter Property="Height" Value="10"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource AnalysisRunningBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsWarning}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource AnalysisWarningBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Workspace header and browser-like navigation -->
        <Border Grid.Row="0"
                Background="{DynamicResource ButtonBackground}"
                BorderBrush="{DynamicResource ButtonBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BackButton" Width="34" Height="30" Margin="0,0,6,0"
                            ToolTip="返回上一个分析页面" Click="BackButton_Click" IsEnabled="False">
                        <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                    </Button>
                    <Button x:Name="ForwardButton" Width="34" Height="30"
                            ToolTip="前进到下一个分析页面" Click="ForwardButton_Click" IsEnabled="False">
                        <TextBlock Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                    <TextBlock Text="流程执行分析" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock x:Name="WorkspaceSubtitleText"
                               Text="选择批次后，先定位瓶颈，再深入节点与消息"
                               Margin="0,3,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="12"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{x:Static properties:Resources.Flow_NodeAnalysis_Export}"
                            Click="ExportButton_Click" Padding="12,5"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Compact batch picker -->
        <Border Grid.Row="1"
                BorderBrush="{DynamicResource ButtonBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="批次" FontWeight="SemiBold" Margin="0,0,8,0"/>
                    <TextBlock Text="可多选"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="11"/>
                </StackPanel>

                <ListBox x:Name="BatchListView"
                         Grid.Column="1"
                         Height="34"
                         SelectionMode="Multiple"
                         BorderThickness="0"
                         Background="Transparent"
                         ItemContainerStyle="{StaticResource BatchItemStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0">
                    <Button Content="{x:Static properties:Resources.Flow_NodeAnalysis_Load}"
                            Click="LoadButton_Click" Padding="12,5" Margin="0,0,6,0"/>
                    <Button Content="{x:Static properties:Resources.Flow_NodeAnalysis_Compare}"
                            Click="CompareButton_Click"
                            Style="{StaticResource PrimaryActionButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Each question gets its own page; linked actions use navigation history. -->
        <TabControl x:Name="AnalysisTabControl"
                    Grid.Row="2"
                    Margin="12"
                    BorderThickness="0"
                    SelectionChanged="AnalysisTabControl_SelectionChanged">
            <TabItem x:Name="DistributionTab" Header="耗时分布">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,12">
                        <Border Style="{StaticResource AnalysisCardStyle}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="流程总耗时" Style="{StaticResource MetricLabelStyle}"/>
                                <TextBlock x:Name="SummaryTotalTimeText" Text="—" Style="{StaticResource MetricValueStyle}"/>
                                <TextBlock x:Name="SummaryTotalTimeHintText"
                                           Text="所选批次的墙钟时间"
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap"
                                           Style="{StaticResource MetricLabelStyle}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource AnalysisCardStyle}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="执行节点" Style="{StaticResource MetricLabelStyle}"/>
                                <TextBlock x:Name="SummaryNodeCountText" Text="—" Style="{StaticResource MetricValueStyle}"/>
                                <TextBlock x:Name="SummaryNodeStateText"
                                           Text="等待加载"
                                           Margin="0,4,0,0"
                                           Style="{StaticResource MetricLabelStyle}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource AnalysisCardStyle}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="最慢节点" Style="{StaticResource MetricLabelStyle}"/>
                                <TextBlock x:Name="SummarySlowestNodeText"
                                           Text="—"
                                           TextTrimming="CharacterEllipsis"
                                           Style="{StaticResource MetricValueStyle}"/>
                                <TextBlock x:Name="SummarySlowestTimeText"
                                           Text="—"
                                           Margin="0,4,0,0"
                                           Style="{StaticResource MetricLabelStyle}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource AnalysisCardStyle}">
                            <StackPanel>
                                <TextBlock Text="消息追踪" Style="{StaticResource MetricLabelStyle}"/>
                                <TextBlock x:Name="SummaryMessageCountText" Text="—" Style="{StaticResource MetricValueStyle}"/>
                                <TextBlock x:Name="SummaryMessageStateText"
                                           Text="等待加载"
                                           Margin="0,4,0,0"
                                           Style="{StaticResource MetricLabelStyle}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Grid.Row="1" Style="{StaticResource AnalysisCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="节点耗时分布" Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock x:Name="DistributionHintText"
                                               Text="按耗时从高到低排列；条形长度相对最慢节点，右侧比例为节点工作量占比"
                                               Margin="0,4,0,0"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               FontSize="12"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="双击任一行可进入节点分析"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="11"
                                           VerticalAlignment="Bottom"/>
                            </Grid>

                            <Grid Grid.Row="1">
                                <ListBox x:Name="DurationListBox"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         ItemContainerStyle="{StaticResource DurationItemStyle}"
                                         MouseDoubleClick="DurationListBox_MouseDoubleClick"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="42"/>
                                                    <ColumnDefinition Width="210"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="76"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="{Binding Rank, StringFormat=#\{0\}}"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"/>

                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding NodeName}"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding SampleText}"
                                                               Margin="0,3,0,0"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>

                                                <ProgressBar Grid.Column="2"
                                                             Margin="8,0,18,0"
                                                             Maximum="100"
                                                             Value="{Binding RelativeToSlowestPercent, Mode=OneWay}"
                                                             Style="{StaticResource DurationProgressStyle}"/>

                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding DurationText}"
                                                           HorizontalAlignment="Right"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"/>

                                                <StackPanel Grid.Column="4" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding ShareText}" HorizontalAlignment="Right"/>
                                                    <TextBlock Text="节点工作量"
                                                               HorizontalAlignment="Right"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                </StackPanel>

                                                <Button Grid.Column="5"
                                                        Content="分析"
                                                        Tag="{Binding Record}"
                                                        Click="AnalyzeNode_Click"
                                                        Padding="9,3"
                                                        Margin="12,0,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <TextBlock x:Name="DistributionEmptyText"
                                           Text="选择并加载一个批次，即可查看节点耗时分布"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Visibility="Visible"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="TimelineTab" Header="执行时序">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*" MinHeight="260"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*" MinHeight="150"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="2,0,2,8">
                        <StackPanel>
                            <TextBlock Text="执行时序" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock x:Name="TimelineHintText"
                                       Text="用于识别并行、等待与节点间空档；瓶颈判断请优先查看“耗时分布”"
                                       Margin="0,4,0,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="12"/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource AnalysisCardStyle}" Padding="6">
                        <ScottPlot:WpfPlot x:Name="GanttPlot"/>
                    </Border>

                    <GridSplitter Grid.Row="2"
                                  Height="8"
                                  HorizontalAlignment="Stretch"
                                  Background="Transparent"/>

                    <Border Grid.Row="3" Style="{StaticResource AnalysisCardStyle}" Padding="6">
                        <ListView x:Name="NodeRecordListView"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  MouseDoubleClick="NodeRecordListView_MouseDoubleClick">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="{x:Type ListViewItem}" BasedOn="{StaticResource ListViewItemBaseStyle.Small}"/>
                            </ListView.ItemContainerStyle>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="BatchId" Width="70" DisplayMemberBinding="{Binding BatchId}"/>
                                    <GridViewColumn Header="{x:Static properties:Resources.Flow_NodeAnalysis_NodeName}" Width="190" DisplayMemberBinding="{Binding NodeName}"/>
                                    <GridViewColumn Header="{x:Static properties:Resources.Flow_NodeAnalysis_NodeType}" Width="130" DisplayMemberBinding="{Binding NodeType}"/>
                                    <GridViewColumn Header="{x:Static properties:Resources.Flow_NodeAnalysis_StartTime}" Width="180">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StartTime, StringFormat=yyyy/MM/dd HH:mm:ss.fff}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="{x:Static properties:Resources.Flow_NodeAnalysis_EndTime}" Width="180">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding EndTime, StringFormat=yyyy/MM/dd HH:mm:ss.fff}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="{x:Static properties:Resources.Flow_NodeAnalysis_ElapsedMs}" Width="100" DisplayMemberBinding="{Binding ElapsedMs}"/>
                                    <GridViewColumn Header="SN" Width="220" DisplayMemberBinding="{Binding SerialNumber}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="NodeDetailsTab" Header="节点分析">
                <Grid Margin="0,10,0,0">
                    <TextBlock x:Name="NodeDetailEmptyText"
                               Text="从“耗时分布”或“执行时序”中选择一个节点开始分析"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>

                    <Grid x:Name="NodeDetailContent" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Margin="2,0,2,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="NodeDetailTitleText" Text="—" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock x:Name="NodeDetailSubtitleText"
                                           Text="—"
                                           Margin="0,4,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="12"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="上一个节点" Click="PreviousNodeButton_Click" Padding="10,5" Margin="0,0,6,0"/>
                                <Button Content="下一个节点" Click="NextNodeButton_Click" Padding="10,5" Margin="0,0,12,0"/>
                                <Button x:Name="LocateFlowNodeButton"
                                        Content="定位到流程图"
                                        Click="LocateFlowNodeButton_Click"
                                        Padding="10,5"
                                        Margin="0,0,6,0"/>
                                <Button Content="查看节点消息"
                                        Click="ViewNodeMessagesButton_Click"
                                        Style="{StaticResource PrimaryActionButtonStyle}"/>
                            </StackPanel>
                        </Grid>

                        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,12">
                            <Border Style="{StaticResource AnalysisCardStyle}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="本次耗时" Style="{StaticResource MetricLabelStyle}"/>
                                    <TextBlock x:Name="NodeElapsedText" Text="—" Style="{StaticResource MetricValueStyle}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource AnalysisCardStyle}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="节点工作量占比" Style="{StaticResource MetricLabelStyle}"/>
                                    <TextBlock x:Name="NodeShareText" Text="—" Style="{StaticResource MetricValueStyle}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource AnalysisCardStyle}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="最近平均" Style="{StaticResource MetricLabelStyle}"/>
                                    <TextBlock x:Name="NodeHistoryAverageText" Text="—" Style="{StaticResource MetricValueStyle}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource AnalysisCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="最近 P95" Style="{StaticResource MetricLabelStyle}"/>
                                    <TextBlock x:Name="NodeHistoryP95Text" Text="—" Style="{StaticResource MetricValueStyle}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="360"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource AnalysisCardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="本次执行信息" Style="{StaticResource SectionTitleStyle}"/>
                                    <Grid Grid.Row="1" Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="86"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="32"/>
                                            <RowDefinition Height="32"/>
                                            <RowDefinition Height="32"/>
                                            <RowDefinition Height="32"/>
                                            <RowDefinition Height="32"/>
                                            <RowDefinition Height="32"/>
                                            <RowDefinition Height="32"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="批次" Style="{StaticResource MetricLabelStyle}"/>
                                        <TextBlock x:Name="NodeBatchText" Grid.Column="1"/>
                                        <TextBlock Grid.Row="1" Text="节点类型" Style="{StaticResource MetricLabelStyle}"/>
                                        <TextBlock x:Name="NodeTypeText" Grid.Row="1" Grid.Column="1"/>
                                        <TextBlock Grid.Row="2" Text="NodeId" Style="{StaticResource MetricLabelStyle}"/>
                                        <TextBlock x:Name="NodeIdText" Grid.Row="2" Grid.Column="1" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Row="3" Text="开始时间" Style="{StaticResource MetricLabelStyle}"/>
                                        <TextBlock x:Name="NodeStartTimeText" Grid.Row="3" Grid.Column="1"/>
                                        <TextBlock Grid.Row="4" Text="结束时间" Style="{StaticResource MetricLabelStyle}"/>
                                        <TextBlock x:Name="NodeEndTimeText" Grid.Row="4" Grid.Column="1"/>
                                        <TextBlock Grid.Row="5" Text="序列号" Style="{StaticResource MetricLabelStyle}"/>
                                        <TextBlock x:Name="NodeSerialNumberText" Grid.Row="5" Grid.Column="1" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Row="6" Text="状态" Style="{StaticResource MetricLabelStyle}"/>
                                        <TextBlock x:Name="NodeStateText" Grid.Row="6" Grid.Column="1" FontWeight="SemiBold"/>
                                    </Grid>
                                    <TextBlock Grid.Row="2"
                                               Text="说明：同一批次内同一节点重复执行时，当前消息记录只能按 BatchId + NodeId 汇总。"
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource AnalysisCardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="最近执行记录" Style="{StaticResource SectionTitleStyle}"/>
                                        <TextBlock x:Name="NodeHistoryHintText"
                                                   Text="用于判断该节点是偶发变慢，还是长期瓶颈"
                                                   Margin="0,4,0,10"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontSize="12"/>
                                    </StackPanel>
                                    <ListView x:Name="NodeHistoryListView"
                                              Grid.Row="1"
                                              Background="Transparent"
                                              BorderThickness="0">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="{x:Type ListViewItem}" BasedOn="{StaticResource ListViewItemBaseStyle.Small}"/>
                                        </ListView.ItemContainerStyle>
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="BatchId" Width="80" DisplayMemberBinding="{Binding BatchId}"/>
                                                <GridViewColumn Header="{x:Static properties:Resources.Flow_NodeAnalysis_StartTime}" Width="190">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding StartTime, StringFormat=yyyy/MM/dd HH:mm:ss.fff}"/>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Header="{x:Static properties:Resources.Flow_NodeAnalysis_ElapsedMs}" Width="110" DisplayMemberBinding="{Binding ElapsedMs}"/>
                                                <GridViewColumn Header="SN" Width="220" DisplayMemberBinding="{Binding SerialNumber}"/>
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem x:Name="MessageTraceTab" Header="消息追踪">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource AnalysisCardStyle}" Padding="10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Static properties:Resources.Flow_NodeAnalysis_NodeFilter}" Margin="0,0,6,0"/>
                            <ComboBox x:Name="MessageNodeFilter"
                                      Grid.Column="1"
                                      SelectionChanged="MessageNodeFilter_SelectionChanged">
                                <ComboBoxItem Content="{x:Static properties:Resources.Flow_NodeAnalysis_All}" Tag="All" IsSelected="True"/>
                            </ComboBox>
                            <TextBlock Grid.Column="2"
                                       Text="{x:Static properties:Resources.Flow_NodeAnalysis_StateFilter}"
                                       Margin="16,0,6,0"/>
                            <ComboBox x:Name="MessageStateFilter"
                                      Grid.Column="3"
                                      SelectionChanged="MessageStateFilter_SelectionChanged">
                                <ComboBoxItem Content="{x:Static properties:Resources.Flow_NodeAnalysis_All}" Tag="All" IsSelected="True"/>
                                <ComboBoxItem Content="Sent"/>
                                <ComboBoxItem Content="Success"/>
                                <ComboBoxItem Content="Fail"/>
                                <ComboBoxItem Content="Timeout"/>
                            </ComboBox>
                            <TextBlock x:Name="MessageScopeText"
                                       Grid.Column="4"
                                       Margin="16,0"
                                       HorizontalAlignment="Right"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="当前所选批次"/>
                            <Button Grid.Column="5"
                                    Content="重置筛选"
                                    Click="ResetMessageFilterButton_Click"
                                    Padding="10,4"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" MinWidth="480"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="2*" MinWidth="360"/>
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource AnalysisCardStyle}" Padding="6">
                            <ListView x:Name="MessageListView"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      ScrollViewer.CanContentScroll="True"
                                      SelectionChanged="MessageListView_SelectionChanged">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="{x:Type ListViewItem}" BasedOn="{StaticResource ListViewItemBaseStyle.Small}"/>
                                </ListView.ItemContainerStyle>
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="{x:Static properties:Resources.Flow_NodeAnalysis_Node}" Width="140" DisplayMemberBinding="{Binding NodeName}"/>
                                        <GridViewColumn Header="EventName" Width="120" DisplayMemberBinding="{Binding EventName}"/>
                                        <GridViewColumn Header="{x:Static properties:Resources.Flow_NodeAnalysis_SendTime}" Width="145">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding SendTime, StringFormat=HH:mm:ss.fff}"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="{x:Static properties:Resources.Flow_NodeAnalysis_RecvTime}" Width="145">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding RecvTime, StringFormat=HH:mm:ss.fff}"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="{x:Static properties:Resources.Flow_NodeAnalysis_ElapsedMs}" Width="85" DisplayMemberBinding="{Binding ElapsedMs}"/>
                                        <GridViewColumn Header="{x:Static properties:Resources.Flow_NodeAnalysis_State}" Width="85" DisplayMemberBinding="{Binding State}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Border>

                        <GridSplitter Grid.Column="1"
                                      Width="8"
                                      HorizontalAlignment="Stretch"
                                      Background="Transparent"/>

                        <Border Grid.Column="2" Style="{StaticResource AnalysisCardStyle}" Padding="6">
                            <TabControl BorderThickness="0">
                                <TabItem Header="{x:Static properties:Resources.Flow_NodeAnalysis_SendData}">
                                    <Grid Margin="6,10,6,6">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock x:Name="SendTopicTextBlock"
                                                   Text="选择一条消息查看 Topic 与 Payload"
                                                   Margin="2,0,2,8"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBox x:Name="SendPayloadTextBox"
                                                 Grid.Row="1"
                                                 IsReadOnly="True"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                 TextWrapping="Wrap"
                                                 FontFamily="Consolas"
                                                 FontSize="12"/>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="{x:Static properties:Resources.Flow_NodeAnalysis_RecvData}">
                                    <Grid Margin="6,10,6,6">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock x:Name="RecvTopicTextBlock"
                                                   Text="选择一条消息查看 Topic 与 Payload"
                                                   Margin="2,0,2,8"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBox x:Name="RecvPayloadTextBox"
                                                 Grid.Row="1"
                                                 IsReadOnly="True"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                 TextWrapping="Wrap"
                                                 FontFamily="Consolas"
                                                 FontSize="12"/>
                                    </Grid>
                                </TabItem>
                            </TabControl>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2"
                            Margin="0,8,0,0"
                            BorderBrush="{DynamicResource ButtonBorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="4,8,4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="当前显示 " Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock x:Name="MessageDisplayCountText" Text="0" FontWeight="SemiBold"/>
                            <TextBlock Text=" 条 / 批次消息 " Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock x:Name="MessageTotalCountText" Text="0" FontWeight="SemiBold"/>
                            <TextBlock Text=" 条" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
