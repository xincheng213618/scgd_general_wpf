<UserControl x:Class="ColorVision.Engine.FlowProcessing.ViewFlow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ColorVision.Engine.FlowProcessing"
             xmlns:flow="clr-namespace:ColorVision.Engine.FlowProcessing.Editor"
             xmlns:engine="clr-namespace:ColorVision.Engine"
             xmlns:properties="clr-namespace:ColorVision.Engine.Properties"
             mc:Ignorable="d"
             PreviewKeyDown="UserControl_PreviewKeyDown"
             d:DataContext="{d:DesignInstance local:ViewFlow}"
             d:DesignHeight="600" d:DesignWidth="1000"
             Background="{DynamicResource GlobalBackground}"
             Initialized="UserControl_Initialized">
    <Grid x:Name="Grid1">
        <flow:FlowEditorCanvas x:Name="EditorCanvas"
                               PropertyPanelMargin="0,54,10,108">
            <flow:FlowEditorCanvas.ToolbarContent>
                <StackPanel Orientation="Horizontal">
                <Button Command="{Binding NewFlowCommand}" Width="34" Height="32"
                        Margin="2,0" Padding="3"
                        ToolTip="{x:Static properties:Resources.New}">
                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets"
                               Foreground="{DynamicResource GlobalTextBrush}" FontSize="16"/>
                </Button>
                <Button Command="{Binding SaveCommand}" Width="34" Height="32"
                        Margin="2,0" Padding="3"
                        ToolTip="{x:Static properties:Resources.Save}">
                    <Image Source="{DynamicResource DrawingImageSave}" Height="20"/>
                </Button>
                <Button Command="{Binding RefreshCommand}" Width="34" Height="32"
                        Margin="2,0" Padding="3"
                        ToolTip="{x:Static properties:Resources.Refresh}">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets"
                               Foreground="{DynamicResource GlobalTextBrush}" FontSize="16"/>
                </Button>
                <Button Command="{Binding VersionHistoryCommand}" Width="34" Height="32"
                        Margin="2,0" Padding="3"
                        ToolTip="{engine:EngineLang 流程版本历史}">
                    <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets"
                               Foreground="{DynamicResource GlobalTextBrush}" FontSize="16"/>
                </Button>
                <Button Command="{Binding IncidentManagementCommand}" Width="34" Height="32"
                        Margin="2,0" Padding="3"
                        ToolTip="{engine:EngineLang Key='流程 Incident 管理'}">
                    <TextBlock Text="&#xEA39;" FontFamily="Segoe MDL2 Assets"
                               Foreground="{DynamicResource GlobalTextBrush}" FontSize="16"/>
                </Button>
                <Button Command="{Binding AutoAlignmentCommand}" Width="34" Height="32"
                        Margin="2,0" Padding="3"
                        ToolTip="{x:Static properties:Resources.AutoAlign}">
                    <Image Source="{DynamicResource DrawingImageFlow}"/>
                </Button>
                <Button Command="{Binding AutoSizeCommand}" Width="34" Height="32"
                        Margin="2,0" Padding="3" ToolTip="{engine:EngineLang 适应全部节点}">
                    <TextBlock Text="&#xE9A6;" FontFamily="Segoe MDL2 Assets"
                               Foreground="{DynamicResource GlobalTextBrush}" FontSize="16"/>
                </Button>
                <Button Command="{Binding ClearCommand}" Width="34" Height="32"
                        Margin="2,0" Padding="3"
                        ToolTip="{x:Static properties:Resources.Clear}">
                    <Image Source="{DynamicResource DrawingImageClear}"/>
                </Button>
                <Button Command="{Binding ExportFlowCommand}" Width="34" Height="32"
                        Margin="2,0" Padding="3"
                        ToolTip="{x:Static properties:Resources.Flow_ExportFlow}">
                    <TextBlock Text="&#xEDE1;" FontFamily="Segoe MDL2 Assets"
                               Foreground="{DynamicResource GlobalTextBrush}" FontSize="16"/>
                </Button>
                <Button Command="{Binding ImportFlowCommand}" Width="34" Height="32"
                        Margin="2,0" Padding="3"
                        ToolTip="{x:Static properties:Resources.Flow_ImportFlow}">
                    <TextBlock Text="&#xE8B5;" FontFamily="Segoe MDL2 Assets"
                               Foreground="{DynamicResource GlobalTextBrush}" FontSize="16"/>
                </Button>
                </StackPanel>
            </flow:FlowEditorCanvas.ToolbarContent>
            <flow:FlowEditorCanvas.RightToolbarContent>
                <StackPanel Orientation="Horizontal">
                    <Button MinWidth="88" Height="32" Margin="2,0" Padding="8,3"
                            Click="PreProcessManagementButton_Click"
                            ToolTip="{x:Static properties:Resources.PreprocessManager}"
                            AutomationProperties.Name="{x:Static properties:Resources.PreprocessManager}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="18" Height="18"
                                  Data="M 9.5,2.5 H 16.5 V 15.5 H 9.5 M 1.5,9 H 12 M 8.5,5.5 L 12,9 8.5,12.5"
                                  Stroke="{DynamicResource GlobalTextBrush}" StrokeThickness="1.3"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <TextBlock Text="{engine:EngineLang 预处理}" Margin="6,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource GlobalTextBrush}"/>
                        </StackPanel>
                    </Button>
                    <Button MinWidth="88" Height="32" Margin="2,0" Padding="8,3"
                            Click="PostProcessManagementButton_Click"
                            ToolTip="{x:Static properties:Resources.ProcessHandlingConfig}"
                            AutomationProperties.Name="{x:Static properties:Resources.ProcessHandlingConfig}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="18" Height="18"
                                  Data="M 8.5,2.5 H 1.5 V 15.5 H 8.5 M 6,9 H 16.5 M 13,5.5 L 16.5,9 13,12.5"
                                  Stroke="{DynamicResource GlobalTextBrush}" StrokeThickness="1.3"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <TextBlock Text="{engine:EngineLang 后处理}" Margin="6,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource GlobalTextBrush}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </flow:FlowEditorCanvas.RightToolbarContent>
        </flow:FlowEditorCanvas>

        <Grid>
            <!-- Compact execution details float above the progress bar. -->
            <Grid Margin="10,0,10,10"
                  HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                  Panel.ZIndex="25" Opacity="0.8">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Height" Value="75"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsExecutionStopping}" Value="True">
                                <Setter Property="Height" Value="95"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Border Background="{DynamicResource GlobalBackground}"
                        BorderBrush="{DynamicResource GlobalBorderBrush}"
                        BorderThickness="1" CornerRadius="6" Opacity="0.3"/>
                <Grid Margin="6,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="StoppingText" Margin="6,0,6,0"
                               Foreground="{DynamicResource GlobalTextBrush}"
                               Text="{engine:EngineLang Key='正在停止，等待当前环节结束…'}"
                               Visibility="{Binding IsExecutionStopping, Converter={StaticResource bool2VisibilityConverter}}"/>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Margin="0,0,6,0" VerticalAlignment="Center">
                            <Button x:Name="RunButton" Width="50" Height="50"
                                    Padding="3"
                                    ToolTip="{x:Static properties:Resources.ExecutionProcess}" Margin="6,0,0,0"
                                    Visibility="{Binding IsExecutionActive, Converter={StaticResource bool2VisibilityConverter1}}"
                                    Command="{Binding RunFlowCommand}">
                                <TextBlock Text="&#xE768;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="30"
                                           Foreground="{DynamicResource GlobalTextBrush}"/>
                            </Button>
                            <Button x:Name="StopButton" Width="50" Height="50"
                                    Padding="3"
                                    ToolTip="{x:Static properties:Resources.StopProcess}" Margin="6,0,0,0"
                                    Visibility="{Binding IsExecutionActive, Converter={StaticResource bool2VisibilityConverter}}"
                                    Command="{Binding StopFlowCommand}">
                                <TextBlock Text="&#xE71A;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="30"
                                           Foreground="{DynamicResource GlobalTextBrush}"/>
                            </Button>
                        </Grid>

                        <DockPanel Grid.Column="1" LastChildFill="True">
                            <Button x:Name="ErrorNodeDetailsButton"
                                    DockPanel.Dock="Right"
                                    Margin="6,0,4,0"
                                    Padding="8,2"
                                    VerticalAlignment="Top"
                                    Visibility="Collapsed"
                                    Content="{x:Static properties:Resources.Flow_NodeExecutionDetails}"
                                    Click="ErrorNodeDetailsButton_Click"/>
                            <TextBox x:FieldModifier="public" x:Name="logTextBox"
                                     Padding="2" Background="Transparent"
                                     Foreground="{DynamicResource GlobalTextBrush}"
                                     BorderThickness="0" TextWrapping="WrapWithOverflow"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top" IsReadOnly="True"/>
                        </DockPanel>

                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal">
                            <Button Content="{x:Static properties:Resources.FlowResultManagement}" Command="{Binding FlowEngineManager.MeasureBatchManagerCommand}"/>
                            <Button Content="{engine:EngineLang 执行分析}" Click="Button_Click_NodeAnalysis"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>

            <ProgressBar x:Name="ProgressBar1" Height="8"
                         HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                         Panel.ZIndex="40"
                         Maximum="100" Style="{StaticResource ProgressBarFlat}"
                         IsIndeterminate="{Binding IsExecutionProgressIndeterminate}"
                         Visibility="{Binding IsExecutionActive, Converter={StaticResource bool2VisibilityConverter}}"
                         Value="{Binding FlowEngineManager.BatchProgress}"/>
        </Grid>
    </Grid>
</UserControl>
