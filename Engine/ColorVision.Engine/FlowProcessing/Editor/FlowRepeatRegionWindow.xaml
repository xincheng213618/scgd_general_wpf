<Window x:Class="ColorVision.Engine.FlowProcessing.Editor.FlowRepeatRegionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:ColorVision.Engine"
        Width="1060" Height="720" MinWidth="880" MinHeight="590"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource GlobalBackground}" Foreground="{DynamicResource GlobalTextBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="{i18n:EngineLang Key='重复执行与逐轮参数'}" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="{i18n:EngineLang Key='每一行是一轮；框内整段执行完成后进入下一轮。参数随流程保存。'}" Margin="0,6,0,14" Opacity="0.75"/>
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="{i18n:EngineLang Key='执行次数'}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="RepeatCountBox" Width="85" VerticalContentAlignment="Center" Padding="7,4"/>
                <Button x:Name="ApplyCountButton" Content="{i18n:EngineLang Key='应用次数'}" Click="ApplyCount_Click" Padding="12,6" Margin="8,0,20,0"/>
                <Button x:Name="AddRoundButton" Content="{i18n:EngineLang Key='增加一轮'}" Click="AddRound_Click" Padding="12,6" Margin="0,0,8,0"/>
                <Button x:Name="RemoveRoundsButton" Content="{i18n:EngineLang Key='删除选中轮次'}" Click="RemoveRounds_Click" Padding="12,6"/>
            </WrapPanel>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="215"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock Text="{i18n:EngineLang Key='可编辑的节点'}" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock x:Name="NodeCountText" Margin="0,5,0,0" Opacity="0.65" TextWrapping="Wrap"/>
                </StackPanel>
                <ListBox x:Name="NodeList" SelectionChanged="NodeList_SelectionChanged" Padding="5" HorizontalContentAlignment="Stretch"/>
            </DockPanel>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,10">
                    <TextBlock x:Name="NodeTitle" FontSize="17" FontWeight="SemiBold"/>
                    <WrapPanel x:Name="ParameterOptions" Margin="0,8,0,0"/>
                    <TextBlock x:Name="UnavailableText" Margin="0,6,0,0" TextWrapping="Wrap" Opacity="0.75"/>
                </StackPanel>
                <WrapPanel Grid.Row="1" Margin="0,0,0,10" VerticalAlignment="Center">
                    <ComboBox x:Name="ParameterSelector" MinWidth="145" Margin="0,0,12,6" SelectionChanged="ParameterSelector_SelectionChanged"/>
                    <TextBlock Text="{i18n:EngineLang Key='从第'}" VerticalAlignment="Center" Margin="0,0,4,6"/>
                    <TextBox x:Name="FirstRoundBox" Width="42" Text="1" Margin="0,0,4,6"/>
                    <TextBlock Text="{i18n:EngineLang Key='到'}" VerticalAlignment="Center" Margin="0,0,4,6"/>
                    <TextBox x:Name="LastRoundBox" Width="42" Margin="0,0,12,6"/>
                    <TextBlock Text="{i18n:EngineLang Key='起始值'}" VerticalAlignment="Center" Margin="0,0,4,6"/>
                    <TextBox x:Name="StartValueBox" Width="72" Margin="0,0,12,6"/>
                    <TextBlock Text="{i18n:EngineLang Key='每轮增加'}" VerticalAlignment="Center" Margin="0,0,4,6"/>
                    <TextBox x:Name="IncrementBox" Width="65" Text="0" Margin="0,0,8,6"/>
                    <Button x:Name="FillButton" Content="{i18n:EngineLang Key='填充选定范围'}" Click="Fill_Click" Padding="10,4" Margin="0,0,0,6"/>
                </WrapPanel>
                <DataGrid x:Name="ParameterGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserSortColumns="False" CanUserReorderColumns="False" SelectionMode="Extended" SelectionUnit="FullRow"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True" HeadersVisibility="Column" RowHeaderWidth="0"
                          GridLinesVisibility="Horizontal" RowHeight="35" MinRowHeight="30" SelectionChanged="ParameterGrid_SelectionChanged"/>
                <TextBlock Grid.Row="3" Text="{i18n:EngineLang Key='直接修改单元格可设置任意跳变；增量填 0 可统一赋值，负数可递减。平均次数表示设备单轮内部平均。'}"
                           TextWrapping="Wrap" Margin="0,10,0,0" Opacity="0.65"/>
            </Grid>
        </Grid>
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="{i18n:EngineLang Key='确定'}" IsDefault="True" Click="Accept_Click" MinWidth="88" Padding="12,7" Margin="0,0,8,0"/>
                <Button Content="{i18n:EngineLang Key='取消'}" IsCancel="True" MinWidth="88" Padding="12,7"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
