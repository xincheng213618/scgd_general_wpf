<Window x:Class="ColorVision.Engine.FlowProcessing.Editor.FlowRepeatCountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ColorVision.UI.Properties;assembly=ColorVision.UI"
        Width="400" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource GlobalBackground}" Foreground="{DynamicResource GlobalTextBrush}">
    <StackPanel Margin="20">
        <StackPanel x:Name="CountPanel"/>
        <TextBlock x:Name="Explanation" Margin="0,12,0,0" TextWrapping="Wrap"/>
        <TextBlock x:Name="ErrorText" Margin="0,10,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource DangerBrush}" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="AcceptButton" Content="{x:Static ui:Resources.OK}" MinWidth="80" Margin="0,0,8,0"
                    IsDefault="True" Click="Accept_Click"/>
            <Button Content="{x:Static ui:Resources.Cancel}" MinWidth="80" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
