<UserControl x:Class="ColorVision.Engine.FlowProcessing.Editor.FlowEditorCanvas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:engine="clr-namespace:ColorVision.Engine"
             xmlns:local="clr-namespace:ColorVision.Engine.FlowProcessing.Editor"
             xmlns:st="clr-namespace:ST.Library.UI.NodeEditor;assembly=ST.Library.UI"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000">
    <Grid>
        <st:STNodeEditor x:Name="STNodeEditorMain"
                         LimitCanvasToContentBounds="False"
                         ShowLocation="False"
                         ShowCanvasDragLockButton="False"
                         AutoSwitchCanvasDragBySelection="False"
                         HighlightGridOrigin="False"
                         ShowNodeShadow="False"
                         NodeCornerRadius="10"
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Stretch"/>

        <Grid Margin="0,10,0,0"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Panel.ZIndex="20">
            <Border Background="{DynamicResource GlobalBackground}"
                    BorderBrush="{DynamicResource GlobalBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Opacity="0.82"/>
            <StackPanel Orientation="Horizontal" Margin="5">
                <ContentPresenter Content="{Binding ToolbarContent, RelativeSource={RelativeSource AncestorType={x:Type local:FlowEditorCanvas}}}"
                                  VerticalAlignment="Center"/>
                <ToggleButton x:Name="CanvasDragLockButton"
                              Width="34"
                              Height="32"
                              Margin="2,0"
                              Padding="3"
                              IsChecked="True"
                              ToolTip="{engine:EngineLang Key='切换画布拖动/框选'}"
                              Checked="CanvasDragLockButton_Checked"
                              Unchecked="CanvasDragLockButton_Unchecked">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               FontSize="16"
                               Foreground="{DynamicResource GlobalTextBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="&#xE785;"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=CanvasDragLockButton}" Value="True">
                                        <Setter Property="Text" Value="&#xE72E;"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </ToggleButton>
            </StackPanel>
        </Grid>

        <Canvas x:Name="PropertyEditorOverlay"
                ClipToBounds="True"
                Panel.ZIndex="30">
            <Grid x:Name="PropertyEditorPanel"
                  MaxWidth="360"
                  MaxHeight="520"
                  Visibility="Collapsed"
                  Opacity="0.9">
                <Border Background="{DynamicResource GlobalBackground}"
                        BorderBrush="{DynamicResource GlobalBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="7"
                        Opacity="0.78"/>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Margin="9,4,9,0"
                            Padding="0,0,0,4"
                            BorderBrush="{DynamicResource GlobalBorderBrush}"
                            BorderThickness="0,0,0,1">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button x:Name="ConfigurationViewButton"
                                    Click="ConfigurationViewButton_Click"
                                    Padding="9,2"
                                    Margin="0,0,3,0"
                                    BorderThickness="0"
                                    Background="Transparent"
                                    Focusable="False"/>
                            <Button x:Name="DocumentationViewButton"
                                    Click="DocumentationViewButton_Click"
                                    Padding="9,2"
                                    BorderThickness="0"
                                    Background="Transparent"
                                    Focusable="False"/>
                                <ToggleButton x:Name="AdvancedPropertiesButton"
                                              Checked="AdvancedPropertiesButton_Checked"
                                              Unchecked="AdvancedPropertiesButton_Unchecked"
                                              Width="25"
                                              Height="22"
                                              Padding="0"
                                              Margin="4,0,0,0"
                                              BorderThickness="0"
                                              Background="Transparent"
                                              Focusable="False">
                                    <Canvas Width="16" Height="16" IsHitTestVisible="False">
                                        <Line X1="1.5" X2="14.5" Y1="3.5" Y2="3.5"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}"
                                              StrokeThickness="1.25" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Ellipse Canvas.Left="9.5" Canvas.Top="1" Width="5" Height="5"
                                                 Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}"/>
                                        <Line X1="1.5" X2="14.5" Y1="8" Y2="8"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}"
                                              StrokeThickness="1.25" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Ellipse Canvas.Left="3.5" Canvas.Top="5.5" Width="5" Height="5"
                                                 Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}"/>
                                        <Line X1="1.5" X2="14.5" Y1="12.5" Y2="12.5"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}"
                                              StrokeThickness="1.25" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Ellipse Canvas.Left="8" Canvas.Top="10" Width="5" Height="5"
                                                 Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}"/>
                                    </Canvas>
                                </ToggleButton>
                            </StackPanel>
                            <TextBlock x:Name="NodeInspectorTitle"
                                       VerticalAlignment="Center"
                                       FontWeight="Bold"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource GlobalTextBrush}"/>
                        </DockPanel>
                    </Border>
                    <ScrollViewer Grid.Row="1"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  Background="Transparent">
                        <StackPanel x:Name="NodePropertyPanelContent"
                                    Orientation="Vertical"
                                    Margin="5"/>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Canvas>
    </Grid>
</UserControl>
