<Window x:Class="ColorVision.Engine.FlowProcessing.Compilation.FlowSubflowEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="可复用子流程"
        Width="980" Height="620"
        MinWidth="820" MinHeight="500"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Margin="0,0,0,10" TextWrapping="Wrap"
                   Text="每条调用会替换父流程中的一条现有连接。目标流程固定到明确的 revision 和 SHA-256；配置只写入侧车，不修改 STN。"/>

        <DataGrid x:Name="CallsGrid" Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionChanged="CallsGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="调用名称" Binding="{Binding CallId}" Width="150"/>
                <DataGridTextColumn Header="父流程连接" Binding="{Binding Connection}" Width="*"/>
                <DataGridTextColumn Header="目标流程" Binding="{Binding Target}" Width="280"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2" Margin="0,12,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="调用名称"/>
            <TextBox x:Name="CallIdBox" Grid.Column="1" Margin="4,0,12,0"/>
            <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="连接"/>
            <ComboBox x:Name="ConnectionBox" Grid.Column="3" Margin="4,0,12,0"
                      DisplayMemberPath="DisplayName"/>
            <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="目标版本"/>
            <ComboBox x:Name="TargetBox" Grid.Column="5" Margin="4,0,12,0"
                      DisplayMemberPath="DisplayName"/>
            <Button Grid.Column="6" Margin="0,0,6,0" Padding="14,4"
                    Content="添加/更新" Click="Upsert_Click"/>
            <Button Grid.Column="7" Padding="14,4"
                    Content="删除" Click="Remove_Click"/>
        </Grid>

        <DockPanel Grid.Row="3">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                       Foreground="{DynamicResource GlobalTextBrush}"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <CheckBox x:Name="PublishArtifactBox"
                          Margin="0,0,14,0" VerticalAlignment="Center"
                          Content="同时发布 Artifact"/>
                <Button Margin="0,0,8,0" Padding="18,5"
                        Content="保存侧车" Click="Save_Click"/>
                <Button Padding="18,5" Content="关闭"
                        IsCancel="True"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
