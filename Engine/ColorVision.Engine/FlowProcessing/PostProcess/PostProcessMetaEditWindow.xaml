<Window x:Class="ColorVision.Engine.FlowProcessing.PostProcess.PostProcessMetaEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:engine="clr-namespace:ColorVision.Engine"
        Title="{engine:EngineLang 后处理项}" Height="660" Width="1180" MinHeight="580" MinWidth="980"
        Background="{DynamicResource GlobalBackground}" Loaded="Window_Loaded">
    <Window.Resources>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}"/>
        </Style>

        <Style x:Key="PanelTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="TemplateItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Margin" Value="0 2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="ItemBorder" Padding="11 8" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="1" CornerRadius="5">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ButtonBackground}"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ButtonBackground}"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Margin" Value="0 0 7 7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="FilterBorder" Padding="13 6" Background="Transparent"
                                BorderBrush="{DynamicResource ButtonBorderBrush}" BorderThickness="1" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FilterBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="FilterBorder" Property="Background" Value="{DynamicResource ButtonBackground}"/>
                                <Setter TargetName="FilterBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TypeCardItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0 0 10 10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="CardBorder" Width="205" MinHeight="92" Padding="13 10"
                                Background="{DynamicResource ButtonBackground}"
                                BorderBrush="{DynamicResource ButtonBorderBrush}" BorderThickness="1" CornerRadius="7">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="CardBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="2 0 2 14">
            <TextBlock Text="{Binding PageTitle}" FontWeight="SemiBold" FontSize="18"/>
            <TextBlock Text="{engine:EngineLang Key='填写基本信息，按分类选择后处理类型，并在右侧确认配置。'}"
                       Foreground="{DynamicResource SecondaryTextBrush}" Margin="0 5 0 0"/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="8" Background="{DynamicResource GlobalBackground}">
            <Grid Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="255"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*" MinWidth="430"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="315"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0 0 18 0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="{engine:EngineLang 名称}" Style="{StaticResource PanelTitleStyle}" Margin="0 0 0 8"/>
                    <TextBox x:Name="NameTextBox" Grid.Row="1"
                             Text="{Binding MetaName, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Row="2" Text="{engine:EngineLang 标签}" Style="{StaticResource PanelTitleStyle}" Margin="0 16 0 8"/>
                    <TextBox Grid.Row="3" Text="{Binding Tag, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Row="4" Text="{engine:EngineLang 失败策略}" Style="{StaticResource PanelTitleStyle}" Margin="0 16 0 8"/>
                    <ComboBox Grid.Row="5" ItemsSource="{Binding FailurePolicies}"
                              SelectedItem="{Binding FailurePolicy}"/>

                    <Grid Grid.Row="6" Margin="0 18 0 0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{engine:EngineLang 流程模板}" Style="{StaticResource PanelTitleStyle}" Margin="0 0 0 8"/>
                        <TextBox Grid.Row="1" Text="{Binding TemplateSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{engine:EngineLang 输入模板名称筛选}" Margin="0 0 0 8"/>
                        <ListBox Grid.Row="2" ItemsSource="{Binding VisibleTemplates}"
                                 SelectedItem="{Binding SelectedTemplate}" BorderThickness="1"
                                 BorderBrush="{DynamicResource BorderBrush}" Background="Transparent"
                                 Padding="5" ItemContainerStyle="{StaticResource TemplateItemStyle}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Key}" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>

                <Border Grid.Column="1" Background="{DynamicResource BorderBrush}"/>

                <Grid Grid.Column="2" Margin="18 0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                             ItemContainerStyle="{StaticResource FilterItemStyle}" BorderThickness="0"
                             Background="Transparent" Margin="0 0 0 8">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel IsItemsHost="True"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>

                    <ListBox Grid.Row="1" ItemsSource="{Binding VisibleProcesses}"
                             SelectedItem="{Binding SelectedOption}" BorderThickness="0"
                             Background="Transparent" ItemContainerStyle="{StaticResource TypeCardItemStyle}"
                             SelectionChanged="ProcessType_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel IsItemsHost="True"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel ToolTip="{Binding Description}">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="{Binding ConfigurationSummary}"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               FontSize="12" Margin="0 5 0 0"/>
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               FontSize="12" Margin="0 7 0 0" MaxHeight="38"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <Border Grid.Column="3" Background="{DynamicResource BorderBrush}"/>

                <Grid Grid.Column="4" Margin="18 0 0 0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{engine:EngineLang 处理配置}" Style="{StaticResource PanelTitleStyle}"/>
                    <StackPanel Grid.Row="1" Margin="0 10 0 12">
                        <TextBlock Text="{Binding SelectedOption.DisplayName, TargetNullValue={engine:EngineLang 未选择处理类型}}"
                                   FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Text="{Binding SelectedOption.Description}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" Margin="0 5 0 0"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="DraftProcessConfigPanel"/>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 13 0 0">
            <Button Content="{engine:EngineLang 保存}" Padding="22 6" Click="Save_Click" IsDefault="True"/>
            <Button Content="{engine:EngineLang 取消}" Padding="22 6" Margin="8 0 0 0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
