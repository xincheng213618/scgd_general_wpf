<UserControl x:Class="ColorVision.Engine.Services.Flow.ViewFlow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ColorVision.Engine.Services.Flow"
             xmlns:flow="clr-namespace:ColorVision.Engine.Templates.Flow"
             xmlns:st="clr-namespace:ST.Library.UI.NodeEditor;assembly=ST.Library.UI"
             xmlns:properties="clr-namespace:ColorVision.Engine.Properties"
             mc:Ignorable="d"
             PreviewKeyDown="UserControl_PreviewKeyDown"
             d:DataContext="{d:DesignInstance local:ViewFlow}"
             d:DesignHeight="600" d:DesignWidth="1000"
             Background="{DynamicResource GlobalBackground}"
             Initialized="UserControl_Initialized">
    <Grid x:Name="Grid1">
        <st:STNodeEditor x:Name="STNodeEditorMain" x:FieldModifier="public"
                         LimitCanvasToContentBounds="False" ShowLocation="False"
                         ShowCanvasDragLockButton="False"
                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>



       <!-- Primary editor commands float above the canvas. -->
        <Grid Margin="0,10,0,0"
              HorizontalAlignment="Center" VerticalAlignment="Top"
              Panel.ZIndex="20">
            <Border Background="{DynamicResource GlobalBackground}"
                    BorderBrush="{DynamicResource GlobalBorderBrush}"
                    BorderThickness="1" CornerRadius="7" Opacity="0.82"/>
            <StackPanel Orientation="Horizontal" Margin="5">
                <Button Command="{Binding SaveCommand}" Width="34" Height="32"
                        Margin="2,0" Padding="3"
                        ToolTip="{x:Static properties:Resources.Save}">
                    <Image Source="{DynamicResource DrawingImageSave}" Height="20"/>
                </Button>
                <Button Command="{Binding RefreshCommand}" Width="34" Height="32"
                        Margin="2,0" Padding="3"
                        ToolTip="{x:Static properties:Resources.Refresh}">
                    <Button.Triggers>
                        <EventTrigger RoutedEvent="Button.Click">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="rotateTransform1"
                                                     Storyboard.TargetProperty="Angle"
                                                     From="0" To="360" Duration="0:0:0.5"
                                                     FillBehavior="Stop"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Button.Triggers>
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets"
                               Foreground="{DynamicResource GlobalTextBrush}" FontSize="16">
                        <TextBlock.RenderTransform>
                            <RotateTransform x:Name="rotateTransform1" CenterX="8" CenterY="8"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Button>
                <Button Command="{Binding AutoAlignmentCommand}" Width="34" Height="32"
                        Margin="2,0" Padding="3"
                        ToolTip="{x:Static properties:Resources.AutoAlign}">
                    <Button.Triggers>
                        <EventTrigger RoutedEvent="Button.Click">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="rotateTransform3"
                                                     Storyboard.TargetProperty="Angle"
                                                     From="0" To="720" Duration="0:0:0.5"
                                                     FillBehavior="Stop"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Button.Triggers>
                    <Image Source="{DynamicResource DrawingImageFlow}">
                        <Image.RenderTransform>
                            <RotateTransform x:Name="rotateTransform3" CenterX="12" CenterY="12"/>
                        </Image.RenderTransform>
                    </Image>
                </Button>
                <Button Command="{Binding AutoSizeCommand}" Width="34" Height="32"
                        Margin="2,0" Padding="3" ToolTip="适应全部节点">
                    <TextBlock Text="&#xE9A6;" FontFamily="Segoe MDL2 Assets"
                               Foreground="{DynamicResource GlobalTextBrush}" FontSize="16"/>
                </Button>
                <Button Command="{Binding ClearCommand}" Width="34" Height="32"
                        Margin="2,0" Padding="3"
                        ToolTip="{x:Static properties:Resources.Clear}">
                    <Image Source="{DynamicResource DrawingImageClear}"/>
                </Button>
                <Button Command="{Binding ExportFlowCommand}" Width="34" Height="32"
                        Margin="2,0" Padding="3"
                        ToolTip="{x:Static properties:Resources.Flow_ExportFlow}">
                    <TextBlock Text="&#xEDE1;" FontFamily="Segoe MDL2 Assets"
                               Foreground="{DynamicResource GlobalTextBrush}" FontSize="16"/>
                </Button>
                <Button Command="{Binding ImportFlowCommand}" Width="34" Height="32"
                        Margin="2,0" Padding="3"
                        ToolTip="{x:Static properties:Resources.Flow_ImportFlow}">
                    <TextBlock Text="&#xE8B5;" FontFamily="Segoe MDL2 Assets"
                               Foreground="{DynamicResource GlobalTextBrush}" FontSize="16"/>
                </Button>
                <ToggleButton x:Name="CanvasDragLockButton"
                              Width="34" Height="32"
                              Margin="2,0" Padding="3"
                              IsChecked="True"
                              ToolTip="切换画布拖动"
                              Checked="CanvasDragLockButton_Checked"
                              Unchecked="CanvasDragLockButton_Unchecked">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               FontSize="16"
                               Foreground="{DynamicResource GlobalTextBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="&#xE785;"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=CanvasDragLockButton}" Value="True">
                                        <Setter Property="Text" Value="&#xE72E;"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </ToggleButton>
            </StackPanel>
        </Grid>

        <!-- Selected-node properties return to a translucent right-side overlay. -->
        <Grid x:Name="PropertyEditorPanel" Width="360" Margin="0,54,10,108"
              HorizontalAlignment="Right" VerticalAlignment="Stretch"
              Visibility="Collapsed" Opacity="0.9" Panel.ZIndex="30">
            <Border Background="{DynamicResource GlobalBackground}"
                    BorderBrush="{DynamicResource GlobalBorderBrush}"
                    BorderThickness="1" CornerRadius="7" Opacity="0.78"/>
            <Grid >
                <flow:FlowNodePropertyPanel x:Name="InlineNodePropertyPanel"
                                            Grid.Row="1" Background="Transparent"/>
            </Grid>
        </Grid>

        <!-- Compact execution details float above the progress bar. -->
        <Grid Height="70" Margin="10,0,10,10"
              HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
              Panel.ZIndex="25">
            <Border Background="{DynamicResource GlobalBackground}"
                    BorderBrush="{DynamicResource GlobalBorderBrush}"
                    BorderThickness="1" CornerRadius="6" Opacity="0.74"/>
            <Grid Margin="6,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Margin="0,0,6,0" VerticalAlignment="Center">
                        <Button Width="50" Height="50"
                                Padding="3"
                                ToolTip="{x:Static properties:Resources.ExecutionProcess}"
                                Visibility="{Binding FlowEngineManager.FlowControl.IsFlowRun, Converter={StaticResource bool2VisibilityConverter1}}"
                                Click="Button_FlowRun_Click">
                            <TextBlock Text="&#xE768;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="30"
                                       Foreground="{DynamicResource GlobalTextBrush}"/>
                        </Button>
                        <Button Width="50" Height="50"
                                Padding="3"
                                ToolTip="{x:Static properties:Resources.StopProcess}"
                                Visibility="{Binding FlowEngineManager.FlowControl.IsFlowRun, Converter={StaticResource bool2VisibilityConverter}}"
                                Click="Button_FlowStop_Click">
                            <TextBlock Text="&#xE71A;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="30"
                                       Foreground="{DynamicResource GlobalTextBrush}"/>
                        </Button>
                    </Grid>

                    <TextBox x:FieldModifier="public" x:Name="logTextBox" Grid.Column="1"
                             Padding="2" Background="Transparent"
                             Foreground="{DynamicResource GlobalTextBrush}"
                             BorderThickness="0" TextWrapping="WrapWithOverflow"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top" IsReadOnly="True"/>

                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{x:Static properties:Resources.FlowResultManagement}" Command="{Binding FlowEngineManager.MeasureBatchManagerCommand}"  />
                            <Button Content="{x:Static properties:Resources.Flow_NodeTimeAnalysis}"  Click="Button_Click_NodeAnalysis"  />
                        </StackPanel>

                        <Button Content="{x:Static properties:Resources.ParsingManagement}"  Click="Button_Click_1"  />
                        <Button Content="{x:Static properties:Resources.PreprocessManager}" Click="Button_Click_PreProcess" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <ProgressBar x:Name="ProgressBar1" Height="8"
                     HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                     Panel.ZIndex="40"
                     Maximum="100" Style="{StaticResource ProgressBarFlat}"
                     Visibility="{Binding FlowEngineManager.FlowControl.IsFlowRun, Converter={StaticResource bool2VisibilityConverter}}"
                     Value="{Binding FlowEngineManager.BatchProgress}"/>
    </Grid>
</UserControl>
