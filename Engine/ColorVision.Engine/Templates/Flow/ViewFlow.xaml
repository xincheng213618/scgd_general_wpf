<UserControl x:Class="ColorVision.Engine.Services.Flow.ViewFlow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ColorVision.Engine.Services.Flow"
             xmlns:flow="clr-namespace:ColorVision.Engine.Templates.Flow"
             xmlns:st="clr-namespace:ST.Library.UI.NodeEditor;assembly=ST.Library.UI"
             xmlns:properties="clr-namespace:ColorVision.Engine.Properties"
             mc:Ignorable="d"
             PreviewKeyDown="UserControl_PreviewKeyDown"
             d:DataContext="{d:DesignInstance local:ViewFlow}"
             d:DesignHeight="600" d:DesignWidth="1000"
             Background="{DynamicResource GlobalBackground}"
             Initialized="UserControl_Initialized">
    <Grid x:Name="Grid1">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="170"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <st:STNodeEditor x:Name="STNodeEditorMain" x:FieldModifier="public"
                             LimitCanvasToContentBounds="False" ShowLocation="False"
                             HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

            <!-- Only the workflow management actions remain on the canvas. -->
            <Grid Width="232" Margin="10,54,0,0"
                  HorizontalAlignment="Left" VerticalAlignment="Top"
                  Panel.ZIndex="10">
                <Border Background="{DynamicResource GlobalBackground}"
                        BorderBrush="{DynamicResource GlobalBorderBrush}"
                        BorderThickness="1" CornerRadius="7" Opacity="0.92"/>
                <StackPanel Margin="8">
                <TextBlock Text="{x:Static properties:Resources.Workflow}"
                           Foreground="{DynamicResource GlobalTextBrush}"
                           FontWeight="SemiBold" Margin="3,0,3,6"/>

                <Button Content="{x:Static properties:Resources.FlowResultManagement}"
                        Command="{Binding FlowEngineManager.MeasureBatchManagerCommand}"
                        HorizontalContentAlignment="Left" Margin="0,0,0,4"/>
                <Button Content="{x:Static properties:Resources.Flow_NodeTimeAnalysis}"
                        Click="Button_Click_NodeAnalysis"
                        HorizontalContentAlignment="Left" Margin="0,0,0,4"/>
                <Button Content="{x:Static properties:Resources.ParsingManagement}"
                        Click="Button_Click_1"
                        HorizontalContentAlignment="Left" Margin="0,0,0,4"/>
                <Button Content="{x:Static properties:Resources.PreprocessManager}"
                        Click="Button_Click_PreProcess"
                        HorizontalContentAlignment="Left"/>
                </StackPanel>
            </Grid>

            <!-- Primary editor commands float above the canvas. -->
            <Grid Margin="0,10,0,0"
                  HorizontalAlignment="Center" VerticalAlignment="Top"
                  Panel.ZIndex="20">
                <Border Background="{DynamicResource GlobalBackground}"
                        BorderBrush="{DynamicResource GlobalBorderBrush}"
                        BorderThickness="1" CornerRadius="7" Opacity="0.92"/>
                <StackPanel Orientation="Horizontal" Margin="5">
                <Button Command="{Binding SaveCommand}" Width="34" Height="32"
                        Margin="2,0" Padding="3"
                        ToolTip="{x:Static properties:Resources.Save}">
                    <Image Source="{DynamicResource DrawingImageSave}" Height="20"/>
                </Button>
                <Button Command="{Binding RefreshCommand}" Width="34" Height="32"
                        Margin="2,0" Padding="3"
                        ToolTip="{x:Static properties:Resources.Refresh}">
                    <Button.Triggers>
                        <EventTrigger RoutedEvent="Button.Click">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="rotateTransform1"
                                                     Storyboard.TargetProperty="Angle"
                                                     From="0" To="360" Duration="0:0:0.5"
                                                     FillBehavior="Stop"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Button.Triggers>
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets"
                               Foreground="{DynamicResource GlobalTextBrush}" FontSize="16">
                        <TextBlock.RenderTransform>
                            <RotateTransform x:Name="rotateTransform1" CenterX="8" CenterY="8"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Button>
                <Button Command="{Binding AutoAlignmentCommand}" Width="34" Height="32"
                        Margin="2,0" Padding="3"
                        ToolTip="{x:Static properties:Resources.AutoAlign}">
                    <Button.Triggers>
                        <EventTrigger RoutedEvent="Button.Click">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="rotateTransform3"
                                                     Storyboard.TargetProperty="Angle"
                                                     From="0" To="720" Duration="0:0:0.5"
                                                     FillBehavior="Stop"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Button.Triggers>
                    <Image Source="{DynamicResource DrawingImageFlow}">
                        <Image.RenderTransform>
                            <RotateTransform x:Name="rotateTransform3" CenterX="12" CenterY="12"/>
                        </Image.RenderTransform>
                    </Image>
                </Button>
                <Button Command="{Binding AutoSizeCommand}" Width="34" Height="32"
                        Margin="2,0" Padding="3" ToolTip="适应全部节点">
                    <TextBlock Text="&#xE9A6;" FontFamily="Segoe MDL2 Assets"
                               Foreground="{DynamicResource GlobalTextBrush}" FontSize="16"/>
                </Button>
                <Button Command="{Binding ClearCommand}" Width="34" Height="32"
                        Margin="2,0" Padding="3"
                        ToolTip="{x:Static properties:Resources.Clear}">
                    <Image Source="{DynamicResource DrawingImageClear}"/>
                </Button>
                <Button Command="{Binding ExportFlowCommand}" Width="34" Height="32"
                        Margin="2,0" Padding="3"
                        ToolTip="{x:Static properties:Resources.Flow_ExportFlow}">
                    <TextBlock Text="&#xEDE1;" FontFamily="Segoe MDL2 Assets"
                               Foreground="{DynamicResource GlobalTextBrush}" FontSize="16"/>
                </Button>
                <Button Command="{Binding ImportFlowCommand}" Width="34" Height="32"
                        Margin="2,0" Padding="3"
                        ToolTip="{x:Static properties:Resources.Flow_ImportFlow}">
                    <TextBlock Text="&#xE8B5;" FontFamily="Segoe MDL2 Assets"
                               Foreground="{DynamicResource GlobalTextBrush}" FontSize="16"/>
                </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                      Background="{DynamicResource GlobalBorderBrush}"/>

        <!-- Execution details and selected-node properties share the bottom pane. -->
        <TabControl x:Name="BottomDetailsTabControl" Grid.Row="2">
            <TabItem Header="{x:Static properties:Resources.ExecutionProcess}">
                <TextBox x:FieldModifier="public" x:Name="logTextBox"
                         Padding="6" Background="Transparent"
                         Foreground="{DynamicResource GlobalTextBrush}"
                         BorderThickness="0" TextWrapping="WrapWithOverflow"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top" IsReadOnly="True"/>
            </TabItem>
            <TabItem x:Name="NodePropertyTab"
                     Header="{x:Static properties:Resources.NodeProperty}"
                     Visibility="Collapsed">
                <Grid x:Name="PropertyEditorPanel" Visibility="Collapsed">
                    <flow:FlowNodePropertyPanel x:Name="InlineNodePropertyPanel"
                                                Background="Transparent"/>
                </Grid>
            </TabItem>
        </TabControl>

        <ProgressBar x:Name="ProgressBar1" Grid.Row="3" Height="8"
                     Maximum="100" Style="{StaticResource ProgressBarFlat}"
                     Value="{Binding FlowEngineManager.BatchProgress}"/>
    </Grid>
</UserControl>
