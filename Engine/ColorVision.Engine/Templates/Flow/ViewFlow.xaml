<UserControl x:Class="ColorVision.Engine.Services.Flow.ViewFlow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ColorVision.Engine.Services.Flow"
             xmlns:flow="clr-namespace:ColorVision.Engine.Templates.Flow"
             xmlns:st="clr-namespace:ST.Library.UI.NodeEditor;assembly=ST.Library.UI"
             xmlns:properties="clr-namespace:ColorVision.Engine.Properties"
             mc:Ignorable="d"
             PreviewKeyDown="UserControl_PreviewKeyDown"
             d:DataContext="{d:DesignInstance local:ViewFlow}"
             d:DesignHeight="600" d:DesignWidth="1000"
             Background="{DynamicResource GlobalBackground}"
             Initialized="UserControl_Initialized">
    <Grid x:Name="Grid1" Margin="0,0.5,0,0">
        <!-- The editor owns the complete view; the remaining controls are overlays. -->
        <st:STNodeEditor x:Name="STNodeEditorMain" x:FieldModifier="public"
                         LimitCanvasToContentBounds="False" ShowLocation="False"
                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

        <!-- Flow actions and service logs share the left overlay. -->
        <Grid Width="232" Margin="10,54,0,18"
              HorizontalAlignment="Left" VerticalAlignment="Stretch"
              Panel.ZIndex="10">
            <Border Background="{DynamicResource GlobalBackground}"
                    BorderBrush="{DynamicResource GlobalBorderBrush}"
                    BorderThickness="1" CornerRadius="7" Opacity="0.92"/>
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="{x:Static properties:Resources.Workflow}"
                           Foreground="{DynamicResource GlobalTextBrush}"
                           FontWeight="SemiBold" Margin="3,0,3,6"/>

                <StackPanel Grid.Row="1">
                    <Button Content="{x:Static properties:Resources.FlowResultManagement}"
                            Command="{Binding FlowEngineManager.MeasureBatchManagerCommand}"
                            HorizontalContentAlignment="Left" Margin="0,0,0,4"/>
                    <Button Content="{x:Static properties:Resources.Flow_NodeTimeAnalysis}"
                            Click="Button_Click_NodeAnalysis"
                            HorizontalContentAlignment="Left" Margin="0,0,0,4"/>
                    <Button Content="{x:Static properties:Resources.ParsingManagement}"
                            Click="Button_Click_1"
                            HorizontalContentAlignment="Left" Margin="0,0,0,4"/>
                    <Button Content="{x:Static properties:Resources.PreprocessManager}"
                            Click="Button_Click_PreProcess"
                            HorizontalContentAlignment="Left"/>
                </StackPanel>

                <Separator Grid.Row="2" Margin="0,8"/>

                <Grid Grid.Row="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="{x:Static properties:Resources.Service}"
                               Foreground="{DynamicResource GlobalTextBrush}"
                               FontWeight="SemiBold" Margin="3,0,3,6"/>

                    <UniformGrid Grid.Row="1" Columns="2">
                        <Button Content="X64" Tag="ServiceLog_x64"
                                ToolTip="{x:Static properties:Resources.ServiceLogX64}"
                                Click="Button_OpenServiceLog_Click" Margin="0,0,4,4"/>
                        <Button Content="Camera" Tag="ServiceLog_Camera"
                                ToolTip="{x:Static properties:Resources.ServiceLogCamera}"
                                Click="Button_OpenServiceLog_Click" Margin="0,0,0,4"/>
                        <Button Content="Spectrum" Tag="ServiceLog_Spectrum"
                                ToolTip="{x:Static properties:Resources.ServiceLogSpectrum}"
                                Click="Button_OpenServiceLog_Click" Margin="0,0,4,4"/>
                        <Button Content="x86" Tag="ServiceLog_dev"
                                ToolTip="{x:Static properties:Resources.ServiceLogDev}"
                                Click="Button_OpenServiceLog_Click" Margin="0,0,0,4"/>
                        <Button Content="Algorithm" Tag="ServiceLog_Algorithm"
                                ToolTip="{x:Static properties:Resources.ServiceLogAlgorithm}"
                                Click="Button_OpenServiceLog_Click" Margin="0,0,4,0"/>
                        <Button Content="OLED" Tag="ServiceLog_CVOLED"
                                ToolTip="{x:Static properties:Resources.ServiceLogCVOLED}"
                                Click="Button_OpenServiceLog_Click"/>
                    </UniformGrid>

                    <TextBox x:FieldModifier="public" x:Name="logTextBox" Grid.Row="2"
                             Margin="0,8,0,0" Padding="5"
                             Background="Transparent"
                             Foreground="{DynamicResource GlobalTextBrush}"
                             BorderBrush="{DynamicResource GlobalBorderBrush}"
                             BorderThickness="1" TextWrapping="WrapWithOverflow"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top" IsReadOnly="True"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- Primary editor commands float above the canvas. -->
        <Grid Margin="0,10,0,0"
              HorizontalAlignment="Center" VerticalAlignment="Top"
              Panel.ZIndex="20">
            <Border Background="{DynamicResource GlobalBackground}"
                    BorderBrush="{DynamicResource GlobalBorderBrush}"
                    BorderThickness="1" CornerRadius="7" Opacity="0.92"/>
            <StackPanel Orientation="Horizontal" Margin="5">
                <Button Command="{Binding SaveCommand}" Width="34" Height="32"
                        Margin="2,0" Padding="3"
                        ToolTip="{x:Static properties:Resources.Save}">
                    <Image Source="{DynamicResource DrawingImageSave}" Height="20"/>
                </Button>
                <Button Command="{Binding RefreshCommand}" Width="34" Height="32"
                        Margin="2,0" Padding="3"
                        ToolTip="{x:Static properties:Resources.Refresh}">
                    <Button.Triggers>
                        <EventTrigger RoutedEvent="Button.Click">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="rotateTransform1"
                                                     Storyboard.TargetProperty="Angle"
                                                     From="0" To="360" Duration="0:0:0.5"
                                                     FillBehavior="Stop"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Button.Triggers>
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets"
                               Foreground="{DynamicResource GlobalTextBrush}" FontSize="16">
                        <TextBlock.RenderTransform>
                            <RotateTransform x:Name="rotateTransform1" CenterX="8" CenterY="8"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Button>
                <Button Command="{Binding AutoAlignmentCommand}" Width="34" Height="32"
                        Margin="2,0" Padding="3"
                        ToolTip="{x:Static properties:Resources.AutoAlign}">
                    <Button.Triggers>
                        <EventTrigger RoutedEvent="Button.Click">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="rotateTransform3"
                                                     Storyboard.TargetProperty="Angle"
                                                     From="0" To="720" Duration="0:0:0.5"
                                                     FillBehavior="Stop"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Button.Triggers>
                    <Image Source="{DynamicResource DrawingImageFlow}">
                        <Image.RenderTransform>
                            <RotateTransform x:Name="rotateTransform3" CenterX="12" CenterY="12"/>
                        </Image.RenderTransform>
                    </Image>
                </Button>
                <Button Command="{Binding AutoSizeCommand}" Width="34" Height="32"
                        Margin="2,0" Padding="3" ToolTip="适应全部节点">
                    <TextBlock Text="&#xE9A6;" FontFamily="Segoe MDL2 Assets"
                               Foreground="{DynamicResource GlobalTextBrush}" FontSize="16"/>
                </Button>
                <Button Command="{Binding ClearCommand}" Width="34" Height="32"
                        Margin="2,0" Padding="3"
                        ToolTip="{x:Static properties:Resources.Clear}">
                    <Image Source="{DynamicResource DrawingImageClear}"/>
                </Button>
                <Button Command="{Binding ExportFlowCommand}" Width="34" Height="32"
                        Margin="2,0" Padding="3"
                        ToolTip="{x:Static properties:Resources.Flow_ExportFlow}">
                    <TextBlock Text="&#xEDE1;" FontFamily="Segoe MDL2 Assets"
                               Foreground="{DynamicResource GlobalTextBrush}" FontSize="16"/>
                </Button>
                <Button Command="{Binding ImportFlowCommand}" Width="34" Height="32"
                        Margin="2,0" Padding="3"
                        ToolTip="{x:Static properties:Resources.Flow_ImportFlow}">
                    <TextBlock Text="&#xE8B5;" FontFamily="Segoe MDL2 Assets"
                               Foreground="{DynamicResource GlobalTextBrush}" FontSize="16"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- The selected node property editor is embedded in ViewFlow, not AvalonDock. -->
        <Grid x:Name="PropertyEditorPanel" Width="360" Margin="0,54,10,18"
              HorizontalAlignment="Right" VerticalAlignment="Stretch"
              Visibility="Collapsed" Panel.ZIndex="30">
            <Border Background="{DynamicResource GlobalBackground}"
                    BorderBrush="{DynamicResource GlobalBorderBrush}"
                    BorderThickness="1" CornerRadius="7" Opacity="0.95"/>
            <Grid Margin="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{x:Static properties:Resources.NodeProperty}"
                           Foreground="{DynamicResource GlobalTextBrush}"
                           FontWeight="SemiBold" Margin="5,2,5,7"/>
                <flow:FlowNodePropertyPanel x:Name="InlineNodePropertyPanel"
                                            Grid.Row="1" Background="Transparent"/>
            </Grid>
        </Grid>

        <!-- A single, unobtrusive batch progress indicator floats at the bottom. -->
        <Grid Height="10" Margin="10,0,10,8"
              HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
              IsHitTestVisible="False" Panel.ZIndex="40">
            <Border Background="{DynamicResource GlobalBackground}"
                    CornerRadius="5" Opacity="0.55"/>
            <ProgressBar x:Name="ProgressBar1" Margin="2" Height="6"
                         Maximum="100" Opacity="0.78"
                         Style="{StaticResource ProgressBarFlat}"
                         Value="{Binding FlowEngineManager.BatchProgress}"/>
        </Grid>
    </Grid>
</UserControl>
