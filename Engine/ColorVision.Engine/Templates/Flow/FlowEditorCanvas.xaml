<UserControl x:Class="ColorVision.Engine.Templates.Flow.FlowEditorCanvas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ColorVision.Engine.Templates.Flow"
             xmlns:st="clr-namespace:ST.Library.UI.NodeEditor;assembly=ST.Library.UI"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000">
    <Grid>
        <st:STNodeEditor x:Name="STNodeEditorMain"
                         LimitCanvasToContentBounds="False"
                         ShowLocation="False"
                         ShowCanvasDragLockButton="False"
                         ShowNodeShadow="False"
                         NodeCornerRadius="10"
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Stretch"/>

        <Grid Margin="0,10,0,0"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Panel.ZIndex="20">
            <Border Background="{DynamicResource GlobalBackground}"
                    BorderBrush="{DynamicResource GlobalBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Opacity="0.82"/>
            <StackPanel Orientation="Horizontal" Margin="5">
                <ContentPresenter Content="{Binding ToolbarContent, RelativeSource={RelativeSource AncestorType={x:Type local:FlowEditorCanvas}}}"
                                  VerticalAlignment="Center"/>
                <ToggleButton x:Name="CanvasDragLockButton"
                              Width="34"
                              Height="32"
                              Margin="2,0"
                              Padding="3"
                              IsChecked="True"
                              ToolTip="切换画布拖动"
                              Checked="CanvasDragLockButton_Checked"
                              Unchecked="CanvasDragLockButton_Unchecked">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               FontSize="16"
                               Foreground="{DynamicResource GlobalTextBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="&#xE785;"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=CanvasDragLockButton}" Value="True">
                                        <Setter Property="Text" Value="&#xE72E;"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </ToggleButton>
            </StackPanel>
        </Grid>

        <Grid x:Name="PropertyEditorPanel"
              Width="360"
              Margin="{Binding PropertyPanelMargin, RelativeSource={RelativeSource AncestorType={x:Type local:FlowEditorCanvas}}}"
              HorizontalAlignment="Right"
              VerticalAlignment="Stretch"
              Visibility="Collapsed"
              Opacity="0.9"
              Panel.ZIndex="30">
            <Border Background="{DynamicResource GlobalBackground}"
                    BorderBrush="{DynamicResource GlobalBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Opacity="0.78"/>
            <local:FlowNodePropertyPanel x:Name="InlineNodePropertyPanel"
                                         Background="Transparent"/>
        </Grid>
    </Grid>
</UserControl>
