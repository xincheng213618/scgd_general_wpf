<Window x:Class="ColorVision.Engine.Templates.Flow.Routing.FlowExecutionPolicyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="流程执行策略"
        Width="1320"
        Height="760"
        MinWidth="980"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource GlobalBackground}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="220"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*" MinHeight="220"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="0,0,0,10"
                Padding="10,8"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right"
                           VerticalAlignment="Center"
                           Foreground="Gray"
                           Text="{Binding RevisionText}"/>
                <StackPanel>
                    <TextBlock FontWeight="SemiBold"
                               Text="{Binding FlowKey, StringFormat=流程：{0}}"/>
                    <TextBlock Margin="0,3,0,0"
                               Foreground="Gray"
                               Text="策略保存在本机独立侧车中，不修改 STN/CVFlow。节点下拉显示标题，内部使用稳定节点 Guid。"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <GroupBox Grid.Row="1" Header="节点重试策略">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,6">
                    <Button Padding="12,4"
                            Click="AddRetry_Click"
                            Content="新增重试策略"/>
                    <Button Margin="8,0,0,0"
                            Padding="12,4"
                            Click="RemoveRetry_Click"
                            Content="删除选中项"/>
                    <TextBlock Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="Gray"
                               Text="MaxAttempts 包含首次执行；Canceled 不能自动重试。"/>
                </DockPanel>
                <DataGrid x:Name="RetryGrid"
                          Grid.Row="1"
                          ItemsSource="{Binding RetryRows}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="节点" Width="260">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox Margin="2"
                                              ItemsSource="{Binding DataContext.RetryNodeChoices, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                              DisplayMemberPath="DisplayName"
                                              SelectedValuePath="NodeId"
                                              SelectedValue="{Binding NodeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="MaxAttempts"
                                            Width="95"
                                            Binding="{Binding MaxAttempts, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                        <DataGridTextColumn Header="InitialDelayMs"
                                            Width="105"
                                            Binding="{Binding InitialDelayMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                        <DataGridTextColumn Header="Backoff"
                                            Width="80"
                                            Binding="{Binding Backoff, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                        <DataGridTextColumn Header="MaxDelayMs"
                                            Width="100"
                                            Binding="{Binding MaxDelayMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                        <DataGridTemplateColumn Header="可重试失败类型" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ItemsControl Margin="4,2"
                                                  ItemsSource="{Binding FailureKinds}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Margin="0,0,12,2"
                                                          Content="{Binding DisplayName}"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="3" Header="ERROR 路由">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,6">
                    <Button Padding="12,4"
                            Click="AddRoute_Click"
                            Content="新增错误路由"/>
                    <Button Margin="8,0,0,0"
                            Padding="12,4"
                            Click="RemoveRoute_Click"
                            Content="删除选中项"/>
                    <TextBlock Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="Gray"
                               Text="同一来源节点的同一种失败类型只能配置一个目标。"/>
                </DockPanel>
                <DataGrid x:Name="RouteGrid"
                          Grid.Row="1"
                          ItemsSource="{Binding RouteRows}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="来源节点" Width="250">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox Margin="2"
                                              ItemsSource="{Binding DataContext.RouteSourceNodeChoices, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                              DisplayMemberPath="DisplayName"
                                              SelectedValuePath="NodeId"
                                              SelectedValue="{Binding SourceNodeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="目标节点" Width="250">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox Margin="2"
                                              ItemsSource="{Binding DataContext.RouteTargetNodeChoices, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                              DisplayMemberPath="DisplayName"
                                              SelectedValuePath="NodeId"
                                              SelectedValue="{Binding TargetNodeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="TargetInputIndex"
                                            Width="120"
                                            Binding="{Binding TargetInputIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                        <DataGridTemplateColumn Header="FailureKinds" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ItemsControl Margin="4,2"
                                                  ItemsSource="{Binding FailureKinds}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Margin="0,0,12,2"
                                                          Content="{Binding DisplayName}"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center"
                       Foreground="{Binding StatusBrush}"
                       Text="{Binding StatusText}"
                       TextTrimming="CharacterEllipsis"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Margin="0,0,8,0"
                        Padding="14,5"
                        Click="Reload_Click"
                        Content="重新读取"/>
                <Button x:Name="SaveButton"
                        Margin="0,0,8,0"
                        Padding="18,5"
                        IsEnabled="{Binding CanSave}"
                        Click="Save_Click"
                        Content="保存"/>
                <Button Padding="18,5"
                        IsCancel="True"
                        Content="取消"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
