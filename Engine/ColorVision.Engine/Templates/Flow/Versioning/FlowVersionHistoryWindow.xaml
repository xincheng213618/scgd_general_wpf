<Window x:Class="ColorVision.Engine.Templates.Flow.Versioning.FlowVersionHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="本机流程版本历史"
        Width="980" Height="620"
        MinWidth="760" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource GlobalBackground}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText"
                   Margin="2,0,0,10"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource GlobalTextBrush}"/>

        <DataGrid x:Name="RevisionGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  CanUserAddRows="False"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="版本" Binding="{Binding Revision}" Width="70"/>
                <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="90"/>
                <DataGridCheckBoxColumn Header="已发布" Binding="{Binding IsPublished, Mode=OneWay}" Width="70"/>
                <DataGridTextColumn Header="时间 (UTC)" Binding="{Binding CreatedTimeUtc}" Width="155"/>
                <DataGridTextColumn Header="作者" Binding="{Binding Author}" Width="110"/>
                <DataGridTextColumn Header="内容哈希" Binding="{Binding ShortBinaryHash}" Width="120"/>
                <DataGridTextColumn Header="说明" Binding="{Binding Message}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource GlobalTextBrush}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Margin="4,0" Padding="14,5"
                        Content="对比所选两版"
                        Click="CompareButton_Click"/>
                <Button Margin="4,0" Padding="14,5"
                        Content="恢复到所选版本"
                        Click="RestoreButton_Click"/>
                <Button Margin="4,0" Padding="14,5"
                        Content="关闭"
                        IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
