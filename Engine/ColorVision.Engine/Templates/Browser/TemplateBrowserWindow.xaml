<Window x:Class="ColorVision.Engine.Templates.Browser.TemplateBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ColorVision.Engine.Templates.Browser"
        xmlns:flow="clr-namespace:ColorVision.Engine.Templates.Flow"
        xmlns:properties="clr-namespace:ColorVision.Engine.Properties"
        xmlns:engine="clr-namespace:ColorVision.Engine"
        xmlns:commands="clr-namespace:ColorVision.UI;assembly=ColorVision.Common"
        Width="940" Height="660" MinWidth="640" MinHeight="420" ShowInTaskbar="False"
        Background="{DynamicResource GlobalBackground}" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="BrowserAction" TargetType="Button" BasedOn="{StaticResource ButtonDefault}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style x:Key="BrowserViewToggle" TargetType="ToggleButton" BasedOn="{StaticResource ToggleButtonDefault}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/></Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                    <Setter Property="Background" Value="{DynamicResource SecondaryRegionBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="TemplateName">
            <Grid>
                <TextBlock Text="{Binding Key}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Key}"
                           VerticalAlignment="Center" Visibility="{Binding IsEditMode,Converter={StaticResource bool2VisibilityConverter1}}"/>
                <TextBox Text="{Binding Key,UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding Key}"
                         Visibility="{Binding IsEditMode,Converter={StaticResource bool2VisibilityConverter}}"
                         IsVisibleChanged="RenameBox_IsVisibleChanged" LostFocus="RenameBox_LostFocus" KeyDown="RenameBox_KeyDown"/>
            </Grid>
        </DataTemplate>
        <ContextMenu x:Key="TemplateContextMenu" Opened="TemplateContextMenu_Opened">
            <MenuItem Header="{x:Static properties:Resources.TemplateBrowserOpenEditor}" Click="Open_Click"/>
            <Separator/>
            <MenuItem Header="{x:Static properties:Resources.MenuRename}" Command="{x:Static commands:Commands.ReName}"/>
            <MenuItem Header="{x:Static properties:Resources.CreateCopy}" Click="Copy_Click"/>
            <MenuItem Header="{x:Static properties:Resources.MenuDelete}" Command="ApplicationCommands.Delete"/>
        </ContextMenu>
        <Style x:Key="TemplateRowItem" TargetType="ListViewItem" BasedOn="{StaticResource ListViewItemBaseStyle.Small}">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="ContextMenu" Value="{StaticResource TemplateContextMenu}"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="SwapTarget"><Setter Property="Background" Value="{DynamicResource SecondaryRegionBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/></Trigger>
            </Style.Triggers>
        </Style>
        <GridView x:Key="TemplateDetailsView" AllowsColumnReorder="False">
            <GridViewColumn Header="{x:Static properties:Resources.Choice}" Width="54">
                <GridViewColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected}" ToolTip="{x:Static properties:Resources.Choice}"/></DataTemplate></GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="{x:Static properties:Resources.SerialNumber1}" Width="80" DisplayMemberBinding="{Binding Id}"/>
            <GridViewColumn Header="{x:Static properties:Resources.Name}" Width="360" CellTemplate="{StaticResource TemplateName}"/>
        </GridView>
        <Style x:Key="TemplateTileItem" TargetType="ListViewItem">
            <Setter Property="Width" Value="{Binding TileWidth,RelativeSource={RelativeSource AncestorType=local:TemplateBrowserWindow}}"/>
            <Setter Property="Margin" Value="4,4,4,8"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="ContextMenu" Value="{StaticResource TemplateContextMenu}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Stretch"/>
                            </Border>
                            <Border x:Name="SwapBadge" Visibility="Collapsed" Background="{DynamicResource PrimaryBrush}" CornerRadius="3"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Padding="7,3" IsHitTestVisible="False">
                                <TextBlock Text="{x:Static properties:Resources.TemplateBrowserSwap}" Foreground="White" FontSize="11"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SecondaryRegionBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="Background" Value="{DynamicResource SecondaryRegionBrush}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="SwapTarget">
                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="SwapBadge" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ItemsPanelTemplate x:Key="TemplateTilePanel"><WrapPanel/></ItemsPanelTemplate>
        <ControlTemplate x:Key="TemplateTileList" TargetType="ListView">
            <Border Background="{TemplateBinding Background}">
                <ScrollViewer Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                              CanContentScroll="False">
                    <ItemsPresenter/>
                </ScrollViewer>
            </Border>
        </ControlTemplate>
        <DataTemplate x:Key="FlowTile">
            <StackPanel>
                <Grid Height="{Binding CoverHeight,RelativeSource={RelativeSource AncestorType=local:TemplateBrowserWindow}}">
                    <flow:FlowTemplateCover Flow="{Binding Value}"/>
                    <CheckBox IsChecked="{Binding IsSelected}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5"
                              ToolTip="{x:Static properties:Resources.Choice}">
                        <CheckBox.Style>
                            <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                <Setter Property="Visibility" Value="Hidden"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver,RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <Trigger Property="IsChecked" Value="True"><Setter Property="Visibility" Value="Visible"/></Trigger>
                                </Style.Triggers>
                            </Style>
                        </CheckBox.Style>
                    </CheckBox>
                </Grid>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TemplateName}" HorizontalContentAlignment="Stretch" TextBlock.TextAlignment="Center" Margin="0,7,0,0" Height="26"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="PoiTile">
            <StackPanel>
                <Grid Height="90">
                    <Canvas x:Name="PoiIcon" Width="64" Height="64" VerticalAlignment="Center" IsHitTestVisible="False">
                        <Path Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 8,22 L 8,8 22,8 M 42,8 L 56,8 56,22 M 56,42 L 56,56 42,56 M 22,56 L 8,56 8,42"/>
                        <Path Fill="{DynamicResource PrimaryBrush}" Opacity="0.7">
                            <Path.Data>
                                <GeometryGroup>
                                    <EllipseGeometry Center="20,20" RadiusX="2.5" RadiusY="2.5"/>
                                    <EllipseGeometry Center="32,20" RadiusX="2.5" RadiusY="2.5"/>
                                    <EllipseGeometry Center="44,20" RadiusX="2.5" RadiusY="2.5"/>
                                    <EllipseGeometry Center="20,32" RadiusX="2.5" RadiusY="2.5"/>
                                    <EllipseGeometry Center="44,32" RadiusX="2.5" RadiusY="2.5"/>
                                    <EllipseGeometry Center="20,44" RadiusX="2.5" RadiusY="2.5"/>
                                    <EllipseGeometry Center="32,44" RadiusX="2.5" RadiusY="2.5"/>
                                    <EllipseGeometry Center="44,44" RadiusX="2.5" RadiusY="2.5"/>
                                </GeometryGroup>
                            </Path.Data>
                        </Path>
                        <Ellipse Canvas.Left="27" Canvas.Top="27" Width="10" Height="10" Fill="{DynamicResource PrimaryBrush}"/>
                    </Canvas>
                    <CheckBox IsChecked="{Binding IsSelected}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2"
                              ToolTip="{x:Static properties:Resources.Choice}">
                        <CheckBox.Style>
                            <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                <Setter Property="Visibility" Value="Hidden"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver,RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                    <Trigger Property="IsChecked" Value="True"><Setter Property="Visibility" Value="Visible"/></Trigger>
                                </Style.Triggers>
                            </Style>
                        </CheckBox.Style>
                    </CheckBox>
                </Grid>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TemplateName}" HorizontalContentAlignment="Stretch"
                                TextBlock.TextAlignment="Center" Margin="0,5,0,0" Height="26"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="16,12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="NewButton" Command="ApplicationCommands.New" ToolTip="{x:Static properties:Resources.TemplateBrowserTemplates}" AutomationProperties.Name="{x:Static properties:Resources.TemplateBrowserTemplates}"
                        Style="{StaticResource BrowserAction}" Background="{DynamicResource PrimaryBrush}" Foreground="White" BorderBrush="Transparent">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock x:Name="NewLabel" Text="{x:Static properties:Resources.TemplateBrowserTemplates}"/></StackPanel>
                </Button>
                <Button Click="Import_Click" Content="{x:Static properties:Resources.Import}" ToolTip="{x:Static properties:Resources.TemplateBrowserImportHint}" AutomationProperties.Name="{x:Static properties:Resources.TemplateBrowserImportHint}" Style="{StaticResource BrowserAction}"/>
                <Button Click="Export_Click" Content="{x:Static properties:Resources.Export}" ToolTip="{x:Static properties:Resources.TemplateBrowserExportHint}" AutomationProperties.Name="{x:Static properties:Resources.TemplateBrowserExportHint}" Style="{StaticResource BrowserAction}"/>
            </StackPanel>
            <StackPanel>
                <TextBlock x:Name="HeadingText" Text="{x:Static properties:Resources.TemplateBrowserTemplates}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource GlobalTextBrush}"/>
                <TextBlock x:Name="CountText" FontSize="12" Margin="0,3,0,0" Foreground="{DynamicResource GlobalTextBrush}" Opacity="0.6"/>
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Height="34" HorizontalAlignment="Stretch" Margin="0,0,8,0"
                    Background="{DynamicResource ButtonBackground}" BorderThickness="1" CornerRadius="5">
                <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}"/>
                    <Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/></Trigger></Style.Triggers>
                </Style></Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource GlobalTextBrush}" Opacity="0.6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBox x:Name="SearchBox" Grid.Column="1" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="0,3"
                             ToolTip="{x:Static properties:Resources.TemplateBrowserSearchHint}" AutomationProperties.Name="{x:Static properties:Resources.TemplateBrowserSearchHint}" TextChanged="Search_TextChanged" KeyDown="Search_KeyDown"/>
                    <TextBlock x:Name="SearchPlaceholder" Grid.Column="1" Text="{x:Static properties:Resources.TemplateBrowserSearchHint}" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource GlobalTextBrush}" Opacity="0.45">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                        </Style></TextBlock.Style>
                    </TextBlock>
                    <Button Grid.Column="2" Click="ClearSearch_Click" Background="Transparent" BorderThickness="0" Padding="0" ToolTip="{x:Static properties:Resources.TemplateBrowserClearSearch}" AutomationProperties.Name="{x:Static properties:Resources.TemplateBrowserClearSearch}">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource ButtonDefault}">
                            <Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Hidden"/></DataTrigger></Style.Triggers>
                        </Style></Button.Style>
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                </Grid>
            </Border>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ToggleButton x:Name="CardsViewButton" Style="{StaticResource BrowserViewToggle}" Click="ViewMode_Click"
                              ToolTip="{engine:EngineLang TemplateBrowserCards}" AutomationProperties.Name="{engine:EngineLang TemplateBrowserCards}">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80A;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="{engine:EngineLang TemplateBrowserCards}"/></StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="ListViewButton" Style="{StaticResource BrowserViewToggle}" Click="ViewMode_Click"
                              ToolTip="{engine:EngineLang TemplateBrowserList}" AutomationProperties.Name="{engine:EngineLang TemplateBrowserList}">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="{engine:EngineLang TemplateBrowserList}"/></StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="PreviewButton" Style="{StaticResource BrowserViewToggle}" Click="Preview_Click"
                              ToolTip="{engine:EngineLang TemplateBrowserPreview}" AutomationProperties.Name="{engine:EngineLang TemplateBrowserPreview}">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A1;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="{engine:EngineLang TemplateBrowserPreview}"/></StackPanel>
                </ToggleButton>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" MinWidth="200"/><ColumnDefinition Width="Auto"/><ColumnDefinition x:Name="PreviewColumn" Width="0"/></Grid.ColumnDefinitions>
            <Grid>
            <ListView x:Name="TemplateList" Style="{StaticResource ListView.Small}" ItemContainerStyle="{StaticResource TemplateTileItem}"
                      Template="{StaticResource TemplateTileList}" ItemsPanel="{StaticResource TemplateTilePanel}"
                      BorderThickness="0" ScrollViewer.CanContentScroll="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                      PreviewMouseDoubleClick="TemplateList_DoubleClick" KeyDown="TemplateList_KeyDown" AllowDrop="True"
                      PreviewMouseLeftButtonDown="TemplateList_MouseDown" PreviewMouseMove="TemplateList_MouseMove" DragOver="TemplateList_DragOver" DragLeave="TemplateList_DragLeave" Drop="TemplateList_Drop"/>
            <TextBlock x:Name="EmptyText" Text="{x:Static properties:Resources.TemplateBrowserNoMatches}" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource GlobalTextBrush}" IsHitTestVisible="False"/>
            </Grid>
            <GridSplitter x:Name="PreviewSplitter" Grid.Column="1" Width="8" HorizontalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Visibility="Collapsed" Background="Transparent"/>
            <Border x:Name="PreviewPane" Grid.Column="2" Visibility="Collapsed" BorderBrush="{DynamicResource GlobalBorderBrush}" BorderThickness="1,0,0,0" Padding="14,0,0,0">
                <local:TemplateBrowserPreview x:Name="PreviewContent"/>
            </Border>
        </Grid>
        <Border Grid.Row="3" BorderBrush="{DynamicResource GlobalBorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="SelectionText" Foreground="{DynamicResource GlobalTextBrush}" Opacity="0.7" VerticalAlignment="Center" FontSize="12"/>
                    <Button x:Name="DeleteButton" Command="ApplicationCommands.Delete" Content="{x:Static properties:Resources.Delete}" ToolTip="{x:Static properties:Resources.TemplateBrowserDeleteHint}" AutomationProperties.Name="{x:Static properties:Resources.TemplateBrowserDeleteHint}" Style="{StaticResource BrowserAction}" Background="Transparent" BorderBrush="Transparent" Foreground="#E87979"/>
                </StackPanel>
                <TextBlock x:Name="StatusText" Grid.Column="1" Text="{x:Static properties:Resources.TemplateBrowserInteractionHint}" TextTrimming="CharacterEllipsis" Margin="14,0" FontSize="12" Opacity="0.6"
                           ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}" Foreground="{DynamicResource GlobalTextBrush}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Command="ApplicationCommands.Save" Content="{x:Static properties:Resources.Save}" ToolTip="{x:Static properties:Resources.TemplateBrowserSaveHint}" AutomationProperties.Name="{x:Static properties:Resources.TemplateBrowserSaveHint}" Style="{StaticResource BrowserAction}"/>
                    <Button Click="Close_Click" Content="{x:Static properties:Resources.Close}" ToolTip="{x:Static properties:Resources.TemplateBrowserCloseHint}" AutomationProperties.Name="{x:Static properties:Resources.TemplateBrowserCloseHint}" Style="{StaticResource BrowserAction}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
