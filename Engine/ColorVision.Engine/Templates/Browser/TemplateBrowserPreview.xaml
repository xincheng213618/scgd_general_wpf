<UserControl x:Class="ColorVision.Engine.Templates.Browser.TemplateBrowserPreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:engine="clr-namespace:ColorVision.Engine">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="{engine:EngineLang TemplateBrowserPreview}" Foreground="{DynamicResource GlobalTextBrush}" Opacity="0.6" FontSize="12" Margin="0,0,0,10"/>
            <TextBlock x:Name="PreviewTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource GlobalTextBrush}" Margin="0,0,0,12"/>
            <Border x:Name="ImageBorder" Background="#1D2025" CornerRadius="6" Padding="4" Visibility="Collapsed">
                <Image x:Name="PreviewImage" Stretch="Uniform" MaxHeight="220" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
            <ItemsControl x:Name="PreviewDetails" Margin="0,14,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="PreviewLabel"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Key}" Foreground="{DynamicResource GlobalTextBrush}" Opacity="0.6" Margin="0,0,14,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" Foreground="{DynamicResource GlobalTextBrush}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="PreviewStatus" Text="{engine:EngineLang TemplateBrowserSelectPreview}" TextWrapping="Wrap" Foreground="{DynamicResource GlobalTextBrush}" Opacity="0.65" Margin="0,10,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
