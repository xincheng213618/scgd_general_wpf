<UserControl x:Class="ColorVision.Engine.Templates.Jsons.EditTemplateJson"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:jsonEditor="clr-namespace:ColorVision.UI.PropertyEditor.Json;assembly=ColorVision.UI"
             xmlns:properties="clr-namespace:ColorVision.Engine.Properties"
             Height="560" MinWidth="480" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}"/>
        </Style>
        <Style x:Key="EditorAction" TargetType="Button">
            <Setter Property="Padding" Value="10,5"/><Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{DynamicResource GlobalBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SecondaryRegionBrush}"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.65"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.4"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="ModeTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Chrome" CornerRadius="4" Padding="{TemplateBinding Padding}" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource GlobalBackground}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.75"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource GlobalBackground}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,7">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock x:Name="EditorTitleText" Text="模板参数" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        <TextBlock x:Name="EditorSubtitleText" Text="属性与 JSON 内容同步" FontSize="11" Opacity="0.6" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <WrapPanel x:Name="FuncStackPanel" Grid.Column="1" VerticalAlignment="Center">

                    <Button x:Name="ValidateButton" Content="检查语法" Style="{StaticResource EditorAction}" Click="Validate_Click" ToolTip="检查 JSON 语法，不执行算法或完整 Schema 校验"/>
                    <Button x:Name="FormatButton" Content="格式化" Style="{StaticResource EditorAction}" Click="Format_Click" ToolTip="格式化 JSON，支持 Ctrl+Z 撤销"/>
                    <Button x:Name="SearchButton" Content="查找" Style="{StaticResource EditorAction}" Click="Search_Click" ToolTip="查找 JSON 文本 · Ctrl+F"/>
                    <Button Content="更多 ▾" Style="{StaticResource EditorAction}" Click="More_Click">
                        <Button.ContextMenu><ContextMenu>
                            <MenuItem Header="复制当前 JSON" Click="CopyJson_Click"/>
                            <MenuItem Header="在 json.cn 中打开…" Click="Button_Click_1"/>
                            <Separator/>
                            <MenuItem Header="恢复默认参数…" Click="Reset_Click"/>
                        </ContextMenu></Button.ContextMenu>
                    </Button>
                    <Button x:Name="AskCopilotButton" Content="{x:Static properties:Resources.Copilot_Ask}" Style="{StaticResource EditorAction}" Click="AskCopilotButton_Click">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{x:Static properties:Resources.ExplainTemplate}" Click="AskCopilotExplainTemplate_Click" />
                        <MenuItem Header="{x:Static properties:Resources.ExplainParameters}" Click="AskCopilotExplainParameters_Click" />
                        <MenuItem Header="{x:Static properties:Resources.CheckConfigAnomaly}" Click="AskCopilotDiagnoseTemplate_Click" />
                        <Separator />
                        <MenuItem Header="{x:Static properties:Resources.Copilot_SendWithEllipsis}" Click="AskCopilotOpenPanel_Click" />
                    </ContextMenu>
                </Button.ContextMenu>

                    </Button>
                    </WrapPanel>
                    <Border Grid.Column="2" Background="{DynamicResource SecondaryRegionBrush}" CornerRadius="5" Padding="2" VerticalAlignment="Center" Margin="4,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="PropertyModeButton" Content="参数" GroupName="EditorMode" Style="{StaticResource ModeTab}" Click="PropertyMode_Click"/>
                            <RadioButton x:Name="TextModeButton" Content="JSON" GroupName="EditorMode" Style="{StaticResource ModeTab}" Click="TextMode_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <avalonEdit:TextEditor x:Name="textEditor" Grid.Row="1" FontFamily="Consolas" FontSize="14" ShowLineNumbers="True"
                                   Background="{DynamicResource EditorBackgroundBrush}" Foreground="{DynamicResource EditorForegroundBrush}"
                                   LineNumbersForeground="{DynamicResource EditorLineNumberBrush}" Padding="12" Visibility="Collapsed"
                                   HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
            <jsonEditor:JsonPropertyEditorControl x:Name="propertyEditor" Grid.Row="1"/>
            <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Background="{DynamicResource SecondaryRegionBrush}" Padding="12,4" CornerRadius="0,0,7,7">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" Text="选择模板后开始编辑" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    <TextBlock x:Name="PositionText" Grid.Column="1" Margin="16,0,0,0" FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
