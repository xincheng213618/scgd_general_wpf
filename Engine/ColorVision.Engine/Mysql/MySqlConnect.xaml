<Window x:Class="ColorVision.Database.MySqlConnect"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ColorVision.Themes.Controls;assembly=ColorVision.Themes"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:properties="clr-namespace:ColorVision.Database.Properties;assembly=ColorVision.Database"
        Title="{x:Static properties:Resources.MysqlConnectionConfiguration}"
        Background="{DynamicResource GlobalBackground}" Width="400" SizeToContent="Height" ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </Window.Resources>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Background="{DynamicResource GlobalBorderBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="105"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{x:Static properties:Resources.Host}"/>
                <controls:IPAddressBox Grid.Column="1" Margin="0,5" AllowTextMode="True"
                                       ToolTip="{x:Static properties:Resources.Host}" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Grid.Row="1" Text="{x:Static properties:Resources.Port}"/>
                <TextBox x:Name="PortTextBox" Grid.Row="1" Grid.Column="1" Margin="0,5"
                         ToolTip="{x:Static properties:Resources.Port}" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                <TextBlock Grid.Row="2" Text="{x:Static properties:Resources.UserName}"/>
                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,5"
                         ToolTip="{x:Static properties:Resources.UserName}" Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Grid.Row="3" Text="{x:Static properties:Resources.Password}"/>
                <hc:PasswordBox x:Name="PasswordBox1" Grid.Row="3" Grid.Column="1" Margin="0,5"
                                ToolTip="{x:Static properties:Resources.Password}" ShowEyeButton="True"/>
                <TextBlock Grid.Row="4" Text="{x:Static properties:Resources.Database}"/>
                <TextBox Grid.Row="4" Grid.Column="1" Margin="0,5"
                         ToolTip="{x:Static properties:Resources.Database}" Text="{Binding Database, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
        </Border>
        <DockPanel Grid.Row="1" Margin="0,15,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="{x:Static properties:Resources.TesConnection}" Click="Test_Click" MinWidth="80"/>
            <Button DockPanel.Dock="Right" Content="{x:Static properties:Resources.Cancel}" IsCancel="True" MinWidth="70" Margin="8,0,0,0"/>
            <Button DockPanel.Dock="Right" Content="{x:Static properties:Resources.OK}" Click="Confirm_Click" IsDefault="True" MinWidth="70"/>
        </DockPanel>
    </Grid>
</Window>
