<Window x:Class="ColorVision.Database.DatabaseCleanupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ColorVision.Database"
        xmlns:engine="clr-namespace:ColorVision.Engine"
        xmlns:properties="clr-namespace:ColorVision.Engine.Properties"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:DatabaseCleanupWindowViewModel}"
        Title="{x:Static properties:Resources.DataCleanup}"
        Width="1120"
        Height="760"
        MinWidth="920"
        MinHeight="640"
        Background="{DynamicResource GlobalBackground}"
        Initialized="Window_Initialized">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <SolidColorBrush x:Key="CleanupDangerBrush" Color="#C83F49"/>

        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource TextBox.Small}">
            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CleanupCardStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <Style x:Key="CleanupBusyAwareCardStyle"
               TargetType="{x:Type Border}"
               BasedOn="{StaticResource CleanupCardStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CleanupSectionTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="CleanupSecondaryTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="CleanupActionButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="13,6"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>

        <Style x:Key="CleanupPrimaryButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource CleanupActionButtonStyle}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
        </Style>

        <Style x:Key="CleanupDangerButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource CleanupActionButtonStyle}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource CleanupDangerBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CleanupDangerBrush}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="2,0,2,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="{engine:EngineLang Key='数据库清理'}" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock Margin="0,5,0,0"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="{engine:EngineLang Key='先确认范围和备份策略，再清理历史数据或指定数据表。'}"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <Border Grid.Column="1"
                    Padding="10,5"
                    CornerRadius="12"
                    Background="{DynamicResource GlobalBorderBrush1}"
                    VerticalAlignment="Center">
                <TextBlock Text="{engine:EngineLang Key='企业数据操作'}" FontSize="12" FontWeight="SemiBold"/>
            </Border>
        </Grid>

        <TabControl Grid.Row="1"
                    ItemsSource="{Binding Sources}"
                    SelectedItem="{Binding SelectedSource}"
                    Background="Transparent"
                    BorderThickness="0">
            <TabControl.ItemTemplate>
                <DataTemplate DataType="{x:Type local:DatabaseCleanupSourceViewModel}">
                    <TextBlock Text="{Binding DisplayName}" Margin="10,3"/>
                </DataTemplate>
            </TabControl.ItemTemplate>

            <TabControl.ContentTemplate>
                <DataTemplate DataType="{x:Type local:DatabaseCleanupSourceViewModel}">
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource CleanupCardStyle}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource CleanupSectionTitleStyle}"/>
                                    <TextBlock Margin="0,5,0,0"
                                               Text="{Binding Description}"
                                               Style="{StaticResource CleanupSecondaryTextStyle}"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Margin="0,8,0,0" Text="{Binding TableSummary}" FontWeight="SemiBold"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <Button Content="{engine:EngineLang Key='刷新统计'}"
                                            Command="{Binding RefreshCommand}"
                                            Style="{StaticResource CleanupActionButtonStyle}"
                                            Margin="0,0,8,0"/>
                                    <Button Content="{Binding MigrationActionName}"
                                            Command="{Binding MigrationCommand}"
                                            Style="{StaticResource CleanupPrimaryButtonStyle}"
                                            Margin="0,0,8,0"
                                            Visibility="{Binding SupportsMigration, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <Button Content="{engine:EngineLang Key='仅创建完整备份'}"
                                            Command="{Binding BackupCommand}"
                                            Style="{StaticResource CleanupPrimaryButtonStyle}"
                                            Visibility="{Binding SupportsBackup, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource CleanupBusyAwareCardStyle}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{engine:EngineLang Key='清理策略'}" Style="{StaticResource CleanupSectionTitleStyle}" Margin="0,0,18,0"/>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{engine:EngineLang Key='保留最近'}" Margin="0,0,8,0"/>
                                        <TextBox Width="64"
                                                 Text="{Binding KeepMonthsText, UpdateSourceTrigger=PropertyChanged}"
                                                 TextAlignment="Center"/>
                                        <TextBlock Text="{engine:EngineLang Key='个月'}" Margin="8,0,12,0"/>
                                        <Button Content="{engine:EngineLang Key='清理过期数据'}"
                                                Command="{Binding CleanupHistoryCommand}"
                                                Style="{StaticResource CleanupActionButtonStyle}"/>
                                    </StackPanel>

                                    <CheckBox Grid.Column="2"
                                              Content="{engine:EngineLang Key='清理前创建完整备份（推荐）'}"
                                              IsChecked="{Binding BackupBeforeCleanup}"
                                              VerticalAlignment="Center"
                                              Margin="18,0,0,0"
                                              Visibility="{Binding SupportsBackup, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </Grid>

                                <Border Grid.Row="1"
                                        Margin="0,12,0,0"
                                        Padding="0,12,0,0"
                                        BorderBrush="{DynamicResource ButtonBorderBrush}"
                                        BorderThickness="0,1,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{engine:EngineLang Key='按表清理只处理勾选项；清理主表时需同时选择所有现存关联明细表；完全清理会清空所有可用表。'}"
                                                   Style="{StaticResource CleanupSecondaryTextStyle}"
                                                   TextWrapping="Wrap"/>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="18,0,0,0">
                                            <Button Content="{engine:EngineLang Key='清空选中表'}"
                                                    Command="{Binding CleanupSelectedCommand}"
                                                    Style="{StaticResource CleanupPrimaryButtonStyle}"
                                                    Margin="0,0,8,0"
                                                    Visibility="{Binding SupportsTableCleanup, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <Button Content="{engine:EngineLang Key='完全清理全部表'}"
                                                    Command="{Binding CleanupAllCommand}"
                                                    Style="{StaticResource CleanupDangerButtonStyle}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource CleanupBusyAwareCardStyle}" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Margin="14,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{engine:EngineLang Key='可清理数据表'}" Style="{StaticResource CleanupSectionTitleStyle}" Margin="0,0,12,0"/>
                                        <TextBlock Text="{Binding SelectionSummary}" Style="{StaticResource CleanupSecondaryTextStyle}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                Visibility="{Binding SupportsTableCleanup, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Button Content="{engine:EngineLang Key='全选可用表'}"
                                                Command="{Binding SelectAllCommand}"
                                                Style="{StaticResource CleanupActionButtonStyle}"
                                                Padding="10,3"
                                                MinHeight="26"
                                                Margin="0,0,6,0"/>
                                        <Button Content="{engine:EngineLang Key='清除选择'}"
                                                Command="{Binding ClearSelectionCommand}"
                                                Style="{StaticResource CleanupActionButtonStyle}"
                                                Padding="10,3"
                                                MinHeight="26"/>
                                    </StackPanel>
                                </Grid>

                                <DataGrid Grid.Row="1"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          CanUserResizeRows="False"
                                          CanUserSortColumns="True"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          RowHeaderWidth="0"
                                          SelectionMode="Extended"
                                          SelectionUnit="FullRow"
                                          EnableRowVirtualization="True"
                                          ItemsSource="{Binding Tables}">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="{engine:EngineLang Key='选择'}" Width="64" CanUserSort="False">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}">
                                                        <CheckBox.Style>
                                                            <Style TargetType="{x:Type CheckBox}">
                                                                <Setter Property="IsEnabled" Value="False"/>
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding DataContext.SupportsTableCleanup, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding CanSelect}" Value="True"/>
                                                                            <Condition Binding="{Binding DataContext.SupportsTableCleanup, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" Value="True"/>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="IsEnabled" Value="True"/>
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </CheckBox.Style>
                                                    </CheckBox>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="{engine:EngineLang Key='表名'}"
                                                            Binding="{Binding TableName}"
                                                            SortMemberPath="TableName"
                                                            IsReadOnly="True"
                                                            Width="*"/>
                                        <DataGridTextColumn Header="{engine:EngineLang Key='状态'}"
                                                            Binding="{Binding ExistsDisplay}"
                                                            SortMemberPath="Exists"
                                                            IsReadOnly="True"
                                                            Width="95"/>
                                        <DataGridTextColumn Header="{engine:EngineLang Key='行数'}"
                                                            Binding="{Binding RowCountDisplay}"
                                                            SortMemberPath="RowCount"
                                                            IsReadOnly="True"
                                                            Width="140"/>
                                        <DataGridTextColumn Header="{engine:EngineLang Key='占用空间'}"
                                                            Binding="{Binding SizeDisplay}"
                                                            SortMemberPath="SizeBytes"
                                                            IsReadOnly="True"
                                                            Width="140"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <Border Grid.Row="3"
                                Margin="0,10,0,0"
                                Padding="12,8"
                                CornerRadius="6"
                                Background="{DynamicResource GlobalBorderBrush1}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <ProgressBar Width="80"
                                             Height="5"
                                             Margin="0,0,12,0"
                                             IsIndeterminate="True"
                                             Foreground="{DynamicResource PrimaryBrush}"
                                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Status}" TextWrapping="Wrap"/>
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
    </Grid>
</Window>
