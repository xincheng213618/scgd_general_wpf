<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <TargetFrameworks>net10.0;net8.0;net6.0;net461</TargetFrameworks>
	  <VersionPrefix>1.5.1.1</VersionPrefix>
	  <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
	  <IncludeSymbols>True</IncludeSymbols>
	  <SymbolPackageFormat>snupkg</SymbolPackageFormat>
	  <PackageProjectUrl>https://github.com/xincheng213618/scgd_general_wpf</PackageProjectUrl>
	  <PackageReadmeFile>README.md</PackageReadmeFile>
	  <Platforms>x64;ARM64;x86;AnyCPU</Platforms>
	  <!-- 独立纯托管包的显式例外；不表示 ColorVision 宿主支持 ARM64。 -->
	  <AllowStandaloneArm64Build>true</AllowStandaloneArm64Build>
  </PropertyGroup>

	<ItemGroup>
		<None Include="README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>


</Project>
