<Window x:Class="ColorVision.ServiceHost.ServiceHostManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:logControls="clr-namespace:ColorVision.UI.LogImp.Controls;assembly=ColorVision.UI"
        Title="ColorVision 服务主机"
        Width="1240"
        Height="780"
        MinWidth="1040"
        MinHeight="660"
        Background="{DynamicResource UpdateDialog.WindowBorder}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ColorVision;component/Update/UpdateDialogTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="ServiceHost.Success" Color="#16834A" />
            <SolidColorBrush x:Key="ServiceHost.SuccessBackground" Color="#EAF6EF" />
            <SolidColorBrush x:Key="ServiceHost.Warning" Color="#9A6700" />
            <SolidColorBrush x:Key="ServiceHost.WarningBackground" Color="#FFF4CE" />
            <SolidColorBrush x:Key="ServiceHost.Error" Color="#C42B1C" />
            <SolidColorBrush x:Key="ServiceHost.ErrorBackground" Color="#FDE7E9" />

            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource UpdateDialog.TextPrimary}" />
            </Style>

            <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource UpdateDialogSecondaryButtonStyle}">
                <Setter Property="MinWidth" Value="128" />
                <Setter Property="MinHeight" Value="42" />
                <Setter Property="Margin" Value="0,0,10,10" />
                <Setter Property="Padding" Value="16,9" />
            </Style>

            <Style x:Key="CompactActionButtonStyle" TargetType="Button" BasedOn="{StaticResource UpdateDialogSecondaryButtonStyle}">
                <Setter Property="MinWidth" Value="96" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Padding" Value="12,7" />
            </Style>

            <Style x:Key="PrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource UpdateDialogPrimaryButtonStyle}">
                <Setter Property="MinWidth" Value="168" />
                <Setter Property="MinHeight" Value="46" />
                <Setter Property="Padding" Value="20,10" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="SimplePanelStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource UpdateDialog.SurfaceAlt}" />
                <Setter Property="BorderBrush" Value="{DynamicResource UpdateDialog.WeakBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="18,14" />
            </Style>

            <Style x:Key="FactLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{DynamicResource UpdateDialog.TextSecondary}" />
            </Style>

            <Style x:Key="FactValueStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,4,0,0" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource UpdateDialog.TextPrimary}" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{DynamicResource UpdateDialog.Background}">
        <Grid Margin="42,26,42,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource UpdateDialog.TextPrimary}"
                               Text="ColorVision 服务主机" />
                    <TextBlock Margin="0,6,0,0"
                               FontSize="14"
                               Foreground="{DynamicResource UpdateDialog.TextSecondary}"
                               Text="负责更新、系统集成和需要管理员权限的本机维护操作" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock x:Name="VersionBadgeText"
                               HorizontalAlignment="Right"
                               FontSize="13"
                               Foreground="{DynamicResource UpdateDialog.TextPrimary}"
                               Text="当前版本 检查中" />
                    <TextBlock x:Name="SummaryText"
                               Margin="0,4,0,0"
                               HorizontalAlignment="Right"
                               FontSize="11"
                               Foreground="{DynamicResource UpdateDialog.TextSecondary}"
                               Visibility="Collapsed" />
                    <Button x:Name="RefreshButton"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Right"
                            Content="刷新状态"
                            Style="{StaticResource CompactActionButtonStyle}"
                            Click="RefreshButton_Click" />
                </StackPanel>
            </Grid>

            <Border x:Name="HealthCard"
                    Grid.Row="1"
                    Margin="0,22,0,18"
                    Padding="18,16"
                    Background="{DynamicResource UpdateDialog.SurfaceAlt}"
                    BorderBrush="{DynamicResource UpdateDialog.WeakBorder}"
                    BorderThickness="1"
                    CornerRadius="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="HealthIconBorder"
                            Width="44"
                            Height="44"
                            VerticalAlignment="Center"
                            Background="{DynamicResource ServiceHost.SuccessBackground}"
                            CornerRadius="22">
                        <TextBlock x:Name="HealthIconText"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="19"
                                   Foreground="{DynamicResource ServiceHost.Success}"
                                   Text="&#xE930;" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,24,0" VerticalAlignment="Center">
                        <TextBlock x:Name="HealthTitleText"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource UpdateDialog.TextPrimary}"
                                   Text="正在检查服务" />
                        <TextBlock x:Name="HealthDescriptionText"
                                   Margin="0,4,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource UpdateDialog.TextSecondary}"
                                   Text="正在检查服务状态和安装文件。"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="ActionHintText"
                                   Margin="0,4,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource UpdateDialog.Accent}"
                                   Text="建议操作：刷新" />
                    </StackPanel>
                    <Button x:Name="InstallButton"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Content="安装或修复服务"
                            Style="{StaticResource PrimaryActionButtonStyle}"
                            Click="InstallButton_Click" />
                </Grid>
            </Border>

            <TabControl x:Name="ManagerTabs"
                        Grid.Row="2"
                        Background="Transparent"
                        BorderBrush="{DynamicResource UpdateDialog.WeakBorder}"
                        TextElement.Foreground="{DynamicResource UpdateDialog.TextPrimary}">
                <TabItem Header="状态与日志">
                    <Grid Margin="22,18,22,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource SimplePanelStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="1.35*" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FactLabelStyle}" Text="运行状态" />
                                    <Border x:Name="StateBadgeBorder"
                                            Margin="0,5,0,0"
                                            Padding="8,3"
                                            HorizontalAlignment="Left"
                                            Background="{DynamicResource ServiceHost.SuccessBackground}"
                                            CornerRadius="12">
                                        <TextBlock x:Name="StateText"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ServiceHost.Success}"
                                                   Text="检查中" />
                                    </Border>
                                </StackPanel>
                                <Border Grid.Column="1" Background="{DynamicResource UpdateDialog.WeakBorder}" />
                                <StackPanel Grid.Column="2" Margin="18,0">
                                    <TextBlock Style="{StaticResource FactLabelStyle}" Text="安装完整性" />
                                    <TextBlock x:Name="IntegrityText" Style="{StaticResource FactValueStyle}" Text="检查中" />
                                    <TextBlock x:Name="IntegrityDetailText"
                                               Margin="0,3,0,0"
                                               FontSize="11"
                                               Foreground="{DynamicResource UpdateDialog.TextSecondary}"
                                               Text="正在核对运行时文件"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Border Grid.Column="3" Background="{DynamicResource UpdateDialog.WeakBorder}" />
                                <StackPanel Grid.Column="4" Margin="18,0,0,0">
                                    <TextBlock Style="{StaticResource FactLabelStyle}" Text="服务连接" />
                                    <TextBlock x:Name="ConnectionText" Style="{StaticResource FactValueStyle}" Text="检查中" />
                                    <TextBlock x:Name="ServiceNameText"
                                               Margin="0,3,0,0"
                                               FontSize="11"
                                               Foreground="{DynamicResource UpdateDialog.TextSecondary}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1" Margin="0,18,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="日志" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource UpdateDialog.TextSecondary}"
                                           Text="查看服务运行、安装和当前页面的操作记录。" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox x:Name="AutoRefreshLogsCheckBox"
                                          Margin="0,0,14,0"
                                          VerticalAlignment="Center"
                                          Content="自动刷新"
                                          IsChecked="True" />
                                <Button x:Name="RefreshLogsButton"
                                        Margin="0,0,8,0"
                                        Content="刷新日志"
                                        Style="{StaticResource CompactActionButtonStyle}"
                                        Click="RefreshLogsButton_Click" />
                                <Button x:Name="OpenLogButton"
                                        Content="打开文件"
                                        Style="{StaticResource CompactActionButtonStyle}"
                                        Click="OpenLogButton_Click" />
                            </StackPanel>
                        </Grid>

                        <TabControl x:Name="LogTabs" Grid.Row="2" Background="Transparent">
                            <TabItem Header="运行日志">
                                <Grid Margin="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="ServiceLogMetaText"
                                               Margin="0,0,0,7"
                                               FontSize="11"
                                               Foreground="{DynamicResource UpdateDialog.TextSecondary}"
                                               Text="正在读取服务日志…" />
                                    <logControls:LogViewerControl x:Name="ServiceLogViewer" Grid.Row="1" />
                                </Grid>
                            </TabItem>
                            <TabItem x:Name="InstallLogTab" Header="安装记录">
                                <Grid Margin="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="InstallLogMetaText"
                                               Margin="0,0,0,7"
                                               FontSize="11"
                                               Foreground="{DynamicResource UpdateDialog.TextSecondary}"
                                               Text="正在读取安装记录…" />
                                    <logControls:LogViewerControl x:Name="InstallLogViewer" Grid.Row="1" />
                                </Grid>
                            </TabItem>
                            <TabItem Header="操作记录">
                                <logControls:LogViewerControl x:Name="LogViewer" Margin="8" />
                            </TabItem>
                        </TabControl>
                    </Grid>
                </TabItem>

                <TabItem Header="支持与诊断">
                    <Grid Margin="38,28,38,26">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="23"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource UpdateDialog.TextPrimary}"
                                           Text="支持与诊断" />
                                <TextBlock Margin="0,6,0,0"
                                           FontSize="13"
                                           Foreground="{DynamicResource UpdateDialog.TextSecondary}"
                                           Text="反馈会自动附带服务运行日志和安装记录。" />
                            </StackPanel>
                            <Button x:Name="SendFeedbackButton"
                                    Grid.Column="1"
                                    Content="发送反馈"
                                    Style="{StaticResource PrimaryActionButtonStyle}"
                                    Click="SendFeedbackButton_Click" />
                        </Grid>

                        <UniformGrid Grid.Row="1" Margin="0,28,0,0" Columns="2">
                            <Button x:Name="CopyStatusButton"
                                    Margin="0,0,10,0"
                                    MinHeight="54"
                                    Content="复制诊断摘要"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Click="CopyStatusButton_Click" />
                            <Button x:Name="OpenLogFolderButton"
                                    Margin="10,0,0,0"
                                    MinHeight="54"
                                    Content="打开日志目录"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Click="OpenLogFolderButton_Click" />
                        </UniformGrid>

                        <Border Grid.Row="2" Margin="0,28,0,0" Style="{StaticResource SimplePanelStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource UpdateDialog.TextPrimary}"
                                               Text="提交服务问题" />
                                    <TextBlock Margin="0,5,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource UpdateDialog.TextSecondary}"
                                               Text="在反馈窗口补充现场现象并检查诊断资料；右侧目录仅供人工排障。" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="OpenPackageButton"
                                            Margin="0,0,8,0"
                                            Content="程序包目录"
                                            Style="{StaticResource CompactActionButtonStyle}"
                                            Click="OpenPackageButton_Click" />
                                    <Button x:Name="OpenInstalledButton"
                                            Content="安装目录"
                                            Style="{StaticResource CompactActionButtonStyle}"
                                            Click="OpenInstalledButton_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="系统维护">
                    <Grid Margin="38,28,38,26">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="23"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource UpdateDialog.TextPrimary}"
                                       Text="系统维护" />
                            <TextBlock Margin="0,6,0,0"
                                       FontSize="13"
                                       Foreground="{DynamicResource UpdateDialog.TextSecondary}"
                                       Text="恢复服务运行、文件关联和资源管理器集成功能。" />
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,26,0,22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,30,0">
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="服务控制" />
                                <TextBlock Margin="0,5,0,14"
                                           FontSize="12"
                                           Foreground="{DynamicResource UpdateDialog.TextSecondary}"
                                           Text="更新或恢复服务；按钮会根据当前状态自动启用。" />
                                <UniformGrid Columns="2">
                                    <Button x:Name="SelfUpdateButton" Content="后台更新服务" Style="{StaticResource ActionButtonStyle}" Click="SelfUpdateButton_Click" />
                                    <Button x:Name="StartButton" Content="启动服务" Style="{StaticResource ActionButtonStyle}" Click="StartButton_Click" />
                                    <Button x:Name="StopButton" Content="停止服务" Style="{StaticResource ActionButtonStyle}" Click="StopButton_Click" />
                                    <Button x:Name="PingButton" Content="检测连接" Style="{StaticResource ActionButtonStyle}" Click="PingButton_Click" />
                                    <Button x:Name="StatusButton" Content="读取服务状态" Style="{StaticResource ActionButtonStyle}" Click="StatusButton_Click" />
                                </UniformGrid>
                            </StackPanel>
                            <Border Grid.Column="1" Background="{DynamicResource UpdateDialog.WeakBorder}" />
                            <StackPanel Grid.Column="2" Margin="30,0,0,0">
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="系统集成" />
                                <TextBlock Margin="0,5,0,14"
                                           FontSize="12"
                                           Foreground="{DynamicResource UpdateDialog.TextSecondary}"
                                           Text="修复文件打开方式和资源管理器缩略图。" />
                                <UniformGrid Columns="2">
                                    <Button x:Name="FileAssociationButton" Content="修复文件关联" Style="{StaticResource ActionButtonStyle}" Click="FileAssociationButton_Click" />
                                    <Button x:Name="RegisterThumbnailButton" Content="注册缩略图" Style="{StaticResource ActionButtonStyle}" Click="RegisterThumbnailButton_Click" />
                                    <Button x:Name="UnregisterThumbnailButton" Content="取消缩略图" Style="{StaticResource ActionButtonStyle}" Click="UnregisterThumbnailButton_Click" />
                                </UniformGrid>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="2" Style="{StaticResource SimplePanelStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource UpdateDialog.TextPrimary}"
                                               Text="高级维护" />
                                    <TextBlock Margin="0,5,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource UpdateDialog.TextSecondary}"
                                               Text="仅在排障时使用；卸载服务会使更新和系统维护功能不可用。" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="WriteMarkerButton"
                                            Margin="0,0,8,0"
                                            Content="验证写入权限"
                                            Style="{StaticResource CompactActionButtonStyle}"
                                            Click="WriteMarkerButton_Click" />
                                    <Button x:Name="UninstallButton"
                                            Content="卸载服务"
                                            Style="{StaticResource CompactActionButtonStyle}"
                                            Click="UninstallButton_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem x:Name="Com0ComTab" Header="串口驱动" Visibility="Collapsed">
                    <Grid Margin="38,28,38,26">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="23"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource UpdateDialog.TextPrimary}"
                                           Text="虚拟串口" />
                                <TextBlock x:Name="Com0ComSummaryText" Margin="0,6,0,0" Text="正在检查…" />
                                <TextBlock x:Name="Com0ComPathText"
                                           Margin="0,3,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource UpdateDialog.TextSecondary}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Button x:Name="Com0ComRefreshButton"
                                    Grid.Column="1"
                                    Content="刷新"
                                    Style="{StaticResource CompactActionButtonStyle}"
                                    Click="Com0ComRefreshButton_Click" />
                        </Grid>

                        <Border Grid.Row="1" Style="{StaticResource SimplePanelStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center" Text="端口 A" />
                                <ComboBox x:Name="Com0ComPortAComboBox"
                                          Grid.Column="1"
                                          Height="32"
                                          IsEditable="False"
                                          IsTextSearchEnabled="True"
                                          MaxDropDownHeight="320"
                                          SelectionChanged="Com0ComPortComboBox_SelectionChanged" />
                                <TextBlock Grid.Column="3" Margin="0,0,8,0" VerticalAlignment="Center" Text="端口 B" />
                                <ComboBox x:Name="Com0ComPortBComboBox"
                                          Grid.Column="4"
                                          Height="32"
                                          IsEditable="False"
                                          IsTextSearchEnabled="True"
                                          MaxDropDownHeight="320"
                                          SelectionChanged="Com0ComPortComboBox_SelectionChanged" />
                                <Button x:Name="Com0ComCreateButton"
                                        Grid.Column="6"
                                        Margin="0"
                                        Content="创建串口对"
                                        Style="{StaticResource CompactActionButtonStyle}"
                                        Click="Com0ComCreateButton_Click" />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2" Margin="0,20,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="已有串口对" />
                            <DataGrid x:Name="Com0ComPairsGrid"
                                      Grid.Row="1"
                                      Margin="0,10,0,0"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      SelectionChanged="Com0ComPairsGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="序号" Binding="{Binding PairNumber}" Width="70" />
                                    <DataGridTextColumn Header="端口 A" Binding="{Binding PortA}" Width="*" />
                                    <DataGridTextColumn Header="端口 B" Binding="{Binding PortB}" Width="*" />
                                    <DataGridTextColumn Header="内部端口 A" Binding="{Binding InternalPortA}" Width="130" />
                                    <DataGridTextColumn Header="内部端口 B" Binding="{Binding InternalPortB}" Width="130" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <DockPanel Grid.Row="2" Margin="0,10,0,0" LastChildFill="True">
                                <Button x:Name="Com0ComDeleteButton"
                                        DockPanel.Dock="Right"
                                        Margin="8,0,0,0"
                                        Content="删除所选"
                                        Style="{StaticResource CompactActionButtonStyle}"
                                        Click="Com0ComDeleteButton_Click" />
                                <TextBlock x:Name="Com0ComPairCountText"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource UpdateDialog.TextSecondary}" />
                            </DockPanel>
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</Window>
