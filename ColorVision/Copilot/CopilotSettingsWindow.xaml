<Window x:Class="ColorVision.Copilot.CopilotSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:ColorVision.Copilot"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:properties="clr-namespace:ColorVision.Properties"
        Title="Copilot 设置"
        Width="1180"
        Height="780"
        MinWidth="960"
        MinHeight="620"
        Background="{DynamicResource GlobalBackground}"
        Foreground="{DynamicResource GlobalTextBrush}" FontSize="13"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:CopilotSettingsViewModel}">
    <Window.Resources>
        <ResourceDictionary Source="CopilotSettingsStyles.xaml" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl x:Name="SettingsTabs" Grid.Row="0" Style="{StaticResource SettingsNavigationShellStyle}">
            <TabItem Header="模型与连接" Tag="管理模型连接；选择供应商预设，或使用本机 Codex。">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="224" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource SettingsSurfaceBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="12,10,10,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock VerticalAlignment="Center"
                                   Style="{StaticResource SettingsPanelTitleStyle}"
                                   Text="模型连接" />
                        <Button Grid.Column="1"
                                Padding="12,5"
                                Click="OpenAddModelButton_Click" IsEnabled="{Binding IsEditingModel}"
                                Content="添加"
                                Style="{StaticResource PrimaryActionButtonStyle}" />
                    </Grid>

                    <DockPanel Grid.Row="1" Margin="8,0,8,8" IsEnabled="{Binding IsEditingModel}">
                        <Button DockPanel.Dock="Top" Margin="0,0,0,8" Padding="8,4" Content="检测本机 Codex"
                                Command="{Binding DetectLocalCodexCommand}" ToolTip="{Binding LocalCodexStatus}" />
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Margin="0,0,8,0" Padding="10,4" Command="{Binding DuplicateProfileCommand}" Content="{x:Static properties:Resources.Copy}" IsEnabled="{Binding CanEditSelectedProfile}" />
                                <Button Padding="10,4" Command="{Binding DeleteProfileCommand}" Content="{x:Static properties:Resources.Delete}" IsEnabled="{Binding CanEditSelectedProfile}" />
                            </StackPanel>
                        </DockPanel>

                        <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource SettingsModelItemStyle}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:CopilotProfileConfig}">
                                    <Border Padding="0">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           Margin="0,0,8,0"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource GlobalTextBrush}"
                                                           Text="{Binding DisplayLabel}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Border Grid.Column="1"
                                                        Style="{StaticResource ProfileStatusPillBorderStyle}"
                                                        ToolTip="{Binding ConfigurationStatusToolTip}">
                                                    <TextBlock Style="{StaticResource ProfileStatusTextStyle}"
                                                               Text="{Binding ConfigurationStatusText}" />
                                                </Border>
                                            </Grid>
                                            <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource GlobalTextBrush}" Opacity="0.64" FontSize="11" Text="{Binding Model}" TextTrimming="CharacterEllipsis" />

                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource SettingsSurfaceBorderStyle}">
                <Grid>
                <local:CopilotAddModelControl Visibility="{Binding IsAddingModel, Converter={StaticResource BoolToVisibility}}" />
                <ScrollViewer Visibility="{Binding IsEditingModel, Converter={StaticResource BoolToVisibility}}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="24">
                        <local:CopilotCodexConnectionControl Visibility="{Binding SelectedProfile.IsLocalCodex, Converter={StaticResource BoolToVisibility}}" />
                        <StackPanel IsEnabled="{Binding CanEditSelectedProfile}">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource SettingsPanelTitleStyle}" Text="连接配置" />
                                    <TextBlock Margin="0,6,0,0" Style="{StaticResource SettingsHintTextStyle}" Text="{Binding SelectedProfile.SecondaryLabel}" />
                                </StackPanel>


                            </Grid>

                            <Border Style="{StaticResource SettingsUsageBandBorderStyle}">
                                <TextBlock Foreground="{DynamicResource GlobalTextBrush}"
                                           Opacity="0.76"
                                           Text="{Binding SelectedProfileUsageText}"
                                           TextWrapping="Wrap" />
                            </Border>

                            <StackPanel Visibility="{Binding SelectedProfile.IsLocalCodex, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Style="{StaticResource SettingsFieldLabelStyle}" Text="名称" />
                                <TextBox Margin="0,0,0,10" Text="{Binding SelectedProfile.Name, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Style="{StaticResource SettingsFieldLabelStyle}" Text="Codex 模型" />
                                <ComboBox IsEditable="True" Margin="0,0,0,6" ItemsSource="{Binding LocalCodexModels}"
                                          Text="{Binding SelectedProfile.Model, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Style="{StaticResource SettingsHintTextStyle}" TextWrapping="Wrap"
                                           Text="留空使用 Codex 默认模型；账户、可用模型与额度由本机 Codex 管理。" />
                                <CheckBox Margin="0,8,0,0" Content="此模型支持图片输入"
                                          IsChecked="{Binding SelectedProfile.SupportsImageInput, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Margin="0,10,0,0" HorizontalAlignment="Left" Padding="10,5"
                                        Content="{Binding SelectedProfileConnectionTestActionText}" Command="{Binding TestSelectedProfileCommand}" />
                                <TextBlock Margin="0,6,0,0" Style="{StaticResource SettingsHintTextStyle}"
                                           TextWrapping="Wrap" Text="{Binding SelectedProfileConnectionTestText}" />
                            </StackPanel>

                            <StackPanel Visibility="{Binding SelectedProfile.IsApiProfile, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="API Key" Style="{StaticResource SettingsFieldLabelStyle}" />
                                <Grid Margin="0,6,0,18">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <PasswordBox local:PasswordBoxBinding.BindPassword="True"
                                                 local:PasswordBoxBinding.BoundPassword="{Binding SelectedProfile.ApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Visibility="{Binding IsSelectedProfileApiKeyHidden, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBox Text="{Binding SelectedProfile.ApiKey, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsSelectedProfileApiKeyVisible, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Grid.Column="1" Margin="8,0,0,0" Padding="12,5" Command="{Binding ToggleSelectedProfileApiKeyVisibilityCommand}" Content="{Binding SelectedProfileApiKeyVisibilityText}" />
                                </Grid>
                                <TextBlock Text="当前 Windows 用户无法解密已保存的密钥，请重新输入。" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,0,12" Visibility="{Binding SelectedProfile.CredentialNeedsReentry, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="模型" Style="{StaticResource SettingsFieldLabelStyle}" />
                                <ComboBox IsEditable="True" IsTextSearchEnabled="False" ItemsSource="{Binding AvailableModelPresets}" Text="{Binding SelectedProfile.Model, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,10" />
                                <CheckBox Content="支持图片输入" IsChecked="{Binding SelectedProfile.SupportsImageInput, UpdateSourceTrigger=PropertyChanged}" ToolTip="仅在此模型和接口支持图片时开启。" Margin="0,0,0,18" />
                                <TextBlock Text="API 格式" Style="{StaticResource SettingsFieldLabelStyle}" />
                                <ComboBox ItemsSource="{Binding ProviderOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SelectedProfile.ProviderType, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,18" />
                                <TextBlock Text="接口地址 / Base URL" Style="{StaticResource SettingsFieldLabelStyle}" />
                                <TextBox Text="{Binding SelectedProfile.BaseUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,6" ToolTip="Responses 兼容服务可填写以 /responses 结尾的完整地址；普通兼容地址使用 Chat Completions。" />
                                <TextBlock Text="{Binding SelectedProfile.EndpointStatusText}" Style="{StaticResource SettingsHintTextStyle}" />
                                <DockPanel Margin="0,18,0,6">
                                    <Button DockPanel.Dock="Right" Margin="12,0,0,0" Padding="12,6" Command="{Binding TestSelectedProfileCommand}" Content="{Binding SelectedProfileConnectionTestActionText}" />
                                    <TextBlock Text="{Binding SelectedProfileConnectionTestText}" Style="{StaticResource SettingsHintTextStyle}" VerticalAlignment="Center" />
                                </DockPanel>
                                <Expander Header="连接选项" Margin="0,16,0,0">
                                    <StackPanel Margin="0,12,0,0">
                                        <TextBlock Text="显示名称" Style="{StaticResource SettingsFieldLabelStyle}" />
                                        <TextBox Text="{Binding SelectedProfile.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12" />
                                        <TextBlock Text="供应商预设" Style="{StaticResource SettingsFieldLabelStyle}" />
                                        <ComboBox ItemsSource="{Binding VendorOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SelectedProfile.VendorType, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12" />
                                        <CheckBox Content="允许向非本机 HTTP 服务发送密钥" IsChecked="{Binding SelectedProfile.AllowInsecureHttp, UpdateSourceTrigger=PropertyChanged}" ToolTip="仅用于受信的内网服务；HTTP 不加密密钥和对话内容。" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>

                            <Expander Margin="0,8,0,0"
                                      Header="高级 · 超时设置">
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock Style="{StaticResource SettingsHintTextStyle}"
                                               Text="仅影响当前模型连接；响应较慢时可增加等待时间。"
                                               TextWrapping="Wrap" />
                                    <Grid Margin="0,10,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Style="{StaticResource SettingsFieldLabelStyle}" Text="首段内容超时" />
                                        <TextBox Grid.Row="0"
                                                 Grid.Column="1"
                                                 Margin="0,0,12,10"
                                                 Text="{Binding SelectedProfile.FirstContentTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Maximum wait for the provider's first content or tool call." />
                                        <TextBlock Grid.Row="0"
                                                   Grid.Column="2"
                                                   Style="{StaticResource SettingsHintTextStyle}"
                                                   Text="秒 · 15–3,600 · 默认 180" />

                                        <TextBlock Grid.Row="1" Style="{StaticResource SettingsFieldLabelStyle}" Text="流式响应间隔" />
                                        <TextBox Grid.Row="1"
                                                 Grid.Column="1"
                                                 Margin="0,0,12,0"
                                                 Text="{Binding SelectedProfile.StreamingInactivityTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Maximum pause after streamed content has started." />
                                        <TextBlock Grid.Row="1"
                                                   Grid.Column="2"
                                                   Style="{StaticResource SettingsHintTextStyle}"
                                                   Text="秒 · 15–3,600 · 默认 120" />
                                    </Grid>
                                </StackPanel>
                            </Expander>

                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
            </TabItem>

            <TabItem Header="Agent 与工具" Tag="调整任务预算、上下文整理和技能策略。">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Border Margin="0,0,0,12" Padding="24" Style="{StaticResource SettingsSurfaceBorderStyle}">
                        <StackPanel MaxWidth="760">
                            <TextBlock Style="{StaticResource SettingsPanelTitleStyle}" Text="任务默认值" />
                            <TextBlock Margin="0,6,0,16"
                                       Style="{StaticResource SettingsHintTextStyle}"
                                       Text="Shared by every model connection. These values bound a complete Agent task; model connection and generation settings stay independent."
                                       TextWrapping="Wrap" />

                            <Border Style="{StaticResource SettingsUsageBandBorderStyle}">
                                <TextBlock Foreground="{DynamicResource GlobalTextBrush}"
                                           Opacity="0.76"
                                           Text="Long-running defaults: a 1M context window, 1M cumulative request tokens, 128 tool calls, 32 Agent passes, and a two-hour wall-clock window. Per-request overrides can still tighten a specific task."
                                           TextWrapping="Wrap" />
                            </Border>

                            <Grid Margin="0,4,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Style="{StaticResource SettingsFieldLabelStyle}" Text="上下文窗口" />
                                <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,12,10" Text="{Binding AgentContextWindowTokens, UpdateSourceTrigger=PropertyChanged}" ToolTip="Context window used by Agent compaction and Skill metadata budgeting." />
                                <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource SettingsHintTextStyle}" Text="32,768–1,048,576; default 1,048,576" />

                                <TextBlock Grid.Row="1" Style="{StaticResource SettingsFieldLabelStyle}" Text="累计请求 Token" />
                                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,12,10" Text="{Binding AgentRequestTokenBudget, UpdateSourceTrigger=PropertyChanged}" ToolTip="Cumulative provider-token budget across one Agent task." />
                                <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource SettingsHintTextStyle}" Text="4,096–1,048,576; default 1,048,576" />

                                <TextBlock Grid.Row="2" Style="{StaticResource SettingsFieldLabelStyle}" Text="自动整理上下文" />
                                <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,12,10" Orientation="Horizontal">
                                    <CheckBox VerticalAlignment="Center"
                                              IsChecked="{Binding AutoCompactConversationHistory}"
                                              ToolTip="Summarize older turns before the active history reaches its configured limit." />
                                    <TextBox Width="52"
                                             Margin="12,0,0,0"
                                             IsEnabled="{Binding AutoCompactConversationHistory}"
                                             Text="{Binding AutoCompactThresholdPercent, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Active-history percentage that triggers automatic compaction." />
                                    <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" Text="%" />
                                </StackPanel>
                                <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource SettingsHintTextStyle}" Text="50–95%; default 85%. The pending request is sent only after compaction succeeds." TextWrapping="Wrap" />

                                <TextBlock Grid.Row="3" Style="{StaticResource SettingsFieldLabelStyle}" Text="上下文整理重点" />
                                <TextBox Grid.Row="3"
                                         Grid.Column="1"
                                         Grid.ColumnSpan="2"
                                         MinHeight="56"
                                         Margin="0,0,0,10"
                                         AcceptsReturn="True"
                                         IsEnabled="{Binding AutoCompactConversationHistory}"
                                         MaxLength="{x:Static local:CopilotAgentDefaultsConfig.MaximumAutoCompactInstructionsCharacters}"
                                         Text="{Binding AutoCompactInstructions, UpdateSourceTrigger=PropertyChanged}"
                                         TextWrapping="Wrap"
                                         ToolTip="Optional persistent instructions describing details that automatic compaction must preserve. Terminal integrity rules always remain mandatory."
                                         VerticalScrollBarVisibility="Auto" />

                                <TextBlock Grid.Row="4" Style="{StaticResource SettingsFieldLabelStyle}" Text="Tool calls" />
                                <TextBox Grid.Row="4" Grid.Column="1" Margin="0,0,12,10" Text="{Binding MaxAgentToolCalls, UpdateSourceTrigger=PropertyChanged}" ToolTip="Maximum business tool calls during one Agent task." />
                                <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource SettingsHintTextStyle}" Text="1–512; default 128" />

                                <TextBlock Grid.Row="5" Style="{StaticResource SettingsFieldLabelStyle}" Text="Agent passes" />
                                <TextBox Grid.Row="5" Grid.Column="1" Margin="0,0,12,10" Text="{Binding MaxAgentPasses, UpdateSourceTrigger=PropertyChanged}" ToolTip="Maximum automatic continuation passes for an incomplete task." />
                                <TextBlock Grid.Row="5" Grid.Column="2" Style="{StaticResource SettingsHintTextStyle}" Text="1–128; default 32" />

                                <TextBlock Grid.Row="6" Style="{StaticResource SettingsFieldLabelStyle}" Text="Timeout (seconds)" />
                                <TextBox Grid.Row="6" Grid.Column="1" Margin="0,0,12,10" Text="{Binding AgentTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" ToolTip="Total wall-clock budget for one Agent task." />
                                <TextBlock Grid.Row="6" Grid.Column="2" Style="{StaticResource SettingsHintTextStyle}" Text="1–86,400; default 7,200" />

                                <TextBlock Grid.Row="7" Style="{StaticResource SettingsFieldLabelStyle}" Text="Default shell" />
                                <ComboBox Grid.Row="7"
                                          Grid.Column="1"
                                          Grid.ColumnSpan="2"
                                          ItemsSource="{Binding ShellOptions}"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding PreferredShell, UpdateSourceTrigger=PropertyChanged}"
                                          ToolTip="Default Windows shell used by approved Agent command execution." />
                            </Grid>

                            <Expander Margin="0,18,0,0"
                                      Header="{Binding AgentSkillsSummaryText}"
                                      IsExpanded="True">
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock Style="{StaticResource SettingsHintTextStyle}"
                                               Text="Overrides are independent of model profiles. Auto keeps author policy and consecutive-miss demotion; Off hides a Skill without deleting its files."
                                               TextWrapping="Wrap" />
                                    <Grid Margin="0,10,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding NewAgentSkillName, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Agent Skill name: lowercase letters, numbers, and hyphens." />
                                        <Button Grid.Column="1"
                                                Margin="8,0,0,0"
                                                Padding="12,4"
                                                Command="{Binding AddAgentSkillOverrideCommand}"
                                                Content="Add override" />
                                    </Grid>

                                    <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding AgentSkillSettings}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,0,6"
                                                            Padding="10,8"
                                                            Background="{DynamicResource GlobalBorderBrush}"
                                                            BorderBrush="{DynamicResource ButtonBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="150" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock VerticalAlignment="Center"
                                                                       FontFamily="Consolas"
                                                                       FontWeight="SemiBold"
                                                                       Text="{Binding Name}" />
                                                            <ComboBox Grid.Column="1"
                                                                      Margin="8,0"
                                                                      ItemsSource="{Binding DataContext.AgentSkillOverrideOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      DisplayMemberPath="Label"
                                                                      SelectedValuePath="State"
                                                                      SelectedValue="{Binding State, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                            <Button Grid.Column="2"
                                                                    Padding="8,3"
                                                                    Command="{Binding DataContext.RemoveAgentSkillOverrideCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Content="Reset"
                                                                    ToolTip="Reset tracked skills to Auto; remove untracked override entries." />
                                                            <TextBlock Grid.Row="1"
                                                                       Grid.ColumnSpan="3"
                                                                       Margin="0,5,0,0"
                                                                       Style="{StaticResource SettingsHintTextStyle}"
                                                                       Text="{Binding UsageSummary}"
                                                                       TextWrapping="Wrap" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <DockPanel Margin="0,8,0,0">
                                        <Button DockPanel.Dock="Right"
                                                Padding="10,3"
                                                Command="{Binding RefreshAgentSkillDiagnosticsCommand}"
                                                Content="Refresh usage"
                                                ToolTip="Reload local Skill selection and load evidence." />
                                        <TextBlock VerticalAlignment="Center"
                                                   Style="{StaticResource SettingsHintTextStyle}"
                                                   Text="Local usage evidence" />
                                    </DockPanel>
                                    <TextBox Height="96"
                                             Margin="0,6,0,0"
                                             FontFamily="Consolas"
                                             FontSize="11"
                                             HorizontalScrollBarVisibility="Auto"
                                             IsReadOnly="True"
                                             Text="{Binding AgentSkillsDiagnosticsText, Mode=OneWay}"
                                             TextWrapping="NoWrap"
                                             VerticalScrollBarVisibility="Auto" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="网页与网络" Tag="配置网页访问与网络兼容选项。">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Border Margin="0,0,0,12" Padding="24" Style="{StaticResource SettingsSurfaceBorderStyle}">
                        <StackPanel MaxWidth="760">
                            <TextBlock Style="{StaticResource SettingsPanelTitleStyle}" Text="Public web access" />
                            <TextBlock Margin="0,6,0,16"
                                       Style="{StaticResource SettingsHintTextStyle}"
                                       Text="Configure trusted Pref64 prefixes for networks where RFC 7050 discovery is unavailable or incomplete. This setting strengthens private-address detection for FetchUrl, web attachments, and search deep reads."
                                       TextWrapping="Wrap" />

                            <Border Style="{StaticResource SettingsUsageBandBorderStyle}">
                                <TextBlock Foreground="{DynamicResource GlobalTextBrush}"
                                           Opacity="0.82"
                                           Text="Normally leave this empty. Enter one IPv6 CIDR per line only when your network administrator provides its NAT64 Pref64. Supported prefix lengths are /32, /40, /48, /56, /64, and /96. Configured prefixes do not grant access to private targets."
                                           TextWrapping="Wrap" />
                            </Border>

                            <TextBlock Margin="0,6,0,6"
                                       Style="{StaticResource SettingsFieldLabelStyle}"
                                       Text="Pref64 fallback prefixes" />
                            <TextBox MinHeight="132"
                                     AcceptsReturn="True"
                                     FontFamily="Consolas"
                                     HorizontalScrollBarVisibility="Auto"
                                     Text="{Binding WebPagePref64PrefixesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="NoWrap"
                                     ToolTip="One IPv6 CIDR per line. Blank lines and comment lines are ignored."
                                     VerticalScrollBarVisibility="Auto" />
                            <TextBlock Margin="0,7,0,0"
                                       FontSize="11"
                                       Text="{Binding WebPagePref64PrefixesValidationText}"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsHintTextStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsWebPagePref64PrefixesValid}" Value="False">
                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                <Setter Property="Opacity" Value="0.95" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="MCP 服务" Tag="连接外部工具，管理 ColorVision 本地 MCP 服务。">
                <ScrollViewer Padding="10"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <local:CopilotMcpSettingsControl DataContext="{Binding}"/>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="1"
                Margin="224,16,28,20"
                Padding="0,10,0,0"
                Background="Transparent"
                BorderBrush="{DynamicResource ButtonBorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock VerticalAlignment="Center"
                           Style="{StaticResource SettingsFooterStatusTextStyle}"
                           Text="{Binding SettingsStatusText}" />
                <Button Grid.Column="1" Margin="0,0,8,0" Padding="14,6" Click="CancelButton_Click" Content="{Binding SettingsCancelButtonText}" />
                <Button Grid.Column="2"
                        Margin="0,0,8,0"
                        Padding="14,6"
                        Click="ApplyButton_Click"
                        Content="应用"
                        IsEnabled="{Binding CanApplySettings}" />
                <Button Grid.Column="3"
                        Padding="14,6"
                        Click="SaveButton_Click"
                        Content="{x:Static properties:Resources.Save}"
