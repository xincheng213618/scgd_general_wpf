<Window x:Class="ColorVision.Copilot.CopilotCodeReviewWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ColorVision.Copilot"
        Title="代码审查详情"
        Width="1040"
        Height="760"
        MinWidth="760"
        MinHeight="560"
        Background="{DynamicResource GlobalBackground}"
        Foreground="{DynamicResource GlobalTextBrush}"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CopilotStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="20"
                       FontWeight="SemiBold"
                       Text="代码审查详情" />
            <TextBlock Margin="0,4,0,0"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Text="结论与模型证据来自同一次只读 Review；这里不会重新读取或修改工作区。"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,14,0,0"
                Padding="12"
                Style="{StaticResource CopilotCardBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Margin="0,0,8,5"
                           FontWeight="SemiBold"
                           Text="目标" />
                <TextBlock Grid.Row="0" Grid.Column="1"
                           Margin="0,0,18,5"
                           Text="{Binding TargetLabel}"
                           TextWrapping="Wrap" />
                <TextBlock Grid.Row="0" Grid.Column="2"
                           Margin="0,0,8,5"
                           FontWeight="SemiBold"
                           Text="范围" />
                <TextBlock Grid.Row="0" Grid.Column="3"
                           Margin="0,0,0,5"
                           Text="{Binding ScopeLabel}"
                           TextWrapping="Wrap" />

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Margin="0,0,8,5"
                           FontWeight="SemiBold"
                           Text="仓库" />
                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                           Margin="0,0,0,5"
                           Text="{Binding RepositoryRoot}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding RepositoryRoot}" />

                <TextBlock Grid.Row="2" Grid.Column="0"
                           Margin="0,0,8,0"
                           FontWeight="SemiBold"
                           Text="证据" />
                <TextBlock Grid.Row="2" Grid.Column="1"
                           Margin="0,0,18,0"
                           Text="{Binding EvidenceLabel}"
                           TextWrapping="Wrap" />
                <TextBlock Grid.Row="2" Grid.Column="2"
                           Margin="0,0,8,0"
                           FontWeight="SemiBold"
                           Text="路径" />
                <TextBlock Grid.Row="2" Grid.Column="3"
                           Text="{Binding PathLabel}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding PathLabel}" />
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Margin="0,10,0,0"
                Padding="10,7"
                Background="{DynamicResource GlobalBorderBrush}"
                BorderBrush="#E6A23C"
                BorderThickness="1"
                CornerRadius="7"
                Visibility="{Binding HasEvidenceWarning, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding EvidenceWarning}"
                       TextWrapping="Wrap" />
        </Border>

        <TabControl Grid.Row="3" Margin="0,12,0,0">
            <TabItem Header="{Binding FindingsTabHeader}">
                <Grid>
                    <ScrollViewer Padding="12"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasFindings, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding Findings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10"
                                            Padding="12"
                                            Style="{StaticResource CopilotCardBorderStyle}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Margin="0,0,9,0"
                                                    Padding="7,2"
                                                    Background="{DynamicResource PrimaryBrush}"
                                                    CornerRadius="4">
                                                <TextBlock FontWeight="Bold"
                                                           Foreground="White"
                                                           Text="{Binding Priority}" />
                                            </Border>
                                            <TextBlock Grid.Column="1"
                                                       VerticalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding Title}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                                                       Margin="0,8,0,0"
                                                       FontFamily="Consolas"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       Text="{Binding LocationLabel}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Grid.Row="2" Grid.ColumnSpan="2"
                                                       Margin="0,8,0,0"
                                                       Text="{Binding Body}"
                                                       TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Border Margin="12"
                            Padding="16"
                            Style="{StaticResource CopilotCardBorderStyle}"
                            Visibility="{Binding ShowFindingsStatus, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="{Binding FindingsStatusText}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="审查结论">
                <ScrollViewer Padding="12"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <local:CopilotMarkdownView Markdown="{Binding ConclusionText, Mode=OneWay}" />
                </ScrollViewer>
            </TabItem>
            <TabItem Header="模型可见 Diff">
                <TextBox Margin="0"
                         Padding="12,10"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         Background="{DynamicResource GlobalBackground}"
                         BorderThickness="0"
                         FontFamily="Consolas"
                         FontSize="12"
                         Foreground="{DynamicResource GlobalTextBrush}"
                         HorizontalScrollBarVisibility="Auto"
                         IsReadOnly="True"
                         Text="{Binding DiffText, Mode=OneWay}"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" />
            </TabItem>
            <TabItem Header="模型证据原文">
                <TextBox Margin="0"
                         Padding="12,10"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         Background="{DynamicResource GlobalBackground}"
                         BorderThickness="0"
                         FontFamily="Consolas"
                         FontSize="12"
                         Foreground="{DynamicResource GlobalTextBrush}"
                         HorizontalScrollBarVisibility="Auto"
                         IsReadOnly="True"
                         Text="{Binding ModelObservationText, Mode=OneWay}"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" />
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="4"
                    Margin="0,14,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button MinWidth="92"
                    Margin="0,0,8,0"
                    Padding="12,6"
                    Click="CopyFindingsButton_Click"
                    Content="复制 Findings" />
            <Button MinWidth="92"
                    Margin="0,0,8,0"
                    Padding="12,6"
                    Click="CopyConclusionButton_Click"
                    Content="复制结论" />
            <Button MinWidth="92"
                    Margin="0,0,8,0"
                    Padding="12,6"
                    Click="CopyDiffButton_Click"
                    Content="复制 Diff" />
            <Button MinWidth="104"
                    Margin="0,0,8,0"
                    Padding="12,6"
                    Click="CopyModelObservationButton_Click"
                    Content="复制证据原文" />
            <Button MinWidth="92"
                    Padding="12,6"
                    Click="CloseButton_Click"
                    Content="关闭"
                    IsCancel="True"
                    Style="{StaticResource CopilotPrimaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
