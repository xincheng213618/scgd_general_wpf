<Window x:Class="ColorVision.Copilot.CopilotModelEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:display="clr-namespace:ColorVision" Title="编辑模型配置" Width="680" SizeToContent="Height" MaxHeight="820"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource GlobalBackground}" Foreground="{DynamicResource GlobalTextBrush}" FontSize="14">
    <Window.Resources><ResourceDictionary Source="CopilotSettingsStyles.xaml" /></Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="26">
            <TextBlock Text="{display:DisplayText Key='编辑模型配置'}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,24" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <TextBlock Text="{display:DisplayText Key='智能配置'}" VerticalAlignment="Center" Margin="0,0,18,0" />
                <CheckBox IsChecked="{Binding SmartConfiguration}" Style="{StaticResource SettingsToggleStyle}" AutomationProperties.Name="智能配置" />
            </StackPanel>
            <TextBlock Text="模型 ID" Style="{StaticResource SettingsFieldLabelStyle}" />
            <ComboBox ItemsSource="{Binding ModelPresets}" IsEditable="True" IsTextSearchEnabled="False" Text="{Binding ModelId, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,20" />
            <TextBlock Text="{display:DisplayText Key='上下文窗口'}" Style="{StaticResource SettingsFieldLabelStyle}" />
            <TextBox Text="{Binding ContextWindowText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditCapabilities}" Margin="0,8,0,20" />
            <TextBlock Text="{display:DisplayText Key='最大输出 Token'}" Style="{StaticResource SettingsFieldLabelStyle}" />
            <TextBox Text="{Binding MaxOutputText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditOutputLimit}" Margin="0,8,0,8" />
            <TextBlock Text="{Binding OutputLimitHint}" Style="{StaticResource SettingsHintTextStyle}" TextWrapping="Wrap" Margin="0,0,0,6" />
            <TextBlock Text="{Binding DefaultsHint}" Style="{StaticResource SettingsHintTextStyle}" TextWrapping="Wrap" />
            <Expander Header="{display:DisplayText Key='高级配置'}" Margin="0,20,0,0">
                <StackPanel Margin="12">
                    <CheckBox Content="{display:DisplayText Key='支持视觉（图片输入）'}" IsChecked="{Binding SupportsImages}" IsEnabled="{Binding CanEditCapabilities}" Margin="0,0,0,16" />
                    <TextBlock Text="{display:DisplayText Key='首段内容超时（秒）'}" Style="{StaticResource SettingsFieldLabelStyle}" />
                    <TextBox Text="{Binding Draft.FirstContentTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12" />
                    <TextBlock Text="{display:DisplayText Key='流式响应间隔（秒）'}" Style="{StaticResource SettingsFieldLabelStyle}" />
                    <TextBox Text="{Binding Draft.StreamingInactivityTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" />
                </StackPanel>
            </Expander>
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,14,0,0" />
            <DockPanel Margin="0,22,0,0">
                <Button Content="{display:DisplayText Key='重置表单'}" Click="Reset_Click" Padding="10,6" DockPanel.Dock="Left" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{display:DisplayText Key='取消'}" IsCancel="True" Padding="16,7" Margin="0,0,12,0" />
                    <Button Content="{display:DisplayText Key='保存'}" Click="Save_Click" IsDefault="True" Padding="16,7" Style="{StaticResource PrimaryActionButtonStyle}" />
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
