<Window x:Class="ColorVision.Copilot.CopilotActionReviewWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认受保护操作"
        Width="780"
        Height="700"
        MinWidth="620"
        MinHeight="520"
        Background="{DynamicResource GlobalBackground}"
        Foreground="{DynamicResource GlobalTextBrush}"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CopilotStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="True">
            <Border DockPanel.Dock="Right"
                    Margin="12,0,0,0"
                    Padding="8,3"
                    Background="{DynamicResource GlobalBorderBrush}"
                    BorderBrush="{DynamicResource ButtonBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                <TextBlock FontSize="11"
                           FontWeight="SemiBold"
                           Text="{Binding RiskDisplayLabel}" />
            </Border>
            <StackPanel>
                <TextBlock FontSize="19"
                           FontWeight="SemiBold"
                           Text="{Binding Title}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Margin="0,4,0,0"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="请核对来源、作用域和下方完整执行详情；关闭窗口或按 Esc 都不会批准。"
                           TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1"
                Margin="0,14,0,0"
                Padding="12"
                Style="{StaticResource CopilotCardBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Margin="0,0,8,5"
                           FontWeight="SemiBold"
                           Text="来源" />
                <TextBlock Grid.Row="0" Grid.Column="1"
                           Margin="0,0,18,5"
                           Text="{Binding RequesterLabel}"
                           TextWrapping="Wrap" />
                <TextBlock Grid.Row="0" Grid.Column="2"
                           Margin="0,0,8,5"
                           FontWeight="SemiBold"
                           Text="任务" />
                <TextBlock Grid.Row="0" Grid.Column="3"
                           Margin="0,0,0,5"
                           Text="{Binding TaskScopeLabel}"
                           TextWrapping="Wrap" />

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Margin="0,0,8,5"
                           FontWeight="SemiBold"
                           Text="工作区" />
                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                           Margin="0,0,0,5"
                           Text="{Binding WorkspaceLabel}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding WorkspaceLabel}" />

                <TextBlock Grid.Row="2" Grid.Column="0"
                           Margin="0,0,8,5"
                           FontWeight="SemiBold"
                           Text="影响" />
                <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
                           Margin="0,0,0,5"
                           Text="{Binding ImpactLabel}"
                           TextWrapping="Wrap" />

                <TextBlock Grid.Row="3" Grid.Column="0"
                           Margin="0,0,8,0"
                           FontWeight="SemiBold"
                           Text="撤销" />
                <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3"
                           Text="{Binding ReversibilityLabel}"
                           TextWrapping="Wrap" />
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Margin="0,12,0,0"
                Padding="12"
                Style="{StaticResource CopilotCardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Right"
                               Margin="12,0,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="{Binding ReviewDeadlineLabel}" />
                    <TextBlock FontSize="14"
                               FontWeight="SemiBold"
                               Text="{Binding ReviewDetailsHeading}" />
                </DockPanel>
                <TextBlock Grid.Row="1"
                           Margin="0,4,0,8"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="该区域只在本机待审批对象中展示，不会写入普通审计或复制确认载荷。"
                           TextWrapping="Wrap" />
                <TextBox x:Name="ReviewDetailsTextBox"
                         Grid.Row="2"
                         MinHeight="180"
                         Padding="10,8"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         Background="{DynamicResource GlobalBackground}"
                         BorderBrush="{DynamicResource ButtonBorderBrush}"
                         FontFamily="Consolas"
                         FontSize="12"
                         Foreground="{DynamicResource GlobalTextBrush}"
                         FlowDirection="LeftToRight"
                         HorizontalScrollBarVisibility="Auto"
                         IsReadOnly="True"
                         Text="{Binding ReviewDisplayText, Mode=OneWay}"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" />
            </Grid>
        </Border>

        <Expander Grid.Row="3"
                  Margin="0,10,0,0"
                  Header="技术详情"
                  Foreground="{DynamicResource GlobalTextBrush}">
            <StackPanel Margin="10,6,0,0">
                <TextBlock Text="{Binding Description}"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,4,0,0"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="{Binding ToolName, StringFormat=工具：{0}}"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,3,0,0"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="{Binding ActionId, StringFormat=操作 ID：{0}}"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,3,0,0"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="{Binding ArgumentsSummary, StringFormat=脱敏参数摘要：{0}}"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,3,0,0"
                           FontFamily="Consolas"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="{Binding ArgumentsDigest, StringFormat=完整参数指纹（SHA-256）：{0}}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Expander>

        <CheckBox x:Name="ReviewAcknowledgementCheckBox"
                  Grid.Row="4"
                  Margin="0,12,0,0"
                  Checked="ReviewAcknowledgementCheckBox_Changed"
                  Content="我已完整核对上方执行详情，确认它符合当前任务意图。"
                  Foreground="{DynamicResource GlobalTextBrush}"
                  Unchecked="ReviewAcknowledgementCheckBox_Changed"
                  Visibility="{Binding HasReviewDetails, Converter={StaticResource BoolToVisibility}}" />

        <StackPanel Grid.Row="5"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button MinWidth="92"
                    Margin="0,0,8,0"
                    Padding="12,6"
                    Content="取消"
                    IsCancel="True" />
            <Button x:Name="ApproveButton"
                    MinWidth="118"
                    Padding="12,6"
                    Click="ApproveButton_Click"
                    Content="批准并继续"
                    Style="{StaticResource CopilotPrimaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
