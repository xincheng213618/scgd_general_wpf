<UserControl x:Class="ColorVision.Copilot.CopilotChatPanel"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ColorVision.Copilot"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:properties="clr-namespace:ColorVision.Properties"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:CopilotChatViewModel}" d:Height="500" d:Width="600">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CopilotStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="bool2VisibilityConverter" />
        <SolidColorBrush x:Key="CopilotExecutionFailureBrush" Color="#DB3340" />
        <SolidColorBrush x:Key="CopilotControlBrush" Color="#6EA8FF" />
        <SolidColorBrush x:Key="CopilotControlSurfaceBrush" Color="#226EA8FF" />
        <SolidColorBrush x:Key="CopilotControlBorderBrush" Color="#526EA8FF" />
        <SolidColorBrush x:Key="CopilotControlMutedBrush" Color="#9CA3AF" />
        <SolidColorBrush x:Key="CopilotControlMutedSurfaceBrush" Color="#1F9CA3AF" />
        <SolidColorBrush x:Key="CopilotControlMutedBorderBrush" Color="#3A9CA3AF" />
        <SolidColorBrush x:Key="CopilotControlWarningBrush" Color="#D6A84E" />
        <SolidColorBrush x:Key="CopilotControlWarningSurfaceBrush" Color="#22D6A84E" />
        <SolidColorBrush x:Key="CopilotControlWarningBorderBrush" Color="#52D6A84E" />
        <SolidColorBrush x:Key="CopilotControlDangerBrush" Color="#F87171" />
        <SolidColorBrush x:Key="CopilotControlDangerSurfaceBrush" Color="#22F87171" />
        <SolidColorBrush x:Key="CopilotControlDangerBorderBrush" Color="#52F87171" />
        <Style x:Key="AssistantPlainTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="None" />
            <Setter Property="Opacity" Value="0.94" />
        </Style>
        <Style x:Key="ReadOnlyMessageTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="IsReadOnlyCaretVisible" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style x:Key="MessageActionButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}" />
            <Setter Property="Opacity" Value="0.54" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.84" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.28" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ComposerSelectorToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="MaxWidth" Value="180" />
            <Setter Property="Padding" Value="4,0,2,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ComposerPopoverRowToggleStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="0">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource GlobalBorderBrush1}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource GlobalBorderBrush1}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ComposerPopoverButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="0">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource GlobalBorderBrush1}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.76" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ComposerPopoverListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource GlobalBorderBrush1}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource GlobalBorderBrush1}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CopilotIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource GlobalBorderBrush1}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.76" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ComposerPrimaryActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="UserMessageTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource ReadOnlyMessageTextBoxStyle}">
            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="UserMessageMetaTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}" />
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <Style x:Key="UserMessageActionButtonStyle" TargetType="Button" BasedOn="{StaticResource MessageActionButtonStyle}">
            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}" />
            <Setter Property="Opacity" Value="0.68" />
        </Style>
        <Style x:Key="CopilotSurfaceBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
        </Style>
        <Style x:Key="CopilotInsetBorderStyle" TargetType="Border" BasedOn="{StaticResource CopilotSurfaceBorderStyle}">
            <Setter Property="Background" Value="{DynamicResource GlobalBorderBrush}" />
        </Style>
        <Style x:Key="CopilotPillBorderStyle" TargetType="Border" BasedOn="{StaticResource CopilotInsetBorderStyle}">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style x:Key="ComposerShellBorderStyle" TargetType="Border" BasedOn="{StaticResource CopilotSurfaceBorderStyle}">
            <Setter Property="Background" Value="{DynamicResource GlobalBackground}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="McpStatusPillBorderStyle" TargetType="Border" BasedOn="{StaticResource CopilotPillBorderStyle}">
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="Background" Value="{StaticResource CopilotControlSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CopilotControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Opacity" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMcpEnabled}" Value="False">
                    <Setter Property="Background" Value="{StaticResource CopilotControlMutedSurfaceBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource CopilotControlMutedBorderBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasPendingMcpActions}" Value="True">
                    <Setter Property="Background" Value="{StaticResource CopilotControlWarningSurfaceBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource CopilotControlWarningBorderBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasRecentMcpFailures}" Value="True">
                    <Setter Property="Background" Value="{StaticResource CopilotControlDangerSurfaceBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource CopilotControlDangerBorderBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ControlModeTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource CopilotControlBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMcpEnabled}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource CopilotControlMutedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasPendingMcpActions}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource CopilotControlWarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasRecentMcpFailures}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource CopilotControlDangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ExecutionSummaryPillBorderStyle" TargetType="Border">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Opacity" Value="0.62" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsExecutionInProgress}" Value="True">
                    <Setter Property="Opacity" Value="0.7" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasExecutionFailures}" Value="True">
                    <Setter Property="Opacity" Value="0.72" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ExecutionSummaryTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}" />
            <Setter Property="Opacity" Value="0.78" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasExecutionFailures}" Value="True">
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Opacity" Value="0.86" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TraceExpanderStyle" TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton x:Name="HeaderSite"
                                          Padding="0"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Left"
                                          Background="Transparent"
                                          BorderBrush="Transparent"
                                          BorderThickness="0"
                                          Cursor="Hand"
                                          FocusVisualStyle="{x:Null}"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="HeaderChrome"
                                                Padding="0,3"
                                                Background="Transparent">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="16" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"
                                                                  HorizontalAlignment="Left"
                                                                  VerticalAlignment="Center"
                                                                  Content="{TemplateBinding Content}"
                                                                  ContentTemplate="{TemplateBinding ContentTemplate}" />
                                                <TextBlock x:Name="Chevron"
                                                           Grid.Column="1"
                                                           Margin="4,0,0,0"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource GlobalTextBrush}"
                                                           Opacity="0.42"
                                                           Text="›" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="Text" Value="⌄" />
                                                <Setter TargetName="Chevron" Property="Opacity" Value="0.58" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter ContentSource="Header" />
                            </ToggleButton>
                            <Border Height="1"
                                    Margin="0,4,0,0"
                                    Background="{DynamicResource GlobalBorderBrush1}" />
                            <ContentPresenter x:Name="ExpandSite"
                                              Margin="0,8,0,0"
                                              ContentSource="Content"
                                              Visibility="Collapsed" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AttachmentChipBorderStyle" TargetType="Border">
            <Setter Property="Width" Value="168" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="3,2" />
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
        </Style>
        <Style x:Key="AttachmentContentButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.56" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AttachmentCloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}" />
            <Setter Property="Opacity" Value="0.42" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="999">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource GlobalBorderBrush1}" />
                                <Setter Property="Opacity" Value="0.82" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="McpActionMetaPillBorderStyle" TargetType="Border" BasedOn="{StaticResource CopilotPillBorderStyle}">
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="Background" Value="{DynamicResource GlobalBorderBrush1}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Opacity" Value="0.82" />
        </Style>
        <Style x:Key="McpActionDeadlinePillBorderStyle" TargetType="Border" BasedOn="{StaticResource McpActionMetaPillBorderStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsExpiringSoon}" Value="True">
                    <Setter Property="Background" Value="{StaticResource CopilotExecutionFailureBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource CopilotExecutionFailureBrush}" />
                    <Setter Property="Opacity" Value="0.94" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="McpActionMetaTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}" />
            <Setter Property="Opacity" Value="0.72" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="McpActionDeadlineTextStyle" TargetType="TextBlock" BasedOn="{StaticResource McpActionMetaTextStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsExpiringSoon}" Value="True">
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Opacity" Value="0.96" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SidebarListBoxItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="10,2" />
        </Style>
        <Style x:Key="CompactHistoryButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Padding="10,7"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource GlobalBorderBrush1}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="WorkspaceChangedFileTemplate">
            <Button Margin="0,0,0,4"
                    HorizontalAlignment="Left"
                    Command="{Binding DataContext.OpenWorkspaceChangeFileCommand, Source={x:Reference Root}}"
                    CommandParameter="{Binding}"
                    Style="{StaticResource MessageActionButtonStyle}"
                    ToolTip="{Binding FilePath}"
                    ToolTipService.ShowOnDisabled="True">
                <TextBlock MaxWidth="420"
                           FontSize="11"
                           Text="{Binding DisplayLabel}"
                           TextTrimming="CharacterEllipsis" />
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="AgentTraceEntryTemplate">
            <Expander Margin="0,1,0,4" Style="{StaticResource TraceExpanderStyle}">
                <Expander.Header>
                    <Grid ToolTip="{Binding ActivityDescription}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="EntryActivityGlyph"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{DynamicResource GlobalTextBrush}"
                                   Opacity="0.48"
                                   Text="{Binding ActivityGlyph}" />
                        <TextBlock x:Name="EntryActivityLabel"
                                   Grid.Column="1"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{DynamicResource GlobalTextBrush}"
                                   Opacity="0.6"
                                   Text="{Binding ActivityLabel}" />
                        <TextBlock Grid.Column="2"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="10"
                                   Foreground="{DynamicResource GlobalTextBrush}"
                                   Opacity="0.5"
                                   Text="{Binding ActivityProgressLabel}" />
                        <TextBlock Grid.Column="3"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="10"
                                   Foreground="{DynamicResource GlobalTextBrush}"
                                   Opacity="0.38"
                                   Text="{Binding ActivityDurationLabel}" />
                    </Grid>
                </Expander.Header>
                <StackPanel Margin="18,0,0,2">
                    <TextBlock Margin="0,0,0,5"
                               FontSize="11"
                               Foreground="{DynamicResource GlobalTextBrush}"
                               Opacity="0.58"
                               Text="{Binding ActivityDescription}"
                               TextWrapping="Wrap" />
                    <ItemsControl Margin="0,0,0,2"
                                  ItemTemplate="{StaticResource WorkspaceChangedFileTemplate}"
                                  ItemsSource="{Binding WorkspaceChangedFiles}"
                                  Visibility="{Binding HasWorkspaceChangedFiles, Converter={StaticResource bool2VisibilityConverter}}" />
                    <TextBox Style="{StaticResource ReadOnlyMessageTextBoxStyle}"
                             FontSize="10"
                             Opacity="0.42"
                             Text="{Binding DiagnosticDetails, Mode=OneWay}" />
                    <Button Margin="0,6,0,0"
                            HorizontalAlignment="Left"
                            Content="撤销这次修改"
                            Command="{Binding DataContext.RequestWorkspaceRollbackCommand, Source={x:Reference Root}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource MessageActionButtonStyle}"
                            ToolTip="请求 Agent 安全回滚这一整个文件变更集；执行前仍需再次批准。"
                            Visibility="{Binding CanRequestWorkspaceRollback, Converter={StaticResource bool2VisibilityConverter}}" />
                </StackPanel>
            </Expander>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFailure}" Value="True">
                    <Setter TargetName="EntryActivityGlyph" Property="Foreground" Value="{StaticResource CopilotControlDangerBrush}" />
                    <Setter TargetName="EntryActivityLabel" Property="Foreground" Value="{StaticResource CopilotControlDangerBrush}" />
                    <Setter TargetName="EntryActivityLabel" Property="Opacity" Value="0.82" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="AgentTraceGroupTemplate">
            <Expander Margin="0,1,0,4" Style="{StaticResource TraceExpanderStyle}">
                <Expander.Header>
                    <Grid ToolTip="{Binding ActivityDescription}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="GroupActivityGlyph"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{DynamicResource GlobalTextBrush}"
                                   Opacity="0.48"
                                   Text="{Binding ActivityGlyph}" />
                        <TextBlock x:Name="GroupActivityLabel"
                                   Grid.Column="1"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource GlobalTextBrush}"
                                   Opacity="0.66"
                                   Text="{Binding ActivityLabel}" />
                        <TextBlock Grid.Column="2"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="10"
                                   Foreground="{DynamicResource GlobalTextBrush}"
                                   Opacity="0.5"
                                   Text="{Binding ActivityProgressLabel}" />
                        <TextBlock Grid.Column="3"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="10"
                                   Foreground="{DynamicResource GlobalTextBrush}"
                                   Opacity="0.38"
                                   Text="{Binding ActivityDurationLabel}" />
                    </Grid>
                </Expander.Header>
                <StackPanel Margin="18,0,0,2">
                    <StackPanel Visibility="{Binding IsSingle, Converter={StaticResource bool2VisibilityConverter}}">
                        <TextBlock Margin="0,0,0,5"
                                   FontSize="11"
                                   Foreground="{DynamicResource GlobalTextBrush}"
                                   Opacity="0.58"
                                   Text="{Binding FirstEntry.ActivityDescription}"
                                   TextWrapping="Wrap" />
                        <ItemsControl Margin="0,0,0,2"
                                      ItemTemplate="{StaticResource WorkspaceChangedFileTemplate}"
                                      ItemsSource="{Binding FirstEntry.WorkspaceChangedFiles}"
                                      Visibility="{Binding FirstEntry.HasWorkspaceChangedFiles, Converter={StaticResource bool2VisibilityConverter}}" />
                        <TextBox Style="{StaticResource ReadOnlyMessageTextBoxStyle}"
                                 FontSize="10"
                                 Opacity="0.42"
                                 Text="{Binding FirstEntry.DiagnosticDetails, Mode=OneWay}" />
                        <Button Margin="0,6,0,0"
                                HorizontalAlignment="Left"
                                Content="撤销这次修改"
                                Command="{Binding DataContext.RequestWorkspaceRollbackCommand, Source={x:Reference Root}}"
                                CommandParameter="{Binding FirstEntry}"
                                Style="{StaticResource MessageActionButtonStyle}"
                                ToolTip="请求 Agent 安全回滚这一整个文件变更集；执行前仍需再次批准。"
                                Visibility="{Binding FirstEntry.CanRequestWorkspaceRollback, Converter={StaticResource bool2VisibilityConverter}}" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Entries}"
                                  ItemTemplate="{StaticResource AgentTraceEntryTemplate}"
                                  Visibility="{Binding IsMultiple, Converter={StaticResource bool2VisibilityConverter}}" />
                </StackPanel>
            </Expander>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFailure}" Value="True">
                    <Setter TargetName="GroupActivityGlyph" Property="Foreground" Value="{StaticResource CopilotControlDangerBrush}" />
                    <Setter TargetName="GroupActivityLabel" Property="Foreground" Value="{StaticResource CopilotControlDangerBrush}" />
                    <Setter TargetName="GroupActivityLabel" Property="Opacity" Value="0.82" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource GlobalBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="SidebarColumnDefinition" Width="232" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    MinHeight="28"
                    Margin="12,0"
                    BorderBrush="{DynamicResource ButtonBorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource GlobalTextBrush}"
                                   Text="{Binding SelectedConversation.Title, FallbackValue={x:Static properties:Resources.CopilotNewConversation}, TargetNullValue={x:Static properties:Resources.CopilotNewConversation}}"
                                   TextTrimming="CharacterEllipsis" />
                        <Button Margin="0,3,0,0"
                                Padding="0"
                                HorizontalAlignment="Left"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Command="{Binding OpenBranchOriginCommand}"
                                CommandParameter="{Binding SelectedConversation}"
                                Content="↩ 返回源会话"
                                Foreground="{DynamicResource GlobalTextBrush}"
                                FontSize="10"
                                Opacity="0.62"
                                ToolTip="返回创建此分支的直接源会话；如果中间分支已删除，则返回仍存在的根会话。"
                                Visibility="{Binding SelectedConversation.HasBranchOrigin, Converter={StaticResource bool2VisibilityConverter}}" />
                        <TextBlock Margin="0,3,0,0"
                                   FontSize="10"
                                   Foreground="{StaticResource CopilotControlBrush}"
                                   Text="{Binding SelectedConversation.GoalDisplayText}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding SelectedConversation.GoalToolTip}"
                                   Visibility="{Binding SelectedConversation.HasGoal, Converter={StaticResource bool2VisibilityConverter}}" />
                        <Button Margin="0,3,0,0"
                                Padding="0"
                                HorizontalAlignment="Left"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Command="{Binding OpenAgentRunNoticeCommand}"
                                Foreground="{DynamicResource GlobalTextBrush}"
                                FontSize="10"
                                Opacity="0.62"
                                Content="{Binding AgentRunNoticeText}"
                                ToolTip="打开或查看 Agent 任务状态"
                                Visibility="{Binding HasAgentRunNotice, Converter={StaticResource bool2VisibilityConverter}}" />
                        <Button Margin="0,3,0,0"
                                Padding="0"
                                HorizontalAlignment="Left"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Command="{Binding OpenCompletionNoticeCommand}"
                                Foreground="{StaticResource CopilotControlBrush}"
                                FontSize="10"
                                Opacity="0.72"
                                Content="{Binding CompletionNoticeText}"
                                ToolTip="打开最新的子代理结果或后台命令输出"
                                Visibility="{Binding HasCompletionNotice, Converter={StaticResource bool2VisibilityConverter}}" />
                        <TextBlock Margin="0,3,0,0"
                                   FontSize="10"
                                   Foreground="{StaticResource CopilotControlWarningBrush}"
                                   Text="{Binding StateRecoveryNoticeText}"
                                   TextWrapping="Wrap"
                                   ToolTip="{Binding StateRecoveryNoticeToolTip}"
                                   Visibility="{Binding HasStateRecoveryNotice, Converter={StaticResource bool2VisibilityConverter}}" />
                        <Grid Margin="0,3,0,0"
                              ToolTip="{Binding StatePersistenceNoticeToolTip}"
                              Visibility="{Binding HasStatePersistenceNotice, Converter={StaticResource bool2VisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="10"
                                       Foreground="{StaticResource CopilotControlWarningBrush}"
                                       Text="{Binding StatePersistenceNoticeText}"
                                       TextWrapping="Wrap" />
                            <Button Grid.Column="1"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource MessageActionButtonStyle}"
                                    Command="{Binding RetryStatePersistenceCommand}"
                                    Content="重试保存"
                                    Foreground="{StaticResource CopilotControlWarningBrush}"
                                    ToolTip="立即重新保存当前 Copilot 会话" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button x:Name="TitleBarConversationButton"
                                Margin="0,0,6,0"
                                Style="{StaticResource CopilotIconButtonStyle}"
                                Click="ToggleConversationSidebarButton_Click"
                                ToolTip="{x:Static properties:Resources.CopilotExpandConversationList}"
                                Visibility="Collapsed">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       FontSize="15"
                                       Text="&#xE8A7;" />
                        </Button>

                        <Button x:Name="ConversationBranchFamilyButton"
                                Margin="0,0,6,0"
                                Padding="6,2"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderBrush="{DynamicResource ButtonBorderBrush}"
                                Click="ConversationBranchFamilyButton_Click"
                                Content="{Binding ConversationBranchFamilyLabel}"
                                FontSize="10"
                                Foreground="{DynamicResource GlobalTextBrush}"
                                IsEnabled="{Binding CanSwitchConversation}"
                                Opacity="0.72"
                                ToolTip="打开当前根会话及其全部分支；会话切换不会继承其他分支的运行状态、授权或 checkpoint。"
                                Visibility="{Binding HasConversationBranchFamily, Converter={StaticResource bool2VisibilityConverter}}">
                            <Button.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                             ItemsSource="{Binding ConversationBranchFamily}">
                                    <ContextMenu.ItemContainerStyle>
                                        <Style TargetType="{x:Type MenuItem}">
                                            <Setter Property="Header" Value="{Binding DisplayLabel}" />
                                            <Setter Property="IsCheckable" Value="True" />
                                            <Setter Property="IsChecked" Value="{Binding IsCurrent, Mode=OneWay}" />
                                            <EventSetter Event="Click" Handler="ConversationBranchFamilyMenuItem_Click" />
                                        </Style>
                                    </ContextMenu.ItemContainerStyle>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>

                        <Button Margin="0,0,6,0"
                                Style="{StaticResource CopilotIconButtonStyle}"
                                Command="{Binding OpenConversationFindCommand}"
                                ToolTip="查找当前会话 (Ctrl+F)">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Text="&#xE721;" />
                        </Button>

                        <Button Margin="0,0,6,0"
                                Style="{StaticResource CopilotIconButtonStyle}"
                                Command="{Binding NewChatCommand}"
                                IsEnabled="{Binding CanSwitchConversation}"
                                ToolTip="新建会话 (Ctrl+N)">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Text="&#xE710;" />
                        </Button>

                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Margin="18,12,18,0"
                        Padding="12,10"
                        Style="{StaticResource CopilotInsetBorderStyle}"
                        BorderThickness="1"
                        CornerRadius="12"
                        ToolTip="{Binding PendingActionPanelToolTip}"
                        Visibility="{Binding HasPendingActionPanel, Converter={StaticResource bool2VisibilityConverter}}">
                    <StackPanel>
                        <StackPanel>
                            <TextBlock VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource GlobalTextBrush}"
                                       Text="{Binding PendingActionPanelTitle}" />
                            <TextBlock Margin="0,2,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       Foreground="{DynamicResource GlobalTextBrush}"
                                       Opacity="0.62"
                                       Text="{Binding PendingActionPanelSummary}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBlock Margin="0,6,0,0"
                                   Foreground="{DynamicResource GlobalTextBrush}"
                                   Opacity="0.72"
                                   Text="{Binding PendingActionFeedbackText}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasPendingActionFeedback, Converter={StaticResource bool2VisibilityConverter}}" />

                        <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding PendingActions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8"
                                            Padding="10,8"
                                            Style="{StaticResource CopilotSurfaceBorderStyle}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0">
                                                <DockPanel LastChildFill="True">
                                                    <StackPanel DockPanel.Dock="Right"
                                                                Margin="8,0,0,0"
                                                                Orientation="Horizontal">
                                                        <Border Margin="0,0,6,0"
                                                                MaxWidth="150"
                                                                Style="{StaticResource McpActionMetaPillBorderStyle}">
                                                            <TextBlock Style="{StaticResource McpActionMetaTextStyle}"
                                                                       Text="{Binding RiskDisplayLabel}" />
                                                        </Border>
                                                        <Border MaxWidth="170"
                                                                Style="{StaticResource McpActionDeadlinePillBorderStyle}"
                                                                ToolTip="{Binding ExpiresAtLabel, StringFormat={}{0} 到期}">
                                                            <TextBlock Style="{StaticResource McpActionDeadlineTextStyle}"
                                                                       Text="{Binding ReviewDeadlineLabel}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock FontWeight="SemiBold"
                                                               Foreground="{DynamicResource GlobalTextBrush}"
                                                               Text="{Binding Title}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                                <WrapPanel Margin="0,6,0,0">
                                                    <TextBlock FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource GlobalTextBrush}"
                                                               Opacity="0.68"
                                                               Text="来源：" />
                                                    <TextBlock Margin="0,0,12,0"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource GlobalTextBrush}"
                                                               Opacity="0.72"
                                                               Text="{Binding RequesterLabel}" />
                                                    <TextBlock FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource GlobalTextBrush}"
                                                               Opacity="0.68"
                                                               Text="任务：" />
                                                    <TextBlock Margin="0,0,12,0"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource GlobalTextBrush}"
                                                               Opacity="0.72"
                                                               Text="{Binding TaskScopeLabel}" />
                                                </WrapPanel>
                                                <TextBlock Margin="0,3,0,0"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource GlobalTextBrush}"
                                                           Opacity="0.64"
                                                           Text="{Binding WorkspaceLabel, StringFormat=工作区：{0}}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding WorkspaceLabel}" />
                                                <TextBlock Margin="0,3,0,0"
                                                           Foreground="{DynamicResource GlobalTextBrush}"
                                                           Opacity="0.74"
                                                           Text="{Binding Description}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Margin="0,3,0,0"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource GlobalTextBrush}"
                                                           Opacity="0.68"
                                                           Text="{Binding ImpactLabel, StringFormat=影响：{0}}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Margin="0,3,0,0"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource GlobalTextBrush}"
                                                           Opacity="0.68"
                                                           Text="{Binding ReversibilityLabel, StringFormat=撤销：{0}}"
                                                           TextWrapping="Wrap" />
                                                <Expander Margin="0,5,0,0"
                                                          Header="技术详情"
                                                          FontSize="11"
                                                          Foreground="{DynamicResource GlobalTextBrush}">
                                                    <StackPanel Margin="10,4,0,0">
                                                        <TextBlock Opacity="0.58"
                                                                   Text="{Binding ToolName, StringFormat=工具：{0}}"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Margin="0,2,0,0"
                                                                   Opacity="0.58"
                                                                   Text="{Binding ActionId, StringFormat=操作 ID：{0}}"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Margin="0,2,0,0"
                                                                   Opacity="0.58"
                                                                   Text="{Binding ArgumentsSummary, StringFormat=参数：{0}}"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Margin="0,2,0,0"
                                                                   FontFamily="Consolas"
                                                                   Opacity="0.58"
                                                                   Text="{Binding ArgumentsDigest, StringFormat=参数指纹（SHA-256）：{0}}"
                                                                   TextWrapping="Wrap" />
                                                        <WrapPanel Margin="0,5,0,0">
                                                            <Button Margin="0,0,6,0"
                                                                    Padding="8,3"
                                                                    Command="{Binding DataContext.CopyPendingActionIdCommand, Source={x:Reference Root}}"
                                                                    CommandParameter="{Binding}"
                                                                    Content="复制 ID" />
                                                            <Button Padding="8,3"
                                                                    Command="{Binding DataContext.CopyPendingActionPayloadCommand, Source={x:Reference Root}}"
                                                                    CommandParameter="{Binding}"
                                                                    Content="复制确认载荷" />
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </Expander>
                                            </StackPanel>

                                            <WrapPanel Grid.Row="1"
                                                       Margin="0,8,0,0"
                                                       HorizontalAlignment="Right">
                                                <Button Margin="0,0,6,6"
                                                        Padding="10,4"
                                                         Command="{Binding DataContext.ApprovePendingActionCommand, Source={x:Reference Root}}"
                                                         CommandParameter="{Binding}"
                                                         Content="审查并批准"
                                                         ToolTip="先核对来源、任务、工作区、影响和撤销方式，再批准操作。" />
                                                <Button Margin="0,0,6,6"
                                                        Padding="10,4"
                                                         Command="{Binding DataContext.RejectPendingActionCommand, Source={x:Reference Root}}"
                                                         CommandParameter="{Binding}"
                                                         Content="拒绝"
                                                         ToolTip="拒绝这个受保护操作。" />
                                            </WrapPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1"
                        Margin="18,8,18,0"
                        Padding="8,5"
                        Style="{StaticResource CopilotInsetBorderStyle}"
                        BorderThickness="1"
                        CornerRadius="7"
                        Visibility="{Binding IsConversationFindOpen, Converter={StaticResource bool2VisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="12"
                                   Foreground="{DynamicResource GlobalTextBrush}"
                                   Opacity="0.5"
                                   Text="&#xE721;" />
                        <TextBox x:Name="ConversationFindTextBox"
                                 Grid.Column="1"
                                 Margin="7,0,8,0"
                                 Padding="0"
                                 VerticalContentAlignment="Center"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontSize="11"
                                 Foreground="{DynamicResource GlobalTextBrush}"
                                 MaxLength="256"
                                 PreviewKeyDown="ConversationFindTextBox_PreviewKeyDown"
                                 Text="{Binding ConversationFindText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="查找当前会话可见内容；Enter 下一个，Shift+Enter 上一个，Esc 关闭" />
                        <TextBlock Grid.Column="2"
                                   MinWidth="52"
                                   Margin="0,0,6,0"
                                   VerticalAlignment="Center"
                                   FontSize="10"
                                   Foreground="{DynamicResource GlobalTextBrush}"
                                   Opacity="0.58"
                                   Text="{Binding ConversationFindStatusText}"
                                   TextAlignment="Right" />
                        <Button Grid.Column="3"
                                Margin="0,0,3,0"
                                Style="{StaticResource AttachmentCloseButtonStyle}"
                                Command="{Binding FindPreviousConversationMatchCommand}"
                                Content="↑"
                                ToolTip="上一个匹配项 (Shift+Enter)" />
                        <Button Grid.Column="4"
                                Margin="0,0,3,0"
                                Style="{StaticResource AttachmentCloseButtonStyle}"
                                Command="{Binding FindNextConversationMatchCommand}"
                                Content="↓"
                                ToolTip="下一个匹配项 (Enter)" />
                        <Button Grid.Column="5"
                                Style="{StaticResource AttachmentCloseButtonStyle}"
                                Command="{Binding CloseConversationFindCommand}"
                                Content="×"
                                ToolTip="关闭查找 (Esc)" />
                    </Grid>
                </Border>

                <TextBlock x:Name="EmptyStateTextBlock"
                           Grid.Row="2"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           MaxWidth="320"
                           Foreground="{DynamicResource GlobalTextBrush}"
                           Opacity="0.68"
                           Text="{Binding EmptyStateText}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />

                <StackPanel x:Name="CompactHistoryPanel"
                            Grid.Row="2"
                            MaxWidth="620"
                            Margin="24,34,24,18"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Top"
                            Visibility="Collapsed">
                    <DockPanel Margin="0,0,0,8" LastChildFill="False">
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource GlobalTextBrush}"
                                   Opacity="0.82"
                                   Text="{x:Static properties:Resources.CopilotConversations}" />
                        <TextBlock DockPanel.Dock="Right"
                                   Margin="16,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource GlobalTextBrush}"
                                   Opacity="0.46"
                                   Text="{Binding CompactHistoryFooterText}"
                                   Visibility="{Binding HasCompactHistoryOverflow, Converter={StaticResource bool2VisibilityConverter}}" />
                    </DockPanel>

                    <ItemsControl ItemsSource="{Binding CompactHistoryConversations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:CopilotConversationRecord}">
                                <Button Style="{StaticResource CompactHistoryButtonStyle}"
                                        Command="{Binding DataContext.SelectConversationCommand, Source={x:Reference Root}}"
                                        CommandParameter="{Binding}"
                                        IsEnabled="{Binding DataContext.CanSwitchConversation, Source={x:Reference Root}}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0"
                                                   Grid.Column="0"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource GlobalTextBrush}"
                                                   Text="{Binding Title}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="0"
                                                   Grid.Column="1"
                                                   Margin="12,0,0,0"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource GlobalTextBrush}"
                                                   Opacity="0.44"
                                                   Text="{Binding UpdatedLabel}" />
                                        <TextBlock Grid.Row="1"
                                                   Grid.ColumnSpan="2"
                                                   Margin="0,3,0,0"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource GlobalTextBrush}"
                                                   Opacity="0.58"
                                                   Text="{Binding PreviewText}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <ListBox x:Name="MessagesListBox"
                         Grid.Row="2"
                         Padding="{Binding MessageListPadding}"
                         Background="Transparent"
                         BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         ItemsSource="{Binding Messages}"
                         ScrollViewer.CanContentScroll="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.ScrollChanged="MessagesScrollViewer_ScrollChanged"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ListBoxItem}">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="IsTabStop" Value="False" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="MaxWidth" Value="880" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                        <Border x:Name="ConversationFindHighlight"
                                                Padding="0"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="0"
                                                CornerRadius="7">
                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsConversationFindMatch}" Value="True">
                                                <Setter TargetName="ConversationFindHighlight"
                                                        Property="Background"
                                                        Value="{DynamicResource GlobalBorderBrush1}" />
                                                <Setter TargetName="ConversationFindHighlight"
                                                        Property="Padding"
                                                        Value="4" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsCurrentConversationFindMatch}" Value="True">
                                                <Setter TargetName="ConversationFindHighlight"
                                                        Property="BorderBrush"
                                                        Value="{StaticResource CopilotControlBrush}" />
                                                <Setter TargetName="ConversationFindHighlight"
                                                        Property="BorderThickness"
                                                        Value="1" />
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:CopilotChatMessage}">
                                <Grid Margin="{Binding DataContext.MessageItemMargin, Source={x:Reference Root}}">
                                    <Border x:Name="UserBubble"
                                            MaxWidth="680"
                                            Padding="{Binding DataContext.UserMessagePadding, Source={x:Reference Root}}"
                                            HorizontalAlignment="Right"
                                            Background="{DynamicResource GlobalBorderBrush1}"
                                            BorderBrush="{DynamicResource ButtonBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Visibility="Collapsed">
                                        <StackPanel>
                                            <TextBox Style="{StaticResource UserMessageTextBoxStyle}"
                                                     Text="{Binding Content, Mode=OneWay}" />
                                            <ItemsControl Margin="0,6,0,0"
                                                          ItemsSource="{Binding Attachments}"
                                                          Visibility="{Binding HasAttachments, Converter={StaticResource bool2VisibilityConverter}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type local:CopilotAttachmentItem}">
                                                        <Border Margin="0,0,5,4"
                                                                Padding="6,2"
                                                                Background="{DynamicResource GlobalBorderBrush}"
                                                                CornerRadius="4"
                                                                ToolTip="{Binding TooltipText}">
                                                            <DockPanel LastChildFill="False">
                                                                <TextBlock VerticalAlignment="Center"
                                                                           FontSize="9"
                                                                           Foreground="{DynamicResource GlobalTextBrush}"
                                                                           Opacity="0.45"
                                                                           Text="{Binding BadgeText}" />
                                                                <TextBlock Margin="5,0,0,0"
                                                                           MaxWidth="150"
                                                                           VerticalAlignment="Center"
                                                                           FontSize="10"
                                                                           Foreground="{DynamicResource GlobalTextBrush}"
                                                                           Opacity="0.72"
                                                                           Text="{Binding DisplayLabel}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <Button Margin="5,0,0,0"
                                                                        Style="{StaticResource AttachmentCloseButtonStyle}"
                                                                        Command="{Binding DataContext.OpenAttachmentCommand, Source={x:Reference Root}}"
                                                                        CommandParameter="{Binding}"
                                                                        Content="↗"
                                                                        ToolTip="查看附件" />
                                                            </DockPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <DockPanel Margin="0,5,0,0" LastChildFill="False">
                                                <TextBlock DockPanel.Dock="Left"
                                                           VerticalAlignment="Center"
                                                           FontSize="10"
                                                           Style="{StaticResource UserMessageMetaTextStyle}"
                                                           Text="{Binding TimeLabel}"
                                                           Visibility="{Binding DataContext.ShowMessageTimestamps, Source={x:Reference Root}, Converter={StaticResource bool2VisibilityConverter}}" />
                                                <StackPanel DockPanel.Dock="Right"
                                                            HorizontalAlignment="Right"
                                                            Orientation="Horizontal">
                                                    <Button Style="{StaticResource UserMessageActionButtonStyle}"
                                                            Command="{Binding DataContext.CopyMessageCommand, Source={x:Reference Root}}"
                                                            CommandParameter="{Binding}"
                                                            Content="{x:Static properties:Resources.Copy}"
                                                            ToolTip="{x:Static properties:Resources.CopilotCopyMessage}" />
                                                    <Button Style="{StaticResource UserMessageActionButtonStyle}"
                                                            Command="{Binding DataContext.EditMessageCommand, Source={x:Reference Root}}"
                                                            CommandParameter="{Binding}"
                                                            Click="EditMessageButton_Click"
                                                            Content="编辑"
                                                            ToolTip="编辑这条请求并替换最新回复" />
                                                    <Button Margin="0"
                                                            Style="{StaticResource UserMessageActionButtonStyle}"
                                                    Command="{Binding DataContext.RetryMessageCommand, Source={x:Reference Root}}"
                                                    CommandParameter="{Binding}"
                                                    Content="{Binding RetryActionLabel}"
                                                    ToolTip="{Binding RetryActionToolTip}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel x:Name="AssistantPanel"
                                                Margin="0"
                                                Visibility="Collapsed">
                                        <Expander Margin="0,8,0,2"
                                                  IsExpanded="{Binding IsThinkingExpanded, Mode=TwoWay}">
                                            <Expander.Style>
                                                <Style TargetType="Expander" BasedOn="{StaticResource TraceExpanderStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding HasThinkingTrace}" Value="True" />
                                                                <Condition Binding="{Binding HasLegacyResponseLayout}" Value="False" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Expander.Style>
                                            <Expander.Header>
                                                <Border Padding="0" Style="{StaticResource ExecutionSummaryPillBorderStyle}">
                                                    <TextBlock VerticalAlignment="Center"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource GlobalTextBrush}"
                                                               Opacity="0.72"
                                                               Text="{Binding ThinkingHeader}"
                                                               ToolTip="{Binding ThinkingSummaryToolTip}" />
                                                </Border>
                                            </Expander.Header>
                                        </Expander>

                                        <ItemsControl ItemsSource="{Binding VisibleResponseTimelineItems}"
                                                      Visibility="{Binding HasResponseTimeline, Converter={StaticResource bool2VisibilityConverter}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <local:CopilotMarkdownView Markdown="{Binding Markdown, Mode=OneWay}"
                                                                                   Visibility="{Binding IsMarkdown, Converter={StaticResource bool2VisibilityConverter}}" />
                                                        <ContentControl Margin="0,4,0,0"
                                                                        Content="{Binding ToolGroup}"
                                                                        ContentTemplate="{StaticResource AgentTraceGroupTemplate}"
                                                                        Focusable="False">
                                                            <ContentControl.Style>
                                                                <Style TargetType="ContentControl">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding IsToolGroup}" Value="True" />
                                                                                <Condition Binding="{Binding DataContext.IsThinkingExpanded, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ContentControl.Style>
                                                        </ContentControl>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <local:CopilotMarkdownView Markdown="{Binding Content, Mode=OneWay}"
                                                                   Visibility="{Binding HasLegacyResponseLayout, Converter={StaticResource bool2VisibilityConverter}}" />

                                        <Expander Margin="0,8,0,0"
                                                  Style="{StaticResource TraceExpanderStyle}"
                                                  Visibility="{Binding HasWorkspaceDiff, Converter={StaticResource bool2VisibilityConverter}}">
                                            <Expander.Header>
                                                <Border Padding="0" Style="{StaticResource ExecutionSummaryPillBorderStyle}">
                                                    <TextBlock VerticalAlignment="Center"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource GlobalTextBrush}"
                                                               Opacity="0.72"
                                                               Text="{Binding WorkspaceDiffHeader}" />
                                                </Border>
                                            </Expander.Header>
                                            <Border Margin="0,5,0,0"
                                                    Padding="8,6"
                                                    Background="{DynamicResource GlobalBorderBrush}"
                                                    CornerRadius="6">
                                                <TextBox MaxHeight="360"
                                                         FontFamily="Consolas"
                                                         FontSize="10"
                                                         HorizontalScrollBarVisibility="Auto"
                                                         Style="{StaticResource ReadOnlyMessageTextBoxStyle}"
                                                         Text="{Binding WorkspaceDiff, Mode=OneWay}"
                                                         TextWrapping="NoWrap"
                                                         VerticalScrollBarVisibility="Auto" />
                                            </Border>
                                        </Expander>

                                        <Border Margin="0,8,0,0"
                                                Padding="10,7"
                                                Background="{DynamicResource GlobalBorderBrush}"
                                                BorderBrush="#E6A23C"
                                                BorderThickness="1"
                                                CornerRadius="7"
                                                Visibility="{Binding HasResponseInterruption, Converter={StaticResource bool2VisibilityConverter}}">
                                            <DockPanel LastChildFill="True">
                                                <Button DockPanel.Dock="Right"
                                                        Margin="10,0,0,0"
                                                        Padding="10,3"
                                                        Command="{Binding DataContext.RetryMessageCommand, Source={x:Reference Root}}"
                                                        CommandParameter="{Binding}"
                                                        Content="{Binding RetryActionLabel}"
                                                        Style="{StaticResource MessageActionButtonStyle}"
                                                        ToolTip="{Binding RetryActionToolTip}" />
                                                <TextBlock VerticalAlignment="Center"
                                                           FontSize="11"
                                                           Foreground="#E6A23C"
                                                           Text="{Binding ResponseInterruptionText}"
                                                           TextWrapping="Wrap" />
                                            </DockPanel>
                                        </Border>

                                        <StackPanel Margin="0,8,0,0"
                                                    Visibility="{Binding HasLegacyThinkingTrace, Converter={StaticResource bool2VisibilityConverter}}">
                                            <Expander Style="{StaticResource TraceExpanderStyle}"
                                                      IsExpanded="{Binding IsThinkingExpanded, Mode=TwoWay}"
                                                      Visibility="{Binding HasStandaloneThinkingTrace, Converter={StaticResource bool2VisibilityConverter}}">
                                                <Expander.Header>
                                                    <Border Padding="0" Style="{StaticResource ExecutionSummaryPillBorderStyle}">
                                                        <TextBlock VerticalAlignment="Center"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource GlobalTextBrush}"
                                                                   Opacity="0.72"
                                                                   Text="{Binding ThinkingHeader}"
                                                                   ToolTip="{Binding ThinkingSummaryToolTip}" />
                                                    </Border>
                                                </Expander.Header>
                                                <TextBox Style="{StaticResource ReadOnlyMessageTextBoxStyle}"
                                                         FontSize="12"
                                                         Opacity="0.7"
                                                         Text="{Binding LegacyThinkingContent, Mode=OneWay}"
                                                         Visibility="{Binding HasLegacyThinkingContent, Converter={StaticResource bool2VisibilityConverter}}" />
                                            </Expander>

                                            <ItemsControl ItemsSource="{Binding VisibleAgentTraceGroups}"
                                                          ItemTemplate="{StaticResource AgentTraceGroupTemplate}"
                                                          Visibility="{Binding HasAgentTraceEntries, Converter={StaticResource bool2VisibilityConverter}}" />
                                        </StackPanel>

                                        <Border Margin="0,8,0,10"
                                                Padding="12,10"
                                                Background="{DynamicResource GlobalBorderBrush}"
                                                BorderBrush="{DynamicResource PrimaryBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Visibility="{Binding HasUserQuestion, Converter={StaticResource bool2VisibilityConverter}}">
                                            <StackPanel>
                                                <TextBlock FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryBrush}"
                                                           Text="{Binding UserQuestion.Header}" />
                                                <TextBlock Margin="0,4,0,0"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource GlobalTextBrush}"
                                                           Text="{Binding UserQuestion.Question}"
                                                           TextWrapping="Wrap" />
                                                <ItemsControl Margin="0,8,0,0"
                                                              ItemsSource="{Binding UserQuestion.Options}"
                                                              Visibility="{Binding HasPendingUserQuestion, Converter={StaticResource bool2VisibilityConverter}}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Margin="0,0,6,6"
                                                                    Padding="10,4"
                                                                    Command="{Binding DataContext.AnswerUserQuestionOptionCommand, Source={x:Reference Root}}"
                                                                    CommandParameter="{Binding}"
                                                                    Content="{Binding Label}"
                                                                    Style="{StaticResource MessageActionButtonStyle}"
                                                                    ToolTip="{Binding Description}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Margin="0,2,0,0"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource GlobalTextBrush}"
                                                           Opacity="0.62"
                                                           Text="{Binding UserQuestionStatusText}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <Border Margin="0,0,0,10"
                                                Padding="10,8"
                                                Background="{DynamicResource GlobalBorderBrush}"
                                                BorderBrush="{DynamicResource ButtonBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                ToolTip="{Binding AgentTaskSummaryToolTip}"
                                                Visibility="{Binding HasAgentTaskState, Converter={StaticResource bool2VisibilityConverter}}">
                                            <StackPanel>
                                                <DockPanel LastChildFill="True">
                                                    <StackPanel DockPanel.Dock="Right"
                                                                Margin="8,0,0,0"
                                                                Orientation="Horizontal">
                                                        <Button Padding="10,3"
                                                                Command="{Binding DataContext.ContinueAgentTasksCommand, Source={x:Reference Root}}"
                                                                CommandParameter="{Binding}"
                                                                Content="{Binding AgentRecoveryActionLabel}"
                                                                Style="{StaticResource MessageActionButtonStyle}"
                                                                ToolTip="{Binding AgentRecoveryToolTip}"
                                                                Visibility="{Binding HasRecoverableAgentTasks, Converter={StaticResource bool2VisibilityConverter}}" />
                                                        <Button Padding="10,3"
                                                                Command="{Binding DataContext.ContinuePlanningCommand, Source={x:Reference Root}}"
                                                                CommandParameter="{Binding}"
                                                                Content="继续规划"
                                                                Style="{StaticResource MessageActionButtonStyle}"
                                                                ToolTip="切回计划模式，在输入框中补充反馈后生成修订计划"
                                                                Visibility="{Binding HasCompletedPlan, Converter={StaticResource bool2VisibilityConverter}}" />
                                                        <Button Margin="0"
                                                                Padding="10,3"
                                                                Command="{Binding DataContext.ExecuteApprovedPlanCommand, Source={x:Reference Root}}"
                                                                CommandParameter="{Binding}"
                                                                Content="执行计划"
                                                                Style="{StaticResource MessageActionButtonStyle}"
                                                                ToolTip="批准这份计划并作为新的执行任务开始；受保护操作仍按当前权限策略处理"
                                                                Visibility="{Binding HasCompletedPlan, Converter={StaticResource bool2VisibilityConverter}}" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock VerticalAlignment="Center"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource GlobalTextBrush}"
                                                                   Text="Agent 任务" />
                                                        <Border Margin="8,0,0,0"
                                                                Padding="6,1"
                                                                Background="{DynamicResource GlobalBorderBrush1}"
                                                                CornerRadius="4">
                                                            <TextBlock FontSize="10"
                                                                       Foreground="{DynamicResource GlobalTextBrush}"
                                                                       Opacity="0.72"
                                                                       Text="{Binding AgentTaskModeLabel}" />
                                                        </Border>
                                                        <TextBlock Margin="8,0,0,0"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource GlobalTextBrush}"
                                                                   Opacity="0.62"
                                                                   Text="{Binding AgentTaskProgressLabel}" />
                                                    </StackPanel>
                                                </DockPanel>

                                                <ItemsControl Margin="0,7,0,0" ItemsSource="{Binding AgentTaskLedger.Items}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="18" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock x:Name="TaskStateGlyph"
                                                                           VerticalAlignment="Top"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource GlobalTextBrush}"
                                                                           Opacity="0.58"
                                                                           Text="○" />
                                                                <StackPanel x:Name="TaskTextPanel" Grid.Column="1">
                                                                    <TextBlock FontSize="11"
                                                                               Foreground="{DynamicResource GlobalTextBrush}"
                                                                               Text="{Binding Title}"
                                                                               TextWrapping="Wrap" />
                                                                    <TextBlock Margin="0,1,0,0"
                                                                               FontSize="10"
                                                                               Foreground="{DynamicResource GlobalTextBrush}"
                                                                               Opacity="0.5"
                                                                               Text="{Binding Description}"
                                                                               TextWrapping="Wrap" />
                                                                </StackPanel>
                                                            </Grid>
                                                            <DataTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding IsComplete}" Value="True">
                                                                    <Setter TargetName="TaskStateGlyph" Property="Text" Value="✓" />
                                                                    <Setter TargetName="TaskTextPanel" Property="Opacity" Value="0.52" />
                                                                </DataTrigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <TextBlock Margin="0,6,0,0"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource GlobalTextBrush}"
                                                           Opacity="0.62"
                                                           Text="{Binding AgentStopReasonLabel}" />
                                                <TextBlock Margin="0,3,0,0"
                                                           FontSize="10"
                                                           Foreground="#E6A23C"
                                                           Text="{Binding AgentBlockerLabel}"
                                                           TextWrapping="Wrap"
                                                           Visibility="{Binding HasAgentBlockers, Converter={StaticResource bool2VisibilityConverter}}" />
                                            </StackPanel>
                                        </Border>

                                        <StackPanel x:Name="AssistantActionsPanel"
                                                    Margin="{Binding DataContext.AssistantActionsMargin, Source={x:Reference Root}}"
                                                    Orientation="Horizontal">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsResponsePending}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Margin="0,0,8,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource GlobalTextBrush}"
                                                       Opacity="0.52"
                                                       Text="{Binding TimeLabel}"
                                                       Visibility="{Binding DataContext.ShowMessageTimestamps, Source={x:Reference Root}, Converter={StaticResource bool2VisibilityConverter}}" />
                                            <Button Style="{StaticResource MessageActionButtonStyle}"
                                                    Command="{Binding DataContext.CopyMessageCommand, Source={x:Reference Root}}"
                                                    CommandParameter="{Binding}"
                                                    Content="{x:Static properties:Resources.Copy}"
                                                    ToolTip="复制回答（不包含执行轨迹和推理）" />
                                            <Button Style="{StaticResource MessageActionButtonStyle}"
                                                    Command="{Binding DataContext.BranchConversationCommand, Source={x:Reference Root}}"
                                                    CommandParameter="{Binding}"
                                                    Content="分支"
                                                    ToolTip="从此回答复制已发送上下文到新会话；不继承 Agent 运行状态" />
                                            <Button Style="{StaticResource MessageActionButtonStyle}"
                                                    Command="{Binding DataContext.RetryMessageCommand, Source={x:Reference Root}}"
                                                    CommandParameter="{Binding}"
                                                    Content="{Binding RetryActionLabel}"
                                                    ToolTip="{Binding RetryActionToolTip}" />
                                            <Button Style="{StaticResource MessageActionButtonStyle}"
                                                    Margin="0"
                                                    Command="{Binding DataContext.RefreshMessageCommand, Source={x:Reference Root}}"
                                                    CommandParameter="{Binding}"
                                                    Content="{x:Static properties:Resources.Refresh}"
                                                    ToolTip="{Binding RefreshActionToolTip}"
                                                    Visibility="{Binding ShowsRefreshAction, Converter={StaticResource bool2VisibilityConverter}}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsUser}" Value="True">
                                        <Setter TargetName="UserBubble" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsUser}" Value="False">
                                        <Setter TargetName="AssistantPanel" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button x:Name="ScrollToLatestButton"
                        Grid.Row="2"
                        Panel.ZIndex="10"
                        MinHeight="30"
                        Margin="0,0,0,14"
                        Padding="12,5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        AutomationProperties.Name="回到最新消息"
                        Click="ScrollToLatestButton_Click"
                        Content="↓  下方有新内容"
                        Style="{StaticResource CopilotPrimaryButtonStyle}"
                        ToolTip="回到最新消息"
                        Visibility="Collapsed" />
            </Grid>

            <Border Grid.Row="2"
                    x:Name="ComposerShellBorder"
                    AllowDrop="True"
                    MaxWidth="880"
                    Margin="24,0,24,14"
                    Padding="10,5,8,5"
                    PreviewDragLeave="ComposerShellBorder_PreviewDragLeave"
                    PreviewDragOver="ComposerShellBorder_PreviewDragOver"
                    PreviewDrop="ComposerShellBorder_PreviewDrop"
                    Style="{StaticResource ComposerShellBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border x:Name="FileDropOverlay"
                            Grid.RowSpan="6"
                            Panel.ZIndex="20"
                            Background="{DynamicResource GlobalBackground}"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            BorderThickness="2"
                            CornerRadius="7"
                            IsHitTestVisible="False"
                            Opacity="0.94"
                            Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="22"
                                       Foreground="{DynamicResource PrimaryBrush}"
                                       Text="&#xE898;" />
                            <TextBlock Margin="0,7,0,0"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource GlobalTextBrush}"
                                       Text="松开以附加文件" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="0"
                            Margin="0,0,0,8"
                            Padding="10,7"
                            Background="{DynamicResource GlobalBorderBrush}"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            BorderThickness="1"
                            CornerRadius="7"
                            Visibility="{Binding IsEditingMessage, Converter={StaticResource bool2VisibilityConverter}}">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right"
                                    Width="22"
                                    Height="22"
                                    Margin="8,0,0,0"
                                    Padding="0"
                                    Style="{StaticResource AttachmentCloseButtonStyle}"
                                    Command="{Binding CancelMessageEditCommand}"
                                    Content="×"
                                    ToolTip="取消编辑" />
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="11"
                                       Foreground="{DynamicResource GlobalTextBrush}"
                                       Text="{Binding EditingMessageStatusText}"
                                       TextWrapping="Wrap" />
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="0"
                            Margin="0,0,0,8"
                            Padding="12,9"
                            Panel.ZIndex="1"
                            Style="{StaticResource CopilotInsetBorderStyle}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Visibility="{Binding HasLocalCommandResult, Converter={StaticResource bool2VisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock VerticalAlignment="Center"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource GlobalTextBrush}"
                                       Opacity="0.72"
                                       Text="{Binding LocalCommandResultTitle}" />
                            <Button Grid.Column="1"
                                    Width="22"
                                    Height="22"
                                    Padding="0"
                                    Style="{StaticResource AttachmentCloseButtonStyle}"
                                    Command="{Binding DismissLocalCommandResultCommand}"
                                    Content="×"
                                    ToolTip="关闭本地命令结果" />
                            <TextBox Grid.Row="1"
                                     Grid.ColumnSpan="2"
                                     MaxHeight="168"
                                     Margin="0,6,0,0"
                                     Padding="0"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontFamily="Consolas"
                                     FontSize="11"
                                     Foreground="{DynamicResource GlobalTextBrush}"
                                     HorizontalScrollBarVisibility="Auto"
                                     IsReadOnly="True"
                                     Opacity="0.82"
                                     Text="{Binding LocalCommandResultText, Mode=OneWay}"
                                     TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            MaxHeight="150"
                            Margin="0,0,0,6"
                            Padding="9,7"
                            Style="{StaticResource CopilotInsetBorderStyle}"
                            BorderThickness="1"
                            CornerRadius="7"
                            Visibility="{Binding HasQueuedFollowUps, Converter={StaticResource bool2VisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="2,0,2,5">
                                <TextBlock DockPanel.Dock="Right"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="10"
                                           Opacity="0.54"
                                           Text="{Binding FollowUpQueueHintText}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Text="后续队列" />
                                    <Border Margin="6,0,0,0"
                                            Padding="5,1"
                                            Background="{DynamicResource GlobalBorderBrush1}"
                                            CornerRadius="6">
                                        <TextBlock FontSize="9"
                                                   Opacity="0.72"
                                                   Text="{Binding QueuedFollowUpCountLabel}" />
                                    </Border>
                                </StackPanel>
                            </DockPanel>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding QueuedFollowUps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,4"
                                                    Padding="7,5"
                                                    Background="{DynamicResource GlobalBorderBrush1}"
                                                    CornerRadius="6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Margin="0,0,7,0"
                                                               VerticalAlignment="Center"
                                                               FontFamily="Consolas"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Opacity="0.58"
                                                               Text="{Binding PositionLabel}" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock FontSize="9"
                                                                   FontWeight="SemiBold"
                                                                   Opacity="0.54"
                                                                   Text="{Binding ConversationTitle}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Margin="0,2,0,0"
                                                                   FontSize="11"
                                                                   Text="{Binding PromptPreview}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2"
                                                                Margin="8,0,0,0"
                                                                Orientation="Horizontal">
                                                        <Button Width="30"
                                                                Height="22"
                                                                Padding="0"
                                                                Command="{Binding DataContext.SendQueuedFollowUpNowCommand, Source={x:Reference Root}}"
                                                                CommandParameter="{Binding}"
                                                                Content="立即"
                                                                FontSize="9"
                                                                Style="{StaticResource AttachmentCloseButtonStyle}"
                                                                ToolTip="取消当前轮，把这条提升为下一轮立即执行" />
                                                        <Button Width="22"
                                                                Height="22"
                                                                Margin="4,0,0,0"
                                                                Padding="0"
                                                                Command="{Binding DataContext.MoveQueuedFollowUpUpCommand, Source={x:Reference Root}}"
                                                                CommandParameter="{Binding}"
                                                                Content="↑"
                                                                Style="{StaticResource AttachmentCloseButtonStyle}"
                                                                ToolTip="提前一位" />
                                                        <Button Width="22"
                                                                Height="22"
                                                                Margin="2,0,0,0"
                                                                Padding="0"
                                                                Command="{Binding DataContext.MoveQueuedFollowUpDownCommand, Source={x:Reference Root}}"
                                                                CommandParameter="{Binding}"
                                                                Content="↓"
                                                                Style="{StaticResource AttachmentCloseButtonStyle}"
                                                                ToolTip="后移一位" />
                                                        <Button Width="28"
                                                                Height="22"
                                                                Margin="4,0,0,0"
                                                                Padding="0"
                                                                Command="{Binding DataContext.EditQueuedFollowUpCommand, Source={x:Reference Root}}"
                                                                CommandParameter="{Binding}"
                                                                Content="编辑"
                                                                FontSize="9"
                                                                Style="{StaticResource AttachmentCloseButtonStyle}"
                                                                ToolTip="取消排队并移回输入框" />
                                                        <Button Width="22"
                                                                Height="22"
                                                                Margin="2,0,0,0"
                                                                Padding="0"
                                                                Command="{Binding DataContext.DeleteQueuedFollowUpCommand, Source={x:Reference Root}}"
                                                                CommandParameter="{Binding}"
                                                                Content="×"
                                                                Style="{StaticResource AttachmentCloseButtonStyle}"
                                                                ToolTip="删除这条后续消息" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="2" Margin="0,0,0,6"
                                Visibility="{Binding HasComposerAttachmentItems, Converter={StaticResource bool2VisibilityConverter}}">
                        <ScrollViewer x:Name="AttachmentScrollViewer"
                                      HorizontalScrollBarVisibility="Auto"
                                      PanningMode="HorizontalOnly"
                                      VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal">
                                <ItemsControl ItemsSource="{Binding Attachments}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:CopilotAttachmentItem}">
                                            <Border Margin="0,0,6,0"
                                                    Style="{StaticResource AttachmentChipBorderStyle}"
                                                    ToolTip="{Binding TooltipText}">
                                                <DockPanel LastChildFill="True">
                                                    <Button DockPanel.Dock="Left"
                                                            Margin="0,0,3,0"
                                                            Style="{StaticResource AttachmentCloseButtonStyle}"
                                                            Command="{Binding DataContext.RemoveAttachmentCommand, Source={x:Reference Root}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="移除附件">
                                                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="8"
                                                                   Text="&#xE711;" />
                                                    </Button>
                                                    <Button Style="{StaticResource AttachmentContentButtonStyle}"
                                                            Command="{Binding DataContext.OpenAttachmentCommand, Source={x:Reference Root}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="查看附件">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="14" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid Width="14" Height="14" VerticalAlignment="Center">
                                                                <TextBlock HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           FontFamily="Segoe MDL2 Assets"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource PrimaryBrush}"
                                                                           Text="{Binding IconGlyph}" />
                                                                <Image Source="{Binding PreviewImage}"
                                                                       Stretch="UniformToFill" />
                                                            </Grid>
                                                            <TextBlock Grid.Column="1"
                                                                       Margin="4,0,0,0"
                                                                       VerticalAlignment="Center"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource GlobalTextBrush}"
                                                                       Text="{Binding DisplayLabel}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </Grid>
                                                    </Button>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Margin="0,0,6,0"
                                        Style="{StaticResource AttachmentChipBorderStyle}"
                                        Visibility="{Binding HasAvailableCurrentLiveContext, Converter={StaticResource bool2VisibilityConverter}}">
                                    <Button Style="{StaticResource AttachmentContentButtonStyle}"
                                            AutomationProperties.Name="附加当前窗口"
                                            Command="{Binding AttachCurrentLiveContextCommand}"
                                            ToolTip="附加当前窗口">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource GlobalTextBrush}"
                                                       Opacity="0.54"
                                                       Text="&#xE710;" />
                                            <TextBlock Grid.Column="1"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource PrimaryBrush}"
                                                       Text="&#xE723;" />
                                            <TextBlock Grid.Column="2"
                                                       Margin="4,0,0,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource GlobalTextBrush}"
                                                       Text="{Binding CurrentLiveContextAttachmentLabel}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Button>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </StackPanel>

                    <Border Grid.Row="3"
                            Margin="0,0,0,6"
                            Style="{StaticResource CopilotInsetBorderStyle}"
                            BorderThickness="1"
                            CornerRadius="7"
                            Visibility="{Binding HasPromptHistoryPrefixCompletion, Converter={StaticResource bool2VisibilityConverter}}">
                        <Button Padding="10,7"
                                Command="{Binding AcceptPromptHistoryPrefixCompletionCommand}"
                                Click="PromptHistoryPrefixCompletionButton_Click"
                                Style="{StaticResource ComposerPopoverButtonStyle}"
                                ToolTip="恢复这条当前会话中的历史请求，不会自动发送">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           Opacity="0.58"
                                           Text="历史补全" />
                                <TextBlock Grid.Column="1"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           Text="{Binding PromptHistoryPrefixCompletionText}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding PromptHistoryPrefixCompletionText}" />
                                <TextBlock Grid.Column="2"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="9"
                                           Opacity="0.52"
                                           Text="→ 接受" />
                            </Grid>
                        </Button>
                    </Border>

                    <Border Grid.Row="3"
                            MaxHeight="260"
                            Margin="0,0,0,6"
                            Style="{StaticResource CopilotInsetBorderStyle}"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            BorderThickness="1"
                            CornerRadius="9"
                            Visibility="{Binding IsPromptHistorySearchOpen, Converter={StaticResource bool2VisibilityConverter}}">
                        <DockPanel LastChildFill="True">
                            <DockPanel DockPanel.Dock="Top" Margin="10,7,10,4">
                                <TextBlock DockPanel.Dock="Right"
                                           VerticalAlignment="Center"
                                           FontSize="9"
                                           Opacity="0.48"
                                           Text="↑↓ 选择 · Enter/→ 恢复 · Ctrl+S 范围 · Esc 关闭" />
                                <TextBlock VerticalAlignment="Center"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Opacity="0.68"
                                           Text="{Binding PromptHistorySearchHeader}" />
                            </DockPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Margin="10,3,10,7"
                                       FontSize="9"
                                       Opacity="0.54"
                                       Text="{Binding PromptHistorySearchStatusText}"
                                       TextWrapping="Wrap" />
                            <ListBox x:Name="PromptHistorySearchListBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ItemContainerStyle="{StaticResource ComposerPopoverListBoxItemStyle}"
                                     ItemsSource="{Binding PromptHistorySearchResults}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     SelectedItem="{Binding SelectedPromptHistorySearchResult, Mode=TwoWay}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Button Padding="10,7"
                                                Command="{Binding DataContext.SelectPromptHistorySearchResultCommand, Source={x:Reference Root}}"
                                                CommandParameter="{Binding}"
                                                Click="PromptHistorySearchResultButton_Click"
                                                Style="{StaticResource ComposerPopoverButtonStyle}"
                                                ToolTip="恢复到输入框，不会自动发送">
                                            <StackPanel MaxWidth="760">
                                                <TextBlock FontSize="11"
                                                           Text="{Binding Preview}"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap" />
                                                <TextBlock Margin="0,3,0,0"
                                                           FontSize="9"
                                                           Opacity="0.52"
                                                           Text="{Binding SourceSummary}"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap"
                                                           Visibility="{Binding HasSourceSummary, Converter={StaticResource bool2VisibilityConverter}}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="3"
                            MaxHeight="260"
                            Margin="0,0,0,6"
                            Style="{StaticResource CopilotInsetBorderStyle}"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            BorderThickness="1"
                            CornerRadius="9"
                            Visibility="{Binding IsComposerReferencePopoverOpen, Converter={StaticResource bool2VisibilityConverter}}">
                        <DockPanel LastChildFill="True">
                            <DockPanel DockPanel.Dock="Top" Margin="10,7,10,4">
                                <TextBlock DockPanel.Dock="Right"
                                           VerticalAlignment="Center"
                                           FontSize="9"
                                           Opacity="0.48"
                                           Text="↑↓ 选择 · Enter/→ 关联 · Esc 关闭" />
                                <TextBlock VerticalAlignment="Center"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Opacity="0.68"
                                           Text="{Binding ComposerReferenceHeader}" />
                            </DockPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Margin="12,9,12,12"
                                       HorizontalAlignment="Center"
                                       FontSize="10"
                                       Opacity="0.58"
                                       Text="{Binding ComposerReferenceStatusText}"
                                       Visibility="{Binding HasComposerReferenceStatus, Converter={StaticResource bool2VisibilityConverter}}" />
                            <ListBox Background="Transparent"
                                     BorderThickness="0"
                                     ItemContainerStyle="{StaticResource ComposerPopoverListBoxItemStyle}"
                                     ItemsSource="{Binding ComposerReferenceSuggestions}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     SelectedItem="{Binding SelectedComposerReference, Mode=TwoWay}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:CopilotComposerReferenceItem}">
                                        <Button Padding="9,6"
                                                Command="{Binding DataContext.SelectComposerReferenceCommand, Source={x:Reference Root}}"
                                                CommandParameter="{Binding}"
                                                Click="ComposerReferenceSuggestionButton_Click"
                                                Style="{StaticResource ComposerPopoverButtonStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="13"
                                                           Foreground="{DynamicResource PrimaryBrush}"
                                                           Text="{Binding IconGlyph}" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding Title}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Margin="0,2,0,0"
                                                               FontSize="9"
                                                               Opacity="0.54"
                                                               Text="{Binding Subtitle}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Border Grid.Column="2"
                                                        Margin="10,0,0,0"
                                                        Padding="5,1"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource GlobalBorderBrush1}"
                                                        CornerRadius="6">
                                                    <TextBlock FontSize="9"
                                                               Opacity="0.7"
                                                               Text="{Binding KindLabel}" />
                                                </Border>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="3"
                            MaxHeight="190"
                            Margin="0,0,0,6"
                            Style="{StaticResource CopilotInsetBorderStyle}"
                            BorderThickness="1"
                            CornerRadius="7"
                            Visibility="{Binding HasLocalCommandSuggestions, Converter={StaticResource bool2VisibilityConverter}}">
                        <DockPanel LastChildFill="True">
                            <DockPanel DockPanel.Dock="Top" Margin="10,6,10,3">
                                <TextBlock DockPanel.Dock="Right"
                                           VerticalAlignment="Center"
                                           FontSize="9"
                                           Opacity="0.48"
                                           Text="↑↓ 选择 · Tab/→ 补全 · Enter 执行" />
                                <TextBlock VerticalAlignment="Center"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Opacity="0.68"
                                           Text="{Binding LocalCommandSuggestionHeader}" />
                            </DockPanel>
                            <ListBox x:Name="LocalCommandSuggestionListBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ItemContainerStyle="{StaticResource ComposerPopoverListBoxItemStyle}"
                                     ItemsSource="{Binding LocalCommandSuggestions}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     SelectedIndex="{Binding SelectedLocalCommandSuggestionIndex, Mode=TwoWay}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Button Padding="10,6"
                                                Style="{StaticResource ComposerPopoverButtonStyle}"
                                                Command="{Binding DataContext.CompleteLocalCommandCommand, Source={x:Reference Root}}"
                                                CommandParameter="{Binding}"
                                                Click="LocalCommandSuggestionButton_Click"
                                                ToolTip="点击，或用 ↑↓ 选择后按 Tab/→ 补全；Enter 在参数完整时执行">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock FontFamily="Consolas"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding Name}" />
                                                <TextBlock Grid.Column="1"
                                                           Margin="12,0,0,0"
                                                           Opacity="0.62"
                                                           Text="{Binding Description}" />
                                                <TextBlock Grid.Column="2"
                                                           Margin="14,0,0,0"
                                                           Opacity="0.48"
                                                           Text="Tab/→ 补全" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <Grid Grid.Row="4"
                          MinHeight="24">
                        <TextBlock Padding="0,2"
                                   Foreground="{DynamicResource GlobalTextBrush}"
                                   IsHitTestVisible="False"
                                   Opacity="0.28"
                                   Text="{Binding InputPlaceholder}"
                                   VerticalAlignment="Top">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsInputEmpty}" Value="True" />
                                                <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=PromptTextBox}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox x:Name="PromptTextBox"
                                 MinHeight="24"
                                 MaxHeight="112"
                                 MaxLength="{Binding ComposerMaximumCharacters}"
                                 Padding="0,2"
                                 AcceptsReturn="True"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 CaretBrush="{DynamicResource GlobalTextBrush}"
                                 Foreground="{DynamicResource GlobalTextBrush}"
                                 GotKeyboardFocus="PromptTextBox_GotKeyboardFocus"
                                 PreviewKeyDown="PromptTextBox_PreviewKeyDown"
                                 Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap"
                                 ToolTip="{Binding ComposerInputToolTip}"
                                 VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto" />
                    </Grid>

                    <Grid x:Name="ComposerFooterGrid" Grid.Row="5" Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="AttachMenuButton"
                                Grid.Row="0"
                                Grid.Column="0"
                                Width="28"
                                Height="28"
                                Style="{StaticResource CopilotIconButtonStyle}"
                                Click="AttachMenuButton_Click"
                                ToolTip="{Binding AttachmentMenuToolTip}">
                            <Button.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="{Binding ActiveDocumentAttachmentMenuText}"
                                              Command="{Binding AttachActiveDocumentCommand}"
                                              ToolTip="将当前编辑文件作为本轮明确附件；普通 Chat 模式也能读取其正文。"
                                              ToolTipService.ShowOnDisabled="True" />
                                    <MenuItem Header="附加当前窗口"
                                              Command="{Binding AttachCurrentLiveContextCommand}"
                                              Visibility="{Binding HasCurrentLiveContext, Converter={StaticResource bool2VisibilityConverter}}" />
                                    <Separator />
                                    <MenuItem Header="{Binding ComposerReferenceMenuHeader}"
                                              Click="ComposerReferenceMenuItem_Click"
                                              ToolTip="{Binding ComposerReferenceMenuToolTip}" />
                                    <Separator />
                                    <MenuItem Header="{x:Static properties:Resources.CopilotPasteImage}" Command="{Binding PasteImageAttachmentCommand}" />
                                    <MenuItem Header="{x:Static properties:Resources.CopilotSpecifyWebPage}" Command="{Binding AddWebPageAttachmentCommand}" />
                                    <Separator />
                                    <MenuItem Header="{x:Static properties:Resources.CopilotAddFile}" Command="{Binding AddFileAttachmentCommand}" />
                                    <MenuItem Header="{x:Static properties:Resources.CopilotAddContext}" Command="{Binding AddContextAttachmentCommand}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Text="&#xE710;" />
                        </Button>

                        <Button x:Name="AccessModeButton"
                                Grid.Row="0"
                                Grid.Column="1"
                                Height="30"
                                Margin="4,0,0,0"
                                Padding="6,0"
                                HorizontalAlignment="Left"
                                Style="{StaticResource CopilotIconButtonStyle}"
                                Click="AccessModeButton_Click"
                                ToolTip="{Binding ComposerAccessModeToolTip}">
                            <Button.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="按需确认"
                                              IsCheckable="True"
                                              IsChecked="{Binding IsComposerConfirmAccess, Mode=OneWay}"
                                              Command="{Binding SetComposerAccessModeCommand}"
                                              CommandParameter="{x:Static local:CopilotAgentAccessMode.ConfirmProtectedActions}"
                                              ToolTip="受保护操作执行前逐次确认。" />
                                    <MenuItem Header="临时自动复核（仅下一任务/本任务）"
                                              IsCheckable="True"
                                              IsChecked="{Binding IsComposerFullAccess, Mode=OneWay}"
                                              Command="{Binding SetComposerAccessModeCommand}"
                                              CommandParameter="{x:Static local:CopilotAgentAccessMode.FullAccess}"
                                              ToolTip="最长 15 分钟并绑定任务与工作区。结构化补丁走确定性范围规则；其他受保护调用仅在提供完整原生审批详情时由独立模型复核，每次复核会增加一次模型调用。仅 LOW/MEDIUM 风险自动批准，无法判断或较高风险仍等待用户。" />
                                </ContextMenu>
                            </Button.ContextMenu>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="12"
                                           Text="&#xEA18;">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsComposerFullAccess}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource CopilotControlWarningBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock x:Name="AccessModeLabelTextBlock"
                                           Margin="5,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Text="{Binding ComposerAccessModeLabel}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsComposerFullAccess}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource CopilotControlWarningBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>

                        <Border x:Name="ControlModePill"
                                Grid.Row="0"
                                Grid.Column="2"
                                Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource McpStatusPillBorderStyle}"
                                ToolTip="{Binding McpStatusToolTip}"
                                Visibility="{Binding IsControlModeVisible, Converter={StaticResource bool2VisibilityConverter}}">
                            <DockPanel LastChildFill="False">
                                <TextBlock VerticalAlignment="Center"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="13"
                                           Style="{StaticResource ControlModeTextStyle}"
                                           Text="&#xE83D;" />
                                <TextBlock Margin="5,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Style="{StaticResource ControlModeTextStyle}"
                                           Text="{Binding McpStatusLabel}" />
                            </DockPanel>
                        </Border>

                        <StackPanel Grid.Row="0"
                                    Grid.Column="3"
                                    Margin="4,0"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal">
                            <Button MinWidth="60"
                                    MaxWidth="82"
                                    Height="28"
                                    Margin="0,0,4,0"
                                    Padding="5,0"
                                    AutomationProperties.Name="查看当前 Copilot 模型供应商限额"
                                    Command="{Binding ShowUsageDiagnosticsCommand}"
                                    Content="{Binding ProviderRateLimitStatusLabel}"
                                    FontSize="10"
                                    ToolTip="{Binding ProviderRateLimitStatusToolTip}"
                                    Visibility="{Binding IsProviderRateLimitStatusVisible, Converter={StaticResource bool2VisibilityConverter}}">
                                <Button.Style>
                                    <Style BasedOn="{StaticResource CopilotIconButtonStyle}" TargetType="Button">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsProviderRateLimitUnderPressure}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource CopilotControlWarningBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Width="60"
                                    Height="28"
                                    Margin="0,0,4,0"
                                    AutomationProperties.Name="查看 Copilot 会话历史上下文占用"
                                    Command="{Binding ShowContextDiagnosticsCommand}"
                                    Content="{Binding ConversationContextUsageLabel}"
                                    FontSize="10"
                                    ToolTip="{Binding ConversationContextUsageToolTip}">
                                <Button.Style>
                                    <Style BasedOn="{StaticResource CopilotIconButtonStyle}" TargetType="Button">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConversationContextUnderPressure}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource CopilotControlWarningBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Width="28"
                                    Height="28"
                                    Margin="0,0,4,0"
                                    AutomationProperties.Name="展开编辑 Copilot 提示词"
                                    Click="OpenPromptEditorButton_Click"
                                    Content="↗"
                                    FontSize="13"
                                    IsEnabled="{Binding CanOpenExpandedComposerEditor}"
                                    Style="{StaticResource CopilotIconButtonStyle}"
                                    ToolTip="展开编辑当前输入（Ctrl+E；Ctrl+Enter 保存）" />
                            <Button Width="62"
                                    Height="28"
                                    Margin="0,0,4,0"
                                    AutomationProperties.Name="恢复暂存的 Copilot 草稿"
                                    Click="ComposerStashButton_Click"
                                    Content="恢复草稿"
                                    FontSize="10"
                                    Style="{StaticResource CopilotIconButtonStyle}"
                                    ToolTip="{Binding ComposerStashToolTip}"
                                    Visibility="{Binding HasComposerStash, Converter={StaticResource bool2VisibilityConverter}}" />
                            <Button Width="44"
                                    Height="28"
                                    AutomationProperties.Name="压缩已裁剪的会话上下文"
                                    Command="{Binding CompactConversationCommand}"
                                    Content="压缩"
                                    FontSize="10"
                                    Style="{StaticResource CopilotIconButtonStyle}"
                                    ToolTip="{Binding ConversationContextCompactionToolTip}"
                                    Visibility="{Binding IsConversationContextReduced, Converter={StaticResource bool2VisibilityConverter}}" />
                        </StackPanel>

                        <Grid x:Name="ComposerSelectorGrid"
                              Grid.Row="0"
                              Grid.Column="4"
                              MaxWidth="180"
                              Margin="4,0,4,0"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center">
                            <ToggleButton x:Name="ProfileSelectorButton"
                                          MaxWidth="180"
                                          HorizontalAlignment="Stretch"
                                          IsEnabled="{Binding CanSelectProfile}"
                                          Style="{StaticResource ComposerSelectorToggleButtonStyle}"
                                          ToolTip="{Binding SelectedProfileToolTip}">
                                <Grid TextElement.Foreground="{DynamicResource GlobalTextBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Viewbox Grid.Column="0"
                                             MaxHeight="17"
                                             HorizontalAlignment="Stretch"
                                             Stretch="Uniform"
                                             StretchDirection="DownOnly">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock VerticalAlignment="Center"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding SelectedProfile.DisplayLabel}" />
                                            <TextBlock Margin="5,0,0,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="10"
                                                       Opacity="0.58"
                                                       Text="{Binding SelectedProfileReasoningLabel}" />
                                        </StackPanel>
                                    </Viewbox>
                                    <TextBlock Grid.Column="1"
                                               Margin="7,0,0,0"
                                               VerticalAlignment="Center"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="11"
                                               Opacity="0.64"
                                               Text="&#xE70D;" />
                                </Grid>
                            </ToggleButton>

                            <Popup x:Name="ProfileSelectorPopup"
                                   AllowsTransparency="True"
                                   Closed="ProfileSelectorPopup_Closed"
                                   IsOpen="{Binding IsChecked, ElementName=ProfileSelectorButton, Mode=TwoWay}"
                                   Opened="ProfileSelectorPopup_Opened"
                                   Placement="Top"
                                   PlacementTarget="{Binding ElementName=ProfileSelectorButton}"
                                   PopupAnimation="Fade"
                                   StaysOpen="False"
                                   VerticalOffset="6">
                                <Border Padding="14" Background="Transparent">
                                <Grid TextElement.Foreground="{DynamicResource GlobalTextBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="230" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="1"
                                            Padding="4"
                                            VerticalAlignment="Bottom"
                                            Background="{DynamicResource ButtonBackground}"
                                            BorderBrush="{DynamicResource ButtonBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="16" Opacity="0.2" ShadowDepth="2" />
                                        </Border.Effect>
                                        <StackPanel>
                                            <ToggleButton x:Name="ModelSelectorRowButton"
                                                          Click="ModelSelectorRowButton_Click"
                                                          Style="{StaticResource ComposerPopoverRowToggleStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Text="模型" />
                                                    <TextBlock Grid.Column="1"
                                                               Margin="12,0,0,0"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center"
                                                               FontSize="10"
                                                               Opacity="0.58"
                                                               Text="{Binding SelectedProfile.DisplayLabel}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="2"
                                                               Margin="10,0,0,0"
                                                               VerticalAlignment="Center"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="10"
                                                               Opacity="0.64"
                                                               Text="&#xE76C;" />
                                                </Grid>
                                            </ToggleButton>

                                            <ToggleButton x:Name="ReasoningSelectorRowButton"
                                                          Click="ReasoningSelectorRowButton_Click"
                                                          IsEnabled="{Binding HasConfigurableReasoning}"
                                                          Style="{StaticResource ComposerPopoverRowToggleStyle}"
                                                          ToolTip="{Binding SelectedProfileReasoningToolTip}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Text="推理强度" />
                                                    <TextBlock Grid.Column="1"
                                                               Margin="12,0,0,0"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center"
                                                               FontSize="10"
                                                               Opacity="0.58"
                                                               Text="{Binding SelectedProfileReasoningLabel}" />
                                                    <TextBlock Grid.Column="2"
                                                               Margin="10,0,0,0"
                                                               VerticalAlignment="Center"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="10"
                                                               Opacity="0.64"
                                                               Text="&#xE76C;" />
                                                </Grid>
                                            </ToggleButton>

                                            <Border Height="1" Margin="6,3" Background="{DynamicResource ButtonBorderBrush}" />

                                            <Button Command="{Binding OpenSettingsCommand}"
                                                    Click="CloseSelectorPopupButton_Click"
                                                    Style="{StaticResource ComposerPopoverButtonStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Text="设置" />
                                                    <TextBlock Grid.Column="1"
                                                               VerticalAlignment="Center"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="11"
                                                               Opacity="0.68"
                                                               Text="&#xE713;" />
                                                </Grid>
                                            </Button>
                                        </StackPanel>
                                    </Border>

                                    <Border x:Name="ModelSubmenuBorder"
                                            Grid.Column="0"
                                            Width="276"
                                            MaxHeight="340"
                                            Margin="0,0,8,0"
                                            Padding="4"
                                            VerticalAlignment="Bottom"
                                            Background="{DynamicResource ButtonBackground}"
                                            BorderBrush="{DynamicResource ButtonBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14"
                                            Visibility="Collapsed">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="16" Opacity="0.2" ShadowDepth="2" />
                                        </Border.Effect>
                                        <DockPanel LastChildFill="True">
                                            <TextBlock DockPanel.Dock="Top"
                                                       Margin="8,5,8,4"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Opacity="0.58"
                                                       Text="模型" />
                                            <ListBox x:Name="ProfileListBox"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     ItemContainerStyle="{StaticResource ComposerPopoverListBoxItemStyle}"
                                                     ItemsSource="{Binding Profiles}"
                                                     PreviewMouseLeftButtonUp="ProfileListBox_PreviewMouseLeftButtonUp"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                     SelectedItem="{Binding SelectedProfile, Mode=TwoWay}">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid MinHeight="36" Margin="8,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock FontSize="11"
                                                                           FontWeight="SemiBold"
                                                                           Text="{Binding DisplayLabel}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Margin="0,2,0,0"
                                                                           FontSize="9"
                                                                           Opacity="0.52"
                                                                           Text="{Binding SecondaryLabel}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <TextBlock x:Name="SelectedProfileCheck"
                                                                       Grid.Column="1"
                                                                       Margin="12,0,2,0"
                                                                       VerticalAlignment="Center"
                                                                       FontFamily="Segoe MDL2 Assets"
                                                                       FontSize="10"
                                                                       Text="&#xE73E;"
                                                                       Visibility="Collapsed" />
                                                        </Grid>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                <Setter TargetName="SelectedProfileCheck" Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </DockPanel>
                                    </Border>

                                    <Border x:Name="ReasoningSubmenuBorder"
                                            Grid.Column="0"
                                            Width="276"
                                            Margin="0,0,8,0"
                                            Padding="4"
                                            VerticalAlignment="Bottom"
                                            Background="{DynamicResource ButtonBackground}"
                                            BorderBrush="{DynamicResource ButtonBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14"
                                            Visibility="Collapsed">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="16" Opacity="0.2" ShadowDepth="2" />
                                        </Border.Effect>
                                        <StackPanel>
                                            <TextBlock Margin="8,5,8,4"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Opacity="0.58"
                                                       Text="推理强度" />
                                            <ItemsControl x:Name="ReasoningOptionsControl"
                                                          ItemsSource="{Binding SelectedProfileReasoningOptions}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Tag="{Binding Mode}"
                                                                Click="ReasoningOptionButton_Click"
                                                                Style="{StaticResource ComposerPopoverButtonStyle}"
                                                                ToolTip="{Binding Description}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock VerticalAlignment="Center" FontSize="11" Text="{Binding Label}" />
                                                                <TextBlock Grid.Column="1"
                                                                           Margin="12,0,2,0"
                                                                           VerticalAlignment="Center"
                                                                           FontFamily="Segoe MDL2 Assets"
                                                                           FontSize="10"
                                                                           Text="&#xE73E;"
                                                                           Visibility="{Binding IsSelected, Converter={StaticResource bool2VisibilityConverter}}" />
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                </Grid>
                                </Border>
                            </Popup>
                        </Grid>

                        <StackPanel x:Name="ComposerActionStack"
                                    Grid.Row="0"
                                    Grid.Column="5"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button Width="28"
                                    Height="28"
                                    Margin="0,0,6,0"
                                    Command="{Binding SubmitUserQuestionAnswerCommand}"
                                    Content="✓"
                                    FontSize="15"
                                    Style="{StaticResource CopilotIconButtonStyle}"
                                    Visibility="{Binding CanSubmitUserQuestionAnswer, Converter={StaticResource bool2VisibilityConverter}}"
                                    ToolTip="提交当前澄清问题的答案（Enter）" />
                            <Button Width="28"
                                    Height="28"
                                    Margin="0,0,6,0"
                                    Command="{Binding SteerCommand}"
                                    Content="↳"
                                    FontSize="15"
                                    Style="{StaticResource CopilotIconButtonStyle}"
                                    Visibility="{Binding CanSteerCurrentRun, Converter={StaticResource bool2VisibilityConverter}}"
                                    ToolTip="{Binding SteerActionToolTip}" />
                            <Button Width="28"
                                    Height="28"
                                    Margin="0,0,6,0"
                                    Command="{Binding QueueFollowUpCommand}"
                                    Content="⇥"
                                    FontSize="15"
                                    Style="{StaticResource CopilotIconButtonStyle}"
                                    Visibility="{Binding CanQueueCurrentRunFollowUp, Converter={StaticResource bool2VisibilityConverter}}"
                                    ToolTip="{Binding QueueFollowUpToolTip}" />

                            <Button x:Name="VoiceInputButton"
                                    Width="28"
                                    Height="28"
                                    Margin="0,0,6,0"
                                    Style="{StaticResource CopilotIconButtonStyle}"
                                    Click="VoiceInputButton_Click"
                                    ToolTip="语音输入（Windows + H）">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="15"
                                           Text="&#xE720;" />
                            </Button>

                            <Button Margin="2,0,0,0"
                                    Command="{Binding PrimaryActionCommand}"
                                    Style="{StaticResource ComposerPrimaryActionButtonStyle}"
                                    Content="{Binding PrimaryActionGlyph}"
                                    FontSize="15"
                                    ToolTip="{Binding PrimaryActionToolTip}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Column="1">
            <Border x:Name="ConversationSidebarBorder"
                    Background="{DynamicResource ButtonBackground}"
                    BorderBrush="{DynamicResource ButtonBorderBrush}"
                    BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="12,8,10,8" LastChildFill="False">
                        <Button x:Name="CompactSidebarToggleButton"
                                Margin="0,0,6,0"
                                Style="{StaticResource CopilotIconButtonStyle}"
                                Click="ToggleConversationSidebarButton_Click"
                                ToolTip="{x:Static properties:Resources.CopilotCollapseConversationList}"
                                Visibility="Collapsed">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       FontSize="15"
                                       Text="&#xE8A7;" />
                        </Button>

                        <Button Width="28"
                                Height="28"
                                Style="{StaticResource CopilotIconButtonStyle}"
                                Command="{Binding NewChatCommand}"
                                DockPanel.Dock="Right"
                                ToolTip="新建会话 (Ctrl+N)">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Text="&#xE710;" />
                        </Button>

                        <Button Width="28"
                                Height="28"
                                Margin="0,0,4,0"
                                Style="{StaticResource CopilotIconButtonStyle}"
                                Command="{Binding ExportConversationCommand}"
                                CommandParameter="{Binding SelectedConversation}"
                                DockPanel.Dock="Right"
                                ToolTip="导出当前会话为 Markdown">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Text="&#xE74E;" />
                        </Button>

                        <TextBlock VerticalAlignment="Center"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource GlobalTextBrush}"
                                   Text="{x:Static properties:Resources.CopilotConversations}" />
                    </DockPanel>

                    <Border Grid.Row="1"
                            Margin="8,0,8,8"
                            Padding="8,5"
                            Style="{StaticResource CopilotInsetBorderStyle}"
                            BorderThickness="1"
                            CornerRadius="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="12"
                                       Foreground="{DynamicResource GlobalTextBrush}"
                                       Opacity="0.42"
                                       Text="&#xE721;" />
                            <Grid Grid.Column="1" Margin="7,0,4,0">
                                <TextBlock VerticalAlignment="Center"
                                           FontSize="11"
                                           Foreground="{DynamicResource GlobalTextBrush}"
                                           IsHitTestVisible="False"
                                           Opacity="0.38"
                                           Text="搜索会话"
                                           Visibility="{Binding IsConversationSearchEmpty, Converter={StaticResource bool2VisibilityConverter}}" />
                                <TextBox x:Name="ConversationSearchTextBox"
                                         Padding="0"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         FontSize="11"
                                         Foreground="{DynamicResource GlobalTextBrush}"
                                         MaxLength="256"
                                         PreviewKeyDown="ConversationSearchTextBox_PreviewKeyDown"
                                         Text="{Binding ConversationSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         TextChanged="ConversationSearchTextBox_TextChanged"
                                         ToolTip="搜索会话 (Ctrl+G)；↑↓ 选择，Enter 切换，Ctrl+R 重命名，Esc 退出" />
                            </Grid>
                            <Button Grid.Column="2"
                                    Style="{StaticResource AttachmentCloseButtonStyle}"
                                    Command="{Binding ClearConversationSearchCommand}"
                                    Content="×"
                                    ToolTip="清除搜索"
                                    Visibility="{Binding HasConversationSearchQuery, Converter={StaticResource bool2VisibilityConverter}}" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="2"
                            Margin="8,0,8,8"
                            Padding="8,7"
                            Style="{StaticResource CopilotInsetBorderStyle}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Visibility="{Binding HasAgentTasks, Converter={StaticResource bool2VisibilityConverter}}">
                        <StackPanel>
                            <DockPanel Margin="2,0,2,5" LastChildFill="False">
                                <Border DockPanel.Dock="Right"
                                        MinWidth="18"
                                        Padding="4,1"
                                        Background="{DynamicResource GlobalBorderBrush1}"
                                        CornerRadius="9">
                                    <TextBlock HorizontalAlignment="Center"
                                               FontSize="10"
                                               Foreground="{DynamicResource GlobalTextBrush}"
                                               Text="{Binding AgentTaskCountLabel}" />
                                </Border>
                                <Button Padding="0"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        Command="{Binding ToggleAgentTaskPanelCommand}"
                                        ToolTip="{Binding AgentTaskPanelToolTip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Width="14"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource GlobalTextBrush}"
                                                   Opacity="0.62"
                                                   Text="{Binding AgentTaskPanelToggleGlyph}" />
                                        <TextBlock VerticalAlignment="Center"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource GlobalTextBrush}"
                                                   Opacity="0.72"
                                                   Text="Agent 任务" />
                                    </StackPanel>
                                </Button>
                            </DockPanel>

                            <ScrollViewer MaxHeight="168"
                                          VerticalScrollBarVisibility="Auto"
                                          Visibility="{Binding IsAgentTaskListVisible, Converter={StaticResource bool2VisibilityConverter}}">
                                <ItemsControl ItemsSource="{Binding AgentTasks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:CopilotAgentTaskSummary}">
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Button Grid.Column="0"
                                                        Padding="4,3"
                                                        HorizontalContentAlignment="Stretch"
                                                        Background="Transparent"
                                                        BorderBrush="Transparent"
                                                        Command="{Binding DataContext.OpenAgentTaskCommand, Source={x:Reference Root}}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel>
                                                        <TextBlock FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource GlobalTextBrush}"
                                                                   Text="{Binding Title}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Margin="0,1,0,0"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource GlobalTextBrush}"
                                                                   Opacity="0.58"
                                                                   Text="{Binding StatusLabel}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding DetailLabel}" />
                                                    </StackPanel>
                                                </Button>

                                                <Button Grid.Column="1"
                                                        Width="24"
                                                        Height="24"
                                                        Margin="3,0,0,0"
                                                        Padding="0"
                                                        Background="Transparent"
                                                        BorderBrush="Transparent"
                                                        Command="{Binding DataContext.ResumeAgentTaskCommand, Source={x:Reference Root}}"
                                                        CommandParameter="{Binding}"
                                                        Content="▶"
                                                        FontSize="9"
                                                        ToolTip="{Binding RecoveryToolTip}"
                                                        Visibility="{Binding CanResume, Converter={StaticResource bool2VisibilityConverter}}" />
                                                <Button Grid.Column="2"
                                                        Width="24"
                                                        Height="24"
                                                        Margin="2,0,0,0"
                                                        Padding="0"
                                                        Background="Transparent"
                                                        BorderBrush="Transparent"
                                                        Command="{Binding DataContext.DismissAgentTaskCommand, Source={x:Reference Root}}"
                                                        CommandParameter="{Binding}"
                                                        Content="×"
                                                        FontSize="13"
                                                        ToolTip="{Binding DismissToolTip}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <ListBox x:Name="ConversationListBox"
                             Grid.Row="3"
                             Padding="0,0,0,10"
                             BorderThickness="0"
                             Background="Transparent"
                             ItemContainerStyle="{StaticResource SidebarListBoxItemStyle}"
                             ItemsSource="{Binding FilteredConversations}"
                             PreviewKeyDown="ConversationListBox_PreviewKeyDown"
                             PreviewMouseLeftButtonUp="ConversationListBox_PreviewMouseLeftButtonUp"
                             SelectedItem="{Binding SelectedConversation, Mode=OneWay}"
                             IsEnabled="{Binding CanSwitchConversation}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:CopilotConversationRecord}">
                                <Border Padding="11,9"
                                        Style="{StaticResource CopilotInsetBorderStyle}"
                                        BorderThickness="1"
                                        CornerRadius="5">
                                    <Border.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="{x:Static properties:Resources.Rename}"
                                                      Command="{Binding DataContext.RenameConversationCommand, Source={x:Reference Root}}"
                                                      CommandParameter="{Binding}" />
                                            <MenuItem Header="{Binding PinMenuText}"
                                                      Command="{Binding DataContext.TogglePinConversationCommand, Source={x:Reference Root}}"
                                                      CommandParameter="{Binding}" />
                                            <MenuItem Header="导出 Markdown"
                                                      Command="{Binding DataContext.ExportConversationCommand, Source={x:Reference Root}}"
                                                      CommandParameter="{Binding}" />
                                            <MenuItem Header="打开源会话"
                                                      Command="{Binding DataContext.OpenBranchOriginCommand, Source={x:Reference Root}}"
                                                      CommandParameter="{Binding}"
                                                      Visibility="{Binding HasBranchOrigin, Converter={StaticResource bool2VisibilityConverter}}" />
                                            <Separator />
                                            <MenuItem Header="{x:Static properties:Resources.Delete}"
                                                      Command="{Binding DataContext.DeleteConversationCommand, Source={x:Reference Root}}"
                                                      CommandParameter="{Binding}" />
                                        </ContextMenu>
                                    </Border.ContextMenu>

                                    <StackPanel>
                                        <DockPanel LastChildFill="False">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock MaxWidth="138"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource GlobalTextBrush}"
                                                           Text="{Binding Title}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Margin="6,0,0,0"
                                                           Foreground="{DynamicResource GlobalTextBrush}"
                                                           FontSize="11"
                                                           Opacity="0.48"
                                                           Text="{Binding PinLabel}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Border Margin="6,0,0,0"
                                                        Padding="5,1"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource GlobalBorderBrush1}"
                                                        CornerRadius="6"
                                                        Visibility="{Binding HasBranchOrigin, Converter={StaticResource bool2VisibilityConverter}}">
                                                    <TextBlock FontSize="9"
                                                               Foreground="{DynamicResource GlobalTextBrush}"
                                                               Opacity="0.66"
                                                               Text="{Binding BranchLabel}" />
                                                </Border>
                                                <Border Margin="6,0,0,0"
                                                        Padding="5,1"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource GlobalBorderBrush1}"
                                                        CornerRadius="6"
                                                        Visibility="{Binding HasAgentRunStatus, Converter={StaticResource bool2VisibilityConverter}}">
                                                    <TextBlock FontSize="9"
                                                               Foreground="{DynamicResource GlobalTextBrush}"
                                                               Opacity="0.72"
                                                               Text="{Binding AgentRunStatusLabel}" />
                                                </Border>
                                            </StackPanel>
                                        </DockPanel>

                                        <DockPanel Margin="0,4,0,0" LastChildFill="False">
                                            <TextBlock MaxWidth="118"
                                                       Foreground="{DynamicResource GlobalTextBrush}"
                                                       FontSize="11"
                                                       Opacity="0.72"
                                                       Text="{Binding ConversationListPreviewText}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock DockPanel.Dock="Right"
                                                       Margin="8,0,0,0"
                                                       Foreground="{DynamicResource GlobalTextBrush}"
                                                       FontSize="11"
                                                       Opacity="0.5"
                                                       Text="{Binding UpdatedLabel}" />
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="3"
                               Margin="16"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{DynamicResource GlobalTextBrush}"
                               IsHitTestVisible="False"
                               Opacity="0.48"
                               Text="没有匹配的会话"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasNoConversationSearchResults, Converter={StaticResource bool2VisibilityConverter}}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
