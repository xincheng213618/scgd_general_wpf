<UserControl x:Class="ColorVision.Copilot.CopilotCodexConnectionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:display="clr-namespace:ColorVision">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="CodexBoolToVisibility" />
    </UserControl.Resources>
    <Border Padding="12" Margin="0,0,0,12" CornerRadius="6"
            BorderThickness="1" BorderBrush="{DynamicResource ButtonBorderBrush}"
            Background="{DynamicResource GlobalBackground}"
            Visibility="{Binding HasLocalCodex, Converter={StaticResource CodexBoolToVisibility}}">
        <StackPanel>
            <TextBlock Text="{display:DisplayText Key='本机 Codex'}" FontWeight="SemiBold" Foreground="{DynamicResource GlobalTextBrush}" />
            <TextBlock Text="{Binding LocalCodexStatus}" Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource GlobalTextBrush}" Opacity="0.75" />
            <WrapPanel Margin="0,8,0,0">
                <Button Content="{display:DisplayText Key='使用本机 Codex'}" Command="{Binding AddLocalCodexCommand}" Padding="10,5" Margin="0,0,8,4" />
                <Button Content="{display:DisplayText Key='登录 Codex'}" Command="{Binding LoginLocalCodexCommand}" Padding="10,5" Margin="0,0,8,4" />
                <Button Content="{display:DisplayText Key='重新检测'}" Command="{Binding DetectLocalCodexCommand}" Padding="10,5" Margin="0,0,0,4" />
            </WrapPanel>
        </StackPanel>
    </Border>
</UserControl>
