<Window x:Class="ColorVision.Copilot.CopilotTextInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:properties="clr-namespace:ColorVision.Properties"
        Title="{x:Static properties:Resources.Input}"
        Width="520"
        Height="200"
        MinWidth="440"
        Background="{DynamicResource GlobalBackground}"
        mc:Ignorable="d">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="DescriptionTextBlock"
                       Foreground="{DynamicResource GlobalTextBrush}"
                       FontSize="15"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
        </StackPanel>

        <TextBox x:Name="InputTextBox"
                 Grid.Row="1"
                 Margin="0,12,0,12"
                 AcceptsReturn="False"
                 Foreground="{DynamicResource GlobalTextBrush}"
                 TextWrapping="Wrap"
                 VerticalContentAlignment="Center"
                 VerticalScrollBarVisibility="Auto" />

        <StackPanel x:Name="AcceptanceFeedbackPanel" Grid.Row="2" Margin="0,0,0,12" Visibility="Collapsed">
            <TextBlock x:Name="AcceptanceFeedbackTextBlock"
                       Foreground="{DynamicResource GlobalTextBrush}"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="ComparisonLabelTextBlock"
                       Margin="0,8,0,4"
                       Foreground="{DynamicResource GlobalTextBrush}" />
            <TextBox x:Name="ComparisonTextBox"
                     Height="110"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     Foreground="{DynamicResource GlobalTextBrush}"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" />
        </StackPanel>

        <Grid Grid.Row="3">
            <TextBlock x:Name="CharacterCountTextBlock"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource GlobalTextBrush}"
                       Opacity="0.62"
                       Visibility="Collapsed" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button x:Name="CancelButton" Margin="0,0,8,0" Padding="14,6" Click="CancelButton_Click" Content="{x:Static properties:Resources.Cancel}" />
                <Button x:Name="OkButton" Padding="14,6" Click="OkButton_Click" Content="{x:Static properties:Resources.OK}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
