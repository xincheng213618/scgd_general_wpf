<Window x:Class="ColorVision.ToolPlugins.UpdateRelay.UpdateRelayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:display="clr-namespace:ColorVision"
        Title="{display:DisplayText Key='更新跳板'}" Width="680" SizeToContent="Height" MinWidth="620"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource GlobalBackground}"
        Foreground="{DynamicResource GlobalTextBrush}" Loaded="Window_Loaded" Closed="Window_Closed">
    <Window.Resources>
        <Style x:Key="RelayButton" TargetType="Button" BasedOn="{StaticResource ButtonDefault}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,4" />
        </Style>
    </Window.Resources>
    <StackPanel Margin="20,16,20,14">
        <TextBlock Text="{display:DisplayText Key='更新跳板'}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12" />
        <TabControl x:Name="RelayTabs" Background="Transparent" BorderThickness="0">
            <TabItem Header="{display:DisplayText Key='客户机'}" Padding="18,7">
                <StackPanel Margin="2,12,2,4">
                    <TextBlock Text="{display:DisplayText Key='在需要更新的电脑上填写跳板机地址。添加后，ColorVision 会按更新源列表的顺序尝试连接。'}"
                               TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock Text="{display:DisplayText Key='跳板机 IPv4 地址'}" Margin="0,14,0,4" FontWeight="SemiBold" />
                    <ComboBox x:Name="ClientAddress" IsEditable="True" MinHeight="34" VerticalContentAlignment="Center"
                              AutomationProperties.Name="{display:DisplayText Key='跳板机 IPv4 地址'}" />
                    <TextBlock Text="{display:DisplayText Key='默认使用 9998 端口，也可填写 IP:端口。下拉列表显示已配置的地址。'}"
                               Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <WrapPanel Margin="0,14,0,0">
                        <Button Content="{display:DisplayText Key='添加更新源'}" Style="{StaticResource ButtonPrimary}"
                                MinHeight="32" Padding="12,4" Click="AddSource_Click" Margin="0,0,8,0" />
                        <Button Content="{display:DisplayText Key='测试连接'}" Style="{StaticResource RelayButton}" Click="TestSource_Click" Margin="0,0,8,0" />
                        <Button Content="{display:DisplayText Key='移除更新源'}" Style="{StaticResource RelayButton}" Click="RemoveSource_Click" />
                    </WrapPanel>
                </StackPanel>
            </TabItem>
            <TabItem Header="{display:DisplayText Key='跳板机'}" Padding="18,7">
                <StackPanel Margin="2,12,2,4">
                    <TextBlock Text="{display:DisplayText Key='在能访问官方更新服务的电脑上开启转发。把客户机能访问的本机地址发给对方。'}"
                               TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock x:Name="ForwardStatus" Margin="0,12,0,0" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{display:DisplayText Key='本机地址'}" Margin="0,12,0,4" FontWeight="SemiBold" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <ComboBox x:Name="LocalAddress" MinHeight="34" VerticalContentAlignment="Center"
                                  AutomationProperties.Name="{display:DisplayText Key='本机地址'}" />
                        <Button Grid.Column="1" Content="{display:DisplayText Key='复制地址'}" Style="{StaticResource RelayButton}"
                                Margin="8,0,0,0" Click="CopyAddress_Click" />
                        <Button Grid.Column="2" Content="{display:DisplayText Key='刷新'}" Style="{StaticResource RelayButton}"
                                Margin="8,0,0,0" Click="Refresh_Click" />
                    </Grid>
                    <WrapPanel Margin="0,14,0,0">
                        <Button Content="{display:DisplayText Key='开启转发'}" Style="{StaticResource ButtonPrimary}"
                                MinHeight="32" Padding="12,4" Click="EnableForward_Click" Margin="0,0,8,0" />
                        <Button Content="{display:DisplayText Key='测试转发'}" Style="{StaticResource RelayButton}" Click="TestForward_Click" Margin="0,0,8,0" />
                        <Button Content="{display:DisplayText Key='移除转发'}" Style="{StaticResource RelayButton}" Click="DisableForward_Click" />
                    </WrapPanel>
                    <TextBlock Text="{display:DisplayText Key='开启和移除转发时，Windows 会请求管理员授权。'}"
                               Margin="0,7,0,0" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>
            </TabItem>
        </TabControl>
        <Border Margin="0,12,0,0" Padding="10,8" CornerRadius="5" Background="{DynamicResource ButtonBackground}"
                BorderBrush="{DynamicResource ButtonBorderBrush}" BorderThickness="1">
            <TextBlock x:Name="OperationStatus" Text="{display:DisplayText Key='就绪'}" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />
        </Border>
    </StackPanel>
</Window>
