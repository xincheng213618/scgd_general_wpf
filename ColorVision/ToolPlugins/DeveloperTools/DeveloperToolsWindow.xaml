<Window x:Class="ColorVision.ToolPlugins.DeveloperTools.DeveloperToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ColorVision.ToolPlugins.DeveloperTools"
        Title="开发工具管理" Width="1060" Height="720" MinWidth="820" MinHeight="600"
        Background="{DynamicResource GlobalBackground}" Foreground="{DynamicResource GlobalTextBrush}"
        WindowStartupLocation="CenterOwner" Loaded="Window_Loaded" Activated="Window_Activated" Closed="Window_Closed">
    <Window.Resources>
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource ButtonDefault}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="14,5" />
        </Style>
        <Style x:Key="ToolCard" TargetType="Border">
            <Setter Property="Padding" Value="14" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}" />
        </Style>
        <DataTemplate DataType="{x:Type local:DeveloperToolPageModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Foreground="{DynamicResource GlobalTextBrush}">
                <StackPanel Margin="0,10,0,0">
                    <Grid Margin="2,0,2,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" />
                        </StackPanel>
                        <Border Grid.Column="1" Padding="12,6" CornerRadius="5" Background="{DynamicResource GlobalBackground}" VerticalAlignment="Top">
                            <TextBlock Text="{Binding DetectionStatus}" />
                        </Border>
                    </Grid>
                    <Border Style="{StaticResource ToolCard}">
                        <StackPanel>
                            <TextBlock Text="系统中发现的安装" FontWeight="SemiBold" FontSize="14" />
                            <DataGrid ItemsSource="{Binding Installations}" Margin="0,8,0,0" MinHeight="108" MaxHeight="190"
                                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="95" />
                                    <DataGridTextColumn Header="随附包管理器" Binding="{Binding PackageManagerVersion}" Width="130" />
                                    <DataGridTextColumn Header="解释器路径" Binding="{Binding ExecutablePath}" Width="*" MinWidth="280">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                <Setter Property="ToolTip" Value="{Binding ExecutablePath}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="发现方式" Binding="{Binding Source}" Width="160" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <Expander Header="命令路径详情" Margin="0,8,0,0">
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Text="当前应用" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBlock Text="{Binding CurrentCommandPath}" Margin="0,2,0,7" TextWrapping="Wrap" FontFamily="Consolas" />
                                    <TextBlock Text="新终端参考" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBlock Text="{Binding RefreshedCommandPath}" Margin="0,2,0,7" TextWrapping="Wrap" FontFamily="Consolas" />
                                    <TextBlock Text="{Binding Note}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ToolCard}" Margin="0,12,0,0">
                        <StackPanel>
                            <DockPanel LastChildFill="True">
                                <Button DockPanel.Dock="Right" Content="获取可安装版本" Style="{StaticResource ToolButton}" Click="LoadVersions_Click" Margin="12,0,0,0" />
                                <TextBlock Text="可选安装" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Text="{Binding CatalogStatus}" Margin="0,7,0,10" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding Releases}" SelectedItem="{Binding SelectedRelease}" DisplayMemberPath="DisplayName"
                                          MinHeight="34" Margin="0,0,10,0" VerticalContentAlignment="Center" AutomationProperties.Name="安装版本" />
                                <ComboBox Grid.Column="1" SelectedIndex="{Binding SelectedSourceIndex}" MinHeight="34" Margin="0,0,10,0"
                                          VerticalContentAlignment="Center" AutomationProperties.Name="安装包下载源">
                                    <ComboBoxItem Content="国内镜像 · npmmirror" /><ComboBoxItem Content="官方网站" />
                                </ComboBox>
                                <Button Grid.Column="2" Content="下载并安装…" Click="Install_Click" Padding="16,6" MinHeight="34"
                                        Style="{StaticResource ButtonPrimary}" IsEnabled="{Binding CanInstall}" />
                            </Grid>
                            <TextBlock Text="{Binding InstallHint}" Margin="0,9,0,3" TextWrapping="Wrap" />
                            <TextBlock Text="下载源仅用于安装包，不修改 pip/npm 源；安装前会校验官网 SHA256 和发布者签名。"
                                       Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="22,16,22,14">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="开发工具管理" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="检测并安装系统中的 Python 和 Node.js。"
                           Margin="0,5,16,0" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
            </StackPanel>
            <Button Grid.Column="1" Content="刷新检测" Style="{StaticResource ToolButton}" VerticalAlignment="Center" Click="Refresh_Click" />
        </Grid>
        <TabControl x:Name="ToolTabs" Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabItem Header="Python" Content="{Binding Python}" Padding="22,9" />
            <TabItem Header="Node.js / npm" Content="{Binding NodeJs}" Padding="22,9" />
        </TabControl>
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="OperationStatus" Text="就绪" TextWrapping="Wrap" Margin="0,0,12,3" />
                <TextBlock x:Name="LastChecked" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" />
            </StackPanel>
            <Button Grid.Column="1" Content="关闭" Style="{StaticResource ToolButton}" VerticalAlignment="Bottom" Click="Close_Click" />
        </Grid>
    </Grid>
</Window>
