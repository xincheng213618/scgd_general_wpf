<Window x:Class="ColorVision.ToolPlugins.ThirdPartyApps.SscomPresetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:display="clr-namespace:ColorVision"
        Title="{display:DisplayText Key='SSCOM 调试预设'}" Width="780" Height="515" MinWidth="650" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource GlobalBackground}" Foreground="{DynamicResource GlobalTextBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{display:DisplayText Key='选择指令预设'}" FontWeight="SemiBold" FontSize="15" />
            <ComboBox x:Name="ProfileList" DisplayMemberPath="Name" Margin="0,6,0,10" MinHeight="34" VerticalContentAlignment="Center"
                      SelectionChanged="ProfileList_SelectionChanged" AutomationProperties.Name="{display:DisplayText Key='指令预设'}" />
            <Grid x:Name="ArvrSettings" Visibility="Collapsed" Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="86" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="{display:DisplayText Key='服务 IPv4 地址'}" />
                    <TextBox x:Name="ServerAddress" Text="127.0.0.1" MinHeight="32" Margin="0,4,0,0"
                             VerticalContentAlignment="Center" AutomationProperties.Name="{display:DisplayText Key='服务 IPv4 地址'}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Text="{display:DisplayText Key='端口'}" />
                    <TextBox x:Name="ServerPort" Text="6666" MinHeight="32" Margin="0,4,0,0"
                             VerticalContentAlignment="Center" AutomationProperties.Name="{display:DisplayText Key='端口'}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{display:DisplayText Key='测试 SN'}" />
                    <TextBox x:Name="SerialNumber" Text="DEBUG-001" MinHeight="32" Margin="0,4,0,0" TextChanged="SerialNumber_TextChanged"
                             VerticalContentAlignment="Center" AutomationProperties.Name="{display:DisplayText Key='测试 SN'}" />
                </StackPanel>
            </Grid>
        </StackPanel>
        <DataGrid x:Name="CommandPreview" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{display:DisplayText Key='操作'}" Binding="{Binding Name}" Width="240" />
                <DataGridTextColumn Header="{display:DisplayText Key='发送内容'}" Binding="{Binding Request}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="FontFamily" Value="Consolas" /></Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <Button x:Name="ApplyButton" Content="{display:DisplayText Key='添加并打开 SSCOM'}" Click="Apply_Click" Style="{StaticResource ButtonPrimary}"
                        MinHeight="32" Padding="12,4" />
            </StackPanel>
            <TextBlock x:Name="Status" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
        </DockPanel>
    </Grid>
</Window>
