<Window x:Class="ColorVision.ToolPlugins.ThirdPartyApps.NetworkAdapterPriorityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IPv4 网卡与 DNS"
        Width="1120"
        Height="650"
        MinWidth="960"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource GlobalBackground}"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonDefault}">
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,4" />
        </Style>
        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonPrimary}">
            <Setter Property="MinWidth" Value="170" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="16,4" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="0,0,0,12"
                Padding="14"
                Background="{DynamicResource ButtonBackground}"
                BorderBrush="{DynamicResource ButtonBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <StackPanel>
                <TextBlock Text="选择首选上网网卡"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource GlobalTextBrush}" />
                <TextBlock Margin="0,7,0,0"
                           Text="选择目标网卡后，可调整 IPv4 Metric 或执行 DNS 连接修复。所有修改只作用于所选网卡。"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,3,0,0"
                           Text="Metric 数值越小，网络优先级通常越高；修改网络配置时 Windows 会请求管理员授权。"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <DataGrid x:Name="AdaptersGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  SelectionChanged="AdaptersGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="状态" Binding="{Binding ConnectionStateText}" Width="80" />
                <DataGridTextColumn Header="网卡" Binding="{Binding InterfaceAlias}" Width="1.6*" />
                <DataGridTextColumn Header="IPv4 地址" Binding="{Binding IPv4Address}" Width="1.2*" />
                <DataGridTextColumn Header="默认网关" Binding="{Binding DefaultGateway}" Width="1.1*" />
                <DataGridTextColumn Header="IPv4 DNS" Binding="{Binding DnsServers}" Width="1.25*" />
                <DataGridTextColumn Header="自动 Metric" Binding="{Binding AutomaticMetricText}" Width="90" />
                <DataGridTextColumn Header="接口 Metric" Binding="{Binding InterfaceMetric}" Width="84" />
                <DataGridTextColumn Header="路由 Metric" Binding="{Binding RouteMetricText}" Width="84" />
                <DataGridTextColumn Header="合计" Binding="{Binding EffectiveMetricText}" Width="60" />
                <DataGridTextColumn Header="ifIndex" Binding="{Binding InterfaceIndex}" Width="64" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2"
                Margin="0,12,0,0"
                Padding="14,12"
                Background="{DynamicResource ButtonBackground}"
                BorderBrush="{DynamicResource ButtonBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="DNS 连接修复"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource GlobalTextBrush}" />
                    <TextBlock Margin="0,4,0,0"
                               Text="将所选网卡的 IPv4 DNS 设置为 114.114.114.114，并立即刷新 Windows DNS 缓存。"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Button x:Name="SetDnsAndFlushButton"
                        Grid.Column="1"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        Content="设置 DNS 并刷新缓存"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        Click="SetDnsAndFlushButton_Click" />
            </Grid>
        </Border>

        <TextBlock x:Name="StatusText"
                   Grid.Row="3"
                   MinHeight="28"
                   Margin="0,10,0,6"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   TextWrapping="Wrap" />

        <DockPanel Grid.Row="4" LastChildFill="False">
            <Button x:Name="RefreshButton"
                    DockPanel.Dock="Left"
                    Margin="0,0,8,0"
                    Content="刷新"
                    Style="{StaticResource ActionButtonStyle}"
                    Click="RefreshButton_Click" />
            <Button x:Name="SetPreferredButton"
                    DockPanel.Dock="Left"
                    Margin="0,0,8,0"
                    Content="设为首选（Metric 5）"
                    MinWidth="160"
                    Style="{StaticResource ActionButtonStyle}"
                    Click="SetPreferredButton_Click" />
            <Button x:Name="RestoreAutomaticButton"
                    DockPanel.Dock="Left"
                    Margin="0,0,8,0"
                    Content="恢复自动 Metric"
                    MinWidth="130"
                    Style="{StaticResource ActionButtonStyle}"
                    Click="RestoreAutomaticButton_Click" />
            <Button x:Name="CloseButton"
                    DockPanel.Dock="Right"
                    Content="关闭"
                    MinWidth="88"
                    Style="{StaticResource ActionButtonStyle}"
                    Click="CloseButton_Click" />
        </DockPanel>
    </Grid>
</Window>
