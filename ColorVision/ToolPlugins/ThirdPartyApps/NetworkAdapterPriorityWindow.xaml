<Window x:Class="ColorVision.ToolPlugins.ThirdPartyApps.NetworkAdapterPriorityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IPv4 网卡优先级"
        Width="980"
        Height="580"
        MinWidth="820"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource GlobalBackground}"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonDefault}">
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="0,0,0,12"
                Padding="14"
                Background="{DynamicResource ButtonBackground}"
                BorderBrush="{DynamicResource ButtonBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <StackPanel>
                <TextBlock Text="选择首选上网网卡"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource GlobalTextBrush}" />
                <TextBlock Margin="0,7,0,0"
                           Text="选择目标网卡后，将其 IPv4 自动 Metric 关闭并设为 5。此工具只修改所选网卡，不会禁用或改动其他网卡。"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,3,0,0"
                           Text="实际选路还会考虑路由 Metric 和最长前缀匹配；执行修改时 Windows 会请求管理员授权。"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <DataGrid x:Name="AdaptersGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  SelectionChanged="AdaptersGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="状态" Binding="{Binding ConnectionStateText}" Width="80" />
                <DataGridTextColumn Header="网卡" Binding="{Binding InterfaceAlias}" Width="1.6*" />
                <DataGridTextColumn Header="IPv4 地址" Binding="{Binding IPv4Address}" Width="1.35*" />
                <DataGridTextColumn Header="默认网关" Binding="{Binding DefaultGateway}" Width="1.15*" />
                <DataGridTextColumn Header="自动 Metric" Binding="{Binding AutomaticMetricText}" Width="95" />
                <DataGridTextColumn Header="接口 Metric" Binding="{Binding InterfaceMetric}" Width="90" />
                <DataGridTextColumn Header="路由 Metric" Binding="{Binding RouteMetricText}" Width="90" />
                <DataGridTextColumn Header="合计" Binding="{Binding EffectiveMetricText}" Width="65" />
                <DataGridTextColumn Header="ifIndex" Binding="{Binding InterfaceIndex}" Width="70" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="StatusText"
                   Grid.Row="2"
                   MinHeight="28"
                   Margin="0,10,0,6"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   TextWrapping="Wrap" />

        <DockPanel Grid.Row="3" LastChildFill="False">
            <Button x:Name="RefreshButton"
                    DockPanel.Dock="Left"
                    Content="刷新"
                    Style="{StaticResource ActionButtonStyle}"
                    Click="RefreshButton_Click" />
            <Button x:Name="SetPreferredButton"
                    DockPanel.Dock="Left"
                    Content="设为首选（Metric 5）"
                    MinWidth="160"
                    Style="{StaticResource ActionButtonStyle}"
                    Click="SetPreferredButton_Click" />
            <Button x:Name="RestoreAutomaticButton"
                    DockPanel.Dock="Left"
                    Content="恢复自动 Metric"
                    MinWidth="130"
                    Style="{StaticResource ActionButtonStyle}"
                    Click="RestoreAutomaticButton_Click" />
            <Button x:Name="CloseButton"
                    DockPanel.Dock="Right"
                    Content="关闭"
                    MinWidth="88"
                    Style="{StaticResource ActionButtonStyle}"
                    Click="CloseButton_Click" />
        </DockPanel>
    </Grid>
</Window>
