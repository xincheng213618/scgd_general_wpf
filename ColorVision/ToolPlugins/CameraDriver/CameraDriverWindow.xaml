<Window x:Class="ColorVision.ToolPlugins.CameraDriver.CameraDriverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="680" Height="470" MinWidth="560" MinHeight="400"
        Background="{DynamicResource GlobalBackground}" Foreground="{DynamicResource GlobalTextBrush}"
        WindowStartupLocation="CenterOwner" Loaded="Window_Loaded" Closed="Window_Closed">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding Title}" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,18"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Padding="16" CornerRadius="8" Background="{DynamicResource ButtonBackground}"
                        BorderBrush="{DynamicResource ButtonBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="{Binding StatusSummary}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding VersionDetails}" Margin="0,12,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding Hint}" Margin="0,16,0,10" TextWrapping="Wrap"/>
                <TextBlock Margin="0,0,0,12">
                    <Hyperlink Click="DownloadPage_Click"><Run Text="{Binding DownloadPageText, Mode=OneWay}"/></Hyperlink>
                </TextBlock>
                <TextBlock Text="{Binding OperationMessage}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                <ProgressBar Height="4" Margin="0,12,0,0" IsIndeterminate="True">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{Binding RefreshText}" IsEnabled="{Binding CanRefresh}" Click="Refresh_Click"
                    Style="{DynamicResource ButtonDefault}" MinHeight="34" Padding="16,6" Margin="0,0,10,0"/>
            <Button Content="{Binding InstallText}" IsEnabled="{Binding CanInstall}" Click="Install_Click"
                    Style="{DynamicResource ButtonPrimary}" MinHeight="34" Padding="16,6" Margin="0,0,10,0"/>
            <Button Content="{Binding CloseText}" Click="Close_Click" Style="{DynamicResource ButtonDefault}" MinHeight="34" Padding="16,6"/>
        </StackPanel>
    </Grid>
</Window>
