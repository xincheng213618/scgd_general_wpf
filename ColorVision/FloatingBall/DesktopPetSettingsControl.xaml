<UserControl x:Class="ColorVision.FloatingBall.DesktopPetSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ColorVision.FloatingBall"
             Loaded="UserControl_Loaded" Unloaded="UserControl_Unloaded"
             Foreground="{DynamicResource GlobalTextBrush}">
    <UserControl.Resources>
        <Style x:Key="PetAction" TargetType="Button" BasedOn="{StaticResource ButtonDefault}">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Padding" Value="14,6" />
        </Style>
        <Style x:Key="PetPrimaryAction" TargetType="Button" BasedOn="{StaticResource PetAction}">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style x:Key="PetSection" TargetType="Border">
            <Setter Property="Padding" Value="16" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{DynamicResource GlobalBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="PetSecondaryText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="PetHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,20,0,10" />
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="0,4,0,20">
        <TextBlock FontSize="20" FontWeight="SemiBold" Text="{x:Static local:DesktopPetText.ChooseCompanion}" />
        <TextBlock Margin="0,6,0,0" Style="{StaticResource PetSecondaryText}" Text="{x:Static local:DesktopPetText.Subtitle}" />
        <WrapPanel Margin="0,16,0,0">
            <Button Margin="0,0,8,8" Click="CreatePetButton_Click" Content="{x:Static local:DesktopPetText.Create}" Style="{StaticResource PetPrimaryAction}" />
            <Button x:Name="WakePetButton" Margin="0,0,8,8" Click="WakePetButton_Click" Content="{x:Static local:DesktopPetText.Wake}" Style="{StaticResource PetAction}" />
            <Button x:Name="RefreshButton" Margin="0,0,8,8" Click="RefreshButton_Click" Content="{x:Static local:DesktopPetText.Refresh}" Style="{StaticResource PetAction}" />
        </WrapPanel>

        <TextBlock Style="{StaticResource PetHeading}" Margin="0,12,0,10" Text="{x:Static local:DesktopPetText.Preferences}" />
        <Border Style="{StaticResource PetSection}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{x:Static local:DesktopPetText.Appearance}" />
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" Orientation="Horizontal">
                        <TextBlock MinWidth="42" Margin="0,0,12,0" VerticalAlignment="Center" Style="{StaticResource PetSecondaryText}"
                                   Text="{Binding Config.PetScale, StringFormat={}{0:P0}}" />
                        <Slider Width="170" Minimum="0.65" Maximum="1.45" SmallChange="0.05" LargeChange="0.1" TickFrequency="0.05"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                AutomationProperties.Name="{x:Static local:DesktopPetText.Appearance}"
                                Value="{Binding Config.PetScale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>
                <Border Margin="0,14,0,14" BorderBrush="{DynamicResource ButtonBorderBrush}" BorderThickness="0,1,0,0" />
                <CheckBox IsChecked="{Binding Config.EnableCopilotIntegration}">
                    <TextBlock Text="{x:Static local:DesktopPetText.FollowCopilot}" TextWrapping="Wrap" />
                </CheckBox>
                <CheckBox Margin="0,9,0,0" IsEnabled="{Binding Config.EnableCopilotIntegration}" IsChecked="{Binding Config.ShowCopilotNotifications}">
                    <TextBlock Text="{x:Static local:DesktopPetText.CopilotNotifications}" TextWrapping="Wrap" />
                </CheckBox>
                <Button Margin="0,14,0,0" HorizontalAlignment="Left" Click="AdvancedButton_Click" Content="{x:Static local:DesktopPetText.Advanced}" Style="{StaticResource PetAction}" />
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource PetHeading}" Text="{x:Static local:DesktopPetText.AvailablePets}" />
        <TextBlock x:Name="StatusText" Margin="0,0,0,12" Style="{StaticResource PetSecondaryText}" Text="{x:Static local:DesktopPetText.Searching}" />
        <ItemsControl ItemsSource="{Binding Assets}" HorizontalContentAlignment="Stretch">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Width="246" Margin="0,0,12,12" Padding="14" CornerRadius="10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource GlobalBackground}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource CV.Tag.Background}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="58" Height="58" HorizontalAlignment="Left" Background="{DynamicResource CV.Surface.Alternate}" CornerRadius="8">
                                    <Image Margin="4" RenderOptions.BitmapScalingMode="NearestNeighbor" Source="{Binding Thumbnail}" Stretch="Uniform" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding DisplayName}" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,5,0,0" FontSize="11" Style="{StaticResource PetSecondaryText}" Text="{Binding SourceLabel}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock MinHeight="48" Margin="0,12,0,10" FontSize="12" Style="{StaticResource PetSecondaryText}" Text="{Binding Description}" />
                            <TextBlock Margin="0,0,0,8" FontSize="12" Foreground="{DynamicResource CV.Status.Error}" Text="{Binding Diagnostic}" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Diagnostic}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button Click="SelectPetButton_Click" Content="{Binding SelectButtonText}" IsEnabled="{Binding CanSelect}" Tag="{Binding}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PetAction}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Opacity" Value="1" />
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Style="{StaticResource PetHeading}" Margin="0,8,0,10" Text="{x:Static local:DesktopPetText.CustomPets}" />
        <Border Style="{StaticResource PetSection}">
            <StackPanel>
                <TextBlock Style="{StaticResource PetSecondaryText}" Text="{x:Static local:DesktopPetText.CustomSubtitle}" />
                <Button Margin="0,12,0,0" HorizontalAlignment="Left" Click="OpenPetFolderButton_Click" Content="{x:Static local:DesktopPetText.OpenFolder}" Style="{StaticResource PetAction}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
