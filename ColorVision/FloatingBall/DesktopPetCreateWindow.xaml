<Window x:Class="ColorVision.FloatingBall.DesktopPetCreateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ColorVision.FloatingBall"
        Title="{x:Static local:DesktopPetText.CreateTitle}"
        Width="660"
        Height="650"
        MinWidth="580"
        MinHeight="560"
        Background="{DynamicResource GlobalBackground}"
        Loaded="Window_Loaded"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource ButtonDefault}">
            <Setter Property="Padding" Value="14,5" />
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource GlobalTextBrush}"
                       Text="{x:Static local:DesktopPetText.CreateTitle}" />
            <TextBlock Margin="0,6,0,0"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Text="{x:Static local:DesktopPetText.CreateSubtitle}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <TabControl x:Name="CreationModeTabControl"
                    Grid.Row="1"
                    Margin="0,18,0,18"
                    SelectionChanged="CreationModeTabControl_SelectionChanged">
            <TabItem Header="{x:Static local:DesktopPetText.CreateWithCodex}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14,16,14,14">
                        <TextBlock FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource GlobalTextBrush}"
                                   Text="{x:Static local:DesktopPetText.GenerateWithCodex}" />
                        <TextBlock Margin="0,6,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="{x:Static local:DesktopPetText.CodexGenerationDescription}"
                                   TextWrapping="Wrap" />

                        <Border Margin="0,16,0,0"
                                Padding="12,10"
                                Background="{DynamicResource LayoutBackground}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="7">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold"
                                           Foreground="{DynamicResource GlobalTextBrush}"
                                           Text="{x:Static local:DesktopPetText.CodexStatus}" />
                                <TextBlock x:Name="CodexStatusText"
                                           Margin="0,4,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="{x:Static local:DesktopPetText.DetectingCodex}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="0,16,0,0"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource GlobalTextBrush}"
                                   Text="{x:Static local:DesktopPetText.Concept}" />
                        <TextBox x:Name="CodexConceptTextBox"
                                 Margin="0,7,0,0"
                                 MinHeight="104"
                                 MaxLength="600"
                                 Padding="9,7"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" />
                        <TextBlock Margin="0,6,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="{x:Static local:DesktopPetText.ConceptHint}"
                                   TextWrapping="Wrap" />

                        <Border Margin="0,16,0,0"
                                Padding="12,10"
                                Background="{DynamicResource LayoutBackground}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="7">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold"
                                           Foreground="{DynamicResource GlobalTextBrush}"
                                           Text="{x:Static local:DesktopPetText.NextSteps}" />
                                <TextBlock Margin="0,5,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="{x:Static local:DesktopPetText.NextStepsDescription}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{x:Static local:DesktopPetText.ImportSpriteSheet}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <Grid Margin="14,16,14,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource GlobalTextBrush}"
                                       FontWeight="SemiBold"
                                       Text="{x:Static local:DesktopPetText.PetName}" />
                            <TextBox x:Name="PetNameTextBox"
                                     Margin="0,7,0,0"
                                     MaxLength="80"
                                     MinHeight="32"
                                     Padding="8,5" />
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    Margin="0,15,0,0">
                            <TextBlock Foreground="{DynamicResource GlobalTextBrush}"
                                       FontWeight="SemiBold"
                                       Text="{x:Static local:DesktopPetText.OptionalDescription}" />
                            <TextBox x:Name="DescriptionTextBox"
                                     Margin="0,7,0,0"
                                     MaxLength="240"
                                     MinHeight="56"
                                     Padding="8,5"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" />
                        </StackPanel>

                        <StackPanel Grid.Row="2"
                                    Margin="0,15,0,0">
                            <TextBlock Foreground="{DynamicResource GlobalTextBrush}"
                                       FontWeight="SemiBold"
                                       Text="{x:Static local:DesktopPetText.SpriteSheetFile}" />
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="SpriteSheetPathTextBox"
                                         MinHeight="32"
                                         Padding="8,5"
                                         VerticalContentAlignment="Center" />
                                <Button Grid.Column="1"
                                        MinWidth="82"
                                        Height="32"
                                        Margin="8,0,0,0"
                                        Click="BrowseButton_Click"
                                        Content="{x:Static local:DesktopPetText.Browse}" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Row="3"
                                    Margin="0,15,0,0">
                            <TextBlock Foreground="{DynamicResource GlobalTextBrush}"
                                       FontWeight="SemiBold"
                                       Text="{x:Static local:DesktopPetText.SpriteSheetFormat}" />
                            <ComboBox x:Name="SpriteVersionComboBox"
                                      Margin="0,7,0,0"
                                      MinHeight="32"
                                      Padding="7,4"
                                      SelectedIndex="0">
                                <ComboBoxItem Tag="2"
                                              Content="{x:Static local:DesktopPetText.FormatV2}" />
                                <ComboBoxItem Tag="1"
                                              Content="{x:Static local:DesktopPetText.FormatV1}" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Row="4"
                                    Margin="0,15,0,0">
                            <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="{x:Static local:DesktopPetText.ImportHint}"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="ImportStatusText"
                                       Margin="0,8,0,0"
                                       Foreground="{DynamicResource CV.Status.Error}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button MinWidth="88"
                    Height="34"
                    IsCancel="True"
                    Content="{x:Static local:DesktopPetText.Cancel}" />
            <Button x:Name="PrimaryButton"
                    Background="{DynamicResource PrimaryBrush}"
                    BorderBrush="{DynamicResource PrimaryBrush}"
                    Foreground="White"
                    MinWidth="118"
                    Height="34"
                    Margin="10,0,0,0"
                    Click="PrimaryButton_Click"
                    IsDefault="True"
                    IsEnabled="False"
                    Content="{x:Static local:DesktopPetText.Detecting}" />
        </StackPanel>
    </Grid>
</Window>
