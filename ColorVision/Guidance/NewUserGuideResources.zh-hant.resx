  <data name="MenuHeader" xml:space="preserve"><value>新手導覽(_N)</value></data>
  <data name="WelcomeTitle" xml:space="preserve"><value>歡迎使用 ColorVision</value></data>
  <data name="WelcomeDescription" xml:space="preserve"><value>用一分鐘瞭解 ColorVision 的核心介面，快速找到裝置、解決方案與工作區。</value></data>
  <data name="DismissWelcomeAction" xml:space="preserve"><value>稍後瞭解</value></data>
  <data name="StartTourAction" xml:space="preserve"><value>開始導覽</value></data>
  <data name="StepProgressFormat" xml:space="preserve"><value>第 {0} 步，共 {1} 步</value></data>
