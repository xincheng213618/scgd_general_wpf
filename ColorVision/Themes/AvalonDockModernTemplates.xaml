<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
                    xmlns:ad="clr-namespace:AvalonDock;assembly=AvalonDock"
                    xmlns:chrome="clr-namespace:ColorVision.Themes"
                    xmlns:controls="clr-namespace:AvalonDock.Controls;assembly=AvalonDock"
                    xmlns:converters="clr-namespace:AvalonDock.Converters;assembly=AvalonDock"
                    xmlns:properties="clr-namespace:AvalonDock.Properties;assembly=AvalonDock">
    <ResourceDictionary.MergedDictionaries>
        <!-- Supplies command menus, icons and the base manager style, not a second engine. -->
        <ResourceDictionary Source="/ColorVision;component/Themes/AvalonDockGripTemplates.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="DockingCaptionButtonStyle" TargetType="{x:Type primitives:ButtonBase}">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource DockingMutedTextBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type primitives:ButtonBase}">
                    <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource DockingHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource DockingTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource DockingPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Native Windows line icons; the MDL2 family supplies the same glyphs on older Windows. -->
    <Style x:Key="DockingCaptionGlyphStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontStyle" Value="Normal" />
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type primitives:ButtonBase}}}" />
    </Style>
    <Style x:Key="DockingDropDownButtonStyle" TargetType="{x:Type controls:DropDownButton}" BasedOn="{StaticResource DockingCaptionButtonStyle}">
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource DockingPressedBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource DockingTextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="DockingTitleTemplate">
        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
    </DataTemplate>

    <Style TargetType="{x:Type controls:AnchorablePaneTitle}">
        <Setter Property="Background" Value="{DynamicResource GlobalBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource DockingMutedTextBrush}" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:AnchorablePaneTitle}">
                    <!-- The entire painted title is inside the native right-click area,
                         including its padding. AnchorablePaneTitle still owns dragging. -->
                    <controls:DropDownControlArea HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                        DropDownContextMenu="{Binding Model.Root.Manager.AnchorableContextMenu, RelativeSource={RelativeSource TemplatedParent}}"
                        DropDownContextMenuDataContext="{Binding LayoutItem, RelativeSource={RelativeSource TemplatedParent}}"
                        Style="{DynamicResource DropDownControlArea}">
                        <Border x:Name="CaptionBorder" Background="{TemplateBinding Background}" CornerRadius="3,3,0,0">
                            <Grid Margin="7,0,2,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="Header" Margin="0,0,4,0" VerticalAlignment="Center"
                                    Content="{Binding Model, RelativeSource={RelativeSource TemplatedParent}}"
                                    ContentTemplate="{Binding Model.Root.Manager.AnchorableTitleTemplate, RelativeSource={RelativeSource TemplatedParent}}"
                                    ContentTemplateSelector="{Binding Model.Root.Manager.AnchorableTitleTemplateSelector, RelativeSource={RelativeSource TemplatedParent}}"
                                    TextElement.Foreground="{TemplateBinding Foreground}" />
                                <controls:DropDownButton x:Name="MenuDropDownButton" Grid.Column="1" Style="{StaticResource DockingDropDownButtonStyle}"
                                    DropDownContextMenu="{Binding Model.Root.Manager.AnchorableContextMenu, RelativeSource={RelativeSource TemplatedParent}}"
                                    DropDownContextMenuDataContext="{Binding LayoutItem, RelativeSource={RelativeSource TemplatedParent}}"
                                    ToolTip="{x:Static properties:Resources.Anchorable_CxMenu_Hint}">
                                    <TextBlock Style="{StaticResource DockingCaptionGlyphStyle}" Text="&#xE70D;" />
                                </controls:DropDownButton>
                                <Button x:Name="PART_AutoHidePin" Grid.Column="2" Style="{StaticResource DockingCaptionButtonStyle}"
                                    Command="{Binding LayoutItem.AutoHideCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                    ToolTip="{x:Static properties:Resources.Anchorable_BtnAutoHide_Hint}"
                                    Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={converters:BoolToVisibilityConverter}}">
                                    <TextBlock x:Name="AutoHideGlyph" Style="{StaticResource DockingCaptionGlyphStyle}" Text="&#xE718;" />
                                </Button>
                                <Button x:Name="PART_HidePin" Grid.Column="3" Style="{StaticResource DockingCaptionButtonStyle}"
                                    Command="{Binding LayoutItem.HideCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                    ToolTip="{x:Static properties:Resources.Anchorable_BtnClose_Hint}"
                                    Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={converters:BoolToVisibilityConverter}}">
                                    <TextBlock Style="{StaticResource DockingCaptionGlyphStyle}" Text="&#xE711;" />
                                </Button>
                            </Grid>
                        </Border>
                    </controls:DropDownControlArea>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Model.IsActive, RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource DockingTextBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Model.IsAutoHidden, RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter TargetName="AutoHideGlyph" Property="Text" Value="&#xE77A;" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Model.CanClose, RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter TargetName="PART_HidePin" Property="Command" Value="{Binding LayoutItem.CloseCommand, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="PART_HidePin" Property="ToolTip" Value="{x:Static properties:Resources.Document_Close}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DockingDocumentTabStyle" TargetType="{x:Type TabItem}">
        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
        <Setter Property="ToolTip" Value="{Binding ToolTip}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource DockingMutedTextBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="MaxWidth" Value="240" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Grid>
                        <chrome:DockingTabBorder x:Name="DocumentTabBorder" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1,1,1,0"
                            CornerRadius="3" Placement="Top" IsSelected="{TemplateBinding IsSelected}" SnapsToDevicePixels="True"
                            IsHitTestVisible="False" />
                        <!-- Keep the real LayoutDocumentTabItem over the full painted tab,
                             so padding routes to its native menu and drag handlers too. -->
                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsSelected" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="{DynamicResource DockingHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource DockingTextBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource DockingSurfaceBackground}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource DockingBorderBrush}" />
                            <Setter Property="Panel.ZIndex" Value="1" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource DockingTextBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource DockingAccentBrush}" />
                        </DataTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:LayoutDocumentTabItem}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:LayoutDocumentTabItem}">
                    <controls:DropDownControlArea HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                        DropDownContextMenu="{Binding Model.Root.Manager.DocumentContextMenu, RelativeSource={RelativeSource TemplatedParent}}"
                        DropDownContextMenuDataContext="{Binding LayoutItem, RelativeSource={RelativeSource TemplatedParent}}"
                        Style="{DynamicResource DropDownControlArea}">
                        <Border Background="Transparent" BorderBrush="Transparent" BorderThickness="1,1,1,0" Padding="8,0,3,0">
                            <Grid MinHeight="25">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- Emphasize only the caption, not the native menu owner. -->
                                <ContentPresenter x:Name="DocumentHeader" Margin="0,0,5,0" VerticalAlignment="Center" TextElement.FontWeight="Normal"
                                    Content="{Binding Model, RelativeSource={RelativeSource TemplatedParent}}"
                                    ContentTemplate="{Binding Model.Root.Manager.DocumentHeaderTemplate, RelativeSource={RelativeSource TemplatedParent}}"
                                    ContentTemplateSelector="{Binding Model.Root.Manager.DocumentHeaderTemplateSelector, RelativeSource={RelativeSource TemplatedParent}}"
                                    TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}" />
                                <!-- Hidden, not collapsed, for ordinary unselected tabs: hover never changes their width. -->
                                <Button x:Name="PART_CloseButton" Grid.Column="1" Width="22" Height="22" Visibility="Hidden"
                                    Style="{StaticResource DockingCaptionButtonStyle}"
                                    Command="{Binding LayoutItem.CloseCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                    ToolTip="{x:Static properties:Resources.Document_Close}">
                                    <TextBlock Style="{StaticResource DockingCaptionGlyphStyle}" Text="&#xE711;" />
                                </Button>
                            </Grid>
                        </Border>
                    </controls:DropDownControlArea>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Visible" />
                            <Setter TargetName="DocumentHeader" Property="TextElement.FontWeight" Value="SemiBold" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsLastFocusedDocument}" Value="True">
                            <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <DataTrigger Binding="{Binding CanClose}" Value="False">
                            <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <!-- A tool hosted in the document well can be hideable without being closeable. -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding CanClose}" Value="False" />
                                <Condition Binding="{Binding CanHide, FallbackValue=False}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="PART_CloseButton" Property="Command" Value="{Binding LayoutItem.HideCommand, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="PART_CloseButton" Property="ToolTip" Value="{x:Static properties:Resources.Anchorable_Hide}" />
                            <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DockingDocumentPaneStyle" TargetType="{x:Type controls:LayoutDocumentPaneControl}"
           BasedOn="{StaticResource AvalonDockThemeVs2013DocumentPaneControlStyle}">
        <Setter Property="Background" Value="{DynamicResource DockingSurfaceBackground}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource DockingDocumentTabStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:LayoutDocumentPaneControl}">
                    <Grid Background="Transparent" ClipToBounds="True" SnapsToDevicePixels="True" KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid x:Name="TabStrip" Panel.ZIndex="1" Background="{DynamicResource GlobalBackground}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="TabStripLine" Grid.ColumnSpan="2" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DockingBorderBrush}" />
                            <controls:DocumentPaneTabPanel x:Name="HeaderPanel" IsItemsHost="True" KeyboardNavigation.TabIndex="1" />
                            <controls:DropDownButton x:Name="MenuDropDownButton" Grid.Column="1" Margin="3,0,2,0"
                                Style="{StaticResource DockingDropDownButtonStyle}">
                                <controls:DropDownButton.DropDownContextMenu>
                                    <controls:ContextMenuEx ItemsSource="{Binding Model.ChildrenSorted, RelativeSource={RelativeSource TemplatedParent}}" />
                                </controls:DropDownButton.DropDownContextMenu>
                                <TextBlock Style="{StaticResource DockingCaptionGlyphStyle}" Text="&#xE70D;" />
                            </controls:DropDownButton>
                        </Grid>
                        <chrome:DockingSurfaceBorder x:Name="DocumentPaneBorder" Grid.Row="1" Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource DockingBorderBrush}" BorderThickness="1,0,1,1" CornerRadius="0,0,4,4"
                            KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabIndex="2" KeyboardNavigation.TabNavigation="Cycle">
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                        </chrome:DockingSurfaceBorder>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding SelectedItem.IsActive, RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter TargetName="TabStripLine" Property="BorderBrush" Value="{DynamicResource DockingAccentBrush}" />
                            <Setter TargetName="DocumentPaneBorder" Property="BorderBrush" Value="{DynamicResource DockingAccentBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Model.ShowHeader, RelativeSource={RelativeSource Self}}" Value="False">
                            <Setter TargetName="TabStrip" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="DocumentPaneBorder" Property="BorderThickness" Value="1" />
                            <Setter TargetName="DocumentPaneBorder" Property="CornerRadius" Value="4" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Model.ChildrenCount, RelativeSource={RelativeSource Self}}" Value="0">
                            <Setter TargetName="TabStrip" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="DocumentPaneBorder" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DockingToolTabStyle" TargetType="{x:Type TabItem}">
        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
        <Setter Property="Foreground" Value="{DynamicResource DockingMutedTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="ToolTip" Value="{Binding ToolTip}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Grid MinHeight="26">
                        <chrome:DockingTabBorder x:Name="ToolTabBorder" Background="{TemplateBinding Background}"
                            BorderThickness="1,0,1,1" BorderBrush="{TemplateBinding BorderBrush}" CornerRadius="4"
                            Placement="Bottom" IsSelected="{TemplateBinding IsSelected}" IsHitTestVisible="False" />
                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsSelected" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="{DynamicResource DockingHoverBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource DockingTextBrush}" />
                            <Setter Property="Background" Value="{DynamicResource GlobalBackground}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource DockingBorderBrush}" />
                            <Setter Property="Panel.ZIndex" Value="1" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource DockingAccentBrush}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Items.Count, RelativeSource={RelativeSource AncestorType={x:Type TabControl}}}" Value="1">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type controls:LayoutAnchorableTabItem}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:LayoutAnchorableTabItem}">
                    <controls:DropDownControlArea HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                        DropDownContextMenu="{Binding Model.Root.Manager.AnchorableContextMenu, RelativeSource={RelativeSource TemplatedParent}}"
                        DropDownContextMenuDataContext="{Binding LayoutItem, RelativeSource={RelativeSource TemplatedParent}}"
                        Style="{DynamicResource DropDownControlArea}">
                        <Border Background="Transparent" BorderBrush="Transparent" BorderThickness="1,0,1,1" Padding="10,3">
                            <ContentPresenter VerticalAlignment="Center"
                                Content="{Binding Model, RelativeSource={RelativeSource TemplatedParent}}"
                                ContentTemplate="{Binding Model.Root.Manager.AnchorableHeaderTemplate, RelativeSource={RelativeSource TemplatedParent}}"
                                ContentTemplateSelector="{Binding Model.Root.Manager.AnchorableHeaderTemplateSelector, RelativeSource={RelativeSource TemplatedParent}}"
                                TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}" />
                        </Border>
                    </controls:DropDownControlArea>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DockingToolPaneStyle" TargetType="{x:Type controls:LayoutAnchorablePaneControl}"
           BasedOn="{StaticResource AvalonDockThemeVs2013AnchorablePaneControlStyle}">
        <Setter Property="Background" Value="{DynamicResource GlobalBackground}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource DockingToolTabStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:LayoutAnchorablePaneControl}">
                    <Grid Background="{DynamicResource GlobalBackground}" ClipToBounds="True" SnapsToDevicePixels="True" KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <chrome:DockingSurfaceBorder x:Name="ToolPaneBorder" Background="{TemplateBinding Background}" CornerRadius="4,4,0,0"
                            BorderThickness="1,1,1,0" BorderBrush="{DynamicResource DockingBorderBrush}">
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"
                                KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabIndex="2" KeyboardNavigation.TabNavigation="Cycle" />
                        </chrome:DockingSurfaceBorder>
                        <Grid x:Name="ToolTabStrip" Grid.Row="1">
                            <Border x:Name="ToolTabStripLine" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DockingBorderBrush}" />
                            <controls:AnchorablePaneTabPanel x:Name="HeaderPanel" IsItemsHost="True" KeyboardNavigation.TabIndex="1" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding SelectedItem.IsActive, RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter TargetName="ToolPaneBorder" Property="BorderBrush" Value="{DynamicResource DockingAccentBrush}" />
                            <Setter TargetName="ToolTabStripLine" Property="BorderBrush" Value="{DynamicResource DockingAccentBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Items.Count, RelativeSource={RelativeSource Self}}" Value="1">
                            <!-- Keep the items host in layout so its selection binding can
                                 create the content/title even when the only tab is hidden. -->
                            <Setter TargetName="ToolTabStrip" Property="Height" Value="0" />
                            <Setter TargetName="ToolPaneBorder" Property="CornerRadius" Value="4" />
                            <Setter TargetName="ToolPaneBorder" Property="BorderThickness" Value="1" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:LayoutAnchorableControl}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:LayoutAnchorableControl}">
                    <!-- The pane supplies the outline once, around title, content and bottom tabs. -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <controls:AnchorablePaneTitle x:Name="Header" Model="{Binding Model, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ContentPresenter Grid.Row="1" Content="{Binding LayoutItem.View, RelativeSource={RelativeSource TemplatedParent}}"
                            ContentTemplate="{Binding LayoutItem.View.ContentTemplate, RelativeSource={RelativeSource TemplatedParent}}"
                            ContentTemplateSelector="{Binding LayoutItem.View.ContentTemplateSelector, RelativeSource={RelativeSource TemplatedParent}}"
                            FlowDirection="{TemplateBinding FlowDirection}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Model.IsFloating, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding Model.Parent.IsDirectlyHostedInFloatingWindow, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Header" Property="Visibility" Value="Collapsed" />
                        </MultiDataTrigger>
                        <DataTrigger Binding="{Binding Model, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                            <Setter TargetName="Header" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The upstream manager captured its pane styles with StaticResource. Replace the
         setters too; an implicit TabItem or pane style alone never reaches these panes. -->
    <Style TargetType="{x:Type ad:DockingManager}" BasedOn="{StaticResource ColorVisionBaseDockingManagerStyle}">
        <Setter Property="Background" Value="{DynamicResource GlobalBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource DockingTextBrush}" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="DocumentPaneControlStyle" Value="{StaticResource DockingDocumentPaneStyle}" />
        <Setter Property="AnchorablePaneControlStyle" Value="{StaticResource DockingToolPaneStyle}" />
        <Setter Property="AnchorableTitleTemplate" Value="{StaticResource DockingTitleTemplate}" />
    </Style>
</ResourceDictionary>
