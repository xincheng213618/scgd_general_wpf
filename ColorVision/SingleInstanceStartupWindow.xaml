<Window x:Class="ColorVision.SingleInstanceStartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ColorVision 启动" Width="570" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource UpdateDialog.Background}"
        UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ColorVision;component/Update/UpdateDialogTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="StatusText" Text="正在关闭旧程序" FontSize="20" FontWeight="SemiBold"
                   TextWrapping="Wrap" Foreground="{DynamicResource UpdateDialog.TextPrimary}" />
        <TextBlock Grid.Row="1" x:Name="ProcessesText" Margin="0,12,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource UpdateDialog.TextSecondary}" />
        <ProgressBar Grid.Row="2" x:Name="ClosingProgress" Margin="0,18,0,18" Height="4" IsIndeterminate="True" />
        <StackPanel Grid.Row="3">
            <TextBlock x:Name="FailureText" Margin="0,0,0,16" TextWrapping="Wrap" LineHeight="22"
                       Visibility="Collapsed" Foreground="{DynamicResource UpdateDialog.TextPrimary}" />
            <TextBlock TextWrapping="Wrap" LineHeight="22" Foreground="{DynamicResource UpdateDialog.TextSecondary}">
                强制结束会中断旧程序，确认退出后自动继续启动。未保存的数据可能丢失。<LineBreak />
                “直接打开”仅本次允许多开，不修改全局设置。旧进程仍可能占用端口或设备。
            </TextBlock>
        </StackPanel>
        <Grid Grid.Row="4" Margin="0,24,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="CancelButton" Content="取消启动" IsCancel="True" Click="Cancel_Click"
                    Style="{StaticResource UpdateDialogTextButtonStyle}" />
            <Button Grid.Column="2" x:Name="OpenButton" Content="直接打开" IsDefault="True" Click="Open_Click"
                    Margin="0,0,10,0" Style="{StaticResource UpdateDialogSecondaryButtonStyle}" />
            <Button Grid.Column="3" x:Name="ForceButton" Content="重试结束" IsEnabled="False" Click="Force_Click"
                    Style="{StaticResource UpdateDialogPrimaryButtonStyle}" />
        </Grid>
    </Grid>
</Window>
