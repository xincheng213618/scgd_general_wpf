<UserControl x:Class="ColorVision.Settings.Maintenance.StorageMaintenanceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ColorVision.Settings.Maintenance"
             Loaded="Control_Loaded" Unloaded="Control_Unloaded"
             Foreground="{DynamicResource GlobalTextBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,22,0,10"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource GlobalBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource ButtonDefault.Small}">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="MinWidth" Value="76"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style x:Key="SecondaryText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Opacity" Value="0.76"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style x:Key="DataRow" TargetType="Grid">
            <Setter Property="Margin" Value="18,14"/>
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="{x:Static local:MaintenanceText.Management}" Style="{StaticResource SectionHeading}"/>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <Grid Style="{StaticResource DataRow}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0"><TextBlock Text="{x:Static local:MaintenanceText.FileManagement}" FontSize="14"/><TextBlock Text="{x:Static local:MaintenanceText.FileManagementDescription}" Style="{StaticResource SecondaryText}"/></StackPanel>
                    <Button x:Name="FileManagementButton" Grid.Column="1" Content="{x:Static local:MaintenanceText.Manage}" Style="{StaticResource ActionButton}" Click="Files_Click"/>
                </Grid>
                <Separator Margin="18,0"/>
                <Grid Style="{StaticResource DataRow}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0"><TextBlock Text="{x:Static local:MaintenanceText.MemoryManagement}" FontSize="14"/><TextBlock Text="{x:Static local:MaintenanceText.MemoryManagementDescription}" Style="{StaticResource SecondaryText}"/></StackPanel>
                    <Button x:Name="MemoryManagementButton" Grid.Column="1" Content="{x:Static local:MaintenanceText.Manage}" Style="{StaticResource ActionButton}" Click="Memory_Click"/>
                </Grid>
            </StackPanel>
        </Border>
        <TextBlock Text="{x:Static local:MaintenanceText.History}" Style="{StaticResource SectionHeading}"/>
        <Border Style="{StaticResource Card}" IsEnabled="{Binding IsIdle}">
            <StackPanel>
                <Grid Style="{StaticResource DataRow}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0"><TextBlock Text="{x:Static local:MaintenanceText.Database}" FontSize="14"/><TextBlock Text="{x:Static local:MaintenanceText.DatabaseDescription}" Style="{StaticResource SecondaryText}"/></StackPanel>
                    <Button Grid.Column="1" Content="{x:Static local:MaintenanceText.Manage}" Style="{StaticResource ActionButton}" Click="Database_Click"/>
                </Grid>
                <Separator Margin="18,0"/>
                <Grid Style="{StaticResource DataRow}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0"><TextBlock Text="{x:Static local:MaintenanceText.Snapshots}" FontSize="14"/><TextBlock Text="{x:Static local:MaintenanceText.SnapshotsDescription}" Style="{StaticResource SecondaryText}"/></StackPanel>
                    <Button Grid.Column="1" Content="{x:Static local:MaintenanceText.Manage}" Style="{StaticResource ActionButton}" Click="Snapshots_Click"/>
                </Grid>
                <Separator Margin="18,0"/>
                <Grid Style="{StaticResource DataRow}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0"><TextBlock Text="{x:Static local:MaintenanceText.ConfigBackup}" FontSize="14"/><TextBlock Text="{x:Static local:MaintenanceText.ConfigBackupDescription}" Style="{StaticResource SecondaryText}"/></StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{x:Static local:MaintenanceText.OpenFolder}" Style="{StaticResource ActionButton}" Click="OpenBackups_Click"/>
                        <Button Content="{x:Static local:MaintenanceText.CreateBackup}" Style="{StaticResource ActionButton}" Click="Backup_Click"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
        <TextBlock Text="{Binding Status}" Style="{StaticResource SecondaryText}" Margin="18,6,18,0" AutomationProperties.LiveSetting="Polite"/>
        <TextBlock Text="{x:Static local:MaintenanceText.Reset}" Style="{StaticResource SectionHeading}"/>
        <Border Style="{StaticResource Card}" Padding="18,16" IsEnabled="{Binding IsIdle}">
            <StackPanel>
                <TextBlock Text="{x:Static local:MaintenanceText.ResetDescription}" Style="{StaticResource SecondaryText}"/>
                <WrapPanel x:Name="ResetOptions" Margin="0,14,0,14">
                    <CheckBox Content="{x:Static local:MaintenanceText.Appearance}" Tag="ColorVision.Themes.ThemeConfig,ThemeConfig,ColorVision.UI.Languages.LanguageConfig,LanguageConfig" IsChecked="True" Margin="0,0,20,10"/>
                    <CheckBox Content="{x:Static local:MaintenanceText.Window}" Tag="ColorVision.MainWindowConfig,MainWindowConfig" IsChecked="True" Margin="0,0,20,10"/>
                    <CheckBox Content="{x:Static local:MaintenanceText.Hotkeys}" Tag="ColorVision.UI.HotKey.HotKeyConfig,HotKeyConfig" Margin="0,0,20,10"/>
                    <CheckBox Content="{x:Static local:MaintenanceText.Search}" Tag="ColorVision.UI.Serach.SearchConfig,SearchConfig" Margin="0,0,20,10"/>
                    <CheckBox Content="{x:Static local:MaintenanceText.Viewer}" Tag="ColorVision.Solution.MultiImageViewer.MultiImageViewerConfig,MultiImageViewerConfig" Margin="0,0,20,10"/>
                </WrapPanel>
                <TextBlock x:Name="ResetStatus" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12"/>
                <Border HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="CancelResetButton" Content="{x:Static local:MaintenanceText.CancelReset}" Style="{StaticResource ActionButton}" Click="CancelReset_Click"/>
                        <Button Content="{x:Static local:MaintenanceText.ScheduleReset}" Style="{StaticResource ActionButton}" Foreground="{DynamicResource GlobalTextBrush}" Click="Reset_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
