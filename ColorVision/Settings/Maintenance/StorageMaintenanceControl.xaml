<UserControl x:Class="ColorVision.Settings.Maintenance.StorageMaintenanceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ColorVision.Settings.Maintenance"
             Loaded="Control_Loaded" Unloaded="Control_Unloaded"
             Foreground="{DynamicResource GlobalTextBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,22,0,10"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource GlobalBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource ButtonDefault.Small}">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="MinWidth" Value="76"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style x:Key="SecondaryText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Opacity" Value="0.76"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style x:Key="DataRow" TargetType="Grid">
            <Setter Property="Margin" Value="18,14"/>
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <Border Style="{StaticResource Card}" Padding="18,16">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="{x:Static local:MaintenanceText.Space}" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Text="{x:Static local:MaintenanceText.Reclaimable}" Style="{StaticResource SecondaryText}"/>
                    <TextBlock Text="{Binding Summary}" FontSize="26" FontWeight="SemiBold" Margin="0,6,0,0"/>
                    <TextBlock Text="{x:Static local:MaintenanceText.Protected}" Style="{StaticResource SecondaryText}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button x:Name="ScanButton" Content="{x:Static local:MaintenanceText.Scan}" Style="{StaticResource ActionButton}" IsEnabled="{Binding IsIdle}" Click="Scan_Click"/>
                    <Button x:Name="CleanSelectedButton" Content="{x:Static local:MaintenanceText.CleanSelected}" Style="{StaticResource ActionButton}" IsEnabled="{Binding CanCleanSelected}" Click="CleanSelected_Click" Margin="6,8,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Margin="2,10,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12" AutomationProperties.LiveSetting="Polite"/>
                <Button Content="{x:Static local:MaintenanceText.ViewWarnings}" HorizontalAlignment="Left" Margin="0,6,0,0" Click="Warnings_Click"
                        Visibility="{Binding HasIssues, Converter={StaticResource BoolVisibility}}"/>
            </StackPanel>
            <Button Grid.Column="1" Content="{x:Static local:MaintenanceText.Cancel}" Style="{StaticResource ActionButton}" Click="Cancel_Click"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"/>
        </Grid>
        <Border Style="{StaticResource Card}">
            <ItemsControl ItemsSource="{Binding Items}" IsEnabled="{Binding IsIdle}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource ButtonBorderBrush}" BorderThickness="0,0,0,1" Padding="16,13">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Top" Margin="0,3,0,0" AutomationProperties.Name="{Binding Title}"/>
                                <StackPanel Grid.Column="1" Margin="4,0,18,0">
                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource SecondaryText}"/>
                                    <TextBlock Text="{Binding Notice}" Style="{StaticResource SecondaryText}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,9,0,0" Visibility="{Binding HasRetention, Converter={StaticResource BoolVisibility}}">
                                        <TextBlock Text="{x:Static local:MaintenanceText.Keep}" VerticalAlignment="Center" FontSize="12"/>
                                        <ComboBox ItemsSource="{Binding RetentionOptions}" SelectedItem="{Binding RetentionDays}" Width="68" MinWidth="0" Margin="8,0" AutomationProperties.Name="{Binding Title}"/>
                                        <TextBlock Text="{x:Static local:MaintenanceText.Days}" VerticalAlignment="Center" FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="150">
                                    <TextBlock Text="{Binding SizeText}" HorizontalAlignment="Right" FontSize="12" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="{x:Static local:MaintenanceText.Details}" Style="{StaticResource ActionButton}" IsEnabled="{Binding IsScanned}" Click="Details_Click"/>
                                        <Button Content="{x:Static local:MaintenanceText.Clean}" Style="{StaticResource ActionButton}" IsEnabled="{Binding CanClean}" Click="CleanItem_Click" MinWidth="56"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
        <TextBlock Text="{x:Static local:MaintenanceText.History}" Style="{StaticResource SectionHeading}"/>
        <Border Style="{StaticResource Card}" IsEnabled="{Binding IsIdle}">
            <StackPanel>
                <Grid Style="{StaticResource DataRow}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0"><TextBlock Text="{x:Static local:MaintenanceText.Database}" FontSize="14"/><TextBlock Text="{x:Static local:MaintenanceText.DatabaseDescription}" Style="{StaticResource SecondaryText}"/></StackPanel>
                    <Button Grid.Column="1" Content="{x:Static local:MaintenanceText.Manage}" Style="{StaticResource ActionButton}" Click="Database_Click"/>
                </Grid>
                <Separator Margin="18,0"/>
                <Grid Style="{StaticResource DataRow}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0"><TextBlock Text="{x:Static local:MaintenanceText.Snapshots}" FontSize="14"/><TextBlock Text="{x:Static local:MaintenanceText.SnapshotsDescription}" Style="{StaticResource SecondaryText}"/></StackPanel>
                    <Button Grid.Column="1" Content="{x:Static local:MaintenanceText.Manage}" Style="{StaticResource ActionButton}" Click="Snapshots_Click"/>
                </Grid>
                <Separator Margin="18,0"/>
                <Grid Style="{StaticResource DataRow}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0"><TextBlock Text="{x:Static local:MaintenanceText.ConfigBackup}" FontSize="14"/><TextBlock Text="{x:Static local:MaintenanceText.ConfigBackupDescription}" Style="{StaticResource SecondaryText}"/></StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{x:Static local:MaintenanceText.OpenFolder}" Style="{StaticResource ActionButton}" Click="OpenBackups_Click"/>
                        <Button Content="{x:Static local:MaintenanceText.CreateBackup}" Style="{StaticResource ActionButton}" Click="Backup_Click"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
        <TextBlock Text="{x:Static local:MaintenanceText.Reset}" Style="{StaticResource SectionHeading}"/>
        <Border Style="{StaticResource Card}" Padding="18,16" IsEnabled="{Binding IsIdle}">
            <StackPanel>
                <TextBlock Text="{x:Static local:MaintenanceText.ResetDescription}" Style="{StaticResource SecondaryText}"/>
                <WrapPanel x:Name="ResetOptions" Margin="0,14,0,14">
                    <CheckBox Content="{x:Static local:MaintenanceText.Appearance}" Tag="ThemeConfig,LanguageConfig" IsChecked="True" Margin="0,0,20,10"/>
                    <CheckBox Content="{x:Static local:MaintenanceText.Window}" Tag="MainWindowConfig" IsChecked="True" Margin="0,0,20,10"/>
                    <CheckBox Content="{x:Static local:MaintenanceText.Hotkeys}" Tag="HotKeyConfig" Margin="0,0,20,10"/>
                    <CheckBox Content="{x:Static local:MaintenanceText.Search}" Tag="SearchConfig" Margin="0,0,20,10"/>
                    <CheckBox Content="{x:Static local:MaintenanceText.Viewer}" Tag="MultiImageViewerConfig" Margin="0,0,20,10"/>
                </WrapPanel>
                <TextBlock x:Name="ResetStatus" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12"/>
                <Border HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="CancelResetButton" Content="{x:Static local:MaintenanceText.CancelReset}" Style="{StaticResource ActionButton}" Click="CancelReset_Click"/>
                        <Button Content="{x:Static local:MaintenanceText.ScheduleReset}" Style="{StaticResource ActionButton}" Foreground="{DynamicResource GlobalTextBrush}" Click="Reset_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
