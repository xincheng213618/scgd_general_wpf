<Window x:Class="ColorVision.StartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:ColorVision"
        xmlns:startup="clr-namespace:ColorVision.Startup"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d" Title="{x:Static startup:StartupText.Title}" Width="820" Height="460"
        MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="{DynamicResource Startup.Surface}" BorderThickness="0"
        UseLayoutRounding="True" Initialized="Window_Initialized">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="460" ResizeBorderThickness="0" CornerRadius="32" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="Startup.Surface" Color="#080E19" />
        <SolidColorBrush x:Key="Startup.Ink" Color="#E1EBF6" />
        <SolidColorBrush x:Key="Startup.Muted" Color="#93A6BD" />
        <SolidColorBrush x:Key="Startup.Faint" Color="#71849D" />
        <SolidColorBrush x:Key="Startup.Border" Color="#283445" />
        <SolidColorBrush x:Key="Startup.Track" Color="#243041" />
        <LinearGradientBrush x:Key="Startup.Progress" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#68E6E8" Offset="0" />
            <GradientStop Color="#7CA9FF" Offset="0.55" />
            <GradientStop Color="#B6A0FF" Offset="1" />
        </LinearGradientBrush>
        <Style x:Key="StartupProgressBarStyle" TargetType="{x:Type ProgressBar}">
            <Setter Property="Height" Value="2" />
            <Setter Property="Background" Value="{DynamicResource Startup.Track}" />
            <Setter Property="Foreground" Value="{DynamicResource Startup.Progress}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ProgressBar}">
                        <Grid ClipToBounds="True">
                            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Viewbox Stretch="Uniform">
        <Grid x:Name="StartupRoot" Width="820" Height="460" Background="{DynamicResource Startup.Surface}" ClipToBounds="True">
            <local:StartupScene x:Name="startupScene" Width="820" Height="460" />
            <Border Margin="0.5" CornerRadius="16" BorderThickness="1" BorderBrush="{DynamicResource Startup.Border}" IsHitTestVisible="False" />
            <Grid Margin="38,30,38,29">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid TextElement.FontFamily="Segoe UI" TextElement.FontSize="10" TextElement.Foreground="{DynamicResource Startup.Muted}">
                    <TextBlock Text="V I S I O N   /   C O M P U T E" />
                    <TextBlock x:Name="labelVersion" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{DynamicResource Startup.Faint}" Text="1.4.14.22" />
                </Grid>
                <StackPanel Grid.Row="2">
                    <TextBlock x:Name="headlineText" Text="{x:Static startup:StartupText.Headline}" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="24" FontWeight="Light" Foreground="{DynamicResource Startup.Ink}" />
                    <Grid Margin="0,14,0,17">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="startupStatusText" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="11" Foreground="{DynamicResource Startup.Muted}" Text="{x:Static startup:StartupText.PreparingWorkspace}" AutomationProperties.LiveSetting="Polite" />
                        <TextBlock x:Name="capabilitiesText" Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="9" Foreground="{DynamicResource Startup.Faint}" Text="{x:Static startup:StartupText.Capabilities}" />
                    </Grid>
                    <ProgressBar x:Name="startupProgressBar" Minimum="0" Maximum="1" Value="0" Style="{StaticResource StartupProgressBarStyle}" AutomationProperties.Name="{x:Static startup:StartupText.ProgressAutomationName}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Viewbox>
</Window>
