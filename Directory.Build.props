<Project>
	<PropertyGroup>
		<_ColorVisionFileIOProjectPath>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', 'Engine', 'ColorVision.FileIO', 'ColorVision.FileIO.csproj'))</_ColorVisionFileIOProjectPath>
	</PropertyGroup>
	<PropertyGroup>
		<AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)ColorVision.snk</AssemblyOriginatorKeyFile>
		<SignAssembly Condition="Exists('$(AssemblyOriginatorKeyFile)')">True</SignAssembly>
		<SignAssembly Condition="!Exists('$(AssemblyOriginatorKeyFile)')">False</SignAssembly>
		<!-- PLATFORM_SUPPORT_POLICY: ColorVision 宿主运行时、官方插件和客户项目交付包当前仅支持 x64。 -->
		<Platforms>x64</Platforms>
		<Platform Condition="'$(MSBuildProjectExtension)' == '.csproj' and '$(MSBuildProjectFullPath)' != '$(_ColorVisionFileIOProjectPath)' and ('$(Platform)' == '' or '$(Platform)' == 'AnyCPU')">x64</Platform>
		<PlatformTarget Condition="'$(MSBuildProjectExtension)' == '.csproj' and '$(MSBuildProjectFullPath)' != '$(_ColorVisionFileIOProjectPath)'">x64</PlatformTarget>
		<PackageTags>ColorVision</PackageTags>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<AnalysisMode>Recommended</AnalysisMode>
		<TargetFrameworks>net10.0-windows</TargetFrameworks>
		<NoWarn>CS8002</NoWarn>
		<AcceptNPOIOSMFLicense>true</AcceptNPOIOSMFLicense>
		<VersionPrefix>1.4.13.2</VersionPrefix>
		<EnableWindowsTargeting>true</EnableWindowsTargeting>
		<CETCompat>false</CETCompat>
	</PropertyGroup>
	<ItemGroup>
		<ColorVisionPlatformRole Include="X64" Condition="'$(MSBuildProjectExtension)' == '.csproj'" />
	</ItemGroup>
	<PropertyGroup>
		<Copyright>Copyright (C) 2026 ColorVision Corporation</Copyright>
		<AssemblyCompany>ColorVision Corp.</AssemblyCompany>
		<AssemblyCopyright>Copyright (C) 2026 ColorVision Corporation</AssemblyCopyright>
		<AssemblyProduct>ColorVision</AssemblyProduct>
		<Company>ColorVision</Company>
		<NeutralLanguage>zh-CN</NeutralLanguage>
		<Authors>xincheng</Authors>
		<PackageProjectUrl>https://github.com/xincheng213618/scgd_general_wpf</PackageProjectUrl>
		<IncludeSymbols>True</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<RepositoryUrl>https://github.com/xincheng213618/scgd_general_wpf</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
	</PropertyGroup>
</Project>
