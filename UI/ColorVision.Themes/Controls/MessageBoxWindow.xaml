<Window x:Class="ColorVision.Themes.Controls.MessageBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:properties="clr-namespace:ColorVision.Themes.Properties"
        WindowStartupLocation="CenterScreen" SizeToContent="Height" Width="400"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource CV.Surface.Window}" Foreground="{DynamicResource CV.Text.Primary}"
        FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ColorVision.Themes;component/Themes/Components/Dialog.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- A solid focus ring stays visible in both themes, including on the primary action. -->
            <Style x:Key="MessageBoxFocus" TargetType="Control">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Control">
                            <Border Margin="-3" CornerRadius="10" BorderThickness="2"
                                    BorderBrush="{DynamicResource CV.Accent.Primary}" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="MessageBoxButton" TargetType="Button" BasedOn="{StaticResource CV.Button.Secondary}">
                <Setter Property="MinWidth" Value="88" />
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="Padding" Value="18,6" />
                <Setter Property="Margin" Value="8,0,0,0" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource MessageBoxFocus}" />
            </Style>
            <Style x:Key="MessageBoxPrimaryButton" TargetType="Button" BasedOn="{StaticResource CV.Button.Primary}">
                <Setter Property="MinWidth" Value="88" />
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="Padding" Value="18,6" />
                <Setter Property="Margin" Value="8,0,0,0" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource MessageBoxFocus}" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid x:Name="LayoutRoot" KeyboardNavigation.TabNavigation="Cycle">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid x:Name="DockMsg" Margin="24,24,24,22" MinHeight="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="IconHost" Width="40" Height="40" Margin="0,0,16,0"
                  VerticalAlignment="Top" Visibility="Collapsed">
                <Border CornerRadius="12" Background="{Binding Stroke, ElementName=IconPath}" Opacity="0.12" />
                <Viewbox Width="22" Height="22">
                    <Canvas Width="24" Height="24">
                        <Path x:Name="IconPath" Stroke="{DynamicResource CV.Accent.Primary}"
                              StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" />
                    </Canvas>
                </Viewbox>
            </Grid>
            <!-- Keep selection/copy support without inheriting the application's input-field template. -->
            <TextBox x:Name="messageBoxText" Grid.Column="1" Style="{x:Null}"
                     IsReadOnly="True" IsReadOnlyCaretVisible="False" IsTabStop="False"
                     Background="Transparent" Foreground="{DynamicResource CV.Text.Primary}"
                     BorderThickness="0" Padding="0" TextWrapping="Wrap"
                     VerticalAlignment="Center" VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled" TextBlock.LineHeight="23">
                <TextBox.Template>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                      VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
                    </ControlTemplate>
                </TextBox.Template>
            </TextBox>
        </Grid>
        <Border Grid.Row="1" Background="{DynamicResource CV.Surface.Alternate}"
                BorderBrush="{DynamicResource CV.Border.Weak}" BorderThickness="0,1,0,0" Padding="24,16">
            <StackPanel>
                <CheckBox x:Name="show_again" Visibility="Collapsed" Margin="0,0,0,16"
                          Foreground="{DynamicResource CV.Text.Secondary}"
                          IsChecked="{Binding DontShowAgain}" Content="{x:Static properties:Resources.MsgBox_DontShowAgain}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ButtonOK" Visibility="Collapsed" Style="{StaticResource MessageBoxPrimaryButton}"
                            Content="{x:Static properties:Resources.OK}" Click="ResultButton_Click" />
                    <Button x:Name="ButtonYes" Visibility="Collapsed" Style="{StaticResource MessageBoxPrimaryButton}"
                            Content="{x:Static properties:Resources.Yes}" Click="ResultButton_Click" />
                    <Button x:Name="ButtonNo" Visibility="Collapsed" Style="{StaticResource MessageBoxButton}"
                            Content="{x:Static properties:Resources.No}" Click="ResultButton_Click" />
                    <Button x:Name="ButtonCancel" Visibility="Collapsed" Style="{StaticResource MessageBoxButton}"
                            Content="{x:Static properties:Resources.Cancel}" Click="ResultButton_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
