<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <Color x:Key="defaultgreyColor">#212121</Color>

    <SolidColorBrush x:Key="IconSolidColorBrush" Color="#AA000000"/>
    <SolidColorBrush x:Key="IconSolidColorBackgroundBrush" Color="#FFFFFFFF"/>
    


    <Color x:Key="GlobalBackgroundColor">White</Color>
    <Color x:Key="GlobalBroderBrushColor">#F9F9F9</Color>
    <Color x:Key="GlobalTextColor">Black</Color>
    <Color x:Key="UpdateDialogBackgroundColor">White</Color>
    <Color x:Key="UpdateDialogSurfaceColor">#FBFBFB</Color>
    <Color x:Key="UpdateDialogSurfaceHoverColor">#F9F9F9</Color>
    <Color x:Key="UpdateDialogBorderColor">#E5E5E5</Color>
    <Color x:Key="UpdateDialogTextPrimaryColor">Black</Color>
    <Color x:Key="UpdateDialogTextSecondaryColor">Black</Color>
    <Color x:Key="UpdateDialogAccentColor">#007ACC</Color>
    <Color x:Key="UpdateDialogAccentHoverColor">#007ACC</Color>

    <Color x:Key="TerminalBackgroundColor">#F3F5F7</Color>
    <Color x:Key="TerminalForegroundColor">#1F2933</Color>
    <SolidColorBrush x:Key="TerminalBackgroundBrush" Color="{StaticResource TerminalBackgroundColor}"/>
    <SolidColorBrush x:Key="TerminalForegroundBrush" Color="{StaticResource TerminalForegroundColor}"/>
    <SolidColorBrush x:Key="TerminalCursorBrush" Color="#8037475A"/>
    <SolidColorBrush x:Key="TerminalSelectionBrush" Color="#663A8DDE"/>
    <SolidColorBrush x:Key="TerminalUrlBrush" Color="#0969DA"/>

    <!-- Avalon editor: VS-inspired light palette. Syntax colors intentionally differ
         from the dark palette instead of being mechanically inverted. -->
    <SolidColorBrush x:Key="EditorBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="EditorForegroundBrush" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="EditorLineNumberBrush" Color="#6E7681"/>
    <SolidColorBrush x:Key="EditorCaretBrush" Color="#000000"/>
    <SolidColorBrush x:Key="EditorSelectionBrush" Color="#ADD6FF"/>
    <SolidColorBrush x:Key="EditorSelectionForegroundBrush" Color="#000000"/>
    <SolidColorBrush x:Key="EditorCurrentLineBrush" Color="#FFFCE8"/>
    <Pen x:Key="EditorCurrentLineBorderPen" Brush="#E5E5E5" Thickness="1"/>
    <SolidColorBrush x:Key="EditorNonPrintableBrush" Color="#8A8A8A"/>
    <SolidColorBrush x:Key="EditorLinkBrush" Color="#006AB1"/>
    <SolidColorBrush x:Key="EditorSyntaxCommentBrush" Color="#008000"/>
    <SolidColorBrush x:Key="EditorSyntaxStringBrush" Color="#A31515"/>
    <SolidColorBrush x:Key="EditorSyntaxNumberBrush" Color="#098658"/>
    <SolidColorBrush x:Key="EditorSyntaxKeywordBrush" Color="#0000FF"/>
    <SolidColorBrush x:Key="EditorSyntaxTypeBrush" Color="#267F99"/>
    <SolidColorBrush x:Key="EditorSyntaxMethodBrush" Color="#795E26"/>
    <SolidColorBrush x:Key="EditorSyntaxPropertyBrush" Color="#001080"/>
    <SolidColorBrush x:Key="EditorSyntaxPreprocessorBrush" Color="#666666"/>
    <SolidColorBrush x:Key="EditorSyntaxTagBrush" Color="#800000"/>
    <SolidColorBrush x:Key="EditorSyntaxErrorBrush" Color="#A31515"/>
    <SolidColorBrush x:Key="EditorSyntaxAddedBrush" Color="#008000"/>
    <SolidColorBrush x:Key="EditorSyntaxBackgroundBrush" Color="#F3F3F3"/>


    <Color x:Key="SelectedBackgroundColor">#FFC5CBF9</Color>
    <Color x:Key="SelectedUnfocusedColor">#FFDDDDDD</Color>

    <SolidColorBrush x:Key="BordrBrush">#D5DFE5</SolidColorBrush>


    <SolidColorBrush x:Key="ButtonBackground" Color="#FBFBFB" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#E5E5E5" />

    <SolidColorBrush x:Key="GlobalBackground" Color="{StaticResource GlobalBackgroundColor}" />
    <SolidColorBrush x:Key="GlobalBorderBrush" Color="{StaticResource GlobalBroderBrushColor}"/>


    <SolidColorBrush x:Key="GlobalBorderBrush1" Color="#EAEAEA"/>

    

    <SolidColorBrush x:Key="GlobalTextBrush" Color="{StaticResource GlobalTextColor}" />
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#007ACC"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource UpdateDialogAccentColor}"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource GlobalTextColor}"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#666666"/>
    <SolidColorBrush x:Key="MeasureBackground" Color="{StaticResource GlobalBackgroundColor}"/>
    <SolidColorBrush x:Key="MeasureBarBackgroundBrush" Color="#CCCEDB"/>


    <SolidColorBrush x:Key="CaptionButtonBrush" Color="{StaticResource GlobalTextColor}"/>
    <SolidColorBrush x:Key="CaptionButtonForeground" Color="{StaticResource GlobalTextColor}"/>
    <SolidColorBrush x:Key="TitleBarActionForeground" Color="#303030"/>
    <SolidColorBrush x:Key="TitleBarActionInactiveForeground" Color="#808080"/>
    <SolidColorBrush x:Key="WindowIsNotActiveForeground">#d7d7d7</SolidColorBrush>
    <SolidColorBrush x:Key="CaptionButtonChoiceBrush">#C7CACF</SolidColorBrush>
    <SolidColorBrush x:Key="CaptionButtonChoiceBackgrouundBrush">#E5E5E5</SolidColorBrush>
    <SolidColorBrush x:Key="CaptionButtonCloseBrush" Color="Red"/>

    <!--MenuItem-->
    <SolidColorBrush x:Key="MenuBrushKey"   Color="{DynamicResource GlobalBackgroundColor}"/>
    <SolidColorBrush x:Key="MenuHighBrushKey"   Color="#EDEDED"/>
    <SolidColorBrush x:Key="SubMenuBrushKey"   Color="#FAFAFA"/>
    <SolidColorBrush x:Key="SubMenuBorderBrushKey"   Color="#DEDEDE"/>


    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />

    <SolidColorBrush x:Key="MenuItemSeparatorFillTop" Color="#E4E4E4" />
    <SolidColorBrush x:Key="MenuItemSeparatorFillBottom" Color="Transparent" />

    <SolidColorBrush x:Key="SystemColorsMenuText" Color="#FF000000" />

    <SolidColorBrush  x:Key="ControlShadow" Color="#71000000" />

    <SolidColorBrush x:Key="toplevelmenuheaderhoverborder" Color="#F4F5F7" />
    <SolidColorBrush x:Key="toplevelmenuheaderhover" Color="#F0F0F0" />
    <SolidColorBrush x:Key="menuitemglyphpanelborderbrush" Color="#F4F5F7" />
    <SolidColorBrush x:Key="MenuItemHighlightedInnerBorder" Color="#FFF5F5F5" />
    <SolidColorBrush x:Key="MenuItemDisabledForeground" Color="#808080" />
    <SolidColorBrush x:Key="MenuItemSecondaryForeground" Color="#656565" />
    <SolidColorBrush x:Key="MenuItemDisabledGlyphPanelBackground" Color="#FFA2A4A5" />

    <SolidColorBrush x:Key="MenuItemDisabledGlyphFill" Color="#808080" />
    <SolidColorBrush x:Key="environmentcommandbar"  Color="#FFCFD6E5"  />
    <SolidColorBrush x:Key="environmentcommandbaricon" Color="#FFCFD6E5" />
    <SolidColorBrush x:Key="EnvironmentCommandBarMenuMouseOverSubmenuGlyph" Color="#FF000000" />
    <SolidColorBrush x:Key="environmentcommandbarmenuseparator" Color="#FFF0F0F0" />
    <SolidColorBrush x:Key="EnvironmentCommandBarCheckBox" Color="#FF000000" />
    <SolidColorBrush x:Key="EnvironmentCommandBarSelectedIcon" Color="#FFE9ECEE" />
    <SolidColorBrush x:Key="EnvironmentCommandBarCheckBoxMouseOver" Color="#FF000000" />
    <SolidColorBrush x:Key="EnvironmentCommandBarHoverOverSelectedIcon" Color="#EDEDED" />
    <SolidColorBrush x:Key="EnvironmentCommandBarMenuItemMouseOver" Color="#EDEDED" />

    <SolidColorBrush x:Key="ContextMenuBackground" Color="#FAFAFA" />
    <SolidColorBrush x:Key="ContextMenuBorderBrush" Color="#DEDEDE" />
    <SolidColorBrush x:Key="ContextMenuRectangleFill" Color="#FAFAFA" />
    <DropShadowEffect x:Key="MenuPopupShadowEffect" Color="Black" BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.16" RenderingBias="Performance"/>
</ResourceDictionary>




