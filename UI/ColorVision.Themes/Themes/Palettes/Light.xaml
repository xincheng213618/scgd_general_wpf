    <SolidColorBrush x:Key="EnvironmentCommandBarSelectedIcon" Color="#FFE9ECEE" />

    <SolidColorBrush x:Key="EnvironmentCommandBarCheckBoxMouseOver" Color="#FF000000" />

    <SolidColorBrush x:Key="EnvironmentCommandBarHoverOverSelectedIcon" Color="#EDEDED" />

    <SolidColorBrush x:Key="EnvironmentCommandBarMenuItemMouseOver" Color="#EDEDED" />

    <SolidColorBrush x:Key="ContextMenuBackground" Color="#FAFAFA" />

    <SolidColorBrush x:Key="ContextMenuBorderBrush" Color="#DEDEDE" />

    <SolidColorBrush x:Key="ContextMenuRectangleFill" Color="#FAFAFA" />

    <DropShadowEffect x:Key="MenuPopupShadowEffect" Color="Black" BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.16" RenderingBias="Performance"/>

    <SolidColorBrush x:Key="BorderBackGroud1" Color="#F2F2F2" />

    <SolidColorBrush x:Key="BorderBackGroud2" Color="#F2F2F2" />
</ResourceDictionary>
