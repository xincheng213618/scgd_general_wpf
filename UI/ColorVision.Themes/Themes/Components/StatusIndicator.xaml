<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="ButtonDrawingImageHardDisk"  TargetType="{x:Type ToggleButton}">
        <Setter Property="Height"  Value="20"/>
        <Setter Property="Margin"  Value="0,-10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Image x:Name="image1" Source="{DynamicResource DrawingImageHardDiskRed}"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter  TargetName="image1" Property="Source" Value="{DynamicResource DrawingImageHardDisk}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ButtonDrawingImageMysql"  TargetType="{x:Type ToggleButton}">
        <Setter Property="Height"  Value="20"/>
        <Setter Property="Margin"  Value="0,-10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Image x:Name="image1" Source="{DynamicResource DrawingImageMysqlRed}"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter  TargetName="image1" Property="Source" Value="{DynamicResource DrawingImageMysql}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ButtonDrawingImageMQTT"  TargetType="{x:Type ToggleButton}">
        <Setter Property="Height"  Value="20"/>
        <Setter Property="Margin"  Value="0,-10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Image x:Name="image1" Source="{DynamicResource DrawingImageMQTTRed}"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter  TargetName="image1" Property="Source" Value="{DynamicResource DrawingImageMQTT}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ButtonDrawingImageRCService"  TargetType="{x:Type ToggleButton}">
        <Setter Property="Height"  Value="15"/>
        <Setter Property="Margin"  Value="0,-10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Image x:Name="image1" Source="{DynamicResource DrawingImageRCServiceRed}"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter  TargetName="image1" Property="Source" Value="{DynamicResource DrawingImageRCService}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ButtonMQTTConnect"  TargetType="{x:Type ToggleButton}">
        <Setter Property="Height"  Value="20"/>
        <Setter Property="Margin"  Value="0,-10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Ellipse x:Name="e1" Width="{TemplateBinding Width}" Height="{TemplateBinding Width}" Fill="RED" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter  TargetName="e1" Property="Fill" Value="Green"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
