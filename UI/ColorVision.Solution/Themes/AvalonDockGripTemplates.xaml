    Modern caption chrome retains the upstream floating-window commands, resize
    border and hit-testing contract. The decorative dotted grip is not required
    for dragging; WindowChrome owns the caption hit area.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:display="clr-namespace:ColorVision.Solution"
                    xmlns:dockingTheme="clr-namespace:ColorVision.Solution.Themes"
                    xmlns:avalonDock="clr-namespace:AvalonDock;assembly=AvalonDock"
                    xmlns:avalonDockControls="clr-namespace:AvalonDock.Controls;assembly=AvalonDock"
                    xmlns:avalonDockConverters="clr-namespace:AvalonDock.Converters;assembly=AvalonDock"
                    xmlns:avalonDockProperties="clr-namespace:AvalonDock.Properties;assembly=AvalonDock"
                    xmlns:uiDocking="clr-namespace:ColorVision.UI.Docking;assembly=ColorVision.UI"
                    xmlns:wpfShell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
                    xmlns:shell="clr-namespace:Microsoft.Windows.Shell;assembly=AvalonDock">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/AvalonDock.Themes.VS2013;component/Themes/Generic.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Capture the upstream manager under a distinct key before the modern dictionary
         replaces its implicit type key, without relying on same-key lookup ordering. -->
    <Style x:Key="ColorVisionBaseDockingManagerStyle" TargetType="{x:Type avalonDock:DockingManager}"
           BasedOn="{StaticResource {x:Type avalonDock:DockingManager}}" />

    <!-- Windows icon fonts provide the same thin caption glyphs as the docked titles. -->
    <Style x:Key="ColorVisionFloatingCaptionGlyphStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Control}}}" />
    </Style>

    <Style x:Key="ColorVisionFloatingCaptionButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource DockingMutedTextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource DockingHoverBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource DockingTextBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource DockingPressedBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ColorVisionFloatingCaptionMenuStyle" TargetType="{x:Type avalonDockControls:DropDownButton}">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource DockingMutedTextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type avalonDockControls:DropDownButton}">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource DockingHoverBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource DockingTextBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource DockingPressedBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource DockingPressedBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource DockingTextBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <uiDocking:DockPanelTitleActionsConverter x:Key="DockPanelTitleActionsConverter" />

    <Style x:Key="DockingTitleActionItemsStyle" TargetType="{x:Type ItemsControl}">
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate DataType="{x:Type uiDocking:DockPanelTitleAction}">
                    <Button x:Name="PanelTitleActionButton"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        wpfShell:WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.Name="{Binding ToolTip, TargetNullValue={display:DisplayText Key='操作'}, FallbackValue={display:DisplayText Key='操作'}}"
                        Command="{Binding Command}" ToolTip="{Binding ToolTip}">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource ColorVisionFloatingCaptionButtonStyle}">
                                <Setter Property="Width" Value="24" />
                                <Setter Property="Height" Value="24" />
                                <Setter Property="CommandParameter" Value="{Binding CommandParameter}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PassButtonAsParameter}" Value="True">
                                        <Setter Property="CommandParameter" Value="{Binding RelativeSource={RelativeSource Self}}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Style="{StaticResource ColorVisionFloatingCaptionGlyphStyle}" Text="{Binding Glyph}" />
                    </Button>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type avalonDockControls:LayoutAnchorableFloatingWindowControl}">
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource GlobalBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource DockingTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DockingBorderBrush}" />
        <Setter Property="shell:WindowChrome.WindowChrome">
            <Setter.Value>
                <!-- Keep DWM's shadow without a top glass band that hit-tests invisible system caption buttons. -->
                <shell:WindowChrome CaptionHeight="20" CornerRadius="8" GlassFrameThickness="1,0,1,1" ResizeBorderThickness="5" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type avalonDockControls:LayoutAnchorableFloatingWindowControl}">
                    <dockingTheme:FloatingWindowFrame>
                        <!-- AvalonDock hosts the pane in a child HWND. Reserve the curved lower
                             edge in this window so that even opaque hosted content clears it. -->
                        <Border x:Name="WindowBorder" Background="{DynamicResource DockingChromeBackground}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="0,0,0,6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="24" MinHeight="24" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border x:Name="Header" dockingTheme:FloatingWindowFrame.IsCaption="True" Padding="6,0,0,0" Background="{DynamicResource CV.Surface.Alternate}" CornerRadius="7,7,0,0" TextElement.Foreground="{DynamicResource DockingTextBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Padding="0,0,6,0" VerticalAlignment="Center" ClipToBounds="True"
                                                Visibility="{Binding Model.IsSinglePane, RelativeSource={RelativeSource TemplatedParent}, Converter={avalonDockConverters:BoolToVisibilityConverter}}">
                                            <avalonDockControls:DropDownControlArea
                                                DropDownContextMenu="{Binding Model.Root.Manager.AnchorableContextMenu, RelativeSource={RelativeSource TemplatedParent}}"
                                                DropDownContextMenuDataContext="{Binding SingleContentLayoutItem, RelativeSource={RelativeSource TemplatedParent}}"
                                                Style="{DynamicResource DropDownControlArea}">
                                                <ContentPresenter Content="{Binding Model.SinglePane.SelectedContent, RelativeSource={RelativeSource TemplatedParent}}"
                                                                  ContentTemplate="{Binding Model.Root.Manager.AnchorableTitleTemplate, RelativeSource={RelativeSource TemplatedParent}}"
                                                                  ContentTemplateSelector="{Binding Model.Root.Manager.AnchorableTitleTemplateSelector, RelativeSource={RelativeSource TemplatedParent}}" />
                                            </avalonDockControls:DropDownControlArea>
                                        </Border>

                                        <ItemsControl Grid.Column="1" Style="{StaticResource DockingTitleActionItemsStyle}"
                                            ItemsSource="{Binding Model.SinglePane.SelectedContent.Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource DockPanelTitleActionsConverter}}" />
                                        <avalonDockControls:DropDownButton x:Name="SinglePaneContextMenu" Grid.Column="2"
                                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                            DropDownContextMenu="{Binding Model.Root.Manager.AnchorableContextMenu, RelativeSource={RelativeSource TemplatedParent}}"
                                            DropDownContextMenuDataContext="{Binding SingleContentLayoutItem, RelativeSource={RelativeSource TemplatedParent}}"
                                            Style="{StaticResource ColorVisionFloatingCaptionMenuStyle}"
                                            ToolTip="{x:Static avalonDockProperties:Resources.Anchorable_CxMenu_Hint}"
                                            Visibility="{Binding Model.IsSinglePane, RelativeSource={RelativeSource TemplatedParent}, Converter={avalonDockConverters:BoolToVisibilityConverter}}">
                                            <TextBlock x:Name="PART_ImgPinMenu" Text="&#xE70D;" FontSize="10" Style="{StaticResource ColorVisionFloatingCaptionGlyphStyle}" />
                                        </avalonDockControls:DropDownButton>
                                        <Button x:Name="PART_PinMaximize" Grid.Column="3" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                                Command="{x:Static shell:SystemCommands.MaximizeWindowCommand}"
                                                CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                Style="{StaticResource ColorVisionFloatingCaptionButtonStyle}"
                                                ToolTip="{x:Static avalonDockProperties:Resources.Window_Maximize}"
                                                Visibility="{Binding IsMaximized, RelativeSource={RelativeSource TemplatedParent}, Converter={avalonDockConverters:InverseBoolToVisibilityConverter}}">
                                            <TextBlock x:Name="PART_ImgPinMaximize" Text="&#xE922;" FontSize="10" Style="{StaticResource ColorVisionFloatingCaptionGlyphStyle}" />
                                        </Button>
                                        <Button x:Name="PART_PinRestore" Grid.Column="3" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                                Command="{x:Static shell:SystemCommands.RestoreWindowCommand}"
                                                CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                Style="{StaticResource ColorVisionFloatingCaptionButtonStyle}"
                                                ToolTip="{x:Static avalonDockProperties:Resources.Window_Restore}"
                                                Visibility="{Binding IsMaximized, RelativeSource={RelativeSource TemplatedParent}, Converter={avalonDockConverters:BoolToVisibilityConverter}}">
                                            <TextBlock x:Name="PART_ImgPinRestore" Text="&#xE923;" FontSize="10" Style="{StaticResource ColorVisionFloatingCaptionGlyphStyle}" />
                                        </Button>
                                        <Button x:Name="PART_PinClose" Grid.Column="4" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                                Command="{Binding HideWindowCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                                Style="{StaticResource ColorVisionFloatingCaptionButtonStyle}"
                                                ToolTip="{x:Static avalonDockProperties:Resources.Anchorable_BtnClose_Hint}"
                                                Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Mode=OneWay, Converter={avalonDockConverters:BoolToVisibilityConverter}}">
                                            <TextBlock x:Name="PART_ImgPinClose" Text="&#xE711;" FontSize="14" Style="{StaticResource ColorVisionFloatingCaptionGlyphStyle}" />
                                        </Button>
                                    </Grid>
                                </Border>
                                <ContentPresenter x:Name="FloatingContent" Grid.Row="1" Content="{TemplateBinding Content}" />
                            </Grid>
                        </Border>
                    </dockingTheme:FloatingWindowFrame>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Model.SinglePane.Children.Count, RelativeSource={RelativeSource TemplatedParent}}" Value="1">
                            <Setter TargetName="WindowBorder" Property="Background" Value="{DynamicResource GlobalBackground}" />
                        </DataTrigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter TargetName="WindowBorder" Property="BorderThickness" Value="0" />
                            <Setter TargetName="WindowBorder" Property="CornerRadius" Value="0" />
                            <Setter TargetName="Header" Property="CornerRadius" Value="0" />
                        </Trigger>
                        <Trigger Property="IsActive" Value="True">
                            <Setter TargetName="WindowBorder" Property="BorderBrush" Value="{DynamicResource DockingAccentBrush}" />
                            <Setter TargetName="SinglePaneContextMenu" Property="Foreground" Value="{DynamicResource DockingTextBrush}" />
                            <Setter TargetName="PART_PinMaximize" Property="Foreground" Value="{DynamicResource DockingTextBrush}" />
                            <Setter TargetName="PART_PinRestore" Property="Foreground" Value="{DynamicResource DockingTextBrush}" />
                            <Setter TargetName="PART_PinClose" Property="Foreground" Value="{DynamicResource DockingTextBrush}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding Model.SinglePane.SelectedContent.CanClose, RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter TargetName="PART_PinClose" Property="Command" Value="{Binding CloseWindowCommand, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="PART_PinClose" Property="ToolTip" Value="{x:Static avalonDockProperties:Resources.Document_Close}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <dockingTheme:FloatingDocumentCaption x:Key="FloatingDocumentCaption" />
    <dockingTheme:FloatingDocumentHostPrefix x:Key="FloatingDocumentHostPrefix" />

    <Style x:Key="FloatingDocumentButton" TargetType="Button" BasedOn="{StaticResource ColorVisionFloatingCaptionButtonStyle}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="28" />
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}" />
    </Style>

    <Style TargetType="{x:Type avalonDockControls:LayoutDocumentFloatingWindowControl}">
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource DockingSurfaceBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DockingBorderBrush}" />
        <Setter Property="dockingTheme:FloatingDocumentCaption.Document">
            <Setter.Value>
                <MultiBinding Converter="{StaticResource FloatingDocumentCaption}">
                    <Binding Path="Model" RelativeSource="{RelativeSource Self}" />
                    <Binding Path="Model.SinglePane.SelectedContent" RelativeSource="{RelativeSource Self}" />
                    <Binding Path="Model.Root.ActiveContent" RelativeSource="{RelativeSource Self}" />
                </MultiBinding>
            </Setter.Value>
        </Setter>
        <Setter Property="Title" Value="{Binding Path=(dockingTheme:FloatingDocumentCaption.Document).Title, RelativeSource={RelativeSource Self}, FallbackValue='', TargetNullValue=''}" />
        <Setter Property="shell:WindowChrome.WindowChrome">
            <Setter.Value>
                <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="5" CornerRadius="8"
                                    GlassFrameThickness="1,0,1,1" ShowSystemMenu="False" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type avalonDockControls:LayoutDocumentFloatingWindowControl}">
                    <dockingTheme:FloatingWindowFrame x:Name="Frame">
                        <Border x:Name="WindowBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="36" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border x:Name="Header" Background="Transparent" Padding="6,0,2,0"
                                        dockingTheme:FloatingWindowFrame.IsCaption="True" TextElement.Foreground="{DynamicResource DockingMutedTextBrush}">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button x:Name="PART_PinMaximize" Style="{StaticResource FloatingDocumentButton}"
                                                    Command="{x:Static shell:SystemCommands.MaximizeWindowCommand}" CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                    ToolTip="{x:Static avalonDockProperties:Resources.Window_Maximize}">
                                                <TextBlock Style="{StaticResource ColorVisionFloatingCaptionGlyphStyle}" FontSize="10" Text="&#xE922;" />
                                            </Button>
                                            <Button x:Name="PART_PinRestore" Style="{StaticResource FloatingDocumentButton}" Visibility="Collapsed"
                                                    Command="{x:Static shell:SystemCommands.RestoreWindowCommand}" CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                    ToolTip="{x:Static avalonDockProperties:Resources.Window_Restore}">
                                                <TextBlock Style="{StaticResource ColorVisionFloatingCaptionGlyphStyle}" FontSize="10" Text="&#xE923;" />
                                            </Button>
                                            <Button x:Name="PART_PinClose" Style="{StaticResource FloatingDocumentButton}"
                                                    Command="{Binding CloseWindowCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                                    Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={avalonDockConverters:BoolToVisibilityConverter}}"
                                                    ToolTip="{x:Static avalonDockProperties:Resources.Document_Close}">
                                                <TextBlock Style="{StaticResource ColorVisionFloatingCaptionGlyphStyle}" FontSize="13" Text="&#xE711;" />
                                            </Button>
                                        </StackPanel>
                                        <Grid DockPanel.Dock="Left" Width="20" Height="20" Margin="0,0,10,0" IsHitTestVisible="False">
                                            <Image x:Name="CaptionIcon" Source="{Binding DockHostWindow.Icon, ElementName=Frame}" Stretch="Uniform" />
                                            <TextBlock x:Name="FileGlyph" Visibility="Collapsed" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       Text="&#xE8A5;" FontSize="16" TextAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                        <DockPanel x:Name="TitleLine" ClipToBounds="True" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="HostName" DockPanel.Dock="Left" MaxWidth="150" TextTrimming="CharacterEllipsis">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource FloatingDocumentHostPrefix}">
                                                        <Binding Path="DockHostWindow.Title" ElementName="Frame" />
                                                        <Binding Path="ActualWidth" ElementName="TitleLine" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                            <TextBlock x:Name="Separator" DockPanel.Dock="Left" Text="–" Margin="5,0" />
                                            <ContentPresenter x:Name="HeaderContent" Content="{Binding Path=(dockingTheme:FloatingDocumentCaption.Document), RelativeSource={RelativeSource TemplatedParent}}"
                                                ContentTemplate="{Binding Model.Root.Manager.DocumentTitleTemplate, RelativeSource={RelativeSource TemplatedParent}}"
                                                ContentTemplateSelector="{Binding Model.Root.Manager.DocumentTitleTemplateSelector, RelativeSource={RelativeSource TemplatedParent}}" />
                                        </DockPanel>
                                    </DockPanel>
                                </Border>
                                <ContentPresenter x:Name="FloatingContent" Grid.Row="1" Margin="6,0,6,6" Content="{TemplateBinding Content}" />
                            </Grid>
                        </Border>
                    </dockingTheme:FloatingWindowFrame>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding DockHostWindow.Icon, ElementName=Frame}" Value="{x:Null}">
                            <Setter TargetName="CaptionIcon" Property="Source" Value="{Binding Path=(dockingTheme:FloatingDocumentCaption.Document).IconSource, RelativeSource={RelativeSource TemplatedParent}}" />
                        </DataTrigger>
                        <Trigger SourceName="CaptionIcon" Property="Source" Value="{x:Null}">
                            <Setter TargetName="FileGlyph" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger SourceName="HostName" Property="Text" Value="">
                            <Setter TargetName="Separator" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsActive" Value="True">
                            <Setter TargetName="WindowBorder" Property="BorderBrush" Value="{DynamicResource DockingAccentBrush}" />
                            <Setter TargetName="Header" Property="TextElement.Foreground" Value="{DynamicResource DockingTextBrush}" />
                            <Setter TargetName="PART_PinMaximize" Property="Foreground" Value="{DynamicResource DockingTextBrush}" />
                            <Setter TargetName="PART_PinRestore" Property="Foreground" Value="{DynamicResource DockingTextBrush}" />
                            <Setter TargetName="PART_PinClose" Property="Foreground" Value="{DynamicResource DockingTextBrush}" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter TargetName="WindowBorder" Property="CornerRadius" Value="0" />
                            <Setter TargetName="WindowBorder" Property="BorderThickness" Value="0" />
                            <Setter TargetName="FloatingContent" Property="Margin" Value="0" />
                            <Setter TargetName="PART_PinMaximize" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_PinRestore" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
