<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:reskeys="clr-namespace:AvalonDock.Themes.VS2013.Themes;assembly=AvalonDock.Themes.VS2013">
    <!-- Chrome-only palette; editor, workflow and tool content keep their own themes. -->
    <SolidColorBrush x:Key="DockingChromeBackground" Color="{DynamicResource CV.Color.Docking.Chrome}" />
    <SolidColorBrush x:Key="DockingSurfaceBackground" Color="{DynamicResource CV.Color.Docking.Surface}" />
    <SolidColorBrush x:Key="DockingBorderBrush" Color="{DynamicResource CV.Color.Docking.Border}" />
    <SolidColorBrush x:Key="DockingAccentBrush" Color="{DynamicResource CV.Color.Docking.Accent}" />
    <SolidColorBrush x:Key="DockingTextBrush" Color="{DynamicResource CV.Color.Docking.Text}" />
    <SolidColorBrush x:Key="DockingMutedTextBrush" Color="{DynamicResource CV.Color.Docking.MutedText}" />
    <SolidColorBrush x:Key="DockingHoverBrush" Color="{DynamicResource CV.Color.Docking.Hover}" />
    <SolidColorBrush x:Key="DockingPressedBrush" Color="{DynamicResource CV.Color.Docking.Pressed}" />

    <!-- Current Visual Studio-style docking feedback: a quiet opaque navigator
         over busy content, with blue used for direction and the active preview. -->
    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.DockingButtonBackgroundBrushKey}" Color="#E1EFF8" />
    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.DockingButtonForegroundBrushKey}" Color="#1689C9" />
    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.DockingButtonForegroundArrowBrushKey}" Color="#40464D" />
    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.DockingButtonStarBorderBrushKey}" Color="#AEB4BA" />
    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.DockingButtonStarBackgroundBrushKey}" Color="#F2F3F5" />
    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.PreviewBoxBorderBrushKey}" Color="#0078D4" />
    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.PreviewBoxBackgroundBrushKey}" Color="#0078D4" Opacity="0.28" />

    <!-- Retained upstream surfaces (resizers, auto-hide tabs, floating documents). -->
    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.Background}" Color="{DynamicResource CV.Color.Docking.Chrome}" />
    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.PanelBorderBrush}" Color="{DynamicResource CV.Color.Docking.Border}" />
    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.TabBackground}" Color="{DynamicResource CV.Color.Docking.Surface}" />
    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.AutoHideTabDefaultBackground}" Color="{DynamicResource CV.Color.Docking.Chrome}" />
    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.AutoHideTabDefaultBorder}" Color="{DynamicResource CV.Color.Docking.Chrome}" />
    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.AutoHideTabDefaultText}" Color="{DynamicResource CV.Color.Docking.MutedText}" />
    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.AutoHideTabHoveredBackground}" Color="{DynamicResource CV.Color.Docking.Hover}" />
    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.AutoHideTabHoveredBorder}" Color="{DynamicResource CV.Color.Docking.Accent}" />
    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.AutoHideTabHoveredText}" Color="{DynamicResource CV.Color.Docking.Text}" />
    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.FloatingDocumentWindowBackground}" Color="{DynamicResource CV.Color.Docking.Chrome}" />
    <SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.FloatingDocumentWindowBorder}" Color="{DynamicResource CV.Color.Docking.Border}" />
</ResourceDictionary>
