<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
                    xmlns:ad="clr-namespace:AvalonDock;assembly=AvalonDock"
                    xmlns:chrome="clr-namespace:ColorVision.Themes"
                    xmlns:dockingTheme="clr-namespace:ColorVision.Solution.Themes"
                    xmlns:controls="clr-namespace:AvalonDock.Controls;assembly=AvalonDock"
                    xmlns:converters="clr-namespace:AvalonDock.Converters;assembly=AvalonDock"
                    xmlns:properties="clr-namespace:AvalonDock.Properties;assembly=AvalonDock"
                    xmlns:wpfShell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
                    xmlns:workspace="clr-namespace:ColorVision.Solution.Workspace">
    <ResourceDictionary.MergedDictionaries>
        <!-- Supplies command menus, icons and the base manager style, not a second engine. -->
        <ResourceDictionary Source="/ColorVision.Solution;component/Themes/AvalonDockGripTemplates.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <workspace:DocumentTabPinStateConverter x:Key="DocumentTabPinStateConverter" />

    <Style TargetType="{x:Type controls:DetachedAnchorableWindow}">
        <Setter Property="Background" Value="{DynamicResource GlobalBackground}" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <!-- AvalonDock explicitly sets WindowStyle to SingleBorderWindow. WindowChrome
             replaces its visible nonclient frame while retaining system window behavior. -->
        <Setter Property="wpfShell:WindowChrome.WindowChrome">
            <Setter.Value>
                <wpfShell:WindowChrome CaptionHeight="20" CornerRadius="8" GlassFrameThickness="1"
                    ResizeBorderThickness="5" UseAeroCaptionButtons="False" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:DetachedAnchorableWindow}">
                    <dockingTheme:FloatingWindowFrame>
                        <chrome:DockingSurfaceBorder x:Name="WindowFrame" Background="{TemplateBinding Background}" BorderThickness="1"
                            BorderBrush="{DynamicResource DockingBorderBrush}" CornerRadius="8">
                            <AdornerDecorator>
                                <ContentPresenter ContentSource="Content" />
                            </AdornerDecorator>
                        </chrome:DockingSurfaceBorder>
                    </dockingTheme:FloatingWindowFrame>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsActive" Value="True">
                            <Setter TargetName="WindowFrame" Property="BorderBrush" Value="{DynamicResource DockingAccentBrush}" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter TargetName="WindowFrame" Property="BorderThickness" Value="0" />
                            <Setter TargetName="WindowFrame" Property="CornerRadius" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DockingCaptionButtonStyle" TargetType="{x:Type primitives:ButtonBase}">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource DockingMutedTextBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type primitives:ButtonBase}">
                    <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource DockingHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource DockingTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource DockingPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Native Windows line icons; the MDL2 family supplies the same glyphs on older Windows. -->
    <Style x:Key="DockingCaptionGlyphStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontStyle" Value="Normal" />
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type primitives:ButtonBase}}}" />
    </Style>
    <Style x:Key="DockingDropDownButtonStyle" TargetType="{x:Type controls:DropDownButton}" BasedOn="{StaticResource DockingCaptionButtonStyle}">
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource DockingPressedBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource DockingTextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="DockingTitleTemplate">
        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
    </DataTemplate>

    <DataTemplate x:Key="DetachedToolWindowButtons">
        <StackPanel Orientation="Horizontal">
            <Button x:Name="DetachedMaximizeButton"
                wpfShell:WindowChrome.IsHitTestVisibleInChrome="True"
                Command="{x:Static dockingTheme:DetachedToolWindowCommands.ToggleMaximize}" CommandParameter="{Binding}"
                Style="{StaticResource DockingCaptionButtonStyle}" ToolTip="{x:Static properties:Resources.Window_Maximize}">
                <TextBlock x:Name="DetachedMaximizeGlyph" Style="{StaticResource DockingCaptionGlyphStyle}" Text="&#xE922;" />
            </Button>
            <Button x:Name="DetachedCloseButton"
                wpfShell:WindowChrome.IsHitTestVisibleInChrome="True"
                Command="{x:Static dockingTheme:DetachedToolWindowCommands.Close}" CommandParameter="{Binding}"
                Style="{StaticResource DockingCaptionButtonStyle}" ToolTip="{x:Static properties:Resources.Document_Close}">
                <TextBlock Style="{StaticResource DockingCaptionGlyphStyle}" Text="&#xE711;" />
            </Button>
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding WindowState}" Value="Maximized">
                <Setter TargetName="DetachedMaximizeGlyph" Property="Text" Value="&#xE923;" />
                <Setter TargetName="DetachedMaximizeButton" Property="ToolTip" Value="{x:Static properties:Resources.Window_Restore}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Model.CanClose}" Value="True">
                <Setter TargetName="DetachedCloseButton" Property="Command"
                    Value="{Binding LayoutItem.CloseCommand, RelativeSource={RelativeSource AncestorType={x:Type controls:AnchorablePaneTitle}}}" />
                <Setter TargetName="DetachedCloseButton" Property="CommandParameter" Value="{x:Null}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <Style TargetType="{x:Type controls:AnchorablePaneTitle}">
        <Setter Property="Background" Value="{DynamicResource GlobalBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource DockingMutedTextBrush}" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:AnchorablePaneTitle}">
                    <!-- The entire painted title is inside the native right-click area,
                         including its padding. AnchorablePaneTitle still owns dragging. -->
                    <controls:DropDownControlArea HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                        DropDownContextMenu="{Binding Model.Root.Manager.AnchorableContextMenu, RelativeSource={RelativeSource TemplatedParent}}"
                        DropDownContextMenuDataContext="{Binding LayoutItem, RelativeSource={RelativeSource TemplatedParent}}"
                        Style="{DynamicResource DropDownControlArea}">
                        <Border x:Name="CaptionBorder" Background="{TemplateBinding Background}" CornerRadius="3,3,0,0">
                            <Grid Margin="7,0,2,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="Header" Margin="0,0,4,0" VerticalAlignment="Center"
                                    Content="{Binding Model, RelativeSource={RelativeSource TemplatedParent}}"
                                    ContentTemplate="{Binding Model.Root.Manager.AnchorableTitleTemplate, RelativeSource={RelativeSource TemplatedParent}}"
                                    ContentTemplateSelector="{Binding Model.Root.Manager.AnchorableTitleTemplateSelector, RelativeSource={RelativeSource TemplatedParent}}"
                                    TextElement.Foreground="{TemplateBinding Foreground}" />
                                <ItemsControl x:Name="PanelTitleActions" Grid.Column="1" Style="{StaticResource DockingTitleActionItemsStyle}"
                                    ItemsSource="{Binding Model.Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource DockPanelTitleActionsConverter}}" />
                                <controls:DropDownButton x:Name="MenuDropDownButton" Grid.Column="2" Style="{StaticResource DockingDropDownButtonStyle}"
                                    wpfShell:WindowChrome.IsHitTestVisibleInChrome="True"
                                    DropDownContextMenu="{Binding Model.Root.Manager.AnchorableContextMenu, RelativeSource={RelativeSource TemplatedParent}}"
                                    DropDownContextMenuDataContext="{Binding LayoutItem, RelativeSource={RelativeSource TemplatedParent}}"
                                    ToolTip="{x:Static properties:Resources.Anchorable_CxMenu_Hint}">
                                    <TextBlock Style="{StaticResource DockingCaptionGlyphStyle}" Text="&#xE70D;" />
                                </controls:DropDownButton>
                                <Button x:Name="PART_AutoHidePin" Grid.Column="3" Style="{StaticResource DockingCaptionButtonStyle}"
                                    Command="{Binding LayoutItem.AutoHideCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                    ToolTip="{x:Static properties:Resources.Anchorable_BtnAutoHide_Hint}"
                                    Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={converters:BoolToVisibilityConverter}}">
                                    <TextBlock x:Name="AutoHideGlyph" Style="{StaticResource DockingCaptionGlyphStyle}" Text="&#xE718;" />
                                </Button>
                                <Button x:Name="PART_HidePin" Grid.Column="4" Style="{StaticResource DockingCaptionButtonStyle}"
                                    Command="{Binding LayoutItem.HideCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                    ToolTip="{x:Static properties:Resources.Anchorable_BtnClose_Hint}"
                                    Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={converters:BoolToVisibilityConverter}}">
                                    <TextBlock Style="{StaticResource DockingCaptionGlyphStyle}" Text="&#xE711;" />
                                </Button>
                                <ContentPresenter x:Name="DetachedWindowActions" Grid.Column="3" Grid.ColumnSpan="2" />
                            </Grid>
                        </Border>
                    </controls:DropDownControlArea>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Model.IsActive, RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource DockingTextBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Model.IsAutoHidden, RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter TargetName="AutoHideGlyph" Property="Text" Value="&#xE77A;" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Model.CanClose, RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter TargetName="PART_HidePin" Property="Command" Value="{Binding LayoutItem.CloseCommand, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="PART_HidePin" Property="ToolTip" Value="{x:Static properties:Resources.Document_Close}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Model.IsDetached, RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter Property="Height" Value="24" />
                            <Setter TargetName="CaptionBorder" Property="dockingTheme:FloatingWindowFrame.IsCaption" Value="True" />
                            <Setter TargetName="CaptionBorder" Property="CornerRadius" Value="0" />
                            <Setter TargetName="CaptionBorder" Property="Background" Value="{DynamicResource CV.Surface.Alternate}" />
                            <Setter TargetName="PART_AutoHidePin" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_HidePin" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="DetachedWindowActions" Property="ContentTemplate" Value="{StaticResource DetachedToolWindowButtons}" />
                            <Setter TargetName="DetachedWindowActions" Property="Content"
                                Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type controls:DetachedAnchorableWindow}}}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DockingTabKeyboardFocus" TargetType="{x:Type Control}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Control}">
                    <Border Margin="3,2" BorderThickness="1" CornerRadius="3" IsHitTestVisible="False"
                            BorderBrush="{DynamicResource CV.Text.Primary}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="DockingDocumentHeaderTemplate">
        <dockingTheme:DocumentTabCaption Title="{Binding Title}" />
    </DataTemplate>

    <Style x:Key="DockingDocumentTabStyle" TargetType="{x:Type TabItem}">
        <Setter Property="FocusVisualStyle" Value="{StaticResource DockingTabKeyboardFocus}" />
        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
        <Setter Property="ToolTip" Value="{Binding ToolTip}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource DockingMutedTextBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="MaxWidth" Value="216" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Grid>
                        <chrome:DockingTabBorder x:Name="DocumentTabBorder" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1,1,1,0"
                            CornerRadius="3" Placement="Top" IsSelected="{TemplateBinding IsSelected}" SnapsToDevicePixels="True"
                            IsHitTestVisible="False" />
                        <!-- Keep the real LayoutDocumentTabItem over the full painted tab,
                             so padding routes to its native menu and drag handlers too. -->
                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding ToolTip}" Value="{x:Null}">
                            <Setter Property="ToolTip" Value="{Binding Title}" />
                        </DataTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsSelected" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="{DynamicResource DockingHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource DockingTextBrush}" />
                            <Setter TargetName="DocumentTabBorder" Property="Margin" Value="1,2" />
                            <Setter TargetName="DocumentTabBorder" Property="Opacity" Value="0.7" />
                        </MultiTrigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource DockingTextBrush}" />
                            <Setter Property="Background" Value="{DynamicResource DockingSurfaceBackground}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource DockingBorderBrush}" />
                            <Setter Property="Panel.ZIndex" Value="1" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource DockingTextBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource DockingAccentBrush}" />
                        </DataTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:LayoutDocumentTabItem}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:LayoutDocumentTabItem}">
                    <controls:DropDownControlArea HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                        DropDownContextMenu="{Binding Model.Root.Manager.DocumentContextMenu, RelativeSource={RelativeSource TemplatedParent}}"
                        DropDownContextMenuDataContext="{Binding LayoutItem, RelativeSource={RelativeSource TemplatedParent}}"
                        Style="{DynamicResource DropDownControlArea}">
                        <Border Background="Transparent" BorderBrush="Transparent" BorderThickness="1,1,1,0" Padding="8,0,3,0">
                            <Grid MinHeight="25">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- Emphasize only the caption, not the native menu owner. -->
                                <ContentPresenter x:Name="DocumentHeader" Margin="0,0,5,0" VerticalAlignment="Center" TextElement.FontWeight="Normal"
                                    Content="{Binding Model, RelativeSource={RelativeSource TemplatedParent}}"
                                    ContentTemplate="{Binding Model.Root.Manager.DocumentHeaderTemplate, RelativeSource={RelativeSource TemplatedParent}}"
                                    ContentTemplateSelector="{Binding Model.Root.Manager.DocumentHeaderTemplateSelector, RelativeSource={RelativeSource TemplatedParent}}"
                                    TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}" />
                                <Button x:Name="PART_PinButton" Grid.Column="1" Width="22" Height="22" Visibility="Hidden"
                                    Style="{StaticResource DockingCaptionButtonStyle}"
                                    Tag="{Binding Converter={StaticResource DocumentTabPinStateConverter}}"
                                    Command="{x:Static workspace:DocumentTabPinManager.ToggleCommand}"
                                    CommandParameter="{Binding}"
                                    ToolTip="{Binding Tag.ToggleText, RelativeSource={RelativeSource Self}}"
                                    AutomationProperties.Name="{Binding Tag.ToggleText, RelativeSource={RelativeSource Self}}">
                                    <TextBlock x:Name="PinGlyph" Style="{StaticResource DockingCaptionGlyphStyle}" Text="&#xE718;" />
                                </Button>
                                <!-- Hidden, not collapsed, for ordinary unselected tabs: hover never changes their width. -->
                                <Button x:Name="PART_CloseButton" Grid.Column="2" Width="22" Height="22" Visibility="Hidden"
                                    Style="{StaticResource DockingCaptionButtonStyle}"
                                    Command="{Binding LayoutItem.CloseCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                    ToolTip="{x:Static properties:Resources.Document_Close}">
                                    <TextBlock Style="{StaticResource DockingCaptionGlyphStyle}" Text="&#xE711;" />
                                </Button>
                            </Grid>
                        </Border>
                    </controls:DropDownControlArea>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="PART_PinButton" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter TargetName="PART_PinButton" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Visible" />
                            <Setter TargetName="DocumentHeader" Property="TextElement.FontWeight" Value="SemiBold" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsLastFocusedDocument}" Value="True">
                            <Setter TargetName="PART_PinButton" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_PinButton" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <DataTrigger Binding="{Binding CanClose}" Value="False">
                            <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <!-- A tool hosted in the document well can be hideable without being closeable. -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding CanClose}" Value="False" />
                                <Condition Binding="{Binding CanHide, FallbackValue=False}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="PART_CloseButton" Property="Command" Value="{Binding LayoutItem.HideCommand, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="PART_CloseButton" Property="ToolTip" Value="{x:Static properties:Resources.Anchorable_Hide}" />
                            <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                        <DataTrigger Binding="{Binding Tag.IsPinned, ElementName=PART_PinButton}" Value="True">
                            <Setter TargetName="PART_PinButton" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PinGlyph" Property="Text" Value="&#xE841;" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Tag, ElementName=PART_PinButton}" Value="{x:Null}">
                            <Setter TargetName="PART_PinButton" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DockingDocumentPaneStyle" TargetType="{x:Type controls:LayoutDocumentPaneControl}"
           BasedOn="{StaticResource AvalonDockThemeVs2013DocumentPaneControlStyle}">
        <Setter Property="Background" Value="{DynamicResource DockingSurfaceBackground}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource DockingDocumentTabStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:LayoutDocumentPaneControl}">
                    <Grid Background="Transparent" ClipToBounds="True" SnapsToDevicePixels="True" KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid x:Name="TabStripSurface" Panel.ZIndex="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- The pane owns the joining line and its rounded ends. Keep
                                 the strip background above that shared pixel row. -->
                            <Border Grid.ColumnSpan="2" Margin="0,0,0,1" Background="{DynamicResource DockingChromeBackground}" />
                            <!-- Keep the blank-strip menu behind the transparent tab panel. A document tab then routes
                                 directly to its own DropDownControlArea instead of being intercepted by a parent area. -->
                            <controls:DropDownControlArea x:Name="TabStrip" Grid.Column="0"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                DropDownContextMenu="{Binding Model.Root.Manager.DocumentContextMenu, RelativeSource={RelativeSource TemplatedParent}}"
                                DropDownContextMenuDataContext="{Binding Model.SelectedContent, RelativeSource={RelativeSource TemplatedParent}, Converter={converters:LayoutItemFromLayoutModelConverter}}"
                                Style="{DynamicResource DropDownControlArea}">
                                <Border Background="Transparent" />
                            </controls:DropDownControlArea>
                            <chrome:StableDocumentPaneTabPanel x:Name="HeaderPanel" Grid.Column="0" Panel.ZIndex="1"
                                IsItemsHost="True" KeyboardNavigation.TabIndex="1" />
                            <controls:DropDownButton x:Name="MenuDropDownButton" Grid.Column="1" Margin="3,0,2,0"
                                ToolTip="{x:Static properties:Resources.Active_Files}" AutomationProperties.Name="{x:Static properties:Resources.Active_Files}"
                                Style="{StaticResource DockingDropDownButtonStyle}">
                                <controls:DropDownButton.DropDownContextMenu>
                                    <controls:ContextMenuEx ItemsSource="{Binding Model.ChildrenSorted, RelativeSource={RelativeSource TemplatedParent}}">
                                        <controls:ContextMenuEx.ItemContainerStyle>
                                            <Style TargetType="{x:Type controls:MenuItemEx}" BasedOn="{StaticResource {x:Type controls:MenuItemEx}}">
                                                <Setter Property="IsChecked" Value="{Binding IsSelected, Mode=OneWay}" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </controls:ContextMenuEx.ItemContainerStyle>
                                    </controls:ContextMenuEx>
                                </controls:DropDownButton.DropDownContextMenu>
                                <Grid>
                                    <TextBlock Style="{StaticResource DockingCaptionGlyphStyle}" Text="&#xE70D;" />
                                    <Border x:Name="OverflowLine" Width="8" Height="1" VerticalAlignment="Top" Margin="0,1,0,0"
                                        Background="{DynamicResource DockingAccentBrush}" Visibility="Hidden" IsHitTestVisible="False" />
                                </Grid>
                            </controls:DropDownButton>
                        </Grid>
                        <chrome:DockingSurfaceBorder x:Name="DocumentPaneBorder" Grid.Row="1" Margin="0,-1,0,0" Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource DockingBorderBrush}" BorderThickness="1" CornerRadius="4"
                            KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabIndex="2" KeyboardNavigation.TabNavigation="Cycle">
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                        </chrome:DockingSurfaceBorder>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding HasOverflow, ElementName=HeaderPanel}" Value="True">
                            <Setter TargetName="OverflowLine" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SelectedItem.IsActive, RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter TargetName="DocumentPaneBorder" Property="BorderBrush" Value="{DynamicResource DockingAccentBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsSelectedTabAtStart, ElementName=HeaderPanel}" Value="True">
                            <Setter TargetName="DocumentPaneBorder" Property="CornerRadius" Value="0,4,4,4" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Model.ShowHeader, RelativeSource={RelativeSource Self}}" Value="False">
                            <!-- At startup the items host must materialize the selected
                                 editor even when this pane has no visible tab strip. -->
                            <Setter TargetName="TabStripSurface" Property="Height" Value="0" />
                            <Setter TargetName="TabStripSurface" Property="ClipToBounds" Value="True" />
                            <Setter TargetName="TabStripSurface" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="DocumentPaneBorder" Property="Margin" Value="0" />
                            <Setter TargetName="DocumentPaneBorder" Property="BorderThickness" Value="1" />
                            <Setter TargetName="DocumentPaneBorder" Property="CornerRadius" Value="4" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Model.ChildrenCount, RelativeSource={RelativeSource Self}}" Value="0">
                            <Setter TargetName="TabStripSurface" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="DocumentPaneBorder" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DockingToolTabStyle" TargetType="{x:Type TabItem}">
        <Setter Property="FocusVisualStyle" Value="{StaticResource DockingTabKeyboardFocus}" />
        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="Foreground" Value="{DynamicResource DockingMutedTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="ToolTip" Value="{Binding ToolTip}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Grid>
                        <chrome:DockingTabBorder x:Name="ToolTabBorder" Background="{TemplateBinding Background}"
                            BorderThickness="1,0,1,1" BorderBrush="{TemplateBinding BorderBrush}" CornerRadius="4"
                            Placement="Bottom" IsSelected="{TemplateBinding IsSelected}" IsHitTestVisible="False" />
                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsSelected" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="{DynamicResource DockingHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource DockingTextBrush}" />
                            <Setter TargetName="ToolTabBorder" Property="Margin" Value="1,2" />
                        </MultiTrigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource DockingTextBrush}" />
                            <Setter Property="Background" Value="{DynamicResource GlobalBackground}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource DockingBorderBrush}" />
                            <Setter Property="Panel.ZIndex" Value="1" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource DockingAccentBrush}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Parent.IsDirectlyHostedInFloatingWindow}" Value="True">
                <Setter Property="MinHeight" Value="24" />
                <Setter Property="Padding" Value="6,2" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Items.Count, RelativeSource={RelativeSource AncestorType={x:Type TabControl}}}" Value="1">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type controls:LayoutAnchorableTabItem}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:LayoutAnchorableTabItem}">
                    <controls:DropDownControlArea HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                        DropDownContextMenu="{Binding Model.Root.Manager.AnchorableContextMenu, RelativeSource={RelativeSource TemplatedParent}}"
                        DropDownContextMenuDataContext="{Binding LayoutItem, RelativeSource={RelativeSource TemplatedParent}}"
                        Style="{DynamicResource DropDownControlArea}">
                        <Border Background="Transparent" BorderBrush="Transparent" BorderThickness="1,0,1,1"
                            Padding="{Binding Padding, RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}">
                            <ContentPresenter VerticalAlignment="Center"
                                Content="{Binding Model, RelativeSource={RelativeSource TemplatedParent}}"
                                ContentTemplate="{Binding Model.Root.Manager.AnchorableHeaderTemplate, RelativeSource={RelativeSource TemplatedParent}}"
                                ContentTemplateSelector="{Binding Model.Root.Manager.AnchorableHeaderTemplateSelector, RelativeSource={RelativeSource TemplatedParent}}"
                                TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}" />
                        </Border>
                    </controls:DropDownControlArea>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DockingToolPaneStyle" TargetType="{x:Type controls:LayoutAnchorablePaneControl}"
           BasedOn="{StaticResource AvalonDockThemeVs2013AnchorablePaneControlStyle}">
        <Setter Property="Background" Value="{DynamicResource GlobalBackground}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource DockingToolTabStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:LayoutAnchorablePaneControl}">
                    <Grid Background="{DynamicResource GlobalBackground}" ClipToBounds="True" SnapsToDevicePixels="True" KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <chrome:DockingSurfaceBorder x:Name="ToolPaneBorder" Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource DockingBorderBrush}" BorderThickness="1,1,1,0" CornerRadius="4,4,0,0">
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"
                                KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabIndex="2" KeyboardNavigation.TabNavigation="Cycle" />
                        </chrome:DockingSurfaceBorder>
                        <Grid x:Name="ToolTabStrip" Grid.Row="1" Background="{DynamicResource DockingChromeBackground}">
                            <Border x:Name="ToolTabStripLine" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DockingBorderBrush}" />
                            <controls:AnchorablePaneTabPanel x:Name="HeaderPanel" IsItemsHost="True" KeyboardNavigation.TabIndex="1" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding SelectedItem.IsActive, RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter TargetName="ToolPaneBorder" Property="BorderBrush" Value="{DynamicResource DockingAccentBrush}" />
                            <Setter TargetName="ToolTabStripLine" Property="BorderBrush" Value="{DynamicResource DockingAccentBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Items.Count, RelativeSource={RelativeSource Self}}" Value="1">
                            <!-- Keep the items host in layout so its selection binding can
                                 create the content/title even when the only tab is hidden. -->
                            <Setter TargetName="ToolTabStrip" Property="Height" Value="0" />
                            <Setter TargetName="ToolPaneBorder" Property="CornerRadius" Value="4" />
                            <Setter TargetName="ToolPaneBorder" Property="BorderThickness" Value="1" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Model.IsDirectlyHostedInFloatingWindow, RelativeSource={RelativeSource Self}}" Value="True">
                            <!-- The floating window owns the only visible frame. Keep this
                                 last so it also wins for single-tool floating panes. -->
                            <Setter TargetName="ToolPaneBorder" Property="BorderThickness" Value="0" />
                            <Setter TargetName="ToolPaneBorder" Property="CornerRadius" Value="0" />
                            <Setter TargetName="HeaderPanel" Property="Margin" Value="8,0" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:LayoutAnchorableControl}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:LayoutAnchorableControl}">
                    <!-- The pane supplies the outline once, around title, content and bottom tabs. -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <controls:AnchorablePaneTitle x:Name="Header" Model="{Binding Model, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ContentPresenter Grid.Row="1" Content="{Binding LayoutItem.View, RelativeSource={RelativeSource TemplatedParent}}"
                            ContentTemplate="{Binding LayoutItem.View.ContentTemplate, RelativeSource={RelativeSource TemplatedParent}}"
                            ContentTemplateSelector="{Binding LayoutItem.View.ContentTemplateSelector, RelativeSource={RelativeSource TemplatedParent}}"
                            FlowDirection="{TemplateBinding FlowDirection}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Model.Parent.IsDirectlyHostedInFloatingWindow, RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter TargetName="Header" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Model, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                            <Setter TargetName="Header" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <dockingTheme:AutoHideTabOpenConverter x:Key="AutoHideTabOpenConverter" />
    <ControlTemplate x:Key="DockingAutoHideTabTemplate" TargetType="{x:Type controls:LayoutAnchorControl}">
        <!-- AvalonDock rotates the whole group on the left and right. Keep the
             indicator on the outside edge in the tab's local coordinates. -->
        <Grid Margin="0,0,4,0" MinHeight="24" Background="Transparent" TextOptions.TextFormattingMode="Display">
            <Border x:Name="TabSurface" CornerRadius="3" Background="{DynamicResource DockingChromeBackground}" />
            <ContentPresenter x:Name="Title" Margin="7,3" VerticalAlignment="Center"
                TextElement.Foreground="{DynamicResource DockingMutedTextBrush}"
                Content="{Binding Model, RelativeSource={RelativeSource TemplatedParent}}"
                ContentTemplate="{Binding AnchorableHeaderTemplate, RelativeSource={RelativeSource AncestorType={x:Type ad:DockingManager}}}"
                ContentTemplateSelector="{Binding AnchorableHeaderTemplateSelector, RelativeSource={RelativeSource AncestorType={x:Type ad:DockingManager}}}" />
            <Border x:Name="OpenIndicator" Height="2" Margin="4,0" VerticalAlignment="Bottom" CornerRadius="1"
                Background="{DynamicResource DockingAccentBrush}" Visibility="Hidden" IsHitTestVisible="False" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Side" Value="Top">
                <Setter TargetName="OpenIndicator" Property="VerticalAlignment" Value="Top" />
            </Trigger>
            <Trigger Property="Side" Value="Right">
                <Setter TargetName="OpenIndicator" Property="VerticalAlignment" Value="Top" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource DockingHoverBrush}" />
                <Setter TargetName="Title" Property="TextElement.Foreground" Value="{DynamicResource DockingTextBrush}" />
            </Trigger>
            <DataTrigger Value="True">
                <DataTrigger.Binding>
                    <MultiBinding Converter="{StaticResource AutoHideTabOpenConverter}">
                        <Binding Path="Model" RelativeSource="{RelativeSource Self}" />
                        <Binding Path="AutoHideWindow.IsVisible" RelativeSource="{RelativeSource AncestorType={x:Type ad:DockingManager}}" />
                    </MultiBinding>
                </DataTrigger.Binding>
                <Setter TargetName="OpenIndicator" Property="Visibility" Value="Visible" />
                <Setter TargetName="Title" Property="TextElement.Foreground" Value="{DynamicResource DockingTextBrush}" />
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- The upstream manager captured its pane styles with StaticResource. Replace the
         setters too; an implicit TabItem or pane style alone never reaches these panes. -->
    <Style TargetType="{x:Type ad:DockingManager}" BasedOn="{StaticResource ColorVisionBaseDockingManagerStyle}">
        <Setter Property="Background" Value="{DynamicResource GlobalBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource DockingTextBrush}" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="DocumentPaneControlStyle" Value="{StaticResource DockingDocumentPaneStyle}" />
        <Setter Property="DocumentHeaderTemplate" Value="{StaticResource DockingDocumentHeaderTemplate}" />
        <Setter Property="AnchorablePaneControlStyle" Value="{StaticResource DockingToolPaneStyle}" />
        <Setter Property="AnchorableTitleTemplate" Value="{StaticResource DockingTitleTemplate}" />
        <Setter Property="AnchorTemplate" Value="{StaticResource DockingAutoHideTabTemplate}" />
    </Style>
</ResourceDictionary>
