<UserControl x:Class="ColorVision.Solution.TreeViewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ColorVision.Solution"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:properties="clr-namespace:ColorVision.Solution.Properties"
             xmlns:explorer="clr-namespace:ColorVision.Solution.Explorer"
             d:DataContext="{d:DesignInstance local:SolutionManager}"
             mc:Ignorable="d" 
             d:DesignWidth="320" d:DesignHeight="600" FontSize="12" Foreground="{DynamicResource GlobalTextBrush}"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             Initialized="UserControl_Initialized" Background="{DynamicResource GlobalBackground}" Loaded="UserControl_Loaded" Unloaded="UserControl_Unloaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ColorVision.Solution;component/Explorer/TreeView.xaml"/>
                <ResourceDictionary Source="/ColorVision.Solution;component/Explorer/ExplorerChrome.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <WrapPanel Grid.Row="0" Margin="4,3,4,2">
            <RadioButton x:Name="SolutionViewButton" Content="解决方案" GroupName="ExplorerView" IsChecked="True"
                         Style="{StaticResource ExplorerViewButton}" Click="SolutionViewButton_Click" AutomationProperties.Name="解决方案视图"/>
            <RadioButton x:Name="FileSystemViewButton" Content="文件系统" GroupName="ExplorerView" Margin="2,0,3,0"
                         Style="{StaticResource ExplorerViewButton}" Click="FileSystemViewButton_Click" AutomationProperties.Name="文件系统视图"/>
            <Border Width="1" Height="16" Background="{DynamicResource GlobalTextBrush}" Opacity="0.14" Margin="2,5,4,5"/>
            <Button Style="{StaticResource ExplorerToolbarButton}" Command="{x:Static explorer:SolutionNavigationCommands.SyncWithActiveDocument}"
                    CommandTarget="{Binding ElementName=SolutionTreeView}" ToolTip="与活动文档同步" AutomationProperties.Name="与活动文档同步">
                <TextBlock Style="{StaticResource ExplorerToolbarIcon}" Text="&#xE8AB;"/>
            </Button>
            <Button Style="{StaticResource ExplorerToolbarButton}" Command="{x:Static explorer:SolutionNavigationCommands.CollapseAll}"
                    CommandTarget="{Binding ElementName=SolutionTreeView}" ToolTip="全部折叠" AutomationProperties.Name="全部折叠">
                <TextBlock Style="{StaticResource ExplorerToolbarIcon}" Text="&#xF165;"/>
            </Button>
            <Button Style="{StaticResource ExplorerToolbarButton}" Command="{x:Static explorer:SolutionNavigationCommands.Refresh}"
                    CommandTarget="{Binding ElementName=SolutionTreeView}" ToolTip="刷新" AutomationProperties.Name="刷新">
                <TextBlock Style="{StaticResource ExplorerToolbarIcon}" Text="&#xE72C;"/>
            </Button>
            <Button Style="{StaticResource ExplorerToolbarButton}" Command="ApplicationCommands.Properties"
                    CommandTarget="{Binding ElementName=SolutionTreeView}" ToolTip="属性" AutomationProperties.Name="属性">
                <Rectangle Width="16" Height="16" Fill="{DynamicResource DIProperty}"/>
            </Button>
            <Button x:Name="ExplorerMoreButton" Style="{StaticResource ExplorerToolbarButton}" Click="ExplorerMoreButton_Click"
                    ToolTip="更多选项" AutomationProperties.Name="更多选项">
                <TextBlock Style="{StaticResource ExplorerToolbarIcon}" Text="&#xE712;"/>
                <Button.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="解决方案设置" Command="{Binding SettingCommand}"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </WrapPanel>
        <hc:SearchBar x:Name="SearchBar1" Grid.Row="1" Margin="5,2,5,4" Height="27" Padding="5,2"
                      FontSize="12" hc:BorderElement.CornerRadius="2" TextChanged="SearchBar1_TextChanged"
                      hc:InfoElement.Placeholder="{x:Static properties:Resources.SearchProjectFiles}"
                      hc:InfoElement.ShowClearButton="True" Style="{StaticResource SearchBarPlus}" IsRealTime="True"
                      AutomationProperties.Name="搜索工程文件"/>
        <Border Grid.Row="2" Background="{DynamicResource SecondaryRegionBrush}" Margin="4,0,4,2" Padding="7,5" CornerRadius="2">
            <DockPanel>
                <Path Width="16" Height="16" Data="M1.5,4.5 L6,4.5 7.5,6 14.5,6 14.5,13.5 1.5,13.5 Z"
                      Stroke="{DynamicResource GlobalTextBrush}" StrokeThickness="1" StrokeLineJoin="Round" Margin="0,0,6,0" Opacity="0.7"/>
                <TextBlock x:Name="WorkspacePathText" Text="{Binding CurrentSolutionExplorer.DirectoryInfo.FullName, TargetNullValue=未打开工作区}"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" FontSize="11" Opacity="0.75"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            </DockPanel>
        </Border>
        <Border BorderThickness="0" Grid.Row="3" CornerRadius="0"  Padding="0" >
            <TreeView  x:Name="SolutionTreeView" explorer:ExplorerScrollBarBehavior.IsEnabled="True" Style="{StaticResource TreeView.Small}"  BorderThickness="0" Padding="0" Margin="3,0,3,0" Background="{DynamicResource GlobalBackground}" ScrollViewer.HorizontalScrollBarVisibility="Auto" ContextMenuOpening="SolutionTreeView_ContextMenuOpening" SelectedItemChanged="SolutionTreeView_SelectedItemChanged" PreviewKeyDown="SolutionTreeView_PreviewKeyDown">
                <TreeView.Resources>
                    <local:TreeViewItemMarginConverter x:Key="TreeViewItemMarginConverter" />
                    <Style x:Key="ExpandCollapseToggleStyle" TargetType="{x:Type ToggleButton}">
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Width" Value="18" />
                        <Setter Property="Height" Value="20" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <Border Background="Transparent">
                                        <Path x:Name="ExpandGlyph" Data="M2,0 L6,4 2,8" Width="8" Height="8"
                                              Stroke="{DynamicResource GlobalTextBrush}" StrokeThickness="1.1" Opacity="0.8"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="ToggleButton.IsChecked" Value="True">
                                            <Setter TargetName="ExpandGlyph" Property="Data" Value="M0,2 L4,6 8,2" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ExpandGlyph" Property="Opacity" Value="1" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TreeView.Resources>
                <TreeView.ItemContainerStyle>
                    
                    <Style TargetType="{x:Type TreeViewItem}"  BasedOn="{StaticResource TreeViewItemBaseStyle}">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="MinHeight" Value="24"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="ToolTip" Value="{Binding FullPath}"/>

                        <EventSetter Event="RequestBringIntoView" Handler="TreeViewItem_RequestBringIntoView"/>
                        <EventSetter Event="Expanded" Handler="TreeViewItem_ExpansionChanged"/>
                        <EventSetter Event="Collapsed" Handler="TreeViewItem_ExpansionChanged"/>
                        <Setter Property="local:DoubleClickCommandBehavior.DoubleClickCommand" Value="{x:Static explorer:SolutionResourceCommands.Open}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type TreeViewItem}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition MinHeight="{TemplateBinding MinHeight}" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border x:Name="SelectionBackground" Background="{DynamicResource GlobalTextBrush}" Opacity="0.085" CornerRadius="4" Visibility="Collapsed" IsHitTestVisible="False"
                                                HorizontalAlignment="Left" Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                                            <Border.RenderTransform>
                                                <TranslateTransform X="{Binding HorizontalOffset, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"/>
                                            </Border.RenderTransform>
                                        </Border>
                                        <Border Name="Bd" BorderBrush="Transparent" BorderThickness="1" Background="Transparent" SnapsToDevicePixels="true" CornerRadius="4">
                                            <DockPanel LastChildFill="True" Margin="{Binding Converter={StaticResource TreeViewItemMarginConverter}, RelativeSource={RelativeSource TemplatedParent}}">
                                                <ToggleButton Name="Expander" ClickMode="Press" Margin="4,0,2,0" Style="{StaticResource ExpandCollapseToggleStyle}" IsChecked="{Binding IsExpanded , RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                                                <ContentPresenter Name="PART_Header" VerticalAlignment="Center" ContentSource="Header" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                            </DockPanel>
                                        </Border>
                                        <Border x:Name="SelectionAccent" Background="{DynamicResource PrimaryBrush}" Width="2" CornerRadius="1" HorizontalAlignment="Left" Margin="2,4,0,4" Visibility="Collapsed" IsHitTestVisible="False">
                                            <Border.RenderTransform>
                                                <TranslateTransform X="{Binding HorizontalOffset, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"/>
                                            </Border.RenderTransform>
                                        </Border>
                                        <Border x:Name="KeyboardFocus" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1" Opacity="0.6" CornerRadius="4" Visibility="Collapsed" IsHitTestVisible="False"/>
                                        <ItemsPresenter Name="ItemsHost" Grid.Row="1"/>
                                       
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger SourceName="Bd" Property="UIElement.IsMouseOver" Value="true">
                                            <Setter TargetName="SelectionBackground" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="SelectionBackground" Property="Opacity" Value="0.045"/>
                                        </Trigger>
                                        <Trigger Property="TreeViewItem.IsExpanded" Value="false">
                                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                                        </Trigger>
                                        <Trigger Property="ItemsControl.HasItems" Value="false">
                                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsMultiSelected}" Value="True">
                                            <Setter TargetName="SelectionBackground" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="SelectionBackground" Property="Opacity" Value="0.085"/>
                                            <Setter TargetName="SelectionAccent" Property="Visibility" Value="Visible"/>
                                            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}"/>
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                <Condition Binding="{Binding IsMultiSelected}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="KeyboardFocus" Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                        <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SecondaryRegionBrush}" />
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                            <Setter TargetName="Bd" Property="BorderThickness" Value="1" />
                                        </DataTrigger>
                                        <Trigger Property="IsEnabled" Value="false">
                                            <Setter Property="UIElement.Opacity" Value=".4" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                </TreeView.ItemContainerStyle>
            </TreeView>
        </Border>
        <TextBlock x:Name="SearchStatusText"
                   Grid.Row="4"
                   Margin="8,2,5,4"
                   FontSize="11"
                   Opacity="0.7"
                   Visibility="Collapsed"
                   AutomationProperties.LiveSetting="Polite"/>
    </Grid>

</UserControl>
