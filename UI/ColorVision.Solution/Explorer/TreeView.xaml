<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:XSolution="clr-namespace:ColorVision.Solution" 
                    xmlns:Explorer="clr-namespace:ColorVision.Solution.Explorer"
                    xmlns:local="clr-namespace:ColorVision.Solution"
                    x:Class="ColorVision.Solution.Explorer.SolutionTreeViewBehavior">
    <Style x:Key="ExplorerFolderGlyph" TargetType="Path">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Stroke" Value="#C28A00"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="Data" Value="M1.5,4.5 L6,4.5 7.5,6 14.5,6 14.5,13.5 1.5,13.5 Z"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                <Setter Property="Data" Value="M1.5,13.5 L1.5,4.5 6,4.5 7.5,6 13.5,6 13.5,8 M1.5,13.5 L3.5,8 15,8 13,13.5 Z"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="ExplorerSolutionGlyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="Text" Value="&#xE8F1;"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}"/>
        <Setter Property="Opacity" Value="0.8"/>
    </Style>
    
    <Style x:Key="ButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="OverridesDefaultStyle"  Value="true" />
        <Setter Property="Height" Value="25"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="border" Background="{DynamicResource ButtonBackground}"  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" SnapsToDevicePixels="true">
                        <Grid>
                            <Border x:Name="Bds" Background="#6EA646" CornerRadius="3"  Opacity="1" Visibility="Collapsed"/>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" Opacity="0.9" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter TargetName="Bds" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Bds" Property="Background" Value="#6EA646"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="true">
                            <Setter Property="Foreground" Value="{DynamicResource ForegroundHightBrush}"/>
                            <Setter TargetName="Bds" Property="Background" Value="{DynamicResource ButtonBackground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style x:Key="style_treeViewItem_icon" TargetType="Image">
        <Setter Property="Width" Value="16"></Setter>
        <Setter Property="Height" Value="16"></Setter>
        <Setter Property="Margin" Value="5,0,5,0"></Setter>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="TreeViewItemPanel" TargetType="StackPanel">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <DataTemplate x:Key="displayTemplate">
        <TextBlock Text="{Binding Path=Name}" Padding="4,0,3,0" VerticalAlignment="Center" ></TextBlock>
    </DataTemplate>
    <DataTemplate x:Key="editTemplate">
        <TextBox Text="{Binding Path=Name, Mode=OneWay}"  Tag="{Binding .}"  LostFocus="TextBox_LostFocus" Padding="3,1" PreviewKeyDown="PreviewKeyDown" Loaded="TextBox_Loaded" />
    </DataTemplate>

    <Style x:Key="EditableTextBlockStyle"   TargetType="local:EditableTextBlock">
        <Style.Triggers>
            <Trigger Property="IsEditMode" Value="True">
                <Setter Property="ContentTemplate" Value="{StaticResource editTemplate}"/>
            </Trigger>
            <Trigger Property="IsEditMode" Value="False">
                <Setter Property="ContentTemplate" Value="{StaticResource displayTemplate}"/>
            </Trigger>
            <DataTrigger Binding="{Binding IsStartupProject}" Value="True">
                <Setter Property="FontWeight" Value="Bold"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <HierarchicalDataTemplate DataType="{x:Type Explorer:SolutionExplorer}"   ItemsSource="{Binding VisualChildren}">
        <StackPanel Style="{StaticResource TreeViewItemPanel}" >
            <TextBlock Style="{StaticResource ExplorerSolutionGlyph}"/>
            <local:EditableTextBlock   Style="{StaticResource EditableTextBlockStyle}" IsEditMode="{Binding IsEditMode}" Content="{Binding .}"/>

        </StackPanel>
    </HierarchicalDataTemplate>

    <DataTemplate DataType="{x:Type Explorer:LazyLoadingNode}">
        <TextBlock Text="{Binding Name}" Padding="4,0,3,0" Opacity="0.6"/>
    </DataTemplate>

    <HierarchicalDataTemplate DataType="{x:Type Explorer:SolutionSearchResultNode}">
        <StackPanel Orientation="Horizontal">
            <Image Source="{Binding Icon}" Height="15" Width="16" Margin="0,0,4,0"/>
            <StackPanel>
                <local:EditableTextBlock Style="{StaticResource EditableTextBlockStyle}"
                                         IsEditMode="{Binding IsEditMode}"
                                         Content="{Binding .}"/>
                <TextBlock Text="{Binding DisplayPath}"
                           FontSize="10"
                           Opacity="0.65"
                           Margin="6,-1,0,1"/>
            </StackPanel>
        </StackPanel>
    </HierarchicalDataTemplate>

    <HierarchicalDataTemplate DataType="{x:Type Explorer:SolutionFolderNode}" ItemsSource="{Binding VisualChildren}">
        <StackPanel Style="{StaticResource TreeViewItemPanel}">
            <Path Style="{StaticResource ExplorerFolderGlyph}"/>
            <local:EditableTextBlock Style="{StaticResource EditableTextBlockStyle}" IsEditMode="{Binding IsEditMode}" Content="{Binding .}"/>
        </StackPanel>
    </HierarchicalDataTemplate>

    <HierarchicalDataTemplate DataType="{x:Type Explorer:FileNode}"   ItemsSource="{Binding VisualChildren}">
        <StackPanel>
            <StackPanel.Style>
                <Style TargetType="StackPanel" BasedOn="{StaticResource TreeViewItemPanel}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsExcludedFromProject}" Value="True">
                            <Setter Property="Opacity" Value="0.5"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <Image Source="{Binding Icon}" Height="16" Width="16" VerticalAlignment="Center"/>
            <local:EditableTextBlock   Style="{StaticResource EditableTextBlockStyle}" IsEditMode="{Binding IsEditMode}" Content="{Binding .}"/>
        </StackPanel>
    </HierarchicalDataTemplate>
    <HierarchicalDataTemplate DataType="{x:Type Explorer:FolderNode}"   ItemsSource="{Binding VisualChildren}">
        <StackPanel>
            <StackPanel.Style>
                <Style TargetType="StackPanel" BasedOn="{StaticResource TreeViewItemPanel}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsExcludedFromProject}" Value="True">
                            <Setter Property="Opacity" Value="0.5"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <Path Style="{StaticResource ExplorerFolderGlyph}"/>
            <local:EditableTextBlock   Style="{StaticResource EditableTextBlockStyle}" IsEditMode="{Binding IsEditMode}" Content="{Binding .}"/>
        </StackPanel>
    </HierarchicalDataTemplate>

</ResourceDictionary>
