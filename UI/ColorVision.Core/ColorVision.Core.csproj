<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0-windows7.0;net10.0-windows7.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<UseWPF>true</UseWPF>
		<ImplicitUsings>disable</ImplicitUsings>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<PackageProjectUrl>https://github.com/xincheng213618/scgd_general_wpf</PackageProjectUrl>
		<IncludeSymbols>True</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<PropertyGroup>
		<!-- NATIVE_BUILD_POLICY: 日常托管项目/Visual Studio 构建复用已有 DLL，仅在 DLL 缺失时加入 C++ 项目引用；
		     build.sln 和发布流程仍负责显式构建原生项目。VC++ 输出在解决方案构建时位于仓库 x64\Release，
		     单独构建原生项目时可能位于 Native\opencv_helper\x64\Release。 -->
		<OpenCvHelperBinary Condition="'$(SolutionDir)' != '' and '$(SolutionDir)' != '*Undefined*'">$(SolutionDir)x64\Release\opencv_helper.dll</OpenCvHelperBinary>
		<OpenCvHelperBinary Condition="'$(OpenCvHelperBinary)' == '' and Exists('..\..\x64\Release\opencv_helper.dll')">..\..\x64\Release\opencv_helper.dll</OpenCvHelperBinary>
		<OpenCvHelperBinary Condition="'$(OpenCvHelperBinary)' == ''">..\..\Native\opencv_helper\x64\Release\opencv_helper.dll</OpenCvHelperBinary>
		<UseProjectReference Condition="'$(UseProjectReference)' == '' and !Exists('$(OpenCvHelperBinary)')">true</UseProjectReference>
	</PropertyGroup>

	<ItemGroup Condition="'$(UseProjectReference)'=='true'">
		<ProjectReference Include="..\..\Native\opencv_helper\opencv_helper.vcxproj"
			ReferenceOutputAssembly="false"
			AdditionalProperties="Configuration=Release;Platform=x64" />
	</ItemGroup>
	
	<ItemGroup>
		<Content Include="$(OpenCvHelperBinary)" Link="runtimes\win-x64\native\opencv_helper.dll">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Pack>true</Pack>
			<PackagePath>runtimes/win-x64/native</PackagePath>
		</Content>
		<Content Include="..\..\x64\Release\opencv_cuda.dll" Link="runtimes\win-x64\native\opencv_cuda.dll">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Pack>true</Pack>
			<PackagePath>runtimes/win-x64/native</PackagePath>
		</Content>
		<Content Include="..\..\packages\opencv\x64\vc18\bin\opencv_core4130.dll" Link="runtimes\win-x64\native\opencv_core4130.dll">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Pack>true</Pack>
			<PackagePath>runtimes/win-x64/native</PackagePath>
		</Content>
		<Content Include="..\..\packages\opencv\x64\vc18\bin\opencv_flann4130.dll" Link="runtimes\win-x64\native\opencv_flann4130.dll">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Pack>true</Pack>
			<PackagePath>runtimes/win-x64/native</PackagePath>
		</Content>
		<Content Include="..\..\packages\opencv\x64\vc18\bin\opencv_features2d4130.dll" Link="runtimes\win-x64\native\opencv_features2d4130.dll">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Pack>true</Pack>
			<PackagePath>runtimes/win-x64/native</PackagePath>
		</Content>
		<Content Include="..\..\packages\opencv\x64\vc18\bin\opencv_calib3d4130.dll" Link="runtimes\win-x64\native\opencv_calib3d4130.dll">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Pack>true</Pack>
			<PackagePath>runtimes/win-x64/native</PackagePath>
		</Content>
		<Content Include="..\..\packages\opencv\x64\vc18\bin\opencv_highgui4130.dll" Link="runtimes\win-x64\native\opencv_highgui4130.dll">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Pack>true</Pack>
			<PackagePath>runtimes/win-x64/native</PackagePath>
		</Content>
		<Content Include="..\..\packages\opencv\x64\vc18\bin\opencv_imgcodecs4130.dll" Link="runtimes\win-x64\native\opencv_imgcodecs4130.dll">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Pack>true</Pack>
			<PackagePath>runtimes/win-x64/native</PackagePath>
		</Content>
		<Content Include="..\..\packages\opencv\x64\vc18\bin\opencv_imgproc4130.dll" Link="runtimes\win-x64\native\opencv_imgproc4130.dll">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Pack>true</Pack>
			<PackagePath>runtimes/win-x64/native</PackagePath>
		</Content>
		<Content Include="..\..\packages\opencv\x64\vc18\bin\opencv_videoio4130.dll" Link="runtimes\win-x64\native\opencv_videoio4130.dll">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Pack>true</Pack>
			<PackagePath>runtimes/win-x64/native</PackagePath>
		</Content>
		<Content Include="..\..\packages\opencv\x64\vc18\bin\opencv_videoio_ffmpeg4130_64.dll" Link="runtimes\win-x64\native\opencv_videoio_ffmpeg4130_64.dll">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Pack>true</Pack>
			<PackagePath>runtimes/win-x64/native</PackagePath>
		</Content>
	</ItemGroup>
	<ItemGroup>
	  <None Include="README.md">
		  <Pack>true</Pack>
		  <PackagePath>\</PackagePath>
	  </None>
	</ItemGroup>

	<ItemGroup>
	  <Compile Update="Properties\Resources.Designer.cs">
	    <DependentUpon>Resources.resx</DependentUpon>
	    <DesignTime>True</DesignTime>
	    <AutoGen>True</AutoGen>
	  </Compile>
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Update="Properties\Resources.resx">
	    <SubType>Designer</SubType>
	    <LastGenOutput>Resources.Designer.cs</LastGenOutput>
	    <Generator>PublicResXFileCodeGenerator</Generator>
	  </EmbeddedResource>
	</ItemGroup>

</Project>
