<Window x:Class="ColorVision.ImageEditor.Settings.ImageViewSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ColorVision.ImageEditor.Settings"
        Title="{x:Static local:SettingsText.WindowTitle}" Width="1040" Height="720" MinWidth="820" MinHeight="540"
        Background="{DynamicResource GlobalBackground}" Foreground="{DynamicResource GlobalTextBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13" TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}" />
        </Style>
        <Style x:Key="NavigationItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Surface" CornerRadius="7" Padding="{TemplateBinding Padding}" Background="Transparent"><ContentPresenter /></Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ButtonBackground}" /></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ButtonBackground}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Background="{DynamicResource GlobalBackground}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="196" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Grid Margin="12,22,12,12">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <TextBlock Text="{x:Static local:SettingsText.WindowTitle}" FontSize="20" FontWeight="SemiBold" Margin="10,0,0,18" />
            <Grid Grid.Row="1" Margin="2,0,2,12">
                <TextBox x:Name="SearchBox" MinHeight="32" Padding="9,5" ToolTip="{x:Static local:SettingsText.Search}"
                         AutomationProperties.Name="{x:Static local:SettingsText.Search}" TextChanged="Search_Changed" />
                <TextBlock Text="{x:Static local:SettingsText.Search}" Foreground="{DynamicResource SecondaryTextBrush}"
                           IsHitTestVisible="False" Margin="10,0" VerticalAlignment="Center">
                    <TextBlock.Style><Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                    </Style></TextBlock.Style>
                </TextBlock>
            </Grid>
            <ListBox x:Name="SettingsList" Grid.Row="2" BorderThickness="0" Background="Transparent"
                     ItemContainerStyle="{StaticResource NavigationItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="SettingsList_SelectionChanged">
                <ListBox.GroupStyle>
                    <GroupStyle><GroupStyle.HeaderTemplate><DataTemplate>
                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="12,15,0,5" />
                    </DataTemplate></GroupStyle.HeaderTemplate></GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Header}" TextTrimming="CharacterEllipsis" /></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
        </Grid>
        <Border Grid.Column="1" Margin="0,12,12,12" CornerRadius="10" Background="{DynamicResource GlobalBorderBrush}"
                BorderBrush="{DynamicResource ButtonBorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="24,24,24,20" MaxWidth="900">
                        <TextBlock x:Name="PageTitle" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,20" />
                        <ContentControl x:Name="SettingsContent" HorizontalContentAlignment="Stretch" />
                    </StackPanel>
                </ScrollViewer>
                <Border Grid.Row="1" BorderBrush="{DynamicResource ButtonBorderBrush}" BorderThickness="0,1,0,0" Padding="18,12">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock x:Name="StatusText" Text="{x:Static local:SettingsText.Ready}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,9" />
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="SkipSaveButton" Content="{x:Static local:SettingsText.CloseWithoutSaving}" Visibility="Collapsed"
                                    Margin="0,0,8,0" Padding="10,5" Click="SkipSave_Click" Style="{DynamicResource ButtonDefault}" />
                            <Button x:Name="SaveButton" Content="{x:Static local:SettingsText.Save}" Margin="0,0,8,0" MinWidth="92"
                                    Click="Save_Click" Style="{DynamicResource ButtonDefault}" />
                            <Button Content="{x:Static local:SettingsText.Close}" MinWidth="76" Click="Close_Click" Style="{DynamicResource ButtonDefault}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
