<UserControl x:Class="ColorVision.ImageEditor.EditorTools.ThreeD.ModelViewer3DControl"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:hx="http://helix-toolkit.org/wpf/SharpDX"
             xmlns:properties="clr-namespace:ColorVision.ImageEditor.Properties"
             mc:Ignorable="d"
             Focusable="True"
             AllowDrop="True"
             PreviewKeyDown="Root_PreviewKeyDown"
             PreviewMouseDown="Root_PreviewMouseDown"
             DragEnter="Root_DragEnter"
             DragLeave="Root_DragLeave"
             Drop="Root_Drop"
             SizeChanged="Root_SizeChanged"
             d:DesignHeight="760"
             d:DesignWidth="1280">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ModelViewer3DStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="#FF15181C">
        <hx:Viewport3DX x:Name="Viewport"
                       BackgroundColor="#FF15181C"
                       ModelUpDirection="0,0,1"
                       CameraMode="Inspect"
                       ShowViewCube="True"
                       IsViewCubeEdgeClicksEnabled="True"
                       ShowCoordinateSystem="True"
                       CoordinateSystemLabelX="X"
                       CoordinateSystemLabelY="Y"
                       CoordinateSystemLabelZ="Z"
                       CoordinateSystemLabelForeground="#FFD1D5DB"
                       CoordinateSystemSize="0.72"
                       CoordinateSystemHorizontalPosition="0.88"
                       CoordinateSystemVerticalPosition="0.42"
                       IsCoordinateSystemMoverEnabled="False"
                       ViewCubeSize="0.82"
                       ViewCubeHorizontalPosition="0.88"
                       ViewCubeVerticalPosition="0.72"
                       IsViewCubeMoverEnabled="False"
                       EnableMouseButtonHitTest="True"
                       EnableSwapChainRendering="False"
                       IsPanEnabled="True"
                       IsRotationEnabled="True"
                       IsZoomEnabled="True"
                       ZoomAroundMouseDownPoint="True"
                       RotationSensitivity="1.0"
                       ZoomSensitivity="1.1"
                       FXAALevel="Low"
                       BelongsToParentWindow="False"
                       MouseDown3D="Viewport_MouseDown3D"
                       MouseDoubleClick="Viewport_MouseDoubleClick">
            <hx:Viewport3DX.Camera>
                <hx:PerspectiveCamera x:Name="PerspectiveCamera"
                                      Position="700,-900,650"
                                      LookDirection="-700,900,-650"
                                      UpDirection="0,0,1"
                                      NearPlaneDistance="0.01"
                                      FarPlaneDistance="100000"
                                      FieldOfView="60"/>
            </hx:Viewport3DX.Camera>
            <hx:AmbientLight3D Color="#FF50545A"/>
            <hx:DirectionalLight3D Direction="-1,1,-2" Color="#FFF3F4F6"/>
            <hx:DirectionalLight3D Direction="1,-1,-0.7" Color="#FF6C7A8C"/>
            <hx:AxisPlaneGridModel3D x:Name="GroundGrid"
                                     UpAxis="Z"
                                     GridPattern="Grid"
                                     AutoSpacing="True"
                                     AutoSpacingRate="5"
                                     GridThickness="0.04"
                                     GridColor="#42FFFFFF"
                                     PlaneColor="#0AFFFFFF"
                                     FadingFactor="0.15"
                                     IsHitTestVisible="False"/>
            <hx:Element3DPresenter x:Name="ScenePresenter"/>
            <hx:PostEffectMeshBorderHighlight EffectName="selection"/>
        </hx:Viewport3DX>

        <Border x:Name="ToolbarPanel"
                Style="{StaticResource ModelViewerOverlayPanel}"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="76,12,20,0"
                Padding="6"
                MaxWidth="980"
                Panel.ZIndex="40">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly">
                    <StackPanel Orientation="Horizontal">
                    <Button x:Name="OpenModelButton" Style="{StaticResource ModelViewerToolbarButton}" Click="OpenModel_Click" ToolTip="Ctrl+O">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ModelViewerGlyph}" Text="&#xE8E5;" Margin="0,0,7,0"/>
                            <TextBlock x:Name="OpenModelText" Text="{x:Static properties:Resources.ThreeD_OpenModel}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="FitViewButton" Style="{StaticResource ModelViewerToolbarButton}" Click="FitView_Click" ToolTip="Home">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ModelViewerGlyph}" Text="&#xE740;" Margin="0,0,7,0"/>
                            <TextBlock x:Name="FitViewText" Text="{x:Static properties:Resources.ThreeD_FitView}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="FocusSelectionButton" Style="{StaticResource ModelViewerToolbarButton}" Click="FocusSelection_Click" ToolTip="F">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ModelViewerGlyph}" Text="&#xF2A0;" Margin="0,0,7,0"/>
                            <TextBlock x:Name="FocusSelectionText" Text="{x:Static properties:Resources.ThreeD_FocusSelected}"/>
                        </StackPanel>
                    </Button>
                    <Border Width="1" Height="22" Background="{DynamicResource GlobalBorderBrush}" Margin="8,5"/>
                    <ComboBox x:Name="ViewPresetComboBox" Width="92" Height="30" Margin="2,0" VerticalContentAlignment="Center" SelectionChanged="ViewPresetComboBox_SelectionChanged">
                        <ComboBoxItem Tag="Iso" Content="{x:Static properties:Resources.ThreeD_IsoViewToolTip}" IsSelected="True"/>
                        <ComboBoxItem Tag="Front" Content="{x:Static properties:Resources.ThreeD_FrontViewToolTip}"/>
                        <ComboBoxItem Tag="Back" Content="{x:Static properties:Resources.ThreeD_BackViewToolTip}"/>
                        <ComboBoxItem Tag="Left" Content="{x:Static properties:Resources.ThreeD_LeftViewToolTip}"/>
                        <ComboBoxItem Tag="Right" Content="{x:Static properties:Resources.ThreeD_RightViewToolTip}"/>
                        <ComboBoxItem Tag="Top" Content="{x:Static properties:Resources.ThreeD_TopViewToolTip}"/>
                        <ComboBoxItem Tag="Bottom" Content="{x:Static properties:Resources.ThreeD_BottomViewToolTip}"/>
                    </ComboBox>
                    <ToggleButton x:Name="ProjectionToggle" Style="{StaticResource ModelViewerToolbarToggle}" Click="ProjectionToggle_Click" ToolTip="P / Num5">
                        <TextBlock x:Name="ProjectionText" Text="{x:Static properties:Resources.ThreeD_Perspective}"/>
                    </ToggleButton>
                    <Border Width="1" Height="22" Background="{DynamicResource GlobalBorderBrush}" Margin="8,5"/>
                    <TextBlock x:Name="DisplayModeText" Text="{x:Static properties:Resources.ThreeD_DisplayMode}" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="3,0,6,0"/>
                    <ComboBox x:Name="RenderModeComboBox" Width="104" Height="30" Margin="2,0" VerticalContentAlignment="Center" SelectionChanged="RenderModeComboBox_SelectionChanged">
                        <ComboBoxItem Tag="Textured" Content="{x:Static properties:Resources.ThreeD_TexturedMaterial}" IsSelected="True"/>
                        <ComboBoxItem Tag="Solid" Content="{x:Static properties:Resources.ThreeD_Solid}"/>
                        <ComboBoxItem Tag="Wireframe" Content="{x:Static properties:Resources.ThreeD_WireframeRenderMode}"/>
                    </ComboBox>
                    <Button x:Name="ScreenshotButton" Style="{StaticResource ModelViewerToolbarButton}" Click="Screenshot_Click" ToolTip="Ctrl+Shift+S">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ModelViewerGlyph}" Text="&#xE722;" Margin="0,0,7,0"/>
                            <TextBlock Text="{x:Static properties:Resources.ThreeD_Screenshot}"/>
                        </StackPanel>
                    </Button>
                    </StackPanel>
                </ScrollViewer>
                <Button x:Name="MoreButton" Grid.Column="1" Style="{StaticResource ModelViewerToolbarButton}" Click="MoreButton_Click" ToolTip="{x:Static properties:Resources.ThreeD_More}" Margin="4,0,0,0">
                        <TextBlock Style="{StaticResource ModelViewerGlyph}" Text="&#xE712;"/>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{x:Static properties:Resources.ThreeD_Reload}" Click="Reload_Click" InputGestureText="Ctrl+R"/>
                                <Separator/>
                                <MenuItem Header="{x:Static properties:Resources.ThreeD_IsolateSelected}" Click="IsolateSelected_Click" InputGestureText="I"/>
                                <MenuItem Header="{x:Static properties:Resources.ThreeD_HideSelected}" Click="HideSelected_Click" InputGestureText="H"/>
                                <MenuItem Header="{x:Static properties:Resources.ThreeD_ShowAll}" Click="ShowAllNodes_Click" InputGestureText="Shift+H"/>
                                <Separator/>
                                <MenuItem x:Name="FlipVerticalMenuItem" Header="{x:Static properties:Resources.ThreeD_FlipVertical}" IsCheckable="True" Click="FlipVertical_Click"/>
                                <Separator/>
                                <MenuItem Header="{x:Static properties:Resources.ThreeD_Screenshot}" Click="Screenshot_Click" InputGestureText="Ctrl+Shift+S"/>
                                <MenuItem Header="{x:Static properties:Resources.ThreeD_ExportModel}" Click="ExportModel_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
            </Grid>
        </Border>

        <Border Style="{StaticResource ModelViewerOverlayPanel}" Width="64" HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="4,72,0,72" CornerRadius="7" Panel.ZIndex="42">
            <StackPanel>
                <ToggleButton x:Name="SceneRailButton" Style="{StaticResource ModelViewerRailToggle}" IsChecked="True" Click="SceneRailButton_Click">
                    <StackPanel>
                        <TextBlock Style="{StaticResource ModelViewerGlyph}" Text="&#xE7B8;" FontSize="20"/>
                        <TextBlock Text="{x:Static properties:Resources.ThreeD_Scene}" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="InfoRailButton" Style="{StaticResource ModelViewerRailToggle}" Click="InfoRailButton_Click">
                    <StackPanel>
                        <TextBlock Style="{StaticResource ModelViewerGlyph}" Text="&#xE946;" FontSize="20"/>
                        <TextBlock Text="{x:Static properties:Resources.ThreeD_Info}" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </ToggleButton>
            </StackPanel>
        </Border>

        <Border x:Name="SideDrawer" Style="{StaticResource ModelViewerOverlayPanel}" Width="264" HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="68,72,0,72" Padding="10" CornerRadius="7" Panel.ZIndex="41">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="4,1,1,10">
                    <TextBlock x:Name="DrawerTitle" Text="{x:Static properties:Resources.ThreeD_Scene}" Style="{StaticResource ModelViewerHeading}"/>
                    <Button Style="{StaticResource ModelViewerToolbarButton}" Width="28" Height="28" Padding="0" HorizontalAlignment="Right" Click="CloseDrawer_Click" ToolTip="{x:Static properties:Resources.ThreeD_Collapse}">
                        <TextBlock Style="{StaticResource ModelViewerGlyph}" Text="&#xE711;" FontSize="13"/>
                    </Button>
                </Grid>
                <Grid x:Name="SceneDrawerContent" Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,8">
                        <TextBox x:Name="SceneSearchTextBox" Height="32" Padding="30,4,8,4" TextChanged="SceneSearchTextBox_TextChanged"/>
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE721;" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False"/>
                        <TextBlock Text="{x:Static properties:Resources.ThreeD_SearchNodes}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="31,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SceneSearchTextBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <TreeView x:Name="ModelTreeView" Grid.Row="1" Style="{StaticResource ModelViewerTreeView}" ItemContainerStyle="{StaticResource ModelViewerTreeItem}" SelectedItemChanged="ModelTreeView_SelectedItemChanged">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <Grid Height="29">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="28"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" FontFamily="Segoe MDL2 Assets" Text="&#xE7B8;" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <Button Grid.Column="2" Style="{StaticResource ModelViewerToolbarButton}" Width="26" Height="26" Padding="0" Click="NodeVisibility_Click" ToolTip="{x:Static properties:Resources.ThreeD_ToggleVisibility}">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE890;" FontSize="14">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Opacity" Value="1"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEffectivelyVisible}" Value="False">
                                                            <Setter Property="Opacity" Value="0.28"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button>
                                </Grid>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
                <ScrollViewer x:Name="InfoDrawerContent" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{x:Static properties:Resources.ThreeD_File}" Style="{StaticResource ModelViewerCaption}" Margin="2,2,2,5"/>
                        <TextBlock x:Name="InfoFileNameText" Text="—" Foreground="{DynamicResource GlobalTextBrush}" TextWrapping="Wrap" Margin="2,0,2,12"/>
                        <TextBlock Text="{x:Static properties:Resources.ThreeD_Geometry}" Style="{StaticResource ModelViewerCaption}" Margin="2,2,2,5"/>
                        <Grid Margin="2,0,2,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{x:Static properties:Resources.ThreeD_Mesh}" Style="{StaticResource ModelViewerCaption}"/>
                                <TextBlock x:Name="InfoMeshCountText" Text="—" FontSize="16" Foreground="{DynamicResource GlobalTextBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{x:Static properties:Resources.ThreeD_Material}" Style="{StaticResource ModelViewerCaption}"/>
                                <TextBlock x:Name="InfoMaterialCountText" Text="—" FontSize="16" Foreground="{DynamicResource GlobalTextBrush}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{x:Static properties:Resources.ThreeD_DimensionsModelUnits}" Style="{StaticResource ModelViewerCaption}" Margin="2,2,2,5"/>
                        <TextBlock x:Name="InfoDimensionsText" Text="—" Foreground="{DynamicResource GlobalTextBrush}" Margin="2,0,2,12" TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Static properties:Resources.ThreeD_Loading}" Style="{StaticResource ModelViewerCaption}" Margin="2,2,2,5"/>
                        <TextBlock x:Name="InfoLoadText" Text="—" Foreground="{DynamicResource GlobalTextBrush}" Margin="2,0,2,12" TextWrapping="Wrap"/>
                        <Separator Margin="2,4,2,12"/>
                        <TextBlock Text="{x:Static properties:Resources.ThreeD_MouseControls}" Style="{StaticResource ModelViewerHeading}" Margin="2,0,2,8"/>
                        <TextBlock Text="{x:Static properties:Resources.ThreeD_MouseControlsGuide}" Style="{StaticResource ModelViewerCaption}" LineHeight="21" TextWrapping="Wrap" Margin="2"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border x:Name="IsolationBanner" Style="{StaticResource ModelViewerOverlayPanel}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="80,58,20,0" Padding="10,6" Visibility="Collapsed" Panel.ZIndex="39">
            <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE73D;" Foreground="#FF3899F6" Margin="0,0,7,0"/>
                <TextBlock Text="{x:Static properties:Resources.ThreeD_IsolationActive}" Foreground="{DynamicResource GlobalTextBrush}"/>
                <Button Style="{StaticResource ModelViewerToolbarButton}" Height="24" Margin="8,-2,-4,-2" Padding="6,0" Content="{x:Static properties:Resources.ThreeD_ExitIsolation}" Click="ExitIsolation_Click"/>
            </StackPanel>
        </Border>

        <Border x:Name="EmptyStatePanel" Style="{StaticResource ModelViewerOverlayPanel}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="34,28" MaxWidth="430" Panel.ZIndex="20">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7B8;" FontSize="38" Foreground="#FF3899F6" HorizontalAlignment="Center" Margin="0,0,0,13"/>
                <TextBlock Text="{x:Static properties:Resources.ThreeD_OpenModel}" Style="{StaticResource ModelViewerHeading}" FontSize="18" HorizontalAlignment="Center"/>
                <TextBlock Text="{x:Static properties:Resources.ThreeD_EmptyStateDescription}" Style="{StaticResource ModelViewerCaption}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,18"/>
                <Button Style="{StaticResource ModelViewerCardButton}" Height="36" MinWidth="132" Click="OpenModel_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource ModelViewerGlyph}" Text="&#xE8E5;" Margin="0,0,7,0"/>
                        <TextBlock Text="{x:Static properties:Resources.ThreeD_OpenModel}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <Border x:Name="ModelSummaryCard" Style="{StaticResource ModelViewerOverlayPanel}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="80,0,0,20" Padding="12,8" MinWidth="246" Visibility="Collapsed" Panel.ZIndex="35">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" FontFamily="Segoe MDL2 Assets" Text="&#xE8A5;" FontSize="20" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="SummaryFileNameText" Text="model.obj" Foreground="{DynamicResource GlobalTextBrush}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SummaryGeometryText" Text="—" Style="{StaticResource ModelViewerCaption}" Margin="0,3,0,0"/>
                </StackPanel>
                <Ellipse Grid.Column="2" Width="6" Height="6" Fill="#FF45C77B" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Border x:Name="SelectionCard" Style="{StaticResource ModelViewerOverlayPanel}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,20" Padding="12" Width="306" Visibility="Collapsed" Panel.ZIndex="35">
            <StackPanel>
                <Grid Margin="3,1,3,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="5" Background="#183899F6">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7B8;" FontSize="18" Foreground="#FF3899F6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="SelectionNameText" Text="Mesh" Foreground="{DynamicResource GlobalTextBrush}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SelectionStatsText" Text="—" Style="{StaticResource ModelViewerCaption}" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
                <UniformGrid Columns="3">
                    <Button Style="{StaticResource ModelViewerCardButton}" Click="FocusSelection_Click">
                        <StackPanel>
                            <TextBlock Style="{StaticResource ModelViewerGlyph}" Text="&#xF2A0;" FontSize="18"/>
                            <TextBlock Text="{x:Static properties:Resources.ThreeD_Focus}" FontSize="11" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ModelViewerCardButton}" Click="IsolateSelected_Click">
                        <StackPanel>
                            <TextBlock Style="{StaticResource ModelViewerGlyph}" Text="&#xE7B8;" FontSize="18"/>
                            <TextBlock Text="{x:Static properties:Resources.ThreeD_Isolate}" FontSize="11" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ModelViewerCardButton}" Click="HideSelected_Click">
                        <StackPanel>
                            <TextBlock Style="{StaticResource ModelViewerGlyph}" Text="&#xED1A;" FontSize="18"/>
                            <TextBlock Text="{x:Static properties:Resources.ThreeD_Hide}" FontSize="11" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>
            </StackPanel>
        </Border>

        <Border x:Name="LoadingPanel" Style="{StaticResource ModelViewerOverlayPanel}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="80,0,20,20" Padding="12,9" Visibility="Collapsed" Panel.ZIndex="60">
            <StackPanel Orientation="Horizontal">
                <ProgressBar Width="120" Height="4" IsIndeterminate="True" BorderThickness="0" Foreground="#FF3899F6" VerticalAlignment="Center"/>
                <TextBlock x:Name="LoadingText" Text="{x:Static properties:Resources.ThreeD_LoadingModel}" Foreground="{DynamicResource GlobalTextBrush}" Margin="12,0,6,0" VerticalAlignment="Center"/>
                <Button Style="{StaticResource ModelViewerToolbarButton}" Height="26" Padding="7,0" Content="{x:Static properties:Resources.ThreeD_Cancel}" Click="CancelLoad_Click"/>
            </StackPanel>
        </Border>

        <Border x:Name="GraphicsErrorPanel" Style="{StaticResource ModelViewerOverlayPanel}" MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="88,24,24,24" Padding="24" Visibility="Collapsed" Panel.ZIndex="70">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Style="{StaticResource ModelViewerGlyph}" Text="&#xE7BA;" FontSize="34" Foreground="#FFEEA947" HorizontalAlignment="Center"/>
                <TextBlock Text="{x:Static properties:Resources.ThreeD_ModelViewer}" Style="{StaticResource ModelViewerHeading}" FontSize="20" HorizontalAlignment="Center" Margin="0,12,0,8"/>
                <TextBlock Text="{x:Static properties:Resources.ThreeD_Direct3DUnavailable}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" TextAlignment="Center"/>
            </StackPanel>
        </Border>

        <Border x:Name="ToastPanel" Style="{StaticResource ModelViewerOverlayPanel}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="80,0,20,20" Padding="12,8" Visibility="Collapsed" Panel.ZIndex="59">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ToastGlyph" FontFamily="Segoe MDL2 Assets" Text="&#xE73E;" Foreground="#FF45C77B" Margin="0,0,8,0"/>
                <TextBlock x:Name="ToastText" Text="{x:Static properties:Resources.ThreeD_ModelLoaded}" Foreground="{DynamicResource GlobalTextBrush}" MaxWidth="520" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border x:Name="DropOverlay" Background="#D915181C" BorderBrush="#FF3899F6" BorderThickness="2" Margin="10" CornerRadius="10" Visibility="Collapsed" IsHitTestVisible="False" Panel.ZIndex="100">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE898;" FontSize="42" Foreground="#FF3899F6" HorizontalAlignment="Center"/>
                <TextBlock Text="{x:Static properties:Resources.ThreeD_DropToOpenModel}" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
