<Window x:Class="ColorVision.ImageEditor.Window3D"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:properties="clr-namespace:ColorVision.ImageEditor.Properties"
        Title="{x:Static properties:Resources.ThreeD_View3D}" Width="1180" Height="800" MinWidth="760" MinHeight="540"
        WindowStartupLocation="CenterOwner" Loaded="Window_Loaded" Closed="Window_Closed" PreviewKeyDown="Window3D_PreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ThreeDStyles.xaml"/></ResourceDictionary.MergedDictionaries>
            <Style x:Key="Label" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#C8D1DC"/><Setter Property="Margin" Value="0,12,0,6"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>
            <Style x:Key="Action" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
                <Setter Property="Height" Value="32"/><Setter Property="Margin" Value="0,3"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Background="#151A22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="#1D2530" Padding="18,12">
            <DockPanel>
                <TextBlock Text="亮度高度图" Foreground="#F0F4FA" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock x:Name="SourceInfo" Foreground="#B0BECF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="226"/><ColumnDefinition/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
            <Border Background="#1D2530" Padding="14,4,14,12" BorderBrush="#35404D" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="显示高度" Style="{StaticResource Label}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                            <Button Content="−" Style="{StaticResource Action}" Click="HeightScaleDecrease_Click" ToolTip="降低高度（−）"/>
                            <TextBox x:Name="HeightValue" Grid.Column="1" Margin="6,3" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" LostFocus="HeightValue_LostFocus" KeyDown="HeightValue_KeyDown" ToolTip="Z = 亮度值 / 255 × 显示高度"/>
                            <Button Grid.Column="2" Content="+" Style="{StaticResource Action}" Click="HeightScaleIncrease_Click" ToolTip="增加高度（+）"/>
                        </Grid>
                        <TextBlock Text="Z = 灰度 / 255 × 显示高度" Foreground="#92A1B5" FontSize="11" Margin="0,4"/>
                        <TextBlock Text="仅调整显示比例。亮度不是物理深度；不改变源像素。" Foreground="#92A1B5" FontSize="11" TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Static properties:Resources.ThreeD_PseudoColor}" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="ComboBoxColormap" SelectionChanged="ComboBoxColormap_SelectionChanged" MinHeight="32">
                            <ComboBox.ItemTemplate><DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="2">
                                    <Image Width="12" Height="64" Stretch="Fill" Source="{Binding ImageSource}"><Image.LayoutTransform><RotateTransform Angle="90"/></Image.LayoutTransform></Image>
                                    <TextBlock Text="{Binding Name}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="立体光照" Style="{StaticResource Label}"/>
                        <Slider x:Name="LightingSlider" Minimum="0" Maximum="1" Value="0.35" ValueChanged="LightingSlider_ValueChanged" ToolTip="左侧为纯伪彩色，右侧增强表面光照；图例始终表示原始伪彩色"/>
                        <TextBlock Text="纯伪彩色                         明暗塑形" Foreground="#92A1B5" FontSize="10" Margin="0,2,0,8"/>
                        <TextBlock Text="视角" Style="{StaticResource Label}"/>
                        <Button Content="↺ 重置并完整显示  ·  Home" Style="{StaticResource Action}" Click="ResetViewButton_Click"/>
                        <Button Content="俯视" Style="{StaticResource Action}" Click="TopView_Click"/>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="平移" Foreground="#92A1B5" HorizontalAlignment="Center" FontSize="11"/>
                                <WrapPanel HorizontalAlignment="Center" Width="90">
                                    <Button Style="{StaticResource ToolBtn}" Content="◀" Click="CameraMoveLeft_Click"/>
                                    <Button Style="{StaticResource ToolBtn}" Content="▲" Click="CameraMoveForward_Click"/>
                                    <Button Style="{StaticResource ToolBtn}" Content="▶" Click="CameraMoveRight_Click"/>
                                    <Button Style="{StaticResource ToolBtn}" Content="▼" Click="CameraMoveBack_Click" Margin="31,1,1,1"/>
                                </WrapPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="旋转" Foreground="#92A1B5" HorizontalAlignment="Center" FontSize="11"/>
                                <WrapPanel HorizontalAlignment="Center" Width="90">
                                    <Button Style="{StaticResource ToolBtn}" Content="◀" Click="LookLeft_Click"/>
                                    <Button Style="{StaticResource ToolBtn}" Content="▲" Click="LookUp_Click"/>
                                    <Button Style="{StaticResource ToolBtn}" Content="▶" Click="LookRight_Click"/>
                                    <Button Style="{StaticResource ToolBtn}" Content="▼" Click="LookDown_Click" Margin="31,1,1,1"/>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="左键旋转 · 右键 / 中键平移&#10;滚轮缩放 · 双击完整显示" Foreground="#92A1B5" FontSize="11" LineHeight="18" Margin="0,5,0,10"/>
                        <Button Content="{x:Static properties:Resources.ThreeD_Screenshot}" Style="{StaticResource Action}" Click="ScreenshotButton_Click"/>
                        <Button Content="{x:Static properties:Resources.ThreeD_ExportModel}" Style="{StaticResource Action}" Click="ExportModelButton_Click"/>
                        <Button Content="{x:Static properties:Resources.ThreeD_Settings}" Style="{StaticResource Action}" Click="SettingsButton_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Grid Grid.Column="1" x:Name="ViewArea" ClipToBounds="True" SizeChanged="ViewArea_SizeChanged">
                <Grid x:Name="ContentGrid"/>
                <Border x:Name="LoadingPanel" Background="#CC151A22" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="6" Padding="24,16" IsHitTestVisible="False">
                    <TextBlock x:Name="LoadingText" Text="正在准备高度图…" Foreground="White" TextWrapping="Wrap" MaxWidth="420"/>
                </Border>
            </Grid>
            <Grid x:Name="ColorBarPanel" Grid.Column="2" Margin="4,24,8,24">
                <Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border BorderBrush="#607080" BorderThickness="1"><Image x:Name="ColorBarImage" Stretch="Fill"/></Border>
                <TextBlock Grid.Column="1" Text="255" Foreground="#D1D9E5" FontSize="11" Margin="6,0" VerticalAlignment="Top"/>
                <TextBlock Grid.Column="1" Text="128" Foreground="#D1D9E5" FontSize="11" Margin="6,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="0" Foreground="#D1D9E5" FontSize="11" Margin="6,0" VerticalAlignment="Bottom"/>
            </Grid>
        </Grid>
        <Border Grid.Row="2" Background="#1D2530" Padding="16,8" BorderBrush="#35404D" BorderThickness="0,1,0,0">
            <StackPanel>
                <TextBlock x:Name="HoverInfoText" Text="将鼠标移到曲面上读取显示亮度（0–255）" Foreground="#E0E9F5" FontSize="12"/>
                <TextBlock x:Name="StatusText" Text="正在载入" Foreground="#92A1B5" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <Popup x:Name="SettingsPopup" Placement="Center" PlacementTarget="{Binding ElementName=ViewArea}" StaysOpen="False" AllowsTransparency="True">
            <Border Background="#F0202834" CornerRadius="8" Padding="20" BorderBrush="#607080" BorderThickness="1">
                <StackPanel Width="280">
                    <TextBlock Text="高度图显示设置" Foreground="White" FontSize="16" Margin="0,0,0,8"/>
                    <TextBlock Text="静止细节 · 最长边（128–2048）" Style="{StaticResource Label}"/>
                    <TextBox x:Name="TxtDetail" Padding="6,4"/>
                    <TextBlock Text="交互网格上限 X / Y（128–1024）" Style="{StaticResource Label}"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtTargetX" Padding="6,4" Margin="0,0,4,0"/>
                        <TextBox x:Name="TxtTargetY" Grid.Column="1" Padding="6,4" Margin="4,0,0,0"/>
                    </Grid>
                    <CheckBox x:Name="AdaptiveCheck" Content="交互时使用缓存的较低细节网格" Foreground="White" Margin="0,16,0,8"/>
                    <TextBlock Text="松开后恢复完整细节。低配显卡可用 768 / 256；关闭此选项可始终保持细节。采样不恢复原图未采到的细节。" Foreground="#A9B6C9" TextWrapping="Wrap" FontSize="11"/>
                    <TextBlock x:Name="SettingsError" Foreground="#FFBF80" TextWrapping="Wrap" Margin="0,8"/>
                    <Button Content="应用并刷新" Click="ApplySettings_Click" Padding="8,6"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
