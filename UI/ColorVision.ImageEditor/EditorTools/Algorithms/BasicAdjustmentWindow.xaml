<Window x:Class="ColorVision.ImageEditor.EditorTools.Algorithms.BasicAdjustmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:properties="clr-namespace:ColorVision.ImageEditor.Properties"
        Title="{x:Static properties:Resources.Algorithm_BrightnessContrastTitle}"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource GlobalBackground}"
        Foreground="{DynamicResource GlobalTextBrush}"
        ResizeMode="NoResize">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{x:Static properties:Resources.Algorithm_BrightnessContrastTitle}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}"/>
            <TextBlock Text="{x:Static properties:Resources.Algorithm_AdjustBrightnessContrast}"
                       Margin="0,4,0,0"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="76"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="{x:Static properties:Resources.Algorithm_Exposure}"
                       VerticalAlignment="Center"
                       Margin="0,8,12,8"/>
            <hc:PreviewSlider x:Name="ExposureSlider"
                              Grid.Row="0"
                              Grid.Column="1"
                              Minimum="-5"
                              Maximum="5"
                              Value="0"
                              TickFrequency="0.1"
                              IsSnapToTickEnabled="True"
                              SmallChange="0.1"
                              LargeChange="1"
                              ValueChanged="ParameterSlider_ValueChanged"/>
            <TextBox Grid.Row="0"
                     Grid.Column="2"
                     Text="{Binding ElementName=ExposureSlider, Path=Value, StringFormat=F1}"
                     Margin="8,5,0,5"
                     VerticalContentAlignment="Center"/>

            <TextBlock Grid.Row="1"
                       Text="{x:Static properties:Resources.Algorithm_Brightness}"
                       VerticalAlignment="Center"
                       Margin="0,8,12,8"/>
            <hc:PreviewSlider x:Name="BrightnessSlider"
                              Grid.Row="1"
                              Grid.Column="1"
                              Minimum="-100"
                              Maximum="100"
                              Value="0"
                              TickFrequency="1"
                              IsSnapToTickEnabled="True"
                              SmallChange="1"
                              LargeChange="10"
                              ValueChanged="ParameterSlider_ValueChanged"/>
            <TextBox Grid.Row="1"
                     Grid.Column="2"
                     Text="{Binding ElementName=BrightnessSlider, Path=Value, StringFormat=F0}"
                     Margin="8,5,0,5"
                     VerticalContentAlignment="Center"/>

            <TextBlock Grid.Row="2"
                       Text="{x:Static properties:Resources.Algorithm_Contrast}"
                       VerticalAlignment="Center"
                       Margin="0,8,12,8"/>
            <hc:PreviewSlider x:Name="ContrastSlider"
                              Grid.Row="2"
                              Grid.Column="1"
                              Minimum="-100"
                              Maximum="100"
                              Value="0"
                              TickFrequency="1"
                              IsSnapToTickEnabled="True"
                              SmallChange="1"
                              LargeChange="10"
                              ValueChanged="ParameterSlider_ValueChanged"/>
            <TextBox Grid.Row="2"
                     Grid.Column="2"
                     Text="{Binding ElementName=ContrastSlider, Path=Value, StringFormat=F0}"
                     Margin="8,5,0,5"
                     VerticalContentAlignment="Center"/>

            <TextBlock Grid.Row="3"
                       Text="{x:Static properties:Resources.Algorithm_GammaValue}"
                       VerticalAlignment="Center"
                       Margin="0,8,12,8"/>
            <hc:PreviewSlider x:Name="GammaSlider"
                              Grid.Row="3"
                              Grid.Column="1"
                              Minimum="0.1"
                              Maximum="5"
                              Value="1"
                              TickFrequency="0.05"
                              IsSnapToTickEnabled="True"
                              SmallChange="0.05"
                              LargeChange="0.5"
                              ValueChanged="ParameterSlider_ValueChanged"/>
            <TextBox Grid.Row="3"
                     Grid.Column="2"
                     Text="{Binding ElementName=GammaSlider, Path=Value, StringFormat=F2}"
                     Margin="8,5,0,5"
                     VerticalContentAlignment="Center"/>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,18,0,0" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Content="{x:Static properties:Resources.Algorithm_Reset}"
                        Width="88"
                        Click="Reset_Click"/>
                <CheckBox x:Name="PreviewCheckBox"
                          Content="{x:Static properties:Resources.Algorithm_Preview}"
                          Margin="18,0,0,0"
                          VerticalAlignment="Center"
                          IsChecked="True"
                          Checked="PreviewCheckBox_Changed"
                          Unchecked="PreviewCheckBox_Changed"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{x:Static properties:Resources.Algorithm_Apply}"
                        Width="88"
                        Margin="0,0,10,0"
                        IsDefault="True"
                        Click="Apply_Click"/>
                <Button Content="{x:Static properties:Resources.Algorithm_Cancel}"
                        Width="88"
                        IsCancel="True"
                        Click="Cancel_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
