<Window x:Class="ColorVision.ImageEditor.EditorTools.Algorithms.Calculate.RoiStatistics.RoiStatisticsResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="ROI 统计结果" Width="980" Height="700" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource GlobalBackground}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="SummaryText" Margin="4,0,4,8" TextWrapping="Wrap"/>
        <TabControl Grid.Row="1">
            <TabItem Header="统计摘要">
                <DataGrid x:Name="SummaryGrid" IsReadOnly="True" AutoGenerateColumns="True" CanUserAddRows="False"/>
            </TabItem>
            <TabItem Header="直方图">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <ScottPlot:WpfPlot x:Name="HistogramPlot"/>
                    <DataGrid Grid.Row="1" x:Name="HistogramGrid" IsReadOnly="True" AutoGenerateColumns="True" CanUserAddRows="False"/>
                </Grid>
            </TabItem>
            <TabItem Header="坏点候选">
                <DataGrid x:Name="CandidatesGrid" IsReadOnly="True" AutoGenerateColumns="True" CanUserAddRows="False"/>
            </TabItem>
        </TabControl>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="导出 CSV" Width="96" Margin="0,0,8,0" Click="ExportCsv_Click"/>
            <Button Content="导出 JSON" Width="96" Margin="0,0,8,0" Click="ExportJson_Click"/>
            <Button Content="关闭" Width="88" IsCancel="True" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
