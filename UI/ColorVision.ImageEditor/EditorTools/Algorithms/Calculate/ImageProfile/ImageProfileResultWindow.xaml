<Window x:Class="ColorVision.ImageEditor.EditorTools.Algorithms.Calculate.ImageProfile.ImageProfileResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="灰度与颜色剖面" Width="1100" Height="800" MinWidth="760" MinHeight="580"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource GlobalBackground}" Foreground="{DynamicResource GlobalTextBrush}">
    <Window.Resources>
        <Style x:Key="ProfileGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource CV.Surface.Control}"/>
            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CV.Border.Control}"/>
            <Setter Property="RowBackground" Value="{DynamicResource CV.Surface.Control}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource CV.Surface.Alternate}"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeight" Value="26"/>
            <Setter Property="ColumnHeaderHeight" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="ColumnWidth" Value="*"/>
            <Setter Property="MinColumnWidth" Value="65"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="EnableColumnVirtualization" Value="True"/>
            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="8,3"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{DynamicResource CV.Surface.Alternate}"/>
                        <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}"/>
                        <Setter Property="Padding" Value="8,4"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource CV.Border.Control}"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="150"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="295" MinHeight="90"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <StackPanel x:Name="SourcePanel" Orientation="Horizontal" Visibility="Collapsed" Margin="4,0,4,8">
                <TextBlock Text="数据源：" VerticalAlignment="Center"/>
                <ComboBox x:Name="SourceSelector" MinWidth="170"/>
            </StackPanel>
            <WrapPanel x:Name="ChannelPanel" Margin="4,0,4,8"/>
            <TextBlock x:Name="SummaryText" Margin="4,0,4,8" TextWrapping="Wrap" Foreground="{DynamicResource CV.Text.Secondary}" FontSize="12"/>
        </StackPanel>
        <ScottPlot:WpfPlot Grid.Row="1" x:Name="ProfilePlot"/>
        <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch" Background="{DynamicResource CV.Border.Weak}"/>
        <TabControl Grid.Row="3">
            <TabItem Header="统计摘要">
                <DataGrid x:Name="StatisticsGrid" Style="{StaticResource ProfileGrid}" AutoGenerateColumns="True"/>
            </TabItem>
            <TabItem Header="采样数据">
                <DataGrid x:Name="SamplesGrid" Style="{StaticResource ProfileGrid}" AutoGenerateColumns="True" ColumnWidth="SizeToHeader"/>
            </TabItem>
        </TabControl>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <ProgressBar x:Name="ExportProgress" Width="140" Height="12" Minimum="0" Maximum="100" Visibility="Collapsed" Margin="0,0,8,0"/>
            <Button x:Name="CancelExportButton" Content="取消导出" Width="88" Margin="0,0,8,0" Visibility="Collapsed" Click="CancelExport_Click"/>
            <Button x:Name="ExportCsvButton" Content="导出 CSV" Width="96" Margin="0,0,8,0" Click="ExportCsv_Click"/>
            <Button x:Name="ExportJsonButton" Content="导出 JSON" Width="96" Margin="0,0,8,0" Click="ExportJson_Click"/>
            <Button Content="关闭" Width="88" IsCancel="True" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
