<Window x:Class="ColorVision.ImageEditor.EditorTools.Algorithms.Calculate.ImageProfile.ImageProfileResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="灰度与颜色剖面" Width="980" Height="680" MinWidth="760" MinHeight="500"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource GlobalBackground}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <StackPanel x:Name="SourcePanel" Orientation="Horizontal" Visibility="Collapsed" Margin="4,0,4,8">
                <TextBlock Text="数据源：" VerticalAlignment="Center"/>
                <ComboBox x:Name="SourceSelector" MinWidth="170"/>
            </StackPanel>
            <TextBlock x:Name="SummaryText" Margin="4,0,4,8" TextWrapping="Wrap"/>
        </StackPanel>
        <ScottPlot:WpfPlot Grid.Row="1" x:Name="ProfilePlot"/>
        <TabControl Grid.Row="2">
            <TabItem Header="统计摘要">
                <DataGrid x:Name="StatisticsGrid" IsReadOnly="True" AutoGenerateColumns="True" CanUserAddRows="False"/>
            </TabItem>
            <TabItem Header="采样数据">
                <DataGrid x:Name="SamplesGrid" IsReadOnly="True" AutoGenerateColumns="True" CanUserAddRows="False"/>
            </TabItem>
        </TabControl>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <ProgressBar x:Name="ExportProgress" Width="140" Height="12" Minimum="0" Maximum="100" Visibility="Collapsed" Margin="0,0,8,0"/>
            <Button x:Name="CancelExportButton" Content="取消导出" Width="88" Margin="0,0,8,0" Visibility="Collapsed" Click="CancelExport_Click"/>
            <Button x:Name="ExportCsvButton" Content="导出 CSV" Width="96" Margin="0,0,8,0" Click="ExportCsv_Click"/>
            <Button x:Name="ExportJsonButton" Content="导出 JSON" Width="96" Margin="0,0,8,0" Click="ExportJson_Click"/>
            <Button Content="关闭" Width="88" IsCancel="True" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
