<Window x:Class="ColorVision.ImageEditor.EditorTools.Algorithms.Calculate.ContourAnalysis.ContourAnalysisResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="轮廓提取结果" Width="1080" Height="700" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource GlobalBackground}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="SummaryText" Margin="4,0,4,8" TextWrapping="Wrap"/>
        <DataGrid Grid.Row="1" x:Name="ContoursGrid" IsReadOnly="True" AutoGenerateColumns="True" CanUserAddRows="False"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="导出 CSV" Width="96" Margin="0,0,8,0" Click="ExportCsv_Click"/>
            <Button Content="导出 JSON" Width="96" Margin="0,0,8,0" Click="ExportJson_Click"/>
            <Button Content="关闭" Width="88" IsCancel="True" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
