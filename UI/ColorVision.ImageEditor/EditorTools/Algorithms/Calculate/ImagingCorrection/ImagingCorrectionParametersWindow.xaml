<Window x:Class="ColorVision.ImageEditor.EditorTools.Algorithms.Calculate.ImagingCorrection.ImagingCorrectionParametersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="成像校正" Height="510" Width="820" WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="校正顺序固定为 Dark-frame → Flat-field → Shading/Non-uniformity → Bad-pixel。参考图必须与源图尺寸和格式一致；坏点 map 必须为 Gray8。" TextWrapping="Wrap"/>
        <Grid Grid.Row="1" Margin="0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <CheckBox Content="Dark-frame" IsChecked="{Binding EnableDarkFrame}" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" Text="{Binding DarkFramePath, UpdateSourceTrigger=PropertyChanged}" Margin="6"/>
            <Button Grid.Column="2" Content="选择..." Tag="dark" Click="Browse_Click" Margin="6"/>
            <CheckBox Grid.Row="1" Content="Flat-field" IsChecked="{Binding EnableFlatField}" VerticalAlignment="Center"/>
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding FlatFieldPath, UpdateSourceTrigger=PropertyChanged}" Margin="6"/>
            <Button Grid.Row="1" Grid.Column="2" Content="选择..." Tag="flat" Click="Browse_Click" Margin="6"/>
            <CheckBox Grid.Row="2" Content="Shading / Non-uniformity" IsChecked="{Binding EnableShading}" VerticalAlignment="Center"/>
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ShadingReferencePath, UpdateSourceTrigger=PropertyChanged}" Margin="6"/>
            <Button Grid.Row="2" Grid.Column="2" Content="选择..." Tag="shading" Click="Browse_Click" Margin="6"/>
            <CheckBox Grid.Row="3" Content="Bad-pixel map" IsChecked="{Binding EnableBadPixelCorrection}" VerticalAlignment="Center"/>
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding BadPixelMapPath, UpdateSourceTrigger=PropertyChanged}" Margin="6"/>
            <Button Grid.Row="3" Grid.Column="2" Content="选择..." Tag="bad" Click="Browse_Click" Margin="6"/>
        </Grid>
        <TextBlock Grid.Row="2" x:Name="SummaryText" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <DockPanel Grid.Row="3" LastChildFill="False">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="高级参数..." Width="95" Margin="0,0,8,0" Click="Edit_Click"/>
                <Button Content="加载 preset..." Width="105" Margin="0,0,8,0" Click="Load_Click"/>
                <Button Content="保存 preset..." Width="105" Click="Save_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="执行并提交" Width="95" Margin="8,0" Click="Run_Click"/>
                <Button Content="取消" Width="75" Click="Cancel_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
