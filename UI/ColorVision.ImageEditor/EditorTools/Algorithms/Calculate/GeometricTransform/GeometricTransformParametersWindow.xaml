<Window x:Class="ColorVision.ImageEditor.EditorTools.Algorithms.Calculate.GeometricTransform.GeometricTransformParametersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="几何变换" Height="350" Width="640" WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="矩阵按源像素中心 → 目标像素中心定义。可编辑参数，或加载已保存的 V1 preset。" TextWrapping="Wrap"/>
        <Border Grid.Row="1" Margin="0,12" Padding="12" BorderBrush="#40808080" BorderThickness="1" CornerRadius="4">
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" FontFamily="Consolas"/>
        </Border>
        <DockPanel Grid.Row="2" LastChildFill="False">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="编辑参数..." Width="95" Margin="0,0,8,0" Click="Edit_Click"/>
                <Button Content="加载 preset..." Width="105" Margin="0,0,8,0" Click="Load_Click"/>
                <Button Content="保存 preset..." Width="105" Click="Save_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="执行并提交" Width="95" Margin="8,0" Click="Run_Click"/>
                <Button Content="取消" Width="75" Click="Cancel_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
