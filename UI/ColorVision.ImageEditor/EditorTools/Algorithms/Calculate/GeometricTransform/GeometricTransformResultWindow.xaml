<Window x:Class="ColorVision.ImageEditor.EditorTools.Algorithms.Calculate.GeometricTransform.GeometricTransformResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:display="clr-namespace:ColorVision.ImageEditor"
        Title="{display:DisplayText Key='几何变换结果'}" Height="680" Width="900" WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="170"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <TabControl Grid.Row="1">
            <TabItem Header="{display:DisplayText Key='变换图像'}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Image x:Name="TransformedPreview" Stretch="None"/>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{display:DisplayText Key='有效区域 mask'}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Image x:Name="MaskPreview" Stretch="None"/>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <DataGrid x:Name="MatrixGrid" Grid.Row="2" Margin="0,8" AutoGenerateColumns="True" IsReadOnly="True"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{display:DisplayText Key='保存变换图...'}" Width="105" Margin="0,0,8,0" Click="SaveImage_Click"/>
            <Button Content="{display:DisplayText Key='保存 mask...'}" Width="95" Margin="0,0,8,0" Click="SaveMask_Click"/>
            <Button Content="{display:DisplayText Key='导出 JSON...'}" Width="95" Margin="0,0,8,0" Click="ExportJson_Click"/>
            <Button Content="{display:DisplayText Key='关闭'}" Width="75" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
