<Window x:Class="ColorVision.ImageEditor.EditorTools.Algorithms.Calculate.FrequencySpectrum.FrequencySpectrumResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:display="clr-namespace:ColorVision.ImageEditor"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="{display:DisplayText Key='FFT / 频域分析结果'}" Width="1080" Height="760" MinWidth="820" MinHeight="580"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource GlobalBackground}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="SummaryText" Margin="4,0,4,8" TextWrapping="Wrap"/>
        <TabControl Grid.Row="1">
            <TabItem Header="{display:DisplayText Key='幅度频谱'}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Image x:Name="MagnitudePreview" Stretch="None"/>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{display:DisplayText Key='功率频谱'}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Image x:Name="PowerPreview" Stretch="None"/>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{display:DisplayText Key='径向频谱'}"><ScottPlot:WpfPlot x:Name="RadialPlot"/></TabItem>
            <TabItem Header="{display:DisplayText Key='方向频谱'}"><ScottPlot:WpfPlot x:Name="DirectionalPlot"/></TabItem>
        </TabControl>
        <DataGrid Grid.Row="2" x:Name="PeaksGrid" Margin="0,8,0,0" IsReadOnly="True" AutoGenerateColumns="True" CanUserAddRows="False"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{display:DisplayText Key='保存幅度图...'}" Width="105" Margin="0,0,8,0" Click="SaveMagnitude_Click"/>
            <Button Content="{display:DisplayText Key='保存功率图...'}" Width="105" Margin="0,0,8,0" Click="SavePower_Click"/>
            <Button Content="{display:DisplayText Key='导出 CSV...'}" Width="95" Margin="0,0,8,0" Click="ExportCsv_Click"/>
            <Button Content="{display:DisplayText Key='导出 JSON...'}" Width="95" Margin="0,0,8,0" Click="ExportJson_Click"/>
            <Button Content="{display:DisplayText Key='关闭'}" Width="75" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
