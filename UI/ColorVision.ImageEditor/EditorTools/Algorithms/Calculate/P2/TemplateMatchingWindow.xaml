<Window x:Class="ColorVision.ImageEditor.EditorTools.Algorithms.Calculate.P2.TemplateMatchingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="本地模板匹配" Width="1020" Height="760" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource GlobalBackground}">
    <Grid Margin="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <WrapPanel x:Name="FileActions" Margin="0,0,0,10">
            <Button Content="新建模板" Click="New_Click" Padding="12,5" Margin="0,0,8,0"/>
            <Button Content="导入模板…" Click="Load_Click" Padding="12,5" Margin="0,0,8,0"/>
            <Button Content="导入参考图…" Click="Import_Click" Padding="12,5" Margin="0,0,8,0"/>
            <Button x:Name="ApplyButton" Content="导出模板…" Click="Save_Click" Padding="12,5" Margin="0,0,8,0"/>
            <Button x:Name="ExportButton" Content="导出模板…" Click="Export_Click" Visibility="Collapsed" Padding="12,5" Margin="0,0,8,0"/>
            <Button Content="重置参数" Click="Reset_Click" Padding="12,5" Margin="0,0,8,0"/>
            <Button x:Name="CancelButton" Content="取消" IsCancel="True" Visibility="Collapsed" Padding="12,5"/>
        </WrapPanel>
        <DockPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="模板名称" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="NameText" Width="220" HorizontalAlignment="Left" Padding="5"/>
            <TextBlock x:Name="FileText" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </DockPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="6" Height="150">
                        <Image x:Name="TemplatePreview" Stretch="Uniform"/>
                    </Border>
                    <TextBlock x:Name="ImageInfo" Margin="0,5,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto"><ContentControl x:Name="ParameterEditor"/></ScrollViewer>
            </DockPanel>
            <DockPanel Grid.Column="2">
                <TextBlock x:Name="SearchInfo" DockPanel.Dock="Top" Margin="0,0,0,8" TextWrapping="Wrap"/>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                    <Button x:Name="RunButton" Content="运行匹配" Click="Run_Click" Padding="16,6" IsEnabled="False"/>
                    <Button Content="清除结果" Click="Clear_Click" Padding="12,6" Margin="8,0,0,0"/>
                </StackPanel>
                <TabControl>
                    <TabItem Header="匹配结果">
                        <DataGrid x:Name="MatchesGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="中心 X" Binding="{Binding Center.X, StringFormat=F3}" Width="*"/>
                                <DataGridTextColumn Header="中心 Y" Binding="{Binding Center.Y, StringFormat=F3}" Width="*"/>
                                <DataGridTextColumn Header="角度(°)" Binding="{Binding AngleDegrees, StringFormat=F3}" Width="*"/>
                                <DataGridTextColumn Header="尺度" Binding="{Binding Scale, StringFormat=F3}" Width="*"/>
                                <DataGridTextColumn Header="分数" Binding="{Binding Score, StringFormat=F4}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="结果 JSON"><TextBox x:Name="ResultText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/></TabItem>
                </TabControl>
            </DockPanel>
        </Grid>
        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,10,0,0" TextWrapping="Wrap"/>
    </Grid>
</Window>
