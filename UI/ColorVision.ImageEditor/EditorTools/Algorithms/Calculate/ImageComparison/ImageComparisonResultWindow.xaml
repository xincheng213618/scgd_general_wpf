<Window x:Class="ColorVision.ImageEditor.EditorTools.Algorithms.Calculate.ImageComparison.ImageComparisonResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="图像比较" Width="1040" Height="760" MinWidth="800" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource GlobalBackground}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="SummaryText" Margin="4,0,4,8" TextWrapping="Wrap"/>
        <TabControl Grid.Row="1" x:Name="ViewTabs" SelectionChanged="ViewTabs_SelectionChanged">
            <TabItem Header="差分">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <ComboBox x:Name="DifferenceKind" Width="220" HorizontalAlignment="Left" Margin="4" SelectionChanged="DifferenceKind_SelectionChanged">
                        <ComboBoxItem Content="差分热力图" Tag="difference-heatmap" IsSelected="True"/>
                        <ComboBoxItem Content="绝对差（显示归一化）" Tag="absolute-difference-visualization"/>
                        <ComboBoxItem Content="有符号差（中性灰为零）" Tag="signed-difference-visualization"/>
                    </ComboBox>
                    <Border Grid.Row="1" Background="#FF202020"><Image x:Name="DifferenceImage" Stretch="Uniform"/></Border>
                </Grid>
            </TabItem>
            <TabItem Header="Blink">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="4">
                        <Button x:Name="BlinkButton" Content="开始" Width="80" Click="BlinkButton_Click"/>
                        <TextBlock Text="间隔 (ms)" VerticalAlignment="Center" Margin="14,0,6,0"/>
                        <Slider x:Name="BlinkInterval" Minimum="100" Maximum="2000" Value="500" Width="220" TickFrequency="100" ValueChanged="BlinkInterval_ValueChanged"/>
                        <TextBlock x:Name="BlinkLabel" VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </StackPanel>
                    <Border Grid.Row="1" Background="#FF202020"><Image x:Name="BlinkImage" Stretch="Uniform"/></Border>
                </Grid>
            </TabItem>
            <TabItem Header="Split">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="4">
                        <TextBlock Text="候选图覆盖比例" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Slider x:Name="SplitPosition" Minimum="0" Maximum="1" Value="0.5" Width="320" ValueChanged="SplitPosition_ValueChanged"/>
                    </StackPanel>
                    <Grid Grid.Row="1" x:Name="SplitViewport" Background="#FF202020" SizeChanged="SplitViewport_SizeChanged">
                        <Image x:Name="SplitReference" Stretch="Uniform"/>
                        <Image x:Name="SplitCandidate" Stretch="Uniform"/>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
        <TabControl Grid.Row="2" Margin="0,8,0,0">
            <TabItem Header="通道质量">
                <DataGrid x:Name="MetricsGrid" IsReadOnly="True" AutoGenerateColumns="True" CanUserAddRows="False"/>
            </TabItem>
            <TabItem Header="对齐预检">
                <DataGrid x:Name="AlignmentGrid" IsReadOnly="True" AutoGenerateColumns="True" CanUserAddRows="False"/>
            </TabItem>
        </TabControl>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="保存当前差分 PNG" Width="145" Margin="0,0,8,0" Click="SaveDifference_Click"/>
            <Button Content="导出 CSV" Width="96" Margin="0,0,8,0" Click="ExportCsv_Click"/>
            <Button Content="导出 JSON" Width="96" Margin="0,0,8,0" Click="ExportJson_Click"/>
            <Button Content="关闭" Width="88" IsCancel="True" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
