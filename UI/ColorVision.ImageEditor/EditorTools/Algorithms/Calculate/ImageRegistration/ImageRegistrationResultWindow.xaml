<Window x:Class="ColorVision.ImageEditor.EditorTools.Algorithms.Calculate.ImageRegistration.ImageRegistrationResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="图像配准结果" Height="740" Width="980" MinHeight="560" MinWidth="760" WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <TabControl Grid.Row="1">
            <TabItem Header="已配准图像">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Image x:Name="RegisteredPreview" Stretch="None"/>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="有效区域 mask">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Image x:Name="MaskPreview" Stretch="None"/>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <TabControl Grid.Row="2" Margin="0,8,0,0">
            <TabItem Header="变换矩阵"><DataGrid x:Name="MatrixGrid" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False"/></TabItem>
            <TabItem Header="匹配点"><DataGrid x:Name="MatchesGrid" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False"/></TabItem>
        </TabControl>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="保存配准图..." Width="110" Margin="0,0,8,0" Click="SaveImage_Click"/>
            <Button Content="保存 mask..." Width="95" Margin="0,0,8,0" Click="SaveMask_Click"/>
            <Button Content="导出 CSV..." Width="95" Margin="0,0,8,0" Click="ExportCsv_Click"/>
            <Button Content="导出 JSON..." Width="95" Margin="0,0,8,0" Click="ExportJson_Click"/>
            <Button Content="关闭" Width="75" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
