<Window x:Class="ColorVision.ImageEditor.EditorTools.Algorithms.Calculate.ImageRegistration.ImageRegistrationParametersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="图像配准" Height="320" Width="640" WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="当前图像作为 reference；随后选择的图像作为 moving。参数可保存为严格版本化的 V1 preset。" TextWrapping="Wrap"/>
        <Border Grid.Row="1" Margin="0,12" Padding="12" BorderBrush="#40808080" BorderThickness="1" CornerRadius="4">
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" FontFamily="Consolas"/>
        </Border>
        <DockPanel Grid.Row="2" LastChildFill="False">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="编辑参数..." Width="95" Margin="0,0,8,0" Click="Edit_Click"/>
                <Button Content="加载 preset..." Width="105" Margin="0,0,8,0" Click="Load_Click"/>
                <Button Content="保存 preset..." Width="105" Click="Save_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="选择 moving..." Width="110" Margin="8,0" Click="Run_Click"/>
                <Button Content="取消" Width="75" Click="Cancel_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
