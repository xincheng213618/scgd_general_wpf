<Window x:Class="ColorVision.ImageEditor.EditorTools.Algorithms.Calculate.GridDistortion.GridDistortionResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:display="clr-namespace:ColorVision.ImageEditor"
        Title="{display:DisplayText Key='点阵畸变分析 (V2)'}" Width="1020" Height="730" MinWidth="760" MinHeight="500"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBox x:Name="SummaryText" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                 FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <TextBlock Grid.Row="1" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="{display:DisplayText Key='一次定位，计算全部指标方案。蓝色：完整点阵；橙色：参考 9 点。所有坐标均为原图像素。'}"/>
        <TabControl Grid.Row="2">
            <TabItem Header="{display:DisplayText Key='畸变指标'}">
                <DataGrid x:Name="MetricsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                          SelectionUnit="CellOrRowHeader" ClipboardCopyMode="IncludeHeader" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{display:DisplayText Key='方案'}" Binding="{Binding Method}" Width="130"/>
                        <DataGridTextColumn Header="{display:DisplayText Key='指标'}" Binding="{Binding Name}" Width="170"/>
                        <DataGridTextColumn Header="{display:DisplayText Key='数值'}" Binding="{Binding Value}" Width="110"/>
                        <DataGridTextColumn Header="{display:DisplayText Key='单位'}" Binding="{Binding Unit}" Width="50"/>
                        <DataGridTextColumn Header="{display:DisplayText Key='定义'}" Binding="{Binding Description}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="{display:DisplayText Key='光学相对估计'}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="10"
                               Text="{display:DisplayText Key='用完整等间距平面点阵拟合透视参考和一阶径向畸变，假设光学中心位于中心点。径向偏差 = (实际半径 − 无径向畸变参考半径) / 参考半径 × 100%。此为模型估计，未经独立标定；不拟合偏心、切向或高阶畸变。'}"/>
                    <DataGrid x:Name="OpticalGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                              SelectionUnit="CellOrRowHeader" ClipboardCopyMode="IncludeHeader" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{display:DisplayText Key='点 ID'}" Binding="{Binding PointId}" Width="80"/>
                            <DataGridTextColumn Header="{display:DisplayText Key='实际半径 (px)'}" Binding="{Binding ActualRadiusPixels, StringFormat=F4}" Width="*"/>
                            <DataGridTextColumn Header="{display:DisplayText Key='参考半径 (px)'}" Binding="{Binding ReferenceRadiusPixels, StringFormat=F4}" Width="*"/>
                            <DataGridTextColumn Header="{display:DisplayText Key='径向偏差 (%)'}" Binding="{Binding RadialPercent, StringFormat=F6}" Width="*"/>
                            <DataGridTextColumn Header="{display:DisplayText Key='参考 X (px)'}" Binding="{Binding ReferencePosition.X, StringFormat=F4}" Width="*"/>
                            <DataGridTextColumn Header="{display:DisplayText Key='参考 Y (px)'}" Binding="{Binding ReferencePosition.Y, StringFormat=F4}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="{display:DisplayText Key='点阵坐标'}">
                <DataGrid x:Name="PointsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                          SelectionUnit="CellOrRowHeader" ClipboardCopyMode="IncludeHeader" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                        <DataGridTextColumn Header="{display:DisplayText Key='参考点'}" Binding="{Binding Reference}" Width="90"/>
                        <DataGridTextColumn Header="{display:DisplayText Key='行 (0起)'}" Binding="{Binding Row}" Width="85"/>
                        <DataGridTextColumn Header="{display:DisplayText Key='列 (0起)'}" Binding="{Binding Col}" Width="85"/>
                        <DataGridTextColumn Header="X (px)" Binding="{Binding X, StringFormat=F4}" Width="*"/>
                        <DataGridTextColumn Header="Y (px)" Binding="{Binding Y, StringFormat=F4}" Width="*"/>
                        <DataGridTextColumn Header="{display:DisplayText Key='面积 (px²)'}" Binding="{Binding Area, StringFormat=F2}" Width="*"/>
                        <DataGridTextColumn Header="{display:DisplayText Key='对比度'}" Binding="{Binding Contrast, StringFormat=F4}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="{display:DisplayText Key='质量与耗时'}">
                <TextBox x:Name="DiagnosticsText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" Padding="12"/>
            </TabItem>
            <TabItem Header="{display:DisplayText Key='原始 JSON'}">
                <TextBox x:Name="JsonText" IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas"
                         FontSize="12" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="8"/>
            </TabItem>
            <TabItem Header="{display:DisplayText Key='全部分析 JSON'}">
                <TextBox x:Name="AnalysisJsonText" IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas"
                         FontSize="12" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="8"/>
            </TabItem>
        </TabControl>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="{display:DisplayText Key='复制指标'}" Click="CopyMetrics_Click" Padding="16,6" Margin="0,0,10,0"/>
            <Button Content="{display:DisplayText Key='复制全部分析 JSON'}" Click="CopyAnalysisJson_Click" Padding="16,6" Margin="0,0,10,0"/>
            <Button Content="{display:DisplayText Key='复制原始 JSON'}" Click="CopyJson_Click" Padding="16,6"/>
        </StackPanel>
    </Grid>
</Window>
