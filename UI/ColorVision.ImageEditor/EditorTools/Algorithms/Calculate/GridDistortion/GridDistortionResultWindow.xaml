<Window x:Class="ColorVision.ImageEditor.EditorTools.Algorithms.Calculate.GridDistortion.GridDistortionResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="点阵畸变分析 (V2)" Width="1020" Height="730" MinWidth="760" MinHeight="500"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBox x:Name="SummaryText" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                 FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <TextBlock Grid.Row="1" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="一次定位，计算全部指标方案。蓝色：完整点阵；橙色：参考 9 点。所有坐标均为原图像素。"/>
        <TabControl Grid.Row="2">
            <TabItem Header="畸变指标">
                <DataGrid x:Name="MetricsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                          SelectionUnit="CellOrRowHeader" ClipboardCopyMode="IncludeHeader" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="方案" Binding="{Binding Method}" Width="130"/>
                        <DataGridTextColumn Header="指标" Binding="{Binding Name}" Width="170"/>
                        <DataGridTextColumn Header="数值" Binding="{Binding Value}" Width="110"/>
                        <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="50"/>
                        <DataGridTextColumn Header="定义" Binding="{Binding Description}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="光学相对估计">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="10"
                               Text="中央节距相对估计，非已标定镜头畸变。以中心点及相邻四点建立参考；径向偏差 = (实际半径 − 参考半径) / 参考半径 × 100%。透视和光轴偏心未单独分离。"/>
                    <DataGrid x:Name="OpticalGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                              SelectionUnit="CellOrRowHeader" ClipboardCopyMode="IncludeHeader" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="点 ID" Binding="{Binding PointId}" Width="80"/>
                            <DataGridTextColumn Header="实际半径 (px)" Binding="{Binding ActualRadiusPixels, StringFormat=F4}" Width="*"/>
                            <DataGridTextColumn Header="参考半径 (px)" Binding="{Binding ReferenceRadiusPixels, StringFormat=F4}" Width="*"/>
                            <DataGridTextColumn Header="径向偏差 (%)" Binding="{Binding RadialPercent, StringFormat=F6}" Width="*"/>
                            <DataGridTextColumn Header="参考 X (px)" Binding="{Binding ReferencePosition.X, StringFormat=F4}" Width="*"/>
                            <DataGridTextColumn Header="参考 Y (px)" Binding="{Binding ReferencePosition.Y, StringFormat=F4}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="点阵坐标">
                <DataGrid x:Name="PointsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                          SelectionUnit="CellOrRowHeader" ClipboardCopyMode="IncludeHeader" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                        <DataGridTextColumn Header="参考点" Binding="{Binding Reference}" Width="90"/>
                        <DataGridTextColumn Header="行 (0起)" Binding="{Binding Row}" Width="85"/>
                        <DataGridTextColumn Header="列 (0起)" Binding="{Binding Col}" Width="85"/>
                        <DataGridTextColumn Header="X (px)" Binding="{Binding X, StringFormat=F4}" Width="*"/>
                        <DataGridTextColumn Header="Y (px)" Binding="{Binding Y, StringFormat=F4}" Width="*"/>
                        <DataGridTextColumn Header="面积 (px²)" Binding="{Binding Area, StringFormat=F2}" Width="*"/>
                        <DataGridTextColumn Header="对比度" Binding="{Binding Contrast, StringFormat=F4}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="质量与耗时">
                <TextBox x:Name="DiagnosticsText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" Padding="12"/>
            </TabItem>
            <TabItem Header="原始 JSON">
                <TextBox x:Name="JsonText" IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas"
                         FontSize="12" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="8"/>
            </TabItem>
            <TabItem Header="全部分析 JSON">
                <TextBox x:Name="AnalysisJsonText" IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas"
                         FontSize="12" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="8"/>
            </TabItem>
        </TabControl>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="复制指标" Click="CopyMetrics_Click" Padding="16,6" Margin="0,0,10,0"/>
            <Button Content="复制全部分析 JSON" Click="CopyAnalysisJson_Click" Padding="16,6" Margin="0,0,10,0"/>
            <Button Content="复制原始 JSON" Click="CopyJson_Click" Padding="16,6"/>
        </StackPanel>
    </Grid>
</Window>
