<Window x:Class="ColorVision.ImageEditor.BatchProcessing.BatchImageProcessingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:properties="clr-namespace:ColorVision.ImageEditor.Properties"
        Title="{x:Static properties:Resources.BatchTitle}" Height="720" Width="980" MinHeight="600" MinWidth="820"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource GlobalBackground}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid x:Name="SettingsPanel" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="{x:Static properties:Resources.BatchAlgorithm}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ComboBox x:Name="AlgorithmComboBox" DisplayMemberPath="DisplayName" SelectionChanged="AlgorithmComboBox_SelectionChanged"/>
                    <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="8" MinHeight="82">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ContentControl x:Name="AlgorithmOptionsContent"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="{x:Static properties:Resources.BatchOutput}" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="{x:Static properties:Resources.BatchOutputFormat}"/>
                    <ComboBox x:Name="OutputFormatComboBox" Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="3" DisplayMemberPath="Name" SelectedValuePath="Value"/>

                    <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="{x:Static properties:Resources.BatchFilenameSuffix}"/>
                    <TextBox x:Name="SuffixTextBox" Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="3"/>

                    <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="{x:Static properties:Resources.BatchOutputDirectory}"/>
                    <TextBox x:Name="OutputDirectoryTextBox" Grid.Row="4" Grid.Column="2" ToolTip="{x:Static properties:Resources.BatchOutputDirectoryHint}"/>
                    <Button Grid.Row="4" Grid.Column="4" Content="{x:Static properties:Resources.BatchBrowse}" Padding="12,3" Click="BrowseOutputDirectory_Click"/>

                    <StackPanel Grid.Row="6" Grid.Column="2" Grid.ColumnSpan="3">
                        <CheckBox x:Name="PreserveFolderStructureCheckBox" IsChecked="True"><CheckBox.Content><TextBlock Text="{x:Static properties:Resources.BatchPreserveFolders}" TextWrapping="Wrap"/></CheckBox.Content></CheckBox>
                        <CheckBox x:Name="AvoidOverwriteCheckBox" IsChecked="True" Margin="0,6,0,0"><CheckBox.Content><TextBlock Text="{x:Static properties:Resources.BatchAvoidOverwrite}" TextWrapping="Wrap"/></CheckBox.Content></CheckBox>
                    </StackPanel>
                </Grid>
            </GroupBox>
        </Grid>

        <GroupBox Grid.Row="2" Header="{x:Static properties:Resources.BatchInputImages}" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <WrapPanel>
                    <Button x:Name="AddFilesButton" Content="{x:Static properties:Resources.BatchAddFiles}" Padding="14,4" Margin="0,0,8,0" Click="AddFiles_Click"/>
                    <Button x:Name="AddFolderButton" Content="{x:Static properties:Resources.BatchAddFolder}" Padding="14,4" Margin="0,0,8,0" Click="AddFolder_Click"/>
                    <Button x:Name="RemoveButton" Content="{x:Static properties:Resources.BatchRemoveSelected}" Padding="14,4" Margin="0,0,8,0" Click="RemoveSelected_Click"/>
                    <Button x:Name="ClearButton" Content="{x:Static properties:Resources.BatchClear}" Padding="14,4" Click="Clear_Click"/>
                    <CheckBox x:Name="RecursiveCheckBox" Content="{x:Static properties:Resources.BatchIncludeSubfolders}" IsChecked="True" Margin="20,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="FileCountTextBlock" Margin="20,0,0,0" VerticalAlignment="Center"/>
                </WrapPanel>

                <DataGrid x:Name="FilesDataGrid" Grid.Row="2" ItemsSource="{Binding Files}" AutoGenerateColumns="False"
                          IsReadOnly="True" SelectionMode="Extended" CanUserAddRows="False" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{x:Static properties:Resources.BatchFilename}" Binding="{Binding FileName}" Width="180"/>
                        <DataGridTextColumn Header="{x:Static properties:Resources.BatchSourceFile}" Binding="{Binding FilePath}" Width="2*" MinWidth="140"/>
                        <DataGridTextColumn Header="{x:Static properties:Resources.BatchStatus}" Binding="{Binding Status}" Width="150"/>
                        <DataGridTextColumn Header="{x:Static properties:Resources.BatchOutputFile}" Binding="{Binding OutputPath}" Width="2*" MinWidth="140"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ProgressBar x:Name="ProgressBar" Height="18" Minimum="0"/>
            <TextBlock x:Name="ProgressTextBlock" Grid.Column="2" MinWidth="110" TextAlignment="Right" VerticalAlignment="Center" Text="{x:Static properties:Resources.BatchNotStarted}"/>
        </Grid>

        <DockPanel Grid.Row="6">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="{x:Static properties:Resources.BatchCancel}" MinWidth="90" Padding="14,4" Margin="12,0,8,0" IsEnabled="False" Click="Cancel_Click"/>
                <Button x:Name="ExecuteButton" Content="{x:Static properties:Resources.BatchStart}" MinWidth="100" Padding="14,4" Click="Execute_Click"/>
            </StackPanel>
            <TextBlock Text="{x:Static properties:Resources.BatchOutputHint}"
                       VerticalAlignment="Center" Opacity="0.75" TextWrapping="Wrap"/>
        </DockPanel>
    </Grid>
</Window>
