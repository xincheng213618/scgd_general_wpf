<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:properties="clr-namespace:ColorVision.ImageEditor.Properties">
    <BooleanToVisibilityConverter x:Key="CieBoolVisibility" />
    <Style x:Key="CieFloatingCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource GlobalBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="Effect">
            <Setter.Value><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.12" /></Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CieActionBase" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="MinWidth" Value="30" />
        <Setter Property="Padding" Value="9,4" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#180078D4" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#300078D4" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Background" Value="#200078D4" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CieAction" TargetType="Button" BasedOn="{StaticResource CieActionBase}" />
    <Geometry x:Key="CieZoomOutIcon">M 11.5,7 A 4.5,4.5 0 1 1 2.5,7 A 4.5,4.5 0 1 1 11.5,7 M 10.3,10.3 L 14.5,14.5 M 4.5,7 H 9.5</Geometry>
    <Geometry x:Key="CieZoomInIcon">M 11.5,7 A 4.5,4.5 0 1 1 2.5,7 A 4.5,4.5 0 1 1 11.5,7 M 10.3,10.3 L 14.5,14.5 M 4.5,7 H 9.5 M 7,4.5 V 9.5</Geometry>
    <Geometry x:Key="CieFitIcon">M 1.5,5.5 V 1.5 H 5.5 M 10.5,1.5 H 14.5 V 5.5 M 14.5,10.5 V 14.5 H 10.5 M 5.5,14.5 H 1.5 V 10.5 M 5,5 H 11 V 11 H 5 Z</Geometry>
    <Style x:Key="CieIconButton" TargetType="Button" BasedOn="{StaticResource CieAction}">
        <Setter Property="Width" Value="34" /><Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="7" /><Setter Property="Margin" Value="2,0" />
        <Setter Property="ContentTemplate">
            <Setter.Value><DataTemplate>
                <Viewbox Width="18" Height="18"><Canvas Width="16" Height="16">
                    <Path Data="{Binding}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Canvas></Viewbox>
            </DataTemplate></Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CieZoomOutButton" TargetType="Button" BasedOn="{StaticResource CieIconButton}">
        <Setter Property="Content" Value="{StaticResource CieZoomOutIcon}" />
        <Setter Property="ToolTip" Value="{x:Static properties:Resources.ZoomOut}" />
        <Setter Property="AutomationProperties.Name" Value="{x:Static properties:Resources.ZoomOut}" />
    </Style>
    <Style x:Key="CieZoomInButton" TargetType="Button" BasedOn="{StaticResource CieIconButton}">
        <Setter Property="Content" Value="{StaticResource CieZoomInIcon}" />
        <Setter Property="ToolTip" Value="{x:Static properties:Resources.ZoomIn}" />
        <Setter Property="AutomationProperties.Name" Value="{x:Static properties:Resources.ZoomIn}" />
    </Style>
    <Style x:Key="CieFitButton" TargetType="Button" BasedOn="{StaticResource CieIconButton}">
        <Setter Property="Content" Value="{StaticResource CieFitIcon}" />
        <Setter Property="ToolTip" Value="{x:Static properties:Resources.Cie_Fit}" />
        <Setter Property="AutomationProperties.Name" Value="{x:Static properties:Resources.Cie_Fit}" />
    </Style>
    <Style x:Key="CieToggle" TargetType="ToggleButton" BasedOn="{StaticResource CieActionBase}">
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="#200078D4" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="CieSection" TargetType="GroupBox">
        <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}" />
        <Setter Property="Margin" Value="0,0,0,14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <StackPanel>
                        <ContentPresenter ContentSource="Header" Margin="0,0,0,7" TextElement.FontWeight="SemiBold" />
                        <ContentPresenter />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CieWorkspaceTabs" TargetType="TabControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                        <Border x:Name="CieTabHeader" Style="{StaticResource CieFloatingCard}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Panel.ZIndex="20">
                            <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="TabItem">
                    <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Padding" Value="12,7" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter x:Name="HeaderPresenter" ContentSource="Header" RecognizesAccessKey="True" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#200078D4" />
                                        <Setter TargetName="HeaderPresenter" Property="TextElement.FontWeight" Value="SemiBold" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#180078D4" /></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
