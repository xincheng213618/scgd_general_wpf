<Window x:Class="ColorVision.ImageEditor.WindowCIE"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cie="clr-namespace:ColorVision.ImageEditor.Cie"
        xmlns:properties="clr-namespace:ColorVision.ImageEditor.Properties"
        Title="{x:Static properties:Resources.Cie_Title}"
        Width="860" Height="680" MinWidth="720" MinHeight="520"
        Background="{Binding Background, ElementName=CieView}" UseLayoutRounding="True"
        Icon="/ColorVision.ImageEditor;component/Assets/Image/CIE1931xy.ico"
        Initialized="Window_Initialized">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CieWorkspaceStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="PanelGroupBox" TargetType="GroupBox" BasedOn="{StaticResource CieSection}" />
            <Style x:Key="OptionCheckBox" TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}" />
                <Setter Property="Margin" Value="0,3,8,3" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style x:Key="PanelButton" TargetType="Button" BasedOn="{StaticResource CieAction}">
                <Setter Property="Margin" Value="0,0,4,4" />
                <Setter Property="Background" Value="#100078D4" />
            </Style>
            <Style x:Key="ReadoutText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Margin" Value="0,2" />
                <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <TabControl x:Name="CieTabs" SelectionChanged="CieTabs_SelectionChanged" Style="{StaticResource CieWorkspaceTabs}">
        <TabItem Header="{x:Static properties:Resources.Cie_Chromaticity}">
            <Grid Background="{Binding Background, ElementName=CieView}" ClipToBounds="True">
                <cie:CieDiagramView x:Name="CieView">
                    <cie:CieDiagramView.Style>
                        <Style TargetType="cie:CieDiagramView">
                            <Setter Property="Margin" Value="8,58,8,58" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=ShowDisplayOptions}" Value="True">
                                    <Setter Property="Margin" Value="8,58,306,58" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </cie:CieDiagramView.Style>
                </cie:CieDiagramView>
                <Border x:Name="DiagramToolbar" Style="{StaticResource CieFloatingCard}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Panel.ZIndex="10">
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="ComboBoxDiagram" Width="144" MinHeight="30" Margin="0,0,4,0"
                                  ToolTip="{x:Static properties:Resources.Cie_CoordinateSystem}"
                                  SelectedIndex="0" SelectionChanged="ComboBoxDiagram_SelectionChanged">
                            <ComboBoxItem Content="CIE 1931 xy" />
                            <ComboBoxItem Content="CIE 1960 uv" />
                            <ComboBoxItem Content="CIE 1976 u′v′" />
                        </ComboBox>
                        <ComboBox x:Name="ReferenceWhitePreset" Width="82" MinHeight="30" Margin="0,0,4,0"
                                  DisplayMemberPath="Name" ToolTip="计算参考白（默认 D65）" AutomationProperties.Name="计算参考白"
                                  SelectionChanged="ReferenceWhitePreset_Changed" />
                        <Button Style="{StaticResource CieZoomOutButton}" Click="ButtonZoomOut_Click" />
                        <Button Style="{StaticResource CieZoomInButton}" Click="ButtonZoomIn_Click" />
                        <Button Style="{StaticResource CieFitButton}" Click="ButtonFit_Click" />
                        <ToggleButton x:Name="ShowDisplayOptions" Content="{x:Static properties:Resources.Cie_DisplayOptions}" Style="{StaticResource CieToggle}" />
                    </StackPanel>
                </Border>
                <Grid Margin="0,64,12,48" HorizontalAlignment="Right" Width="280"
                      Visibility="{Binding IsChecked, ElementName=ShowDisplayOptions, Converter={StaticResource CieBoolVisibility}}">
                    <Border x:Name="DisplayOptionsPanel" Style="{StaticResource CieFloatingCard}" Padding="14">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <GroupBox Header="计算参考白" Style="{StaticResource PanelGroupBox}">
                                    <StackPanel>
                                        <UniformGrid Columns="2">
                                            <StackPanel Margin="0,0,4,0"><TextBlock Text="白点 x" /><TextBox x:Name="ReferenceWhiteX" MinHeight="28" AutomationProperties.Name="计算参考白 x" /></StackPanel>
                                            <StackPanel><TextBlock Text="白点 y" /><TextBox x:Name="ReferenceWhiteY" MinHeight="28" AutomationProperties.Name="计算参考白 y" /></StackPanel>
                                        </UniformGrid>
                                        <TextBlock Text="参考白亮度 Yn（cd/m²）" Margin="0,6,0,2" />
                                        <TextBox x:Name="ReferenceWhiteLuminance" MinHeight="28" AutomationProperties.Name="计算参考白亮度" />
                                        <Button x:Name="ApplyReferenceWhite" Content="应用参考白" Style="{StaticResource PanelButton}" HorizontalAlignment="Left" Margin="0,6,0,4" Click="ApplyReferenceWhite_Click" />
                                        <TextBlock x:Name="ReferenceWhiteStatus" TextWrapping="Wrap" FontSize="11" Opacity="0.7" />
                                        <TextBlock Text="仅用于本窗口。相对样品参考白 Y=100；下方白点勾选只控制图层显示。" TextWrapping="Wrap" FontSize="11" Opacity="0.7" Margin="0,4,0,0" />
                                    </StackPanel>
                                </GroupBox>
                                <GroupBox Header="{x:Static properties:Resources.Cie_DisplayPresets}" Style="{StaticResource PanelGroupBox}">
                                    <UniformGrid Columns="2">
                                        <Button Content="{x:Static properties:Resources.Cie_Display}"
                                                Click="PresetButton_Click"
                                                Style="{StaticResource PanelButton}"
                                                Tag="Display" />
                                        <Button Content="{x:Static properties:Resources.Cie_Cinema}"
                                                Click="PresetButton_Click"
                                                Style="{StaticResource PanelButton}"
                                                Tag="Cinema" />
                                        <Button Content="{x:Static properties:Resources.Cie_SelectAll}"
                                                Click="PresetButton_Click"
                                                Style="{StaticResource PanelButton}"
                                                Tag="All" />
                                        <Button Content="{x:Static properties:Resources.Cie_Clear}"
                                                Click="PresetButton_Click"
                                                Style="{StaticResource PanelButton}"
                                                Tag="Clear" />
                                    </UniformGrid>
                                </GroupBox>
                                <GroupBox Header="{x:Static properties:Resources.Cie_ColorGamut}" Style="{StaticResource PanelGroupBox}">
                                    <UniformGrid Columns="2">
                                        <CheckBox x:Name="CheckBoxSRgb"
                                                  Content="sRGB"
                                                  IsChecked="True"
                                                  Style="{StaticResource OptionCheckBox}"
                                                  Checked="GamutCheckBox_Changed"
                                                  Unchecked="GamutCheckBox_Changed" />
                                        <CheckBox x:Name="CheckBoxRec709"
                                                  Content="BT.709"
                                                  Style="{StaticResource OptionCheckBox}"
                                                  Checked="GamutCheckBox_Changed"
                                                  Unchecked="GamutCheckBox_Changed" />
                                        <CheckBox x:Name="CheckBoxAdobeRgb"
                                                  Content="Adobe RGB"
                                                  Style="{StaticResource OptionCheckBox}"
                                                  Checked="GamutCheckBox_Changed"
                                                  Unchecked="GamutCheckBox_Changed" />
                                        <CheckBox x:Name="CheckBoxDisplayP3"
                                                  Content="Display P3"
                                                  Style="{StaticResource OptionCheckBox}"
                                                  Checked="GamutCheckBox_Changed"
                                                  Unchecked="GamutCheckBox_Changed" />
                                        <CheckBox x:Name="CheckBoxNtsc"
                                                  Content="NTSC 1953"
                                                  Style="{StaticResource OptionCheckBox}"
                                                  Checked="GamutCheckBox_Changed"
                                                  Unchecked="GamutCheckBox_Changed" />
                                        <CheckBox x:Name="CheckBoxDciP3"
                                                  Content="DCI-P3"
                                                  Style="{StaticResource OptionCheckBox}"
                                                  Checked="GamutCheckBox_Changed"
                                                  Unchecked="GamutCheckBox_Changed" />
                                        <CheckBox x:Name="CheckBoxRec2020"
                                                  Content="BT.2020"
                                                  Style="{StaticResource OptionCheckBox}"
                                                  Checked="GamutCheckBox_Changed"
                                                  Unchecked="GamutCheckBox_Changed" />
                                        <CheckBox x:Name="CheckBoxPal"
                                                  Content="EBU/PAL"
                                                  Style="{StaticResource OptionCheckBox}"
                                                  Checked="GamutCheckBox_Changed"
                                                  Unchecked="GamutCheckBox_Changed" />
                                        <CheckBox x:Name="CheckBoxSmpteC"
                                                  Content="SMPTE-C"
                                                  Style="{StaticResource OptionCheckBox}"
                                                  Checked="GamutCheckBox_Changed"
                                                  Unchecked="GamutCheckBox_Changed" />
                                        <CheckBox x:Name="CheckBoxProPhoto"
                                                  Content="ProPhoto"
                                                  Style="{StaticResource OptionCheckBox}"
                                                  Checked="GamutCheckBox_Changed"
                                                  Unchecked="GamutCheckBox_Changed" />
                                        <CheckBox x:Name="CheckBoxAcesCg"
                                                  Content="ACEScg"
                                                  Style="{StaticResource OptionCheckBox}"
                                                  Checked="GamutCheckBox_Changed"
                                                  Unchecked="GamutCheckBox_Changed" />
                                    </UniformGrid>
                                </GroupBox>
                                <GroupBox Header="{x:Static properties:Resources.Cie_WhitePointLightSource}" Style="{StaticResource PanelGroupBox}">
                                    <UniformGrid Columns="2">
                                        <CheckBox x:Name="CheckBoxD65"
                                                  Content="D65"
                                                  IsChecked="True"
                                                  Style="{StaticResource OptionCheckBox}"
                                                  Checked="IlluminantCheckBox_Changed"
                                                  Unchecked="IlluminantCheckBox_Changed" />
                                        <CheckBox x:Name="CheckBoxE"
                                                  Content="E"
                                                  Style="{StaticResource OptionCheckBox}"
                                                  Checked="IlluminantCheckBox_Changed"
                                                  Unchecked="IlluminantCheckBox_Changed" />
                                        <CheckBox x:Name="CheckBoxD50"
                                                  Content="D50"
                                                  IsChecked="False"
                                                  Style="{StaticResource OptionCheckBox}"
                                                  Checked="IlluminantCheckBox_Changed"
                                                  Unchecked="IlluminantCheckBox_Changed" />
                                        <CheckBox x:Name="CheckBoxD55"
                                                  Content="D55"
                                                  Style="{StaticResource OptionCheckBox}"
                                                  Checked="IlluminantCheckBox_Changed"
                                                  Unchecked="IlluminantCheckBox_Changed" />
                                        <CheckBox x:Name="CheckBoxD60"
                                                  Content="D60"
                                                  Style="{StaticResource OptionCheckBox}"
                                                  Checked="IlluminantCheckBox_Changed"
                                                  Unchecked="IlluminantCheckBox_Changed" />
                                        <CheckBox x:Name="CheckBoxC"
                                                  Content="C"
                                                  Style="{StaticResource OptionCheckBox}"
                                                  Checked="IlluminantCheckBox_Changed"
                                                  Unchecked="IlluminantCheckBox_Changed" />
                                        <CheckBox x:Name="CheckBoxA"
                                                  Content="A"
                                                  IsChecked="False"
                                                  Style="{StaticResource OptionCheckBox}"
                                                  Checked="IlluminantCheckBox_Changed"
                                                  Unchecked="IlluminantCheckBox_Changed" />
                                        <CheckBox x:Name="CheckBoxD75"
                                                  Content="D75"
                                                  IsChecked="False"
                                                  Style="{StaticResource OptionCheckBox}"
                                                  Checked="IlluminantCheckBox_Changed"
                                                  Unchecked="IlluminantCheckBox_Changed" />
                                    </UniformGrid>
                                </GroupBox>
                                <GroupBox Header="{x:Static properties:Resources.Cie_ReferenceLines}" Style="{StaticResource PanelGroupBox}">
                                    <StackPanel>
                                        <CheckBox x:Name="CheckBoxCct"
                                                  Content="Tc(K)"
                                                  IsChecked="False"
                                                  Style="{StaticResource OptionCheckBox}"
                                                  Checked="CctCheckBox_Changed"
                                                  Unchecked="CctCheckBox_Changed" />
                                        <CheckBox x:Name="CheckBoxDaylight"
                                                  Content="D locus"
                                                  IsChecked="False"
                                                  Style="{StaticResource OptionCheckBox}"
                                                  Checked="DaylightCheckBox_Changed"
                                                  Unchecked="DaylightCheckBox_Changed" />
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
                <Border Style="{StaticResource CieFloatingCard}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,12,12,62" Padding="8,5" MaxWidth="430">
                    <Expander x:Name="SelectedPointDetails">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{x:Static properties:Resources.Cie_CurrentPoint}" Margin="0,0,8,0" />
                                <TextBlock x:Name="TextBlockSelectedXy" Style="{StaticResource ReadoutText}" Text="xy: --" />
                            </StackPanel>
                        </Expander.Header>
                        <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="24,5,8,0">
                            <TextBlock x:Name="TextBlockSelectedUv1960" Style="{StaticResource ReadoutText}" Text="uv: --" />
                            <TextBlock x:Name="TextBlockSelectedUv1976" Style="{StaticResource ReadoutText}" Text="CIE 1976 u′v′: --" />
                            <TextBlock x:Name="TextBlockSelectedCct" Style="{StaticResource ReadoutText}" Text="CCT: --" />
                            <TextBlock x:Name="TextBlockSelectedWavelength" Style="{StaticResource ReadoutText}" Text="主 / 补波长: --" />
                            <TextBlock x:Name="TextBlockSelectedPurity" Style="{StaticResource ReadoutText}" Text="激发纯度: --" />
                            <TextBlock x:Name="TextBlockSelectedWhiteDistance" Style="{StaticResource ReadoutText}" Text="距 D65 Δu′v′: --" />
                            <StackPanel x:Name="SelectedColorValues" Visibility="Collapsed" Margin="0,6,0,0">
                                <TextBlock x:Name="TextBlockSelectedXyz" Style="{StaticResource ReadoutText}" TextWrapping="Wrap" />
                                <TextBlock x:Name="TextBlockSelectedLab" Style="{StaticResource ReadoutText}" TextWrapping="Wrap" />
                                <TextBlock x:Name="TextBlockSelectedLuv" Style="{StaticResource ReadoutText}" TextWrapping="Wrap" />
                                <TextBlock x:Name="TextBlockSelectedChroma" Style="{StaticResource ReadoutText}" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock x:Name="TextBlockSelectedConditions" FontSize="11" Opacity="0.7" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource GlobalTextBrush}" />
                        </StackPanel>
                        </ScrollViewer>
                    </Expander>
                </Border>
                <TextBlock x:Name="TextBlockCursor" HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                           Margin="12,0,14,10" FontFamily="Consolas" FontSize="11" TextAlignment="Right" TextWrapping="Wrap"
                           Foreground="{DynamicResource GlobalTextBrush}"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
            </Grid>
        </TabItem>
        <TabItem Header="{x:Static properties:Resources.Cie_GamutCalculation}">
            <cie:ManualColorGamutView x:Name="GamutView" />
        </TabItem>
        <TabItem x:Name="SampleAnalysisTab" Header="样品与色差">
            <cie:CieSampleAnalysisView x:Name="SampleAnalysis" />
        </TabItem>
    </TabControl>
</Window>
