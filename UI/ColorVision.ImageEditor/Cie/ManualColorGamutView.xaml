<UserControl x:Class="ColorVision.ImageEditor.Cie.ManualColorGamutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cie="clr-namespace:ColorVision.ImageEditor.Cie"
             xmlns:properties="clr-namespace:ColorVision.ImageEditor.Properties"
             Background="White" Initialized="View_Initialized">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CieWorkspaceStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="PanelGroupBox" TargetType="GroupBox" BasedOn="{StaticResource CieSection}" />
            <Style x:Key="LabelText" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}" />
            </Style>
            <Style x:Key="ValueText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}" />
                <Setter Property="Margin" Value="0,0,16,0" />
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="Margin" Value="3" />
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
            </Style>
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}" />
                <Setter Property="Margin" Value="0,3" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style TargetType="Button" BasedOn="{StaticResource CieAction}">
                <Setter Property="Margin" Value="0,0,4,0" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Background="White" ClipToBounds="True">
            <cie:CieDiagramView x:Name="CieDiagram">
                <cie:CieDiagramView.Style>
                    <Style TargetType="cie:CieDiagramView">
                        <Setter Property="Margin" Value="8,58,8,8" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=ShowParameters}" Value="True">
                                <Setter Property="Margin" Value="8,58,318,8" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </cie:CieDiagramView.Style>
            </cie:CieDiagramView>
            <Border Style="{StaticResource CieFloatingCard}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12">
                <StackPanel Orientation="Horizontal">
                    <Button Content="−" Click="ButtonZoomOut_Click" ToolTip="{x:Static properties:Resources.ZoomOut}" AutomationProperties.Name="{x:Static properties:Resources.ZoomOut}" />
                    <Button Content="+" Click="ButtonZoomIn_Click" ToolTip="{x:Static properties:Resources.ZoomIn}" AutomationProperties.Name="{x:Static properties:Resources.ZoomIn}" />
                    <Button Content="{x:Static properties:Resources.Cie_Fit}" Click="ButtonFit_Click" />
                    <ToggleButton x:Name="ShowParameters" Content="{x:Static properties:Resources.Cie_Parameters}" IsChecked="True" Style="{StaticResource CieToggle}" />
                </StackPanel>
            </Border>
            <Grid Margin="0,64,12,8" HorizontalAlignment="Right" Width="292"
                  Visibility="{Binding IsChecked, ElementName=ShowParameters, Converter={StaticResource CieBoolVisibility}}">
                <Border x:Name="ParameterPanel" Style="{StaticResource CieFloatingCard}" Padding="14">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <GroupBox Header="RGB CIE 1931 xy 坐标" Style="{StaticResource PanelGroupBox}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="54" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="x" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="y" HorizontalAlignment="Center" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="R" Style="{StaticResource LabelText}" />
                                    <TextBox x:Name="TextBoxRedX" Grid.Row="1" Grid.Column="1" TextChanged="CoordinateTextBox_TextChanged" />
                                    <TextBox x:Name="TextBoxRedY" Grid.Row="1" Grid.Column="2" TextChanged="CoordinateTextBox_TextChanged" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="G" Style="{StaticResource LabelText}" />
                                    <TextBox x:Name="TextBoxGreenX" Grid.Row="2" Grid.Column="1" TextChanged="CoordinateTextBox_TextChanged" />
                                    <TextBox x:Name="TextBoxGreenY" Grid.Row="2" Grid.Column="2" TextChanged="CoordinateTextBox_TextChanged" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="B" Style="{StaticResource LabelText}" />
                                    <TextBox x:Name="TextBoxBlueX" Grid.Row="3" Grid.Column="1" TextChanged="CoordinateTextBox_TextChanged" />
                                    <TextBox x:Name="TextBoxBlueY" Grid.Row="3" Grid.Column="2" TextChanged="CoordinateTextBox_TextChanged" />
                                </Grid>
                            </GroupBox>
                            <WrapPanel Margin="0,0,0,10">
                                <Button Content="套用标准值" Click="ButtonApplyStandard_Click" />
                                <Button Content="计算" Click="ButtonCalculate_Click" />
                                <Button x:Name="ButtonExport" Content="导出" Click="ButtonExport_Click" IsEnabled="False" />
                            </WrapPanel>
                            <TextBlock x:Name="TextBlockStatus" TextWrapping="Wrap" Margin="0,0,0,10" FontSize="12" Foreground="Gray" />
                            <GroupBox Header="标准色域" Style="{StaticResource PanelGroupBox}">
                                <StackPanel>
                                    <ListBox x:Name="ListBoxStandards"
                                             MinHeight="0"
                                             MaxHeight="190"
                                             BorderBrush="{DynamicResource BorderBrush}"
                                             SelectionChanged="ListBoxStandards_SelectionChanged">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Standard.Name}"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Checked="StandardCheckBox_Changed"
                                                          Unchecked="StandardCheckBox_Changed" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="全选" Click="ButtonSelectAll_Click" />
                                        <Button Content="清空" Click="ButtonClearSelection_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource CieFloatingCard}" Margin="12,0,12,12" Padding="8">
            <Expander x:Name="ResultsExpander" IsExpanded="True">
                <Expander.Header>
                    <WrapPanel>
                        <TextBlock Text="{x:Static properties:Resources.Cie_Results}" FontWeight="SemiBold" Margin="0,0,12,0" />
                        <TextBlock Text="数量" Style="{StaticResource LabelText}" />
                        <TextBlock x:Name="TextBlockResultCount" Style="{StaticResource ValueText}" />
                        <TextBlock Text="样品面积" Style="{StaticResource LabelText}" />
                        <TextBlock x:Name="TextBlockSampleArea" Style="{StaticResource ValueText}" />
                        <TextBlock Text="面积比" Style="{StaticResource LabelText}" />
                        <TextBlock x:Name="TextBlockCoverageRange" Style="{StaticResource ValueText}" FontWeight="SemiBold" />
                    </WrapPanel>
                </Expander.Header>
                <DataGrid x:Name="ResultGrid" Margin="0,8,0,0" MaxHeight="170" MinHeight="64"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          HeadersVisibility="Column" RowHeaderWidth="0" RowHeight="28"
                          SelectionMode="Single" BorderThickness="0" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="标准色域" Binding="{Binding StandardName}" Width="*" MinWidth="100" />
                        <DataGridTextColumn Header="面积比(%)" Binding="{Binding CoverageDisplay}" Width="130" />
                        <DataGridTextColumn Header="样品面积" Binding="{Binding SampleAreaDisplay}" Width="130" />
                        <DataGridTextColumn Header="标准面积" Binding="{Binding StandardAreaDisplay}" Width="130" />
                    </DataGrid.Columns>
                </DataGrid>
            </Expander>
        </Border>
    </Grid>
</UserControl>
