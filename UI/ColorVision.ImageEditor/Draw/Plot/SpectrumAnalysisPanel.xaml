<UserControl x:Class="ColorVision.ImageEditor.Draw.SpectrumAnalysisPanel"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ColorVision.ImageEditor.Draw"
             xmlns:display="clr-namespace:ColorVision.ImageEditor"
             Focusable="False">
    <StackPanel Background="{DynamicResource GlobalBackground}">
        <Border Padding="4,2" BorderBrush="{DynamicResource ButtonBorderBrush}" BorderThickness="0,0,0,1">
            <ItemsControl x:Name="SummaryMetrics">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel MinWidth="105" Margin="8,3,10,3" ToolTip="{Binding Explanation}">
                            <TextBlock Text="{Binding Label}" FontSize="11" Opacity="0.7" Foreground="{DynamicResource GlobalTextBrush}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Value}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource GlobalTextBrush}"/>
                                <TextBlock Text="{Binding Unit}" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Bottom" Opacity="0.7" Foreground="{DynamicResource GlobalTextBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
        <Expander x:Name="RenderingExpander" Header="{display:DisplayText Key=显色性 R1～R15}" IsExpanded="False" Margin="8,2" HorizontalContentAlignment="Stretch">
            <StackPanel>
                <TextBlock x:Name="RenderingUnavailable" Text="{Binding Value.RenderingStatus, ElementName=Root}" TextWrapping="Wrap" Margin="6,8" Foreground="{DynamicResource GlobalTextBrush}"/>
                <local:SpectrumRenderingChart x:Name="RenderingChart" Height="185" Values="{Binding Value.RenderingIndices, ElementName=Root}" Foreground="{DynamicResource GlobalTextBrush}"/>
                <TextBlock Text="{display:DisplayText Key='Ra 为 R1～R8 的平均值；R9 单独强调，负指数保留。'}" FontSize="11" Opacity="0.65" TextWrapping="Wrap" Margin="6,0,6,4" Foreground="{DynamicResource GlobalTextBrush}"/>
            </StackPanel>
        </Expander>
    </StackPanel>
</UserControl>
