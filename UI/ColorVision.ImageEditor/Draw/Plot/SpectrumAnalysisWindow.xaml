<Window x:Class="ColorVision.ImageEditor.Draw.SpectrumAnalysisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ColorVision.ImageEditor.Draw"
        xmlns:display="clr-namespace:ColorVision.ImageEditor"
        xmlns:plot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Width="1120" Height="860" MinWidth="760" MinHeight="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource GlobalBackground}" Foreground="{DynamicResource GlobalTextBrush}">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Margin="6,2,6,12">
            <TextBlock Text="{display:DisplayText Key=光谱分析}" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock x:Name="RecordDescription" Margin="0,5,0,0" Opacity="0.7" TextWrapping="Wrap"/>
        </StackPanel>
        <Border DockPanel.Dock="Bottom" Margin="0,10,0,0" BorderBrush="{DynamicResource ButtonBorderBrush}" BorderThickness="1" CornerRadius="6">
            <ScrollViewer MaxHeight="355" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <local:SpectrumAnalysisPanel x:Name="Analysis" Margin="4"/>
            </ScrollViewer>
        </Border>
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,4,6">
                <ToggleButton x:Name="AbsoluteToggle" Click="SpectrumType_Click" Padding="10,4" Content="{display:DisplayText Key=绝对光谱}"/>
            </StackPanel>
            <Grid>
                <plot:WpfPlot x:Name="SpectrumPlot"/>
                <TextBlock x:Name="NoSpectrum" Visibility="Collapsed" Text="{display:DisplayText Key=无有效光谱数据}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7"/>
            </Grid>
        </DockPanel>
    </DockPanel>
</Window>
