<UserControl x:Class="ColorVision.UI.Desktop.LanRemote.LanRemoteControlSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ColorVision.UI.Desktop.LanRemote"
             SizeChanged="Control_SizeChanged">
    <UserControl.Resources>
        <local:LanRemoteItemTextConverter x:Key="ItemText"/>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}"/>
            <Setter Property="Background" Value="{DynamicResource GlobalBackground}"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Description" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Opacity" Value=".68"/>
            <Setter Property="Margin" Value="0,6,0,16"/>
            <Setter Property="LineHeight" Value="18"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource ButtonDefault}">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>
        <Style x:Key="SectionTab" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}"/>
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource ButtonBackground}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource ButtonBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource GlobalBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="MinHeight" Value="160"/>
            <Setter Property="MaxHeight" Value="280"/>
            <Setter Property="Background" Value="{DynamicResource GlobalBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="EmptyState" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Margin" Value="18"/>
            <Setter Property="Opacity" Value=".6"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <Border Style="{StaticResource Card}" Margin="0,0,0,18">
            <DockPanel LastChildFill="True">
                <CheckBox x:Name="EnableCheckBox" DockPanel.Dock="Right" Margin="20,0,0,0"
                          Content="{local:LanRemoteText Enable}" VerticalAlignment="Top"
                          Checked="EnableCheckBox_Changed" Unchecked="EnableCheckBox_Changed"/>
                <StackPanel>
                    <TextBlock Text="{local:LanRemoteText Companion}" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="{local:LanRemoteText Introduction}" Style="{StaticResource Description}" Margin="0,6,0,12"/>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ServiceStateIndicator" Width="8" Height="8" Margin="0,0,8,0"
                                 Fill="{DynamicResource GlobalTextBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ServiceStateTextBlock" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>
        <TabControl x:Name="SectionsTabControl" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
            <TabItem Header="{local:LanRemoteText ConnectTab}" Style="{StaticResource SectionTab}">
                <StackPanel Margin="0,16,0,0">
                    <Grid x:Name="ConnectionGrid">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border x:Name="DownloadCard" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{local:LanRemoteText InstallStep}" Style="{StaticResource Heading}"/>
                                <TextBlock Text="{local:LanRemoteText InstallDescription}" Style="{StaticResource Description}"/>
                                <Border Width="164" Height="164" Padding="8" CornerRadius="8" Background="White" BorderBrush="#D7DEE8" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,16">
                                    <Image x:Name="AppDownloadQrImage" Stretch="Uniform" AutomationProperties.Name="{local:LanRemoteText DownloadQr}"/>
                                </Border>
                                <TextBox x:Name="AppDownloadUrlTextBox" IsReadOnly="True" AutomationProperties.Name="{local:LanRemoteText DownloadAddress}"/>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content="{local:LanRemoteText OpenDownload}" Click="OpenAppDownloadPageButton_Click"/>
                                    <Button Content="{local:LanRemoteText CopyDownload}" Click="CopyAppDownloadUrlButton_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border x:Name="PairingCard" Grid.Column="2" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{local:LanRemoteText PairStep}" Style="{StaticResource Heading}"/>
                                <TextBlock Text="{local:LanRemoteText PairDescription}" Style="{StaticResource Description}"/>
                                <Grid Width="208" Height="208" HorizontalAlignment="Center" Margin="0,0,0,12">
                                    <Border x:Name="QrCard" Padding="8" CornerRadius="8" Background="White" BorderBrush="#D7DEE8" BorderThickness="1">
                                        <Image x:Name="QrImage" Stretch="Uniform" AutomationProperties.Name="{local:LanRemoteText PairingQr}"/>
                                    </Border>
                                    <Border x:Name="PairingUnavailableOverlay" CornerRadius="8" Padding="16" Background="{DynamicResource GlobalBackground}" BorderBrush="{DynamicResource ButtonBorderBrush}" BorderThickness="1">
                                        <TextBlock x:Name="PairingStateTextBlock" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                                    </Border>
                                </Grid>
                                <TextBlock x:Name="PairingExpiryTextBlock" FontSize="12" Opacity=".68" TextAlignment="Center" Margin="0,0,0,12"/>
                                <TextBox x:Name="ConnectionUrlTextBox" IsReadOnly="True" AutomationProperties.Name="{local:LanRemoteText SecureAddress}"/>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button x:Name="ResetTokenButton" Content="{local:LanRemoteText RefreshPairing}" Click="ResetTokenButton_Click"/>
                                    <Button x:Name="CopyUrlButton" Content="{local:LanRemoteText CopySecureAddress}" Click="CopyUrlButton_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,12,0,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{local:LanRemoteText ReviewDevices}" Margin="16,0,0,0" Click="ReviewDevicesButton_Click"/>
                            <StackPanel>
                                <TextBlock Text="{local:LanRemoteText ApproveStep}" FontWeight="SemiBold"/>
                                <TextBlock Text="{local:LanRemoteText ApproveStepDescription}" Style="{StaticResource Description}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </TabItem>
            <TabItem Style="{StaticResource SectionTab}">
                <TabItem.Header><TextBlock x:Name="DevicesTabHeader" Text="{local:LanRemoteText DevicesTab}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/></TabItem.Header>
                <Grid x:Name="DevicesGrid" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{local:LanRemoteText PendingDevices}" Style="{StaticResource Heading}"/>
                            <TextBlock Text="{local:LanRemoteText PendingDescription}" Style="{StaticResource Description}"/>
                            <Grid>
                                <ListBox x:Name="PendingDevicesListBox" SelectionChanged="Selection_Changed">
                                    <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="6">
                                        <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold" Foreground="{DynamicResource GlobalTextBrush}"/>
                                        <TextBlock Text="{Binding DeviceId}" FontSize="11" Opacity=".6" Foreground="{DynamicResource GlobalTextBrush}"/>
                                    </StackPanel></DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock x:Name="PendingEmptyText" Text="{local:LanRemoteText PendingEmpty}" Style="{StaticResource EmptyState}"/>
                            </Grid>
                            <WrapPanel Margin="0,14,0,0">
                                <Button x:Name="ApproveDeviceButton" Content="{local:LanRemoteText ApproveDevice}" Click="ApproveDeviceButton_Click" IsEnabled="False"/>
                                <Button x:Name="RejectDeviceButton" Content="{local:LanRemoteText Reject}" Click="RejectDeviceButton_Click" IsEnabled="False"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border x:Name="PairedDevicesCard" Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{local:LanRemoteText PairedDevices}" Style="{StaticResource Heading}"/>
                            <TextBlock Text="{local:LanRemoteText PairedDescription}" Style="{StaticResource Description}"/>
                            <Grid>
                                <ListBox x:Name="PairedDevicesListBox" SelectionChanged="Selection_Changed">
                                    <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="6">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="{DynamicResource GlobalTextBrush}"/>
                                        <TextBlock Text="{Binding DeviceId}" FontSize="11" Opacity=".6" Foreground="{DynamicResource GlobalTextBrush}"/>
                                    </StackPanel></DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock x:Name="PairedEmptyText" Text="{local:LanRemoteText PairedEmpty}" Style="{StaticResource EmptyState}"/>
                            </Grid>
                            <Button x:Name="RevokeDeviceButton" Margin="0,14,0,0" HorizontalAlignment="Left" Content="{local:LanRemoteText RevokeDevice}" Click="RevokeDeviceButton_Click" IsEnabled="False"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Style="{StaticResource SectionTab}">
                <TabItem.Header><TextBlock x:Name="ConfirmationsTabHeader" Text="{local:LanRemoteText ConfirmationsTab}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/></TabItem.Header>
                <Grid x:Name="ConfirmationsGrid" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{local:LanRemoteText LocalJobs}" Style="{StaticResource Heading}"/>
                            <TextBlock Text="{local:LanRemoteText LocalJobsDescription}" Style="{StaticResource Description}"/>
                            <Grid>
                                <ListBox x:Name="LocalCoSignJobsListBox" SelectionChanged="Selection_Changed">
                                    <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="6">
                                        <TextBlock Text="{Binding Converter={StaticResource ItemText}, ConverterParameter=Title}" FontWeight="SemiBold" Foreground="{DynamicResource GlobalTextBrush}"/>
                                        <TextBlock Text="{Binding Converter={StaticResource ItemText}, ConverterParameter=Notice}" FontSize="11" Opacity=".78" Margin="0,4,0,4" Foreground="{DynamicResource GlobalTextBrush}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Reason}" FontSize="11" Opacity=".6" Foreground="{DynamicResource GlobalTextBrush}" TextWrapping="Wrap"/>
                                    </StackPanel></DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock x:Name="JobsEmptyText" Text="{local:LanRemoteText JobsEmpty}" Style="{StaticResource EmptyState}"/>
                            </Grid>
                            <WrapPanel Margin="0,14,0,0">
                                <Button x:Name="LocalCoSignJobButton" Content="{local:LanRemoteText ConfirmJob}" Click="LocalCoSignJobButton_Click" IsEnabled="False"/>
                                <Button x:Name="LocalRejectJobButton" Content="{local:LanRemoteText RejectLocally}" Click="LocalRejectJobButton_Click" IsEnabled="False"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border x:Name="SupportCard" Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{local:LanRemoteText SupportRequests}" Style="{StaticResource Heading}"/>
                            <TextBlock Text="{local:LanRemoteText SupportDescription}" Style="{StaticResource Description}"/>
                            <Grid>
                                <ListBox x:Name="SupportRequestsListBox" SelectionChanged="Selection_Changed">
                                    <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="6">
                                        <TextBlock Text="{Binding Converter={StaticResource ItemText}}" FontWeight="SemiBold" Foreground="{DynamicResource GlobalTextBrush}"/>
                                        <TextBlock Text="{Binding Reason}" FontSize="11" Opacity=".6" Foreground="{DynamicResource GlobalTextBrush}" TextWrapping="Wrap"/>
                                    </StackPanel></DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock x:Name="SupportEmptyText" Text="{local:LanRemoteText SupportEmpty}" Style="{StaticResource EmptyState}"/>
                            </Grid>
                            <WrapPanel Margin="0,14,0,0">
                                <Button x:Name="ConsentSupportButton" Content="{local:LanRemoteText ConsentSupport}" Click="ConsentSupportButton_Click" IsEnabled="False"/>
                                <Button x:Name="RejectSupportButton" Content="{local:LanRemoteText Reject}" Click="RejectSupportButton_Click" IsEnabled="False"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="{local:LanRemoteText NetworkTab}" Style="{StaticResource SectionTab}">
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="{local:LanRemoteText NetworkTitle}" Style="{StaticResource Heading}"/>
                        <TextBlock Text="{local:LanRemoteText NetworkDescription}" Style="{StaticResource Description}"/>
                        <TextBlock Text="{local:LanRemoteText QrAddress}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="IpAddressComboBox" MinHeight="34" HorizontalAlignment="Stretch" VerticalContentAlignment="Center"
                                  SelectionChanged="IpAddressComboBox_SelectionChanged" AutomationProperties.Name="{local:LanRemoteText QrAddress}"/>
                        <TextBlock x:Name="IpListTextBlock" Style="{StaticResource Description}"/>
                        <TextBlock Text="{local:LanRemoteText LegacyPort}" Margin="0,0,0,6"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{local:LanRemoteText Apply}" Click="ApplyPortButton_Click" Margin="10,0,0,0"/>
                            <TextBox x:Name="PortTextBox" LostFocus="PortTextBox_LostFocus" KeyDown="PortTextBox_KeyDown" AutomationProperties.Name="{local:LanRemoteText LegacyPort}"/>
                        </DockPanel>
                        <TextBlock Text="{local:LanRemoteText LegacyPortDescription}" Style="{StaticResource Description}"/>
                        <TextBlock Text="{local:LanRemoteText SecurePort}" Margin="0,0,0,6"/>
                        <TextBlock x:Name="SecurePortTextBlock" FontWeight="SemiBold"/>
                        <TextBlock x:Name="NetworkStatusTextBlock" Style="{StaticResource Description}"/>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>
        <DockPanel Margin="0,16,0,0">
            <Button DockPanel.Dock="Right" Content="{local:LanRemoteText RefreshStatus}" Click="RefreshButton_Click" Margin="16,0,0,0"/>
            <TextBlock x:Name="StatusTextBlock" Text="{local:LanRemoteText ReadyHint}" FontSize="12" Opacity=".75" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
        </DockPanel>
    </StackPanel>
</UserControl>
