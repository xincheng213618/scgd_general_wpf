<Window x:Class="ColorVision.UI.Desktop.Download.DownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:local="clr-namespace:ColorVision.UI.Desktop.Download"
        xmlns:properties="clr-namespace:ColorVision.UI.Desktop.Properties"
        mc:Ignorable="d"
        Title="{x:Static properties:Resources.DownloadManager}" Height="600" Width="900"
        Background="{DynamicResource GlobalBackground}" Initialized="Window_Initialized">
    <Window.Resources>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}"/>
        </Style>
        <!-- The icon font stays on the glyph: tooltips and menus inherit a button's font and cannot render text with it. -->
        <Style x:Key="RowIconGlyph" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="RowIconButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Margin" Value="0,0,1,0"/>
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="5,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnAddUrl" Content="{x:Static properties:Resources.AddDownload}" Click="BtnAddUrl_Click" Margin="2,0" Padding="8,3"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <RadioButton x:Name="FilterAll" Content="{x:Static properties:Resources.DownloadFilterAll}" GroupName="DownloadFilter" IsChecked="True" Checked="Filter_Checked" Margin="0,0,10,0"/>
                    <RadioButton x:Name="FilterActive" Content="{x:Static properties:Resources.DownloadFilterActive}" GroupName="DownloadFilter" Checked="Filter_Checked" Margin="0,0,10,0"/>
                    <RadioButton x:Name="FilterFailed" Content="{x:Static properties:Resources.Failed}" GroupName="DownloadFilter" Checked="Filter_Checked"/>
                </StackPanel>

                <hc:TextBox x:Name="SearchTextBox" Grid.Column="2" Margin="10,0" VerticalAlignment="Center" VerticalContentAlignment="Center"
                            Style="{DynamicResource TextBoxPlusBaseStyle}"
                            hc:InfoElement.Placeholder="{x:Static properties:Resources.DownloadSearchPlaceholder}"
                            AutomationProperties.Name="{x:Static properties:Resources.DownloadSearchPlaceholder}"
                            TextChanged="SearchTextBox_TextChanged"/>

                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button ToolTip="{x:Static properties:Resources.DownloadSettings}"
                            AutomationProperties.Name="{x:Static properties:Resources.DownloadSettings}"
                            Click="Settings_Click" Margin="2,0" Padding="6,3" Background="Transparent" BorderThickness="0">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="18"/>
                    </Button>
                    <Button x:Name="MoreActionsButton" ToolTip="{x:Static properties:Resources.DownloadMoreActions}"
                            AutomationProperties.Name="{x:Static properties:Resources.DownloadMoreActions}"
                            Click="MoreActions_Click" Margin="2,0" Padding="6,3" Background="Transparent" BorderThickness="0">
                        <TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="18"/>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{x:Static properties:Resources.ClearCompletedRecords}" Click="ClearCompletedRecords_Click"/>
                                <Separator/>
                                <MenuItem Header="{x:Static properties:Resources.ClearRecords}" Click="ClearRecords_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Download List -->
        <ListBox x:Name="DownloadListView" Grid.Row="1" Margin="0"
                 SelectionMode="Extended" HorizontalContentAlignment="Stretch"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" BorderThickness="0"
                 MouseDoubleClick="DownloadListView_MouseDoubleClick"
                 PreviewMouseRightButtonDown="DownloadListView_PreviewMouseRightButtonDown"
                 KeyDown="DownloadListView_KeyDown">
            <ListBox.ContextMenu>
                <ContextMenu x:Name="DownloadContextMenu" Opened="DownloadContextMenu_Opened">
                    <MenuItem x:Name="MenuOpenFile" Header="{x:Static properties:Resources.OpenFile}" Click="ContextMenu_OpenFile_Click"/>
                    <MenuItem x:Name="MenuOpenFolder" Header="{x:Static properties:Resources.OpenFolder}" Click="ContextMenu_OpenFolder_Click"/>
                    <Separator/>
                    <MenuItem x:Name="MenuCopyUrl" Header="{x:Static properties:Resources.CopyUrl}" Click="ContextMenu_CopyUrl_Click"/>
                    <Separator/>
                    <MenuItem x:Name="MenuPause" Header="{x:Static properties:Resources.PauseDownload}" Click="ContextMenu_Pause_Click"/>
                    <MenuItem x:Name="MenuResume" Header="{x:Static properties:Resources.ResumeDownload}" Click="ContextMenu_Resume_Click"/>
                    <MenuItem x:Name="MenuRetry" Header="{x:Static properties:Resources.RetryDownload}" Click="ContextMenu_Retry_Click"/>
                    <MenuItem x:Name="MenuCancel" Header="{x:Static properties:Resources.CancelDownload}" Click="ContextMenu_Cancel_Click"/>
                    <Separator/>
                    <MenuItem x:Name="MenuDelete" Header="{x:Static properties:Resources.DeleteRecord}" Click="ContextMenu_Delete_Click"/>
                </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type local:DownloadTask}">
                    <Grid Height="44" Margin="2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- File Icon from OS -->
                        <Image Source="{Binding FileIconSource}" Width="24" Height="24" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                        <!-- Main content area -->
                        <Grid Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Row 0: FileName + FileSize + CreateTime -->
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding CreateTime, StringFormat=yyyy-MM-dd HH:mm}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding FileSizeDisplayText}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="58" TextAlignment="Right"/>
                                <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" FontSize="13" VerticalAlignment="Center"/>
                            </DockPanel>

                            <!-- Row 1: Progress bar + speed (visible when downloading) -->
                            <Grid Grid.Row="1" Margin="0,2,0,0"
                                  Visibility="{Binding IsActiveDownloading, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ProgressBar Value="{Binding ProgressValue}" Height="10" Minimum="0" Maximum="100"/>
                                <TextBlock Grid.Column="1" Text="{Binding SpeedText}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" MinWidth="80" TextAlignment="Right"/>
                            </Grid>

                            <!-- Row 1: Status text (visible when NOT actively downloading) -->
                            <TextBlock Grid.Row="1" Text="{Binding StatusText}" ToolTip="{Binding ErrorMessage}"
                                       FontSize="11" Margin="0,2,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActiveDownloading}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsFinished}" Value="True">
                                                <Setter Property="Opacity" Value="0.6"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static local:DownloadStatus.Failed}">
                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- Action buttons (right side) -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0">
                            <Button Style="{StaticResource RowIconButton}"
                                    ToolTip="{x:Static properties:Resources.PauseDownload}"
                                    AutomationProperties.Name="{x:Static properties:Resources.PauseDownload}"
                                    Click="InlinePause_Click"
                                    Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="&#xE769;" Style="{StaticResource RowIconGlyph}"/>
                            </Button>
                            <Button Style="{StaticResource RowIconButton}"
                                    ToolTip="{x:Static properties:Resources.ResumeDownload}"
                                    AutomationProperties.Name="{x:Static properties:Resources.ResumeDownload}"
                                    Click="InlineResume_Click"
                                    Visibility="{Binding IsPaused, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="&#xE768;" Style="{StaticResource RowIconGlyph}"/>
                            </Button>
                            <Button Style="{StaticResource RowIconButton}"
                                    ToolTip="{x:Static properties:Resources.RetryDownload}"
                                    AutomationProperties.Name="{x:Static properties:Resources.RetryDownload}"
                                    Click="InlineRetry_Click"
                                    Visibility="{Binding IsRetryable, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="&#xE72C;" Style="{StaticResource RowIconGlyph}"/>
                            </Button>
                            <Button Style="{StaticResource RowIconButton}"
                                    ToolTip="{x:Static properties:Resources.OpenFolder}"
                                    AutomationProperties.Name="{x:Static properties:Resources.OpenFolder}"
                                    Click="InlineOpenFolder_Click"
                                    Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="&#xED25;" Style="{StaticResource RowIconGlyph}"/>
                            </Button>
                            <Button Style="{StaticResource RowIconButton}"
                                    ToolTip="{x:Static properties:Resources.DeleteRecord}"
                                    AutomationProperties.Name="{x:Static properties:Resources.DeleteRecord}"
                                    Click="InlineDelete_Click">
                                <TextBlock Text="&#xE74D;" Style="{StaticResource RowIconGlyph}"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Status Bar -->
        <Border Grid.Row="2" Height="28" Background="{DynamicResource GlobalBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel Margin="8,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{x:Static properties:Resources.TotalRecords}" VerticalAlignment="Center" Margin="0,0,3,0" FontSize="11"/>
                    <TextBlock x:Name="TotalCountText" Text="0" VerticalAlignment="Center" FontSize="11"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusIndicator" Width="8" Height="8" Fill="Gray" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusBarText" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
