<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Use the same theme palette as the startup recovery and update windows,
         without introducing a dependency on the ColorVision application. -->
    <SolidColorBrush x:Key="Marketplace.Background" Color="{DynamicResource UpdateDialogBackgroundColor}" />
    <SolidColorBrush x:Key="Marketplace.Surface" Color="{DynamicResource UpdateDialogSurfaceColor}" />
    <SolidColorBrush x:Key="Marketplace.SurfaceHover" Color="{DynamicResource UpdateDialogSurfaceHoverColor}" />
    <SolidColorBrush x:Key="Marketplace.Border" Color="{DynamicResource UpdateDialogBorderColor}" />
    <SolidColorBrush x:Key="Marketplace.WeakBorder" Color="{DynamicResource UpdateDialogBorderColor}" Opacity="0.5" />
    <SolidColorBrush x:Key="Marketplace.TextPrimary" Color="{DynamicResource UpdateDialogTextPrimaryColor}" />
    <SolidColorBrush x:Key="Marketplace.TextSecondary" Color="{DynamicResource UpdateDialogTextPrimaryColor}" Opacity="0.65" />
    <SolidColorBrush x:Key="Marketplace.Accent" Color="{DynamicResource UpdateDialogAccentColor}" />
    <SolidColorBrush x:Key="Marketplace.AccentBackground" Color="{DynamicResource UpdateDialogAccentColor}" Opacity="0.1" />

    <Style x:Key="MarketplaceCardStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource Marketplace.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Marketplace.WeakBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="18,16" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="MarketplaceButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Marketplace.TextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource Marketplace.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Marketplace.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8" SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource Marketplace.Accent}" />
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource Marketplace.Accent}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.7" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MarketplacePrimaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource MarketplaceButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource Marketplace.Accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Marketplace.Accent}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinWidth" Value="100" />
    </Style>

    <Style x:Key="MarketplaceDetailActionButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource MarketplaceButtonStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="56" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="MarketplaceTagStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource Marketplace.AccentBackground}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8,3" />
    </Style>

    <Style x:Key="MarketplaceListItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Foreground" Value="{DynamicResource Marketplace.TextPrimary}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Background" Value="{DynamicResource Marketplace.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Marketplace.WeakBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="ItemBorder" CornerRadius="10"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Marketplace.SurfaceHover}" />
                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource Marketplace.Border}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Marketplace.AccentBackground}" />
                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource Marketplace.Accent}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource Marketplace.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MarketplaceListStyle" TargetType="{x:Type ListBox}">
        <Setter Property="Foreground" Value="{DynamicResource Marketplace.TextPrimary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource MarketplaceListItemStyle}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
    </Style>

    <Style x:Key="MarketplaceTabStyle" TargetType="{x:Type TabItem}">
        <Setter Property="Foreground" Value="{DynamicResource Marketplace.TextSecondary}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Border x:Name="TabBorder" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent">
                        <ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource Marketplace.AccentBackground}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource Marketplace.Accent}" />
                            <Setter Property="Foreground" Value="{DynamicResource Marketplace.Accent}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource Marketplace.AccentBackground}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MarketplaceTabsStyle" TargetType="{x:Type TabControl}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource MarketplaceTabStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border BorderBrush="{DynamicResource Marketplace.WeakBorder}" BorderThickness="0,0,0,1">
                            <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" />
                        </Border>
                        <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" Margin="0,14,0,0"
                                          ContentSource="SelectedContent" SnapsToDevicePixels="True" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MarketplaceTabHeadersStyle" TargetType="{x:Type TabControl}" BasedOn="{StaticResource MarketplaceTabsStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <Border BorderBrush="{DynamicResource Marketplace.WeakBorder}" BorderThickness="0,0,0,1">
                        <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
