<Window x:Class="ColorVision.UI.Desktop.Marketplace.MarketplaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ColorVision.UI.Desktop.Marketplace"
        xmlns:properties="clr-namespace:ColorVision.UI.Desktop.Properties"
        xmlns:uiProperties="clr-namespace:ColorVision.UI.Properties;assembly=ColorVision.UI"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:themes="https://schemas.colorvision.cn/wpf/themes"
        d:DataContext="{d:DesignInstance local:MarketplaceManager}" mc:Ignorable="d"
        Title="{x:Static properties:Resources.MarketplaceWindowTitle}"
        Background="{DynamicResource Marketplace.Background}" Foreground="{DynamicResource Marketplace.TextPrimary}"
        Width="520" Height="720" MinWidth="480" MinHeight="600"
        SnapsToDevicePixels="True" UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner" Initialized="Window_Initialized">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="MarketplaceStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="InstalledPluginItemStyle" TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource MarketplaceListItemStyle}">
                <Setter Property="ContextMenu" Value="{Binding ContextMenu}" />
            </Style>
            <Style x:Key="MarketplaceDetailTabsStyle" TargetType="{x:Type TabControl}" BasedOn="{StaticResource MarketplaceTabHeadersStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="MarketplacePendingContentStyle" TargetType="{x:Type FrameworkElement}">
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding DataContext.IsMarketplaceTabActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                            <Condition Binding="{Binding DataContext.Catalog.IsLoadingDetail, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="IsEnabled" Value="False" />
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>
            <DataTemplate x:Key="MarketplaceDetailRowTemplate" DataType="{x:Type local:MarketplaceDetailRow}">
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="136" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Marketplace.TextSecondary}" Margin="0,0,16,0" />
                    <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="MarketplaceVersionBadgeTemplate" DataType="{x:Type local:MarketplaceVersionBadgeItem}">
                <Border Style="{StaticResource MarketplaceTagStyle}" Margin="6,0,0,4">
                    <TextBlock Text="{Binding Text}" Foreground="{DynamicResource Marketplace.Accent}" FontSize="11" />
                </Border>
            </DataTemplate>
            <DataTemplate x:Key="MarketplaceVersionCardTemplate" DataType="{x:Type local:MarketplaceVersionItemViewModel}">
                <Border Style="{StaticResource MarketplaceCardStyle}" Margin="0,0,0,10" Padding="16">
                    <StackPanel>
                        <DockPanel>
                            <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Badges}" ItemTemplate="{StaticResource MarketplaceVersionBadgeTemplate}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <TextBlock Text="{Binding VersionText}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="{Binding SummaryText}" Margin="0,8,0,0" Foreground="{DynamicResource Marketplace.TextSecondary}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ChangeLog}" Margin="0,8,0,0" TextWrapping="Wrap" MaxHeight="90" Visibility="{Binding HasChangeLog, Converter={StaticResource bool2VisibilityConverter}}" />
                        <WrapPanel Margin="0,12,0,0">
                            <Button Content="{Binding InstallText}" Command="{Binding InstallCommand}" Style="{StaticResource MarketplacePrimaryButtonStyle}" Margin="0,0,8,0" />
                            <Button Content="{x:Static properties:Resources.Download}" Command="{Binding DownloadCommand}" Style="{StaticResource MarketplaceButtonStyle}" />
                        </WrapPanel>
                        <TextBlock Text="{Binding HashText}" Margin="0,10,0,0" FontSize="11" Foreground="{DynamicResource Marketplace.TextSecondary}" TextWrapping="Wrap" Visibility="{Binding HasHash, Converter={StaticResource bool2VisibilityConverter}}" />
                    </StackPanel>
                </Border>
            </DataTemplate>
            <DataTemplate x:Key="MarketplaceVersionGroupTemplate" DataType="{x:Type local:MarketplaceVersionGroup}">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16" Margin="0,18,0,12" />
                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource MarketplaceVersionCardTemplate}" />
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24,22,24,18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="CatalogColumn" Width="*" />
            <ColumnDefinition x:Name="DetailColumn" Width="0" />
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource MarketplaceCardStyle}" Padding="14">
            <Grid>
                <TabControl x:Name="MainTabControl" Style="{StaticResource MarketplaceTabsStyle}" SelectionChanged="MainTabControl_SelectionChanged">
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{x:Static properties:Resources.Installed}" />
                                <TextBlock Text="{Binding Plugins.Count}" Margin="8,0,0,0" Opacity="0.7" />
                            </StackPanel>
                        </TabItem.Header>
                        <ListBox x:Name="ListViewPlugins" ItemsSource="{Binding Plugins}" SelectedItem="{Binding SelectedInstalledPlugin, Mode=TwoWay}" Style="{StaticResource MarketplaceListStyle}" ItemContainerStyle="{StaticResource InstalledPluginItemStyle}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:PluginInfoVM}">
                                    <Grid ToolTip="{Binding Description}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Image Source="{Binding Icon}" Width="32" Height="32" Margin="0,2,12,0" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality" />
                                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                            <WrapPanel Margin="0,6,0,0">
                                                <TextBlock Text="{Binding AssemblyVersion, StringFormat=v{0}}" FontSize="11" Foreground="{DynamicResource Marketplace.TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="{x:Static properties:Resources.MarketplaceInstalledVersion}" />
                                                <Border Style="{StaticResource MarketplaceTagStyle}" Padding="6,2" Visibility="{Binding HasUpdate, Converter={StaticResource bool2VisibilityConverter}}">
                                                    <TextBlock Text="{Binding LastVersion, StringFormat=→ v{0}}" FontSize="11" Foreground="{DynamicResource Marketplace.Accent}" ToolTip="{x:Static properties:Resources.MarketplaceHasUpdateTooltip}" />
                                                </Border>
                                            </WrapPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <themes:ToggleSwitch IsChecked="{Binding PluginInfo.Enabled}" HorizontalAlignment="Right" ToolTip="{x:Static properties:Resources.MarketplaceEnabled}" AutomationProperties.Name="{Binding Name}" />
                                            <Button Content="{x:Static properties:Resources.Update}" Command="{Binding UpdateCommand}" Visibility="{Binding HasUpdate, Converter={StaticResource bool2VisibilityConverter}}"
                                                    Style="{StaticResource MarketplaceButtonStyle}" MinHeight="28" Padding="8,4" Margin="0,8,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                    <TabItem Header="{x:Static properties:Resources.Marketplace}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <WrapPanel Margin="0,0,0,10">
                                <TextBlock Text="{Binding Catalog.StatusText}" Foreground="{DynamicResource Marketplace.TextSecondary}" FontSize="12" Margin="0,0,8,0" />
                                <TextBlock Text="{x:Static properties:Resources.MarketplaceOffline}" Foreground="{DynamicResource Marketplace.TextSecondary}" FontSize="12" Visibility="{Binding Catalog.IsOffline, Converter={StaticResource bool2VisibilityConverter}}" />
                            </WrapPanel>
                            <Grid Grid.Row="1">
                                <ListBox x:Name="ListViewMarketplace" ItemsSource="{Binding Catalog.MarketplacePlugins}" SelectedItem="{Binding Catalog.SelectedPlugin, Mode=TwoWay}"
                                         Style="{StaticResource MarketplaceListStyle}" Visibility="{Binding Catalog.HasItems, Converter={StaticResource bool2VisibilityConverter}}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                <TextBlock Text="{Binding Description}" Foreground="{DynamicResource Marketplace.TextSecondary}" FontSize="12" Margin="0,6,0,0" MaxHeight="36" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                                <DockPanel Margin="0,10,0,0">
                                                    <Border Style="{StaticResource MarketplaceTagStyle}" DockPanel.Dock="Left">
                                                        <TextBlock Text="{Binding LatestVersion, StringFormat=v{0}}" Foreground="{DynamicResource Marketplace.Accent}" FontSize="11" />
                                                    </Border>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="{x:Static properties:Resources.MarketplaceDownloads}">
                                                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource Marketplace.TextSecondary}" Margin="0,0,5,0" />
                                                        <TextBlock Text="{Binding TotalDownloads}" FontSize="11" Foreground="{DynamicResource Marketplace.TextSecondary}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" Visibility="{Binding Catalog.IsLoading, Converter={StaticResource bool2VisibilityConverter}}">
                                    <ProgressBar IsIndeterminate="True" Height="3" Width="120" Margin="0,0,0,12" />
                                    <TextBlock Text="{Binding Catalog.StatusText}" Foreground="{DynamicResource Marketplace.TextSecondary}" TextWrapping="Wrap" TextAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding Catalog.StatusText}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" TextWrapping="Wrap" TextAlignment="Center"
                                           Foreground="{DynamicResource Marketplace.TextSecondary}" Visibility="{Binding Catalog.HasError, Converter={StaticResource bool2VisibilityConverter}}" />
                                <TextBlock Text="{x:Static properties:Resources.MarketplaceNoMatches}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" TextWrapping="Wrap" TextAlignment="Center"
                                           Foreground="{DynamicResource Marketplace.TextSecondary}" Visibility="{Binding Catalog.IsEmpty, Converter={StaticResource bool2VisibilityConverter}}" />
                            </Grid>
                        </Grid>
                    </TabItem>
                </TabControl>
                <Button Click="MoreButton_Click" Style="{StaticResource MarketplaceButtonStyle}" Width="32" MinHeight="32" Padding="0"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0"
                        ToolTip="{x:Static properties:Resources.MarketplaceMoreActions}" AutomationProperties.Name="{x:Static properties:Resources.MarketplaceMoreActions}">
                    <Button.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="{x:Static properties:Resources.InstallPackage}" Command="{Binding InstallPackageCommand}" />
                            <MenuItem Header="{x:Static properties:Resources.Refresh}" Click="RefreshVersionsButton_Click" />
                            <Separator />
                            <MenuItem Header="{x:Static properties:Resources.Options}" Command="{Binding EditConfigCommand}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                    <TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                </Button>
            </Grid>
        </Border>

        <Border x:Name="BorderContent" Grid.Column="1" DataContext="{Binding CurrentDetailContext}" Visibility="Collapsed"
                Style="{StaticResource MarketplaceCardStyle}" Padding="20,18" Margin="16,0,0,0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel" BasedOn="{StaticResource MarketplacePendingContentStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Width="56" Height="56" CornerRadius="12" Background="{DynamicResource Marketplace.Background}" BorderBrush="{DynamicResource Marketplace.WeakBorder}" BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Top">
                                <Image Source="{Binding Icon}" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding HeaderMetaText}" FontSize="12" Margin="0,5,0,0" Foreground="{DynamicResource Marketplace.TextSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                        <WrapPanel Margin="0,16,0,0">
                            <Button Content="{Binding PrimaryActionText}" Visibility="{Binding PrimaryActionVisibility, FallbackValue=Collapsed}" Margin="0,0,8,6">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource MarketplacePrimaryButtonStyle}">
                                        <Setter Property="Command" Value="{Binding InstallCommand}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsMarketplaceTabActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"><Setter Property="Command" Value="{Binding UpdateCommand}" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="{x:Static properties:Resources.Download}" Command="{Binding DownloadCommand}" Visibility="{Binding DownloadLatestVisibility, FallbackValue=Collapsed}" Style="{StaticResource MarketplaceButtonStyle}" Margin="0,0,8,6" />
                            <Button Content="{x:Static properties:Resources.MarketplaceOpenProjectUrl}" Command="{Binding OpenProjectUrlCommand}" Visibility="{Binding OpenProjectUrlVisibility, FallbackValue=Collapsed}" Style="{StaticResource MarketplaceButtonStyle}" Margin="0,0,0,6" />
                        </WrapPanel>
                    </StackPanel>
                    <Button Grid.Column="1" Click="CloseDetailButton_Click" Style="{StaticResource MarketplaceButtonStyle}" Width="32" MinHeight="32" Padding="0" VerticalAlignment="Top"
                            ToolTip="{x:Static uiProperties:Resources.Close}" AutomationProperties.Name="{x:Static uiProperties:Resources.Close}">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                    </Button>
                </Grid>
                <TabControl x:Name="TabControl1" Grid.Row="1" Style="{StaticResource MarketplaceDetailTabsStyle}" SelectionChanged="TabControl_SelectionChanged">
                    <TabItem Header="{x:Static properties:Resources.MarketplaceReadmeHeader}" />
                    <TabItem Header="{x:Static properties:Resources.MarketplaceChangelogHeader}" />
                    <TabItem Header="{x:Static properties:Resources.MarketplaceDetailInfoHeader}" />
                </TabControl>
                <!-- Keep the native browser attached while changing document tabs. -->
                <Grid Grid.Row="2" Margin="0,14,0,0" Style="{StaticResource MarketplacePendingContentStyle}">
                    <wv2:WebView2 x:Name="webViewMarkdown" Visibility="Hidden" />
                    <ScrollViewer x:Name="InstalledDetailScrollViewer" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="DetailInfo" Margin="0,0,8,0" />
                    </ScrollViewer>
                    <ScrollViewer x:Name="MarketplaceDetailScrollViewer" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,8,0">
                            <ItemsControl ItemsSource="{Binding DetailRows}" ItemTemplate="{StaticResource MarketplaceDetailRowTemplate}" />
                            <ItemsControl ItemsSource="{Binding VersionGroups}" ItemTemplate="{StaticResource MarketplaceVersionGroupTemplate}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                <ProgressBar Grid.RowSpan="3" Height="2" Margin="0,-10,0,0" VerticalAlignment="Top" IsIndeterminate="True">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Visibility" Value="Hidden" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding DataContext.IsMarketplaceTabActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                        <Condition Binding="{Binding DataContext.Catalog.IsLoadingDetail, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
                <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <ProgressBar IsIndeterminate="True" Height="3" Width="120" Margin="0,0,0,16"
                                 Visibility="{Binding DataContext.Catalog.IsLoadingDetail, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource bool2VisibilityConverter}}" />
                    <TextBlock Foreground="{DynamicResource Marketplace.TextSecondary}" TextWrapping="Wrap" TextAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{x:Static properties:Resources.MarketplaceLoadFailed}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.Catalog.IsLoadingDetail, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Text" Value="{x:Static properties:Resources.Loading}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Content="{x:Static properties:Resources.Refresh}" Click="RefreshVersionsButton_Click" Margin="0,16,0,0" HorizontalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MarketplaceButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.Catalog.IsLoadingDetail, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
