<Window x:Class="ColorVision.UI.Desktop.Settings.SettingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:properties="clr-namespace:ColorVision.UI.Properties;assembly=ColorVision.UI"
        mc:Ignorable="d"
        Height="720" Width="1180" MinHeight="620" MinWidth="980"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        Foreground="{DynamicResource CV.Text.Primary}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Title="{x:Static properties:Resources.Options}"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource GlobalBorderBrush1}"
        Initialized="Window_Initialized">
    <Window.Resources>
        <Style x:Key="SettingsEditorTextBoxStyle" TargetType="{x:Type TextBox}" BasedOn="{StaticResource TextBox.Small}">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Foreground" Value="{DynamicResource CV.Text.Primary}"/>
            <Setter Property="Background" Value="{DynamicResource CV.Surface.Control}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CV.Border.Control}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>

        <Style x:Key="SettingsEditorComboBoxStyle" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource ComboBoxBaseStyle}">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource GlobalBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style x:Key="SettingsSearchTextBoxStyle" TargetType="{x:Type TextBox}" BasedOn="{StaticResource TextBox.Small}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="140"/>
            <Setter Property="Padding" Value="32,4,10,4"/>
            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource GlobalBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}"/>
        </Style>

        <Style x:Key="SettingsNavigationListBoxStyle" TargetType="{x:Type ListBox}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="SettingsNavigationItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource GlobalBackground}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource GlobalBackground}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource CV.Accent.Primary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource GlobalBorderBrush1}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="204"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource GlobalBorderBrush1}">
            <Grid Margin="14,22,12,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="{x:Static properties:Resources.Options}"
                           Margin="10,0,0,0"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource GlobalTextBrush}"
                           TextTrimming="CharacterEllipsis"/>

                <Grid Grid.Row="1" Margin="0,18,0,12">
                    <TextBox x:Name="SearchTextBox"
                             Style="{StaticResource SettingsSearchTextBoxStyle}"
                             AutomationProperties.Name="{x:Static properties:Resources.SearchSettingsTitle}"
                             TextChanged="SearchTextBox_TextChanged"
                             ToolTip="{x:Static properties:Resources.SearchSettingsTitle}"/>
                    <TextBlock Margin="11,0,0,0"
                               FontFamily="Segoe MDL2 Assets"
                               Text="&#xE721;"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Foreground="{DynamicResource CV.Text.Secondary}"/>
                    <TextBlock Margin="33,0,8,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               FontSize="12"
                               Opacity="0.58"
                               Foreground="{DynamicResource GlobalTextBrush}"
                               Text="{x:Static properties:Resources.Search}">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <ListBox x:Name="NavigationListBox"
                         Grid.Row="2"
                         Style="{StaticResource SettingsNavigationListBoxStyle}"
                         ItemContainerStyle="{StaticResource SettingsNavigationItemStyle}"
                         SelectionChanged="NavigationListBox_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="15"
                                           Opacity="0.82"
                                           Text="{Binding IconGlyph}"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource GlobalTextBrush}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding DisplayName}"
                                           ToolTip="{Binding DisplayName}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource GlobalTextBrush}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Border Grid.Column="1"
                Margin="0,10,10,10"
                Background="{DynamicResource ButtonBackground}"
                BorderBrush="{DynamicResource GlobalBorderBrush}"
                BorderThickness="1"
                CornerRadius="10">
            <ScrollViewer x:Name="SettingsScrollViewer"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="800" Margin="28,24,28,28">
                    <TextBlock x:Name="CurrentGroupTitle"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource GlobalTextBrush}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="CurrentGroupDescription"
                               Margin="0,6,0,0"
                               FontSize="12"
                               Opacity="0.76"
                               Foreground="{DynamicResource GlobalTextBrush}"
                               TextWrapping="Wrap"/>
                    <StackPanel x:Name="SettingsContentPanel" Margin="0,22,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
