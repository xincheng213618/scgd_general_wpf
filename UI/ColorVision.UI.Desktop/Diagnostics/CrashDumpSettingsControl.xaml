<UserControl x:Class="ColorVision.UI.Desktop.Diagnostics.CrashDumpSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="150">
    <StackPanel HorizontalAlignment="Stretch">
        <Border CornerRadius="8"
                BorderThickness="1"
                Padding="18"
                Background="{DynamicResource GlobalBackground}"
                BorderBrush="{DynamicResource ButtonBorderBrush}">
            <StackPanel>
                <TextBlock x:Name="OperationsTitle"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource GlobalTextBrush}"/>
                <TextBlock x:Name="OperationsDescription"
                           Margin="0,5,0,14"
                           FontSize="12.5"
                           Opacity="0.68"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource GlobalTextBrush}"/>

                <WrapPanel>
                    <Button x:Name="ApplyButton" Padding="14,6" Click="ApplyButton_Click"/>
                    <Button x:Name="ClearButton" Margin="8,0,0,0" Padding="14,6" Click="ClearButton_Click"/>
                    <Button x:Name="SaveDumpButton" Margin="8,0,0,0" Padding="14,6"
                            Click="SaveDumpButton_Click"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Margin="0,12,0,0"
                CornerRadius="8"
                BorderThickness="1"
                Padding="14,10"
                Background="{DynamicResource GlobalBackground}"
                BorderBrush="{DynamicResource ButtonBorderBrush}">
            <TextBlock x:Name="StatusTextBlock"
                       FontSize="12.5"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource GlobalTextBrush}"/>
        </Border>
    </StackPanel>
</UserControl>
