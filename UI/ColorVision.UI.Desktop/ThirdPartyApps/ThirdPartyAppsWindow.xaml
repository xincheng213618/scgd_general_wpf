<Window x:Class="ColorVision.UI.Desktop.ThirdPartyApps.ThirdPartyAppsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:properties="clr-namespace:ColorVision.UI.Desktop.Properties"
        Title="{x:Static properties:Resources.ThirdPartyApps}" Height="760" Width="1120"
        MinHeight="560" MinWidth="920" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource UpdateDialog.Background}" Foreground="{DynamicResource UpdateDialog.TextPrimary}"
        Initialized="Window_Initialized" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ColorVision.Themes;component/Themes/UpdateDialogTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="CategoryTabItemStyle" TargetType="ListBoxItem">
                <Setter Property="Margin" Value="0,0,22,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="TabChrome" Padding="0,12" Background="Transparent"
                                    BorderBrush="Transparent" BorderThickness="0,0,0,2">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="TabText" Text="{Binding DisplayName}" FontSize="13"
                                               Foreground="{DynamicResource UpdateDialog.TextSecondary}"/>
                                    <TextBlock Text="{Binding Count}" Margin="7,0,0,0" FontSize="12"
                                               VerticalAlignment="Center" Foreground="{DynamicResource UpdateDialog.TextSecondary}"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="TabText" Property="Foreground" Value="{DynamicResource UpdateDialog.TextPrimary}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="TabChrome" Property="BorderBrush" Value="{DynamicResource UpdateDialog.Accent}"/>
                                    <Setter TargetName="TabText" Property="Foreground" Value="{DynamicResource UpdateDialog.TextPrimary}"/>
                                    <Setter TargetName="TabText" Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="AppTileItemStyle" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0,0,12,12"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="TileChrome" Width="240" Height="84" Padding="16"
                                    CornerRadius="10" BorderThickness="1" Cursor="Hand"
                                    BorderBrush="{DynamicResource UpdateDialog.WeakBorder}"
                                    Background="{DynamicResource UpdateDialog.Surface}">
                                <Grid ToolTip="{Binding Name}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="36" Height="36">
                                        <TextBlock x:Name="IconFallback" Text="{Binding IconGlyph}"
                                                   FontFamily="Segoe MDL2 Assets" FontSize="27" Visibility="Collapsed"
                                                   Foreground="{DynamicResource UpdateDialog.Accent}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image x:Name="AppIcon" Source="{Binding IconSource}" Width="36" Height="36"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <Ellipse x:Name="UnavailableDot" Width="9" Height="9" Fill="#D99A27"
                                                 Stroke="{DynamicResource UpdateDialog.Surface}" StrokeThickness="2"
                                                 Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                    </Grid>
                                    <TextBlock x:Name="AppNameText" Grid.Column="1" Text="{Binding Name}" Margin="14,0,0,0"
                                               FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap" MaxHeight="42"
                                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource UpdateDialog.TextPrimary}"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding IconSource}" Value="{x:Null}">
                                    <Setter TargetName="AppIcon" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="IconFallback" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                                    <Setter TargetName="UnavailableDot" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="AppIcon" Property="Opacity" Value="0.5"/>
                                    <Setter TargetName="AppNameText" Property="Foreground" Value="{DynamicResource UpdateDialog.TextSecondary}"/>
                                </DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="TileChrome" Property="Background" Value="{DynamicResource UpdateDialog.SurfaceHover}"/>
                                    <Setter TargetName="TileChrome" Property="BorderBrush" Value="{DynamicResource UpdateDialog.Border}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="TileChrome" Property="BorderBrush" Value="{DynamicResource UpdateDialog.Accent}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="30,28,30,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,24">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{x:Static properties:Resources.ThirdPartyApps}" FontSize="28" FontWeight="SemiBold"
                           Foreground="{DynamicResource UpdateDialog.TextPrimary}"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock x:Name="CurrentGroupText" FontSize="13" Foreground="{DynamicResource UpdateDialog.TextSecondary}"/>
                    <TextBlock Text=" · " Foreground="{DynamicResource UpdateDialog.TextSecondary}"/>
                    <TextBlock x:Name="AppCountText" FontSize="13" Foreground="{DynamicResource UpdateDialog.TextSecondary}"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnAddScript" Content="{x:Static properties:Resources.ThirdPartyAppsAddQuickScript}"
                        Style="{StaticResource UpdateDialogTextButtonStyle}" Margin="0,0,20,0" Click="BtnAddScript_Click"/>
                <Button x:Name="BtnAddApp" Content="{x:Static properties:Resources.CustomApp_AddTooltip}"
                        Style="{StaticResource UpdateDialogSecondaryButtonStyle}" Click="BtnAddApp_Click"/>
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" BorderBrush="{DynamicResource UpdateDialog.Border}" BorderThickness="0,1,0,0" Padding="0,20,0,8">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="320" HorizontalAlignment="Left" Background="{DynamicResource UpdateDialog.Surface}"
                        BorderBrush="{DynamicResource UpdateDialog.Border}" BorderThickness="1" CornerRadius="8" Padding="12,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center"
                                   Foreground="{DynamicResource UpdateDialog.TextSecondary}"/>
                        <Grid Grid.Column="1">
                            <TextBlock Text="{x:Static properties:Resources.Search}" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Foreground="{DynamicResource UpdateDialog.TextSecondary}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox x:Name="SearchBox" Height="38" BorderThickness="0" Background="Transparent" Padding="0"
                                     Foreground="{DynamicResource UpdateDialog.TextPrimary}" CaretBrush="{DynamicResource UpdateDialog.TextPrimary}"
                                     VerticalContentAlignment="Center" FontSize="13" TextChanged="SearchBox_TextChanged"/>
                        </Grid>
                    </Grid>
                </Border>
                <Button x:Name="BtnRefresh" Grid.Column="1" Content="{x:Static properties:Resources.Refresh}"
                        Style="{StaticResource UpdateDialogTextButtonStyle}" Click="BtnRefresh_Click"/>
            </Grid>
        </Border>
        <ListBox x:Name="GroupListBox" Grid.Row="2" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,20"
                 ItemContainerStyle="{StaticResource CategoryTabItemStyle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled" SelectionChanged="GroupListBox_SelectionChanged">
            <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
        </ListBox>
        <ListBox x:Name="AppsListBox" Grid.Row="3" Background="Transparent" BorderThickness="0" Padding="0"
                 ItemContainerStyle="{StaticResource AppTileItemStyle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" MouseDoubleClick="AppsListBox_MouseDoubleClick"
                 PreviewMouseRightButtonUp="AppsListBox_PreviewMouseRightButtonUp">
            <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
        </ListBox>
    </Grid>
</Window>
