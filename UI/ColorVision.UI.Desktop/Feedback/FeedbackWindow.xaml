<Window x:Class="ColorVision.UI.Desktop.Feedback.FeedbackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:properties="clr-namespace:ColorVision.UI.Desktop.Properties"
        mc:Ignorable="d"
        Title="{x:Static properties:Resources.SendFeedback}"
        Background="{DynamicResource GlobalBackground}"
        Height="600" Width="760"
        MinHeight="560" MinWidth="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        KeyboardNavigation.TabNavigation="Cycle"
        FocusManager.FocusedElement="{Binding ElementName=MessageTextBox}"
        Initialized="Window_Initialized">
    <Window.Resources>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="FeedbackSecondaryTextBlockStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="FeedbackSectionTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <Style x:Key="FeedbackSectionBorderStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <Style x:Key="FeedbackListBoxStyle" TargetType="{x:Type ListBox}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <Style x:Key="FeedbackListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="FeedbackContentScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,4,0">
            <StackPanel>
                <TextBlock x:Name="MessageLabel"
                           Text="{x:Static properties:Resources.FeedbackMessageLabel}"
                           Style="{StaticResource FeedbackSectionTitleStyle}"/>
                <TextBlock Text="{x:Static properties:Resources.FeedbackMessageHint}"
                           Margin="0,5,0,10"
                           Style="{StaticResource FeedbackSecondaryTextBlockStyle}"/>
                <Border Style="{StaticResource FeedbackSectionBorderStyle}" Margin="0,0,0,18">
                    <TextBox x:Name="MessageTextBox"
                             AutomationProperties.LabeledBy="{Binding ElementName=MessageLabel}"
                             AcceptsReturn="True"
                             Background="Transparent"
                             BorderThickness="0"
                             MinHeight="80"
                             MaxHeight="140"
                             Padding="0"
                             Text="{x:Static properties:Resources.FeedbackPlaceholder}"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto"
                             Foreground="{DynamicResource SecondaryTextBrush}"
                             GotFocus="MessageTextBox_GotFocus"
                             LostFocus="MessageTextBox_LostFocus"/>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{x:Static properties:Resources.Attachments}"
                                   Style="{StaticResource FeedbackSectionTitleStyle}"/>
                        <TextBlock Text="{Binding Items.Count, ElementName=AttachmentsList, StringFormat='({0})'}"
                                   Margin="8,0,0,0"
                                   Style="{StaticResource FeedbackSecondaryTextBlockStyle}"/>
                    </StackPanel>
                    <Button x:Name="AddFileButton" Grid.Column="1"
                            Content="{x:Static properties:Resources.AddFile}"
                            Click="AddFile_Click" Padding="12,5" Margin="0,0,8,0"/>
                    <Button x:Name="AddScreenshotButton" Grid.Column="2"
                            Content="{x:Static properties:Resources.CaptureScreenshot}"
                            Click="CaptureScreenshot_Click" Padding="12,5"/>
                </Grid>
                <TextBlock Text="{x:Static properties:Resources.FeedbackAttachmentsHint}"
                           Margin="0,5,0,8" Style="{StaticResource FeedbackSecondaryTextBlockStyle}"/>
                <TextBlock x:Name="EmptyAttachmentsText"
                           Text="{x:Static properties:Resources.FeedbackNoAttachments}"
                           Margin="0,10,0,12">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource FeedbackSecondaryTextBlockStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasItems, ElementName=AttachmentsList}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ListBox x:Name="AttachmentsList"
                         AutomationProperties.Name="{x:Static properties:Resources.Attachments}"
                         Style="{StaticResource FeedbackListBoxStyle}"
                         ItemContainerStyle="{StaticResource FeedbackListBoxItemStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource GlobalBorderBrush1}"
                                    BorderThickness="0,0,0,1" Padding="0,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName}" ToolTip="{Binding FileName}"
                                                   Foreground="{DynamicResource GlobalTextBrush}"/>
                                        <TextBlock Text="{Binding SizeText}" Margin="0,3,0,0"
                                                   Style="{StaticResource FeedbackSecondaryTextBlockStyle}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{x:Static properties:Resources.OpenFolder}"
                                            Click="OpenAttachmentFolder_Click" Tag="{Binding}"
                                            IsEnabled="{Binding FileExists, Mode=OneWay}"
                                            ToolTip="{x:Static properties:Resources.OfflinePackageHint}"
                                            Margin="0,0,8,0" Padding="10,4" VerticalAlignment="Center"/>
                                    <Button Grid.Column="2" Click="RemoveAttachment_Click" Tag="{Binding}"
                                            AutomationProperties.Name="{x:Static properties:Resources.FeedbackRemoveAttachment}"
                                            ToolTip="{x:Static properties:Resources.FeedbackRemoveAttachment}"
                                            Width="30" Height="30" Padding="0" VerticalAlignment="Center"
                                            Background="Transparent" BorderThickness="0">
                                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

            </StackPanel>
        </ScrollViewer>

        <Border x:Name="DiagnosticsPanel" Grid.Row="1" Style="{StaticResource FeedbackSectionBorderStyle}" Margin="0,14,0,0">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <WrapPanel VerticalAlignment="Center">
                        <TextBlock Text="{x:Static properties:Resources.DiagnosticItems}" FontWeight="SemiBold" Margin="0,0,12,0"/>
                        <TextBlock x:Name="DiagnosticsSummaryText" Style="{StaticResource FeedbackSecondaryTextBlockStyle}"/>
                    </WrapPanel>
                    <Button x:Name="ConfigureDiagnosticsButton" Grid.Column="1"
                            Content="{x:Static properties:Resources.FeedbackConfigureDiagnostics}"
                            Click="ConfigureDiagnostics_Click" Padding="12,5" Margin="8,0,8,0"/>
                    <Button x:Name="PackLogsButton" Grid.Column="2"
                            Content="{x:Static properties:Resources.PackLogs}" Click="PackLogs_Click" Padding="12,5"/>
                </Grid>
                <TextBlock x:Name="DiagnosticsHintText" Margin="0,8,0,12" Style="{StaticResource FeedbackSecondaryTextBlockStyle}"/>
                <WrapPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                        <TextBlock Text="{x:Static properties:Resources.FeedbackLogRange}" Margin="0,0,8,0"/>
                        <ComboBox x:Name="LogRangeComboBox" Width="120"
                                  AutomationProperties.Name="{x:Static properties:Resources.FeedbackLogRange}"
                                  ToolTip="{x:Static properties:Resources.FeedbackSharedLogRangeHint}"
                                  DisplayMemberPath="DisplayName" SelectedValuePath="Days"
                                  SelectionChanged="LogRange_SelectionChanged"/>
                    </StackPanel>
                    <Button x:Name="OpenLogFoldersButton" Content="{x:Static properties:Resources.OpenLogFolder}"
                            Click="OpenLogFolders_Click" Padding="10,4" Margin="0,0,8,4"/>
                    <Button x:Name="ClearDiagnosticsButton" Content="{x:Static properties:Resources.ClearDiagnostics}"
                            ToolTip="{x:Static properties:Resources.FeedbackCleanupSourcesHint}"
                            Click="ClearDiagnostics_Click" Padding="10,4" Margin="0,0,0,4"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border x:Name="FeedbackFooter" Grid.Row="2" Margin="0,14,0,0" Padding="0,14,0,0"
                BorderBrush="{DynamicResource GlobalBorderBrush1}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ProgressBar x:Name="UploadProgressBar" Grid.ColumnSpan="2" Height="4" Margin="0,0,0,10"
                             Minimum="0" Maximum="100" Value="0" Visibility="Collapsed"/>
                <TextBlock x:Name="StatusText" Grid.Row="1" Margin="0,0,16,0" MaxHeight="40"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                           AutomationProperties.LiveSetting="Polite"
                           Style="{StaticResource FeedbackSecondaryTextBlockStyle}"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                    <Button Content="{x:Static properties:Resources.Cancel}" Click="Cancel_Click"
                            Padding="18,6" Margin="0,0,10,0" IsCancel="True"/>
                    <Button x:Name="SendButton" Content="{x:Static properties:Resources.SendFeedback}"
                            Click="Send_Click" Padding="18,6" IsDefault="True"
                            Foreground="White" Background="{DynamicResource PrimaryBrush}"
                            BorderBrush="{DynamicResource PrimaryBrush}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
