<Window x:Class="ColorVision.UI.Desktop.Feedback.FeedbackDiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:properties="clr-namespace:ColorVision.UI.Desktop.Properties"
        Title="{x:Static properties:Resources.DiagnosticItems}"
        Background="{DynamicResource GlobalBackground}"
        Width="700" Height="620" MinWidth="580" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        KeyboardNavigation.TabNavigation="Cycle"
        FocusManager.FocusedElement="{Binding ElementName=SearchTextBox}">
    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="{x:Static properties:Resources.FeedbackDiagnosticSelectionHint}"
                   Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
        <Grid Grid.Row="1" Margin="0,14,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBox x:Name="SearchTextBox" Padding="8,5"
                     AutomationProperties.Name="{x:Static properties:Resources.FeedbackSearchDiagnostics}"
                     ToolTip="{x:Static properties:Resources.FeedbackSearchDiagnostics}"
                     TextChanged="Search_TextChanged"/>
            <TextBlock Text="{x:Static properties:Resources.FeedbackSearchDiagnostics}"
                       Margin="9,0" Foreground="{DynamicResource SecondaryTextBrush}" IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}" Value="">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <WrapPanel Grid.Row="1" Margin="0,10,0,0">
                <Button x:Name="SelectAllButton" Content="{x:Static properties:Resources.FeedbackSelectAll}"
                        Click="SelectAll_Click" Padding="10,4" Margin="0,0,8,0"/>
                <Button x:Name="SelectNoneButton" Content="{x:Static properties:Resources.FeedbackSelectNone}"
                        Click="SelectNone_Click" Padding="10,4" Margin="0,0,8,0"/>
                <Button x:Name="RestoreDefaultsButton" Content="{x:Static properties:Resources.FeedbackRestoreDefaults}"
                        Click="RestoreDefaults_Click" Padding="10,4"/>
            </WrapPanel>
        </Grid>
        <Border Grid.Row="2" BorderBrush="{DynamicResource GlobalBorderBrush1}" BorderThickness="1" CornerRadius="4">
            <Grid>
                <ScrollViewer x:Name="DiagnosticItemsScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="CollectorsList" Background="Transparent"
                                  AutomationProperties.Name="{x:Static properties:Resources.DiagnosticItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Padding="10,8" Margin="10,0"
                                          HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                                          Foreground="{DynamicResource GlobalTextBrush}"
                                          AutomationProperties.Name="{Binding Name, Mode=OneWay}"
                                          AutomationProperties.HelpText="{Binding Description, Mode=OneWay}">
                                    <StackPanel Margin="8,0,0,0">
                                        <TextBlock Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" ToolTip="{Binding Name, Mode=OneWay}"/>
                                        <TextBlock Text="{Binding Description, Mode=OneWay}" Margin="0,3,0,0" FontSize="12"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" ToolTip="{Binding Description, Mode=OneWay}"/>
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock Text="{x:Static properties:Resources.FeedbackNoMatchingDiagnostics}" Margin="16" TextWrapping="Wrap"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasItems, ElementName=CollectorsList}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
        <Grid x:Name="SelectionFooter" Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SelectionSummaryText" AutomationProperties.LiveSetting="Polite"/>
            <Button x:Name="DoneButton" Grid.Column="1" Content="{x:Static properties:Resources.Finish}"
                    IsDefault="True" IsCancel="True" Click="Done_Click" Padding="20,6"
                    Foreground="White" Background="{DynamicResource PrimaryBrush}" BorderBrush="{DynamicResource PrimaryBrush}"/>
        </Grid>
    </Grid>
</Window>
