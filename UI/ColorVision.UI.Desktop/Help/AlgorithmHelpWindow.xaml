<Window x:Class="ColorVision.UI.Desktop.Help.AlgorithmHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Width="1120" Height="850" MinWidth="680" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource GlobalBackground}"
        Foreground="{DynamicResource GlobalTextBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Padding="16,10" BorderBrush="{DynamicResource GlobalBorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="OnlineButton" Padding="12,5" Margin="0,0,8,0" Click="OnlineButton_Click" />
                    <Button x:Name="CopyLinkButton" Padding="12,5" Margin="0,0,8,0" Click="CopyLinkButton_Click" />
                    <Button x:Name="PrintButton" Padding="12,5" IsEnabled="False" Click="PrintButton_Click" />
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock x:Name="TopicTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="VersionText" FontSize="12" Opacity="0.7" Margin="0,3,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>
        <wv2:WebView2 x:Name="Browser" Grid.Row="1" />
        <TextBlock x:Name="StatusText" Grid.Row="1" Margin="28" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="560" />
    </Grid>
</Window>
