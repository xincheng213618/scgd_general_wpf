<Window x:Class="ColorVision.UI.DisplayControlManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:properties="clr-namespace:ColorVision.UI.Properties"
        xmlns:controls="clr-namespace:ColorVision.Themes.Controls;assembly=ColorVision.Themes"
        Title="{x:Static properties:Resources.DisplayControlManagerTitle}" Width="900" Height="550" MinWidth="800" MinHeight="420"
        Background="{DynamicResource GlobalBackground}" Foreground="{DynamicResource GlobalTextBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" ShowInTaskbar="False">
    <Window.Resources>
        <SolidColorBrush x:Key="SelectionSurface" Color="{DynamicResource CV.Color.Accent.Primary}" Opacity="0.08" />
        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <ControlTemplate x:Key="ActionTemplate" TargetType="ButtonBase">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="Transparent"
                    BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Surface" Property="Background" Value="{DynamicResource CV.Tag.Background}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.6" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.3" /></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="RowAction" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template" Value="{StaticResource ActionTemplate}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}, TargetNullValue={x:Static properties:Resources.DisplayControlGroupActions}, FallbackValue={x:Static properties:Resources.DisplayControlGroupActions}}" />
        </Style>
        <Style x:Key="StateToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template" Value="{StaticResource ActionTemplate}" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                    <Setter Property="Background" Value="{StaticResource SelectionSurface}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ExpandGlyph" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
            <Setter Property="Text" Value="&#xE70D;" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="False">
                    <Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="-90" /></Setter.Value></Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <ContextMenu x:Key="GroupMenu" x:Shared="False"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" Opened="GroupMenu_Opened">
            <MenuItem Header="{x:Static properties:Resources.Rename}" Click="RenameGroup_Click">
                <MenuItem.Icon><TextBlock Text="&#xE70F;" Style="{StaticResource Icon}" /></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="{x:Static properties:Resources.DisplayControlGroupMoveUp}" Tag="-1" Click="MoveGroupUp_Click">
                <MenuItem.Icon><TextBlock Text="&#xE74A;" Style="{StaticResource Icon}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{x:Static properties:Resources.DisplayControlGroupMoveDown}" Tag="1" Click="MoveGroupDown_Click">
                <MenuItem.Icon><TextBlock Text="&#xE74B;" Style="{StaticResource Icon}" /></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="{x:Static properties:Resources.DisplayControlDeleteGroup}" Tag="Delete" Click="DeleteGroup_Click">
                <MenuItem.Icon><TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" /></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
        <Style x:Key="GroupRow" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}" />
            <Setter Property="ContextMenu" Value="{StaticResource GroupMenu}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Surface" Background="Transparent" CornerRadius="5" BorderBrush="Transparent" BorderThickness="1" Padding="3">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource CV.Surface.ControlHover}" /></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource SelectionSurface}" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Height" Value="34" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{DynamicResource CV.Surface.Control}" BorderBrush="{DynamicResource CV.Border.Weak}" BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TextColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource ColumnHeader}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style x:Key="ControlRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource CV.Border.Weak}" BorderThickness="0,0,0,1">
                            <DataGridCellsPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource CV.Surface.ControlHover}" /></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource SelectionSurface}" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ControlCell" TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="24,18,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="{x:Static properties:Resources.DisplayControlsTitle}" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="{x:Static properties:Resources.DisplayControlsDescription}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,6,0,0" />
        </StackPanel>
        <Border Grid.Row="1" BorderBrush="{DynamicResource CV.Border.Control}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="194" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Margin="10,12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <DockPanel Margin="8,0,4,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource RowAction}" Click="CreateGroup_Click" ToolTip="{x:Static properties:Resources.DisplayControlCreateGroup}">
                            <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" />
                        </Button>
                        <TextBlock Text="{x:Static properties:Resources.DisplayControlGroup}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <ListBox x:Name="GroupsListBox" Grid.Row="1" ItemsSource="{Binding Groups}" ItemContainerStyle="{StaticResource GroupRow}"
                             Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="34">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="28" /></Grid.ColumnDefinitions>
                                    <ToggleButton Style="{StaticResource StateToggle}" Background="Transparent" Foreground="{DynamicResource SecondaryTextBrush}"
                                                  IsChecked="{Binding IsExpanded, Mode=OneWay}" Click="GroupExpanded_Click"
                                                  ToolTip="{x:Static properties:Resources.DisplayControlExpandGroupHint}" AutomationProperties.Name="{Binding Name, StringFormat={x:Static properties:Resources.DisplayControlExpandGroupAccessible}}">
                                        <TextBlock Style="{StaticResource ExpandGlyph}" />
                                    </ToggleButton>
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center" Margin="4,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}" />
                                    <Button Grid.Column="2" Style="{StaticResource RowAction}" Click="GroupActions_Click" ToolTip="{x:Static properties:Resources.DisplayControlGroupActions}">
                                        <TextBlock Text="&#xE712;" Style="{StaticResource Icon}" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
                <Border Grid.Column="1" Background="{DynamicResource CV.Border.Weak}" />
                <Grid Grid.Column="2" Margin="16,12,12,12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,8" Height="28">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Controls.Count, StringFormat={x:Static properties:Resources.DisplayControlItemCount}}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Static properties:Resources.DisplayControlAllItems}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <DataGrid x:Name="ControlsDataGrid" Grid.Row="1" ItemsSource="{Binding Controls}"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                              CanUserSortColumns="False" CanUserResizeRows="False" CanUserResizeColumns="False"
                              IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" SelectionUnit="FullRow"
                              Background="Transparent" BorderThickness="0" Padding="0" GridLinesVisibility="None" RowHeight="44"
                              RowStyle="{StaticResource ControlRow}" CellStyle="{StaticResource ControlCell}" ColumnHeaderStyle="{StaticResource ColumnHeader}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="*" MinWidth="136" Header="{x:Static properties:Resources.DisplayControlName}" HeaderStyle="{StaticResource TextColumnHeader}">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}">
                                        <TextBlock.Style><Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}" />
                                            <Style.Triggers><DataTrigger Binding="{Binding IsVisible}" Value="False"><Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" /></DataTrigger></Style.Triggers>
                                        </Style></TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="138" Header="{x:Static properties:Resources.DisplayControlGroup}" HeaderStyle="{StaticResource TextColumnHeader}">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <ComboBox Height="28" MinHeight="0" Padding="7,2" Background="Transparent" BorderThickness="0" BorderBrush="{DynamicResource SecondaryTextBrush}"
                                              ItemsSource="{Binding DataContext.Groups, RelativeSource={RelativeSource AncestorType=Window}}"
                                              DisplayMemberPath="DisplayName" SelectedValuePath="Id" ToolTip="{x:Static properties:Resources.DisplayControlMoveToGroupHint}" AutomationProperties.Name="{Binding Name, StringFormat={x:Static properties:Resources.DisplayControlGroupAccessible}}"
                                              SelectedValue="{Binding GroupId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="60" Header="{x:Static properties:Resources.DisplayControlVisible}">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <controls:ToggleSwitch HorizontalAlignment="Center" IsChecked="{Binding IsVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                           ToolTip="{x:Static properties:Resources.DisplayControlVisibilityTooltip}" AutomationProperties.Name="{Binding Name, StringFormat={x:Static properties:Resources.DisplayControlShowAccessible}}" />
                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="48" Header="{x:Static properties:Resources.DisplayControlPinned}">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <ToggleButton Style="{StaticResource StateToggle}" IsChecked="{Binding IsPinned, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="{x:Static properties:Resources.DisplayControlPinTooltip}" AutomationProperties.Name="{Binding Name, StringFormat={x:Static properties:Resources.DisplayControlPinAccessible}}">
                                        <TextBlock Text="&#xE718;" Style="{StaticResource Icon}" />
                                    </ToggleButton>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="72" Header="{x:Static properties:Resources.DisplayControlExpanded}">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <ToggleButton Style="{StaticResource StateToggle}" IsChecked="{Binding IsExpanded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="{x:Static properties:Resources.DisplayControlExpandTooltip}" AutomationProperties.Name="{Binding Name, StringFormat={x:Static properties:Resources.DisplayControlExpandAccessible}}">
                                        <TextBlock Style="{StaticResource ExpandGlyph}" />
                                    </ToggleButton>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="72" Header="{x:Static properties:Resources.DisplayControlOrder}">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Style="{StaticResource RowAction}" Click="MoveControlUp_Click" ToolTip="{x:Static properties:Resources.DisplayControlMoveUp}">
                                            <TextBlock Text="&#xE74A;" Style="{StaticResource Icon}" FontSize="12" />
                                        </Button>
                                        <Button Style="{StaticResource RowAction}" Click="MoveControlDown_Click" ToolTip="{x:Static properties:Resources.DisplayControlMoveDown}">
                                            <TextBlock Text="&#xE74B;" Style="{StaticResource Icon}" FontSize="12" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="1" Text="{x:Static properties:Resources.DisplayControlEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" IsHitTestVisible="False">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers><DataTrigger Binding="{Binding Controls.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                        </Style></TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>
        </Border>
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="{x:Static properties:Resources.DisplayControlVisibilityHint}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,20,0" />
            <Button Grid.Column="1" MinWidth="84" Height="32" Padding="16,4" IsCancel="True" Content="{x:Static properties:Resources.Close}" />
        </Grid>
    </Grid>
</Window>
