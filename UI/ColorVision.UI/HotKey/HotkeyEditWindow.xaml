<Window x:Class="ColorVision.UI.HotKey.HotkeyEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ColorVision.UI.HotKey"
        Title="{x:Static local:HotkeyEditorText.EditTitle}" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" PreviewKeyDown="Window_PreviewKeyDown" Foreground="{DynamicResource GlobalTextBrush}">
    <Grid Margin="26">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource GlobalTextBrush}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Description}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,7,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,24,0,0">
            <TextBlock Text="{x:Static local:HotkeyEditorText.Record}" Foreground="{DynamicResource GlobalTextBrush}" FontWeight="SemiBold"/>
            <TextBlock Text="{x:Static local:HotkeyEditorText.RecordHelp}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,6,0,12" TextWrapping="Wrap"/>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="CaptureBox" IsReadOnly="True" IsReadOnlyCaretVisible="False" InputMethod.IsInputMethodEnabled="False" Height="48" FontSize="18" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                         ContextMenu="{x:Null}" AutomationProperties.Name="{x:Static local:HotkeyEditorText.CaptureLabel}"/>
                <Button x:Name="ClearButton" Grid.Column="1" Content="{x:Static local:HotkeyEditorText.ClearValue}" Click="Clear_Click" Margin="10,0,0,0" Padding="10,4"/>
            </Grid>
            <TextBlock x:Name="DefaultText" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/>
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive"/>
        </StackPanel>
        <Border Grid.Row="2" Margin="0,22,0,0" Padding="0,18,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource GlobalBorderBrush}">
            <StackPanel>
                <CheckBox x:Name="GlobalCheckBox" Foreground="{DynamicResource GlobalTextBrush}" Content="{x:Static local:HotkeyEditorText.GlobalOption}"/>
                <TextBlock Text="{x:Static local:HotkeyEditorText.GlobalHelp}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,7,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="3" HorizontalAlignment="Right" Margin="0,24,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="{x:Static local:HotkeyEditorText.Cancel}" Click="Cancel_Click" MinWidth="78" Padding="14,7"/>
                <Button x:Name="SaveButton" Content="{x:Static local:HotkeyEditorText.Apply}" Click="Save_Click" MinWidth="78" Padding="14,7" Margin="10,0,0,0"
                        Background="{DynamicResource PrimaryBrush}" Foreground="White" BorderThickness="0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
