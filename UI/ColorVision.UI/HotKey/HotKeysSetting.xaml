<UserControl x:Class="ColorVision.UI.HotKey.HotKeysSetting"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ColorVision.UI.HotKey"
             MinWidth="420" UseLayoutRounding="True" Foreground="{DynamicResource GlobalTextBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderThickness="1" BorderBrush="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource SecondaryRegionBrush}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.35"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="TextAction" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <Grid Margin="0,0,0,22">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{x:Static local:HotkeyEditorText.Subtitle}" Foreground="{DynamicResource SecondaryTextBrush}"
                       TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,20,0"/>
            <Button Grid.Column="1" Content="{x:Static local:HotkeyEditorText.ResetAll}" Padding="12,6" MinHeight="32"
                    IsEnabled="{Binding HasCustomizations}" Click="ResetAll_Click"/>
        </Grid>
        <Border CornerRadius="18" Background="{DynamicResource GlobalBackground}" BorderBrush="{DynamicResource GlobalBorderBrush}" BorderThickness="1" Padding="12,2">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                <TextBox x:Name="SearchBox" Grid.Column="1" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Background="Transparent"
                         BorderThickness="0" MinHeight="34" Padding="8,6" VerticalContentAlignment="Center"
                         AutomationProperties.Name="{x:Static local:HotkeyEditorText.Search}" ToolTip="{x:Static local:HotkeyEditorText.KeyboardHint}"/>
                <TextBlock Grid.Column="1" Text="{x:Static local:HotkeyEditorText.Search}" Margin="10,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}" IsHitTestVisible="False">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                    </Style></TextBlock.Style>
                </TextBlock>
                <Button Grid.Column="2" Style="{StaticResource ActionButton}" Visibility="{Binding HasSearch, Converter={StaticResource BoolVisibility}}"
                        Click="ClearSearch_Click" ToolTip="{x:Static local:HotkeyEditorText.ClearSearch}" AutomationProperties.Name="{x:Static local:HotkeyEditorText.ClearSearch}">
                    <TextBlock Text="&#xE711;" Style="{StaticResource Icon}"/>
                </Button>
            </Grid>
        </Border>
        <Grid Margin="2,12,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Summary}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" Foreground="{DynamicResource SecondaryTextBrush}"/>
            <ComboBox x:Name="StateFilter" Grid.Column="1" SelectedIndex="{Binding FilterIndex}" MinWidth="112" MinHeight="32" AutomationProperties.Name="{x:Static local:HotkeyEditorText.Filter}">
                <ComboBoxItem Content="{x:Static local:HotkeyEditorText.All}"/>
                <ComboBoxItem Content="{x:Static local:HotkeyEditorText.Unassigned}"/>
                <ComboBoxItem Content="{x:Static local:HotkeyEditorText.Modified}"/>
            </ComboBox>
        </Grid>
        <Border Background="{DynamicResource GlobalBackground}" BorderBrush="{DynamicResource ButtonBorderBrush}" BorderThickness="1" CornerRadius="12">
            <Grid>
                <ItemsControl x:Name="ShortcutList" ItemsSource="{Binding Rows}" Margin="18,2" Grid.IsSharedSizeScope="True">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource ButtonBorderBrush}" BorderThickness="0,0,0,1" Padding="0,17">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*" MinWidth="215"/></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center" ToolTip="{Binding Details}">
                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource GlobalTextBrush}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                        <WrapPanel Margin="0,5,0,0">
                                            <TextBlock Text="{x:Static local:HotkeyEditorText.Modified}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,0,12,0"
                                                       ToolTip="{Binding DefaultShortcut}" Visibility="{Binding IsModified, Converter={StaticResource BoolVisibility}}"/>
                                            <TextBlock Text="{x:Static local:HotkeyEditorText.Global}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"
                                                       Visibility="{Binding IsGlobal, Converter={StaticResource BoolVisibility}}"/>
                                        </WrapPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <ItemsControl ItemsSource="{Binding Bindings}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid MinHeight="36">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                                                        <Grid VerticalAlignment="Center" HorizontalAlignment="Left">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                                                            <Button Style="{StaticResource TextAction}" Click="Edit_Click" ToolTip="{Binding EditLabel}" AutomationProperties.Name="{Binding EditLabel}">
                                                                <Border CornerRadius="11" Background="{DynamicResource SecondaryRegionBrush}" Padding="9,3">
                                                                    <TextBlock Text="{Binding Shortcut}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                                </Border>
                                                            </Button>
                                                            <Button Grid.Column="1" Style="{StaticResource ActionButton}" Click="Edit_Click" ToolTip="{Binding EditLabel}" AutomationProperties.Name="{Binding EditLabel}">
                                                                <TextBlock Text="&#xE70F;" Style="{StaticResource Icon}"/>
                                                            </Button>
                                                        </Grid>
                                                        <Button Grid.Column="1" Style="{StaticResource ActionButton}" Click="Clear_Click" ToolTip="{Binding ClearLabel}" AutomationProperties.Name="{Binding ClearLabel}">
                                                            <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}"/>
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Grid MinHeight="32">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <Button Style="{StaticResource TextAction}" Click="Add_Click" ToolTip="{x:Static local:HotkeyEditorText.Add}" AutomationProperties.Name="{x:Static local:HotkeyEditorText.Add}"
                                                        Visibility="{Binding IsUnassigned, Converter={StaticResource BoolVisibility}}">
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="{x:Static local:HotkeyEditorText.Unassigned}" VerticalAlignment="Center"/><TextBlock Text="&#xE70F;" Style="{StaticResource Icon}" Margin="10,0,0,0"/></StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource TextAction}" Click="Add_Click" Content="{x:Static local:HotkeyEditorText.Add}" FontSize="12"
                                                        Visibility="{Binding IsAssigned, Converter={StaticResource BoolVisibility}}"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource ActionButton}" Click="Reset_Click" ToolTip="{Binding DefaultShortcut}" AutomationProperties.Name="{x:Static local:HotkeyEditorText.Reset}"
                                                    Visibility="{Binding IsModified, Converter={StaticResource BoolVisibility}}">
                                                <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}"/>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Margin="24,36" HorizontalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}">
                    <TextBlock Text="{Binding EmptyTitle}" Foreground="{DynamicResource GlobalTextBrush}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding EmptyHelp}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                    <Button Content="{x:Static local:HotkeyEditorText.ClearFilters}" Click="ClearFilters_Click" Margin="0,14,0,0" Padding="10,5" MinHeight="32" HorizontalAlignment="Center"
                            Visibility="{Binding HasFilter, Converter={StaticResource BoolVisibility}}"/>
                </StackPanel>
            </Grid>
        </Border>
        <TextBlock Text="{Binding Status}" Margin="2,12,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Visibility="{Binding HasStatus, Converter={StaticResource BoolVisibility}}">
            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                <Style.Triggers><DataTrigger Binding="{Binding IsError}" Value="True"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/></DataTrigger></Style.Triggers>
            </Style></TextBlock.Style>
        </TextBlock>
    </StackPanel>
</UserControl>
