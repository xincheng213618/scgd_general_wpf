<UserControl x:Class="ColorVision.UI.HotKey.HotKeysSetting"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ColorVision.UI.HotKey"
             MinWidth="420" UseLayoutRounding="True" Foreground="{DynamicResource GlobalTextBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderThickness="1" BorderBrush="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource SecondaryRegionBrush}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.35"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <Grid Margin="0,0,0,22">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{x:Static local:HotkeyEditorText.Subtitle}" Foreground="{DynamicResource SecondaryTextBrush}"
                       TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,20,0"/>
            <Button Grid.Column="1" Content="{x:Static local:HotkeyEditorText.ResetAll}" Padding="12,6" MinHeight="32"
                    IsEnabled="{Binding HasCustomizations}" Click="ResetAll_Click"/>
        </Grid>
        <Border CornerRadius="18" Background="{DynamicResource GlobalBackground}" BorderBrush="{DynamicResource GlobalBorderBrush}" BorderThickness="1" Padding="12,2">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                <TextBox x:Name="SearchBox" Grid.Column="1" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Background="Transparent"
                         BorderThickness="0" MinHeight="34" Padding="8,6" VerticalContentAlignment="Center"
                         AutomationProperties.Name="{x:Static local:HotkeyEditorText.Search}" ToolTip="{x:Static local:HotkeyEditorText.KeyboardHint}"/>
                <TextBlock Grid.Column="1" Text="{x:Static local:HotkeyEditorText.Search}" Margin="10,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}" IsHitTestVisible="False">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                    </Style></TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
        <TextBlock Text="{Binding Summary}" FontSize="12" Margin="2,12,0,12" Foreground="{DynamicResource SecondaryTextBrush}"/>
        <Border Background="{DynamicResource GlobalBackground}" BorderBrush="{DynamicResource ButtonBorderBrush}" BorderThickness="1" CornerRadius="12">
            <Grid>
                <ItemsControl x:Name="ShortcutList" ItemsSource="{Binding Rows}" Margin="18,2" Grid.IsSharedSizeScope="True">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource ButtonBorderBrush}" BorderThickness="0,0,0,1" Padding="0,17">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto" SharedSizeGroup="ShortcutColumn"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center" ToolTip="{Binding Details}">
                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource GlobalTextBrush}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Grid Grid.Column="1" VerticalAlignment="Center" MinWidth="130">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Border CornerRadius="11" Background="{DynamicResource SecondaryRegionBrush}" Padding="9,3" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Shortcut}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                            </Border>
                                            <TextBlock Text="{x:Static local:HotkeyEditorText.Global}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="8,4,0,0"
                                                       Visibility="{Binding IsGlobal, Converter={StaticResource BoolVisibility}}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource ActionButton}" Click="Edit_Click" ToolTip="{x:Static local:HotkeyEditorText.Edit}" AutomationProperties.Name="{x:Static local:HotkeyEditorText.Edit}">
                                            <TextBlock Text="&#xE70F;" Style="{StaticResource Icon}"/>
                                        </Button>
                                    </Grid>
                                    <Border Grid.Column="2" Width="72" Margin="16,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                                            <Button Style="{StaticResource ActionButton}" Click="Reset_Click" ToolTip="{x:Static local:HotkeyEditorText.Reset}" AutomationProperties.Name="{x:Static local:HotkeyEditorText.Reset}">
                                                <Button.Visibility><Binding Path="IsModified" Converter="{StaticResource BoolVisibility}"/></Button.Visibility>
                                                <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}"/>
                                            </Button>
                                            <Button Grid.Column="1" Style="{StaticResource ActionButton}" Click="Clear_Click" IsEnabled="{Binding IsAssigned}" ToolTip="{x:Static local:HotkeyEditorText.Clear}" AutomationProperties.Name="{x:Static local:HotkeyEditorText.Clear}">
                                                <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Margin="24,36" HorizontalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}">
                    <TextBlock Text="{x:Static local:HotkeyEditorText.Empty}" Foreground="{DynamicResource GlobalTextBrush}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="{x:Static local:HotkeyEditorText.EmptyHelp}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
        <TextBlock Text="{Binding Status}" Margin="2,12,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Visibility="{Binding HasStatus, Converter={StaticResource BoolVisibility}}">
            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                <Style.Triggers><DataTrigger Binding="{Binding IsError}" Value="True"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/></DataTrigger></Style.Triggers>
            </Style></TextBlock.Style>
        </TextBlock>
    </StackPanel>
</UserControl>
