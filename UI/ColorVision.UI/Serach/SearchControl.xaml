<UserControl x:Class="ColorVision.UI.Serach.SearchControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ColorVision.UI.Serach"
             x:Name="RootControl" UseLayoutRounding="True"
             Foreground="{DynamicResource GlobalTextBrush}" Background="Transparent"
             KeyboardNavigation.TabNavigation="Cycle" PreviewKeyDown="Palette_PreviewKeyDown">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
        <Style x:Key="PaletteIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PaletteButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                                BorderThickness="1" BorderBrush="Transparent" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource SecondaryRegionBrush}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBoxItem" x:Key="ResultItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="4,1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="ToolTip" Value="{Binding Details}"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                                BorderBrush="Transparent" BorderThickness="1" CornerRadius="6">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource SecondaryRegionBrush}"/></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SecondaryRegionBrush}"/>
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsAvailable}" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.5"/></DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border x:Name="PaletteRoot" Background="{DynamicResource GlobalBackground}" BorderBrush="{DynamicResource GlobalBorderBrush}"
            BorderThickness="1" CornerRadius="12" Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Margin="4,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{x:Static local:SearchPaletteText.Title}" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Style="{StaticResource PaletteButton}" Click="Close_Click"
                        ToolTip="{x:Static local:SearchPaletteText.Close}" AutomationProperties.Name="{x:Static local:SearchPaletteText.Close}">
                    <TextBlock Text="&#xE711;" Style="{StaticResource PaletteIcon}" FontSize="12"/>
                </Button>
            </Grid>
            <Border Grid.Row="1" Background="{DynamicResource RegionBrush}" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1" CornerRadius="7" Padding="10,3">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE721;" Style="{StaticResource PaletteIcon}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBox x:Name="Searchbox" Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent" BorderThickness="0" Padding="8,8" FontSize="15" MinHeight="38"
                             VerticalContentAlignment="Center" MaxLength="256"
                             AutomationProperties.Name="{x:Static local:SearchPaletteText.Placeholder}"/>
                    <TextBlock Grid.Column="1" Text="{x:Static local:SearchPaletteText.Placeholder}" Margin="10,0,0,0"
                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers><DataTrigger Binding="{Binding SearchText}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                        </Style></TextBlock.Style>
                    </TextBlock>
                    <Button Grid.Column="2" Style="{StaticResource PaletteButton}" Click="Clear_Click"
                            Visibility="{Binding HasSearch, Converter={StaticResource BoolVisibility}}"
                            ToolTip="{x:Static local:SearchPaletteText.Clear}" AutomationProperties.Name="{x:Static local:SearchPaletteText.Clear}">
                        <TextBlock Text="&#xE894;" Style="{StaticResource PaletteIcon}" FontSize="14"/>
                    </Button>
                </Grid>
            </Border>
            <Grid Grid.Row="2" Margin="4,10,4,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" AutomationProperties.LiveSetting="Polite"/>
                <ComboBox x:Name="CategoryFilter" Grid.Column="1" MinWidth="116" MinHeight="30"
                          ItemsSource="{Binding Categories}" DisplayMemberPath="Label" SelectedItem="{Binding Category}"
                          AutomationProperties.Name="{x:Static local:SearchPaletteText.Filter}"/>
            </Grid>
            <Grid Grid.Row="3">
                <ListBox x:Name="ListViewSearch" ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}"
                         Background="Transparent" Foreground="{DynamicResource GlobalTextBrush}" BorderThickness="0" MaxHeight="380"
                         HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling" ItemContainerStyle="{StaticResource ResultItem}"
                         PreviewMouseLeftButtonUp="Result_MouseLeftButtonUp" SelectionChanged="Result_SelectionChanged"
                         AutomationProperties.Name="{x:Static local:SearchPaletteText.Title}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource PaletteIcon}" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Left"/>
                                <StackPanel Grid.Column="1" Margin="4,0,12,0">
                                    <local:SearchHighlightTextBlock ContentText="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource GlobalTextBrush}"
                                        Query="{Binding DataContext.SearchText, RelativeSource={RelativeSource AncestorType=ListBox}}" AutomationProperties.Name="{Binding Title}"/>
                                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" MaxWidth="195">
                                    <Border Background="{DynamicResource SecondaryRegionBrush}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right"
                                            Visibility="{Binding HasShortcut, Converter={StaticResource BoolVisibility}}">
                                        <TextBlock Text="{Binding ShortcutText}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                    <TextBlock Text="{Binding Category}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16,24" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}">
                    <TextBlock Text="{x:Static local:SearchPaletteText.NoResults}" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center"/>
                    <TextBlock Text="{x:Static local:SearchPaletteText.NoResultsHelp}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,8,0,0"
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420"/>
                </StackPanel>
                <ProgressBar Height="2" IsIndeterminate="True" VerticalAlignment="Top" Visibility="{Binding IsSearching, Converter={StaticResource BoolVisibility}}"/>
            </Grid>
            <TextBlock Grid.Row="4" Text="{Binding Status}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="4,8"
                       Visibility="{Binding HasStatus, Converter={StaticResource BoolVisibility}}" AutomationProperties.LiveSetting="Polite"/>
            <Border Grid.Row="5" BorderBrush="{DynamicResource GlobalBorderBrush}" BorderThickness="0,1,0,0" Padding="4,8,0,0" Margin="0,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static local:SearchPaletteText.KeyboardHint}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    <Button Grid.Column="1" Content="{x:Static local:SearchPaletteText.Settings}" Style="{StaticResource PaletteButton}" Click="Settings_Click" FontSize="12"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
