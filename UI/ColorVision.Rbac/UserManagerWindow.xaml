<Window x:Class="ColorVision.Rbac.UserManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ColorVision.Rbac"
        xmlns:properties="clr-namespace:ColorVision.Solution.Properties;assembly=ColorVision.Solution"
        Title="{x:Static properties:Resources.Sol_UserMgr_Title}" Height="820" Width="1180"
        MinHeight="740" MinWidth="1020" WindowStartupLocation="CenterOwner" Initialized="Window_Initialized"
        Background="{DynamicResource UpdateDialog.Background}" Foreground="{DynamicResource UpdateDialog.TextPrimary}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ColorVision.Themes;component/Themes/UpdateDialogTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <local:BoolToColorConverter x:Key="BoolToColorConverter"/>
            <local:BoolToStatusTextConverter x:Key="BoolToStatusTextConverter"/>
            <local:BoolToYesNoConverter x:Key="BoolToYesNoConverter"/>
            <local:BoolToToggleIconConverter x:Key="BoolToToggleIconConverter"/>
            <local:BoolToToggleTooltipConverter x:Key="BoolToToggleTooltipConverter"/>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource UpdateDialog.TextPrimary}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="Background" Value="{DynamicResource UpdateDialog.Surface}"/>
                <Setter Property="Foreground" Value="{DynamicResource UpdateDialog.TextPrimary}"/>
                <Setter Property="CaretBrush" Value="{DynamicResource UpdateDialog.TextPrimary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource UpdateDialog.Border}"/>
                <Setter Property="Padding" Value="10,7"/>
                <Setter Property="MinHeight" Value="36"/>
            </Style>
            <Style TargetType="ListView" BasedOn="{StaticResource {x:Type ListView}}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource UpdateDialog.TextPrimary}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            </Style>
            <Style x:Key="ManagementHeaderStyle" TargetType="GridViewColumnHeader" BasedOn="{StaticResource {x:Type GridViewColumnHeader}}">
                <Setter Property="Background" Value="{DynamicResource UpdateDialog.Surface}"/>
                <Setter Property="Foreground" Value="{DynamicResource UpdateDialog.TextSecondary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource UpdateDialog.WeakBorder}"/>
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>
            <Style x:Key="ManagementRowStyle" TargetType="ListViewItem">
                <Setter Property="Foreground" Value="{DynamicResource UpdateDialog.TextPrimary}"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="12,10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <Border x:Name="RowBorder" Background="Transparent"
                                    BorderBrush="{DynamicResource UpdateDialog.WeakBorder}" BorderThickness="0,0,0,1">
                                <GridViewRowPresenter Margin="{TemplateBinding Padding}" Content="{TemplateBinding Content}"
                                                      Columns="{Binding View.Columns, RelativeSource={RelativeSource AncestorType=ListView}}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource UpdateDialog.SurfaceHover}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource UpdateDialog.TagBackground}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="RowActionButtonStyle" TargetType="Button" BasedOn="{StaticResource UpdateDialogSecondaryButtonStyle}">
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="MinHeight" Value="0"/>
            </Style>
            <Style x:Key="SectionCard" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource UpdateDialog.Surface}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource UpdateDialog.WeakBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="18"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="30,28,30,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border BorderBrush="{DynamicResource UpdateDialog.Border}" BorderThickness="0,0,0,1" Padding="0,0,0,22" Margin="0,0,0,22">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{x:Static properties:Resources.Sol_UserMgr_Label}" FontSize="28" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtStatusInfo" Margin="0,8,0,0" FontSize="13" Foreground="{DynamicResource UpdateDialog.TextSecondary}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button Content="{x:Static properties:Resources.Sol_UserMgr_Refresh}"
                            Style="{StaticResource UpdateDialogTextButtonStyle}" Click="BtnRefresh_Click" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="TxtSessionInfo" Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource UpdateDialog.TextSecondary}"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource SectionCard}" Margin="0,0,0,18">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="{x:Static properties:Resources.Sol_UserMgr_RoleMgmt}" FontSize="17" FontWeight="SemiBold"/>
                    <Button Content="{x:Static properties:Resources.Sol_UserMgr_PermMgmt}" HorizontalAlignment="Right"
                            Style="{StaticResource UpdateDialogTextButtonStyle}" Click="BtnOpenPermissionManager_Click"/>
                </Grid>
                <Grid Grid.Row="1" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="1.4*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{x:Static properties:Resources.Sol_UserMgr_RoleName}" FontSize="12" Margin="0,0,0,6" Foreground="{DynamicResource UpdateDialog.TextSecondary}"/>
                        <TextBox x:Name="TxtRoleName" ToolTip="{x:Static properties:Resources.Sol_UserMgr_RoleNameTooltip}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{x:Static properties:Resources.Sol_UserMgr_RoleCode}" FontSize="12" Margin="0,0,0,6" Foreground="{DynamicResource UpdateDialog.TextSecondary}"/>
                        <TextBox x:Name="TxtRoleCode" ToolTip="{x:Static properties:Resources.Sol_UserMgr_RoleCodeTooltip}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="{x:Static properties:Resources.Sol_UserMgr_Remark}" FontSize="12" Margin="0,0,0,6" Foreground="{DynamicResource UpdateDialog.TextSecondary}"/>
                        <TextBox x:Name="TxtRoleRemark" ToolTip="{x:Static properties:Resources.Sol_UserMgr_RemarkTooltip}"/>
                    </StackPanel>
                    <Button Grid.Column="6" Content="{x:Static properties:Resources.Sol_UserMgr_CreateRole}" VerticalAlignment="Bottom"
                            Style="{StaticResource UpdateDialogSecondaryButtonStyle}" Click="BtnCreateRole_Click"/>
                </Grid>
                <ListView ItemContainerStyle="{StaticResource ManagementRowStyle}" x:Name="RolesListView" Grid.Row="2" Height="96" Margin="0,18,0,0">
                    <ListView.View>
                        <GridView ColumnHeaderContainerStyle="{StaticResource ManagementHeaderStyle}">
                            <GridViewColumn Header="{x:Static properties:Resources.Sol_UserMgr_Col_RoleName}" Width="140">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{x:Static properties:Resources.Sol_UserMgr_Col_RoleCode}" Width="140" DisplayMemberBinding="{Binding Code}" />
                            <GridViewColumn Header="{x:Static properties:Resources.Sol_UserMgr_Col_Remark}" Width="220" DisplayMemberBinding="{Binding Remark}" />
                            <GridViewColumn Header="{x:Static properties:Resources.Sol_UserMgr_Col_Status}" Width="80">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border HorizontalAlignment="Left" Background="{Binding IsEnable, Converter={StaticResource BoolToColorConverter}}"
                                                CornerRadius="3" Padding="6,2">
                                            <TextBlock Text="{Binding IsEnable, Converter={StaticResource BoolToStatusTextConverter}}"
                                                       Foreground="White" FontSize="10" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{x:Static properties:Resources.Sol_UserMgr_Col_CreateTime}" Width="160" DisplayMemberBinding="{Binding CreatedAt, StringFormat='yyyy-MM-dd HH:mm:ss'}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource SectionCard}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{x:Static properties:Resources.Sol_UserMgr_UserList}" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtTotalCount" Margin="0,5,0,0" FontSize="12" Foreground="{DynamicResource UpdateDialog.TextSecondary}"/>
                    </StackPanel>
                    <Grid Grid.Column="1" Width="260" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBox x:Name="TxtSearch" Padding="34,7,10,7" TextChanged="TxtSearch_TextChanged"
                                 ToolTip="{x:Static properties:Resources.Sol_UserMgr_SearchTooltip}"/>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14" HorizontalAlignment="Left"
                                   Margin="12,0,0,0" IsHitTestVisible="False" Foreground="{DynamicResource UpdateDialog.TextSecondary}"/>
                    </Grid>
                    <Button Grid.Column="2" Content="{x:Static properties:Resources.Sol_UserMgr_CreateUser}" VerticalAlignment="Center"
                            Style="{StaticResource UpdateDialogPrimaryButtonStyle}" Click="BtnCreateUser_Click"
                            ToolTip="{x:Static properties:Resources.Sol_UserMgr_CreateUserTooltip}"/>
                </Grid>
                <ListView ItemContainerStyle="{StaticResource ManagementRowStyle}" x:Name="UsersListView" Grid.Row="1" Margin="0,16,0,0">
                <ListView.View>
                    <GridView ColumnHeaderContainerStyle="{StaticResource ManagementHeaderStyle}">
                        <GridViewColumn Header="{x:Static properties:Resources.Sol_UserMgr_Col_Username}" Width="120">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" 
                                                   FontSize="14" Foreground="{DynamicResource UpdateDialog.Accent}" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding Username}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="{x:Static properties:Resources.Sol_UserMgr_Col_Role}" Width="120">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding RolesDisplay}" ToolTip="{Binding RolesDisplay}"
                                               TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="{x:Static properties:Resources.Sol_UserMgr_Col_Remark}" Width="160">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Remark}" TextTrimming="CharacterEllipsis" 
                                               ToolTip="{Binding Remark}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="{x:Static properties:Resources.Sol_UserMgr_Col_Status}" Width="70">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border HorizontalAlignment="Left" Background="{Binding IsEnable, Converter={StaticResource BoolToColorConverter}}"
                                            CornerRadius="3" Padding="6,2">
                                        <TextBlock Text="{Binding IsEnable, Converter={StaticResource BoolToStatusTextConverter}}"
                                                   Foreground="White" FontSize="10" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="{x:Static properties:Resources.Sol_UserMgr_Col_Delete}" Width="50">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding IsDelete, Converter={StaticResource BoolToYesNoConverter}}"
                                               Foreground="{DynamicResource UpdateDialog.TextSecondary}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="{x:Static properties:Resources.Sol_UserMgr_Col_CreateTime}" Width="150" DisplayMemberBinding="{Binding CreatedAt, StringFormat='yyyy-MM-dd HH:mm:ss'}" />
                        <GridViewColumn Header="{x:Static properties:Resources.Sol_UserMgr_Col_Action}" Width="168">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="&#xE70F;" FontFamily="Segoe MDL2 Assets" Padding="6,3" Tag="{Binding}" Click="BtnEditRoles_Click"
                                                Style="{StaticResource RowActionButtonStyle}" FontSize="11" Margin="0,0,4,0" Width="32" Height="26"
                                                ToolTip="{x:Static properties:Resources.Sol_UserMgr_EditRoleTooltip}"/>
                                        <Button Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" Padding="6,3" Tag="{Binding}" Click="BtnDeleteUser_Click"
                                                Style="{StaticResource RowActionButtonStyle}" FontSize="11" Margin="0,0,4,0" Width="32" Height="26"
                                                ToolTip="{x:Static properties:Resources.Sol_UserMgr_DeleteUserTooltip}"/>
                                        <Button Content="{Binding IsEnable, Converter={StaticResource BoolToToggleIconConverter}}" FontFamily="Segoe MDL2 Assets" Padding="6,3" Tag="{Binding}" Click="BtnToggleUser_Click"
                                                Style="{StaticResource RowActionButtonStyle}" FontSize="11" Margin="0,0,4,0" Width="32" Height="26"
                                                >
                                            <Button.ToolTip>
                                                <TextBlock Text="{Binding IsEnable, Converter={StaticResource BoolToToggleTooltipConverter}}"/>
                                            </Button.ToolTip>
                                        </Button>
                                        <Button Content="&#xE72E;" FontFamily="Segoe MDL2 Assets" Padding="6,3" Tag="{Binding}" Click="BtnResetPassword_Click"
                                                Style="{StaticResource RowActionButtonStyle}" FontSize="11" Margin="0,0,0,0" Width="32" Height="26"
                                                ToolTip="{x:Static properties:Resources.Sol_UserMgr_ResetPwdTooltip}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
            </Grid>
        </Border>
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="TxtCacheStats" FontSize="11" Foreground="{DynamicResource UpdateDialog.TextSecondary}"
                       TextTrimming="CharacterEllipsis" Margin="0,0,16,0"/>
            <TextBlock Grid.Column="1" Text="{x:Static properties:Resources.Sol_UserMgr_DoubleClickHint}"
                       FontSize="11" Foreground="{DynamicResource UpdateDialog.TextSecondary}"/>
        </Grid>
    </Grid>
</Window>
