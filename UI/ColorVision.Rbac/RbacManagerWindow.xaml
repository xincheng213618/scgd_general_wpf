<Window x:Class="ColorVision.Rbac.RbacManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ColorVision.Rbac"
        xmlns:properties="clr-namespace:ColorVision.Solution.Properties;assembly=ColorVision.Solution"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:RbacManagerWindow}"
        Title="{x:Static properties:Resources.UserCenter}"
        Width="1120" Height="800" MinWidth="1000" MinHeight="650"
        Background="{DynamicResource UpdateDialog.Background}"
        Foreground="{DynamicResource UpdateDialog.TextPrimary}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterOwner"
        Initialized="Window_Initialized">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ColorVision.Themes;component/Themes/UpdateDialogTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="SectionCard" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource UpdateDialog.Surface}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource UpdateDialog.WeakBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="22"/>
            </Style>

            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource UpdateDialog.TextPrimary}"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <Style x:Key="MetricValue" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource UpdateDialog.TextPrimary}"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="TextTrimming" Value="None"/>
            </Style>

            <Style x:Key="MetricLabel" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{DynamicResource UpdateDialog.TextSecondary}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Margin" Value="0,5,0,0"/>
            </Style>

            <Style x:Key="DetailLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource UpdateDialog.TextSecondary}"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>

            <Style x:Key="DetailValue" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource UpdateDialog.TextPrimary}"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="30,28,30,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
            <Border Grid.Row="0"
                    Background="{DynamicResource UpdateDialog.Background}"
                    BorderBrush="{DynamicResource UpdateDialog.WeakBorder}"
                    BorderThickness="0,0,0,1"
                    Padding="0,0,0,22" Margin="0,0,0,22">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{x:Static properties:Resources.UserCenter}" FontSize="28" FontWeight="SemiBold"
                                   Foreground="{DynamicResource UpdateDialog.TextPrimary}"/>
                        <TextBlock Text="{x:Static local:UserCenterText.Description}"
                                   FontSize="13"
                                   Foreground="{DynamicResource UpdateDialog.TextSecondary}"
                                   Margin="0,8,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Command="{Binding LoginCommand}"
                                Style="{StaticResource UpdateDialogPrimaryButtonStyle}"
                                Margin="0,0,8,0"
                                Visibility="{Binding LoginButtonVisibility}"
                                ToolTip="{x:Static properties:Resources.Sol_RbacMgr_LoginTooltip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,6,0"/>
                                <TextBlock Text="{x:Static properties:Resources.LoginOrSwitch}"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding EditCommand}"
                                Style="{StaticResource UpdateDialogSecondaryButtonStyle}"
                                Margin="0,0,8,0"
                                Visibility="{Binding LoggedInButtonVisibility}"
                                ToolTip="{x:Static properties:Resources.Sol_RbacMgr_EditUserTooltip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,6,0"/>
                                <TextBlock Text="{x:Static properties:Resources.EditInfo}"/>
                            </StackPanel>
                        </Button>
                        <Button Click="BtnChangePassword_Click"
                                Style="{StaticResource UpdateDialogSecondaryButtonStyle}"
                                Margin="0,0,8,0"
                                Visibility="{Binding LoggedInButtonVisibility}"
                                ToolTip="{x:Static properties:Resources.Sol_RbacMgr_ChangePwdTooltip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,6,0"/>
                                <TextBlock Text="{x:Static properties:Resources.Sol_RbacMgr_ChangePwdLabel}"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenUserManagerCommand}"
                                Style="{StaticResource UpdateDialogSecondaryButtonStyle}"
                                Margin="0,0,8,0"
                                Visibility="{Binding AdminButtonVisibility}"
                                ToolTip="{x:Static properties:Resources.Sol_RbacMgr_UserMgmtTooltip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,6,0"/>
                                <TextBlock Text="{x:Static properties:Resources.UserManagement}"/>
                            </StackPanel>
                        </Button>
                        <Button Click="BtnLogout_Click"
                                Style="{StaticResource UpdateDialogSecondaryButtonStyle}"
                                Visibility="{Binding LoggedInButtonVisibility}"
                                ToolTip="{x:Static properties:Resources.Sol_RbacMgr_LogoutTooltip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,6,0"/>
                                <TextBlock Text="{x:Static properties:Resources.Sign_out}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="0,0,14,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,2,0,0">
                        <Border Width="64" Height="64" Background="{DynamicResource UpdateDialog.Surface}"
                                BorderBrush="{DynamicResource UpdateDialog.WeakBorder}" BorderThickness="1" CornerRadius="12" Padding="7">
                            <hc:Gravatar Id="{Binding Config.LoginResult.User.Username}" Width="48" Height="48"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Margin="18,0,0,0">
                            <TextBlock Text="{Binding CurrentUserDisplay}" FontSize="24" FontWeight="SemiBold"
                                       Foreground="{DynamicResource UpdateDialog.TextPrimary}"/>
                            <TextBlock Text="{Binding ProfileSubtitle}" FontSize="13" Margin="0,6,0,0"
                                       Foreground="{DynamicResource UpdateDialog.TextSecondary}"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Row="1" Style="{StaticResource SectionCard}" Padding="0" Margin="0,26,0,0">
                        <UniformGrid Columns="5" Height="88">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentSessionDisplay}" Style="{StaticResource MetricValue}"/>
                                <TextBlock Text="{x:Static local:UserCenterText.CurrentSession}" Style="{StaticResource MetricLabel}"/>
                            </StackPanel>
                            <Border BorderBrush="{DynamicResource UpdateDialog.WeakBorder}" BorderThickness="1,0,0,0">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TotalRunTimeDisplay}" Style="{StaticResource MetricValue}"/>
                                    <TextBlock Text="{x:Static local:UserCenterText.TotalRuntime}" Style="{StaticResource MetricLabel}"/>
                                </StackPanel>
                            </Border>
                            <Border BorderBrush="{DynamicResource UpdateDialog.WeakBorder}" BorderThickness="1,0,0,0">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding LaunchCountDisplay}" Style="{StaticResource MetricValue}"/>
                                    <TextBlock Text="{x:Static local:UserCenterText.LaunchCount}" Style="{StaticResource MetricLabel}"/>
                                </StackPanel>
                            </Border>
                            <Border BorderBrush="{DynamicResource UpdateDialog.WeakBorder}" BorderThickness="1,0,0,0">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TotalFlowCountDisplay}" Style="{StaticResource MetricValue}"/>
                                    <TextBlock Text="{x:Static local:UserCenterText.TotalFlowCount}" Style="{StaticResource MetricLabel}"/>
                                </StackPanel>
                            </Border>
                            <Border BorderBrush="{DynamicResource UpdateDialog.WeakBorder}" BorderThickness="1,0,0,0">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CompletionRateDisplay}" Style="{StaticResource MetricValue}"/>
                                    <TextBlock Text="{x:Static local:UserCenterText.Last7CompletionRate}" Style="{StaticResource MetricLabel}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource SectionCard}" Margin="0,18,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <StackPanel>
                                    <TextBlock Text="{x:Static local:UserCenterText.FlowActivity}" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="{Binding ActivitySummaryDisplay}"
                                               FontSize="12"
                                               Foreground="{DynamicResource UpdateDialog.TextSecondary}"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding ActivityRangeDisplay}"
                                               Foreground="{DynamicResource UpdateDialog.TextSecondary}"
                                               FontSize="12"
                                               Margin="0,0,12,0"/>
                                    <Button Style="{StaticResource UpdateDialogSecondaryButtonStyle}"
                                            Padding="9,5"
                                            Click="BtnRefreshStatistics_Click"
                                            ToolTip="{x:Static local:UserCenterText.RefreshStatistics}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,5,0"/>
                                            <TextBlock Text="{x:Static properties:Resources.Refresh}" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,18,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                                <ItemsControl ItemsSource="{Binding ActivityDays}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Vertical" Height="98"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="12" Height="12" Margin="1"
                                                    CornerRadius="2"
                                                    Background="{DynamicResource UpdateDialog.Accent}"
                                                    Opacity="{Binding Intensity}"
                                                    ToolTip="{Binding ToolTip}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </Viewbox>

                                <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Bottom">
                                    <TextBlock Text="{x:Static local:UserCenterText.ActivityLess}" FontSize="11" Foreground="{DynamicResource UpdateDialog.TextSecondary}" HorizontalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <Border Width="12" Height="12" Margin="2" CornerRadius="2" Background="{DynamicResource UpdateDialog.Accent}" Opacity="0.12"/>
                                        <Border Width="12" Height="12" Margin="2" CornerRadius="2" Background="{DynamicResource UpdateDialog.Accent}" Opacity="0.35"/>
                                        <Border Width="12" Height="12" Margin="2" CornerRadius="2" Background="{DynamicResource UpdateDialog.Accent}" Opacity="0.55"/>
                                        <Border Width="12" Height="12" Margin="2" CornerRadius="2" Background="{DynamicResource UpdateDialog.Accent}" Opacity="0.75"/>
                                        <Border Width="12" Height="12" Margin="2" CornerRadius="2" Background="{DynamicResource UpdateDialog.Accent}"/>
                                    </StackPanel>
                                    <TextBlock Text="{x:Static local:UserCenterText.ActivityMore}" FontSize="11" Foreground="{DynamicResource UpdateDialog.TextSecondary}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="2"
                                    Background="{DynamicResource UpdateDialog.Background}"
                                    BorderBrush="{DynamicResource UpdateDialog.WeakBorder}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,7"
                                    Margin="0,10,0,0"
                                    Visibility="{Binding StatisticsStatusVisibility}">
                                <TextBlock Text="{Binding StatisticsStatusDisplay}"
                                           Foreground="{DynamicResource UpdateDialog.TextSecondary}"
                                           FontSize="12"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="3" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="{x:Static local:UserCenterText.AccountOverview}" Style="{StaticResource SectionTitle}" Margin="0,0,0,16"/>
                                <Grid Margin="0,0,0,11">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Static properties:Resources.UserId}" Style="{StaticResource DetailLabel}"/>
                                    <TextBlock Grid.Column="1" Margin="18,0,0,0" TextWrapping="Wrap" TextAlignment="Right" Text="{Binding UserIdDisplay}" Style="{StaticResource DetailValue}"/>
                                </Grid>
                                <Grid Margin="0,0,0,11">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Static properties:Resources.Role}" Style="{StaticResource DetailLabel}"/>
                                    <TextBlock Grid.Column="1" Margin="18,0,0,0" TextWrapping="Wrap" TextAlignment="Right" Text="{Binding UserRoleDisplay}" Style="{StaticResource DetailValue}"/>
                                </Grid>
                                <Grid Margin="0,0,0,11">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Static properties:Resources.PermissionMode}" Style="{StaticResource DetailLabel}"/>
                                    <TextBlock Grid.Column="1" Margin="18,0,0,0" TextWrapping="Wrap" TextAlignment="Right" Text="{Binding PermissionModeDisplay}" Style="{StaticResource DetailValue}"/>
                                </Grid>
                                <Grid Margin="0,0,0,11">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Static local:UserCenterText.AccountUpdated}" Style="{StaticResource DetailLabel}"/>
                                    <TextBlock Grid.Column="1" Margin="18,0,0,0" TextWrapping="Wrap" TextAlignment="Right" Text="{Binding AccountUpdatedDisplay}" Style="{StaticResource DetailValue}"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Static local:UserCenterText.FirstUsage}" Style="{StaticResource DetailLabel}"/>
                                    <TextBlock Grid.Column="1" Margin="18,0,0,0" TextWrapping="Wrap" TextAlignment="Right" Text="{Binding FirstLaunchDisplay}" Style="{StaticResource DetailValue}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="{x:Static local:UserCenterText.FlowInsights}" Style="{StaticResource SectionTitle}" Margin="0,0,0,16"/>
                                <Grid Margin="0,0,0,11">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Static local:UserCenterText.Last7Executions}" Style="{StaticResource DetailLabel}"/>
                                    <TextBlock Grid.Column="1" Margin="18,0,0,0" TextWrapping="Wrap" TextAlignment="Right" Text="{Binding Last7DayFlowCountDisplay}" Style="{StaticResource DetailValue}"/>
                                </Grid>
                                <Grid Margin="0,0,0,11">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Static local:UserCenterText.AverageFlowDuration}" Style="{StaticResource DetailLabel}"/>
                                    <TextBlock Grid.Column="1" Margin="18,0,0,0" TextWrapping="Wrap" TextAlignment="Right" Text="{Binding AverageFlowDurationDisplay}" Style="{StaticResource DetailValue}"/>
                                </Grid>
                                <Grid Margin="0,0,0,11">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Static local:UserCenterText.ActiveDays}" Style="{StaticResource DetailLabel}"/>
                                    <TextBlock Grid.Column="1" Margin="18,0,0,0" TextWrapping="Wrap" TextAlignment="Right" Text="{Binding ActiveDaysDisplay}" Style="{StaticResource DetailValue}"/>
                                </Grid>
                                <Grid Margin="0,0,0,11">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Static local:UserCenterText.BusiestDay}" Style="{StaticResource DetailLabel}"/>
                                    <TextBlock Grid.Column="1" Margin="18,0,0,0" TextWrapping="Wrap" TextAlignment="Right" Text="{Binding BusiestDayDisplay}" Style="{StaticResource DetailValue}"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Static local:UserCenterText.LastLaunch}" Style="{StaticResource DetailLabel}"/>
                                    <TextBlock Grid.Column="1" Margin="18,0,0,0" TextWrapping="Wrap" TextAlignment="Right" Text="{Binding LastLaunchDisplay}" Style="{StaticResource DetailValue}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </ScrollViewer>
    </Grid>
</Window>
