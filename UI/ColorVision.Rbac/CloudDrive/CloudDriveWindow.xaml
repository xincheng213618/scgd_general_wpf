<Window x:Class="ColorVision.Rbac.CloudDrive.CloudDriveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:display="clr-namespace:ColorVision.Rbac"
        Title="{display:DisplayText Key='云盘 · ColorVision'}" Width="1080" Height="720" MinWidth="880" MinHeight="600"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        Background="{DynamicResource UpdateDialog.Background}" Foreground="{DynamicResource UpdateDialog.TextPrimary}"
        AllowDrop="True" Drop="Files_Drop" DragOver="Files_DragOver">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ColorVision.Themes;component/Themes/UpdateDialogTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,22">
            <TextBlock Text="{display:DisplayText Key='云盘'}" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock Text="{display:DisplayText Key='上传图像与文件，分享给任何一台电脑'}" FontSize="14" Margin="0,8,0,8"/>
            <TextBlock Text="{Binding LimitText}" TextWrapping="Wrap" Foreground="{DynamicResource UpdateDialog.TextSecondary}"/>
        </StackPanel>
        <WrapPanel Grid.Row="1" Margin="0,0,0,18">
            <Button Content="{display:DisplayText Key='选择文件'}" Click="AddFiles_Click" IsEnabled="{Binding IsIdle}" Style="{StaticResource UpdateDialogSecondaryButtonStyle}" Margin="0,0,8,6"/>
            <Button Content="{display:DisplayText Key='选择文件夹'}" Click="AddFolder_Click" IsEnabled="{Binding IsIdle}" Style="{StaticResource UpdateDialogSecondaryButtonStyle}" Margin="0,0,18,6"/>
            <Button Content="{display:DisplayText Key='开始 / 继续上传'}" Click="Start_Click" IsEnabled="{Binding IsIdle}" Style="{StaticResource UpdateDialogPrimaryButtonStyle}" Margin="0,0,8,6"/>
            <Button Content="{display:DisplayText Key='暂停上传'}" Click="Pause_Click" IsEnabled="{Binding IsBusy}" Style="{StaticResource UpdateDialogSecondaryButtonStyle}" Margin="0,0,8,6"/>
            <Button Content="{display:DisplayText Key='后台上传'}" Click="Hide_Click" Style="{StaticResource UpdateDialogSecondaryButtonStyle}" Margin="0,0,0,6" ToolTip="{display:DisplayText Key='隐藏窗口并继续上传，可从用户中心重新打开'}"/>
        </WrapPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
            <Border CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource UpdateDialog.WeakBorder}" Background="{DynamicResource UpdateDialog.Surface}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="{display:DisplayText Key='本机上传记录 · 可拖入文件或文件夹'}" FontWeight="SemiBold" Margin="6,4,0,12"/>
                    <ListBox x:Name="FilesList" Grid.Row="1" ItemsSource="{Binding Items}" SelectionChanged="Selection_Changed"
                             Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DataTemplate.Resources>
                                    <BooleanToVisibilityConverter x:Key="UploadProgressVisibility"/>
                                </DataTemplate.Resources>
                                <Grid Margin="2,8">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding SourcePath}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="12"/>
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="0,6,0,4" MinHeight="18">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <ProgressBar x:Name="UploadProgressBar" Style="{x:Null}" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" Height="6"/>
                                        <TextBlock x:Name="UploadPercentage" Grid.Column="1" Text="{Binding ProgressText}" FontSize="12" FontWeight="SemiBold"
                                                   Margin="10,0,0,0" MinWidth="48" TextAlignment="Right" VerticalAlignment="Center"
                                                   Visibility="{Binding HasUploadProgress, Converter={StaticResource UploadProgressVisibility}}"/>
                                    </Grid>
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="UploadDetail" Text="{Binding Detail}" FontSize="12" TextWrapping="Wrap"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                                            <TextBlock x:Name="UploadCurrentSpeed" Text="{Binding CurrentSpeedText}" FontSize="12"
                                                       Visibility="{Binding HasUploadProgress, Converter={StaticResource UploadProgressVisibility}}"/>
                                            <TextBlock x:Name="UploadRemainingTime" Text="{Binding RemainingTimeText}" FontSize="12" Margin="12,0,0,0"
                                                       Visibility="{Binding HasUploadProgress, Converter={StaticResource UploadProgressVisibility}}"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock x:Name="UploadMessage" Grid.Row="3" Text="{Binding UploadMessage}" FontSize="12" TextWrapping="Wrap"
                                               Margin="0,4,0,0" Visibility="{Binding HasUploadMessage, Converter={StaticResource UploadProgressVisibility}}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <WrapPanel Grid.Row="2" Margin="0,10,0,0">
                        <Button Content="{display:DisplayText Key='继续 / 重试选中项'}" Click="Retry_Click" IsEnabled="{Binding IsIdle}" Style="{StaticResource UpdateDialogSecondaryButtonStyle}" Margin="0,0,8,0"/>
                        <Button Content="{display:DisplayText Key='移除本机记录'}" Click="Remove_Click" IsEnabled="{Binding IsIdle}" Style="{StaticResource UpdateDialogSecondaryButtonStyle}"/>
                    </WrapPanel>
                </Grid>
            </Border>
            <Border Grid.Column="1" CornerRadius="10" Margin="16,0,0,0" BorderThickness="1" BorderBrush="{DynamicResource UpdateDialog.WeakBorder}" Background="{DynamicResource UpdateDialog.Surface}" Padding="18">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="{display:DisplayText Key='分享文件'}" FontSize="16" FontWeight="SemiBold"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                      <StackPanel>
                        <TextBlock x:Name="ShareHint" Text="{display:DisplayText Key='选择已完成的文件，即可生成分享二维码。'}" TextWrapping="Wrap" Margin="0,10,0,10" Foreground="{DynamicResource UpdateDialog.TextSecondary}"/>
                        <Border x:Name="QrBorder" Background="White" Padding="8" HorizontalAlignment="Center" Visibility="Collapsed">
                            <Image x:Name="QrImage" Width="172" Height="172"/>
                        </Border>
                        <TextBox x:Name="LinkText" IsReadOnly="True" TextWrapping="Wrap" Margin="0,10,0,10" MinHeight="48" VerticalContentAlignment="Center"/>
                      </StackPanel>
                    </ScrollViewer>
                    <UniformGrid Grid.Row="2" Columns="2" Margin="0,10,0,0">
                        <Button x:Name="CopyButton" Content="{display:DisplayText Key='复制链接'}" Click="Copy_Click" IsEnabled="False" Style="{StaticResource UpdateDialogPrimaryButtonStyle}" Margin="0,0,8,0"/>
                        <Button x:Name="OpenButton" Content="{display:DisplayText Key='打开网页'}" Click="Open_Click" IsEnabled="False" Style="{StaticResource UpdateDialogSecondaryButtonStyle}"/>
                    </UniformGrid>
                    <TextBlock Grid.Row="3" Text="{display:DisplayText Key='持有链接或二维码的人均可下载。到期后需重新上传。'}" TextWrapping="Wrap" Margin="0,12,0,0" FontSize="12" Foreground="{DynamicResource UpdateDialog.TextSecondary}"/>
                </Grid>
            </Border>
        </Grid>
        <TextBlock Grid.Row="3" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,18,0,0" MinHeight="32" Foreground="{DynamicResource UpdateDialog.TextSecondary}"/>
    </Grid>
</Window>
