<Window x:Class="ColorVision.Rbac.CloudDrive.CloudDriveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="云盘 · ColorVision" Width="1080" Height="720" MinWidth="880" MinHeight="600"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        Background="{DynamicResource UpdateDialog.Background}" Foreground="{DynamicResource UpdateDialog.TextPrimary}"
        AllowDrop="True" Drop="Files_Drop" DragOver="Files_DragOver">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ColorVision.Themes;component/Themes/UpdateDialogTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,22">
            <TextBlock Text="云盘" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock Text="上传图像与文件，分享给任何一台电脑" FontSize="14" Margin="0,8,0,8"/>
            <TextBlock Text="{Binding LimitText}" TextWrapping="Wrap" Foreground="{DynamicResource UpdateDialog.TextSecondary}"/>
        </StackPanel>
        <WrapPanel Grid.Row="1" Margin="0,0,0,18">
            <Button Content="选择文件" Click="AddFiles_Click" IsEnabled="{Binding IsIdle}" Style="{StaticResource UpdateDialogSecondaryButtonStyle}" Margin="0,0,8,6"/>
            <Button Content="选择文件夹" Click="AddFolder_Click" IsEnabled="{Binding IsIdle}" Style="{StaticResource UpdateDialogSecondaryButtonStyle}" Margin="0,0,18,6"/>
            <Button Content="开始 / 继续上传" Click="Start_Click" IsEnabled="{Binding IsIdle}" Style="{StaticResource UpdateDialogPrimaryButtonStyle}" Margin="0,0,8,6"/>
            <Button Content="暂停上传" Click="Pause_Click" IsEnabled="{Binding IsBusy}" Style="{StaticResource UpdateDialogSecondaryButtonStyle}" Margin="0,0,8,6"/>
            <Button Content="后台上传" Click="Hide_Click" Style="{StaticResource UpdateDialogSecondaryButtonStyle}" Margin="0,0,0,6" ToolTip="隐藏窗口并继续上传，可从用户中心重新打开"/>
        </WrapPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
            <Border CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource UpdateDialog.WeakBorder}" Background="{DynamicResource UpdateDialog.Surface}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="本机上传记录 · 可拖入文件或文件夹" FontWeight="SemiBold" Margin="6,4,0,12"/>
                    <ListBox x:Name="FilesList" Grid.Row="1" ItemsSource="{Binding Items}" SelectionChanged="Selection_Changed"
                             Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,8">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding SourcePath}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="12"/>
                                    </Grid>
                                    <ProgressBar Grid.Row="1" Style="{x:Null}" Minimum="0" Maximum="100" Value="{Binding Progress}" Height="5" Margin="0,10,0,7"/>
                                    <TextBlock Grid.Row="2" Text="{Binding Detail}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource UpdateDialog.TextSecondary}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <WrapPanel Grid.Row="2" Margin="0,10,0,0">
                        <Button Content="继续 / 重试选中项" Click="Retry_Click" IsEnabled="{Binding IsIdle}" Style="{StaticResource UpdateDialogSecondaryButtonStyle}" Margin="0,0,8,0"/>
                        <Button Content="移除本机记录" Click="Remove_Click" IsEnabled="{Binding IsIdle}" Style="{StaticResource UpdateDialogSecondaryButtonStyle}"/>
                    </WrapPanel>
                </Grid>
            </Border>
            <Border Grid.Column="1" CornerRadius="10" Margin="16,0,0,0" BorderThickness="1" BorderBrush="{DynamicResource UpdateDialog.WeakBorder}" Background="{DynamicResource UpdateDialog.Surface}" Padding="18">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="分享文件" FontSize="16" FontWeight="SemiBold"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                      <StackPanel>
                        <TextBlock x:Name="ShareHint" Text="选择已完成的文件，即可生成分享二维码。" TextWrapping="Wrap" Margin="0,10,0,10" Foreground="{DynamicResource UpdateDialog.TextSecondary}"/>
                        <Border x:Name="QrBorder" Background="White" Padding="8" HorizontalAlignment="Center" Visibility="Collapsed">
                            <Image x:Name="QrImage" Width="172" Height="172"/>
                        </Border>
                        <TextBox x:Name="LinkText" IsReadOnly="True" TextWrapping="Wrap" Margin="0,10,0,10" MinHeight="48" VerticalContentAlignment="Center"/>
                      </StackPanel>
                    </ScrollViewer>
                    <UniformGrid Grid.Row="2" Columns="2" Margin="0,10,0,0">
                        <Button x:Name="CopyButton" Content="复制链接" Click="Copy_Click" IsEnabled="False" Style="{StaticResource UpdateDialogPrimaryButtonStyle}" Margin="0,0,8,0"/>
                        <Button x:Name="OpenButton" Content="打开网页" Click="Open_Click" IsEnabled="False" Style="{StaticResource UpdateDialogSecondaryButtonStyle}"/>
                    </UniformGrid>
                    <TextBlock Grid.Row="3" Text="持有链接或二维码的人均可下载。到期后需重新上传。" TextWrapping="Wrap" Margin="0,12,0,0" FontSize="12" Foreground="{DynamicResource UpdateDialog.TextSecondary}"/>
                </Grid>
            </Border>
        </Grid>
        <TextBlock Grid.Row="3" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,18,0,0" MinHeight="32" Foreground="{DynamicResource UpdateDialog.TextSecondary}"/>
    </Grid>
</Window>
