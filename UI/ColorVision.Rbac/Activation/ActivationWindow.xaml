<Window x:Class="ColorVision.Rbac.Activation.ActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:display="clr-namespace:ColorVision.Rbac"
        Title="{display:DisplayText Key='许可证激活'}" Width="660" Height="650" MinWidth="520" MinHeight="450"
        WindowStartupLocation="CenterOwner" UseLayoutRounding="True"
        Background="{DynamicResource UpdateDialog.Background}" Foreground="{DynamicResource UpdateDialog.TextPrimary}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ColorVision.Themes;component/Themes/UpdateDialogTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ActivationCard" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource UpdateDialog.Surface}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource UpdateDialog.WeakBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="16"/>
                <Setter Property="Margin" Value="0,0,0,14"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="26,22,26,16">
            <TextBlock Text="{display:DisplayText Key='许可证激活'}" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock Text="{display:DisplayText Key='申请许可证并查看设备占用。激活状态仅在此处显示，不影响软件功能。'}"
                       Foreground="{DynamicResource UpdateDialog.TextSecondary}" TextWrapping="Wrap" Margin="0,6,0,16"/>
            <Border Style="{StaticResource ActivationCard}">
                <StackPanel>
                    <TextBlock x:Name="LocalStatus" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock x:Name="LicenseDetails" Foreground="{DynamicResource UpdateDialog.TextSecondary}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    <WrapPanel x:Name="Actions" Margin="0,12,0,0">
                        <Button x:Name="RefreshButton" Content="{display:DisplayText Key='刷新状态'}" Click="Refresh_Click" Style="{StaticResource UpdateDialogSecondaryButtonStyle}" Margin="0,0,8,0"/>
                        <Button x:Name="CopyButton" Content="{display:DisplayText Key='复制许可证'}" Click="Copy_Click" Style="{StaticResource UpdateDialogSecondaryButtonStyle}" Margin="0,0,8,0"/>
                        <Button x:Name="ReleaseButton" Content="{display:DisplayText Key='释放本机'}" Click="Release_Click" Style="{StaticResource UpdateDialogSecondaryButtonStyle}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border x:Name="EnrollmentCard" Style="{StaticResource ActivationCard}">
                <StackPanel>
                    <TextBlock Text="{display:DisplayText Key='选择设备类型'}" FontSize="15" FontWeight="SemiBold"/>
                    <RadioButton x:Name="OfflineMode" GroupName="ActivationMode" IsChecked="True" Margin="0,10,0,4"
                                 Content="{display:DisplayText Key='我的电脑（TPM 离线）'}"/>
                    <RadioButton GroupName="ActivationMode" Margin="0,0,0,8" Content="{display:DisplayText Key='共享电脑（在线）'}"/>
                    <TextBlock Text="{display:DisplayText Key='离线模式需要 TPM，联网可续期。在线模式在此窗口打开时续租，关闭后由服务器按租约到期回收。'}"
                               Foreground="{DynamicResource UpdateDialog.TextSecondary}" TextWrapping="Wrap"/>
                    <Button x:Name="ApplyButton" Content="{display:DisplayText Key='联网申请并激活'}" HorizontalAlignment="Left" Click="Apply_Click"
                            Style="{StaticResource UpdateDialogPrimaryButtonStyle}" Margin="0,12,0,12"/>
                    <TextBlock x:Name="LicenseCodeLabel" Text="{display:DisplayText Key='使用已有许可证'}" FontWeight="SemiBold"/>
                    <DockPanel Margin="0,6,0,0" LastChildFill="True">
                        <Button DockPanel.Dock="Right" Content="{display:DisplayText Key='激活本机'}" Click="Activate_Click" Style="{StaticResource UpdateDialogSecondaryButtonStyle}" Margin="8,0,0,0"/>
                        <PasswordBox x:Name="LicenseInput" MaxLength="64" AutomationProperties.LabeledBy="{Binding ElementName=LicenseCodeLabel}" VerticalContentAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="{display:DisplayText Key='服务器记录设备名、公钥指纹和激活时间，用于识别设备及计算名额。'}"
                               Foreground="{DynamicResource UpdateDialog.TextSecondary}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="OperationStatus" TextWrapping="Wrap" Margin="0,0,0,12" AutomationProperties.LiveSetting="Polite" Visibility="Collapsed"/>

            <Border Style="{StaticResource ActivationCard}">
                <StackPanel>
                    <TextBlock x:Name="DevicesTitle" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock x:Name="DevicesHint" Foreground="{DynamicResource UpdateDialog.TextSecondary}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <ItemsControl x:Name="DeviceList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource UpdateDialog.WeakBorder}" Padding="0,9,0,2" Margin="0,7,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Details}" Foreground="{DynamicResource UpdateDialog.TextSecondary}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
