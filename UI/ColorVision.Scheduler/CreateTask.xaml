<Window x:Class="ColorVision.Scheduler.CreateTask"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:properties="clr-namespace:ColorVision.Scheduler.Properties" xmlns:local="clr-namespace:ColorVision.Scheduler"
        Title="{x:Static properties:Resources.CreateTask}" Width="620" MinWidth="540" SizeToContent="Height"
        Background="{DynamicResource CV.Surface.Window}" Foreground="{DynamicResource CV.Text.Primary}"
        UseLayoutRounding="True" Loaded="Window_Loaded">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Presentation/SchedulerStyles.xaml"/></ResourceDictionary.MergedDictionaries>
            <Style x:Key="FormTextBox" TargetType="TextBox" BasedOn="{StaticResource TextBox.Small}">
                <Setter Property="MinHeight" Value="32"/><Setter Property="VerticalContentAlignment" Value="Center"/>
                <Style.Triggers>
                    <Trigger Property="Validation.HasError" Value="True">
                        <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="FormComboBox" TargetType="ComboBox" BasedOn="{StaticResource ComboBox.Small}">
                <Setter Property="MinHeight" Value="32"/><Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style x:Key="FormLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource CV.Text.Secondary}"/><Setter Property="Margin" Value="0,0,0,6"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock x:Name="FormTitle" Text="{x:Static properties:Resources.CreateTask}" FontSize="23" FontWeight="SemiBold"/>
            <TextBlock x:Name="FormSubtitle" Text="{x:Static properties:Resources.Sched_CreateHint}" Style="{StaticResource SchedulerSecondaryText}" Margin="0,6,0,0"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="EditorForm">
                <Border Style="{StaticResource SchedulerPanel}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{x:Static properties:Resources.Sched_TaskType}" Style="{StaticResource SchedulerSectionTitle}"/>
                        <Grid>
                            <ComboBox x:Name="TaskComboBox" Style="{StaticResource FormComboBox}" DisplayMemberPath="Key" SelectedValuePath="Value"
                                      SelectedValue="{Binding JobType, UpdateSourceTrigger=PropertyChanged}" SelectionChanged="TaskComboBox_SelectionChanged"
                                      AutomationProperties.Name="{x:Static properties:Resources.Sched_TaskType}"/>
                            <TextBlock Text="{x:Static properties:Resources.Sched_SelectTaskType}" IsHitTestVisible="False" Margin="10,0,28,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SchedulerSecondaryText}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=TaskComboBox, Path=SelectedIndex}" Value="-1"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{x:Static properties:Resources.Sched_TaskName}" Style="{StaticResource FormLabel}"/>
                                <TextBox x:Name="TaskNameTextBox" Style="{StaticResource FormTextBox}" Text="{Binding JobName, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="{x:Static properties:Resources.Sched_TaskName}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{x:Static properties:Resources.Sched_Group}" Style="{StaticResource FormLabel}"/>
                                <TextBox Style="{StaticResource FormTextBox}" Text="{Binding GroupName, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="{x:Static properties:Resources.Sched_Group}"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel x:Name="ConfigurationSection" Visibility="Collapsed" Margin="0,16,0,0">
                            <TextBlock Text="{x:Static properties:Resources.Sched_TaskConfiguration}" Style="{StaticResource FormLabel}"/>
                            <StackPanel x:Name="StackPanelConfig"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SchedulerPanel}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{x:Static properties:Resources.Sched_ScheduleMode}" Style="{StaticResource SchedulerSectionTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <ComboBox x:Name="ComboBoxMode" Style="{StaticResource FormComboBox}" DisplayMemberPath="Key" SelectedValuePath="Value"
                                      SelectedValue="{Binding Mode, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static properties:Resources.Sched_ScheduleMode}"/>
                            <ComboBox x:Name="RepeatModeComboBox" Grid.Column="2" DisplayMemberPath="Key" SelectedValuePath="Value"
                                      SelectedValue="{Binding RepeatMode, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static properties:Resources.Sched_RepeatMode}"
                                      ToolTip="{x:Static properties:Resources.Sched_RepeatMode}">
                                <ComboBox.Style>
                                    <Style TargetType="ComboBox" BasedOn="{StaticResource FormComboBox}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSimple}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                            <DataTrigger Binding="{Binding IsJobInterval}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.Style>
                            </ComboBox>
                        </Grid>
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSimple}" Value="True"/><Condition Binding="{Binding IsRepeatOnce}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                        <DataTrigger Binding="{Binding IsJobInterval}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{x:Static properties:Resources.Sched_Interval}" Style="{StaticResource FormLabel}"/>
                                    <TextBox x:Name="IntervalTextBox" Style="{StaticResource FormTextBox}" Text="{Binding Interval, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                             AutomationProperties.Name="{x:Static properties:Resources.Sched_Interval}" ToolTip="{x:Static properties:Resources.Sched_TimeFormat}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Visibility="{Binding IsRepeatMultiple, Converter={StaticResource bool2VisibilityConverter}}">
                                    <TextBlock Text="{x:Static properties:Resources.Sched_AdditionalRuns}" Style="{StaticResource FormLabel}"/>
                                    <TextBox x:Name="RepeatCountTextBox" Style="{StaticResource FormTextBox}" Text="{Binding RepeatCount, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                             AutomationProperties.Name="{x:Static properties:Resources.Sched_AdditionalRuns}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{x:Static properties:Resources.Sched_RepeatHint}" Style="{StaticResource SchedulerSecondaryText}" Margin="0,6,0,0"
                                       Visibility="{Binding IsRepeatMultiple, Converter={StaticResource bool2VisibilityConverter}}"/>
                        </StackPanel>
                        <StackPanel Visibility="{Binding IsCron, Converter={StaticResource bool2VisibilityConverter}}" Margin="0,12,0,0">
                            <TextBlock Text="{x:Static properties:Resources.CronExpression}" Style="{StaticResource FormLabel}"/>
                            <TextBox x:Name="CronTextBox" Style="{StaticResource FormTextBox}" Text="{Binding CronExpression, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="{x:Static properties:Resources.CronExpression}"/>
                            <Button Content="{x:Static properties:Resources.Sched_CronGenerator}" Style="{StaticResource CV.Button.Text}" Click="CronGenerator_Click" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{x:Static properties:Resources.Sched_CalendarHint}" Style="{StaticResource SchedulerSecondaryText}"
                                   Visibility="{Binding IsCalendar, Converter={StaticResource bool2VisibilityConverter}}" Margin="0,12,0,0"/>
                        <CheckBox Content="{x:Static properties:Resources.Sched_DelayStart}" IsChecked="{Binding IsDelayed, UpdateSourceTrigger=PropertyChanged}"
                                  Checked="DelayStart_Checked" Margin="0,16,0,0"/>
                        <StackPanel Visibility="{Binding IsDelayed, Converter={StaticResource bool2VisibilityConverter}}" Margin="0,8,0,0">
                            <TextBox x:Name="DelayTextBox" Style="{StaticResource FormTextBox}" Text="{Binding Delay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                     AutomationProperties.Name="{x:Static properties:Resources.Sched_DelayStart}"/>
                            <TextBlock Text="{x:Static properties:Resources.Sched_TimeFormat}" Style="{StaticResource SchedulerSecondaryText}" Margin="0,6,0,0"/>
                        </StackPanel>
                        <Border Background="{DynamicResource CV.Tag.Background}" CornerRadius="6" Padding="12" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="{x:Static properties:Resources.Sched_PlanPreview}" Style="{StaticResource SchedulerSecondaryText}"/>
                                <TextBlock x:Name="PlanSummaryText" TextWrapping="Wrap" Margin="0,5,0,0">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource SchedulerScheduleSummary}" Mode="OneWay">
                                            <Binding/><Binding Path="Mode"/><Binding Path="RepeatMode"/><Binding Path="RepeatCount"/>
                                            <Binding Path="Interval"/><Binding Path="IsDelayed"/><Binding Path="Delay"/><Binding Path="CronExpression"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
                <Expander x:Name="AdvancedSettings" Header="{x:Static properties:Resources.Sched_Advanced}" IsExpanded="False" Margin="0,0,0,8">
                    <Border Style="{StaticResource SchedulerPanel}" Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{x:Static properties:Resources.Sched_PriorityLabel}" Style="{StaticResource FormLabel}" ToolTip="{x:Static properties:Resources.Sched_PriorityTooltip}"/>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Priority}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                    <Slider x:Name="PrioritySlider" Minimum="1" Maximum="10" Value="{Binding Priority}" TickFrequency="1" IsSnapToTickEnabled="True"
                                            MinHeight="32" AutomationProperties.Name="{x:Static properties:Resources.Sched_PriorityLabel}"/>
                                </DockPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{x:Static properties:Resources.Sched_Timeout}" Style="{StaticResource FormLabel}" ToolTip="{x:Static properties:Resources.Sched_TimeoutTooltip}"/>
                                <TextBox x:Name="TimeoutTextBox" Text="{Binding TimeoutSeconds, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Style="{StaticResource FormTextBox}"
                                         AutomationProperties.Name="{x:Static properties:Resources.Sched_Timeout}"/>
                                <TextBlock Text="{x:Static properties:Resources.Sched_NoLimit}" Style="{StaticResource SchedulerSecondaryText}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Expander>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock x:Name="ErrorMessage" Foreground="{DynamicResource CV.Status.Error}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,10"/>
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="CancelButton" Content="{x:Static properties:Resources.Sched_Cancel}" IsCancel="True" Style="{StaticResource SchedulerAction}" MinWidth="80" Margin="0,0,8,0"/>
                    <Button x:Name="SubmitButton" Content="{x:Static properties:Resources.CreateTask}" Style="{StaticResource SchedulerPrimaryAction}" IsDefault="True" Click="Submit_Click"/>
                </StackPanel>
                <TextBlock Text="{x:Static properties:Resources.Sched_ImmediateHint}" Style="{StaticResource SchedulerSecondaryText}" Margin="0,0,18,0" MaxWidth="270"/>
            </DockPanel>
        </StackPanel>
    </Grid>
</Window>
