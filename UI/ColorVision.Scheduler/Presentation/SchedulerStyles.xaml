<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:ColorVision.Scheduler">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/ColorVision.Themes;component/Themes/Components/Dialog.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    <local:SchedulerDisplayConverter x:Key="SchedulerDisplay"/>
    <local:SchedulerScheduleSummaryConverter x:Key="SchedulerScheduleSummary"/>
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource CV.Text.Primary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="SchedulerSecondaryText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource CV.Text.Secondary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="SchedulerSectionTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource CV.Text.Primary}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style x:Key="SchedulerPanel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CV.Surface.Control}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CV.Border.Weak}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="18"/>
    </Style>
    <Style x:Key="SchedulerAction" TargetType="Button" BasedOn="{StaticResource CV.Button.Secondary}">
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="MinHeight" Value="32"/>
    </Style>
    <Style x:Key="SchedulerPrimaryAction" TargetType="Button" BasedOn="{StaticResource CV.Button.Primary}">
        <Setter Property="MinWidth" Value="100"/>
        <Setter Property="Padding" Value="16,7"/>
        <Setter Property="MinHeight" Value="34"/>
    </Style>
</ResourceDictionary>
