<Window x:Class="ColorVision.Database.GenericQueryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ColorVision.Database"
        xmlns:properties="clr-namespace:ColorVision.Database.Properties"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:GenericQueryBase}"
        Title="{x:Static properties:Resources.DB_AdvancedQuery}"
        Height="520" Width="760" MinHeight="420" MinWidth="640"
        Background="{StaticResource GlobalBackground}"
        Initialized="Window_Initialized"
        Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Background="{DynamicResource GlobalBorderBrush}" CornerRadius="6" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{x:Static properties:Resources.DB_FilterFieldColumn}"
                           VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                <ComboBox x:Name="PropertyInfoCB" Grid.Column="1"
                          DisplayMemberPath="Key" SelectedValuePath="Value"
                          MinHeight="32" HorizontalAlignment="Stretch"
                          IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True"
                          SelectionChanged="PropertyInfoCB_SelectionChanged"
                          PreviewKeyDown="PropertyInfoCB_PreviewKeyDown"
                          AutomationProperties.Name="{x:Static properties:Resources.DB_SelectFilterField}"/>
                <Button x:Name="AddConditionButton" Grid.Column="2"
                        Content="{x:Static properties:Resources.DB_Add}"
                        Click="AddPropertyInfo_Click" Margin="8,0,0,0"
                        MinWidth="76" MinHeight="32" Padding="10,4"
                        IsEnabled="False"
                        Background="{DynamicResource PrimaryBrush}" Foreground="White"/>
                <Button Grid.Column="3" Content="{x:Static properties:Resources.DB_AddAll}"
                        Click="AddAllPropertyInfo_Click" Margin="8,0,0,0"
                        MinHeight="32" Padding="10,4"/>
                <Button x:Name="MoreButton" Grid.Column="4" Content="•••"
                        Click="MoreButton_Click" Margin="8,0,0,0"
                        Width="42" MinHeight="32"
                        ToolTip="{x:Static properties:Resources.DB_TableMaintenance}">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{x:Static properties:Resources.DB_ClearTable}" Click="DeleteAll_Click"/>
                            <MenuItem Header="{x:Static properties:Resources.DB_TruncateTable}" Click="TruncateTable_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="6" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="10,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="125"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static properties:Resources.DB_FilterFieldColumn}" Opacity="0.68"/>
                    <TextBlock Grid.Column="1" Text="{x:Static properties:Resources.DB_FilterOperatorColumn}" Opacity="0.68"/>
                    <TextBlock Grid.Column="2" Text="{x:Static properties:Resources.DB_FilterValueColumn}" Opacity="0.68"/>
                    <Button x:Name="ResetConditionsButton" Grid.Column="3"
                            Content="{x:Static properties:Resources.DB_ClearConditions}"
                            Click="ResetConditions_Click" Margin="8,-4,0,0" Padding="8,2"
                            Visibility="Collapsed"/>
                </Grid>

                <Grid Grid.Row="1">
                    <TextBlock x:Name="EmptyStatePanel"
                               Text="{x:Static properties:Resources.DB_NoFilterConditions}"
                               VerticalAlignment="Center" HorizontalAlignment="Center"
                               Opacity="0.58"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid x:Name="QueryGrid"/>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Background="{DynamicResource GlobalBorderBrush}" CornerRadius="6" Padding="10" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="82"/>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{x:Static properties:Resources.DB_MaxResults}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox x:Name="MaxResultsTextBox" Grid.Column="1" Margin="8,0,0,0"
                         MinHeight="30" VerticalContentAlignment="Center" TextAlignment="Right"
                         AutomationProperties.Name="{x:Static properties:Resources.DB_MaxResults}"/>
                <TextBlock Grid.Column="2" Text="{x:Static properties:Resources.DB_ResultUnit}"
                           VerticalAlignment="Center" Margin="6,0,0,0"/>
                <TextBlock Grid.Column="3" Text="{x:Static properties:Resources.DB_SortById}"
                           VerticalAlignment="Center" FontWeight="SemiBold" Margin="18,0,0,0"/>
                <ComboBox x:Name="SortDirectionCB" Grid.Column="4" Margin="8,0,0,0" MinHeight="30">
                    <ComboBoxItem Content="{x:Static properties:Resources.DB_NewestFirst}"/>
                    <ComboBoxItem Content="{x:Static properties:Resources.DB_OldestFirst}"/>
                </ComboBox>
            </Grid>
        </Border>

        <Expander Grid.Row="3" Header="SQL" Margin="2,0,2,6">
            <TextBox Text="{Binding Sql}" IsReadOnly="True" TextWrapping="Wrap"
                     MaxHeight="74" Padding="8" Margin="0,4,0,0"
                     VerticalScrollBarVisibility="Auto"/>
        </Expander>

        <TextBlock x:Name="StatusText" Grid.Row="4"
                   MinHeight="20" Margin="2,0,0,6" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Assertive"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{x:Static properties:Resources.DB_Close}" MinWidth="82" MinHeight="34"
                    Padding="12,5" IsCancel="True" Click="Cancel_Click"/>
            <Button x:Name="ApplyFilterButton"
                    Content="{x:Static properties:Resources.DB_Query}"
                    MinWidth="96" MinHeight="34" Padding="12,5" Margin="8,0,0,0"
                    IsDefault="True" Click="Query_Click"
                    Background="{DynamicResource PrimaryBrush}" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
