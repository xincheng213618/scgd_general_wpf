<Window x:Class="ColorVision.Database.GenericQueryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ColorVision.Database"
        xmlns:properties="clr-namespace:ColorVision.Database.Properties"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:GenericQueryBase}"
        Title="{x:Static properties:Resources.DB_AdvancedQuery}"
        Height="460" Width="760" MinHeight="400" MinWidth="640"
        Background="{StaticResource GlobalBackground}"
        Initialized="Window_Initialized"
        Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="6" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Margin="0,0,0,10">
                    <Button x:Name="MoreButton" DockPanel.Dock="Right" Content="•••"
                            Click="MoreButton_Click" Width="34" MinHeight="28" Margin="8,0,0,0"
                            ToolTip="{x:Static properties:Resources.DB_MoreQueryActions}"
                            AutomationProperties.Name="{x:Static properties:Resources.DB_MoreQueryActions}">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{x:Static properties:Resources.DB_AddAll}" Click="AddAllPropertyInfo_Click"/>
                                <Separator/>
                                <MenuItem Header="{x:Static properties:Resources.DB_TableMaintenance}">
                                    <MenuItem Header="{x:Static properties:Resources.DB_ClearTable}" Click="DeleteAll_Click"/>
                                    <MenuItem Header="{x:Static properties:Resources.DB_TruncateTable}" Click="TruncateTable_Click"/>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button x:Name="ResetConditionsButton" DockPanel.Dock="Right"
                            Content="{x:Static properties:Resources.DB_ClearConditions}"
                            Click="ResetConditions_Click" Padding="8,2" Visibility="Collapsed"/>
                    <TextBlock Text="{x:Static properties:Resources.DB_MatchAllConditions}"
                               VerticalAlignment="Center"/>
                </DockPanel>

                <Grid Grid.Row="1" Margin="9,0,9,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static properties:Resources.DB_FilterFieldColumn}" Opacity="0.68"/>
                    <TextBlock Grid.Column="1" Text="{x:Static properties:Resources.DB_FilterOperatorColumn}" Opacity="0.68"/>
                    <TextBlock Grid.Column="2" Text="{x:Static properties:Resources.DB_FilterValueColumn}" Opacity="0.68"/>
                </Grid>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Grid x:Name="QueryGrid"/>
                        <Button x:Name="AddConditionButton" HorizontalAlignment="Left"
                                Content="{x:Static properties:Resources.DB_AddCondition}"
                                Click="AddCondition_Click" MinHeight="30" Padding="10,4" Margin="0,4,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Background="{DynamicResource GlobalBorderBrush}" CornerRadius="6" Padding="10" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="82"/>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{x:Static properties:Resources.DB_MaxResults}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox x:Name="MaxResultsTextBox" Grid.Column="1" Margin="8,0,0,0"
                         MinHeight="30" VerticalContentAlignment="Center" TextAlignment="Right"
                         AutomationProperties.Name="{x:Static properties:Resources.DB_MaxResults}"/>
                <TextBlock Grid.Column="2" Text="{x:Static properties:Resources.DB_ResultUnit}"
                           VerticalAlignment="Center" Margin="6,0,0,0"/>
                <TextBlock Grid.Column="3" Text="{x:Static properties:Resources.DB_SortById}"
                           VerticalAlignment="Center" FontWeight="SemiBold" Margin="18,0,0,0"/>
                <ComboBox x:Name="SortDirectionCB" Grid.Column="4" Margin="8,0,0,0" MinHeight="30">
                    <ComboBoxItem Content="{x:Static properties:Resources.DB_NewestFirst}"/>
                    <ComboBoxItem Content="{x:Static properties:Resources.DB_OldestFirst}"/>
                </ComboBox>
            </Grid>
        </Border>

        <Expander Grid.Row="2" Header="SQL" Margin="2,0,2,6">
            <TextBox Text="{Binding Sql}" IsReadOnly="True" TextWrapping="Wrap"
                     MaxHeight="74" Padding="8" Margin="0,4,0,0"
                     VerticalScrollBarVisibility="Auto"/>
        </Expander>

        <TextBlock x:Name="StatusText" Grid.Row="3"
                   MinHeight="20" Margin="2,0,0,6" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Assertive"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{x:Static properties:Resources.DB_Close}" MinWidth="82" MinHeight="34"
                    Padding="12,5" IsCancel="True" Click="Cancel_Click"/>
            <Button x:Name="ApplyFilterButton"
                    Content="{x:Static properties:Resources.DB_Query}"
                    MinWidth="96" MinHeight="34" Padding="12,5" Margin="8,0,0,0"
                    IsDefault="True" Click="Query_Click"
                    Background="{DynamicResource PrimaryBrush}" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
