<Window x:Class="ColorVision.Database.GenericQueryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ColorVision.Database"
        xmlns:properties="clr-namespace:ColorVision.Database.Properties"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:GenericQueryBase}"
        Title="{x:Static properties:Resources.DB_AdvancedQuery}"
        Height="620" Width="800" MinHeight="520" MinWidth="680"
        Background="{StaticResource GlobalBackground}"
        Initialized="Window_Initialized">
    <Window.Resources>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource GlobalTextBrush}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="{x:Static properties:Resources.DB_FilterDataTitle}" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="{x:Static properties:Resources.DB_FilterDataDescription}" Margin="0,4,0,0" Opacity="0.72"/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Background="{DynamicResource GlobalBorderBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{x:Static properties:Resources.DB_AddFilterField}"
                           VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0"/>
                <ComboBox x:Name="PropertyInfoCB" Grid.Column="1"
                          DisplayMemberPath="Key" SelectedValuePath="Value"
                          MinHeight="32" MaxWidth="420" HorizontalAlignment="Stretch"
                          SelectionChanged="PropertyInfoCB_SelectionChanged"
                          PreviewKeyDown="PropertyInfoCB_PreviewKeyDown"
                          AutomationProperties.Name="{x:Static properties:Resources.DB_SelectFilterField}"/>
                <Button x:Name="AddConditionButton" Grid.Column="2"
                        Content="{x:Static properties:Resources.DB_AddCondition}"
                        Click="AddPropertyInfo_Click" Margin="10,0,0,0"
                        MinWidth="96" MinHeight="32" Padding="12,4"
                        IsEnabled="False"
                        Background="{DynamicResource PrimaryBrush}" Foreground="White"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Margin="0,0,0,10">
                    <Button x:Name="ResetConditionsButton" DockPanel.Dock="Right"
                            Content="{x:Static properties:Resources.DB_ClearConditions}"
                            Click="ResetConditions_Click" Padding="10,3"
                            Visibility="Collapsed"/>
                    <StackPanel>
                        <TextBlock Text="{x:Static properties:Resources.DB_FilterConditions}" FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Static properties:Resources.DB_AllConditionsMustMatch}"
                                   Margin="0,3,0,0" Opacity="0.68" FontSize="12"/>
                    </StackPanel>
                </DockPanel>

                <Grid Grid.Row="1" Margin="10,0,50,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="125"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static properties:Resources.DB_FilterFieldColumn}" Opacity="0.68"/>
                    <TextBlock Grid.Column="1" Text="{x:Static properties:Resources.DB_FilterOperatorColumn}" Opacity="0.68"/>
                    <TextBlock Grid.Column="2" Text="{x:Static properties:Resources.DB_FilterValueColumn}" Opacity="0.68"/>
                </Grid>

                <Grid Grid.Row="2">
                    <StackPanel x:Name="EmptyStatePanel" VerticalAlignment="Center" HorizontalAlignment="Center"
                                MaxWidth="540" Margin="20">
                        <TextBlock Text="{x:Static properties:Resources.DB_NoFilterConditions}"
                                   FontSize="16" FontWeight="SemiBold" TextAlignment="Center"/>
                        <TextBlock Text="{x:Static properties:Resources.DB_NoFilterConditionsDescription}"
                                   Margin="0,6,0,0" TextAlignment="Center" TextWrapping="Wrap" Opacity="0.68"/>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid x:Name="QueryGrid"/>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Background="{DynamicResource GlobalBorderBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{x:Static properties:Resources.DB_MaxResults}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox x:Name="MaxResultsTextBox" Grid.Column="1" Margin="10,0,0,0"
                         MinHeight="30" VerticalContentAlignment="Center" TextAlignment="Right"
                         AutomationProperties.Name="{x:Static properties:Resources.DB_MaxResults}"/>
                <TextBlock Grid.Column="2" Text="{x:Static properties:Resources.DB_ResultUnit}"
                           VerticalAlignment="Center" Margin="6,0,0,0"/>
                <TextBlock Grid.Column="3" Text="{x:Static properties:Resources.DB_SortById}"
                           VerticalAlignment="Center" FontWeight="SemiBold" Margin="24,0,0,0"/>
                <ComboBox x:Name="SortDirectionCB" Grid.Column="4" Margin="10,0,0,0" MinHeight="30">
                    <ComboBoxItem Content="{x:Static properties:Resources.DB_NewestFirst}"/>
                    <ComboBoxItem Content="{x:Static properties:Resources.DB_OldestFirst}"/>
                </ComboBox>
            </Grid>
        </Border>

        <TextBlock x:Name="StatusText" Grid.Row="4"
                   Text="{x:Static properties:Resources.DB_Ready}"
                   MinHeight="22" Margin="2,0,0,8" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Assertive"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{x:Static properties:Resources.Cancel}" MinWidth="88" MinHeight="34"
                    Padding="14,5" IsCancel="True" Click="Cancel_Click"/>
            <Button x:Name="ApplyFilterButton"
                    Content="{x:Static properties:Resources.DB_ApplyFilter}"
                    MinWidth="112" MinHeight="34" Padding="14,5" Margin="10,0,0,0"
                    IsDefault="True" Click="Query_Click"
                    Background="{DynamicResource PrimaryBrush}" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
