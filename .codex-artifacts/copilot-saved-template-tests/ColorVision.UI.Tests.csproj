             Link="CopilotTemplateTypeContextTests.cs" />
    <Compile Include="..\..\ColorVision\Copilot\Agent\CopilotReferenceContextSupport.cs"
             Link="CopilotReferenceContextSupport.cs" />
    <Compile Include="..\..\ColorVision\Copilot\Agent\CopilotToolIntentPolicy.cs"
             Link="CopilotToolIntentPolicy.cs" />
    <Compile Include="..\..\ColorVision\Copilot\Agent\Tools\Application\CopilotExecuteMenuTool.cs"
             Link="CopilotExecuteMenuTool.cs" />
    <Compile Include="..\..\ColorVision\Copilot\Agent\Tools\Application\CopilotSavedTemplateContextTool.cs"
             Link="CopilotSavedTemplateContextTool.cs" />
    <Compile Include="..\..\ColorVision\Copilot\Agent\Tools\Application\CopilotTemplateTypeContextTool.cs"
             Link="CopilotTemplateTypeContextTool.cs" />
    <Reference Include="ColorVision">
